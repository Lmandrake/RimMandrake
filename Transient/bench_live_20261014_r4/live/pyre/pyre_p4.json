    "pyre_animal_distribution_correct": {
      "polarity": "must",
      "text": "every wild animal on a fresh Pyrelands map belongs to the biome's fire-ecology cast, no other kind wanders in, and the small common grazers outnumber the big predators."
    },
    "pyre_mapgen_log_clean": {
      "polarity": "must",
      "text": "generating a fresh Pyrelands map raises no error message on screen."
    },
    "pyre_ground_deep_ash": {
      "polarity": "must",
      "text": "a fresh Pyrelands map is almost all deep ash; only small pockets of unburned soil and gravel remain, and standing water is ringed with richer ground."
    },
    "pyre_ash_fertile_when_watered": {
      "polarity": "must",
      "text": "a crop on deep ash beside a watered channel grows clearly faster than the same crop on dry ash."
    },
    "pyre_fresh_burn_feeds_the_field": {
      "polarity": "must",
      "text": "ground that has just burned grows noticeably faster for a few days, and a black rain washes that advantage away early."
    },
    "pyre_grass_chokes_ground": {
      "polarity": "must",
      "text": "open ground is carpeted densely in grass; there are no bare-dirt expanses where grass should carry the ground."
    },
    "pyre_embergrass_regrows": {
      "polarity": "must",
      "text": "a burned patch of grass is visibly re-greening within a few days and largely green again within about a week, at the biome's own heat."
    },
    "pyre_burn_line_present": {
      "polarity": "must",
      "text": "a fresh Pyrelands map shows an active line of fire somewhere, with a visibly scorched trail behind its advancing front."
    },
    "pyre_scorchfruit_fire_born": {
      "polarity": "must",
      "text": "scorch-fruit appears only on freshly burned ground, never as ordinary wild growth on unburned land."
    },
    "pyre_scorchfruit_produces": {
      "polarity": "must",
      "text": "a ripe scorch-fruit plant yields edible fruit that a colonist can harvest, and eating it raises a hungry colonist's food meter."
    },
    "pyre_scorchfruit_spoils_fast": {
      "polarity": "must",
      "text": "unrefrigerated, harvested scorch-fruit rots within about four days, and a ripe unharvested plant withers within about a day."
    },
    "pyre_ruins_scorched": {
      "polarity": "must",
      "text": "ruins on a fresh Pyrelands map stand blackened and fire-scarred, not pristine."
    },
    "pyre_fulgurite_after_lightning": {
      "polarity": "must",
      "text": "after a dry-lightning storm strikes sandy ground, at least one impact site bears a visible lump of fulgurite glass."
    },
    "pyre_firehawk_carries_ember": {
      "polarity": "must",
      "text": "a fire-hawk picks up a burning twig and a new fire starts where it drops it, ahead of the existing blaze."
    },
    "pyre_furnacebeast_warmth": {
      "polarity": "must",
      "text": "a pawn standing in the open near a furnace-beast shows a readable warmth status that disappears after it walks away."
    },
    "pyre_furnacebeast_heats_room": {
      "polarity": "must",
      "text": "an enclosed room holding a furnace-beast becomes clearly hotter than a comparable room without one."
    },
    "pyre_burrowers_dive": {
      "polarity": "must",
      "text": "when fire reaches a burrowing grazer it shows a readable burrowed status and comes through unharmed once the fire has passed."
    },
    "pyre_ashfall_darkens_drifts": {
      "polarity": "must",
      "text": "ash fall dims the map and lays visible loose-ash drifts that keep accumulating while it lasts."
    },
    "pyre_cinderfall_distinct": {
      "polarity": "must",
      "text": "cinderfall is recognisable at a glance as its own weather, not ash fall renamed."
    },
    "pyre_blackrain_reads": {
      "polarity": "must",
      "text": "black rain falls visibly dark, plainly different from ordinary blue-grey rain."
    },
    "pyre_cannot_ordinary_rain": {
      "polarity": "cannot",
      "text": "ordinary rain falling on a Pyrelands map; its only wet weather is black rain."
    }
  },
