						<solid>True</solid>
						<id>11</id>
						<development IsNull="True" />
					</li>
					<li>
						<foundation Class="IdeoFoundation_Deity">
							<def>Deity</def>
							<place>Sophiamunda</place>
							<deities>
								<li>
									<name>Palpatine</name>
									<type>He Who Is Rising</type>
									<gender>Male</gender>
									<iconPath>UI/Deities/DeityGeneric</iconPath>
								</li>
								<li>
									<name>the Line</name>
									<type>That Which Has No Face</type>
									<iconPath>UI/Deities/DeityGeneric</iconPath>
								</li>
							</deities>
						</foundation>
						<name>The Rising Order</name>
						<adjective>faithful</adjective>
						<memberName>Faithholder</memberName>
						<leaderTitleMale>Emperor</leaderTitleMale>
						<leaderTitleFemale>Emperor</leaderTitleFemale>
						<description>We have never seen him. We will never see him. He is rising, and we are the ground he rises from. Take the helmet: it is the last thing you will ever choose. There is no doubt among us — only disorder, and disorder is corrected. Say the name once when you are given the armour, and once when you are taken out of it. Between those two words, stand in line.</description>
						<descriptionTemplate>The people of the techno-feudal world Sophiamunda worshipped %%deity0_name%%. %%Deity0_pronoun%% saw that they were suited for humanity, and ordained that these worshippers would rule above all others. An anti-human revolutionist made an edict giving some equal rights to both animals and humans. %%Deity0_name%% wept as the %%memberNamePlural%% were forced to give their rights to donkeys and pandas. %%Deity0_name%% blessed a squire named Bethany 'Beth' Andrews with great charisma, and none could turn away when she spoke. Beth admonished the rebels and reminded them of %%deity0_name%%'s power, and they put down their warhammers.</descriptionTemplate>
						<culture>RUT_Jawa_Culture_Empire</culture>
						<iconDef>EmbodiedTheist_Bolthand</iconDef>
						<colorDef>LightGreen</colorDef>
						<primaryFactionColor>RGBA(0.850, 0.850, 0.750, 1.000)</primaryFactionColor>
						<memes>
							<li>Structure_TheistEmbodied</li>
							<li>Supremacist</li>
							<li>Proselytizer</li>
							<li>HumanPrimacy</li>
						</memes>
						<precepts>
							<li>
								<name>slavery</name>
								<def>Slavery_Honorable</def>
								<ID>1225</ID>
								<randomSeed>2060860620</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li>
								<name>execution</name>
								<def>Execution_Required</def>
								<ID>1226</ID>
								<randomSeed>1832642915</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li Class="Precept_Ritual">
								<name>funeral (no corpse)</name>
								<def>AM_FuneralNoCorpse</def>
								<ID>1229</ID>
								<randomSeed>-1244758278</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
								<ritualExpectedDesc>Once a {IDEO} member dies and the body is lost, other {MEMBERS} gather around an empty grave for {RITUAL_labelDef}.</ritualExpectedDesc>
								<playsIdeoMusic>True</playsIdeoMusic>
								<generatedAttachedReward>True</generatedAttachedReward>
								<sourcePattern>AM_FuneralNoCorpsePattern</sourcePattern>
								<obligationTargetFilter Class="RitualObligationTargetWorker_AnyEmptyGrave">
									<def>AnyEmptyGrave</def>
									<parent>Precept_1229</parent>
								</obligationTargetFilter>
								<targetFilter IsNull="True" />
								<behavior Class="RitualBehaviorWorker_Funeral">
									<def>Funeral</def>
								</behavior>
								<triggers>
									<li Class="AlphaMemes.RitualObligationTrigger_NoCorpse">
										<mustBePlayerIdeo>True</mustBePlayerIdeo>
									</li>
								</triggers>
								<outcomeEffect Class="RitualOutcomeEffectWorker_FromQuality">
									<def>AttendedFuneralNoCorpse</def>
									<compDatas>
										<li IsNull="True" />
										<li Class="RitualOutcomeComp_DataThingPresence">
											<presentForTicks>
												<keys />
												<values />
											</presentForTicks>
										</li>
									</compDatas>
								</outcomeEffect>
								<layerWhitelist IsNull="True" />
								<layerBlacklist IsNull="True" />
								<activeObligations IsNull="True" />
								<completedObligations IsNull="True" />
								<lastFinishedTick>-1</lastFinishedTick>
							</li>
							<li Class="Precept_Ritual">
