						<solid>True</solid>
						<id>3</id>
						<development IsNull="True" />
					</li>
					<li>
						<foundation Class="IdeoFoundation_Deity">
							<def>Deity</def>
							<place>Rogia</place>
							<deities />
						</foundation>
						<name>the Green Oath</name>
						<adjective>lifeist</adjective>
						<memberName>Lifeist</memberName>
						<leaderTitleMale>Elder</leaderTitleMale>
						<leaderTitleFemale>Elder</leaderTitleFemale>
						<description>We are a forest people on a world with no forest, and the Oath does not care. Everything that breathes is kin — the animal, the tree, the stranger who pulled one of us out of a cage. A life handed back is a debt that never closes, and it was never meant to. We keep the springs green. We remember every hand that cut them. Both of those are the same duty.</description>
						<descriptionTemplate>The universe is an endless cycle of creation and destruction managed by spirits in aspects of the world around us. Every spirit is simply an aspect of all the others, and those that try to stand alone are fall quickly. It is prophesied that a sleeping traveler from the stars will crash to the earth, and the spirit of the crater will wake the traveller who will raise the last tribe.</descriptionTemplate>
						<culture>RUT_Jawa_Culture_Wildsteam</culture>
						<iconDef>RoundE</iconDef>
						<colorDef>Olive</colorDef>
						<primaryFactionColor>RGBA(0.258, 0.392, 0.213, 1.000)</primaryFactionColor>
						<memes>
							<li>Structure_Animist</li>
							<li>Collectivist</li>
							<li>AnimalPersonhood</li>
							<li>TreeConnection</li>
							<li>NaturePrimacy</li>
						</memes>
						<precepts>
							<li>
								<name>Gauranlen connection</name>
								<def>GauranlenConnection_Strong</def>
								<ID>419</ID>
								<randomSeed>-905262278</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li>
								<name>meat eating</name>
								<def>MeatEating_Horrible</def>
								<ID>420</ID>
								<randomSeed>-564812269</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li>
								<name>fishing</name>
								<def>Fishing_Prohibited</def>
								<ID>421</ID>
								<randomSeed>2146287519</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li Class="Precept_Ritual">
								<name>funeral (no corpse)</name>
								<def>AM_FuneralNoCorpse</def>
								<ID>425</ID>
								<randomSeed>252096243</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
								<ritualExpectedDesc>Once a {IDEO} member dies and the body is lost, other {MEMBERS} gather around an empty grave for {RITUAL_labelDef}.</ritualExpectedDesc>
								<playsIdeoMusic>True</playsIdeoMusic>
								<generatedAttachedReward>True</generatedAttachedReward>
								<sourcePattern>AM_FuneralNoCorpsePattern</sourcePattern>
								<obligationTargetFilter Class="RitualObligationTargetWorker_AnyEmptyGrave">
									<def>AnyEmptyGrave</def>
									<parent>Precept_425</parent>
								</obligationTargetFilter>
								<targetFilter IsNull="True" />
								<behavior Class="RitualBehaviorWorker_Funeral">
									<def>Funeral</def>
								</behavior>
								<triggers>
									<li Class="AlphaMemes.RitualObligationTrigger_NoCorpse">
										<mustBePlayerIdeo>True</mustBePlayerIdeo>
									</li>
								</triggers>
								<outcomeEffect Class="RitualOutcomeEffectWorker_FromQuality">
									<def>AttendedFuneralNoCorpse</def>
									<compDatas>
										<li IsNull="True" />
										<li Class="RitualOutcomeComp_DataThingPresence">
											<presentForTicks>
												<keys />
												<values />
											</presentForTicks>
										</li>
									</compDatas>
								</outcomeEffect>
								<layerWhitelist IsNull="True" />
								<layerBlacklist IsNull="True" />
								<activeObligations IsNull="True" />
								<completedObligations IsNull="True" />
								<lastFinishedTick>-1</lastFinishedTick>
							</li>
							<li Class="Precept_Ritual">
								<name>Lifeist Burial</name>
								<def>AM_SkyBurial</def>
								<ID>504</ID>
								<randomSeed>1486052890</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<nameMaker>NamerRitualFuneral</nameMaker>
								<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
								<ritualExpectedDesc>Once a {IDEO} member dies, other {MEMBERS} witnesss {RITUAL_labelDef} to send off their friend to nature</ritualExpectedDesc>
								<playsIdeoMusic>True</playsIdeoMusic>
								<generatedAttachedReward>True</generatedAttachedReward>
								<sourcePattern>AM_SkyBurialPattern</sourcePattern>
								<obligationTargetFilter Class="AlphaMemes.RitualObligationTargetWorker_FuneralHolderThings">
									<def>AM_SkyBurialTarget</def>
									<parent>Precept_504</parent>
								</obligationTargetFilter>
								<targetFilter IsNull="True" />
