+
+    /// <summary>Proof build only (the Test Pilot sitting on RIMMANDRAKE_FIX_WALK_RAID_SIX_FAILED_ROWS_AFTER_CRASHES): per-frame time
+    /// in the vanilla paths a throw sets off, for RM_FrameProbe's CSV: PawnFlyer drawing and ticking, the map mesh rebuild
+    /// (MapDrawer.MapMeshDrawerUpdate_First) and job searches (TryFindAndStartJob, CheckForJobOverride). Vanilla methods only.</summary>
+    [HarmonyPatch]
+    public static class RM_Patch_ProofFrameVanillaTime
+    {
+        public static IEnumerable<MethodBase> TargetMethods()
+        {
+            yield return AccessTools.Method(typeof(PawnFlyer), "DynamicDrawPhaseAt");
+            yield return AccessTools.Method(typeof(PawnFlyer), "TickInterval");
+            yield return AccessTools.Method(typeof(MapDrawer), "MapMeshDrawerUpdate_First");
+            yield return AccessTools.Method(typeof(Pawn_JobTracker), "TryFindAndStartJob");
+            yield return AccessTools.Method(typeof(Pawn_JobTracker), "CheckForJobOverride");
+        }
+
+        public static void Prefix(out long __state)
+        {
+            __state = System.Diagnostics.Stopwatch.GetTimestamp();
+        }
+
+        public static void Postfix(long __state, MethodBase __originalMethod, object __instance)
+        {
+            double ms = RM_FrameProbe.MsSince(__state);
+            string n = __originalMethod?.Name;
+            if (n == "DynamicDrawPhaseAt") RM_FrameProbe.FlyerDrawMs += ms;
+            else if (n == "TickInterval") RM_FrameProbe.FlyerTickMs += ms;
+            else if (n == "MapMeshDrawerUpdate_First") RM_FrameProbe.MeshMs += ms;
+            else
+            {
+                RM_FrameProbe.JobMs += ms;
+                RM_FrameProbe.JobSearches++;
+                if (ms >= 2.0 && __instance is Pawn_JobTracker jt && RM_FrameProbe.JobWho.Length < 600)
+                {
+                    Pawn pw = Traverse.Create(jt).Field("pawn").GetValue<Pawn>();
+                    RM_FrameProbe.JobWho.Append(pw?.LabelShort ?? "?").Append('/').Append(pw?.Faction?.IsPlayer == true ? "P" : "N")
+                        .Append(n == "CheckForJobOverride" ? "/ovr" : "/find").Append('=').Append(ms.ToString("0.#")).Append('>')
+                        .Append(jt.curJob?.def?.defName ?? "none").Append(';');
+                }
+            }
+        }
+    }
 }
 #endif
