{
 "sheet": "flora_assignment_register",
 "posture": "blacklist",
 "postureMeaning": "LANDED unless overruled. Rows with no entry stand as landed.",
 "criterion": "Rows pass their biome sheet's admission tests — which rank LAWFULNESS, not worth; commonality values are agent-chosen throughout.",
 "generatedBy": "gen_flora_assignment_sheet.py",
