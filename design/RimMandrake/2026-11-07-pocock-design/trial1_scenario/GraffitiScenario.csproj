<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pocock trial 1's replacement test (04-trial1-callers.md): the REAL ThoughtWorker_ViewedGraffitiMark.cs and the real kernel,
    compiled against a small fake Verse/RimWorld (Stubs.cs), driven by literal scenarios (Scenarios.cs). Plain net8.0.
    Run: python3 design/RimMandrake/2026-11-07-pocock-design/trial1_scenario/run_scenarios.py
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>GraffitiScenario</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\..\..\src\RimMandrake\Graffiti\Source\ThoughtWorker_ViewedGraffitiMark.cs" />
    <Compile Include="..\..\..\..\src\RimMandrake\Graffiti\Source\Kernel\RM_GraffitiKernel.cs" />
    <Compile Include="..\..\..\..\src\RimMandrake\Graffiti\Source\GraffitiForm.cs" />
    <Compile Include="..\..\..\..\src\RimMandrake\Graffiti\Source\GraffitiCategory.cs" />
    <Compile Include="Stubs.cs" />
    <Compile Include="Scenarios.cs" />
  </ItemGroup>

</Project>
