  "schemas": {
    "jawa/static_call": {
      "name": "jawa/static_call",
      "title": "Jawa Static Call",
      "description": "Invoke a PUBLIC STATIC method by type FullName + method name, for pure helpers a mod script needs to exercise (e.g. RM_ZennaqLightning.Redirect). args = '|'-separated, coerced by the parameter type: int/float/double/bool/string, IntVec3 as 'x,y,z' (or 'x,z'), Map as 'current' or a map index, ThingDef/any Def by defName, Thing/Pawn (or any Thing subclass) by exact ThingID ('Human123') or bare thingIDNumber, current map first then every map - refused with candidates when absent or not of the parameter's type. Instance methods and overload ambiguity are REFUSED with the candidate signatures. The return value is rendered as text. Runs on the main thread. GM-gated: it can call anything public.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Type.FullName, exact."
          },
          "method": {
            "type": "string",
            "description": "Method name."
          },
          "args": {
            "type": "string",
            "description": "'|'-separated arguments.",
            "default": ""
          }
        },
        "additionalProperties": false
      },
      "parameters": [
        {
          "name": "type",
          "type": "String",
          "description": "Type.FullName, exact.",
          "required": false,
          "defaultValue": null
        },
        {
          "name": "method",
          "type": "String",
          "description": "Method name.",
          "required": false,
          "defaultValue": null
        },
        {
          "name": "args",
          "type": "String",
          "description": "'|'-separated arguments.",
          "required": false,
          "defaultValue": ""
        }
      ],
      "outputSchema": {
        "description": "success, method (signature), result, ticksGame."
      },
      "requiresAuth": false
    },
    "jawa/mod_settings_field": {
      "name": "jawa/mod_settings_field",
      "title": "Jawa Mod Settings Field",
      "description": "Read or write ANY public field (static OR instance) on a mod's ModSettings-derived class by TYPE NAME and field name. BRIDGE_STATIC_SETTINGS_FIELDS_1: rimworld/update_mod_settings only resolves INSTANCE fields and refuses public static ones - most of our own mods' settings classes declare static fields, which that tool cannot touch at all. This tool tries the field as STATIC first; if not found there, falls back to INSTANCE by locating a loaded Mod (assembly-matched to the settings type) whose Mod.GetSettings<T>() resolves it. Values are read/written as their string form and coerced to the field's real type (bool/int/float/double/string/enum only - refuses other types by name rather than guessing a conversion). action='list' (default, typeName only) reports every public field's name/type/kind/current value so a caller can discover names without reading source first.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "typeName": {
            "type": "string",
            "description": "Type.FullName of the settings class, e.g. 'RimMandrake.FlowWorks.RimMandrakeFlowWorksSettings' - exact, not guessed; use action='list' on a near-miss to see what's actually loaded, or jawa/get_defs-adjacent source reading to confirm the real namespace."
          },
          "action": {
            "type": "string",
            "description": "'list' (default), 'get', or 'set'.",
            "default": "list"
          },
          "field": {
            "type": "string",
            "description": "get/set: the field name."
          },
          "value": {
            "type": "string",
            "description": "set: the value as a string, coerced to the field's real type ('true'/'false' for bool, parsed for numeric, verbatim for string, name for enum)."
          }
        },
        "additionalProperties": false
      },
      "parameters": [
        {
          "name": "typeName",
          "type": "String",
          "description": "Type.FullName of the settings class, e.g. 'RimMandrake.FlowWorks.RimMandrakeFlowWorksSettings' - exact, not guessed; use action='list' on a near-miss to see what's actually loaded, or jawa/get_defs-adjacent source reading to confirm the real namespace.",
          "required": false,
          "defaultValue": null
        },
        {
          "name": "action",
          "type": "String",
          "description": "'list' (default), 'get', or 'set'.",
          "required": false,
          "defaultValue": "list"
        },
        {
          "name": "field",
          "type": "String",
          "description": "get/set: the field name.",
          "required": false,
          "defaultValue": null
        },
        {
          "name": "value",
          "type": "String",
          "description": "set: the value as a string, coerced to the field's real type ('true'/'false' for bool, parsed for numeric, verbatim for string, name for enum).",
          "required": false,
          "defaultValue": null
        }
      ],
      "outputSchema": {
        "description": "list: success, fields[] (name, type, kind, value). get: success, field, fieldKind, value. set: success, field, fieldKind, valueBefore, valueAfter."
