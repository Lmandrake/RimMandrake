					</li>
					<li>
						<foundation Class="IdeoFoundation_Deity">
							<def>Deity</def>
							<place>Nuchadus</place>
							<deities>
								<li>
									<name>Soma</name>
									<type>Moon God</type>
									<gender>Female</gender>
									<iconPath>UI/Deities/DeityGeneric</iconPath>
									<relatedMeme>Structure_OriginHindu</relatedMeme>
								</li>
								<li>
									<name>Varuna</name>
									<type>Sky God</type>
									<gender>Female</gender>
									<iconPath>UI/Deities/DeityGeneric</iconPath>
									<relatedMeme>Supremacist</relatedMeme>
								</li>
								<li>
									<name>Vishnu</name>
									<type>God of Preservation</type>
									<gender>Male</gender>
									<iconPath>UI/Deities/DeityGeneric</iconPath>
									<relatedMeme>Structure_OriginHindu</relatedMeme>
								</li>
								<li>
									<name>Aranyani</name>
									<type>Forest God</type>
									<gender>Male</gender>
									<iconPath>UI/Deities/DeityGeneric</iconPath>
									<relatedMeme>Supremacist</relatedMeme>
								</li>
							</deities>
						</foundation>
						<name>Strong Legion</name>
						<adjective>Somaic</adjective>
						<memberName>Somaist</memberName>
						<leaderTitleMale>Yogic Pandit</leaderTitleMale>
						<leaderTitleFemale>Yogic Pandit</leaderTitleFemale>
						<description>The people of the dim volcano-world Nuchadus, both Somaists and others, lived in peace for many years under the watchful eye of &lt;color=#D09B61FF&gt;Soma&lt;/color&gt;. A lava lord passed a law forbidding Somaists from rising to the ruling classes of Nuchadus. A hero named Druschtje 'Forrix' Scholty tried to assassinate the lava lord. She failed, but &lt;color=#D09B61FF&gt;Soma&lt;/color&gt; witnessed Forrix's struggle, and anointed her as the prophet of the Somaists. Forrix destroyed the capital of Nuchadus with an archotech-induced volcano eruption, killing the lava lord. She took her place as ruler of Nuchadus - and the universe beyond.</description>
						<descriptionTemplate>The people of the dim volcano-world Nuchadus, both %%memberNamePlural%% and others, lived in peace for many years under the watchful eye of %%deity0_name%%. A lava lord passed a law forbidding %%memberNamePlural%% from rising to the ruling classes of Nuchadus. A hero named Druschtje 'Forrix' Scholty tried to assassinate the lava lord. She failed, but %%deity0_name%% witnessed Forrix's struggle, and anointed her as the prophet of the %%memberNamePlural%%. Forrix destroyed the capital of Nuchadus with an archotech-induced volcano eruption, killing the lava lord. She took her place as ruler of Nuchadus - and the universe beyond.</descriptionTemplate>
						<culture>Rustican</culture>
						<iconDef>CirclesE</iconDef>
						<colorDef>LightSapphire</colorDef>
						<primaryFactionColor>RGBA(0.423, 0.664, 0.980, 1.000)</primaryFactionColor>
						<memes>
							<li>Structure_OriginHindu</li>
							<li>Supremacist</li>
						</memes>
						<precepts>
							<li>
								<name>execution</name>
								<def>Execution_Required</def>
								<ID>305</ID>
								<randomSeed>1469980513</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li Class="Precept_Ritual">
								<name>Somaic Eulogy</name>
								<def>Funeral</def>
								<ID>306</ID>
								<randomSeed>959780291</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<nameMaker>NamerRitualFuneral</nameMaker>
								<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
								<ritualExpectedDesc>You can hold a {IDEOLIGION_adjective} funeral for {PAWN_nameDef}.</ritualExpectedDesc>
								<ritualExpectedDescNoAdjective>You can hold a funeral for {PAWN_nameDef}.</ritualExpectedDescNoAdjective>
								<playsIdeoMusic>True</playsIdeoMusic>
								<generatedAttachedReward>True</generatedAttachedReward>
								<sourcePattern>FuneralStandard</sourcePattern>
								<obligationTargetFilter Class="RitualObligationTargetWorker_GraveWithTarget">
									<def>GraveWithTargetsCorpse</def>
									<parent>Precept_306</parent>
								</obligationTargetFilter>
								<targetFilter IsNull="True" />
								<behavior Class="RitualBehaviorWorker_Funeral">
									<def>Funeral</def>
								</behavior>
								<triggers>
									<li Class="RitualObligationTrigger_MemberDied">
										<mustBePlayerIdeo>True</mustBePlayerIdeo>
									</li>
								</triggers>
								<outcomeEffect Class="RitualOutcomeEffectWorker_FromQuality">
									<def>AttendedFuneral</def>
									<compDatas>
										<li IsNull="True" />
										<li Class="RitualOutcomeComp_DataThingPresence">
											<presentForTicks>
												<keys />
												<values />
											</presentForTicks>
										</li>
									</compDatas>
								</outcomeEffect>
								<layerWhitelist IsNull="True" />
								<layerBlacklist IsNull="True" />
								<activeObligations IsNull="True" />
								<completedObligations IsNull="True" />
								<lastFinishedTick>-1</lastFinishedTick>
							</li>
							<li Class="Precept_Ritual">
								<name>Supreme Festival</name>
								<def>Festival</def>
								<ID>307</ID>
								<randomSeed>914786005</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<descOverride>A dance party with loud music. Participants will gather, socialize, and dance to have fun and connect with each other.</descOverride>
								<nameMaker>NamerRitualFestival</nameMaker>
								<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
								<ritualExpectedDesc>Every year on {DATE}, {MEMBERS} can have a special celebration.</ritualExpectedDesc>
								<shortDescOverride>dance party</shortDescOverride>
								<iconPathOverride>UI/Icons/Rituals/CelebrationPartyDanceTech</iconPathOverride>
								<patternGroupTag>CelebratedDate</patternGroupTag>
								<minTechLevel>Industrial</minTechLevel>
								<isAnytime>True</isAnytime>
								<canBeAnytime>True</canBeAnytime>
								<generatedAttachedReward>True</generatedAttachedReward>
								<sourcePattern>CelebrationPartyDanceTech</sourcePattern>
								<obligationTargetFilter Class="RitualObligationTargetWorker_LightBall">
									<def>LightBall</def>
									<parent>Precept_307</parent>
								</obligationTargetFilter>
								<targetFilter IsNull="True" />
								<behavior Class="RitualBehaviorWorker_DancePartyTech">
									<def>DancePartyTech</def>
								</behavior>
								<triggers>
									<li Class="RitualObligationTrigger_Date">
										<mustBePlayerIdeo>True</mustBePlayerIdeo>
										<triggerDaysSinceStartOfYear>11</triggerDaysSinceStartOfYear>
									</li>
								</triggers>
								<attachableOutcomeEffect>NearbyFactionGoodwill</attachableOutcomeEffect>
								<outcomeEffect Class="RitualOutcomeEffectWorker_DanceParty">
									<def>CelebrationPartyDanceTech</def>
									<compDatas>
										<li Class="RitualOutcomeComp_DataThingPresence">
											<presentForTicks>
												<keys />
												<values />
											</presentForTicks>
										</li>
										<li Class="RitualOutcomeComp_DataRoomStatCached" />
										<li Class="RitualOutcomeComp_DataThingPresence">
											<presentForTicks>
