					<li>
						<foundation Class="IdeoFoundation_Deity">
							<def>Deity</def>
							<place>Boccocarro</place>
							<deities />
						</foundation>
						<name>Empty Ship</name>
						<adjective>just</adjective>
						<memberName>Justicar</memberName>
						<leaderTitleMale>Moral Leader</leaderTitleMale>
						<leaderTitleFemale>Moral Leader</leaderTitleFemale>
						<description>"In my observances of the cosmos, I have found one truth above all else: Our ships are our holy mothers and sacred fathers. We must care for them as they have cared for us. It is something I'll never forget."

  - Shurik Monol, from the keynote to The Stars Assembly</description>
						<descriptionTemplate>"In my observances of the cosmos, I have found one truth above all else: Our ships are our holy mothers and sacred fathers. We must care for them as they have cared for us. It is something I'll never forget."

  - Shurik Monol, from the keynote to The Stars Assembly</descriptionTemplate>
						<culture>Astropolitan</culture>
						<iconDef>StarsB</iconDef>
						<colorDef>DarkRed</colorDef>
						<primaryFactionColor>RGBA(0.750, 0.500, 0.500, 1.000)</primaryFactionColor>
						<memes>
							<li>Structure_Ideological</li>
							<li>Shipborn</li>
						</memes>
						<precepts>
							<li>
								<name>space habitat</name>
								<def>SpaceHabitat_Preferred</def>
								<ID>561</ID>
								<randomSeed>1299993520</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li Class="Precept_Ritual">
								<name>Stellar Burial</name>
								<def>Funeral</def>
								<ID>562</ID>
								<randomSeed>1725679910</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<nameMaker>NamerRitualFuneral</nameMaker>
								<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
								<ritualExpectedDesc>You can hold a {IDEOLIGION_adjective} funeral for {PAWN_nameDef}.</ritualExpectedDesc>
								<ritualExpectedDescNoAdjective>You can hold a funeral for {PAWN_nameDef}.</ritualExpectedDescNoAdjective>
								<playsIdeoMusic>True</playsIdeoMusic>
								<generatedAttachedReward>True</generatedAttachedReward>
								<sourcePattern>FuneralStandard</sourcePattern>
								<obligationTargetFilter Class="RitualObligationTargetWorker_GraveWithTarget">
									<def>GraveWithTargetsCorpse</def>
									<parent>Precept_562</parent>
								</obligationTargetFilter>
								<targetFilter IsNull="True" />
								<behavior Class="RitualBehaviorWorker_Funeral">
									<def>Funeral</def>
								</behavior>
								<triggers>
									<li Class="RitualObligationTrigger_MemberDied">
										<mustBePlayerIdeo>True</mustBePlayerIdeo>
									</li>
								</triggers>
								<outcomeEffect Class="RitualOutcomeEffectWorker_FromQuality">
									<def>AttendedFuneral</def>
									<compDatas>
										<li IsNull="True" />
										<li Class="RitualOutcomeComp_DataThingPresence">
											<presentForTicks>
												<keys />
												<values />
											</presentForTicks>
										</li>
									</compDatas>
								</outcomeEffect>
								<layerWhitelist IsNull="True" />
								<layerBlacklist IsNull="True" />
								<activeObligations IsNull="True" />
								<completedObligations IsNull="True" />
								<lastFinishedTick>-1</lastFinishedTick>
							</li>
							<li>
								<name>indoors</name>
								<def>Indoors_Acceptable</def>
								<ID>563</ID>
								<randomSeed>-148291942</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li Class="Precept_Ritual">
								<name>Celestial Advent</name>
								<def>Festival</def>
								<ID>564</ID>
								<randomSeed>-717044196</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<descOverride>A social ritual where people release skylanterns. Participants will assemble wooden skylanterns while socializing, then release them and watch them drift away.</descOverride>
								<nameMaker>NamerRitualFestival</nameMaker>
								<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
								<ritualExpectedDesc>Every year on {DATE}, {MEMBERS} can have a special celebration.</ritualExpectedDesc>
								<shortDescOverride>skylantern festival</shortDescOverride>
								<iconPathOverride>UI/Icons/Rituals/CelebrationPartySkylanterns</iconPathOverride>
								<patternGroupTag>CelebratedDate</patternGroupTag>
								<isAnytime>True</isAnytime>
								<canBeAnytime>True</canBeAnytime>
								<playsIdeoMusic>True</playsIdeoMusic>
								<generatedAttachedReward>True</generatedAttachedReward>
								<sourcePattern>CelebrationSkyLanterns</sourcePattern>
								<obligationTargetFilter Class="RitualObligationTargetWorker_SkyLanterns">
									<def>CampfireSkylanterns</def>
									<parent>Precept_564</parent>
								</obligationTargetFilter>
								<targetFilter IsNull="True" />
								<behavior>
									<def>CelebrationSkyLanterns</def>
								</behavior>
								<triggers>
									<li Class="RitualObligationTrigger_Date">
										<mustBePlayerIdeo>True</mustBePlayerIdeo>
										<triggerDaysSinceStartOfYear>42</triggerDaysSinceStartOfYear>
									</li>
								</triggers>
								<attachableOutcomeEffect>RechargePsyfocus</attachableOutcomeEffect>
								<outcomeEffect Class="RitualOutcomeEffectWorker_Skylantern">
									<def>CelebrationSkyLanterns</def>
									<compDatas>
										<li IsNull="True" />
									</compDatas>
								</outcomeEffect>
								<layerWhitelist IsNull="True" />
								<layerBlacklist>
									<li>Orbit</li>
								</layerBlacklist>
