						<id>2</id>
						<development IsNull="True" />
					</li>
					<li>
						<foundation Class="IdeoFoundation_Deity">
							<def>Deity</def>
							<place>Ilwaba</place>
							<deities>
								<li>
									<name>God</name>
									<type>Creator of Everything</type>
									<gender>Male</gender>
									<iconPath>UI/Deities/DeityGeneric</iconPath>
									<relatedMeme>Structure_OriginChristian</relatedMeme>
								</li>
							</deities>
						</foundation>
						<name>Ilwaban Sect</name>
						<adjective>Post-Catholic</adjective>
						<memberName>Post-Catholic</memberName>
						<leaderTitleMale>Divine Chief</leaderTitleMale>
						<leaderTitleFemale>Divine Chief</leaderTitleFemale>
						<description>On the regrown ruin-world Ilwaba there was a &lt;color=#D09B61FF&gt;Pure Emblem&lt;/color&gt; in &lt;color=#D09B61FF&gt;God&lt;/color&gt;'s church, where the Creator of Everything would bless those of pure flesh. Then the crypto-leader came. His crypto-soldiers killed many worshippers of &lt;color=#D09B61FF&gt;God&lt;/color&gt; with scrap-swords. A hero named Miñoca Alpaca tried to assassinate the crypto-leader. She failed, but &lt;color=#D09B61FF&gt;God&lt;/color&gt; witnessed Alpaca's struggle, and anointed her as the prophet of the Post-Catholics. The crypto-leader finally sent crypto-soldiers to kill the Post-Catholics, but &lt;color=#D09B61FF&gt;God&lt;/color&gt;'s energy flowed from the pure flesh of the Post-Catholics, and the devices in the crypto-soldiers' bodies turned to ash and killed them.</description>
						<descriptionTemplate>On the regrown ruin-world Ilwaba there was a %%altar0_name%% in %%deity0_name%%'s %%altarRoomLabel%%, where the %%deity0_type%% would bless those of pure flesh. Then the crypto-leader came. His crypto-soldiers killed many worshippers of %%deity0_name%% with scrap-swords. A hero named Miñoca Alpaca tried to assassinate the crypto-leader. She failed, but %%deity0_name%% witnessed Alpaca's struggle, and anointed her as the prophet of the %%memberNamePlural%%. The crypto-leader finally sent crypto-soldiers to kill the %%memberNamePlural%%, but %%deity0_name%%'s energy flowed from the pure flesh of the %%memberNamePlural%%, and the devices in the crypto-soldiers' bodies turned to ash and killed them.</descriptionTemplate>
						<culture>Corunan</culture>
						<iconDef>Treeflat</iconDef>
						<colorDef>Teal</colorDef>
						<primaryFactionColor>RGBA(0.464, 0.933, 0.490, 1.000)</primaryFactionColor>
						<memes>
							<li>Structure_OriginChristian</li>
							<li>FleshPurity</li>
						</memes>
						<precepts>
							<li>
								<name>body modification</name>
								<def>BodyMod_Abhorrent</def>
								<ID>146</ID>
								<randomSeed>-998445770</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li>
								<name>drug use</name>
								<def>DrugUse_Prohibited</def>
								<ID>147</ID>
								<randomSeed>1344975398</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li>
								<name>organ use</name>
								<def>OrganUse_Abhorrent</def>
								<ID>148</ID>
								<randomSeed>1539212769</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li Class="Precept_Ritual">
								<name>Requiem of Flesh</name>
								<def>Funeral</def>
								<ID>149</ID>
								<randomSeed>-1907480926</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<nameMaker>NamerRitualFuneral</nameMaker>
								<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
								<ritualExpectedDesc>You can hold a {IDEOLIGION_adjective} funeral for {PAWN_nameDef}.</ritualExpectedDesc>
								<ritualExpectedDescNoAdjective>You can hold a funeral for {PAWN_nameDef}.</ritualExpectedDescNoAdjective>
								<playsIdeoMusic>True</playsIdeoMusic>
								<generatedAttachedReward>True</generatedAttachedReward>
								<sourcePattern>FuneralStandard</sourcePattern>
								<obligationTargetFilter Class="RitualObligationTargetWorker_GraveWithTarget">
									<def>GraveWithTargetsCorpse</def>
									<parent>Precept_149</parent>
								</obligationTargetFilter>
								<targetFilter IsNull="True" />
								<behavior Class="RitualBehaviorWorker_Funeral">
									<def>Funeral</def>
								</behavior>
								<triggers>
									<li Class="RitualObligationTrigger_MemberDied">
										<mustBePlayerIdeo>True</mustBePlayerIdeo>
									</li>
								</triggers>
								<outcomeEffect Class="RitualOutcomeEffectWorker_FromQuality">
									<def>AttendedFuneral</def>
									<compDatas>
										<li IsNull="True" />
										<li Class="RitualOutcomeComp_DataThingPresence">
											<presentForTicks>
												<keys />
												<values />
											</presentForTicks>
										</li>
									</compDatas>
								</outcomeEffect>
								<layerWhitelist IsNull="True" />
								<layerBlacklist IsNull="True" />
								<activeObligations IsNull="True" />
								<completedObligations IsNull="True" />
								<lastFinishedTick>-1</lastFinishedTick>
							</li>
							<li Class="Precept_Animal">
								<name>venerated animal</name>
								<def>AnimalVenerated</def>
								<ID>150</ID>
								<randomSeed>168453104</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<thingDef>Lynx</thingDef>
							</li>
							<li Class="Precept_Ritual">
								<name>Pure Fair</name>
								<def>DateRitualConsumable</def>
								<ID>142</ID>
								<randomSeed>-1268240431</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<descOverride>A party around a Christmas tree. Participants will gather around a Christmas tree and make merry.</descOverride>
								<nameMaker>NamerRitualFestival</nameMaker>
								<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
								<ritualExpectedDesc>Every year on {DATE}, {MEMBERS} can have a special celebration.</ritualExpectedDesc>
								<shortDescOverride>christmas tree party</shortDescOverride>
								<iconPathOverride>UI/Icons/Rituals/TreeCelebration</iconPathOverride>
								<patternGroupTag>RitualBuildingConsumer</patternGroupTag>
								<canBeAnytime>True</canBeAnytime>
								<playsIdeoMusic>True</playsIdeoMusic>
								<generatedAttachedReward>True</generatedAttachedReward>
								<sourcePattern>CelebrationTree</sourcePattern>
								<obligationTargetFilter Class="RitualObligationTargetWorker_ConsumableBuilding">
									<def>ChristmasTree</def>
									<parent>Precept_142</parent>
								</obligationTargetFilter>
								<targetFilter IsNull="True" />
								<behavior>
									<def>CelebrationTree</def>
								</behavior>
								<triggers>
									<li Class="RitualObligationTrigger_Date">
										<mustBePlayerIdeo>True</mustBePlayerIdeo>
										<triggerDaysSinceStartOfYear>32</triggerDaysSinceStartOfYear>
									</li>
								</triggers>
								<attachableOutcomeEffect>NearbyFactionGoodwill</attachableOutcomeEffect>
								<outcomeEffect Class="RitualOutcomeEffectWorker_RemoveConsumableBuilding">
									<def>DestroyConsumableBuilding_ChristmasTree</def>
									<compDatas>
										<li Class="RitualOutcomeComp_DataThingPresence">
											<presentForTicks>
												<keys />
												<values />
