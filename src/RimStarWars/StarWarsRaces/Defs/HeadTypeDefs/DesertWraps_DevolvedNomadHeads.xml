<?xml version="1.0" encoding="utf-8" ?>
<!-- DESERT_WRAPS_ART_COMMISSION_1 — new native content, hand-authored (NOT
     part of SW_HeadTypes.xml/SW_Genes.xml, which are GENERATED by
     src/RimMandrake/Utils/gen_races_mod.py and must not be hand-edited —
     same pattern as GeneDefs/Jawa_Head.xml).

     ORIGINAL ART, commissioned from the written design capture
     design/Jawa/desert_wraps_design_capture.md SS2 (prose+numbers only, no
     donor pixels used as an image input anywhere in this pipeline).

     Owner ruling 2026-09-10 (ledger 05:59:13Z): BOTH head shapes ship (1
     "Blunt Bucket Head" and 2 "Elongated Ridged Skull") but as UNWIRED
     OPTIONS ONLY — def + art land here in StarWarsRaces, no xenotype/tribe
     wiring ("don't change our aliens xenotypes yet"). That is enforced here
     by NOT adding RSW_Head_DevolvedNomad_Pot / RSW_Head_DevolvedNomad_Ridged
     to any XenotypeDef's <genes> list or any GeneDef's forcedHeadTypes other
     than their own — both genes below exist but no living pawn in the mod
     set carries either, so forcedHeadTypes never fires. Wiring one onto the
     Jawa tribe (a xenotype gene-list edit) is a separate, later decision.

     🔴 DO NOT confuse these with the PRE-EXISTING RSW_Head_Devolved gene /
     RSW_Male_DevolvedNormal / RSW_Female_DevolvedNormal HeadTypeDefs in
     SW_HeadTypes.xml + SW_Genes.xml — those point at
     RimMandrakeSW/SWX/Pawn/HeadType/Sov_tusken/HeadSandM|F, absorbed from
     guy762's "Star Wars Xenotypes" mod under an earlier, separate wave, and
     ARE already wired into a shipped xenotype (RimMandrakeXenotypes.xml,
     the RSW_GS_Primitive-carrying xenotype). That is unrelated pre-existing
     content; this commission's two new head shapes use distinct defNames
     (…DevolvedNomad_Pot / …DevolvedNomad_Ridged) specifically so they cannot
     collide with it. -->
<Defs>

  <HeadTypeDef Name="RimMandrake_DevolvedNomadPotBase" Abstract="True">
    <randomChosen>false</randomChosen>
    <requiredGenes>
      <li>RSW_Head_DevolvedNomad_Pot</li>
    </requiredGenes>
  </HeadTypeDef>
  <HeadTypeDef ParentName="RimMandrake_DevolvedNomadPotBase">
    <defName>RSW_Male_DevolvedNomad_Pot</defName>
    <graphicPath>RimMandrakeSW/SWX/Pawn/HeadType/desert_nomad/HeadPot</graphicPath>
    <gender>Male</gender>
  </HeadTypeDef>
  <HeadTypeDef ParentName="RimMandrake_DevolvedNomadPotBase">
    <defName>RSW_Female_DevolvedNomad_Pot</defName>
    <graphicPath>RimMandrakeSW/SWX/Pawn/HeadType/desert_nomad/HeadPot</graphicPath>
    <gender>Female</gender>
  </HeadTypeDef>

  <HeadTypeDef Name="RimMandrake_DevolvedNomadRidgedBase" Abstract="True">
    <randomChosen>false</randomChosen>
    <requiredGenes>
      <li>RSW_Head_DevolvedNomad_Ridged</li>
    </requiredGenes>
  </HeadTypeDef>
  <HeadTypeDef ParentName="RimMandrake_DevolvedNomadRidgedBase">
    <defName>RSW_Male_DevolvedNomad_Ridged</defName>
    <graphicPath>RimMandrakeSW/SWX/Pawn/HeadType/desert_nomad/HeadRidged</graphicPath>
    <gender>Male</gender>
  </HeadTypeDef>
  <HeadTypeDef ParentName="RimMandrake_DevolvedNomadRidgedBase">
    <defName>RSW_Female_DevolvedNomad_Ridged</defName>
    <graphicPath>RimMandrakeSW/SWX/Pawn/HeadType/desert_nomad/HeadRidged</graphicPath>
    <gender>Female</gender>
  </HeadTypeDef>

  <GeneDef ParentName="GeneJawBase">
    <defName>RSW_Head_DevolvedNomad_Pot</defName>
    <label>devolved nomad head (blunt)</label>
    <description>Carriers of this gene have a blunt, flat-crowned, heavy-jawed facial appearance -- a devolved desert-nomad head shape, distinct from the mod's other devolved head. UNWIRED: no xenotype currently carries this gene.</description>
    <iconPath>UI/Icons/Genes/Gene_Hair</iconPath>
    <forcedHeadTypes>
      <li>RSW_Male_DevolvedNomad_Pot</li>
      <li>RSW_Female_DevolvedNomad_Pot</li>
    </forcedHeadTypes>
    <statFactors>
    </statFactors>
    <displayOrderInCategory>97</displayOrderInCategory>
    <exclusionTags>
      <li>Jaw</li>
    </exclusionTags>
  </GeneDef>

  <GeneDef ParentName="GeneJawBase">
    <defName>RSW_Head_DevolvedNomad_Ridged</defName>
    <label>devolved nomad head (ridged)</label>
    <description>Carriers of this gene have a low sloping cranium and a heavy bony brow ridge continuous with the skull -- a devolved desert-nomad head shape, distinct from the mod's other devolved head. UNWIRED: no xenotype currently carries this gene.</description>
    <iconPath>UI/Icons/Genes/Gene_Hair</iconPath>
    <forcedHeadTypes>
      <li>RSW_Male_DevolvedNomad_Ridged</li>
      <li>RSW_Female_DevolvedNomad_Ridged</li>
    </forcedHeadTypes>
    <statFactors>
    </statFactors>
    <displayOrderInCategory>97</displayOrderInCategory>
    <exclusionTags>
      <li>Jaw</li>
    </exclusionTags>
  </GeneDef>

</Defs>
