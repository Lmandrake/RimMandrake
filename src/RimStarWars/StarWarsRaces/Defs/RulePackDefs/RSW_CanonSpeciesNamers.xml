<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Species name-makers for the xenotypes that had none (XENOTYPE_CANON_CORRECTION_1).
       Word lists are the named individuals of each Wookieepedia species category
       (Category:<species>; Gungans = its three race subcategories), species without a surname
       pool of 15 also draw surnames from the given-name pool (mononym cultures).
       fetched 2026-10-26 through the MediaWiki categorymembers API, split first/last token.
       Removed: Unidentified/relational titles, callsigns, English-word nicknames, real-world
       tribute names, and headline characters (Ackbar, Raddus, Plo Koon, Saesee Tiin, Grievous, Kuiil, Jar Jar, Ki-Adi-Mundi...).
       Hand-authored; gen_races_mod.py wires them through OWNER_NAMERS and does not rewrite this file. -->
  <RulePackDef>
    <defName>RSW_NamerIthorian</defName>
    <rulePack>
      <rulesStrings>
        <li>r_name-&gt;[firstName] [lastName]</li>
        <li>firstName-&gt;[NameIthorian]</li>
        <li>lastName-&gt;[lastGenerated]</li>
        <li>lastGenerated-&gt;[LastNameIthorian]</li>
      </rulesStrings>
      <rulesRaw>
        <li Class="Rule_File">
          <keyword>NameIthorian</keyword>
          <path>RimMandrakeSWNames/Canon/Ithorian/First</path>
        </li>
        <li Class="Rule_File">
          <keyword>LastNameIthorian</keyword>
          <path>RimMandrakeSWNames/Canon/Ithorian/Last</path>
        </li>
      </rulesRaw>
    </rulePack>
  </RulePackDef>
