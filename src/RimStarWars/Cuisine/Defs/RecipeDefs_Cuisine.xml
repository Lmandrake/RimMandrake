<?xml version="1.0" encoding="utf-8"?>
<!--
  Absorbed from badoaks.meatonastick + badoaks.meatonastick.expansion per
  STICK_FOOD_INGEST_1. CookMealBase is a real vanilla Core RecipeDef,
  confirmed on disk before use.

  IngredientValueGetter_ExcludeSkewer replaces the donor expansion's
  un-sourced MOAS_Expansion.IngredientValueGetter_MeatlessStick - see that
  C# file's header for why it's a reconstruction, not a byte-for-byte port.

  Moved here from the standalone src/RimUtinni/StickCuisine/ mod, owner
  ruling 2026-09-05 - see ThingDefs_Cuisine.xml's header for why.
-->
<Defs>

  <RecipeDef>
    <defName>RSW_CookRoastOnAStick</defName>
    <label>cook roast on a stick</label>
    <description>Cook raw meat, fish or vegetables over an open fire.</description>
    <jobString>Roasting food on a stick.</jobString>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <requiredGiverWorkType>BasicWorker</requiredGiverWorkType>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredientValueGetterClass>RimMandrake.StarWars.Cuisine.IngredientValueGetter_ExcludeSkewer</ingredientValueGetterClass>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>MeatRaw</li>
            <li>Fish</li>
            <li>PlantFoodRaw</li>
          </categories>
        </filter>
        <count>0.5</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>RSW_Skewer</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>MeatRaw</li>
        <li>Fish</li>
        <li>PlantFoodRaw</li>
      </categories>
      <disallowedCategories>
        <li>AnimalProductRaw</li>
      </disallowedCategories>
    </fixedIngredientFilter>
    <products>
      <RSW_RoastOnAStick>1</RSW_RoastOnAStick>
    </products>
    <workSkill>Cooking</workSkill>
    <displayPriority>95</displayPriority>
    <recipeUsers>
      <li>Campfire</li>
    </recipeUsers>
  </RecipeDef>

  <RecipeDef>
    <defName>RSW_CookRoastOnAStick4</defName>
    <label>cook roast on a stick x4</label>
    <description>Cook raw meat, fish or vegetables over an open fire.</description>
    <jobString>Roasting food on a stick.</jobString>
    <workAmount>760</workAmount>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <requiredGiverWorkType>BasicWorker</requiredGiverWorkType>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredientValueGetterClass>RimMandrake.StarWars.Cuisine.IngredientValueGetter_ExcludeSkewer</ingredientValueGetterClass>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>MeatRaw</li>
            <li>Fish</li>
            <li>PlantFoodRaw</li>
          </categories>
        </filter>
        <count>2.0</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>RSW_Skewer</li>
          </thingDefs>
        </filter>
        <count>4</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>MeatRaw</li>
        <li>Fish</li>
        <li>PlantFoodRaw</li>
      </categories>
      <disallowedCategories>
        <li>AnimalProductRaw</li>
      </disallowedCategories>
    </fixedIngredientFilter>
    <products>
      <RSW_RoastOnAStick>4</RSW_RoastOnAStick>
    </products>
    <workSkill>Cooking</workSkill>
    <displayPriority>96</displayPriority>
    <recipeUsers>
      <li>Campfire</li>
    </recipeUsers>
  </RecipeDef>

  <!-- Skewer crafting -->
  <RecipeDef>
    <defName>RSW_CraftSkewers</defName>
    <label>make skewer sticks from a log</label>
    <description>Make skewer sticks from a log.</description>
    <displayPriority>1</displayPriority>
    <workAmount>300</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Smelt</effectWorking>
    <soundWorking>Recipe_Sculpt</soundWorking>
    <jobString>Cutting wood into sticks.</jobString>
    <workSkill>Crafting</workSkill>
    <recipeUsers>
      <li>CraftingSpot</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <stuffCategoriesToAllow>
            <li>Woody</li>
          </stuffCategoriesToAllow>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <stuffCategoriesToAllow>
        <li>Woody</li>
      </stuffCategoriesToAllow>
    </fixedIngredientFilter>
    <products>
      <RSW_Skewer>10</RSW_Skewer>
    </products>
  </RecipeDef>

</Defs>
