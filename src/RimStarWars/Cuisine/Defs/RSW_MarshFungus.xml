<?xml version="1.0" encoding="utf-8"?>
<!-- MIASMA_ROTTING_BED_CUISINE_1. Marsh fungus is canon (Wookieepedia "Marsh fungi": a fungus of Dagobah's swamps that Yoda
     kept in his pantry and mashed into a sweet, creamy yogurt; source Star Wars: Absolutely Everything You Need to Know, 2015),
     found by the search API before inventing a name. It is what a spent Miasma decay cell (RM_RottingBed) grows: the
     cross-tier wiring is Patches/RSW_RottingBed_MarshFungus.xml, guarded on mandrake.rm.miasma.
     It is PlantFoodRaw (through RSW_CultureStarters, a child of PlantFoodRaw) so RSW_CookFungusOnAStick and vanilla cooking
     take it today; RSW_CultureStarters is the tag the hazard-pantry and the fermentation crock will read when those rungs
     of high_cuisine_deep_design.md land. Numbers // INVENTED. ART: placeholder = vanilla raw fungus, tinted; own art is an
     artpipe job (RSW_MarshFungus). -->
<Defs>
  <ThingCategoryDef>
    <defName>RSW_CultureStarters</defName>
    <label>culture starters</label>
    <parent>PlantFoodRaw</parent>
  </ThingCategoryDef>

  <ThingDef ParentName="PlantFoodRawBase">
    <defName>RSW_MarshFungus</defName>
    <label>marsh fungus</label>
    <description>A pale, rubbery swamp fungus that grows best in warm rot. Bland and a little sour raw; mashed, it turns into a sweet, creamy paste that hermits on swamp worlds eat like yogurt. Cooks well on a stick, and makes a good starter for anything left to ferment.</description>
    <graphicData>
      <texPath>Things/Item/Resource/PlantFoodRaw/RawFungus</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(170,185,140)</color>
    </graphicData>
    <statBases>
      <MarketValue>1.4</MarketValue>
      <Mass>0.03</Mass>
      <Nutrition>0.05</Nutrition>
      <DeteriorationRate>6</DeteriorationRate>
      <FoodPoisonChanceFixedHuman>0.03</FoodPoisonChanceFixedHuman>
    </statBases>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>20</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <ingestible>
      <preferability>RawBad</preferability>
      <tasteThought>AteRawFood</tasteThought>
      <foodType>Fungus</foodType>
    </ingestible>
    <ingredient>
      <mergeCompatibilityTags>
        <li MayRequire="Ludeon.RimWorld.Ideology">Fungus</li>
      </mergeCompatibilityTags>
    </ingredient>
    <thingCategories Inherit="False">
      <li>RSW_CultureStarters</li>
    </thingCategories>
  </ThingDef>
</Defs>
