    <label>make carbonite charges</label>
    <description>Mix chemfuel and uranium into two carbonite charges, one per carbon-freezing batch.</description>
    <jobString>Mixing carbonite charges.</jobString>
    <workAmount>800</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Chemfuel</li>
          </thingDefs>
        </filter>
        <count>25</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Uranium</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Chemfuel</li>
        <li>Uranium</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <RSW_CarboniteCharge>2</RSW_CarboniteCharge>
    </products>
    <recipeUsers>
      <li>RSW_CarbonFreezingPress</li>
    </recipeUsers>
    <researchPrerequisite>RSW_CarbonFreezing</researchPrerequisite>
    <modExtensions>
      <li Class="RimMandrake.ColdStorage.ColdStorageGateExtension">
        <gate>External</gate>
        <settingField>RimMandrake.StarWars.Cuisine.RSW_CuisineSettings:carbonPressEnabled</settingField>
      </li>
    </modExtensions>
  </RecipeDef>

