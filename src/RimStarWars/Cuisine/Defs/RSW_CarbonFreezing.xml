          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>RSW_CarboniteCharge</li>
      </thingDefs>
      <categories>
        <li>FoodMeals</li>
      </categories>
      <disallowedThingDefs>
        <li>RSW_CarbonBurntMeal</li>
