  <RecipeDef ParentName="RSW_CarbonFreezeRecipeBase" MayRequire="mandrake.rm.coldstorage">
    <defName>RSW_CarbonThaw</defName>
    <label>thaw carbonite pack</label>
    <description>Thaw a carbonite pack and take out what it holds, exactly as it went in. A cooked meal may come out carbon-burnt.</description>
    <jobString>Thawing a carbonite pack.</jobString>
    <workAmount>300</workAmount>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>RSW_CarbonitePack_Meat</li>
            <li>RSW_CarbonitePack_Fish</li>
            <li>RSW_CarbonitePack_Produce</li>
            <li>RSW_CarbonitePack_Meal</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>RSW_CarbonitePack_Meat</li>
        <li>RSW_CarbonitePack_Fish</li>
        <li>RSW_CarbonitePack_Produce</li>
        <li>RSW_CarbonitePack_Meal</li>
      </thingDefs>
    </fixedIngredientFilter>
    <modExtensions>
      <li Class="RimMandrake.ColdStorage.ColdStorageEncaseExtension">
        <mode>Release</mode>
        <shockedMealInto>RSW_CarbonBurntMeal</shockedMealInto>
        <shockChance>0.05</shockChance>
        <shockChanceSettingField>RimMandrake.StarWars.Cuisine.RSW_CuisineSettings:carbonShockChance</shockChanceSettingField>
      </li>
      <li Class="RimMandrake.ColdStorage.ColdStorageGateExtension">
        <gate>External</gate>
        <settingField>RimMandrake.StarWars.Cuisine.RSW_CuisineSettings:carbonPressEnabled</settingField>
      </li>
    </modExtensions>
  </RecipeDef>

  <RecipeDef MayRequire="mandrake.rm.coldstorage">
