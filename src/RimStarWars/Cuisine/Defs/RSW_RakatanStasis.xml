    </graphicData>
    <size>(1,2)</size>
    <rotatable>true</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>42</pathCost>
    <fillPercent>0.5</fillPercent>
    <castEdgeShadows>true</castEdgeShadows>
    <canOverlapZones>false</canOverlapZones>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <Mass>60</Mass>
      <Flammability>0</Flammability>
      <MarketValue>250</MarketValue>
      <Beauty>-5</Beauty>
    </statBases>
    <replaceTags>
      <li>RSW_RakatanStasisCasket</li>
    </replaceTags>
    <tradeability>Sellable</tradeability>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
  </ThingDef>

  <ThingDef ParentName="RSW_RakatanStasisCasketBase" MayRequire="mandrake.rm.coldstorage">
    <defName>RSW_RakatanStasisCasket_Kludged</defName>
    <label>kludged Rakatan stasis casket</label>
    <description>A Rakatan stasis casket from the frozen vaults of Belsavis: a coffin-sized chamber that wraps what it holds in a field older than the Republic. Coaxed back to a fifth of its field with ordinary parts, it slows spoiling a little, now and then flickers out for an hour, and drinks five times the power a whole field would.</description>
    <costList>
      <Steel>60</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <graphicData>
      <color>(160,152,140)</color>
    </graphicData>
    <statBases>
      <MarketValue>500</MarketValue>
    </statBases>
    <building>
      <maxItemsInCell>1</maxItemsInCell>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>400</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="RimMandrake.ColdStorage.CompProperties_StorageClimate">
        <mode>Stasis</mode>
        <method>RM_ColdMethod_Stasis</method>
        <stasisRotFactor>0.8</stasisRotFactor>
        <scalePowerByStrength>true</scalePowerByStrength>
        <stasisFlickerMtbHours>24</stasisFlickerMtbHours>
      </li>
    </comps>
  </ThingDef>

