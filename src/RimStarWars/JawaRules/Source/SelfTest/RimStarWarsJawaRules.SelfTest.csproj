<Project Sdk="Microsoft.NET.Sdk">

  <!--
    JawaRules offline fuzz, Approach B (same shape as TheSump/Armoury/SWBestiary). Plain net8.0, zero RimWorld/Unity/Harmony
    references: ../Kernel/*.cs are the PRODUCTION files the mod compiles, pulled in directly. A `using Verse;` landing in one
    of them breaks this build - that is the guard rail working.
    Run (builds on Windows via winbuild staging, then runs the exe):
      python3 src/RimMandrake/Utils/selftest_jawarules_fuzz.py [fuzz knobs]
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RimStarWarsJawaRules.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.StarWars.JawaRules.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Kernel\RSW_JawaRulesKernel.cs" />
    <Compile Include="JawaRulesFuzz.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
