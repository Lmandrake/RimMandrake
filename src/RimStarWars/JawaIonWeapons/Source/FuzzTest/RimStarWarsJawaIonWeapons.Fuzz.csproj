<Project Sdk="Microsoft.NET.Sdk">

  <!--
    JawaIonWeapons offline fuzz, Approach B (same shape as TheSump/Armoury/SWBestiary/JawaRules). Plain net8.0, zero RimWorld/Unity
    references: ../Kernel/*.cs is the PRODUCTION file the main assembly and the vehicle-tier assembly compile, pulled in directly. A
    `using Verse;` landing in it breaks this build - that is the guard rail working. (The older ../SelfTest project is a net472
    console app that DOES reference the game and compiles the real StatPart; it is run by selftest_stun_scaling.py.)
    Run (builds on Windows via winbuild staging, then runs the exe):
      python3 src/RimMandrake/Utils/selftest_jawaionweapons_fuzz.py [fuzz knobs]
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RimStarWarsJawaIonWeapons.Fuzz</AssemblyName>
    <RootNamespace>RimMandrake.StarWars.JawaIonWeapons.Fuzz</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Kernel\RSW_IonBuildupKernel.cs" />
    <Compile Include="IonFuzz.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
