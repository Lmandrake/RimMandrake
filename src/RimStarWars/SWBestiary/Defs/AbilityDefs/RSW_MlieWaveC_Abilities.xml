<?xml version="1.0" encoding="utf-8"?>
<!--
  MLIE_FAUNA_ABSORPTION_1 Wave C — Beldon's special-trainable ability
  (soothing song). An Odyssey-DLC animal-command ability (MayRequire
  preserved from the donor); the game is whole without Odyssey, Beldon just
  loses the special-trainable gizmo, same as every other Odyssey-gated
  animal ability in this mod.

  Ported verbatim from mlie.starwarsanimalcollection's
  AbilityDefs/SW_Abilities.xml (`SW_SootheSong`, an AbilityDef + HediffDef +
  TrainableDef trio sharing one defName in the donor, same pattern as
  RSW_SW_Rampage/RSW_SW_Spur in RSW_MlieWaveB_Abilities.xml) — renamed
  RSW_SW_SootheSong throughout. soundCast repoints to RSW_Ability_SootheSong
  (already absorbed in the 589-sound wave, 2026-09-02). The HediffDef's
  RecoveryThought (`SoothingSong`) is donor content too, ported this same
  pass as RSW_SoothingSong (RSW_Bantha_Thoughts.xml). effecterDef
  (WarTrumpet), fleckDef (PsycastPsychicEffect), and the
  CompProperties_AbilityAnimalRoar/_AbilityEffecterOnCaster/
  _AbilityFleckOnTarget/_AbilityGiveHediff/_AbilityRequiresTrainable comp
  classes are Core/Odyssey vanilla — nothing here still points at the donor.

  Pass 12 addition (GreaterKraytDragon, 2026-09-18): `SW_Calamity`, another
  AbilityDef + HediffDef + TrainableDef trio sharing one defName in the
  donor (same file), renamed RSW_SW_Calamity throughout. Referenced
  directly off RSW_GreaterKraytDragon's PawnKindDef `<abilities>` (not just
  `specialTrainables`, unlike every other Wave C ability so far) - kept the
  same wiring. soundCast repoints to RSW_Ability_Calamity (already absorbed
  in the 589-sound wave, 2026-09-02). The HediffDef (`SW_BeastRoar` in the
  donor, renamed RSW_SW_BeastRoar) has no RecoveryThought, unlike
  SootheSong - a plain capacity-debuff hediff, ported verbatim. effecterDef
  (WarTrumpet), stateDef (Terror), and every comp class are Core/Odyssey
  vanilla - nothing here still points at the donor.

  Pass 13 addition (Kinrath, 2026-09-18): `SW_WebShot`, a FOUR-def group in
  the donor (unlike every prior Wave C ability's trio) — AbilityDef +
  HediffDef (`SW_Webbed`) + TrainableDef sharing one defName, PLUS a
  `BaseBullet`-parented projectile ThingDef (`SW_WebShotprojectile`) the
  AbilityDef's `CompProperties_AbilityLaunchProjectile` references — renamed
  RSW_SW_WebShot / RSW_SW_Webbed / RSW_SW_WebShotprojectile throughout.
  soundCast repoints to the already-absorbed `RSW_Ability_WebShot` (589-sound
  wave, 2026-09-02). `warmupStartSound` (`AcidSpray_Warmup`) is vanilla
  Anomaly content, confirmed absent from the donor's own SoundDefs — left
  bare. The HediffDef's RecoveryThought (`Webbed`) is donor content, ported
  this same pass as `RSW_Webbed` (RSW_Bantha_Thoughts.xml, a plain -3 mood
  debuff, not a taste thought like its siblings there). Icon
  (`Ability_AnimalWeb`, 128x128) and the projectile's own texture (`WebShot`,
  128x128, `UI/Abilities/WebShot`) both newly extracted this pass — neither
  has a sibling `*ArtOverride` mod, same as `Ability_AnimalCalamity` (Pass
  12). Wired directly off `RSW_Kinrath`'s PawnKindDef `<abilities>` AND its
  ThingDef's `<race><specialTrainables>` (the donor's own Kinrath references
  it both ways, same dual-wiring GreaterKraytDragon's `SW_Calamity` used).
-->
<Defs>
<AbilityDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>RSW_SW_SootheSong</defName>
    <label>soothing song</label>
    <description>Release a calming song which can boost the mood nearby humans.</description>
    <iconPath>UI/Abilities/Ability_AnimalSootheSong</iconPath>
    <cooldownTicksRange>60000</cooldownTicksRange>
    <!-- 24 hours -->
    <stunTargetWhileCasting>True</stunTargetWhileCasting>
    <targetRequired>false</targetRequired>
    <displayOrder>300</displayOrder>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <statBases>
      <Ability_EffectRadius>23.9</Ability_EffectRadius>
    </statBases>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>8.9</range>
      <warmupTime>0.5</warmupTime>
      <requireLineOfSight>false</requireLineOfSight>
      <soundCast>RSW_Ability_SootheSong</soundCast>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
        <canTargetHumans>true</canTargetHumans>
        <canTargetLocations>false</canTargetLocations>
        <canTargetAnimals>false</canTargetAnimals>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetEntities>False</canTargetEntities>
        <canTargetSubhumans>False</canTargetSubhumans>
        <canTargetMechs>false</canTargetMechs>
        <neverTargetHostileFaction>True</neverTargetHostileFaction>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityAnimalRoar">
        <chanceFromHearingCurve>
          <points>
            <li>(0.0, 0.0)</li>
            <li>(0.8, 1.0)</li>
          </points>
        </chanceFromHearingCurve>
      </li>
      <li Class="CompProperties_AbilityEffecterOnCaster">
        <effecterDef>WarTrumpet</effecterDef>
        <maintainTicks>20</maintainTicks>
        <!-- Long enough for the "2nd wave" to spawn -->
      </li>
      <li Class="CompProperties_AbilityFleckOnTarget">
        <fleckDef>PsycastPsychicEffect</fleckDef>
      </li>
      <li Class="CompProperties_AbilityGiveHediff">
        <compClass>CompAbilityEffect_GiveHediff</compClass>
        <hediffDef>RSW_SW_SootheSong</hediffDef>
        <replaceExisting>true</replaceExisting>
      </li>
      <li Class="CompProperties_AbilityRequiresTrainable">
        <trainableDef>RSW_SW_SootheSong</trainableDef>
        <aiCanCastWithoutTrainable>true</aiCanCastWithoutTrainable>
      </li>
    </comps>
  </AbilityDef>
<HediffDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>RSW_SW_SootheSong</defName>
    <label>soothing song</label>
    <description>This person has been heard the beautiful call of a majestic creature.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>30000~60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="HediffCompProperties_RecoveryThought">
        <thought>RSW_SoothingSong</thought>
      </li>
    </comps>
  </HediffDef>
<TrainableDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>RSW_SW_SootheSong</defName>
    <label>soothe song</label>
    <description>Command the creature to emit a soothing song to calm nearby colonists.</description>
    <listPriority>0</listPriority>
    <difficulty>200</difficulty>
    <steps>2</steps>
    <specialTrainable>true</specialTrainable>
    <enablesAbility>RSW_SW_SootheSong</enablesAbility>
  </TrainableDef>
<AbilityDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>RSW_SW_Calamity</defName>
    <label>calamity</label>
    <description>Release a powerful roar which has a chance to cause hostile humans and animals to tremble in fear, reducing their movement speed and manipulation; usually resulting in calamity on the battlefield.</description>
    <iconPath>UI/Abilities/Ability_AnimalCalamity</iconPath>
    <cooldownTicksRange>7500</cooldownTicksRange>
    <!-- 3 hours -->
    <stunTargetWhileCasting>True</stunTargetWhileCasting>
    <targetRequired>false</targetRequired>
    <displayOrder>300</displayOrder>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <statBases>
      <Ability_EffectRadius>23.9</Ability_EffectRadius>
    </statBases>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>23.9</range>
      <warmupTime>0.5</warmupTime>
      <requireLineOfSight>false</requireLineOfSight>
      <soundCast>RSW_Ability_Calamity</soundCast>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetHumans>true</canTargetHumans>
        <canTargetEntities>False</canTargetEntities>
        <canTargetSubhumans>False</canTargetSubhumans>
        <canTargetMechs>false</canTargetMechs>
        <canTargetBuildings>false</canTargetBuildings>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityEffect">
        <compClass>CompAbilityEffect_OnlyTargetHostiles</compClass>
      </li>
      <li Class="CompProperties_AbilityGiveMentalState">
        <compClass>CompAbilityEffect_GiveMentalState</compClass>
        <stateDef>Terror</stateDef>
      </li>
      <li Class="CompProperties_AbilityAnimalRoar">
        <chanceFromHearingCurve>
          <points>
            <li>(0.0, 0.0)</li>
            <li>(0.8, 1.0)</li>
          </points>
        </chanceFromHearingCurve>
      </li>
      <li Class="CompProperties_AbilityEffecterOnCaster">
        <effecterDef>WarTrumpet</effecterDef>
        <maintainTicks>20</maintainTicks>
        <!-- Long enough for the "2nd wave" to spawn -->
      </li>
      <li Class="CompProperties_AbilityGiveHediff">
        <compClass>CompAbilityEffect_GiveHediff</compClass>
        <hediffDef>RSW_SW_BeastRoar</hediffDef>
        <durationSecondsOverride>20~30</durationSecondsOverride>
      </li>
      <li Class="CompProperties_AbilityRequiresTrainable">
        <trainableDef>RSW_SW_Calamity</trainableDef>
        <aiCanCastWithoutTrainable>true</aiCanCastWithoutTrainable>
      </li>
    </comps>
  </AbilityDef>
<HediffDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>RSW_SW_BeastRoar</defName>
    <label>terrifying roar</label>
    <hediffClass>HediffWithComps</hediffClass>
    <description>This creature has been shaken by the powerful roar of a colossal creature.</description>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <postFactor>0.9</postFactor>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <postFactor>0.8</postFactor>
          </li>
          <li>
            <capacity>Moving</capacity>
            <postFactor>0.7</postFactor>
          </li>
          <li>
            <capacity>Hearing</capacity>
            <postFactor>0.25</postFactor>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
<TrainableDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>RSW_SW_Calamity</defName>
    <label>calamity</label>
    <description>Command the creature to emit a beastly roar to create calamity and fear in nearby enemies.</description>
    <listPriority>0</listPriority>
    <difficulty>200</difficulty>
    <steps>2</steps>
    <specialTrainable>true</specialTrainable>
    <enablesAbility>RSW_SW_Calamity</enablesAbility>
  </TrainableDef>
<AbilityDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>RSW_SW_WebShot</defName>
    <label>web shot</label>
    <description>Use the creatures spinneret to launch a blob of hardened webbing, damaging and stunning a target.</description>
    <iconPath>UI/Abilities/Ability_AnimalWeb</iconPath>
    <cooldownTicksRange>2500</cooldownTicksRange>
    <!-- 1 hours -->
    <displayOrder>200</displayOrder>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <warmupStartSound>AcidSpray_Warmup</warmupStartSound>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>8.9</range>
      <warmupTime>0.5</warmupTime>
      <requireLineOfSight>true</requireLineOfSight>
      <soundCast>RSW_Ability_WebShot</soundCast>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetLocations>false</canTargetLocations>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetHumans>true</canTargetHumans>
        <canTargetEntities>true</canTargetEntities>
        <canTargetSubhumans>False</canTargetSubhumans>
        <canTargetMechs>true</canTargetMechs>
        <canTargetSelf>false</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityRequiresTrainable">
        <trainableDef>RSW_SW_WebShot</trainableDef>
        <aiCanCastWithoutTrainable>true</aiCanCastWithoutTrainable>
      </li>
      <li Class="CompProperties_AbilityGiveHediff">
        <compClass>CompAbilityEffect_GiveHediff</compClass>
        <hediffDef>RSW_SW_Webbed</hediffDef>
        <replaceExisting>true</replaceExisting>
      </li>
      <li Class="CompProperties_AbilityLaunchProjectile">
        <projectileDef>RSW_SW_WebShotprojectile</projectileDef>
      </li>
    </comps>
  </AbilityDef>
<ThingDef ParentName="BaseBullet">
    <defName>RSW_SW_WebShotprojectile</defName>
    <label>shot web</label>
    <graphicData>
      <texPath>UI/Abilities/WebShot</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Stun</damageDef>
      <damageAmountBase>20</damageAmountBase>
      <armorPenetrationBase>1</armorPenetrationBase>
      <stoppingPower>1</stoppingPower>
      <speed>55</speed>
    </projectile>
  </ThingDef>
<HediffDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>RSW_SW_Webbed</defName>
    <label>webbed</label>
    <description>This person has been webbed by a creature.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>2500</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="HediffCompProperties_RecoveryThought">
        <thought>RSW_Webbed</thought>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Manipulation</capacity>
            <postFactor>0.8</postFactor>
          </li>
          <li>
            <capacity>Moving</capacity>
            <postFactor>0.7</postFactor>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
<TrainableDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>RSW_SW_WebShot</defName>
    <label>web shot</label>
    <description>Command the creature to shoot a blob of hardened silk webbing at a target.</description>
    <listPriority>0</listPriority>
    <difficulty>200</difficulty>
    <steps>2</steps>
    <specialTrainable>true</specialTrainable>
    <enablesAbility>RSW_SW_WebShot</enablesAbility>
  </TrainableDef>
</Defs>
