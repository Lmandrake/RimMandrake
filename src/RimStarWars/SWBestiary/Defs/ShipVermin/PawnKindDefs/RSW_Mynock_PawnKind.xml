<?xml version="1.0" encoding="utf-8" ?>
<!-- SHIP_VERMIN_MOD_1 - see ThingDefs_Races/RSW_Mynock.xml's header. Same
     shape as PawnKindDefs_Onnik.xml (ParentName AnimalKindBase, Graphic_Multi
     per lifeStage). wildGroupSize kept low - individuals arrive in trickles,
     the swarm forms from mandrake.rm.shipvermin's own breeder comp, not from
     a big wild spawn group. -->
<Defs>

  <PawnKindDef ParentName="AnimalKindBase">
    <defName>RSW_Mynock</defName>
    <label>mynock</label>
    <labelPlural>mynocks</labelPlural>
    <race>RSW_Mynock</race>
    <combatPower>5</combatPower>
    <ecoSystemWeight>0.1</ecoSystemWeight>
    <wildGroupSize>1~2</wildGroupSize>
    <!-- MYNOCK_FLIPBOOK_FRAMES_1: 8-frame whole-body flip-book cut from the statics below
         (src/RimMandrake/Utils/art/flyer_cutout_sets/Mynock.json); the body is pixel-identical in
         every frame, only the wings beat. Multiplier 1.0 = drawn at the life stage's drawSize. -->
    <flyingAnimationFramePathPrefix>RimStarWars/SWBestiary/ShipVermin/Mynock/Mynock_Flying_</flyingAnimationFramePathPrefix>
    <flyingAnimationFrameCount>8</flyingAnimationFrameCount>
    <flyingAnimationTicksPerFrame>3</flyingAnimationTicksPerFrame>
    <flyingAnimationDrawSize>1.0</flyingAnimationDrawSize>
    <flyingAnimationDrawSizeIsMultiplier>true</flyingAnimationDrawSizeIsMultiplier>
    <flyingAnimationInheritColors>false</flyingAnimationInheritColors>
    <lifeStages>
      <li>
        <label>mynock pup</label>
        <labelPlural>mynock pups</labelPlural>
        <bodyGraphicData>
          <texPath>RimStarWars/SWBestiary/ShipVermin/Mynock/Mynock</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>0.35</drawSize>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>RimStarWars/SWBestiary/ShipVermin/Mynock/Mynock</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>0.5</drawSize>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>RimStarWars/SWBestiary/ShipVermin/Mynock/Mynock</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>0.6</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>

</Defs>
