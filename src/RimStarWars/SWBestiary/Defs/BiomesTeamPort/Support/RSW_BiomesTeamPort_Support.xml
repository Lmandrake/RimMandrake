        <painOffset>0.4</painOffset>
        <lifeThreatening>true</lifeThreatening>
        <deathMtbDays>10</deathMtbDays>
        <mtbDeathDestroysBrain>true</mtbDeathDestroysBrain>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.8</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
  <HediffDef ParentName="InfectionBase">
    <defName>RSW_Mutapox</defName>
    <label>mutapox</label>
    <description>A novel virus found only in polluted areas. It can cause genetic mutations in those afflicted if they survive its negative effects.</description>
    <makesSickThought>true</makesSickThought>
    <lethalSeverity>1</lethalSeverity>
    <tendable>true</tendable>
