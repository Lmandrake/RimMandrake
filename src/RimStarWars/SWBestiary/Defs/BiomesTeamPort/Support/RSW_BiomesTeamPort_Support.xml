  <HediffDef ParentName="DiseaseBase">
    <defName>RSW_Paralysis</defName>
    <label>paralysis</label>
    <description>Paralysis-inducing chemicals in the bloodstream. It rapidly renders creatures immobile.</description>
    <isBad>false</isBad>
    <initialSeverity>0.10</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>15000~50000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.8</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>initial</label>
        <becomeVisible>true</becomeVisible>
      </li>
      <li>
        <label>initial</label>
        <minSeverity>0.10</minSeverity>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.10</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>minor</label>
        <minSeverity>0.25</minSeverity>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.25</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>moderate</label>
        <minSeverity>0.50</minSeverity>
        <vomitMtbDays>5</vomitMtbDays>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.50</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>serious</label>
        <minSeverity>0.75</minSeverity>
        <vomitMtbDays>1</vomitMtbDays>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.75</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>extreme</label>
        <minSeverity>0.80</minSeverity>
        <vomitMtbDays>0.5</vomitMtbDays>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <setMax>0.05</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
  <NeedDef>
    <defName>RSW_ToxinDependence</defName>
    <needClass>RimMandrake.StarWars.SWBestiary.RSW_Need_ToxinDependence</needClass>
    <label>toxin dependence</label>
    <description>This creature's metabolism runs on ingested toxins and will not function without them. Deprived of polluted food and water it weakens, and in time it dies of the cleanliness.</description>
    <listPriority>45</listPriority>
    <fallPerDay>1</fallPerDay>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <onlyIfCausedByHediff>true</onlyIfCausedByHediff>
    <showForCaravanMembers>true</showForCaravanMembers>
  </NeedDef>
  <HediffDef>
    <defName>RSW_ToxinDependence</defName>
    <hediffClass>RimMandrake.StarWars.SWBestiary.RSW_Hediff_ToxinDependence</hediffClass>
    <label>toxin dependence</label>
    <description>A body rebuilt around toxic intake. While the creature can keep feeding on polluted matter it is perfectly well; cut off from it, the withdrawal is slow, painful and eventually fatal.</description>
    <chemicalNeed>RSW_ToxinDependence</chemicalNeed>
    <everCurableByItem>false</everCurableByItem>
    <defaultLabelColor>(1,0,0.5)</defaultLabelColor>
    <initialSeverity>0.5</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <stages>
      <li>
            </li>
      <li>
        <label>unmet</label>
