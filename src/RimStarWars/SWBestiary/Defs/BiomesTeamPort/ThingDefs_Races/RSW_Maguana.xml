        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>swanimals/BiomesTeam/BMT_Caverns/Things/Animal/Maguana/Dessicated_Maguana</texPath>
          <color>(100,60,70)</color>
          <drawSize>2.65</drawSize>
        </dessicatedBodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>swanimals/BiomesTeam/BMT_Caverns/Things/Animal/Maguana/Maguana</texPath>
