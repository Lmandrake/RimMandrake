    <label>maguana</label>
    <race>RSW_Maguana</race>
    <combatPower>75</combatPower>
    <ecoSystemWeight>0.5</ecoSystemWeight>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>swanimals/BiomesTeam/BMT_Caverns/Things/Animal/Maguana/Maguana</texPath>
          <drawSize>1.05</drawSize>
