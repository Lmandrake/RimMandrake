<?xml version="1.0" encoding="utf-8" ?>
<!-- LIVESTOCK_STARTER_TRIO_1 - moornak PawnKindDef. Same shape as onnik's
     and karrask's own (ParentName AnimalKindBase, Graphic_Single per
     lifeStage at increasing drawSize) - see PawnKindDefs_Karrask.xml's
     own header. combatPower kept low (it "never flinches" but is not a
     fighter - the danger is the hidden grief ledger, not its bite). -->
<Defs>

  <PawnKindDef ParentName="AnimalKindBase">
    <defName>RSW_Moornak</defName>
    <label>moornak</label>
    <labelPlural>moornaks</labelPlural>
    <race>RSW_Moornak</race>
    <combatPower>30</combatPower>
    <ecoSystemWeight>0.2</ecoSystemWeight>
    <wildGroupSize>1~1</wildGroupSize>
    <lifeStages>
      <li>
        <label>moornak pup</label>
        <labelPlural>moornak pups</labelPlural>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/Moornak/Moornak</texPath>
          <graphicClass>Graphic_Single</graphicClass>
          <drawSize>0.9</drawSize>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/Moornak/Moornak</texPath>
          <graphicClass>Graphic_Single</graphicClass>
          <drawSize>1.3</drawSize>
          <shadowData>
            <volume>(0.35, 0.35, 0.3)</volume>
            <offset>(0,0,-0.12)</offset>
          </shadowData>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/Moornak/Moornak</texPath>
          <graphicClass>Graphic_Single</graphicClass>
          <drawSize>1.7</drawSize>
          <shadowData>
            <volume>(0.45, 0.45, 0.38)</volume>
            <offset>(0,0,-0.12)</offset>
          </shadowData>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>

</Defs>
