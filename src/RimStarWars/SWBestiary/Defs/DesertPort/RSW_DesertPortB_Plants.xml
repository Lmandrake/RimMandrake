<?xml version="1.0" encoding="utf-8"?>
<!-- RSW_DesertPortB_Plants.xml - DESERT_FAMILY_PORT_EXECUTION_1, SWAC batch B.
     4 flora ported from Star Wars Animal Collection (mlie): real SW canon crop
     names (chak-root, nysillin, hubba gourd, bloddle), no rename needed. Base+Wild
     donor def pairs are FLATTENED into one self-contained RSW_ ThingDef (no donor
     abstract parent survives), harvestedThingDef raw-food items ported alongside
     for closure. texPaths are TEMP donor placeholders pending the RSW_ art job.
     PLANT_TIERS_RECONCILE_MOST_ARE_BAROQUE (2026-10-16): every plant and raw item here is now a pure RESKIN of an invented
     franchise-free RM_ base in Baroque Biomes (mandrake.rm.biomes, a hard dependency): ParentName carries all growth, harvest
     and stats; these defs keep only label, description, canon art and their canon harvest item. The flattening note below is history. -->
<Defs>
<ThingDef ParentName="RM_Crimmelroot">
    <!-- PLANT_TIERS_RECONCILE_MOST_ARE_BAROQUE: pure reskin of the franchise-free RM_Crimmelroot (Baroque Biomes, mandrake.rm.biomes).
         Growth, harvest and stats come from the base; only label, description and art (canon, owner-installed) differ here
         (and the harvested item, itself a reskin of the base's). Edit gameplay on RM_Crimmelroot, never here. -->
    <defName>RSW_Plant_Chakroot_Wild</defName>
    <label>wild chak-root plant</label>
    <description>Chak-root was a flavorful red root plant that grew in the marshlands of the planet Erysthes, but was also be found on Naboo (amongst others where it was exported). The sale of this plant carried high taxes, so it was a favorite of smugglers who often developed a taste for it themselves.</description>
    <graphicData>
      <texPath>Things/Plant/RSW_Plant_Chakroot_Wild</texPath>
    </graphicData>
    <plant>
      <immatureGraphicPath>Things/Plant/RSW_Plant_Chakroot_Wild</immatureGraphicPath>
      <harvestedThingDef>RSW_RawChakroot</harvestedThingDef>
    </plant>
  </ThingDef>
<ThingDef ParentName="RM_Salvessa">
    <!-- PLANT_TIERS_RECONCILE_MOST_ARE_BAROQUE: pure reskin of the franchise-free RM_Salvessa (Baroque Biomes, mandrake.rm.biomes).
         Growth, harvest and stats come from the base; only label, description and art (canon, owner-installed) differ here
         (and the harvested item, itself a reskin of the base's). Edit gameplay on RM_Salvessa, never here. -->
    <defName>RSW_Plant_Nysyllin_Wild</defName>
    <label>wild nysyllin plant</label>
    <description>The Nysillin plants also known as nysillim was a healing herb grown as a common crop plant across the galaxy.</description>
    <graphicData>
      <texPath>swplants/Nysillin</texPath>
    </graphicData>
    <plant>
      <immatureGraphicPath>swplants/Nysillin_Immature</immatureGraphicPath>
      <harvestedThingDef>RSW_RawNysyllin</harvestedThingDef>
    </plant>
  </ThingDef>
<ThingDef ParentName="RM_Thrannagourd">
    <!-- PLANT_TIERS_RECONCILE_MOST_ARE_BAROQUE: pure reskin of the franchise-free RM_Thrannagourd (Baroque Biomes, mandrake.rm.biomes).
         Growth, harvest and stats come from the base; only label, description and art (canon, owner-installed) differ here
         (and the harvested item, itself a reskin of the base's). Edit gameplay on RM_Thrannagourd, never here. -->
    <defName>RSW_Plant_HubbaGourd_Wild</defName>
    <label>wild hubba gourd plant</label>
    <description>A hardy gourd crop native to the planet Tatooine. It was popular with both the Jawa and Tusken people and was a major staple in their diet. It was soon exported to other worlds with arid evironments where it thrived in such harsh conditions.</description>
    <graphicData>
      <texPath>Things/Plant/RSW_Plant_HubbaGourd_Wild</texPath>
    </graphicData>
    <plant>
      <immatureGraphicPath>Things/Plant/RSW_Plant_HubbaGourd_Wild</immatureGraphicPath>
      <harvestedThingDef>RSW_RawHubbaGourd</harvestedThingDef>
    </plant>
  </ThingDef>
<ThingDef ParentName="RM_Murrowbulb">
    <!-- PLANT_TIERS_RECONCILE_MOST_ARE_BAROQUE: pure reskin of the franchise-free RM_Murrowbulb (Baroque Biomes, mandrake.rm.biomes).
         Growth, harvest and stats come from the base; only label, description and art (canon, owner-installed) differ here
         (and the harvested item, itself a reskin of the base's). Edit gameplay on RM_Murrowbulb, never here. -->
    <defName>RSW_Plant_Bloddle</defName>
    <label>bloddle plant</label>
    <description>Bloddle was a tasty bulb vegetable grown in the hydroponic gardens and was a popular crop on Tatooine (although it could be found on several worlds). It could be used to enhance the flavor of other foods and was commonly grown for such purposes.</description>
    <graphicData>
      <texPath>Things/Plant/RSW_Plant_Bloddle</texPath>
    </graphicData>
    <plant>
      <immatureGraphicPath>Things/Plant/RSW_Plant_Bloddle</immatureGraphicPath>
      <harvestedThingDef>RSW_RawBloddle</harvestedThingDef>
    </plant>
  </ThingDef>
<ThingDef ParentName="RM_RawMurrowbulb">
    <!-- PLANT_TIERS_RECONCILE_MOST_ARE_BAROQUE: reskin of RM_RawMurrowbulb; only label, description, art (and taste thought text) differ. -->
    <defName>RSW_RawBloddle</defName>
    <label>bloddle</label>
    <description>Raw bloddle. An aromatic root vegetable used in many culinary dishes for it's strong flavour.</description>
    <graphicData>
      <texPath>swresource/PlantFoodRaw/Bloddle</texPath>
    </graphicData>
    <ingestible>
      <specialThoughtAsIngredient>RSW_AteBloddle</specialThoughtAsIngredient>
    </ingestible>
  </ThingDef>
<ThingDef ParentName="RM_RawCrimmelroot">
    <!-- PLANT_TIERS_RECONCILE_MOST_ARE_BAROQUE: reskin of RM_RawCrimmelroot; only label, description, art (and taste thought text) differ. -->
    <defName>RSW_RawChakroot</defName>
    <label>chak-root</label>
    <description>Raw chak-root. An aromatic root vegetable used in many culinary dishes for it's unique flavour.</description>
    <graphicData>
      <texPath>swresource/PlantFoodRaw/Chakroot</texPath>
    </graphicData>
    <ingestible>
      <specialThoughtAsIngredient>RSW_AteChakroot</specialThoughtAsIngredient>
    </ingestible>
  </ThingDef>
<ThingDef ParentName="RM_RawThrannagourd">
    <!-- PLANT_TIERS_RECONCILE_MOST_ARE_BAROQUE: reskin of RM_RawThrannagourd; only label, description, art (and taste thought text) differ. -->
    <defName>RSW_RawHubbaGourd</defName>
    <label>hubba gourd</label>
    <description>Raw hubba gourd. A keystone crop for both the Tusken and Jawa people of Tatooine as it can stay edible for a long time without refrigeration.</description>
    <graphicData>
      <texPath>swresource/PlantFoodRaw/HubbaGourd</texPath>
    </graphicData>
  </ThingDef>
<ThingDef ParentName="RM_RawSalvessa">
    <!-- PLANT_TIERS_RECONCILE_MOST_ARE_BAROQUE: reskin of RM_RawSalvessa; only label, description, art (and taste thought text) differ. -->
    <defName>RSW_RawNysyllin</defName>
    <label>nysyllin</label>
    <description>Raw nysyllin pods plant. Can be refined into large quantities of primitive medicine.</description>
    <graphicData>
      <texPath>swresource/PlantFoodRaw/Nysyllin</texPath>
    </graphicData>
  </ThingDef>
</Defs>
