<?xml version="1.0" encoding="utf-8"?>
<!-- RSW_DesertPortB_Plants.xml - DESERT_FAMILY_PORT_EXECUTION_1, SWAC batch B.
     4 flora ported from Star Wars Animal Collection (mlie): real SW canon crop
     names (chak-root, nysillin, hubba gourd, bloddle), no rename needed. Base+Wild
     donor def pairs are FLATTENED into one self-contained RSW_ ThingDef (no donor
     abstract parent survives), harvestedThingDef raw-food items ported alongside
     for closure. texPaths are TEMP donor placeholders pending the RSW_ art job. -->
<Defs>
<ThingDef ParentName="PlantBase">
    <defName>RSW_Plant_Chakroot_Wild</defName>
    <label>wild chak-root plant</label>
    <description>Chak-root was a flavorful red root plant that grew in the marshlands of the planet Erysthes, but was also be found on Naboo (amongst others where it was exported). The sale of this plant carried high taxes, so it was a favorite of smugglers who often developed a taste for it themselves.</description>
    <statBases>
      <MaxHitPoints>85</MaxHitPoints>
      <Nutrition>0.2</Nutrition>
    </statBases>
    <graphicData>
      <!-- TEMP PLACEHOLDER: donor SWAC texture, replace when the RSW_ art job lands -->
      <texPath>swplants/Chakroot</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <selectable>true</selectable>
    <pathCost>14</pathCost>
    <ingestible />
    <plant>
      <wildClusterRadius>5</wildClusterRadius>
      <wildClusterWeight>250</wildClusterWeight>
      <sowTags Inherit="False" />
      <!-- TEMP PLACEHOLDER: donor SWAC texture, replace when the RSW_ art job lands -->
      <immatureGraphicPath>swplants/Chakroot_Immature</immatureGraphicPath>
      <fertilitySensitivity>0.4</fertilitySensitivity>
      <dieIfLeafless>true</dieIfLeafless>
      <harvestTag>Standard</harvestTag>
      <harvestedThingDef>RSW_RawChakroot</harvestedThingDef>
      <harvestYield>11</harvestYield>
      <sowTags>
        <li>Ground</li>
        <li>Hydroponic</li>
      </sowTags>
      <topWindExposure>0.1</topWindExposure>
      <growDays>4</growDays>
      <visualSizeRange>0.5~1.5</visualSizeRange>
      <wildOrder>2</wildOrder>
      <purpose>Food</purpose>
      <humanFoodPlant>true</humanFoodPlant>
    </plant>
  </ThingDef>
