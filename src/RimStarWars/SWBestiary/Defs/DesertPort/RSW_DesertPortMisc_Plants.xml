	<ThingDef ParentName="PlantBase">
		<!-- ReGrowth 2 Plant_Brambles (ParentName RG_BramblesBase, abstract) -> RSW_Thornscrub. No comps/modExtensions on the donor - a plain wild plant, ported whole. -->
		<defName>RSW_Thornscrub</defName>
		<label>krenna bramble</label>
		<description>Tangled, thorny woody shoots that grow in dense clusters. Krenna brambles snag cloth and slow anyone who wades through them, but the wood beneath the thorns burns well once cleared.</description>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<Nutrition>0.50</Nutrition>
		</statBases>
		<pathCost>14</pathCost>
		<!-- TEMP PLACEHOLDER: donor texPath (ReGrowth's own "Things/Plant/RG_Brambles") does not exist as a loose file - falling back to a CONFIRMED-valid texture (Alpha Biomes' AB_Aaklac) so this does not render magenta. Mismatched art until fill_queue.py renders land. -->
		<graphicData>
			<texPath>Things/Plants/AB_Aaklac</texPath>
			<graphicClass>Graphic_Random</graphicClass>
			<drawSize>1.7</drawSize>
		</graphicData>
		<ingestible/>
		<plant>
			<fertilitySensitivity>0.7</fertilitySensitivity>
			<growDays>3</growDays>
			<harvestWork>60</harvestWork>
			<maxMeshCount>4</maxMeshCount>
			<visualSizeRange>0.7~0.85</visualSizeRange>
			<topWindExposure>0.15</topWindExposure>
			<wildClusterRadius>4</wildClusterRadius>
			<wildClusterWeight>200</wildClusterWeight>
			<wildOrder>1</wildOrder>
			<wildEqualLocalDistribution>false</wildEqualLocalDistribution>
			<pollution>Any</pollution>
		</plant>
	</ThingDef>

</Defs>
