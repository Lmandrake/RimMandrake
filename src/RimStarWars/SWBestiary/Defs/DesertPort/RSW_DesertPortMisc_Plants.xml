			<visualSizeRange>0.8~1.3</visualSizeRange>
			<topWindExposure>0.25</topWindExposure>
			<wildOrder>1</wildOrder>
		</plant>
	</ThingDef>

	<ThingDef ParentName="PlantBase">
		<defName>RSW_EmberCarpet</defName>
		<label>ember carpet</label>
