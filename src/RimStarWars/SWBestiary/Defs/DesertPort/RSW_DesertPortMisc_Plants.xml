	<ThingDef ParentName="BushBase">
		<defName>RSW_VellaraBloom</defName>
		<label>vellara bloom</label>
		<description>A rare, huge flower with a striking color and a strong, sweet smell. Popular in gardening wherever it can be grown at all.</description>
		<statBases>
			<Beauty>10</Beauty>
		</statBases>
		<!-- TEMP PLACEHOLDER: donor Alpha Biomes texture -->
		<graphicData>
			<texPath>Things/Plants/AB_Aaklac</texPath>
			<graphicClass>Graphic_Random</graphicClass>
			<drawSize>1.5</drawSize>
			<shadowData>
				<volume>(0.55, 0.2, 0.2)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
		</graphicData>
		<plant>
			<topWindExposure>0.07</topWindExposure>
			<wildClusterRadius>-1</wildClusterRadius>
			<!-- AUTHORED: donor left visualSizeRange unset (inherits BushBase's own default, itself UNMEASURED by the census); set explicitly here rather than left ambiguous. -->
			<visualSizeRange>0.7~1.0</visualSizeRange>
		</plant>
	</ThingDef>

	<ThingDef ParentName="TreeBase">
		<defName>RSW_SweetbarkTree</defName>
		<label>dommo tree</label>
		<description>A whimsical tree with a sugary trunk, frosting-like growths, and fruit that resembles glazed confections. Lures animals and colonists alike.</description>
		<descriptionHyperlinks>
			<ThingDef>WoodLog</ThingDef>
		</descriptionHyperlinks>
		<!-- TEMP PLACEHOLDER: donor Alpha Biomes texture -->
		<graphicData>
			<texPath>Things/Plants/AB_DessertTree</texPath>
			<graphicClass>Graphic_Random</graphicClass>
			<shadowData>
				<volume>(0.18, 0.3, 0.15)</volume>
