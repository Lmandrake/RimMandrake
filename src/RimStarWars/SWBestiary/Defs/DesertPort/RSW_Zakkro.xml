    <label>zakkro</label>
    <race>RSW_Zakkro</race>
    <combatPower>850</combatPower>
    <ecoSystemWeight>0.05</ecoSystemWeight>
    <wildGroupSize>1</wildGroupSize>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <!-- No existing render found for "zakkro"/cave-beast (checked done/_artsrc/
               registry.jsonl/art_status.json, 2026-09-20). Job rsw_zakkro_v1 filed
               (south/east/north). Baby/juvenile reuse the adult texture at a smaller
