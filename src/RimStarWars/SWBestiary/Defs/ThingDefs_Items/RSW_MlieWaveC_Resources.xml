<?xml version="1.0" encoding="utf-8"?>
<!--
  MLIE_FAUNA_ABSORPTION_1 Wave C — resource ThingDefs. Two sub-passes:

  Pass 1 (Iriaz/Mudhorn, 2026-09-12): Mudhorn needs its two eggs
  (CompProperties_EggLayer), its specific meat, its coarse wool
  (CompProperties_Shearable), and its butcher-body-part skull trophy. Iriaz
  needed no new resource — it repoints to the already-ported
  RSW_Reptomammal_Meat (RSW_MlieWaveB_Resources.xml).

  Pass 2 (Anooba/Beldon/Bolotaur, same day): Anooba needs a new leather
  (RSW_Leather_ReptoFur, texPath swresource/Leather_Fur — same folder Wave
  A's RSW_Leather_Bantha already extracted, reused unchanged, no new art).
  Beldon needs a new meat (RSW_Silica_Meat, texPath swresource/Meat_Silica,
  newly extracted this pass) and two new eggs (RSW_EggBeldonFertilized/
  UnFertilized, texPath swresource/EggSpore, newly extracted this pass).
  Bolotaur needs two new eggs (RSW_EggBolotaurFertilized/UnFertilized,
  texPath swresource/EggSaurian — already extracted, Wave B, reused
  unchanged); its leather/meat repoint to the already-ported
  RSW_Leather_Saurian/RSW_Saurian_Meat (RSW_MlieWaveB_Resources.xml).

  Ported verbatim from mlie.starwarsanimalcollection's (workshop folder
  3497316713) ThingDefs_Items/Items_Resource_swanimal_Items.xml, each defName
  flat-RSW_-prefixed. texPaths are UNCHANGED text.
-->
<Defs>
<ThingDef ParentName="EggFertBase">
    <defName>RSW_EggMudhornFertilized</defName>
    <label>mudhorn egg (fert.)</label>
    <description>A fertilized mudhorn egg. If all goes well, it should hatch into a baby mudhorn. It can be eaten raw or cooked.</description>
    <graphicData>
      <texPath>swresource/EggFurry</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>1.0</drawSize>
      <color>(100,50,0)</color>
    </graphicData>
    <statBases>
      <Nutrition>1.0</Nutrition>
      <MarketValue>100.0</MarketValue>
    </statBases>
    <comps>
      <li Class="CompProperties_Hatcher">
        <hatcherDaystoHatch>15</hatcherDaystoHatch>
        <hatcherPawn>RSW_Mudhorn</hatcherPawn>
      </li>
    </comps>
    <ingestible>
      <joy>0.12</joy>
      <joyKind>Gluttonous</joyKind>
      <tasteThought>RSW_AteMudhornEgg</tasteThought>
      <specialThoughtAsIngredient>RSW_AteMudhornEgg</specialThoughtAsIngredient>
      <optimalityOffsetFeedingAnimals>-50</optimalityOffsetFeedingAnimals>
    </ingestible>
  </ThingDef>
<ThingDef ParentName="EggUnfertBase">
    <defName>RSW_EggMudhornUnFertilized</defName>
    <label>mudhorn egg (unfert.)</label>
    <description>An unfertilized mudhorn egg. It can be eaten raw or cooked.</description>
    <graphicData>
      <texPath>swresource/EggFurry</texPath>
