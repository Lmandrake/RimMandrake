    </graphicData>
    <statBases>
      <Nutrition>1.0</Nutrition>
      <MarketValue>100.0</MarketValue>
    </statBases>
    <ingestible>
      <joy>0.12</joy>
      <joyKind>Gluttonous</joyKind>
      <tasteThought>RSW_AteMudhornEgg</tasteThought>
      <specialThoughtAsIngredient>RSW_AteMudhornEgg</specialThoughtAsIngredient>
      <optimalityOffsetFeedingAnimals>-50</optimalityOffsetFeedingAnimals>
    </ingestible>
  </ThingDef>
<ThingDef ParentName="RSW_SWanimals_RawMeatBase">
    <defName>RSW_Pachydermoid_Meat</defName>
    <label>pachydermoid meat</label>
    <description>A piece of meat from a pachydermoid.</description>
    <graphicData>
      <texPath>swresource/Meat_Pachydermoid</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>2.0</MarketValue>
    </statBases>
  </ThingDef>
<ThingDef ParentName="WoolBase">
    <defName>RSW_WoolCoarse</defName>
    <label>coarse wool</label>
    <description>While somewhat coarse, this wool offers some insulation.</description>
    <statBases>
      <StuffPower_Insulation_Cold>24</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>8</StuffPower_Insulation_Heat>
    </statBases>
    <graphicData>
      <texPath>swresource/Leather_Wool/Leather_Wool</texPath>
      <color>(100,50,0)</color>
    </graphicData>
    <stuffProps>
      <color>(100,50,0)</color>
    </stuffProps>
  </ThingDef>
<ThingDef ParentName="ResourceBase">
    <defName>RSW_MudhornSkull</defName>
    <label>mudhorn skull</label>
    <description>A mudhorn skull. These fearsome trophies were often displayed to show-off hunting prowess.</description>
    <graphicData>
      <texPath>swresource/Trophies/MudhornSkull</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>500</MarketValue>
      <MaxHitPoints>150</MaxHitPoints>
      <Mass>4.0</Mass>
      <Flammability>0.1</Flammability>
      <DeteriorationRate>0.3</DeteriorationRate>
    </statBases>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <stackLimit>10</stackLimit>
    <relicChance MayRequire="Ludeon.RimWorld.Odyssey">2</relicChance>
    <comps>
      <li Class="CompProperties_Styleable">
      </li>
    </comps>
    <thingCategories>
      <li>ItemsMisc</li>
    </thingCategories>
    <tradeTags>
      <li>Exotic</li>
    </tradeTags>
  </ThingDef>
<ThingDef ParentName="LeatherBase">
    <defName>RSW_Leather_ReptoFur</defName>
    <label>reptomammal fur</label>
    <description>Tanned, dried, reptomammal fur. Smells bad but at least it insulates against the cold.</description>
    <graphicData>
      <texPath>swresource/Leather_Fur</texPath>
      <color>(255,255,255)</color>
    </graphicData>
    <statBases>
      <MarketValue>1.8</MarketValue>
      <StuffPower_Armor_Sharp>0.75</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Blunt>0.25</StuffPower_Armor_Blunt>
      <StuffPower_Insulation_Cold>40</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>10</StuffPower_Insulation_Heat>
    </statBases>
    <stuffProps>
      <color>(255,255,255)</color>
      <commonality>0.1</commonality>
      <statFactors>
        <MaxHitPoints>1.0</MaxHitPoints>
      </statFactors>
    </stuffProps>
  </ThingDef>
