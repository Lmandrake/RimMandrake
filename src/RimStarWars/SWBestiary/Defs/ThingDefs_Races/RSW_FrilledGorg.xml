        </swimmingGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>swanimals/FrilledGorg/FrilledGorg_Dessicated</texPath>
          <drawSize>1.0</drawSize>
        </dessicatedBodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>swanimals/FrilledGorg/FrilledGorg</texPath>
          <drawSize>1.5</drawSize>
          <shadowData>
            <volume>(0.3, 0.4, 0.3)</volume>
            <offset>(0,0,0.0)</offset>
          </shadowData>
        </bodyGraphicData>
        <swimmingGraphicData>
          <texPath>swanimals/FrilledGorg/FrilledGorg_Swimming</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.5</drawSize>
        </swimmingGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>swanimals/FrilledGorg/FrilledGorg_Dessicated</texPath>
          <drawSize>1.5</drawSize>
        </dessicatedBodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>
</Defs>
