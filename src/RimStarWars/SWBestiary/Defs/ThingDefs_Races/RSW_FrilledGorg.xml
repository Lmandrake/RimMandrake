        <texPath>swanimals/FrilledGorg/FrilledGorgC</texPath>
        <swimmingTexPath>swanimals/FrilledGorg/FrilledGorgC_Swimming</swimmingTexPath>
      </li>
    </alternateGraphics>
    <moveSpeedFactorByTerrainTag>
      <li>
        <key>Water</key>
        <value>2.0</value>
      </li>
    </moveSpeedFactorByTerrainTag>
    <lifeStages>
      <li>
        <label>frilled gorgling</label>
        <bodyGraphicData>
