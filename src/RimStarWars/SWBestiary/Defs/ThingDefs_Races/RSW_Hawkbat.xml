        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.5</minAge>
          <soundWounded>RSW_Pawn_Hawkbat_Wounded</soundWounded>
          <soundDeath>RSW_Pawn_Hawkbat_Death</soundDeath>
          <soundCall>RSW_Pawn_Hawkbat_Call</soundCall>
          <soundAngry>RSW_Pawn_Hawkbat_Angry</soundAngry>
