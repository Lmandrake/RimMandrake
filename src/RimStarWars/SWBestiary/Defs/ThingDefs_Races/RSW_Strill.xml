      <MoveSpeed>3.5</MoveSpeed>
      <MarketValue>450</MarketValue>
      <ComfyTemperatureMin>-45</ComfyTemperatureMin>
      <ComfyTemperatureMax>55</ComfyTemperatureMax>
      <ArmorRating_Sharp>0.12</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.12</ArmorRating_Blunt>
      <FilthRate>12</FilthRate>
      <Wildness>0.40</Wildness>
      <MaxFlightTime>10</MaxFlightTime>
