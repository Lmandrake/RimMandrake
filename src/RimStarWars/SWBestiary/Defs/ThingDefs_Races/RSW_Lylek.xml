<Defs>
<ThingDef ParentName="AnimalThingBase" ADogSaidBody="LegsTail">
    <defName>RSW_Lylek</defName>
    <label>lylek</label>
    <description>The lylek was the most dangerous predator indigenous to the planet of Ryloth. It's strange biology made it one of the few creatures able to survive in the harsh heat of the Bright Lands. These dangerous creatures were popular exotic pets with certain criminal organisations and subsequently were transported to various worlds.</description>
    <statBases>
      <MoveSpeed>5</MoveSpeed>
      <ComfyTemperatureMin>-75</ComfyTemperatureMin>
      <ComfyTemperatureMax>300</ComfyTemperatureMax>
      <MarketValue>2750</MarketValue>
      <ArmorRating_Blunt>0.40</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.50</ArmorRating_Sharp>
      <ArmorRating_Heat>0.99</ArmorRating_Heat>
      <ToxicResistance>1</ToxicResistance>
      <ToxicEnvironmentResistance MayRequire="Ludeon.RimWorld.Biotech">1.0</ToxicEnvironmentResistance>
      <Wildness>0.95</Wildness>
    </statBases>
    <tools>
      <li>
        <label>left tentacle</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>28</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>RSW_SWTentacleAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
      </li>
      <li>
        <label>right tentacle</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>28</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>RSW_SWTentacleAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
      </li>
      <li>
        <label>poison stinger</label>
        <capacities>
          <li>ScratchToxic</li>
        </capacities>
        <power>24</power>
        <cooldownTime>2.6</cooldownTime>
        <linkedBodyPartsGroup>RSW_SWToxicAppendage</linkedBodyPartsGroup>
        <chanceFactor>0.8</chanceFactor>
      </li>
      <li>
        <label>teeth</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>24</power>
        <cooldownTime>1.4</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        <chanceFactor>0.5</chanceFactor>
      </li>
      <li>
        <label>head</label>
