      <li><texPath>RimStarWars/SWBestiary/DragonsnakeCanon/Dragonsnake_D</texPath><swimmingTexPath>RimStarWars/SWBestiary/DragonsnakeCanon/Dragonsnake_D_Swim</swimmingTexPath></li>
    </alternateGraphics>
    <lifeStages>
