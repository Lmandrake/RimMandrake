<!--
  MLIE_FAUNA_ABSORPTION_1 Wave C — Dragonsnake creature port.
  Ported from mlie.starwarsanimalcollection's `Dragonsnake` ThingDef/
  PawnKindDef pair (Races_Animal_SW.xml, workshop folder 3497316713),
  renamed under the RSW_ tier prefix. Geometry/stats/comps copied verbatim.
  Custom body: the donor's `Dragonsnake` BodyDef uses vanilla Core's
  `SnakeBody`/`SnakeHead`/`SnakeMouth` parts unchanged, plus one donor-custom
  tail part (`SW_Club`) and its attack-tool group (`SWTailAttackTool`) —
  both ALREADY PORTED in Wave B (RSW_SW_Club, RSW_SWTailAttackTool, the same
  club/tail-tool Boma already reuses) — ported here as RSW_Dragonsnake
  (RSW_MlieWaveC_Bodies.xml) with those 2 references repointed, no new body
  part needed.

  `leatherDef`/`specificMeatDef` repoint to the already-ported
  RSW_Leather_Saurian/RSW_Saurian_Meat (Wave B). Its `CompProperties_EggLayer`
  needed 2 new eggs, RSW_EggDragonsnakeFertilized/UnFertilized
  (RSW_MlieWaveC_Resources.xml) — the donor's own egg ThingDefs reuse the
  already-present texPath swresource/EggSaurian (no new art extraction
  needed for the eggs themselves). Sounds repoint to the already-absorbed
  sound wave (RSW_Pawn_Dragonsnake_*, 2026-09-02). texPaths are unchanged
  text — extracted art (7 PNGs: base body + swimming variant + dessicated,
  3 directions each except the single non-directional dessicated) sits at
  Textures/swanimals/Dragonsnake/ (extract_bundle.py against the same
  AssetBundle every prior wave used).

  Wired into the live cast this same pass: BiomeCypreJungle (per
  cast_assignment.csv's current row for this species), repointed from the
  bare "Dragonsnake" entry in cast_assignment.csv / BiomeCast_Ashkarr.xml.
-->
<Defs>
<ThingDef ParentName="AnimalThingBase" ADogSaidBody="LegsTail">
    <defName>RSW_Dragonsnake</defName>
    <label>Dragonsnake</label>
    <description>The dragonsnake (also spelled 'dragon snake') were a large, semi-aquatic predatory reptiles that dwelled in the muddy waters of various planets, including Dagobah and Nal Hutta. Dragonsnakes were large serpentlike beasts with sharp fangs and biolumescent spots along their backs. Although voracious, they were incapable of digesting metal (a lucky escape for some heroic droids!). The dragonsnake "Bright-Eyes" displayed a degree of extreme intelligence and cunning.</description>
    <statBases>
      <MoveSpeed>3.0</MoveSpeed>
      <ComfyTemperatureMin>-10</ComfyTemperatureMin>
      <ComfyTemperatureMax>80</ComfyTemperatureMax>
      <MarketValue>2000</MarketValue>
      <FilthRate>16</FilthRate>
      <ArmorRating_Blunt>0.25</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.35</ArmorRating_Sharp>
      <ArmorRating_Heat>0.25</ArmorRating_Heat>
      <ToxicEnvironmentResistance MayRequire="Ludeon.RimWorld.Biotech">1.0</ToxicEnvironmentResistance>
      <Wildness>0.80</Wildness>
    </statBases>
    <tools>
      <li>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>30</power>
        <cooldownTime>2.6</cooldownTime>
        <linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
        <chanceFactor>0.5</chanceFactor>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>14</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>18</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
      <li>
        <label>bodily constriction</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>20</power>
        <cooldownTime>2.2</cooldownTime>
        <linkedBodyPartsGroup>RSW_SWTailAttackTool</linkedBodyPartsGroup>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>10</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
    </tools>
    <comps>
      <li Class="CompProperties_EggLayer">
        <eggUnfertilizedDef>RSW_EggDragonsnakeUnFertilized</eggUnfertilizedDef>
        <eggFertilizedDef>RSW_EggDragonsnakeFertilized</eggFertilizedDef>
        <eggFertilizationCountMax>1</eggFertilizationCountMax>
        <eggLayIntervalDays>15</eggLayIntervalDays>
        <eggProgressUnfertilizedMax>0.5</eggProgressUnfertilizedMax>
        <eggCountRange>1~3</eggCountRange>
      </li>
    </comps>
    <modExtensions>
      <li MayRequire="pathfinding.framework" Class="PathfindingFramework.MovementExtension">
        <movementDef>PF_Movement_Amphibious</movementDef>
      </li>
    </modExtensions>
    <race>
      <body>RSW_Dragonsnake</body>
      <predator>true</predator>
      <maxPreyBodySize>4.0</maxPreyBodySize>
      <baseHungerRate>0.5</baseHungerRate>
