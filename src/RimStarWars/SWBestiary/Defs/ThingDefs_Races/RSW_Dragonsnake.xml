<?xml version="1.0" encoding="utf-8"?>
<!--
  MLIE_FAUNA_ABSORPTION_1 Wave C — Dragonsnake creature port.
  Ported from mlie.starwarsanimalcollection's `Dragonsnake` ThingDef/
  PawnKindDef pair (Races_Animal_SW.xml, workshop folder 3497316713),
  renamed under the RSW_ tier prefix. Geometry/stats/comps copied verbatim.
  Body: RSW_Dragonsnake (RSW_MlieWaveC_Bodies.xml), rebuilt 2026-10-17 (below);
  its tail keeps the Wave B part RSW_SW_Club and group RSW_SWTailAttackTool.

  `leatherDef`/`specificMeatDef` repoint to the already-ported
  RSW_Leather_Saurian/RSW_Saurian_Meat (Wave B). Its `CompProperties_EggLayer`
  needed 2 new eggs, RSW_EggDragonsnakeFertilized/UnFertilized
  (RSW_MlieWaveC_Resources.xml) — the donor's own egg ThingDefs reuse the
  already-present texPath swresource/EggSaurian (no new art extraction
  needed for the eggs themselves). Sounds repoint to the already-absorbed
  sound wave (RSW_Pawn_Dragonsnake_*, 2026-09-02).

  DRAGONSNAKE_PAIR_BUILD_ONE_PALE_ONE_PROPER (2026-10-17): the owner split the species in two. THIS def
  is the canon Dragonsnake, the Jedi: Fallen Order dark olive-slate crocodilian QUADRUPED; its BodyDef was
  rebuilt with four clawed legs and the tail tool relabelled "tail lash" (a crocodilian does not
  constrict). The pale limbless film serpent is the separate RSW_DragonsnakeAlbino
  (RSW_DragonsnakeAlbino.xml), a rare variant in the same swamps.

  2026-10-18 (owner: "One would be an Albino version (the beautiful white art we already have done in the game) ...
  The other would be new art we commission from the Canon's many options of colorful versions"): the white art left this
  def (it lives on RSW_DragonsnakeAlbino); body + swimming art are ours at RimStarWars/SWBestiary/DragonsnakeCanon/,
  four variants via alternateGraphics below. Dessicated art is still the donor's swanimals file (no render yet).

  Rosters: Greentide at 0.12 (RUT_Greentide inline; RM_Greentide via
  UtinniPatches/Patches/WildAnimals_Greentide.xml) plus race.wildBiomes below.
-->
<Defs>
<ThingDef ParentName="AnimalThingBase" ADogSaidBody="LegsTail">
    <defName>RSW_Dragonsnake</defName>
    <label>dragonsnake</label>
    <description>Dragonsnakes (also spelled 'dragon snakes') were large, semi-aquatic predatory reptiles that dwelled in the muddy waters of various planets, including Dagobah and Nal Hutta. Dragonsnakes were large serpentlike beasts with sharp fangs and bioluminescent spots along their backs. Although voracious, they were incapable of digesting metal (a lucky escape for some heroic droids!). The dragonsnake "Bright-Eyes" displayed a degree of extreme intelligence and cunning.</description>
    <statBases>
      <MoveSpeed>3.0</MoveSpeed>
      <ComfyTemperatureMin>-10</ComfyTemperatureMin>
      <ComfyTemperatureMax>80</ComfyTemperatureMax>
      <MarketValue>2000</MarketValue>
      <FilthRate>16</FilthRate>
      <ArmorRating_Blunt>0.25</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.35</ArmorRating_Sharp>
      <ArmorRating_Heat>0.25</ArmorRating_Heat>
      <ToxicEnvironmentResistance MayRequire="Ludeon.RimWorld.Biotech">1.0</ToxicEnvironmentResistance>
      <Wildness>0.80</Wildness>
    </statBases>
    <tools>
      <li>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>30</power>
        <cooldownTime>2.6</cooldownTime>
        <linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
        <chanceFactor>0.5</chanceFactor>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>14</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>18</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
      <li>
        <label>tail lash</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>20</power>
        <cooldownTime>2.2</cooldownTime>
        <linkedBodyPartsGroup>RSW_SWTailAttackTool</linkedBodyPartsGroup>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>10</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
    </tools>
    <comps>
      <li Class="CompProperties_EggLayer">
        <eggUnfertilizedDef>RSW_EggDragonsnakeUnFertilized</eggUnfertilizedDef>
        <eggFertilizedDef>RSW_EggDragonsnakeFertilized</eggFertilizedDef>
        <eggFertilizationCountMax>1</eggFertilizationCountMax>
        <eggLayIntervalDays>15</eggLayIntervalDays>
        <eggProgressUnfertilizedMax>0.5</eggProgressUnfertilizedMax>
        <eggCountRange>1~3</eggCountRange>
      </li>
    </comps>
    <modExtensions>
      <li MayRequire="pathfinding.framework" Class="PathfindingFramework.MovementExtension">
        <movementDef>PF_Movement_Amphibious</movementDef>
      </li>
    </modExtensions>
    <race>
      <body>RSW_Dragonsnake</body>
      <predator>true</predator>
      <maxPreyBodySize>4.0</maxPreyBodySize>
      <baseHungerRate>0.5</baseHungerRate>
      <baseBodySize>4.0</baseBodySize>
      <baseHealthScale>4.0</baseHealthScale>
      <foodType>CarnivoreAnimal</foodType>
      <leatherDef>RSW_Leather_Saurian</leatherDef>
      <specificMeatDef>RSW_Saurian_Meat</specificMeatDef>
      <lifeExpectancy>60</lifeExpectancy>
      <trainability>Advanced</trainability>
      <manhunterOnTameFailChance>0.70</manhunterOnTameFailChance>
      <manhunterOnDamageChance>1.0</manhunterOnDamageChance>
      <nameGenerator>RSW_SWAnimalNamerMale</nameGenerator>
      <nameGeneratorFemale>RSW_SWAnimalNamerFemale</nameGeneratorFemale>
      <nameOnTameChance>1</nameOnTameChance>
      <waterSeeker>true</waterSeeker>
      <waterCellCost>1</waterCellCost>
      <canFishForFood>true</canFishForFood>
      <wildBiomes>
        <AridShrubland>0.0</AridShrubland>
        <Desert>0.0</Desert>
        <ExtremeDesert>0.0</ExtremeDesert>
        <TropicalRainforest>0.2</TropicalRainforest>
        <TropicalSwamp>0.8</TropicalSwamp>
        <TemperateSwamp>0.6</TemperateSwamp>
        <TemperateForest>0.0</TemperateForest>
        <BorealForest>0.0</BorealForest>
        <Tundra>0.0</Tundra>
        <ColdBog>0.2</ColdBog>
        <IceSheet>0.0</IceSheet>
      </wildBiomes>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.25</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.5</minAge>
          <soundWounded>RSW_Pawn_Dragonsnake_Wounded</soundWounded>
          <soundDeath>RSW_Pawn_Dragonsnake_Death</soundDeath>
          <soundCall>RSW_Pawn_Dragonsnake_Call</soundCall>
          <soundAngry>RSW_Pawn_Dragonsnake_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
      <soundEating>Insectoid_Eat</soundEating>
    </race>
    <tradeTags>
      <li>AnimalExotic</li>
      <li>AnimalFighter</li>
    </tradeTags>
  </ThingDef>
<PawnKindDef ParentName="AnimalKindBase">
    <defName>RSW_Dragonsnake</defName>
    <label>dragonsnake</label>
    <race>RSW_Dragonsnake</race>
    <combatPower>300</combatPower>
    <ecoSystemWeight>0.5</ecoSystemWeight>
    <moveSpeedFactorByTerrainTag>
      <li>
        <key>Water</key>
        <value>2.0</value>
      </li>
    </moveSpeedFactorByTerrainTag>
    <!-- The four Jedi: Fallen Order canon variants (owner 2026-10-18: "I'd like variants to be made from that canon
         example"). Base graphic = variant A; B/C/D are PawnKindDef.alternateGraphics (Verse.AlternateGraphic: texPath,
         swimmingTexPath, weight 0.5 default), picked when Rand.Chance(alternateGraphicChance) (Verse/PawnGraphicUtils.cs).
         0.75 = the four equally likely (one random pool of four). The four renders are the owner's picks on
         dragonsnake_canon_variants_sheet_2026-10-18 (2026-10-18: "I approve all the variants as I have selected on the
         sheet"). Swimming draws Dragonsnake_{A,B,C,D}_Swim (jobs dragonsnake_jfo_var{a,b,c,d}_v1_swim; owner 2026-10-20 on dragonsnake_swim_variants_sheet_2026-10-18: "Accept all"). The white swim art is Albino-only. -->
    <alternateGraphicChance>0.75</alternateGraphicChance>
    <alternateGraphics>
      <li><texPath>RimStarWars/SWBestiary/DragonsnakeCanon/Dragonsnake_B</texPath><swimmingTexPath>RimStarWars/SWBestiary/DragonsnakeCanon/Dragonsnake_B_Swim</swimmingTexPath></li>
