          <drawSize>1.0</drawSize>
        </dessicatedBodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>RimStarWars/SWBestiary/DragonsnakeCanon/Dragonsnake_A</texPath>
