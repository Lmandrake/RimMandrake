<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Ported by src/RimMandrake/Utils/donor_pack_port.py port (DONOR_DEFS_PORT_TO_OURS_1, batch W3e) from mlie.starwarsanimalcollection (MIT; workshop 3497316713, 1.6/Defs). Donor-only names renamed RSW_; values verbatim. A texPath under swanimals/ or swresource/ keeps the donor path; its PNGs are extracted donor art installed in SWBestiary/Textures through the art ledger (owner 2026-10-14: ports may re-use extracted donor art until we regenerate). Canon brief: design/RimStarWars/canon_references/(see tracker). Our own patches that targeted the donor defName were applied BEFORE the rename (so this is the creature the game showed): src/RimStarWars/SWBestiary/Patches/BeastNorm/BeastNorm_Law3.xml (14 ops), src/RimStarWars/SWBestiary/Patches/Silooth/Silooth_Warbeast.xml (9 ops), src/RimUtinni/UtinniPatches/Patches/AnimalBiomeDuplicates_Fix.xml (1 ops), src/RimUtinni/UtinniPatches/Patches/AnimalTolerances_Ashkarr.xml (6 ops), src/RimUtinni/UtinniPatches/Patches/BiomeCastEvictions_WildBiomes.xml (23 ops). Those patch ops still name the donor and go dead when it is retired. -->
  <!-- TAOZIN SPLIT, 2026-10-17 (owner, facings sheet; design/RimStarWars/taozin_split_proposal_2026-10-17.md):
       this def is now the Legends ADULT only, a giant wild-only predator (owner by card: "Wild only").
       The grub is its own creature, RSW_TaozinGrub (RSW_TaozinGrub.xml). Lair: RSW_GenStep_TaozinNest
       (MapGeneration/RSW_TaozinNest.xml) on Crags (RM_Abyss) maps; wild row: UtinniPatches WildAnimals_Abyss.xml.
       Canon brief: design/RimStarWars/canon_references/taozin/description.md. Art: owner rejected the donor
       swanimals/Taozin art 2026-10-17; the texPath below names the regenerated art (artpipe job queued). -->
  <ThingDef ParentName="AnimalThingBase" ADogSaidBody="LegsTail">
    <defName>RSW_Taozin</defName>
    <label>taozin</label>
    <description>A taozin, the 'force dragon': a giant armoured annelid many times a man's length, ringed in red-brown and cream, with a mandibled head and countless short legs. It spits silken webbing to bind its prey, its translucent shell turns aside blaster bolts and blades, and Force-sensitives cannot sense it at all. Taozin guard their nests, where their grubs lie in silk. A rare curiosity, the taozin nodule, can be cut from its skin. It cannot be tamed.</description>
    <statBases>
      <MoveSpeed>2</MoveSpeed>
      <ComfyTemperatureMin>-5</ComfyTemperatureMin>
      <ComfyTemperatureMax>80</ComfyTemperatureMax>
      <MarketValue>3500</MarketValue>
      <ArmorRating_Blunt>0.35</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.80</ArmorRating_Sharp>
      <ArmorRating_Heat>0.99</ArmorRating_Heat>
      <ToxicResistance>1.0</ToxicResistance>
      <ToxicEnvironmentResistance MayRequire="Ludeon.RimWorld.Biotech">1.0</ToxicEnvironmentResistance>
      <PsychicSensitivityOffset>-1.0</PsychicSensitivityOffset>
      <HuntingStealth>2.0</HuntingStealth>
      <Wildness>1</Wildness>
    </statBases>
    <tools>
      <li>
        <label>spiked-tail</label>
        <capacities>
          <li>Blunt</li>
          <li>Stab</li>
        </capacities>
        <power>90.0</power>
        <cooldownTime>3.67</cooldownTime>
        <linkedBodyPartsGroup>RSW_SWTailAttackTool</linkedBodyPartsGroup>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>12</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>left claws</label>
        <capacities>
          <li>Cut</li>
          <li>Stab</li>
        </capacities>
        <power>20</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>Feet</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>10</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>right claws</label>
        <capacities>
          <li>Cut</li>
          <li>Stab</li>
        </capacities>
        <power>20</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>Feet</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>10</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>insectoid maw</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>12</power>
        <cooldownTime>1.4</cooldownTime>
        <linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
        <chanceFactor>0.5</chanceFactor>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>8</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>16</power>
        <cooldownTime>2.4</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <chanceFactor>0.2</chanceFactor>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>8</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
    </tools>
    <ingredient>
      <mergeCompatibilityTags>
        <li MayRequire="Ludeon.RimWorld.Ideology">InsectMeat</li>
      </mergeCompatibilityTags>
    </ingredient>
    <comps>
      <li Class="CompProperties_CanBeDormant" />
      <li Class="CompProperties_WakeUpDormant">
        <wakeUpOnDamage>true</wakeUpOnDamage>
      </li>
      <!-- Web-spit: the shipped Webwork mouth-loom (RM_Gun_LoomSpit, binds prey), reused not rebuilt. -->
      <li Class="CompProperties_TurretGun" MayRequire="mandrake.rm.webwork">
        <turretDef>RM_Gun_LoomSpit</turretDef>
        <autoAttack>true</autoAttack>
      </li>
      <!-- Guards its nest: RSW_GenStep_TaozinNest anchors it there; a roster-spawned adult anchors where it spawns. -->
      <li Class="RimMandrake.EnvironmentalHazards.CompProperties_TerritorialAnchor" MayRequire="mandrake.rm.environmentalhazards">
        <dutyDef>RM_AnchorGuard</dutyDef>
        <anchorRadius>18</anchorRadius>
      </li>
    </comps>
    <receivesSignals>true</receivesSignals>
    <modExtensions>
      <li MayRequire="Mlie.XNDNocturnalAnimals" Class="NocturnalAnimals.ExtendedRaceProperties">
        <bodyClock>Nocturnal</bodyClock>
      </li>
    </modExtensions>
    <race>
      <body>RSW_Taozin</body>
      <predator>true</predator>
      <maxPreyBodySize>6.0</maxPreyBodySize>
      <baseHungerRate>1.0</baseHungerRate>
      <baseBodySize>8.0</baseBodySize>
      <baseHealthScale>6</baseHealthScale>
      <foodType>CarnivoreAnimal, OvivoreAnimal, AnimalProduct</foodType>
      <lifeExpectancy>250</lifeExpectancy>
      <trainability>None</trainability>
      <manhunterOnTameFailChance>0.5</manhunterOnTameFailChance>
      <manhunterOnDamageChance>1.0</manhunterOnDamageChance>
      <nameGenerator>RSW_SWAnimalNamerMale</nameGenerator>
      <nameGeneratorFemale>RSW_SWAnimalNamerFemale</nameGeneratorFemale>
      <nameOnTameChance>1</nameOnTameChance>
      <leatherDef>RSW_Leather_Insectine</leatherDef>
      <useMeatFrom>Megaspider</useMeatFrom>
      <fleshType>Insectoid</fleshType>
      <bloodDef>Filth_BloodInsect</bloodDef>
      <!-- No wildBiomes: wild only in the Crags (RM_Abyss), patch-added by UtinniPatches WildAnimals_Abyss.xml. Never tameable: no trainables. -->
      <lifeStageAges>
        <li>
          <def>AnimalAdult</def>
          <minAge>0</minAge>
          <soundWounded>RSW_Pawn_Taozin_Wounded</soundWounded>
          <soundDeath>RSW_Pawn_Taozin_Death</soundDeath>
          <soundCall>RSW_Pawn_Taozin_Call</soundCall>
          <soundAngry>RSW_Pawn_Taozin_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
      <soundEating>Insectoid_Eat</soundEating>
    </race>
    <butcherProducts>
      <RSW_WoolTaozin>60</RSW_WoolTaozin>
    </butcherProducts>
  </ThingDef>
  <PawnKindDef ParentName="AnimalKindBase">
    <defName>RSW_Taozin</defName>
    <label>taozin</label>
    <race>RSW_Taozin</race>
    <combatPower>650</combatPower>
    <ecoSystemWeight>0.1</ecoSystemWeight>
    <abilities>
      <li MayRequire="Ludeon.RimWorld.Odyssey">RSW_SW_ForceInvisibility</li>
    </abilities>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/RSW_Taozin/RSW_Taozin</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>10</drawSize>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/RSW_Taozin/Dessicated_RSW_Taozin</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>10</drawSize>
        </dessicatedBodyGraphicData>
        <butcherBodyPart>
          <bodyPartGroup>HeadAttackTool</bodyPartGroup>
          <thing>RSW_TaozinNodule</thing>
          <allowFemale>true</allowFemale>
        </butcherBodyPart>
      </li>
    </lifeStages>
  </PawnKindDef>
</Defs>
