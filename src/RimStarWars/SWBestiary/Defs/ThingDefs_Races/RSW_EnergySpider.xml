      </li>
      <li>
        <bodyGraphicData>
          <texPath>swanimals/EnergySpider/EnergySpider</texPath>
          <drawSize>3.0</drawSize>
          <shadowData>
            <volume>(1.2, 1, 1)</volume>
            <offset>(0,0,-0.3)</offset>
