        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>swanimals/EnergySpider/EnergySpider_Dessicated</texPath>
          <drawSize>3.0</drawSize>
        </dessicatedBodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>
</Defs>
