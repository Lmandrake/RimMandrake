<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Ported by src/RimMandrake/Utils/donor_pack_port.py port (DONOR_DEFS_PORT_TO_OURS_1, batch W3d) from mlie.starwarsanimalcollection (MIT; workshop 3497316713, 1.6/Defs). Donor-only names renamed RSW_; values verbatim. A texPath under swanimals/ or swresource/ keeps the donor path; its PNGs are extracted donor art installed in SWBestiary/Textures through the art ledger (owner 2026-10-14: ports may re-use extracted donor art until we regenerate). Canon brief: design/RimStarWars/canon_references/(see tracker). Our own patches that targeted the donor defName were applied BEFORE the rename (so this is the creature the game showed): src/RimStarWars/SWBestiary/Patches/BeastNorm/BeastNorm_Law3.xml (18 ops), src/RimStarWars/SWBestiary/Patches/SeasWaterline/Waterline_Lane1.xml (2 ops), src/RimUtinni/UtinniPatches/Patches/AnimalBiomeDuplicates_Fix.xml (1 ops), src/RimUtinni/UtinniPatches/Patches/AnimalTolerances_Ashkarr.xml (4 ops), src/RimUtinni/UtinniPatches/Patches/BiomeCastEvictions_WildBiomes.xml (25 ops). Those patch ops still name the donor and go dead when it is retired. -->
  <ThingDef ParentName="AnimalThingBase" ADogSaidBody="LegsTail">
    <defName>RSW_EnergySpider</defName>
    <label>energy spider</label>
    <description>Energy spiders (or "spice spiders") were horrifying arachnids that inhabited the Spice Mines of Kessel. The webs that these creatures spin between their legs can be harvested as Glitterstim (a potent drug and medicinal ingredient). This variety of Energy Spider appears to have been bioengineered to survive off of Kessel but with the downside that they have massive appetites. They can however survive in extreme temperatures (both hot and cold) and they (or their product) are not aversed to the sunlight.</description>
    <statBases>
      <MoveSpeed>5</MoveSpeed>
      <ComfyTemperatureMin>-270</ComfyTemperatureMin>
      <ComfyTemperatureMax>100</ComfyTemperatureMax>
      <MarketValue>3000</MarketValue>
      <ArmorRating_Blunt>0.25</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.25</ArmorRating_Sharp>
      <ArmorRating_Heat>0.99</ArmorRating_Heat>
      <ToxicResistance>1</ToxicResistance>
      <ToxicEnvironmentResistance MayRequire="Ludeon.RimWorld.Biotech">1.0</ToxicEnvironmentResistance>
      <HypoxiaResistance MayRequire="kentington.saveourship2">1</HypoxiaResistance>
      <DecompressionResistance MayRequire="kentington.saveourship2">1</DecompressionResistance>
      <Wildness>0.95</Wildness>
    </statBases>
    <tools>
      <li>
        <label>tarsus spike</label>
        <capacities>
          <li>Cut</li>
          <li>Stab</li>
        </capacities>
        <power>20</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>RSW_SWClaws</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
      </li>
      <li>
        <label>fanged pedipalps</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>45.0</power>
        <cooldownTime>2.6</cooldownTime>
        <linkedBodyPartsGroup>HeadClaw</linkedBodyPartsGroup>
        <chanceFactor>0.5</chanceFactor>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>8</power>
        <cooldownTime>2.4</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <ingredient>
      <mergeCompatibilityTags>
        <li MayRequire="Ludeon.RimWorld.Ideology">InsectMeat</li>
      </mergeCompatibilityTags>
    </ingredient>
    <comps>
      <li Class="CompProperties_EggLayer">
        <eggUnfertilizedDef>RSW_EggEnergySpiderUnFertilized</eggUnfertilizedDef>
        <eggFertilizedDef>RSW_EggEnergySpiderFertilized</eggFertilizedDef>
        <eggFertilizationCountMax>1</eggFertilizationCountMax>
        <eggLayIntervalDays>30</eggLayIntervalDays>
        <eggProgressUnfertilizedMax>0.5</eggProgressUnfertilizedMax>
        <eggCountRange>1~3</eggCountRange>
      </li>
      <li Class="CompProperties_CanBeDormant" />
      <li Class="CompProperties_WakeUpDormant">
        <wakeUpOnDamage>true</wakeUpOnDamage>
      </li>
      <li Class="CompProperties_Milkable">
        <milkDef>RSW_Glitterstim</milkDef>
        <milkIntervalDays>5</milkIntervalDays>
        <milkAmount>5</milkAmount>
        <milkFemaleOnly>false</milkFemaleOnly>
      </li>
    </comps>
    <receivesSignals>true</receivesSignals>
    <modExtensions>
      <li MayRequire="Mlie.XNDNocturnalAnimals" Class="NocturnalAnimals.ExtendedRaceProperties">
        <bodyClock>Nocturnal</bodyClock>
      </li>
    </modExtensions>
    <race>
      <body>RSW_EnergySpider</body>
      <predator>true</predator>
      <maxPreyBodySize>4.0</maxPreyBodySize>
      <baseHungerRate>2.0</baseHungerRate>
      <baseBodySize>3.0</baseBodySize>
      <baseHealthScale>4.5</baseHealthScale>
      <foodType>CarnivoreAnimal, OvivoreAnimal, AnimalProduct</foodType>
      <lifeExpectancy>999</lifeExpectancy>
      <trainability>Advanced</trainability>
      <manhunterOnTameFailChance>0.5</manhunterOnTameFailChance>
      <manhunterOnDamageChance>1.0</manhunterOnDamageChance>
      <nameGenerator>RSW_SWAnimalNamerMale</nameGenerator>
      <nameGeneratorFemale>RSW_SWAnimalNamerFemale</nameGeneratorFemale>
      <leatherDef>RSW_Leather_Insectine</leatherDef>
      <useMeatFrom>Megaspider</useMeatFrom>
      <fleshType>Insectoid</fleshType>
      <bloodDef>Filth_BloodInsect</bloodDef>
      <specialTrainables>
        <li MayRequire="Ludeon.RimWorld.Odyssey">RSW_SW_WebShot</li>
      </specialTrainables>
      <wildBiomes>
        <TropicalRainforest>0.0</TropicalRainforest>
        <TropicalSwamp>0.0</TropicalSwamp>
        <TemperateSwamp>0.0</TemperateSwamp>
        <TemperateForest>0.0</TemperateForest>
        <BorealForest>0.0</BorealForest>
        <Tundra>0.0</Tundra>
        <ColdBog>0.0</ColdBog>
        <IceSheet>0.0</IceSheet>
      </wildBiomes>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.4</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.8</minAge>
          <soundWounded>RSW_Pawn_EnergySpider_Wounded</soundWounded>
          <soundDeath>RSW_Pawn_EnergySpider_Death</soundDeath>
          <soundCall>RSW_Pawn_EnergySpider_Call</soundCall>
          <soundAngry>RSW_Pawn_EnergySpider_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
      <soundEating>Insectoid_Eat</soundEating>
    </race>
    <tradeTags>
      <li>AnimalExotic</li>
      <li>AnimalFighter</li>
    </tradeTags>
  </ThingDef>
  <PawnKindDef ParentName="AnimalKindBase">
    <defName>RSW_EnergySpider</defName>
    <label>energy spider</label>
    <race>RSW_EnergySpider</race>
    <combatPower>500</combatPower>
    <ecoSystemWeight>0.1</ecoSystemWeight>
    <abilities>
      <li MayRequire="Ludeon.RimWorld.Odyssey">RSW_SW_WebShot</li>
    </abilities>
    <lifeStages>
      <li>
