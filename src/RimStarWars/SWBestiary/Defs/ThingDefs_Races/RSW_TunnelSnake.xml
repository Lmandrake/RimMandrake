    <race>RSW_TunnelSnake</race>
    <combatPower>320</combatPower>
    <ecoSystemWeight>0.35</ecoSystemWeight>
    <wildGroupSize>1</wildGroupSize>
    <specialTrainables>
      <li MayRequire="Ludeon.RimWorld.Odyssey">AttackTarget</li>
    </specialTrainables>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>swanimals/Klorslug/Klorslug_j</texPath>
