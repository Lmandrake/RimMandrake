<Defs>
  <!-- Ported by src/RimMandrake/Utils/donor_pack_port.py port (DONOR_DEFS_PORT_TO_OURS_1, batch W2c) from mlie.starwarsanimalcollection (MIT; workshop 3497316713, 1.6/Defs). Donor-only names renamed RSW_; values verbatim. A texPath under swanimals/ or swresource/ keeps the donor path; its PNGs are extracted donor art installed in SWBestiary/Textures through the art ledger (owner 2026-10-14: ports may re-use extracted donor art until we regenerate). Canon brief: design/RimStarWars/canon_references/(see tracker). Our own patches that targeted the donor defName were applied BEFORE the rename (so this is the creature the game showed): src/RimStarWars/SWBestiary/Patches/BeastNorm/BeastNorm_Law3.xml (20 ops), src/RimUtinni/UtinniPatches/Patches/AnimalTolerances_Ashkarr.xml (4 ops), src/RimUtinni/UtinniPatches/Patches/BiomeCastEvictions_WildBiomes.xml (17 ops). Those patch ops still name the donor and go dead when it is retired. -->
  <ThingDef ParentName="AnimalThingBase" ADogSaidBody="LegsTail">
    <defName>RSW_HarvesterBeetle</defName>
    <label>harvester beetle</label>
    <description>The harvester beetle were a large domesticated insectoid native to the planet Neimoidia, but were transplanted to all the Neimoidian purse worlds (as well as potential) worlds. They were large, herbivorous and were able to carry heavy loads on their swept backs. In the absence of their 'hive queens' pheremones, these animals have become feral but they still make excellent beasts of burden and can be milked for insect jelly.</description>
    <statBases>
      <MoveSpeed>4.0</MoveSpeed>
      <MarketValue>1250</MarketValue>
      <ComfyTemperatureMin>-5</ComfyTemperatureMin>
      <ComfyTemperatureMax>60</ComfyTemperatureMax>
      <ArmorRating_Blunt>0.40</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.40</ArmorRating_Sharp>
      <FilthRate>18</FilthRate>
      <CaravanRidingSpeedFactor>1.6</CaravanRidingSpeedFactor>
      <Wildness>0.4</Wildness>
    </statBases>
    <tools>
      <li>
        <label>mandibles</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>75.0</power>
        <cooldownTime>3.35</cooldownTime>
        <linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>24</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.1</chanceFactor>
      </li>
    </tools>
    <ingredient>
      <mergeCompatibilityTags>
        <li MayRequire="Ludeon.RimWorld.Ideology">InsectMeat</li>
      </mergeCompatibilityTags>
    </ingredient>
    <comps>
      <li Class="CompProperties_EggLayer">
        <eggUnfertilizedDef>RSW_EggHarvesterBeetleUnFertilized</eggUnfertilizedDef>
        <eggFertilizedDef>RSW_EggHarvesterBeetleFertilized</eggFertilizedDef>
        <eggFertilizationCountMax>1</eggFertilizationCountMax>
        <eggLayIntervalDays>15</eggLayIntervalDays>
        <eggProgressUnfertilizedMax>0.5</eggProgressUnfertilizedMax>
        <eggCountRange>1~3</eggCountRange>
      </li>
      <li Class="CompProperties_Milkable">
        <milkDef>InsectJelly</milkDef>
        <milkIntervalDays>2</milkIntervalDays>
        <milkAmount>15</milkAmount>
        <milkFemaleOnly>false</milkFemaleOnly>
      </li>
      <li Class="CompProperties_CanBeDormant" />
      <li Class="CompProperties_WakeUpDormant">
        <wakeUpOnDamage>true</wakeUpOnDamage>
      </li>
    </comps>
    <receivesSignals>true</receivesSignals>
    <race>
      <body>BeetleLike</body>
      <baseBodySize>5.0</baseBodySize>
      <baseHealthScale>5.0</baseHealthScale>
      <baseHungerRate>1.0</baseHungerRate>
      <foodType>VegetarianRoughAnimal, DendrovoreAnimal, AnimalProduct</foodType>
      <leatherDef>RSW_Leather_Insectine</leatherDef>
      <useMeatFrom>Megaspider</useMeatFrom>
      <fleshType>Insectoid</fleshType>
      <bloodDef>Filth_BloodInsect</bloodDef>
      <roamMtbDays>4</roamMtbDays>
      <trainability>None</trainability>
      <herdAnimal>true</herdAnimal>
      <packAnimal>true</packAnimal>
      <lifeExpectancy>10</lifeExpectancy>
      <manhunterOnDamageChance>0.9</manhunterOnDamageChance>
      <nameGenerator>RSW_SWAnimalNamerMale</nameGenerator>
      <nameGeneratorFemale>RSW_SWAnimalNamerFemale</nameGeneratorFemale>
      <specialTrainables>
        <li MayRequire="Ludeon.RimWorld.Odyssey">Dig</li>
      </specialTrainables>
      <willNeverEat>
        <li MayRequire="Ludeon.RimWorld.Royalty">Plant_TreeAnima</li>
        <li MayRequire="Ludeon.RimWorld.Ideology">Plant_TreeGauranlen</li>
        <li MayRequire="Ludeon.RimWorld.Biotech">Plant_TreePolux</li>
        <li MayRequire="Ludeon.RimWorld.Anomaly">Plant_TreeHarbinger</li>
        <li MayRequire="Ludeon.RimWorld.Odysse">Plant_TreeArchean</li>
      </willNeverEat>
      <wildBiomes>
        <TropicalRainforest>0.8</TropicalRainforest>
        <TropicalSwamp>0.08</TropicalSwamp>
        <TemperateSwamp>0.08</TemperateSwamp>
        <TemperateForest>0.08</TemperateForest>
        <BorealForest>0.02</BorealForest>
        <Tundra>0.0</Tundra>
        <ColdBog>0.0</ColdBog>
        <IceSheet>0.0</IceSheet>
      </wildBiomes>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.5</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>1.0</minAge>
          <soundWounded>RSW_Pawn_HarvesterBeetle_Wounded</soundWounded>
          <soundDeath>RSW_Pawn_HarvesterBeetle_Death</soundDeath>
          <soundCall>RSW_Pawn_HarvesterBeetle_Call</soundCall>
          <soundAngry>RSW_Pawn_HarvesterBeetle_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
      <soundEating>Insectoid_Eat</soundEating>
      <manhunterOnTameFailChance>0.4</manhunterOnTameFailChance>
    </race>
    <tradeTags>
      <li>AnimalExotic</li>
      <li>AnimalFarm</li>
      <li>AnimalFighter</li>
    </tradeTags>
  </ThingDef>
