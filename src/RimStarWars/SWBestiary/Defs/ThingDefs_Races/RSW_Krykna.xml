        <BorealForest>0.1</BorealForest>
        <Tundra>0.1</Tundra>
        <ColdBog>0.1</ColdBog>
        <IceSheet>0.1</IceSheet>
      </wildBiomes>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.1</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.2</minAge>
          <soundWounded>RSW_Pawn_Krykna_Wounded</soundWounded>
          <soundDeath>RSW_Pawn_Krykna_Death</soundDeath>
          <soundCall>RSW_Pawn_Krykna_Call</soundCall>
          <soundAngry>RSW_Pawn_Krykna_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
