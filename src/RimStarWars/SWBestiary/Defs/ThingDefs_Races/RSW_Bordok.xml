<Defs>
  <!-- Ported by src/RimMandrake/Utils/donor_pack_port.py port (DONOR_DEFS_PORT_TO_OURS_1, batch W2b) from mlie.starwarsanimalcollection (MIT; workshop 3497316713, 1.6/Defs). Donor-only names renamed RSW_; values verbatim. A texPath under swanimals/ or swresource/ keeps the donor path; its PNGs are extracted donor art installed in SWBestiary/Textures through the art ledger (owner 2026-10-14: ports may re-use extracted donor art until we regenerate). Canon brief: design/RimStarWars/canon_references/(see tracker). Our own patches that targeted the donor defName were applied BEFORE the rename (so this is the creature the game showed): src/RimMandrake/MandrakePatches/Patches/AnimalDessicatedTexPaths_Fix.xml (1 ops), src/RimStarWars/SWBestiary/Patches/ArtFold/Gualaar_ArtFold.xml (1 ops), src/RimStarWars/SWBestiary/Patches/BeastNorm/BeastNorm_Law3.xml (16 ops), src/RimUtinni/UtinniPatches/Patches/AnimalBiomeDuplicates_Fix.xml (2 ops), src/RimUtinni/UtinniPatches/Patches/AnimalBiomeDuplicates_Generated.xml (1 ops), src/RimUtinni/UtinniPatches/Patches/AnimalTolerances_Ashkarr.xml (12 ops), src/RimUtinni/UtinniPatches/Patches/BiomeCastEvictions_WildBiomes.xml (28 ops). Those patch ops still name the donor and go dead when it is retired. -->
  <ThingDef ParentName="AnimalThingBase" ADogSaidBody="LegsTail">
    <defName>RSW_Bordok</defName>
    <label>bordok</label>
    <description>The bordoks were a vaguely equine herbivore native to the forest moon of Endor. They were used on many worlds as pack animals when tamed. Bordoks were very sure-footed and, in spite of their size, capable of carrying large loads.</description>
    <statBases>
      <MoveSpeed>5.0</MoveSpeed>
      <MarketValue>360</MarketValue>
      <ComfyTemperatureMin>-30</ComfyTemperatureMin>
      <ComfyTemperatureMax>40</ComfyTemperatureMax>
      <FilthRate>16</FilthRate>
      <CaravanRidingSpeedFactor>1.3</CaravanRidingSpeedFactor>
      <Wildness>0</Wildness>
    </statBases>
    <tools>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>21.0</power>
        <cooldownTime>1.77</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
      </li>
      <li>
        <label>left hoof</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>8</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftLeg</linkedBodyPartsGroup>
      </li>
      <li>
        <label>right hoof</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>8</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>FrontRightLeg</linkedBodyPartsGroup>
      </li>
      <li>
        <label>horn</label>
        <capacities>
          <li>Scratch</li>
          <li>Stab</li>
        </capacities>
        <power>6</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HornAttackTool</linkedBodyPartsGroup>
      </li>
    </tools>
    <comps>
      <li Class="CompProperties_Milkable">
        <milkDef>Milk</milkDef>
        <milkIntervalDays>2</milkIntervalDays>
        <milkAmount>12</milkAmount>
      </li>
    </comps>
    <race>
      <herdAnimal>true</herdAnimal>
      <body>QuadrupedAnimalWithHoovesAndHorn</body>
      <baseBodySize>1.4</baseBodySize>
      <baseHealthScale>1.45</baseHealthScale>
      <baseHungerRate>0.30</baseHungerRate>
      <foodType>VegetarianRoughAnimal</foodType>
      <leatherDef>Leather_Plain</leatherDef>
      <specificMeatDef>RSW_Tough_Meat</specificMeatDef>
      <gestationPeriodDays>7</gestationPeriodDays>
      <petness>0.60</petness>
      <roamMtbDays>7</roamMtbDays>
      <nameGenerator>RSW_SWAnimalNamerMale</nameGenerator>
      <nameGeneratorFemale>RSW_SWAnimalNamerFemale</nameGeneratorFemale>
      <trainability>None</trainability>
      <packAnimal>true</packAnimal>
      <lifeExpectancy>30</lifeExpectancy>
      <specialTrainables>
        <li MayRequire="Ludeon.RimWorld.Odyssey">Comfort</li>
      </specialTrainables>
      <wildBiomes>
        <TropicalSwamp>0.04</TropicalSwamp>
        <BorealForest>0.8</BorealForest>
        <TemperateForest>0.8</TemperateForest>
        <TropicalRainforest>0.04</TropicalRainforest>
        <TemperateSwamp>0.2</TemperateSwamp>
        <ColdBog>0.04</ColdBog>
        <Tundra>0.4</Tundra>
      </wildBiomes>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.25</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.3333</minAge>
          <soundWounded>Pawn_Donkey_Wounded</soundWounded>
          <soundDeath>Pawn_Donkey_Death</soundDeath>
          <soundCall>Pawn_Donkey_Call</soundCall>
          <soundAngry>Pawn_Donkey_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
      <soundEating>Herbivore_Eat</soundEating>
    </race>
    <tradeTags>
      <li>AnimalUncommon</li>
      <li>AnimalFarm</li>
    </tradeTags>
  </ThingDef>
