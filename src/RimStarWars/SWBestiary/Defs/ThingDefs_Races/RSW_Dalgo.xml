<!--
  MLIE_FAUNA_ABSORPTION_1 Wave C — Dalgo creature port.
  Ported from mlie.starwarsanimalcollection's `Dalgo` ThingDef/PawnKindDef
  pair (Races_Animal_SW.xml, workshop folder 3497316713), renamed under the
  RSW_ tier prefix. Geometry/stats/comps copied verbatim. No custom body:
  `body` stays the vanilla Core `QuadrupedAnimalWithHooves` — no BodyDef
  port needed. `leatherDef`/`specificMeatDef` repoint to the already-ported
  RSW_Leather_Saurian/RSW_Saurian_Meat (Wave B). No comps (no egg layer). Its
  Odyssey `SW_Spur` specialTrainable/ability is vanilla Core content, left
  unprefixed. Sounds repoint to the already-absorbed sound wave
  (RSW_Pawn_Dalgo_*, 2026-09-02). texPaths are unchanged text — extracted
  art sits at Textures/swanimals/Dalgo/ (extract_bundle.py against the same
  AssetBundle every prior wave used; 3 extra "DalgoPack" textures in the
  bundle are unreferenced by any donor def, left unextracted).

  Wired into the live cast this same pass: BiomeCypreJungle (per
  cast_assignment.csv's current row for this species), repointed from the
  bare "Dalgo" entry in cast_assignment.csv / BiomeCast_Ashkarr.xml.
-->
<Defs>
<ThingDef ParentName="AnimalThingBase" ADogSaidBody="LegsTail">
    <defName>RSW_Dalgo</defName>
    <label>dalgo</label>
    <description>Dalgos were equine reptiles native to the planet of Onderon. Despite being carnivorous predators, they could still be domesticated and filled the same role as other beasts of burden. It is for this reason these creatures found themselves spread across many worlds.</description>
    <statBases>
      <MoveSpeed>5.6</MoveSpeed>
      <MarketValue>500</MarketValue>
      <ComfyTemperatureMin>-10</ComfyTemperatureMin>
      <ComfyTemperatureMax>60</ComfyTemperatureMax>
      <FilthRate>16</FilthRate>
      <ArmorRating_Sharp>0.12</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.12</ArmorRating_Blunt>
      <ArmorRating_Heat>0.12</ArmorRating_Heat>
      <Wildness>0.35</Wildness>
    </statBases>
    <tools>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>10</power>
        <cooldownTime>2.9</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
      </li>
      <li>
        <label>left hoof</label>
        <labelNoLocation>hoof</labelNoLocation>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>8</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftLeg</linkedBodyPartsGroup>
      </li>
      <li>
        <label>right hoof</label>
        <labelNoLocation>hoof</labelNoLocation>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>8</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>FrontRightLeg</linkedBodyPartsGroup>
      </li>
      <li>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>8</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        <chanceFactor>0.5</chanceFactor>
      </li>
    </tools>
    <race>
      <body>QuadrupedAnimalWithHooves</body>
      <predator>true</predator>
      <baseBodySize>2.5</baseBodySize>
      <maxPreyBodySize>2.0</maxPreyBodySize>
      <baseHealthScale>1.80</baseHealthScale>
      <baseHungerRate>0.45</baseHungerRate>
      <foodType>CarnivoreAnimal, OvivoreAnimal, AnimalProduct</foodType>
      <leatherDef>RSW_Leather_Saurian</leatherDef>
      <specificMeatDef>RSW_Saurian_Meat</specificMeatDef>
      <trainability>None</trainability>
      <packAnimal>true</packAnimal>
      <herdAnimal>true</herdAnimal>
      <gestationPeriodDays>7</gestationPeriodDays>
      <petness>0.6</petness>
      <roamMtbDays>4</roamMtbDays>
      <manhunterOnDamageChance>0.30</manhunterOnDamageChance>
      <nameGenerator>SWAnimalNamerMale</nameGenerator>
      <nameGeneratorFemale>SWAnimalNamerFemale</nameGeneratorFemale>
      <nameOnTameChance>1</nameOnTameChance>
      <nuzzleMtbHours>48</nuzzleMtbHours>
      <specialTrainables>
        <li MayRequire="Ludeon.RimWorld.Odyssey">SW_Spur</li>
      </specialTrainables>
      <wildBiomes>
        <AridShrubland>0.4</AridShrubland>
        <Desert>0.00</Desert>
        <ExtremeDesert>0.0</ExtremeDesert>
        <TropicalRainforest>0.4</TropicalRainforest>
        <TropicalSwamp>0.01</TropicalSwamp>
