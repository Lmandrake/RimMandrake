<?xml version="1.0" encoding="utf-8"?>
<!--
  MLIE_FAUNA_ABSORPTION_1 Wave C — Sketto creature port.
  Ported from mlie.starwarsanimalcollection's `Sketto` ThingDef/PawnKindDef
  pair (Races_Animal_SW.xml, workshop folder 3497316713), renamed under the
  RSW_ tier prefix. Geometry/stats/comps copied verbatim. `body` points at
  `RSW_Bogwing` (SWBESTIARY_UNPREFIXED_DONOR_DEFS_1, 2026-09-21) — donor
  content, NOT vanilla Core (confirmed via RimSage: zero defs named
  `Bogwing` on the machine); the earlier "vanilla Core Bogwing body — no
  BodyDef port needed" note here was wrong the same way the FlyingAvian one
  in RSW_MlieWaveC_Bodies.xml was. Already ported as `RSW_Bogwing`
  (RSW_MlieWaveC_Bodies.xml, used by Dactillion/Uvak); repointed here from
  the bare `Bogwing` duplicate in the now-deleted
  `RSW_DesertPortA_Bodies.xml`, which was silently winning the load-order
  collision against this same donor name. `leatherDef`
  (`Leather_Lizard`) is vanilla Core, left bare. `specificMeatDef`
  (`Reptavian_Meat`) ALREADY EXISTS as `RSW_Reptavian_Meat` (Wave B) — no new
  resource needed. Adult lifeStage sounds (`Pawn_Sketto_Call`, reused for
  all 4 vocal slots — wounded/death/call/angry all point at the same clip,
  confirmed directly off the donor's own `<race>` block, not a typo) were
  already absorbed in the 2026-09-02 sound wave — confirmed present in
  SoundDefs_SWBestiary.xml as `RSW_Pawn_Sketto_*`, wired, not re-done.
  `modExtensions` (`NocturnalAnimals.ExtendedRaceProperties`,
  MayRequire="Mlie.XNDNocturnalAnimals") left verbatim, same
  gated-on-a-donor-add-on-mod pattern as Shyrack this same pass — degrades
  cleanly if that add-on isn't installed. No `specialTrainables`/`abilities`
  at all (donor leaves it bare).

  No `*ArtOverride` mod exists for Sketto (checked first). 16 PNGs
  extracted this pass via extract_bundle.py against the same AssetBundle
  every prior wave used: `Sketto_{south,east,north}` (base facing),
  `Sketto_Dessicated`, and all 12 flying-animation frame textures
  (`Sketto_Flying_{1,2,3,4}_{south,east,north}`) the donor's own
  PawnKindDef `flyingAnimationFramePathPrefix`/`flyingAnimationFrameCount`
  fields reference — unlike Shyrack this same pass, Sketto's frame naming
  is clean (`_4_`, not `_44_`), every texPath the def references resolves.
  Sits at Textures/swanimals/Sketto/.

  Wired into the live cast this same pass: per cast_assignment.csv's current
  row(s) for this species, repointed from the bare "Sketto" entry in
  cast_assignment.csv / BiomeCast_Ashkarr.xml.
-->
<Defs>
<ThingDef ParentName="AnimalThingBase" ADogSaidBody="LegsTail">
    <defName>RSW_Sketto</defName>
    <label>sketto</label>
    <description>Skettos were carnivorous flying reptiles that dwelled in the caverns of the planet Tatooine. Only emerging at daybreak and twilight, they possessed many rods in their eyes to assist their vision in low-light conditions as they ate airborne insects. Though reptilian, they were warm-blooded and gave birth to a single offspring at a time. Their small size and lower metabolism made them excellent stowaways and populations easily established themselves on other worlds.</description>
    <statBases>
      <MoveSpeed>3.0</MoveSpeed>
      <MarketValue>60</MarketValue>
      <ComfyTemperatureMin>-8</ComfyTemperatureMin>
      <ComfyTemperatureMax>80</ComfyTemperatureMax>
      <Wildness>0.6</Wildness>
      <MaxFlightTime>30</MaxFlightTime>
      <FlightCooldown>10</FlightCooldown>
    </statBases>
    <tools>
      <li>
        <label>left clawed paw</label>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>8</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
      </li>
      <li>
        <label>right clawed paw</label>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>8</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup>
      </li>
      <li>
        <label>beak</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>12</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>6</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <modExtensions>
      <li MayRequire="Mlie.XNDNocturnalAnimals" Class="NocturnalAnimals.ExtendedRaceProperties">
        <bodyClock>Crepuscular</bodyClock>
      </li>
    </modExtensions>
    <race>
      <body>RSW_Bogwing</body>
      <predator>true</predator>
      <herdAnimal>true</herdAnimal>
      <baseBodySize>0.4</baseBodySize>
      <maxPreyBodySize>0.4</maxPreyBodySize>
      <baseHungerRate>0.12</baseHungerRate>
      <baseHealthScale>0.85</baseHealthScale>
      <foodType>CarnivoreAnimal, AnimalProduct</foodType>
      <leatherDef>Leather_Lizard</leatherDef>
      <specificMeatDef>RSW_Reptavian_Meat</specificMeatDef>
      <trainability>None</trainability>
      <roamMtbDays>1.5</roamMtbDays>
      <lifeExpectancy>20</lifeExpectancy>
      <nameGenerator>SWAnimalNamerMale</nameGenerator>
      <nameGeneratorFemale>SWAnimalNamerFemale</nameGeneratorFemale>
      <nameOnTameChance>1</nameOnTameChance>
      <flightStartChanceOnJobStart>0.05</flightStartChanceOnJobStart>
      <canFlyIntoMap>true</canFlyIntoMap>
      <canLeaveMapFlying>true</canLeaveMapFlying>
      <leaveMapOnFleeChance>0.8</leaveMapOnFleeChance>
      <soundEating>Reptile_Eat</soundEating>
      <gestationPeriodDays>4</gestationPeriodDays>
      <litterSizeCurve>
        <points>
          <li>(0.5, 0)</li>
          <li>(1, 1.0)</li>
          <li>(1.5, 0)</li>
        </points>
      </litterSizeCurve>
      <wildBiomes>
        <AridShrubland>0.8</AridShrubland>
        <Desert>0.4</Desert>
        <ExtremeDesert>0.01</ExtremeDesert>
        <TropicalRainforest>0.08</TropicalRainforest>
        <TropicalSwamp>0.04</TropicalSwamp>
        <TemperateSwamp>0.0</TemperateSwamp>
        <TemperateForest>0.01</TemperateForest>
        <BorealForest>0.0</BorealForest>
        <Tundra>0.0</Tundra>
        <ColdBog>0.0</ColdBog>
        <IceSheet>0.0</IceSheet>
      </wildBiomes>
      <lifeStageAges>
        <li>
          <def>AnimalBabyTiny</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.12</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.2</minAge>
          <soundWounded>RSW_Pawn_Sketto_Call</soundWounded>
          <soundDeath>RSW_Pawn_Sketto_Call</soundDeath>
          <soundCall>RSW_Pawn_Sketto_Call</soundCall>
          <soundAngry>RSW_Pawn_Sketto_Call</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <tradeTags>
      <li>AnimalUncommon</li>
      <li>AnimalExotic</li>
    </tradeTags>
  </ThingDef>
<PawnKindDef ParentName="AnimalKindBase">
    <defName>RSW_Sketto</defName>
    <label>sketto</label>
    <race>RSW_Sketto</race>
    <combatPower>35</combatPower>
    <ecoSystemWeight>0.50</ecoSystemWeight>
    <wildGroupSize>2~4</wildGroupSize>
    <flyingAnimationFramePathPrefix>swanimals/Sketto/Sketto_Flying_</flyingAnimationFramePathPrefix>
    <flyingAnimationFrameCount>4</flyingAnimationFrameCount>
    <flyingAnimationTicksPerFrame>4</flyingAnimationTicksPerFrame>
    <flyingAnimationDrawSize>1.0</flyingAnimationDrawSize>
    <flyingAnimationDrawSizeIsMultiplier>false</flyingAnimationDrawSizeIsMultiplier>
    <flyingAnimationInheritColors>false</flyingAnimationInheritColors>
    <lifeStages>
      <li>
        <label>sketto neonates</label>
        <labelPlural>sketto neonates</labelPlural>
        <bodyGraphicData>
          <texPath>swanimals/Sketto/Sketto</texPath>
          <drawSize>0.50</drawSize>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>swanimals/Sketto/Sketto_Dessicated</texPath>
          <drawSize>0.50</drawSize>
        </dessicatedBodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>swanimals/Sketto/Sketto</texPath>
          <drawSize>1.0</drawSize>
          <shadowData>
            <volume>(0.2, 0.2, 0.2)</volume>
            <offset>(0,0,-0.2)</offset>
          </shadowData>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>swanimals/Sketto/Sketto_Dessicated</texPath>
          <drawSize>1.0</drawSize>
        </dessicatedBodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>swanimals/Sketto/Sketto</texPath>
          <drawSize>1.25</drawSize>
          <shadowData>
            <volume>(0.3, 0.3, 0.3)</volume>
            <offset>(0,0,-0.2)</offset>
          </shadowData>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>swanimals/Sketto/Sketto_Dessicated</texPath>
          <drawSize>1.25</drawSize>
        </dessicatedBodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>
</Defs>
