<?xml version="1.0" encoding="utf-8"?>
<!--
  MLIE_FAUNA_ABSORPTION_1 Wave C, Pass 24 — WompRat creature port.
  Ported from mlie.starwarsanimalcollection's `WompRat` ThingDef/PawnKindDef
  pair, renamed under the RSW_ tier prefix. Body (`QuadrupedAnimalWithPaws`)
  is vanilla Core, left bare. `leatherDef` (`Leather_Light`) is vanilla Core,
  left bare. `specificMeatDef` (`Rodentia_Meat`) ALREADY EXISTS as
  `RSW_Rodentia_Meat` (Pass 18, Ollopom). No egg comp (live birth). All 4
  vocal sounds already absorbed (`RSW_Pawn_WompRat_*`). `modExtensions`'
  NocturnalAnimals entry left verbatim.

  No `*ArtOverride` mod exists for WompRat. 4 PNGs extracted this pass:
  `WompRat_{south,east,north}` and `WompRat_Dessicated`.
-->
<Defs>
<!-- ThingDef -->
<ThingDef ParentName="AnimalThingBase" ADogSaidBody="LegsTail">
    <defName>RSW_WompRat</defName>
    <label>womp rat</label>
    <description>Womp rats were large, omnivorous rodents native to Tatooine that were widely considered to be pests. While womp rats were opportunists and fond of carrion, they were also predators. Although their normal prey included smaller animals, such as scurriers.</description>
    <statBases>
      <MoveSpeed>3.9</MoveSpeed>
      <MarketValue>150</MarketValue>
      <ComfyTemperatureMin>-10</ComfyTemperatureMin>
      <ComfyTemperatureMax>80</ComfyTemperatureMax>
      <FilthRate>8</FilthRate>
      <ToxicEnvironmentResistance MayRequire="Ludeon.RimWorld.Biotech">0.8</ToxicEnvironmentResistance>
      <Wildness>0.75</Wildness>
    </statBases>
    <tools>
      <li>
        <label>left claw</label>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>8.5</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
      </li>
      <li>
        <label>right claw</label>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>8.5</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup>
      </li>
      <li>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>8</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        <chanceFactor>0.7</chanceFactor>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>4</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <comps />
    <modExtensions>
      <li MayRequire="Mlie.XNDNocturnalAnimals" Class="NocturnalAnimals.ExtendedRaceProperties">
        <bodyClock>Nocturnal</bodyClock>
      </li>
    </modExtensions>
    <race>
      <body>QuadrupedAnimalWithPaws</body>
      <herdAnimal>true</herdAnimal>
      <predator>true</predator>
      <maxPreyBodySize>1.0</maxPreyBodySize>
      <baseBodySize>0.75</baseBodySize>
      <baseHungerRate>0.225</baseHungerRate>
      <baseHealthScale>0.7</baseHealthScale>
      <foodType>CarnivoreAnimal, OmnivoreRoughAnimal, OvivoreAnimal, AnimalProduct</foodType>
      <leatherDef>Leather_Light</leatherDef>
      <specificMeatDef>RSW_Rodentia_Meat</specificMeatDef>
      <trainability>None</trainability>
      <nameGenerator>SWAnimalNamerMale</nameGenerator>
      <nameGeneratorFemale>SWAnimalNamerFemale</nameGeneratorFemale>
      <petness>0.01</petness>
      <lifeExpectancy>15</lifeExpectancy>
      <gestationPeriodDays>6</gestationPeriodDays>
      <litterSizeCurve>
        <points>
          <li>(0.5, 0)</li>
          <li>(1, 1)</li>
          <li>(1.5, 1)</li>
          <li>(2, 0)</li>
        </points>
      </litterSizeCurve>
      <wildBiomes>
        <AridShrubland>0.4</AridShrubland>
        <Desert>0.4</Desert>
        <ExtremeDesert>0.3</ExtremeDesert>
        <TropicalRainforest>0.4</TropicalRainforest>
        <TropicalSwamp>0.0</TropicalSwamp>
        <TemperateForest>0.01</TemperateForest>
        <TemperateSwamp>0.0</TemperateSwamp>
        <BorealForest>0.0</BorealForest>
        <Tundra>0.0</Tundra>
        <ColdBog>0.0</ColdBog>
        <IceSheet>0.0</IceSheet>
      </wildBiomes>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.2</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.4</minAge>
          <soundWounded>Pawn_WompRat_Wounded</soundWounded>
          <soundDeath>Pawn_WompRat_Death</soundDeath>
          <soundCall>Pawn_WompRat_Call</soundCall>
          <soundAngry>Pawn_WompRat_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
      <soundEating>Rodent_Eat</soundEating>
    </race>
    <tradeTags>
      <li>AnimalCommon</li>
    </tradeTags>
  </ThingDef>

