        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.4</minAge>
          <soundWounded>RSW_Pawn_Fanback_Wounded</soundWounded>
          <soundDeath>RSW_Pawn_Fanback_Death</soundDeath>
          <soundCall>RSW_Pawn_Fanback_Call</soundCall>
          <soundAngry>RSW_Pawn_Fanback_Angry</soundAngry>
