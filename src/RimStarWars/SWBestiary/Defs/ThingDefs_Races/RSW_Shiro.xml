          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.15</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.2222</minAge>
          <soundWounded>RSW_Pawn_Shiro_Wounded</soundWounded>
          <soundDeath>RSW_Pawn_Shiro_Death</soundDeath>
          <soundCall>RSW_Pawn_Shiro_Call</soundCall>
          <soundAngry>RSW_Pawn_Shiro_Angry</soundAngry>
