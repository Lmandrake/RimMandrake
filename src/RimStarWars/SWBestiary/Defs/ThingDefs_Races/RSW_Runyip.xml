      <leatherDef>Leather_Plain</leatherDef>
      <specificMeatDef>RSW_Pachydermoid_Meat</specificMeatDef>
      <gestationPeriodDays>8</gestationPeriodDays>
      <roamMtbDays>1.4</roamMtbDays>
      <herdAnimal>true</herdAnimal>
      <packAnimal>true</packAnimal>
      <trainability>None</trainability>
      <nameGenerator>SWAnimalNamerMale</nameGenerator>
      <nameGeneratorFemale>SWAnimalNamerFemale</nameGeneratorFemale>
      <lifeExpectancy>22</lifeExpectancy>
      <manhunterOnDamageChance>0.40</manhunterOnDamageChance>
      <waterSeeker>true</waterSeeker>
      <waterCellCost>1</waterCellCost>
      <specialTrainables>
        <li MayRequire="Ludeon.RimWorld.Odyssey">RSW_SW_Spur</li>
      </specialTrainables>
      <litterSizeCurve>
