<Defs>
  <!-- Ported by src/RimMandrake/Utils/donor_pack_port.py port (DONOR_DEFS_PORT_TO_OURS_1, batch W2c) from mlie.starwarsanimalcollection (MIT; workshop 3497316713, 1.6/Defs). Donor-only names renamed RSW_; values verbatim. A texPath under swanimals/ or swresource/ keeps the donor path; its PNGs are extracted donor art installed in SWBestiary/Textures through the art ledger (owner 2026-10-14: ports may re-use extracted donor art until we regenerate). Canon brief: design/RimStarWars/canon_references/grazer. Our own patches that targeted the donor defName were applied BEFORE the rename (so this is the creature the game showed): src/RimStarWars/SWBestiary/Patches/BeastNorm/BeastNorm_Law3.xml (20 ops), src/RimUtinni/UtinniPatches/Patches/AnimalTolerances_Ashkarr.xml (4 ops), src/RimUtinni/UtinniPatches/Patches/BiomeCastEvictions_WildBiomes.xml (17 ops). Those patch ops still name the donor and go dead when it is retired. -->
  <ThingDef ParentName="AnimalThingBase" ADogSaidBody="LegsTail">
    <defName>RSW_Grazer</defName>
    <label>grazer</label>
    <description>A large, slow domesticated mammalia from Alderaan that has been selectively bred to produce huge amounts of milk. Their fat reserves function to insulate them well against a broad range of temperature. However, most of them are so adapted to farm life that they cannot survive in the wild like their feral brethren.</description>
    <statBases>
      <MoveSpeed>1.75</MoveSpeed>
      <ComfyTemperatureMin>-58</ComfyTemperatureMin>
      <ComfyTemperatureMax>45</ComfyTemperatureMax>
      <ArmorRating_Sharp>0.06</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.06</ArmorRating_Blunt>
      <MarketValue>400</MarketValue>
      <FilthRate>16</FilthRate>
      <Wildness>0</Wildness>
    </statBases>
    <comps>
      <li Class="CompProperties_Milkable">
        <milkDef>Milk</milkDef>
        <milkIntervalDays>1</milkIntervalDays>
        <milkAmount>20</milkAmount>
      </li>
    </comps>
    <tools>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>41.25</power>
        <cooldownTime>2.49</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <race>
      <body>QuadrupedAnimalWithHooves</body>
      <herdAnimal>true</herdAnimal>
      <baseBodySize>2.75</baseBodySize>
      <baseHungerRate>0.8</baseHungerRate>
      <baseHealthScale>1.75</baseHealthScale>
      <foodType>VegetarianRoughAnimal</foodType>
      <leatherDef>RSW_Leather_Nerf</leatherDef>
      <specificMeatDef>RSW_Nerf_Meat</specificMeatDef>
      <roamMtbDays>7</roamMtbDays>
      <trainability>None</trainability>
      <gestationPeriodDays>6</gestationPeriodDays>
      <lifeExpectancy>18</lifeExpectancy>
      <nameGenerator>RSW_SWAnimalNamerMale</nameGenerator>
      <nameGeneratorFemale>RSW_SWAnimalNamerFemale</nameGeneratorFemale>
      <canCrossBreedWith>
        <li>RSW_FeralGrazer</li>
        <li>RSW_Nerf</li>
        <li>RSW_Grazer</li>
        <li>RSW_FeralNerf</li>
      </canCrossBreedWith>
      <litterSizeCurve>
        <points>
          <li>(0.5, 0)</li>
          <li>(1, 1)</li>
          <li>(2, 1.7)</li>
          <li>(2.5, 0.7)</li>
          <li>(3, 0)</li>
        </points>
      </litterSizeCurve>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.20</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.30</minAge>
          <soundWounded>RSW_Pawn_FeralGrazer_Wounded</soundWounded>
          <soundDeath>RSW_Pawn_FeralGrazer_Death</soundDeath>
          <soundCall>RSW_Pawn_FeralGrazer_Call</soundCall>
          <soundAngry>RSW_Pawn_FeralGrazer_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
      <soundEating>Herbivore_Eat</soundEating>
      <manhunterOnDamageChance>0.9</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0.4</manhunterOnTameFailChance>
    </race>
    <tradeTags>
      <li>AnimalCommon</li>
      <li>AnimalFarm</li>
    </tradeTags>
  </ThingDef>
