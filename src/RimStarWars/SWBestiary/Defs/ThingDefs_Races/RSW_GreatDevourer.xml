					</shadowData>
				</bodyGraphicData>
				<dessicatedBodyGraphicData>
					<texPath>Things/Pawn/Animal/AA_GreatDevourer/AA_Dessicated_GreatDevourer</texPath>
					<drawSize>3.5</drawSize>
				</dessicatedBodyGraphicData>
			</li>
		</lifeStages>
	</PawnKindDef>

</Defs>
