<Defs>
<ThingDef ParentName="AnimalThingBase" ADogSaidBody="LegsTail">
    <defName>RSW_LongtailGorg</defName>
    <label>longtail gorg</label>
    <description>Longtail Gorgs, were small tailed amphibians that could be found on several planets. This subspecies was slightly larger than the usual and had a tail (hence the name) and could lay unfertilized eggs. Their spread can be attributed to this variety being a favoured snack among the Hutt species.</description>
    <statBases>
      <MoveSpeed>2.3</MoveSpeed>
      <MarketValue>90</MarketValue>
      <ComfyTemperatureMin>-5</ComfyTemperatureMin>
      <ComfyTemperatureMax>80</ComfyTemperatureMax>
      <LeatherAmount>0</LeatherAmount>
      <FilthRate>4</FilthRate>
      <ToxicEnvironmentResistance MayRequire="Ludeon.RimWorld.Biotech">0.8</ToxicEnvironmentResistance>
      <Wildness>0</Wildness>
    </statBases>
    <tools>
      <li>
        <label>claws</label>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>4</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftClaws</linkedBodyPartsGroup>
      </li>
      <li>
        <label>claws</label>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>4</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>FrontRightClaws</linkedBodyPartsGroup>
      </li>
      <li>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>5</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>2</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <comps>
      <li Class="CompProperties_EggLayer">
        <eggUnfertilizedDef>RSW_EggLongtailGorgUnFertilized</eggUnfertilizedDef>
        <eggFertilizedDef>RSW_EggLongtailGorgFertilized</eggFertilizedDef>
        <eggLayIntervalDays>2</eggLayIntervalDays>
        <eggCountRange>1~3</eggCountRange>
      </li>
    </comps>
    <race>
      <body>QuadrupedAnimalWithClawsTailAndJowl</body>
      <baseHungerRate>0.20</baseHungerRate>
      <baseBodySize>0.6</baseBodySize>
      <baseHealthScale>0.40</baseHealthScale>
      <foodType>OmnivoreRoughAnimal, OvivoreAnimal, AnimalProduct</foodType>
      <trainability>None</trainability>
      <nameGenerator>SWAnimalNamerMale</nameGenerator>
      <nameGeneratorFemale>SWAnimalNamerFemale</nameGeneratorFemale>
      <leatherDef>Leather_Light</leatherDef>
      <specificMeatDef>RSW_Gorg_Meat</specificMeatDef>
      <roamMtbDays>7</roamMtbDays>
      <lifeExpectancy>8</lifeExpectancy>
      <waterSeeker>true</waterSeeker>
      <waterCellCost>1</waterCellCost>
      <canFishForFood>true</canFishForFood>
      <canCrossBreedWith>
        <li>RSW_FrilledGorg</li>
        <li>RSW_Gorg</li>
      </canCrossBreedWith>
      <wildBiomes>
        <AridShrubland>1.0</AridShrubland>
