<!--
  MLIE_FAUNA_ABSORPTION_1 Wave C — Mott creature port (Pass 18).
  Ported from mlie.starwarsanimalcollection's `Mott` ThingDef/PawnKindDef
  pair (Races_Animal_SW.xml, workshop folder 3497316713), renamed under the
  RSW_ tier prefix. Geometry/stats/comps copied verbatim.

  Body: `<race><body>QuadrupedAnimalWithPaws</body>` is confirmed VANILLA
  CORE (Data/Core/Defs/Bodies/Bodies_Animal_Quadruped.xml) — left bare, no
  BodyDef port needed, same "no port needed" pattern as LongtailGorg/Lothcat
  (Pass 16/17).

  `leatherDef` (`Leather_Light`) is vanilla Core, left bare (same reuse as
  LongtailGorg). `specificMeatDef` (`Tender_Meat`) had never been ported —
  ported this pass as `RSW_Tender_Meat` (RSW_MlieWaveC_Resources.xml),
  texPath swresource/Meat_Tender, newly extracted this pass (3 PNGs). No
  egg comp (live birth via `gestationPeriodDays`/`litterSizeCurve`,
  confirmed directly off the donor's own `<race>` block). No abilities
  (donor sets no `specialTrainables`).

  🔑 Carries the donor's own `modExtensions` block gated
  `MayRequire="pathfinding.framework"` (`PathfindingFramework.MovementExtension`,
  `PF_Movement_Amphibious`) — kept verbatim, same established pattern as
  Igitz/Dianoga/Falumpaset/Fambaa/Dragonsnake/Nuna (this donor's amphibious
  species all carry this same gated block).

  No `canCrossBreedWith` in the donor. Grepped every already-ported
  `RSW_*.xml` in SWBestiary for a stray `<li>Mott</li>` — none found.

  Art: no ArtOverride mod exists for Mott (checked first). 13 PNGs
  extracted this pass via extract_bundle.py against the same AssetBundle
  every prior wave used (workshop folder 3497316713) — `Mott_m_{south,east,
  north}` adult male, `Mott_f_{south,east,north}` adult female,
  `Mott_m_Swimming_{south,east,north}`/`Mott_f_Swimming_{south,east,north}`
  (a `waterSeeker` with per-sex `swimmingGraphicData`, same pattern
  LongtailGorg established), single `Mott_Dessicated` with no facing suffix
  or male/female split. All 13 confirmed non-zero (256x256 RGBA) and
  PIL-openable before wiring in. Run via `python.exe` on the native
  `C:\...` bundle path, extracted flat (without keep-paths mode) to a Windows
  temp dir and copied into the repo tree over `/mnt/c`. Sits at
  Textures/swanimals/Mott/.

  Sounds (`RSW_Pawn_Mott_*`) were already absorbed in the 2026-09-02 sound
  wave — confirmed present, wired, not re-done.
-->
<Defs>
<ThingDef ParentName="AnimalThingBase" ADogSaidBody="LegsTail">
    <defName>RSW_Mott</defName>
    <label>mott</label>
    <description>Motts were medium sized, semi-aquatic herbivores native to the swamps of Naboo. They ate a wide variety of vegetation and were a primary source of food for most swamp predators. Fortunately, motts had a high reproduction rate.</description>
    <statBases>
      <MoveSpeed>3.9</MoveSpeed>
      <MarketValue>150</MarketValue>
      <ComfyTemperatureMin>-10</ComfyTemperatureMin>
      <ComfyTemperatureMax>50</ComfyTemperatureMax>
      <FilthRate>8</FilthRate>
      <Wildness>0.75</Wildness>
    </statBases>
    <tools>
      <li>
        <label>left claw</label>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>4</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
      </li>
      <li>
        <label>right claw</label>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>4</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup>
      </li>
      <li>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        <chanceFactor>0.7</chanceFactor>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>6</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <modExtensions>
      <li MayRequire="pathfinding.framework" Class="PathfindingFramework.MovementExtension">
        <movementDef>PF_Movement_Amphibious</movementDef>
      </li>
    </modExtensions>
    <race>
      <body>QuadrupedAnimalWithPaws</body>
      <herdAnimal>true</herdAnimal>
      <baseBodySize>0.75</baseBodySize>
      <baseHungerRate>0.225</baseHungerRate>
      <baseHealthScale>0.7</baseHealthScale>
      <foodType>VegetarianRoughAnimal</foodType>
      <leatherDef>Leather_Light</leatherDef>
      <specificMeatDef>RSW_Tender_Meat</specificMeatDef>
      <trainability>None</trainability>
      <nameGenerator>SWAnimalNamerMale</nameGenerator>
      <nameGeneratorFemale>SWAnimalNamerFemale</nameGeneratorFemale>
      <petness>0.08</petness>
      <roamMtbDays>1.5</roamMtbDays>
      <nuzzleMtbHours>48</nuzzleMtbHours>
      <lifeExpectancy>15</lifeExpectancy>
      <gestationPeriodDays>5</gestationPeriodDays>
      <waterSeeker>true</waterSeeker>
      <waterCellCost>1</waterCellCost>
      <litterSizeCurve>
        <points>
          <li>(2.0, 0)</li>
          <li>(3.5, 1)</li>
          <li>(4.5, 1)</li>
          <li>(5, 0)</li>
        </points>
      </litterSizeCurve>
      <wildBiomes>
        <AridShrubland>0.0</AridShrubland>
        <Desert>0.0</Desert>
        <ExtremeDesert>0.0</ExtremeDesert>
        <TropicalRainforest>0.4</TropicalRainforest>
        <TropicalSwamp>0.9</TropicalSwamp>
        <TemperateSwamp>0.9</TemperateSwamp>
        <TemperateForest>0.5</TemperateForest>
        <BorealForest>0.04</BorealForest>
        <Tundra>0.0</Tundra>
        <ColdBog>0.01</ColdBog>
        <IceSheet>0.0</IceSheet>
      </wildBiomes>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.2</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.3</minAge>
          <soundWounded>RSW_Pawn_Mott_Wounded</soundWounded>
          <soundDeath>RSW_Pawn_Mott_Death</soundDeath>
          <soundCall>RSW_Pawn_Mott_Call</soundCall>
          <soundAngry>RSW_Pawn_Mott_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
      <soundEating>Herbivore_Eat</soundEating>
    </race>
    <tradeTags>
      <li>AnimalUncommon</li>
    </tradeTags>
  </ThingDef>
