      <specificMeatDef>RSW_Tough_Meat</specificMeatDef>
      <herdAnimal>true</herdAnimal>
      <petness>0.20</petness>
      <roamMtbDays>2</roamMtbDays>
      <trainability>None</trainability>
      <manhunterOnTameFailChance>0.05</manhunterOnTameFailChance>
      <manhunterOnDamageChance>0.10</manhunterOnDamageChance>
      <nameGenerator>SWAnimalNamerMale</nameGenerator>
      <nameGeneratorFemale>SWAnimalNamerFemale</nameGeneratorFemale>
      <nameOnTameChance>1</nameOnTameChance>
      <nuzzleMtbHours>240</nuzzleMtbHours>
      <gestationPeriodDays>20</gestationPeriodDays>
      <lifeExpectancy>25</lifeExpectancy>
      <willNeverEat>
        <li MayRequire="Ludeon.RimWorld.Royalty">Plant_TreeAnima</li>
