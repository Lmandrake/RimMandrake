      <trainability>None</trainability>
      <manhunterOnTameFailChance>0.05</manhunterOnTameFailChance>
      <manhunterOnDamageChance>0.35</manhunterOnDamageChance>
      <nameGenerator>SWAnimalNamerMale</nameGenerator>
      <nameGeneratorFemale>SWAnimalNamerFemale</nameGeneratorFemale>
      <leatherDef>RSW_Leather_Bright</leatherDef>
      <specificMeatDef>RSW_Felinoid_Meat</specificMeatDef>
      <nuzzleMtbHours>60</nuzzleMtbHours>
      <specialTrainables>
