      <MoveSpeed>5.5</MoveSpeed>
      <MarketValue>75</MarketValue>
      <ComfyTemperatureMin>-25</ComfyTemperatureMin>
      <ComfyTemperatureMax>62.3</ComfyTemperatureMax>
      <Wildness>0.0</Wildness>
    </statBases>
