      <MoveSpeed>5.0</MoveSpeed>
      <MarketValue>700</MarketValue>
      <MeatAmount>350</MeatAmount>
      <ComfyTemperatureMin>-8</ComfyTemperatureMin>
      <FilthRate>10</FilthRate>
      <CaravanRidingSpeedFactor>1.5</CaravanRidingSpeedFactor>
