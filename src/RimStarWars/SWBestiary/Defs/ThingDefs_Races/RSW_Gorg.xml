<!--
  MLIE_FAUNA_ABSORPTION_1 Wave C — Gorg creature port (Pass 9).
  Ported from mlie.starwarsanimalcollection's `Gorg` ThingDef/PawnKindDef
  pair (Races_Animal_SW.xml, workshop folder 3497316713), renamed under the
  RSW_ tier prefix. Geometry/stats/comps copied verbatim.

  Body: the donor's custom `Gorg` BodyDef is, like RSW_Anooba/RSW_Borcatu/
  RSW_Cannok/RSW_Clodhopper/RSW_Eopie, entirely vanilla-part composition
  (Spine, Stomach, Heart, Lung x2, Kidney x2, Liver, Neck/Head/Skull/Brain/
  Eye x4/Nose/AnimalJaw, 4x Leg/Paw) — ported as RSW_Gorg with a defName
  rename only, no new body part needed (RSW_MlieWaveC_Bodies.xml).

  `leatherDef` stays vanilla Core `Leather_Light` — no port needed.
  `specificMeatDef` repoints to the already-ported RSW_Gorg_Meat
  (RSW_MlieWaveC_Resources.xml, Pass 7, Fanback — the same donor `Gorg_Meat`
  this species itself is named for). Its 2 eggs are newly ported
  (RSW_EggGorgFertilized/UnFertilized, texPath swresource/EggPod — already
  extracted, Pass 8/FrilledGorg, reused unchanged, no new art).

  `canCrossBreedWith` (donor: FrilledGorg, LongtailGorg) — FrilledGorg
  repoints to the already-ported RSW_FrilledGorg (Pass 8); LongtailGorg
  stays bare, not yet ported (remains later in this item's Wave C
  worklist).

  Art: extracted this pass via extract_bundle.py against the live Steam
  workshop bundle (workshop folder 3497316713) — 44 PNGs (base + A-E
  recolor variants, each with north/south/east + Swimming_north/south/east;
  juvenile Gorg_j variants with the same set; Dessicated), all confirmed
  non-zero and PIL-openable. texPaths otherwise unchanged text — art sits
  at Textures/swanimals/Gorg/.

  No `*ArtOverride` mod exists for this species (checked the full ~26-mod
  override-folder listing, not a remembered short list).

  Wired into the live cast this same pass: `AridShrubland` (0.3), `Desert`
  (0.4) — per cast_assignment.csv's current rows for this species
  (cross-checked against the worklist's own biome claim and found correct —
  no staleness this pass), repointed from the bare "Gorg" entries in
  cast_assignment.csv / both BiomeCast_Ashkarr.xml copies.
-->
<Defs>
<ThingDef ParentName="AnimalThingBase" ADogSaidBody="LegsTail">
    <defName>RSW_Gorg</defName>
    <label>gorg</label>
    <description>Gorgs, known as 'chubas' in Huttese, were small precocious amphibians that could be found on several planets. They were popularly favored as food by many humanoid species. Thus they became popular livestock on sparse worlds due to their high temperature tolerance, minimal food consumption and fast breeding.</description>
    <statBases>
      <MoveSpeed>2.9</MoveSpeed>
      <MarketValue>50</MarketValue>
      <LeatherAmount>0</LeatherAmount>
      <ComfyTemperatureMin>-5</ComfyTemperatureMin>
      <ComfyTemperatureMax>80</ComfyTemperatureMax>
      <FilthRate>4</FilthRate>
      <ToxicEnvironmentResistance MayRequire="Ludeon.RimWorld.Biotech">0.8</ToxicEnvironmentResistance>
      <Wildness>0</Wildness>
    </statBases>
    <tools>
      <li>
        <label>claws</label>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>2</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
      </li>
      <li>
        <label>claws</label>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>2</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup>
      </li>
      <li>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>3</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>1</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <comps>
      <li Class="CompProperties_EggLayer">
        <eggUnfertilizedDef>RSW_EggGorgUnFertilized</eggUnfertilizedDef>
        <eggFertilizedDef>RSW_EggGorgFertilized</eggFertilizedDef>
        <eggFertilizationCountMax>1</eggFertilizationCountMax>
        <eggLayIntervalDays>2</eggLayIntervalDays>
        <eggCountRange>1~3</eggCountRange>
      </li>
    </comps>
    <race>
      <body>RSW_Gorg</body>
      <baseHungerRate>0.10</baseHungerRate>
      <baseBodySize>0.3</baseBodySize>
      <baseHealthScale>0.35</baseHealthScale>
      <foodType>OmnivoreRoughAnimal, OvivoreAnimal, AnimalProduct</foodType>
      <trainability>None</trainability>
      <leatherDef>Leather_Light</leatherDef>
      <specificMeatDef>RSW_Gorg_Meat</specificMeatDef>
      <roamMtbDays>7</roamMtbDays>
      <lifeExpectancy>4</lifeExpectancy>
      <nameGenerator>SWAnimalNamerMale</nameGenerator>
      <nameGeneratorFemale>SWAnimalNamerFemale</nameGeneratorFemale>
      <waterSeeker>true</waterSeeker>
      <waterCellCost>1</waterCellCost>
      <canFishForFood>true</canFishForFood>
      <canCrossBreedWith>
        <li>RSW_FrilledGorg</li>
        <li>LongtailGorg</li>
      </canCrossBreedWith>
      <wildBiomes>
        <AridShrubland>1.0</AridShrubland>
