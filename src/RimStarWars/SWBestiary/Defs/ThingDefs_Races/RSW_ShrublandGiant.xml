      <li>
        <bodyGraphicData>
          <texPath>swanimals/Fambaa/Fambaa</texPath>
          <color>(168, 158, 128)</color>
          <drawSize>8.0</drawSize>
          <shadowData>
            <volume>(1, 0.8, 0.5)</volume>
            <offset>(0,0,0.0)</offset>
          </shadowData>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>swanimals/Fambaa/Fambaa_Dessicated</texPath>
          <drawSize>8.0</drawSize>
        </dessicatedBodyGraphicData>
      </li>
