    <label>thunderstep</label>
    <race>RSW_ShrublandGiant</race>
    <combatPower>380</combatPower>
    <ecoSystemWeight>0.12</ecoSystemWeight>
    <wildGroupSize>1~3</wildGroupSize>
    <lifeStages>
      <li>
        <label>thunderstep calf</label>
        <labelPlural>thunderstep calves</labelPlural>
        <bodyGraphicData>
          <texPath>swanimals/Fambaa/Fambaa_j</texPath>
          <color>(168, 158, 128)</color> <!-- warm dust-khaki, reskin over the shared Fambaa art - arid_shrubland.md §9 "walking hills with lit flanks", zero new PNGs -->
          <drawSize>2.0</drawSize>
          <shadowData>
            <volume>(0.4, 0.3, 0.3)</volume>
            <offset>(0,0,0.0)</offset>
          </shadowData>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>swanimals/Fambaa/Fambaa_j_Dessicated</texPath>
          <drawSize>2.0</drawSize>
        </dessicatedBodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>swanimals/Fambaa/Fambaa</texPath>
          <color>(168, 158, 128)</color>
          <drawSize>4.0</drawSize>
          <shadowData>
            <volume>(0.7, 0.6, 0.4)</volume>
            <offset>(0,0,0.0)</offset>
          </shadowData>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>swanimals/Fambaa/Fambaa_Dessicated</texPath>
