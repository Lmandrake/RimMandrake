    <ecoSystemWeight>0.12</ecoSystemWeight>
    <wildGroupSize>1~3</wildGroupSize>
    <lifeStages>
      <li>
        <label>giant calf</label>
        <labelPlural>giant calves</labelPlural>
        <bodyGraphicData>
          <texPath>swanimals/Fambaa/Fambaa_j</texPath>
          <color>(168, 158, 128)</color> <!-- warm dust-khaki, reskin over the shared Fambaa art - arid_shrubland.md §9 "walking hills with lit flanks", zero new PNGs -->
          <drawSize>2.0</drawSize>
          <shadowData>
            <volume>(0.4, 0.3, 0.3)</volume>
