<!--
  MLIE_FAUNA_ABSORPTION_1 Wave C — Iriaz creature port.
  Ported from mlie.starwarsanimalcollection's `Iriaz` ThingDef/PawnKindDef pair
  (Races_Animal_SW.xml, workshop folder 3497316713), renamed under the RSW_ tier
  prefix. Geometry/stats/comps copied verbatim. No custom body, no custom ability,
  no new resource needed: `body` stays the vanilla `QuadrupedAnimalWithHooves`,
  `leatherDef` stays vanilla `Leather_Lizard`, and `specificMeatDef` repoints to
  the already-ported `RSW_Reptomammal_Meat` (RSW_MlieWaveB_Resources.xml, same
  texPath the donor used). Sounds repoint to the already-absorbed sound wave
  (RSW_Pawn_Iriaz_*, mlie_sound_defname_map.json). texPaths are unchanged text —
  extracted art sits at Textures/swanimals/Iriaz/ (extract_bundle.py against the
  same AssetBundle the sound and Wave A/B passes already proved out).

  Wired into the live cast this same pass: AridShrubland at 1.0 (donor's own
  wildBiomes weight), repointed from the bare "Iriaz" entry in
  cast_assignment.csv / BiomeCast_Ashkarr.xml.
-->
<Defs>
<ThingDef ParentName="AnimalThingBase" ADogSaidBody="LegsTail">
    <defName>RSW_Iriaz</defName>
    <label>iriaz</label>
    <description>Iriaz were docile creatures from the grassland planet Dantooine. While not normally aggressive, they could attack if provoked. They were a prey of choice for local hunters (and natural predators alike) given that they were a relatively common creature; furthering their export to many planets.</description>
    <statBases>
      <MoveSpeed>4.0</MoveSpeed>
      <ComfyTemperatureMin>-10</ComfyTemperatureMin>
      <ComfyTemperatureMax>50</ComfyTemperatureMax>
      <MarketValue>150</MarketValue>
      <FilthRate>8</FilthRate>
      <Wildness>0.75</Wildness>
    </statBases>
    <tools>
      <li>
        <label>left hoof</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>6</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftLeg</linkedBodyPartsGroup>
      </li>
      <li>
        <label>right hoof</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>6</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>FrontRightLeg</linkedBodyPartsGroup>
      </li>
      <li>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>6</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        <chanceFactor>0.7</chanceFactor>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>8</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <race>
      <body>QuadrupedAnimalWithHooves</body>
      <herdAnimal>true</herdAnimal>
      <baseBodySize>0.7</baseBodySize>
      <baseHungerRate>0.20</baseHungerRate>
      <baseHealthScale>0.7</baseHealthScale>
      <foodType>VegetarianRoughAnimal</foodType>
      <leatherDef>Leather_Lizard</leatherDef>
      <specificMeatDef>RSW_Reptomammal_Meat</specificMeatDef>
      <trainability>None</trainability>
      <nameGenerator>SWAnimalNamerMale</nameGenerator>
      <nameGeneratorFemale>SWAnimalNamerFemale</nameGeneratorFemale>
      <roamMtbDays>1.5</roamMtbDays>
      <gestationPeriodDays>4</gestationPeriodDays>
      <lifeExpectancy>10</lifeExpectancy>
      <wildBiomes>
        <ExtremeDesert>0.01</ExtremeDesert>
        <TropicalRainforest>1.0</TropicalRainforest>
        <TropicalSwamp>0.0</TropicalSwamp>
        <TemperateSwamp>0.0</TemperateSwamp>
        <TemperateForest>0.8</TemperateForest>
        <BorealForest>0.04</BorealForest>
        <Tundra>0.01</Tundra>
        <ColdBog>0.0</ColdBog>
        <IceSheet>0.0</IceSheet>
      </wildBiomes>
      <litterSizeCurve>
        <points>
          <li>(0.5, 0)</li>
          <li>(1.5, 1)</li>
          <li>(2.0, 1.7)</li>
          <li>(2.5, 0.7)</li>
          <li>(3, 0)</li>
        </points>
      </litterSizeCurve>
      <lifeStageAges>
