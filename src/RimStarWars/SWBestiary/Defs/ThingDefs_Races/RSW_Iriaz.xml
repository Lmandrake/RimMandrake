          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.1</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.2</minAge>
          <soundWounded>RSW_Pawn_Iriaz_Wounded</soundWounded>
          <soundDeath>RSW_Pawn_Iriaz_Death</soundDeath>
          <soundCall>RSW_Pawn_Iriaz_Call</soundCall>
          <soundAngry>RSW_Pawn_Iriaz_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
