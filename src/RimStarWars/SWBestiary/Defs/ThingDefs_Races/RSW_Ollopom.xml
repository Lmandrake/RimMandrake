<!--
  MLIE_FAUNA_ABSORPTION_1 Wave C — Ollopom creature port (Pass 18), swapped
  in as this pass's third species after Mynock was dropped for a defName
  collision (see RSW_MlieWaveC_Bodies.xml's own header comment and
  mlie_wave_c_worklist.json's skipped_this_pass_2026-09-18_batch18).
  Ported from mlie.starwarsanimalcollection's `Ollopom` ThingDef/PawnKindDef
  pair (Races_Animal_SW.xml, workshop folder 3497316713), renamed under the
  RSW_ tier prefix. Geometry/stats/comps copied verbatim.

  Body: the donor's own custom `Ollopom` BodyDef is, like Anooba/Borcatu,
  entirely vanilla-part composition (Body/Tail/Spine/Stomach/Heart/Lung x2/
  Kidney x2/Hump/Liver/Neck/Head/Skull/Brain/Eye x2/Ear x2/Nose/AnimalJaw,
  6x Leg/Paw for its hexapod stance) — no SW-prefixed part or group
  anywhere, defName rename only. Ported as RSW_Ollopom
  (RSW_MlieWaveC_Bodies.xml).

  Resources: `leatherDef` (`Leather_Light`) is vanilla Core, left bare.
  `specificMeatDef` (`Rodentia_Meat`) had never been ported — ported this
  pass as `RSW_Rodentia_Meat` (RSW_MlieWaveC_Resources.xml), texPath
  swresource/Meat_Rodentia (newly extracted this pass, 3 PNGs), no
  `ingestible` block in the donor (unlike Mott's Tender_Meat this same
  pass) so no new tasteThought needed. No egg comp (live birth via
  `gestationPeriodDays`/`litterSizeCurve`, confirmed directly off the
  donor's own `<race>` block). No new ability: the donor's own
  `specialTrainables` entry (`Forage`, Odyssey-gated) is a vanilla
  TrainableDef, not donor content — left bare, same "vanilla trainable"
  pattern as Lothcat/Massiff (Pass 17).

  🔑 Carries the donor's own `modExtensions` block gated
  `MayRequire="pathfinding.framework"` (`PathfindingFramework.MovementExtension`,
  `PF_Movement_Amphibious`) — kept verbatim, same established pattern as
  Mott (this same pass) and Igitz/Dianoga/Falumpaset/Fambaa/Dragonsnake/Nuna.

  No `canCrossBreedWith` in the donor. Grepped every already-ported
  `RSW_*.xml` in SWBestiary for a stray `<li>Ollopom</li>` — none found.

  🔴 **ArtOverride collision avoided, checked BEFORE extracting anything**:
  `OllopomArtOverride` (mandrake.rsw.ollopomartoverride) covers
  `Ollopom_{south,east,north}` across ALL life stages (one shared texPath)
  — the swimming-graphic variant and the dessicated-corpse texture stay on
  donor art per its own About.xml. Per the same same-path-collision
  precedent every prior ArtOverride pass documented, SWBestiary ships ONLY
  `Ollopom_Swimming_{south,east,north}` and `Ollopom_Dessicated` — the 3
  base facings are NOT extracted here, and the PawnKindDef's
  `bodyGraphicData` texPath below stays pointed at the donor's own
  `swanimals/Ollopom/Ollopom` path unmodified (same relative path
  OllopomArtOverride uses, same load-order-wins mechanism as every other
  rename in this item). 4 PNGs extracted this pass, all confirmed non-zero
  (256x256 RGBA) and PIL-openable before wiring in. Run via `python.exe` on
  the native `C:\...` bundle path, extracted flat (without keep-paths mode)
  to a Windows temp dir and copied into the repo tree over `/mnt/c`. Sits
  at Textures/swanimals/Ollopom/.

  Sounds: the donor's own `lifeStageAges` block uses vanilla Core
  `Pawn_Rodent_*` sounds (confirmed present in
  Data/Core/Defs/SoundDefs/Pawn_Animal_Misc_Vox.xml), NOT a custom Ollopom
  set — left bare, no sound port needed.
-->
<Defs>
<ThingDef ParentName="AnimalThingBase" ADogSaidBody="LegsTail">
    <defName>RSW_Ollopom</defName>
    <label>ollopom</label>
    <description>Ollopoms were squat, gentle herbivores native to the swamps of the planet Naboo. A species of six-legged aquatic rodent, they were often mistaken for water plants. These short, gentle, dense, green-furred rodents were camouflaged to blend in with the Pom Petals whose edges they fed upon. On their underside, they had gnawing teeth and three pairs of paddle-like claws. Their flukes were used as rudders.</description>
    <statBases>
      <MoveSpeed>3</MoveSpeed>
      <MarketValue>150</MarketValue>
      <ComfyTemperatureMin>-18</ComfyTemperatureMin>
      <ComfyTemperatureMax>50</ComfyTemperatureMax>
      <FilthRate>2</FilthRate>
      <Wildness>0.4</Wildness>
    </statBases>
    <tools>
      <li>
        <label>claws</label>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>6</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
      </li>
      <li>
        <label>claws</label>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>6</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup>
      </li>
      <li>
        <label>bite</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>8</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>5</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>12</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
    </tools>
    <modExtensions>
      <li MayRequire="pathfinding.framework" Class="PathfindingFramework.MovementExtension">
        <movementDef>PF_Movement_Amphibious</movementDef>
      </li>
    </modExtensions>
    <race>
      <body>RSW_Ollopom</body>
      <baseBodySize>0.6</baseBodySize>
      <baseHealthScale>0.6</baseHealthScale>
      <baseHungerRate>0.3</baseHungerRate>
      <herdAnimal>true</herdAnimal>
      <foodType>VegetarianRoughAnimal</foodType>
      <leatherDef>Leather_Light</leatherDef>
      <specificMeatDef>RSW_Rodentia_Meat</specificMeatDef>
      <trainability>Intermediate</trainability>
      <petness>0.01</petness>
      <nuzzleMtbHours>36</nuzzleMtbHours>
      <nameGenerator>SWAnimalNamerMale</nameGenerator>
      <nameGeneratorFemale>SWAnimalNamerFemale</nameGeneratorFemale>
      <lifeExpectancy>12</lifeExpectancy>
      <manhunterOnTameFailChance>0.0</manhunterOnTameFailChance>
      <waterSeeker>true</waterSeeker>
      <waterCellCost>1</waterCellCost>
      <gestationPeriodDays>5</gestationPeriodDays>
      <specialTrainables>
        <li MayRequire="Ludeon.RimWorld.Odyssey">Forage</li>
      </specialTrainables>
      <litterSizeCurve>
        <points>
          <li>(0.5, 0)</li>
          <li>(1, 1)</li>
          <li>(2.2, 1)</li>
          <li>(2.8, 0)</li>
        </points>
      </litterSizeCurve>
      <wildBiomes>
        <AridShrubland>0.0</AridShrubland>
        <Desert>0.0</Desert>
        <ExtremeDesert>0.0</ExtremeDesert>
        <TropicalRainforest>0.2</TropicalRainforest>
        <TropicalSwamp>0.8</TropicalSwamp>
        <TemperateSwamp>0.8</TemperateSwamp>
        <TemperateForest>0.2</TemperateForest>
        <BorealForest>0.0</BorealForest>
        <Tundra>0.0</Tundra>
        <ColdBog>0.6</ColdBog>
        <IceSheet>0.0</IceSheet>
      </wildBiomes>
      <lifeStageAges>
        <li>
          <def>AnimalBabyTiny</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.06</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.12</minAge>
          <soundWounded>Pawn_Rodent_Wounded</soundWounded>
          <soundDeath>Pawn_Rodent_Death</soundDeath>
          <soundCall>Pawn_Rodent_Call</soundCall>
          <soundAngry>Pawn_Rodent_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
      <soundEating>Reptile_Eat</soundEating>
    </race>
    <tradeTags>
      <li>AnimalUncommon</li>
    </tradeTags>
  </ThingDef>
  <PawnKindDef ParentName="AnimalKindBase">
    <defName>RSW_Ollopom</defName>
    <label>ollopom</label>
    <labelPlural>ollopoms</labelPlural>
    <race>RSW_Ollopom</race>
    <combatPower>50</combatPower>
    <ecoSystemWeight>0.3</ecoSystemWeight>
    <wildGroupSize>1~3</wildGroupSize>
    <moveSpeedFactorByTerrainTag>
      <li>
        <key>Water</key>
        <value>2.0</value>
      </li>
    </moveSpeedFactorByTerrainTag>
    <lifeStages>
      <li>
        <label>ollopom pup</label>
        <labelPlural>ollopom pups</labelPlural>
        <bodyGraphicData>
          <texPath>swanimals/Ollopom/Ollopom</texPath>
          <drawSize>0.75</drawSize>
        </bodyGraphicData>
        <swimmingGraphicData>
          <texPath>swanimals/Ollopom/Ollopom_Swimming</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>0.75</drawSize>
        </swimmingGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>swanimals/Ollopom/Ollopom_Dessicated</texPath>
          <drawSize>0.75</drawSize>
        </dessicatedBodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>swanimals/Ollopom/Ollopom</texPath>
          <drawSize>1.25</drawSize>
          <shadowData>
            <volume>(0.3, 0.3, 0.3)</volume>
            <offset>(0,0,0.0)</offset>
          </shadowData>
        </bodyGraphicData>
        <swimmingGraphicData>
          <texPath>swanimals/Ollopom/Ollopom_Swimming</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.25</drawSize>
        </swimmingGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>swanimals/Ollopom/Ollopom_Dessicated</texPath>
          <drawSize>1.25</drawSize>
        </dessicatedBodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>swanimals/Ollopom/Ollopom</texPath>
          <drawSize>1.75</drawSize>
          <shadowData>
            <volume>(0.4, 0.4, 0.4)</volume>
            <offset>(0,0,0.0)</offset>
          </shadowData>
        </bodyGraphicData>
        <swimmingGraphicData>
          <texPath>swanimals/Ollopom/Ollopom_Swimming</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.75</drawSize>
        </swimmingGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>swanimals/Ollopom/Ollopom_Dessicated</texPath>
          <drawSize>1.75</drawSize>
        </dessicatedBodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>
</Defs>
