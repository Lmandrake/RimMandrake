<!--
  MLIE_FAUNA_ABSORPTION_1 Wave C, Pass 24 — Woolamander creature port.
  Ported from mlie.starwarsanimalcollection's `Woolamander` ThingDef/
  PawnKindDef pair, renamed under the RSW_ tier prefix. Body (`Monkey`) is
  vanilla Core, left bare. `leatherDef` (`Leather_Bluefur`) is vanilla Core,
  left bare. `specificMeatDef` (`Anthropoid_Meat`) ALREADY EXISTS as
  `RSW_Anthropoid_Meat` (Pass 12, Gizka). No egg comp (live birth). The baby
  lifeStage's own vocal sounds stay vanilla `Pawn_Monkey_*` (donor's own
  choice, unchanged); the adult lifeStage's sounds already absorbed
  (`RSW_Pawn_Woolamander_*`).

  No `*ArtOverride` mod exists for Woolamander. 4 PNGs extracted this pass:
  `Woolamander_{south,east,north}` and `Woolamander_Dessicated`.
-->
<Defs>
<!-- ThingDef -->
<ThingDef ParentName="AnimalThingBase" ADogSaidBody="LegsTail">
    <defName>RSW_Woolamander</defName>
    <label>woolamander</label>
    <description>Woolamanders were curious social creatures that originated on the jungle moon of Yavin 4. They fed on fruit and other vegetation that would ferment in their pot-bellies. Colouful primate often made for exotic pets and these sociable animals were spread to multiple worlds where upon escaping wild populations soon established themselves.</description>
    <statBases>
      <MoveSpeed>4.0</MoveSpeed>
      <MarketValue>200</MarketValue>
      <ComfyTemperatureMin>-15</ComfyTemperatureMin>
      <ComfyTemperatureMax>70</ComfyTemperatureMax>
      <Wildness>0.30</Wildness>
    </statBases>
    <tools>
      <li>
        <label>left fist</label>
        <capacities>
          <li>Blunt</li>
          <li>Scratch</li>
        </capacities>
        <power>9</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
      </li>
      <li>
        <label>right fist</label>
        <capacities>
          <li>Blunt</li>
          <li>Scratch</li>
        </capacities>
        <power>9</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
      </li>
      <li>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>12</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        <chanceFactor>0.7</chanceFactor>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>6</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <race>
      <body>Monkey</body>
