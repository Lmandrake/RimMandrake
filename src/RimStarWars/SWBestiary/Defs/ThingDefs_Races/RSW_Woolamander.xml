          <def>AnimalBaby</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_Monkey_Wounded</soundWounded>
          <soundDeath>Pawn_Monkey_Death</soundDeath>
          <soundCall>Pawn_Monkey_Call</soundCall>
          <soundAngry>Pawn_Monkey_Angry</soundAngry>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.2</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.3</minAge>
          <soundWounded>Pawn_Woolamander_Wounded</soundWounded>
          <soundDeath>Pawn_Woolamander_Death</soundDeath>
          <soundCall>Pawn_Woolamander_Call</soundCall>
          <soundAngry>Pawn_Woolamander_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
