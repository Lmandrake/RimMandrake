      <foodType>VegetarianRoughAnimal</foodType>
      <leatherDef>Leather_Bluefur</leatherDef>
      <specificMeatDef>RSW_Anthropoid_Meat</specificMeatDef>
      <trainability>Advanced</trainability>
      <nameGenerator>SWAnimalNamerMale</nameGenerator>
      <nameGeneratorFemale>SWAnimalNamerFemale</nameGeneratorFemale>
      <petness>0.5</petness>
      <nuzzleMtbHours>48</nuzzleMtbHours>
      <manhunterOnTameFailChance>0.10</manhunterOnTameFailChance>
      <manhunterOnDamageChance>0.10</manhunterOnDamageChance>
      <lifeExpectancy>35</lifeExpectancy>
      <gestationPeriodDays>8</gestationPeriodDays>
      <litterSizeCurve>
        <points>
          <li>(0.5, 0)</li>
          <li>(1, 1)</li>
          <li>(2, 1)</li>
          <li>(3, 0)</li>
        </points>
      </litterSizeCurve>
      <wildBiomes>
        <AridShrubland>0.0</AridShrubland>
        <Desert>0.0</Desert>
        <ExtremeDesert>0.0</ExtremeDesert>
        <TropicalRainforest>0.8</TropicalRainforest>
        <TropicalSwamp>0.8</TropicalSwamp>
        <TemperateSwamp>0.6</TemperateSwamp>
        <TemperateForest>0.6</TemperateForest>
        <BorealForest>0.04</BorealForest>
        <Tundra>0.0</Tundra>
        <ColdBog>0.0</ColdBog>
