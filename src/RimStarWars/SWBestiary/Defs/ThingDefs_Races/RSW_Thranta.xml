<Defs>
  <!-- Ported by src/RimMandrake/Utils/donor_pack_port.py port (DONOR_DEFS_PORT_TO_OURS_1, batch W3e) from mlie.starwarsanimalcollection (MIT; workshop 3497316713, 1.6/Defs). Donor-only names renamed RSW_; values verbatim. A texPath under swanimals/ or swresource/ keeps the donor path; its PNGs are extracted donor art installed in SWBestiary/Textures through the art ledger (owner 2026-10-14: ports may re-use extracted donor art until we regenerate). Canon brief: design/RimStarWars/canon_references/(see tracker). Our own patches that targeted the donor defName were applied BEFORE the rename (so this is the creature the game showed): src/RimStarWars/SWBestiary/Patches/BeastNorm/BeastNorm_Law3.xml (14 ops), src/RimStarWars/SWBestiary/Patches/Silooth/Silooth_Warbeast.xml (9 ops), src/RimUtinni/UtinniPatches/Patches/AnimalBiomeDuplicates_Fix.xml (1 ops), src/RimUtinni/UtinniPatches/Patches/AnimalTolerances_Ashkarr.xml (6 ops), src/RimUtinni/UtinniPatches/Patches/BiomeCastEvictions_WildBiomes.xml (23 ops). Those patch ops still name the donor and go dead when it is retired. -->
  <ThingDef ParentName="AnimalThingBase" ADogSaidBody="LegsTail">
    <defName>RSW_Thranta</defName>
    <label>thranta</label>
    <description>Thrantas were a group of flying animals originally found on the planet Alderaan. While there were multiple species and breeds varying in size and functions, most thrantas served as air transport. Populations of wild thranta were established on numerous worlds (like Bespin) where the air pollution was low.</description>
    <statBases>
      <MoveSpeed>3.0</MoveSpeed>
      <MarketValue>1000</MarketValue>
      <ComfyTemperatureMin>-20</ComfyTemperatureMin>
      <ComfyTemperatureMax>60</ComfyTemperatureMax>
      <CaravanRidingSpeedFactor>2.0</CaravanRidingSpeedFactor>
      <ToxicEnvironmentResistance MayRequire="Ludeon.RimWorld.Biotech">-1.0</ToxicEnvironmentResistance>
      <Wildness>0.40</Wildness>
      <MaxFlightTime>120</MaxFlightTime>
      <FlightCooldown>30</FlightCooldown>
    </statBases>
    <tools>
      <li>
        <label>tail</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>12</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>RSW_SWTailAttackTool</linkedBodyPartsGroup>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>60.0</power>
        <cooldownTime>3.0</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <comps>
      <li Class="CompProperties_EggLayer">
        <eggUnfertilizedDef>RSW_EggThrantaUnFertilized</eggUnfertilizedDef>
        <eggFertilizedDef>RSW_EggThrantaFertilized</eggFertilizedDef>
        <eggFertilizationCountMax>1</eggFertilizationCountMax>
        <eggLayIntervalDays>15</eggLayIntervalDays>
        <eggProgressUnfertilizedMax>0.5</eggProgressUnfertilizedMax>
        <eggCountRange>1~2</eggCountRange>
      </li>
    </comps>
    <race>
      <body>RSW_Thranta</body>
      <baseBodySize>4.0</baseBodySize>
      <maxPreyBodySize>1.0</maxPreyBodySize>
      <baseHungerRate>1.0</baseHungerRate>
      <baseHealthScale>2.5</baseHealthScale>
      <foodType>OmnivoreAnimal, OvivoreAnimal, AnimalProduct</foodType>
      <leatherDef>RSW_Leather_Reptavian</leatherDef>
      <specificMeatDef>RSW_Reptavian_Meat</specificMeatDef>
      <packAnimal>true</packAnimal>
      <herdAnimal>true</herdAnimal>
      <nameGenerator>RSW_SWAnimalNamerMale</nameGenerator>
      <nameGeneratorFemale>RSW_SWAnimalNamerFemale</nameGeneratorFemale>
      <nameOnTameChance>1</nameOnTameChance>
      <manhunterOnTameFailChance>0.10</manhunterOnTameFailChance>
      <manhunterOnDamageChance>0.10</manhunterOnDamageChance>
      <petness>0.20</petness>
      <nuzzleMtbHours>60</nuzzleMtbHours>
      <lifeExpectancy>75</lifeExpectancy>
      <trainability>Intermediate</trainability>
      <flightStartChanceOnJobStart>0.05</flightStartChanceOnJobStart>
      <canFlyIntoMap>true</canFlyIntoMap>
      <canLeaveMapFlying>true</canLeaveMapFlying>
      <leaveMapOnFleeChance>0.4</leaveMapOnFleeChance>
      <specialTrainables>
        <li MayRequire="Ludeon.RimWorld.Odyssey">RSW_SW_SootheSong</li>
      </specialTrainables>
      <wildBiomes>
        <TropicalRainforest>0.01</TropicalRainforest>
        <TropicalSwamp>0.8</TropicalSwamp>
        <TemperateSwamp>0.8</TemperateSwamp>
        <TemperateForest>0.01</TemperateForest>
        <BorealForest>0.01</BorealForest>
        <Tundra>0.01</Tundra>
        <ColdBog>0.6</ColdBog>
        <IceSheet>0.0</IceSheet>
      </wildBiomes>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.3</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.6</minAge>
          <soundWounded>RSW_Pawn_Thranta_Wounded</soundWounded>
          <soundDeath>RSW_Pawn_Thranta_Death</soundDeath>
          <soundCall>RSW_Pawn_Thranta_Call</soundCall>
          <soundAngry>RSW_Pawn_Thranta_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
      <soundEating>Reptile_Eat</soundEating>
    </race>
    <tradeTags>
      <li>AnimalExotic</li>
    </tradeTags>
  </ThingDef>
