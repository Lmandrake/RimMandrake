<?xml version="1.0" encoding="utf-8"?>
<!--
  MLIE_FAUNA_ABSORPTION_1 — Wave A creature port.
  RSW_BlueMilk's tasteThought, ported verbatim from
  mlie.starwarsanimalcollection (Thoughts_Memory_SpecialCuisine.xml).

  Wave C addition: RSW_AteMudhornEgg, the tasteThought RSW_Mudhorn's two eggs
  (RSW_MlieWaveC_Resources.xml) point at — same donor file, same mechanism,
  kept in this file rather than a new one since it is the same SpecialCuisine
  thought family.

  Wave C addition #2: RSW_SoothingSong, the RecoveryThought RSW_SW_SootheSong's
  HediffDef (RSW_MlieWaveC_Abilities.xml, Beldon's ability) points at — same
  donor file (Thoughts_Memory_SpecialCuisine.xml), same mechanism.

  Wave C addition #3 (Pass 12, 2026-09-18): RSW_AteHawkbatEgg, the
  tasteThought RSW_Hawkbat's two eggs (RSW_MlieWaveC_Resources.xml) point
  at — same donor file, same mechanism.

  Wave C addition #4 (Pass 13, 2026-09-18): RSW_Webbed, the RecoveryThought
  RSW_SW_Webbed's HediffDef (RSW_MlieWaveC_Abilities.xml, Kinrath's
  SW_WebShot ability) points at — same donor file, same mechanism, but a
  plain -3 mood debuff (getting webbed is unpleasant), not a taste thought
  like every other entry here.

  Wave C addition #5 (Pass 18, 2026-09-18): RSW_AteTenderMeat, the
  tasteThought RSW_Tender_Meat (Mott's specificMeatDef,
  RSW_MlieWaveC_Resources.xml) points at — same donor file, same mechanism.
-->
<Defs>
  <ThoughtDef>
    <defName>RSW_DrankBlueMilk</defName>
    <durationDays>1</durationDays>
    <stages>
      <li>
        <label>drank blue milk</label>
        <description>Ah, can't argue with a bit of blue milk...</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RSW_AteMudhornEgg</defName>
    <durationDays>1</durationDays>
    <stages>
      <li>
        <label>ate mudhorn egg</label>
        <description>Utini!</description>
        <baseMoodEffect>12</baseMoodEffect>
      </li>
    </stages>
    <replaceThoughts>
      <li>AteRawFood</li>
    </replaceThoughts>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RSW_SoothingSong</defName>
    <durationDays>1</durationDays>
    <stages>
      <li>
        <label>soothing song</label>
        <description>That creature made such a calm and soothing sound, it almost felt like I was dreaming it.</description>
        <baseMoodEffect>12</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RSW_AteHawkbatEgg</defName>
    <durationDays>1</durationDays>
    <stages>
      <li>
        <label>ate hawkbat egg</label>
        <description>That Hawkbat egg was astonishing. Truly a dish fit for an Emperor.</description>
        <baseMoodEffect>12</baseMoodEffect>
      </li>
    </stages>
    <replaceThoughts>
      <li>AteRawFood</li>
    </replaceThoughts>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RSW_Webbed</defName>
    <durationDays>1</durationDays>
    <stages>
      <li>
        <label>webbed</label>
        <description>Ah! It's sticky! What is it?</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RSW_AteTenderMeat</defName>
    <durationDays>1</durationDays>
    <stages>
      <li>
        <label>ate tender meat</label>
        <description>That meat was very tender and fatty...yum!</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
</Defs>
