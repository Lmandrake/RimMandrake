  <ThingDef ParentName="EggUnfertBase">
    <defName>RSW_EggKaaduUnFertilized</defName>
    <label>kaadu egg (unfert.)</label>
    <description>An unfertilized kaadu egg. It can be eaten raw, but it's much better cooked.</description>
    <graphicData>
      <texPath>swresource/EggSpeckled</texPath>
      <color>(125,100,150)</color>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>0.5</drawSize>
    </graphicData>
    <statBases>
      <Nutrition>0.5</Nutrition>
      <MarketValue>25.0</MarketValue>
    </statBases>
  </ThingDef>
  <ThingDef ParentName="EggFertBase">
    <defName>RSW_EggKaaduFertilized</defName>
    <label>kaadu egg (fert.)</label>
    <description>A fertilized kaadu egg. If all goes well, it should hatch into a baby kaadu. It can be eaten raw, but it's much better cooked.</description>
    <graphicData>
      <texPath>swresource/EggSpeckled</texPath>
      <color>(125,100,150)</color>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>0.5</drawSize>
    </graphicData>
    <statBases>
      <Nutrition>0.5</Nutrition>
      <MarketValue>25.0</MarketValue>
    </statBases>
    <comps>
      <li Class="CompProperties_Hatcher">
        <hatcherDaystoHatch>10</hatcherDaystoHatch>
        <hatcherPawn>RSW_Kaadu</hatcherPawn>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="EggUnfertBase">
