  <AbilityDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>RSW_SW_Spit</defName>
    <label>spit</label>
    <description>Make the creature launch a glob of icky spit, stunning a target. Disgusting.</description>
    <iconPath>UI/Abilities/Ability_AnimalSpit</iconPath>
    <cooldownTicksRange>2500</cooldownTicksRange>
    <displayOrder>200</displayOrder>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <warmupStartSound>RSW_Ability_Spit_Warmup</warmupStartSound>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>8.9</range>
      <warmupTime>0.5</warmupTime>
      <requireLineOfSight>true</requireLineOfSight>
      <soundCast>RSW_Ability_Spit</soundCast>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetLocations>false</canTargetLocations>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetHumans>true</canTargetHumans>
        <canTargetEntities>true</canTargetEntities>
        <canTargetSubhumans>False</canTargetSubhumans>
        <canTargetMechs>true</canTargetMechs>
        <canTargetSelf>false</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityRequiresTrainable">
        <trainableDef>RSW_SW_Spit</trainableDef>
        <aiCanCastWithoutTrainable>true</aiCanCastWithoutTrainable>
      </li>
      <li Class="CompProperties_AbilityGiveHediff">
        <compClass>CompAbilityEffect_GiveHediff</compClass>
        <hediffDef>RSW_SW_Spat</hediffDef>
        <replaceExisting>true</replaceExisting>
      </li>
      <li Class="CompProperties_AbilityLaunchProjectile">
        <projectileDef>RSW_SW_Spitprojectile</projectileDef>
      </li>
    </comps>
  </AbilityDef>
  <TrainableDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>RSW_SW_Spit</defName>
    <label>spit</label>
    <description>Command the creature to spit a glob of saliva at a target.</description>
    <listPriority>0</listPriority>
    <difficulty>200</difficulty>
    <steps>1</steps>
    <specialTrainable>true</specialTrainable>
    <enablesAbility>RSW_SW_Spit</enablesAbility>
  </TrainableDef>
  <ThingDef ParentName="LeatherBase">
    <defName>RSW_Leather_Vapaad</defName>
    <label>vapaad chitin</label>
    <description>The shell of a Vapaad. It is exceptionally resistant to high temperature and provides decent protection.</description>
    <graphicData>
      <texPath>swresource/Leather_Chitin</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(50,75,80)</color>
    </graphicData>
    <statBases>
      <MarketValue>4.0</MarketValue>
      <StuffPower_Armor_Sharp>1.6</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Blunt>1.6</StuffPower_Armor_Blunt>
      <StuffPower_Insulation_Heat>50</StuffPower_Insulation_Heat>
    </statBases>
    <stuffProps>
      <color>(50,75,80)</color>
      <commonality>0.025</commonality>
      <statFactors>
        <MaxHitPoints>1.5</MaxHitPoints>
      </statFactors>
    </stuffProps>
  </ThingDef>
  <HediffDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>RSW_SW_Spat</defName>
    <label>spat on</label>
    <description>This person has been spat on by a creature.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>2500</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="HediffCompProperties_RecoveryThought">
        <thought>RSW_SpatOn</thought>
      </li>
    </comps>
  </HediffDef>
  <ThingDef ParentName="BaseBullet">
    <defName>RSW_SW_Spitprojectile</defName>
    <label>spit</label>
    <graphicData>
      <texPath>UI/Abilities/Spit</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Stun</damageDef>
      <damageAmountBase>1</damageAmountBase>
      <armorPenetrationBase>0.1</armorPenetrationBase>
      <stoppingPower>0.1</stoppingPower>
      <speed>55</speed>
      <filth>Filth_Slime</filth>
      <filthCount>1</filthCount>
      <filthChance>0.25</filthChance>
    </projectile>
  </ThingDef>
  <ThoughtDef>
    <defName>RSW_SpatOn</defName>
    <durationDays>1</durationDays>
    <stages>
      <li>
        <label>spat on</label>
        <description>Schutta! That disgusting beast just spat on me!</description>
        <baseMoodEffect>-6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
</Defs>
