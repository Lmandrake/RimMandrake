<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Ported by src/RimMandrake/Utils/donor_pack_port.py port (DONOR_DEFS_PORT_TO_OURS_1, batch W4a) from mlie.starwarsanimalcollection (MIT; workshop 3497316713, 1.6/Defs). Donor-only names renamed RSW_; values verbatim. A texPath under swanimals/ or swresource/ keeps the donor path; its PNGs are extracted donor art installed in SWBestiary/Textures through the art ledger (owner 2026-10-14: ports may re-use extracted donor art until we regenerate). Support defs reached from the batch's species. -->
  <AbilityDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>RSW_SW_ForcePush</defName>
    <label>force push blast</label>
    <description>Use the creatures innate force connection to send a blast of force energy, damaging and stunning a target.</description>
    <iconPath>UI/Abilities/Ability_AnimalForcePush</iconPath>
    <cooldownTicksRange>20000</cooldownTicksRange>
    <displayOrder>200</displayOrder>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <warmupStartSound>AcidSpray_Warmup</warmupStartSound>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>8.9</range>
      <warmupTime>0.5</warmupTime>
      <soundCast>RSW_Ability_Force</soundCast>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetLocations>false</canTargetLocations>
        <canTargetAnimals>true</canTargetAnimals>
        <canTargetBuildings>true</canTargetBuildings>
        <canTargetHumans>true</canTargetHumans>
        <canTargetEntities>true</canTargetEntities>
        <canTargetSubhumans>False</canTargetSubhumans>
        <canTargetMechs>true</canTargetMechs>
        <canTargetSelf>false</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityRequiresTrainable">
        <trainableDef>RSW_SW_ForcePush</trainableDef>
        <aiCanCastWithoutTrainable>true</aiCanCastWithoutTrainable>
      </li>
      <li Class="CompProperties_AbilityLaunchProjectile">
        <projectileDef>RSW_SW_ForcePushprojectile</projectileDef>
      </li>
    </comps>
  </AbilityDef>
  <TrainableDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>RSW_SW_ForcePush</defName>
    <label>force push</label>
    <description>Command the creature to shoot a force energy blast at a target.</description>
    <listPriority>0</listPriority>
    <difficulty>200</difficulty>
    <steps>2</steps>
    <specialTrainable>true</specialTrainable>
    <enablesAbility>RSW_SW_ForcePush</enablesAbility>
  </TrainableDef>
  <ThoughtDef>
    <defName>RSW_AteToughMeat</defName>
    <durationDays>1</durationDays>
    <stages>
      <li>
        <label>ate tough meat</label>
        <description>Ugh...That meat was too tough and chewy.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RSW_AteChakroot</defName>
    <durationDays>1</durationDays>
    <stages>
      <li>
        <label>ate chak-root</label>
        <description>What a flavour, there's no mistaking the tangy sweetness of chak-root.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RSW_AteBloddle</defName>
    <durationDays>1</durationDays>
    <stages>
      <li>
        <label>ate bloddle</label>
        <description>Ah, you can't beat the aroma of cooked bloddle.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RSW_AteAcklayClaw</defName>
    <durationDays>1</durationDays>
    <stages>
      <li>
        <label>ate acklay claw</label>
        <description>These claws are so tender and sweet, the buttery flavour lingers on the tongue.</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThingDef ParentName="RM_RawGlasmawRoot">
    <!-- PLANT_TIERS_RECONCILE_MOST_ARE_BAROQUE: reskin of RM_RawGlasmawRoot; only label, description, art (and taste thought text) differ. -->
    <defName>RSW_RawTookeTrapRoot</defName>
    <label>tooke-trap root</label>
    <description>Raw tooke-trap root. Can be used to make a shiro-trap symbiote or as emergency animal feed.</description>
    <graphicData>
      <texPath>swresource/PlantFoodRaw/TookeTrapRoot</texPath>
    </graphicData>
  </ThingDef>
