  <ThingDef ParentName="ResourceBase">
    <defName>RSW_WarWyrmSkull</defName>
    <label>war wyrm skull</label>
    <description>A war wyrm skull. This is a relic of a truly legendary hunt.</description>
    <graphicData>
      <texPath>swresource/Trophies/WarWyrmSkull</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
