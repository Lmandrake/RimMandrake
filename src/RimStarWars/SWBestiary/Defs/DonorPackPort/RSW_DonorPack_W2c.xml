  <AbilityDef MayRequire="Ludeon.RimWorld.Royalty">
    <defName>RSW_SW_ForceChaosSkip</defName>
    <label>force chaos skip</label>
    <description>This creature can access a Force dimension to teleport a target to a random position near where it started. Objects above a certain size cannot be teleported.</description>
    <iconPath>UI/Abilities/Ability_AnimalForceChaosSkip</iconPath>
    <cooldownTicksRange>20000</cooldownTicksRange>
    <displayOrder>300</displayOrder>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <statBases>
      <Ability_EffectRadius>0</Ability_EffectRadius>
    </statBases>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>0.5</warmupTime>
      <range>24.9</range>
      <soundCast>RSW_Ability_Force</soundCast>
      <targetParams>
        <canTargetSelf>True</canTargetSelf>
        <canTargetAnimals>True</canTargetAnimals>
        <canTargetPawns>true</canTargetPawns>
        <canTargetItems>True</canTargetItems>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityTeleport">
        <compClass>CompAbilityEffect_Teleport</compClass>
        <destination>RandomInRange</destination>
        <randomRange>6.9~24.9</randomRange>
        <clamorType>Ability</clamorType>
        <clamorRadius>10</clamorRadius>
        <destClamorType>Ability</destClamorType>
        <destClamorRadius>10</destClamorRadius>
        <stunTicks>70~120</stunTicks>
        <goodwillImpact>-15</goodwillImpact>
        <applyGoodwillImpactToLodgers>False</applyGoodwillImpactToLodgers>
      </li>
      <li Class="CompProperties_AbilityFleckOnTarget">
        <fleckDef>PsycastPsychicEffect</fleckDef>
      </li>
      <li Class="CompProperties_AbilityRequiresTrainable">
        <trainableDef>RSW_SW_ForceChaosSkip</trainableDef>
        <aiCanCastWithoutTrainable>false</aiCanCastWithoutTrainable>
      </li>
    </comps>
  </AbilityDef>
  <TrainableDef MayRequire="Ludeon.RimWorld.Royalty">
    <defName>RSW_SW_ForceChaosSkip</defName>
    <label>force chaos skip</label>
    <description>Command the creature to teleport an object via the another reality to a random location nearby.</description>
    <listPriority>0</listPriority>
    <difficulty>200</difficulty>
    <steps>2</steps>
    <specialTrainable>true</specialTrainable>
    <enablesAbility>RSW_SW_ForceChaosSkip</enablesAbility>
  </TrainableDef>
  <AbilityDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>RSW_SW_ForceInvisibility</defName>
    <label>force invisibility</label>
    <description>This creature can use the force to manipulate the visual centers of everyone nearby, rendering them unable to perceived for a short time.</description>
    <iconPath>UI/Abilities/Ability_AnimalForceInvisibility</iconPath>
    <cooldownTicksRange>60000</cooldownTicksRange>
    <displayOrder>300</displayOrder>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <targetRequired>false</targetRequired>
    <statBases>
    </statBases>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>0.5</warmupTime>
      <soundCast>RSW_Ability_Force</soundCast>
      <requireLineOfSight>false</requireLineOfSight>
      <nonInterruptingSelfCast>true</nonInterruptingSelfCast>
      <targetParams>
        <canTargetSelf>True</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityGiveHediff">
        <compClass>CompAbilityEffect_GiveHediff</compClass>
        <hediffDef>PsychicInvisibility</hediffDef>
        <onlyApplyToSelf>True</onlyApplyToSelf>
        <durationSecondsOverride>20~30</durationSecondsOverride>
      </li>
      <li Class="CompProperties_AbilityFleckOnTarget">
        <fleckDef>PsycastPsychicEffect</fleckDef>
      </li>
      <li Class="CompProperties_AbilityRequiresTrainable">
        <trainableDef>RSW_SW_ForceInvisibility</trainableDef>
        <aiCanCastWithoutTrainable>true</aiCanCastWithoutTrainable>
      </li>
    </comps>
  </AbilityDef>
  <TrainableDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>RSW_SW_ForceInvisibility</defName>
    <label>force invisibility</label>
    <description>Command the creature to harness their innate force connection turn themselves invisible for a short time.</description>
    <listPriority>0</listPriority>
    <difficulty>200</difficulty>
    <steps>2</steps>
    <specialTrainable>true</specialTrainable>
    <enablesAbility>RSW_SW_ForceInvisibility</enablesAbility>
  </TrainableDef>
  <ThoughtDef>
    <defName>RSW_DrankGreenMilk</defName>
    <durationDays>1</durationDays>
    <stages>
      <li>
        <label>drank green milk</label>
        <description>Sithspit! What karking thing made this?! It tastes like it's gone bad INSIDE the animal!</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
</Defs>
