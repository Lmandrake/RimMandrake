<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Ported by src/RimMandrake/Utils/donor_pack_port.py port (DONOR_DEFS_PORT_TO_OURS_1, batch W2c) from mlie.starwarsanimalcollection (MIT; workshop 3497316713, 1.6/Defs). Donor-only names renamed RSW_; values verbatim. A texPath under swanimals/ or swresource/ keeps the donor path; its PNGs are extracted donor art installed in SWBestiary/Textures through the art ledger (owner 2026-10-14: ports may re-use extracted donor art until we regenerate). Our own patches that targeted the donor defName were applied BEFORE the rename (so this is the creature the game showed): src/RimStarWars/SWBestiary/Patches/BeastNorm/BeastNorm_Law3.xml (20 ops), src/RimUtinni/UtinniPatches/Patches/AnimalTolerances_Ashkarr.xml (4 ops), src/RimUtinni/UtinniPatches/Patches/BiomeCastEvictions_WildBiomes.xml (17 ops). Those patch ops still name the donor and go dead when it is retired. Support defs reached from the batch's species. -->
  <ThingDef ParentName="EggUnfertBase">
    <defName>RSW_EggHarvesterBeetleUnFertilized</defName>
    <label>harvester beetle egg (unfert.)</label>
    <description>An unfertilized harvester beetle egg. It can be eaten raw, but it's much better cooked.</description>
    <graphicData>
      <texPath>swresource/EggBeetle</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(50,175,175)</color>
      <drawSize>1.0</drawSize>
    </graphicData>
    <statBases>
      <Nutrition>0.5</Nutrition>
      <MarketValue>50.0</MarketValue>
    </statBases>
  </ThingDef>
  <ThingDef ParentName="EggFertBase">
    <defName>RSW_EggHarvesterBeetleFertilized</defName>
    <label>harvester beetle egg (fert.)</label>
    <description>A fertilized harvester beetle egg. If all goes well, it should hatch into a baby harvester beetle. It can be eaten raw, but it's much better cooked.</description>
    <possessionCount>1</possessionCount>
    <graphicData>
      <texPath>swresource/EggBeetle</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(50,175,175)</color>
      <drawSize>1.0</drawSize>
    </graphicData>
    <statBases>
      <Nutrition>0.5</Nutrition>
      <MarketValue>50.0</MarketValue>
    </statBases>
    <comps>
      <li Class="CompProperties_Hatcher">
        <hatcherDaystoHatch>5</hatcherDaystoHatch>
        <hatcherPawn>RSW_HarvesterBeetle</hatcherPawn>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="OrganicProductBase">
    <defName>RSW_GreenMilk</defName>
    <label>green milk</label>
    <description>Green milk from a reek. The high tannin content makes this milk quite bitter, but it can be cooked to remove the taste.</description>
    <graphicData>
      <texPath>swresource/AnimalProduct/GreenMilk</texPath>
    </graphicData>
    <socialPropernessMatters>true</socialPropernessMatters>
    <statBases>
      <MarketValue>1.75</MarketValue>
      <Mass>0.045</Mass>
      <MaxHitPoints>60</MaxHitPoints>
      <Flammability>0.2</Flammability>
      <Nutrition>0.1</Nutrition>
      <FoodPoisonChanceFixedHuman>0.02</FoodPoisonChanceFixedHuman>
    </statBases>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>14</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <ingestible>
      <preferability>RawBad</preferability>
      <foodType>AnimalProduct, Fluid</foodType>
      <tasteThought>RSW_DrankGreenMilk</tasteThought>
    </ingestible>
    <thingCategories>
      <li>AnimalProductRaw</li>
    </thingCategories>
  </ThingDef>
