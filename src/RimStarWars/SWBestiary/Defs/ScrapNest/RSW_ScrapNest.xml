<?xml version="1.0" encoding="utf-8"?>
<!--
  SHRUBLAND_SCRAPNEST_BIRDS_1 — the scrap nest, and the hoarding mechanic's
  def half. The C# half is Source/BeastMechanics/CompScrapHoarder.cs,
  JobGiver_HoardScrap.cs and JobDriver_HoardScrap.cs, each of which carries
  its own reasoning; the bird is Defs/ThingDefs_Races/RSW_ScrapNestBird.xml.

  ══ WHY THIS SHAPE, AND WHAT VANILLA IT COPIES ═══════════════════════════
  The nest is vanilla's `Hive` pattern with the insects taken out, MEASURED
  from the shipped def (Core, ThingDef `Hive`): a BuildingNaturalBase that
  nobody builds, carrying a `CompProperties_Spawner` that trickles out one
  valuable item, plus `killedLeavings` that pay out when it is destroyed.
  That is exactly "a lootable structure an animal made", and it needed no new
  engine concept at all - only the HAULING half (a bird carrying loose scrap
  back to it) has no vanilla precedent and is therefore the only part written
  in C#.

  `surfaceType: Item` is the shelf/table field (MEASURED on Core `Shelf`)
  that makes items legal on the building's own cell, so hauled scrap sits ON
  the nest and reads as lining rather than as litter beside it.

  ⭐ FIRE. arid_shrubland.md §4 point 2: "A firewall can pay anyway: where it
  forces a venomvine thicket, it can reveal the scrap nests inside - treasure
  in the ashes." Flammability 1 and killedLeavings together ARE that
  sentence: burn the thicket, the nests burn with it, and the hoard is left
  lying on the ash. Nothing extra is needed to make it true.

  🔴 spawnForbidden is TRUE, deliberately. A wild nest's scrap must not be
  auto-hauled into the colony by a passing hauler the moment it appears -
  the whole fiction is that somebody goes and TAKES it, through venomvine,
  past the tunnel snake. The player unforbids what they have reached.

  ⚠️ PLACEHOLDER ART, and it is meant to be replaced. The three PNGs under
  Textures/Things/Building/Natural/ScrapNest/ are procedurally drawn by
  art/ScrapNest/gen_scrapnest_placeholder.py - a woven ring with bright
  flecks in the cup, not shipping-quality art. Real art is owed and is named
  here so it is found by looking rather than by playing. Same placeholder
  convention this mod already uses in
  Defs/DesertPort/RSW_DesertPortMechanics.xml.

  🔑 Why not just borrow Core's `Things/Building/Natural/Hive` sprite, which
  is what this def did first: it resolves fine in game, but validate_patch.py
  escalates it to a hard ERROR because SWBestiary ships its own
  `Textures/Things/` root, and once a mod claims that namespace the validator
  will not (and should not) distinguish a correct vanilla path from a typo.
  Three real PNGs remove the ambiguity instead of leaving a standing error
  that a later reader has to re-adjudicate.
-->
<Defs>

  <ThingDef ParentName="BuildingNaturalBase">
    <defName>RSW_ScrapNest</defName>
    <label>scrap nest</label>
    <description>A bird's nest woven deep into venomvine and lined with everything its builders found that caught the light - stripped wire, chips of lens-glass, flakes of hull plate, the odd bead of precious metal. Jawa children are told what one looks like before they are told much else. Getting to it is the hard part.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <altitudeLayer>Building</altitudeLayer>
    <!-- PLACEHOLDER art: procedural, art/ScrapNest/gen_scrapnest_placeholder.py. Real art owed. -->
    <graphicData>
      <texPath>Things/Building/Natural/ScrapNest</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <drawSize>1.1</drawSize>
      <color>(126, 110, 84)</color>
    </graphicData>
    <uiIconScale>0.7</uiIconScale>
    <drawerType>MapMeshOnly</drawerType>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.3</fillPercent>
    <!-- Items may rest on the nest's own cell — the Core Shelf field. -->
    <surfaceType>Item</surfaceType>
    <!-- Never generated by map gen and never buildable: birds make these. -->
    <scatterableOnMapGen>false</scatterableOnMapGen>
    <filthLeaving>Filth_RubbleBuilding</filthLeaving>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Flammability>1</Flammability>
      <Beauty>2</Beauty>
    </statBases>
    <building>
      <claimable>false</claimable>
      <isInert>true</isInert>
      <artificialForMeditationPurposes>false</artificialForMeditationPurposes>
    </building>
    <killedLeavings>
      <ComponentIndustrial>3</ComponentIndustrial>
      <Silver>20</Silver>
      <Gold>2</Gold>
      <Steel>10</Steel>
    </killedLeavings>
    <comps>
      <!--
        The nest restocks itself slowly whether or not a bird is alive to
        haul to it — so a nest found on an unvisited map already holds
        treasure, which is the whole point of seeking one out. Core Hive's
        insect-jelly spawner, retuned: one item per 1-2 days, capped.
      -->
      <li Class="CompProperties_Spawner">
        <thingToSpawn>ComponentIndustrial</thingToSpawn>
        <spawnCount>1</spawnCount>
        <spawnIntervalRange>60000~120000</spawnIntervalRange>
        <spawnMaxAdjacent>4</spawnMaxAdjacent>
        <spawnForbidden>true</spawnForbidden>
        <saveKeysPrefix>scrap</saveKeysPrefix>
      </li>
    </comps>
    <tickerType>Rare</tickerType>
  </ThingDef>

  <JobDef>
    <defName>RSW_HoardScrap</defName>
    <driverClass>RimMandrake.StarWars.SWBestiary.JobDriver_HoardScrap</driverClass>
    <reportString>carrying TargetA back to the nest.</reportString>
    <casualInterruptible>true</casualInterruptible>
  </JobDef>

  <!--
    Inserted at the vanilla Animal think tree's own Animal_PreMain modding
    hook, same route RSW_MetalEaterInsert uses and for the same reason: no
    thinkTreeMain override, so every later change to the vanilla tree is
    inherited. insertPriority is BELOW the metal eater's 100 — a ferroclaw
    that is also (hypothetically) a hoarder eats first.

    Animal_PreMain runs ahead of the ordinary satisfy-needs subtree, so
    JobGiver_HoardScrap gates itself on hunger, danger and rest rather than
    relying on tree position; a hungry or frightened bird never hoards.
  -->
  <ThinkTreeDef>
    <defName>RSW_ScrapHoarderInsert</defName>
    <insertTag>Animal_PreMain</insertTag>
    <insertPriority>50</insertPriority>
    <thinkRoot Class="ThinkNode_Priority">
      <subNodes>
        <li Class="RimMandrake.StarWars.SWBestiary.JobGiver_HoardScrap" />
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>

</Defs>
