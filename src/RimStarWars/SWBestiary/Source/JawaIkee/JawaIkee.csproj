<Project Sdk="Microsoft.NET.Sdk">
  <!--
    RimWorld 1.6 runs Unity/Mono against .NET Framework 4.7.2, so this targets net472.
    No Visual Studio on this machine; reference assemblies come from NuGet.

    Build from a clone (never the read-only D:\Luke\dev\RimMandrake mirror):
      python3 src/RimMandrake/Utils/winbuild.py src/RimStarWars/SWBestiary/Source/JawaIkee/JawaIkee.csproj   (from a clone; stages on D:\ClaudeWork\rimmandrake\build)
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>JawaIkee</AssemblyName>
    <RootNamespace>JawaIkee</RootNamespace>
    <Version>1.0.0</Version>
    <!-- MOD_OPTIONS_RETROFIT_1 fix: this project sits at SWBestiary/Source/JawaIkee/,
         two levels below the mod root's Assemblies/ (same shape as
         RimMandrakeLivestockRSW.csproj next door). ..\Assemblies\ silently built
         into a Source/Assemblies/ nobody deploys — found and fixed here; the
         checked-in JawaIkee.dll beside RimMandrakeLivestockRSW.dll at
         SWBestiary/Assemblies/ is the one RimWorld and deploy_custom_mods.py
         actually read. -->
    <OutputPath>..\..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <DebugType>none</DebugType>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(GameDir)</AssemblySearchPaths>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4518-beta" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\..\..\RimMandrake\_Shared\SettingsKit\SettingsKitCore.cs" Link="Shared\SettingsKitCore.cs" />
    <Compile Include="..\..\..\..\RimMandrake\_Shared\SettingsKit\SettingsKitDrawer.cs" Link="Shared\SettingsKitDrawer.cs" />
  </ItemGroup>
</Project>
