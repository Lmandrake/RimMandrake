<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PORTED_BEAST_MECHANICS_REBUILD_1 — owner, 2026-09-20: "Rebuild in our c#."

    The gameplay mechanics DESERT_FAMILY_PORT_EXECUTION_1 dropped when it
    ported the desert family off its donor frameworks (the khorrak's steel diet
    moved to CreatureBehaviors with RM_Khorrak, KHORRAK_STEEL_DIET_TIER_1):
      * RSW_Vozzik     plasma volley   (was VEF.AnimalBehaviours.CompInitialAbility)
      * RSW_Zhakka  chemfuel spew   (was CompInitialAbility + VFEInsectoids.CompAbilityFuelSpew)
    Each file's own header says what the donor did and where that was measured.

    Same net472 / NuGet-reference-assemblies shape as this mod's sibling
    Livestock project (../Livestock/RimMandrakeLivestockRSW.csproj).

    Build (dotnet is WINDOWS-NATIVE, cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\RimMandrake\src\RimStarWars\SWBestiary\Source\BeastMechanics\RimMandrakeBeastMechanicsRSW.csproj -c Release

    Output lands in ../../Assemblies/ — the mod root's Assemblies folder, beside
    JawaIkee.dll and RimMandrakeLivestockRSW.dll, which is where RimWorld looks.
    Verify a fresh build lands THERE before trusting this comment: the Livestock
    project was once found quietly building into a Source/Assemblies/ nobody
    deploys.

    0Harmony is compile-only: it is provided at runtime by brrainz.harmony,
    which is already a hard dependency of the whole load set. Nothing but our
    own DLL is ever copied next to the mod.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrakeBeastMechanicsRSW</AssemblyName>
    <RootNamespace>RimMandrake.StarWars.SWBestiary</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HarmonyDll)' == ''">
    <HarmonyDll>C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\2009463077\Current\Assemblies\0Harmony.dll</HarmonyDll>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Kernel\RSW_BeastKernel.cs" />
    <Compile Include="..\..\..\..\RimMandrake\_Shared\HarmonyResilience\PatchApplier.cs" Link="Shared\PatchApplier.cs" />
    <Compile Include="CompScrapHoarder.cs" />
    <Compile Include="JobGiver_HoardScrap.cs" />
    <Compile Include="JobDriver_HoardScrap.cs" />
    <Compile Include="ScrapThiefFlock.cs" />
    <Compile Include="CompInnateAbility.cs" />
    <Compile Include="CompAbilityEffect_FuelSpew.cs" />
    <Compile Include="RSW_BeastMechanicsDefOf.cs" />
    <Compile Include="RSW_BeastMechanicsSettings.cs" />
    <Compile Include="..\..\..\..\RimMandrake\_Shared\SettingsKit\SettingsKitCore.cs" Link="Shared\SettingsKitCore.cs" />
    <Compile Include="..\..\..\..\RimMandrake\_Shared\SettingsKit\SettingsKitDrawer.cs" Link="Shared\SettingsKitDrawer.cs" />
    <Compile Include="ToxinDependence.cs" />
    <Compile Include="RSW_BeastMechanicsProof.cs" />
    <Compile Include="RSW_TaozinBrineTank.cs" />
    <Compile Include="RSW_DragonsnakeAlbinoToggle.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- TAOZIN_BRINE_TANK_BUILD_GRUB_GOES_PALE: RM_MechanicGates.Register for the taozin nest switch. The shared
         assembly ships in mandrake.rm.biomes (Biomes/_Kits/EnvironmentalHazards), a hard modDependency of this mod. -->
    <Reference Include="RimMandrake.EnvironmentalHazards">
      <HintPath>..\..\..\..\RimMandrake\EnvironmentalHazards\Assemblies\RimMandrake.EnvironmentalHazards.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
