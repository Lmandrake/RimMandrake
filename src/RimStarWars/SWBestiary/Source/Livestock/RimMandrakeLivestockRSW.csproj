<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RimWorld 1.6 runs Unity/Mono against a .NET Framework 4.7.2 profile, so
    the mod DLL must target net472. Same shape as
    src/RimStarWars/WeatherSuite/Source/WeatherSuiteHook.csproj.

    Build (dotnet is WINDOWS-NATIVE, cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\Rimworld\src\RimStarWars\SWBestiary\Source\Livestock\RimMandrakeLivestockRSW.csproj -c Release

    Output lands in ../../Assemblies/ (this project sits at
    SWBestiary/Source/Livestock/, two levels below the mod root's own
    Assemblies/, which is where RimWorld looks). 2026-09-09: this path was
    found still reading "../Assemblies/" and the invocation comment still
    naming the pre-move src/RimStarWars/Livestock/ location - a leftover
    from the "Sprint wave A" fauna-to-SWBestiary move that silently built
    into a Source/Assemblies/ nobody deploys, never the real one. Fixed
    here; verify a fresh build lands beside JawaIkee.dll at
    SWBestiary/Assemblies/ before trusting this comment again.

    FORSAKEN_CRAGS_PREDATORS_BUILD_1's one C# hook: CompLightAversion,
    Skarnix's firelight-avoidance comp. See CompLightAversion.cs's own
    header for the mechanism and its vanilla precedent.

    LIVESTOCK_STARTER_TRIO_1 adds CompKilnBelly.cs: onnik's feed-cycle kiln
    mechanic (CompKilnBelly on the animal, CompKilnFeed on its clay feed).
    See that file's own header for the mechanism.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrakeLivestockRSW</AssemblyName>
    <RootNamespace>RimMandrake.StarWars.Livestock</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="CompLightAversion.cs" />
    <Compile Include="CompKilnBelly.cs" />
    <Compile Include="RSW_LivestockSettings.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
