<?xml version="1.0" encoding="utf-8"?>
<!--
  SALVAGE_WRECKAGE_EVERYWHERE_1 step 9 (design §4 Fall Line row "TIE-panel (RSW_)"; §5: canon hulls are
  IP, so they live in this RSW layer, Q11a). Children of mandrake.rm.wreckage's families (composed in
  mandrake.rm.biomes; MayRequire guards each def), Fresh weathering: these are what the wreck fall
  delivers, not field scatter. The Fall Line's list (RUT layer) names them through
  Patches/WreckList_FallLine.xml. Close-but-not-quite canon replicas (owner ruling 2026-10-03 (2)).
  Art: on the vanilla ShipChunk placeholder until wreck_freshtiepanelwreck_* / wreck_freshlandspeederwreck_* land.
  ALL NUMBERS PROVISIONAL (family + weathering rows).
  Shipped as a PATCH, not a Defs file (2026-10-07): the RM_WreckFamily_* parents live in
  mandrake.rm.biomes, which loads AFTER this mod, and XmlInheritance.GetBestParentFor only accepts a parent
  from a mod with loadOrder <= the child's. As a Defs file all four children got null thingClass, and that
  NREd ReadingPolicyDatabase in Game's constructor, so no new game could start. A patch-added node has no
  mod, so its parent resolves from any mod. The Conditional skips it when the Biomes parents are absent.
-->
<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[@Name="RM_WreckFamily_Hull"]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs</xpath>
      <value>
          <ThingDef ParentName="RM_WreckFamily_Hull" MayRequire="mandrake.rm.biomes">
            <defName>RSW_FreshTIEPanelWreck</defName>
            <label>fallen TIE wing panel</label>
            <description>A hexagonal solar wing panel torn off a TIE starfighter on the way down, its collector cells cracked, the strut stub still bolted to one edge. It came down recently; the scorch is fresh and nothing has been taken. Deconstruct it for valuable resources.</description>
            <modExtensions>
              <li Class="RimMandrake.Wreckage.RM_WreckWeathering">
                <weathering>RM_WreckWeathering_Fresh</weathering>
              </li>
            </modExtensions>
          </ThingDef>

          <ThingDef ParentName="RM_WreckFamily_Speeder" MayRequire="mandrake.rm.biomes">
            <defName>RSW_FreshLandspeederWreck</defName>
            <label>crashed landspeeder</label>
            <description>An open-cockpit landspeeder that lost its repulsors and ploughed into the ground nose first. One turbine is crumpled, the windscreen is gone, and the seat padding is still smoking. Deconstruct it for valuable resources.</description>
            <modExtensions>
              <li Class="RimMandrake.Wreckage.RM_WreckWeathering">
                <weathering>RM_WreckWeathering_Fresh</weathering>
              </li>
            </modExtensions>
          </ThingDef>
      </value>
    </match>
  </Operation>
</Patch>
