<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  SarlaccRing.xml   StructureInjectionsSW   TILE_STRUCTURE_DESIGNS_1
  ============================================================================
  Wires PROMISE #2 The Sarlacc's "responder polish" onto RSW_SarlaccLair
  (mandrake.rsw.swbestiary, RSW_DonorPack_Sarlacc.xml; ported off Star Wars
  Animal Collection's sw_SarlaccLair 2026-10-15) - same safety convention as WhisperSarlaccSign.xml: the
  PatchOperationAdd is wrapped in a PatchOperationConditional whose xpath
  is IDENTICAL to the inner operation's target, so an absent/renamed mod
  or mutator makes the whole <li> a silent no-op.

  RSW_SarlaccLair's own <extraGenSteps> already carries
  <li>RSW_GenStep_SarlaccPit</li>, and
  WhisperSarlaccSign.xml (this same mod, filed 2026-09-17) already appends
  a second <li>RSW_GenStep_WhisperSarlaccSign</li> alongside it. This
  Add appends a THIRD <li>, RSW_GenStep_SarlaccRing - the three coexist
  because every extraGenSteps entry is sorted and run independently by
  its own <order> (RSW_GenStep_SarlaccPit=950, RSW_GenStep_WhisperSarlaccSign=430,
  RSW_GenStep_SarlaccRing=960 - see GenStepDefs_SarlaccRing.xml's own
  comment for why 960 is load-bearing).
  ============================================================================
-->
<Patch>

  <!-- PROMISE #2 The Sarlacc -> RSW_SarlaccLair (mandrake.rsw.swbestiary). -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/TileMutatorDef[defName="RSW_SarlaccLair"]/extraGenSteps</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/TileMutatorDef[defName="RSW_SarlaccLair"]/extraGenSteps</xpath>
      <value>
        <li>RSW_GenStep_SarlaccRing</li>
      </value>
    </match>
  </Operation>

</Patch>
