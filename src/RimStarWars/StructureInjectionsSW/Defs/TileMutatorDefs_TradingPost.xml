<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- The Trading Outpost (tiny) - structure_procedural_spec.md section 8.4.
       Same extraGenSteps responder shape as every prior batch (RSW_MiningSite,
       RSW_RoadWarehouse, RUT_Homestead, ...): the two Inhabited steps are
       carried under MayRequire so a tile that also holds a WorldObject_Inhabited
       place gets its cast and goods inside the shop/back room (both steps
       no-op on a tile without one).

       The template's own road_dir param defaults to "S" and the exported
       bake was taken at that default, so this responder reads best on a
       tile whose road approaches from the south.

       NOT YET PLACED on any Ash'karr tile - same deferral as every prior
       batch. -->
  <TileMutatorDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>RSW_TradingPost</defName>
    <label>trading outpost</label>
    <description>A shop fronting the road - counter, shelving, stools, a safe if the trade is good - with a back room behind the shared wall: a bed, a desk with a ledger, a stove.</description>
    <extraGenSteps>
      <li>RSW_GenStep_TradingPost</li>
      <li MayRequire="mandrake.rm.inhabited">Inhabited_Cast</li>
      <li MayRequire="mandrake.rm.inhabited">RM_InhabitedStock</li>
    </extraGenSteps>
  </TileMutatorDef>

</Defs>
