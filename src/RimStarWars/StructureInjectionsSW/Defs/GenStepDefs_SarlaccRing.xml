<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- TILE_STRUCTURE_DESIGNS_1 PROMISE #2 The Sarlacc, RSW tier -
       "responder polish (warning totems ring the pit)" onto the EXISTING
       RSW_Sarlacc/RSW_SarlaccLair pair (SWBestiary; ported off Star Wars
       Animal Collection 2026-10-15). Declared gap-design since
       2026-08-31, re-diagnosed 2026-09-18 as a confirmed ENGINE gap
       (GenStep_RimplacePlan had no way to place a plan relative to
       wherever RSW_GenStep_SarlaccPit's own GenStep_ScatterThings randomly lands
       its Thing at mapgen time) - closed this pass with a third placement
       mode, anchorThingDef (RimMandrake/StructureInjections/Source/
       GenStep_RimplacePlan.cs), which finds an already-spawned Thing of
       the named def on the map and centers the plan on ITS OccupiedRect
       center instead of the map's.

       order=960 is load-bearing, not cosmetic: RSW_GenStep_SarlaccPit
       (SWBestiary RSW_DonorPack_Sarlacc.xml) has order=950, and
       MapGenerator.cs sorts every extraGenSteps entry (this def included,
       once the Patch below adds it to RSW_SarlaccLair's own list) by
       order before running any of them - this MUST run strictly after
       950 or anchorThingDef would find nothing yet spawned. -->

  <GenStepDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>RSW_GenStep_SarlaccRing</defName>
    <genStep Class="RimMandrake.StructureInjections.GenStep_RimplacePlan">
      <planFile>Templates/sarlacc_ring.txt</planFile>
      <centerOnMap>false</centerOnMap>
      <anchorThingDef>RSW_SarlaccPit</anchorThingDef>
      <!-- SARLACC_PIT_WIDEN_THE_BIG_ONES: the ring rings the moderate 9x6 pit only (its 15x12 clear would cut into the
           great 15x10 or colossal 25x17 pit). A map that rolled a bigger pit has no RSW_SarlaccPit: skip quietly. -->
      <anchorOptional>true</anchorOptional>
    </genStep>
    <order>960</order>
  </GenStepDef>

</Defs>
