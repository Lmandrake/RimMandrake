<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- TILE_STRUCTURE_DESIGNS_1 whisper subsystem - RimStarWars tier's
       first whisper row. WHISPER #22 The Sarlacc Sign (RSW, sarlacc-
       adjacent), same GenStep_RandomSelector mechanism
       GenStepDefs_Whisper_Batch1.xml (RimUtinni tier) established
       2026-09-12: no new C# for the roll itself, one option this pass
       (declared "fires every time sw_SarlaccLair generates, not RARE" -
       same limitation every single-option whisper selector in this
       program carries so far).

       Anchor: sw_SarlaccLair (Mlie.StarWarsAnimalCollection, requires
       Ludeon.RimWorld.Odyssey per its own def) - confirmed real via a
       validate_patch.py PatchOperationConditional probe against the live
       632-active-mod set, 1 match in SW_Buildings_Natural.xml. -->

  <GenStepDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>RSW_GenStep_WhisperSarlaccSign</defName>
    <genStep Class="GenStep_RandomSelector">
      <options>
        <li>
          <weight>1</weight>
          <genStep Class="RimMandrake.StructureInjections.GenStep_RimplacePlan">
            <planFile>Templates/sarlacc_sign.txt</planFile>
            <centerOnMap>true</centerOnMap>
          </genStep>
        </li>
      </options>
    </genStep>
    <order>430</order>
  </GenStepDef>

</Defs>
