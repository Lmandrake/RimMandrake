<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- GRAFFITI_PUNK_IDEOLIGION_SCOPE_1: the Star Wars variant of
       RM_Graffiti_Stencil_Crown, per the owner's 2026-09-24 ruling ("ship
       the crown as-is; also add an Aurebesh/Imperial-cog RSW-tier variant
       alongside it"). Pure content: ParentName from the RM tier's own
       abstract def, no new C#. -->
  <!-- DIRTY_CODE_REVIEW_STANDING_LOOP_1 wave 76: this def was authored
       alongside Crown's wave-1 (ungated) shape and never picked up wave 2's
       requiresHostileToFactionDef=Empire gate that ThingDefs_Graffiti.xml
       added to RM_Graffiti_Stencil_Crown the same day - this About.xml's own
       description calls it "the same anti-authority defiance mark ... in
       the setting's own alphabet and insignia instead of the generic
       crown", and the mark's own description text below says the same
       ("defiance in the occupier's own alphabet"), so an Imperial-aligned
       pawn painting it (ungated) contradicted the "hostile social act"
       premise both sibling marks share. Added the same gate here so the
       two stay in lockstep; the field is null-safe/opens-on-no-match per
       GraffitiPool.HostilityGateAllows, so this is a no-op on any mod list
       without Royalty. -->
  <ThingDef ParentName="RM_BaseGraffiti">
    <defName>RSW_Graffiti_Stencil_ImperialCog</defName>
    <label>crossed-out cog stencil</label>
    <description>A crisp stencilled Imperial cog, struck through, with an asemic Aurebesh-styled tag beneath it - defiance in the occupier's own alphabet. It does not fade.</description>
    <graphicData>
      <graphicClass>Graphic_Random</graphicClass>
      <texPath>Things/Filth/Art/RSW_Graffiti_Stencil_ImperialCog</texPath>
      <linkType>CornerFiller</linkType>
      <linkFlags>
        <li>Wall</li>
      </linkFlags>
    </graphicData>
    <statBases>
      <Beauty>-5</Beauty>
      <Cleanliness>-3</Cleanliness>
    </statBases>
    <filth>
      <rainWashes>false</rainWashes>
    </filth>
    <modExtensions>
      <li Class="RimMandrake.Graffiti.ModExtension_Graffiti">
        <category>Taunt</category>
        <form>Stencil</form>
        <poolWeight>1</poolWeight>
        <designatorEligible>true</designatorEligible>
        <raidExitEligible>true</raidExitEligible>
        <requiresHostileToFactionDef>Empire</requiresHostileToFactionDef>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
