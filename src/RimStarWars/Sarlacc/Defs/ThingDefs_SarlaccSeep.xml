<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    RSW_DeepDesertSeep — an invisible map marker a swimmer's rooting comp scans
    for (CompSarlaccSwimmer, "it finds a seep" trigger, draft §2.1). Nothing
    places these on a live map yet — that is deep-desert mapgen-scatter work,
    owed alongside the world-tile placement in
    infrastructure/state/items/SARLACC_HABITAT_BUILD_1.md. Spawnable today via
    dev mode / the bridge for testing the rooting mechanism itself.
  -->

  <ThingDef>
    <defName>RSW_DeepDesertSeep</defName>
    <label>buried seep</label>
    <description>A trace of moisture under the sand — a brine seep, a fossil lens, a buried root. Invisible to the eye; a sarlacc swimmer can find one and root here.</description>
    <thingClass>Thing</thingClass>
    <category>Building</category>
    <altitudeLayer>Item</altitudeLayer>
    <passability>Standable</passability>
    <selectable>false</selectable>
    <destroyable>true</destroyable>
    <useHitPoints>false</useHitPoints>
    <drawerType>None</drawerType>
    <size>(1,1)</size>
    <tickerType>Never</tickerType>
    <staticSunShadowHeight>0</staticSunShadowHeight>
    <!-- thingClass Thing with category Building: ThingDef.ConfigErrors
         (ThingDef.cs:1687) rejects a deconstructible Building-category def
         whose class is not a Building (load 13, LOAD13_CONFIGERRORS_TRIAGE_1).
         An invisible marker is never deconstructed anyway. -->
    <building>
      <deconstructible>false</deconstructible>
    </building>
  </ThingDef>

</Defs>
