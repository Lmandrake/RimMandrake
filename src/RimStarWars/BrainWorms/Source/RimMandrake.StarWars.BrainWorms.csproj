<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RimWorld 1.6 runs Unity/Mono against a .NET Framework 4.7.2 profile, so the mod
    DLL must target net472. There is no Visual Studio or targeting pack on this
    machine, so Microsoft.NETFramework.ReferenceAssemblies supplies the reference
    assemblies from NuGet instead. Same shape as
    src/RimUtinni/RestrainingBolts/Source/RimMandrake.Utinni.RestrainingBolts.csproj.

    NO HARMONY REFERENCE, on purpose. Everything here is discovered by RimWorld's
    own def machinery - comp classes named from HediffDef/ThingDef comps, a
    stateClass on a MentalStateDef, a ThinkNode subclass in a ThinkTreeDef that
    rides vanilla's Humanlike_PostMentalState insertTag, a workerClass on an
    IncidentDef, a thingClass on a projectile. There is no patch to collide with.

    Build (the dotnet is WINDOWS-NATIVE and cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\Rimworld\src\RimStarWars\BrainWorms\Source\RimMandrake.StarWars.BrainWorms.csproj -c Release

    Output lands in ../Assemblies/, which is where RimWorld looks.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrake.StarWars.BrainWorms</AssemblyName>
    <RootNamespace>RimMandrake.StarWars.BrainWorms</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <!-- Nothing but our own DLL should ever be copied next to the mod. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="BrainWormsDefOf.cs" />
    <Compile Include="BrainWormUtility.cs" />
    <Compile Include="CompRSWColdKill.cs" />
    <Compile Include="CompRSWWormBurrow.cs" />
    <Compile Include="HediffComp_BrainWormProgress.cs" />
    <Compile Include="HediffComp_BrainWormPuppeteer.cs" />
    <Compile Include="HediffComp_BrainWormWhispers.cs" />
    <Compile Include="IncidentWorker_BrainWormCargo.cs" />
    <Compile Include="JobGiver_BrainWormPuppet.cs" />
    <Compile Include="MentalState_BrainWormPuppet.cs" />
    <Compile Include="Projectile_BrainWormEgg.cs" />
    <Compile Include="RSW_BrainWormsSettings.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
