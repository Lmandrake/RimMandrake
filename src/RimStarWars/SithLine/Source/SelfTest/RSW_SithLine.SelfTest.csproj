<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SithLine offline selftest. Plain net8.0, zero RimWorld/Unity references: ../RSW_SithLineKernel.cs is the PRODUCTION
    file the mod compiles, pulled in directly. If a `using Verse;` ever lands in it, this build breaks.
    Run: python3 src/RimStarWars/SithLine/selftest_sithline.py
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RSW_SithLine.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.StarWars.SithLine.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\RSW_SithLineKernel.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
