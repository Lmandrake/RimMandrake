<?xml version="1.0" encoding="utf-8"?>
<!--
  RSW_TrophyCraft_WyyyschokkFangDrop       mandrake.rsw.trophycraft
  WYYYSCHOKK_FANG_PENDANT_1. The wyyyschokk is RM_Ollathrix (owner ruling 2026-10-03,
  WYYYSCHOKK_IDENTITY_COLLISION_1; RSW_Wyyyschokk retired). The donor `Wyyyschokk` ThingDef in
  `mlie.starwarsanimalcollection` was patched here until the Phase 0 cleanup (2026-10-15) deleted that
  operation: the donor def goes with the donor, and RM_Ollathrix is the creature that keeps the drop.
  The one operation left is a PatchOperationConditional: a patch that matches nothing logs nothing,
  so it loads fine with or without the Webwork mod present.
  🔴 butcherProducts is DICTIONARY-KEYED despite being a C# List<ThingDefCountClass> —
  ThingDefCountClass has a custom LoadDataFromXmlCustom that reads the entry
  TAG as the thingDef name and its TEXT as the count (vanilla:
  `<Steel>30</Steel>` inside Races_Mechanoid.xml). An `<li>` child here throws
  inside that loader and RimWorld discards the WHOLE DEF silently
  (rimworld-custom-loader-li-trap). validate_patch.py, run with the live def
  dump, caught this exact defect on the first pass; fixed before commit.
-->
<Patch>

  <!-- RM_Ollathrix is THE wyyyschokk (owner ruling 2026-10-03, WYYYSCHOKK_IDENTITY_COLLISION_1): it drops the same fangs.
       Its butcherProducts exists (Hyperweave), so a plain Add; no-op when the Webwork mod is absent. -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="RM_Ollathrix"]/butcherProducts</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="RM_Ollathrix"]/butcherProducts</xpath>
      <value>
        <RSW_WyyyschokkFang>3</RSW_WyyyschokkFang>
      </value>
    </match>
  </Operation>

</Patch>
