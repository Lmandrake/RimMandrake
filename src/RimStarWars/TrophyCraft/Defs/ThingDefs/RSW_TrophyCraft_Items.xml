<?xml version="1.0" encoding="utf-8"?>
<!--
  RSW_TrophyCraft_Items                    mandrake.rsw.trophycraft

  WYYYSCHOKK_FANG_PENDANT_1. One ThingDef: the raw fang (a butcher/hunt
  product, attached to the donor Wyyyschokk by
  Patches/RSW_TrophyCraft_WyyyschokkFangDrop.xml), a trade good.
  The fang pendant, its recipe, its observer thought and its RSW_Neck layer
  were removed from the game (owner, picks_icons_sheet_2026-10-19: "drop").

  Pattern for the fang: SWBestiary's own RSW_MudhornSkull (ParentName
  ResourceBase, a stackable butcher-trophy resource) — same shape, smaller
  numbers, since a fang is a common drop rather than a rare skull trophy.
-->
<Defs>

  <ThingDef ParentName="ResourceBase">
    <defName>RSW_WyyyschokkFang</defName>
    <label>wyyyschokk fang</label>
    <description>A curved fang torn from a wyyyschokk's mouth-loom. Dark,
serrated, and stained near the tip — hunting tribes cord them into pendants
to mark a proven kill.</description>
    <graphicData>
      <texPath>swresource/WyyyschokkFang</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>3</MarketValue>
      <MaxHitPoints>60</MaxHitPoints>
      <Mass>0.02</Mass>
      <Flammability>0.5</Flammability>
      <DeteriorationRate>2.0</DeteriorationRate>
    </statBases>
    <resourceReadoutPriority>Last</resourceReadoutPriority>
    <stackLimit>75</stackLimit>
    <thingCategories>
      <li>ItemsMisc</li>
    </thingCategories>
    <tradeTags>
      <li>Exotic</li>
    </tradeTags>
  </ThingDef>

</Defs>
