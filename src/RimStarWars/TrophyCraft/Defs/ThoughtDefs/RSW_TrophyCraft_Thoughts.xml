<?xml version="1.0" encoding="utf-8"?>
<!--
  RSW_TrophyCraft_Thoughts                 mandrake.rsw.trophycraft

  WYYYSCHOKK_FANG_PENDANT_1, spec option (a): a plain, Harmony-free
  ThoughtWorker, never the ideoligion precept route. Shape verified against
  the vanilla ThoughtDef `PsychicLove`
  (Royalty/Defs/ThoughtDefs/Thoughts_Situation_Special.xml) — the closest
  shipped example of a non-precept `Thought_SituationalSocial` with a
  `baseOpinionOffset` stage and no ideo gate.

  `RSW_FactionApparelThoughtExtension.factionDefNames` ships EMPTY here —
  RimStarWars tier does not know Utinni's campaign factions. RimUtinni
  Patches wires in the real three (WyyyschokkFangPendantFactions.xml).
  `p` in CurrentSocialStateInternal(p, otherPawn) is the OBSERVER (the one
  whose faction is checked); `otherPawn` is the WEARER (the one whose
  apparel is checked) — verified against vanilla's own
  ThoughtWorker_Precept_GroinUncovered_Social, which checks otherPawn's
  body, not p's.
-->
<Defs>

  <ThoughtDef>
    <defName>RSW_TrophyCraft_ObserverBraveFang</defName>
    <thoughtClass>RimMandrake.StarWars.TrophyCraft.RSW_Thought_ObserverBraveFang</thoughtClass>
    <workerClass>RimMandrake.StarWars.TrophyCraft.RSW_ThoughtWorker_ObserverFactionApparel</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <modExtensions>
      <li Class="RimMandrake.StarWars.TrophyCraft.RSW_FactionApparelThoughtExtension">
        <apparelDefName>RSW_Apparel_FangPendant</apparelDefName>
        <factionDefNames>
          <!-- RUT_-tier campaign data, added by
               src/RimUtinni/UtinniPatches/Patches/WyyyschokkFangPendantFactions.xml.
               Empty here on purpose. -->
        </factionDefNames>
      </li>
    </modExtensions>
    <stages>
      <li>
        <label>wears the fang of the great weaver</label>
        <description>[OTHERPAWN_nameDef] wears the corded fangs of a
wyyyschokk at their throat. Whatever else is true of them, they looked the
great weaver in its many eyes and walked away with proof of it.</description>
        <labelSocial>wears the wyyyschokk fangs</labelSocial>
        <baseOpinionOffset>8</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
