  <!-- ========================================================================
       RSW_DW_Part_Frame — DROIDWORKS_SHOP_BENCHES_1 (packet B4b). The bare
       chassis: "1 head + 1 frame + the part set. No head, no droid" (section
       1.3). Generic across families, same as the other six parts. Never
       installed on a LIVE droid (no Recipe_InstallDroidPart for it) - a
       frame is only ever consumed whole, by the reassembly harness or the
       shop rebuild bill.
  ======================================================================== -->
  <ThingDef ParentName="ResourceBase">
    <defName>RSW_DW_Part_Frame</defName>
    <label>droid frame</label>
    <description>A bare droid chassis - the frame everything else bolts to. No head, no droid.</description>
    <graphicData>
      <texPath>OuterRim/Items/DroidParts/DroidParts_c</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <Mass>3.0</Mass>
      <MaxHitPoints>80</MaxHitPoints>
      <Flammability>0.3</Flammability>
      <MarketValue>200</MarketValue>
    </statBases>
    <techLevel>Spacer</techLevel>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <comps>
      <li>
        <compClass>CompQuality</compClass>
      </li>
    </comps>
    <!-- Craftable, not drop-table salvage - "Frame and most parts are
         craftable" (section 1.3), and B9's own Primitive tier (grossly
         inferior stats, unbuilt) is the future proper route. This recipe
         is the stopgap so the harness has a source before B9 lands. -->
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <effectWorking>Repair</effectWorking>
      <soundWorking>Recipe_Machining</soundWorking>
      <workAmount>1000</workAmount>
      <productCount>1</productCount>
      <workSkill>Crafting</workSkill>
      <recipeUsers>
        <li>FabricationBench</li>
      </recipeUsers>
      <skillRequirements>
        <Crafting>4</Crafting>
      </skillRequirements>
      <researchPrerequisite>RSW_DW_Research_PrimitiveFabrication</researchPrerequisite>
    </recipeMaker>
    <costList>
      <Steel>40</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
  </ThingDef>

</Defs>
