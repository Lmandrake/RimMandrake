  <!-- ========================================================================
       RSW_DW_Head_Mindstone - MECHANOID_ORIGIN_CANON_1's race, per ruling 3
       ("Mindstone race = a Droidworks chassis with a special head"). Made by
       the campaign's RUT_CaseMindstoneHead at the reassembly harness
       (UtinniPatches, MINDSTONE_MATRIX_KINDLED_BUILD_1) and accepted by
       RSW_DW_AssembleDroid; the droid it makes carries RSW_DW_MindstoneMind
       and refuses wipes, spikes and formats with text. A dying mindstone
       droid drops this head (CompDWHeadDropper). Stats are FOUNDRY's
       PLACEHOLDER: no numbers have been ruled (owed, open on that item).
       Art: vanilla Biotech's Mechlink texPath, PLACEHOLDER; own art owed.
  ======================================================================== -->
  <ThingDef ParentName="ResourceBase">
    <defName>RSW_DW_Head_Mindstone</defName>
    <thingClass>RimMandrake.StarWars.Droidworks.Thing_DWHead</thingClass>
    <label>mindstone head</label>
    <description>A droid head casing built around something that is not the usual imported brain trio - a mindstone, humming with a presence that answers when addressed. Not really a droid mind any more.</description>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/Mechlink</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
