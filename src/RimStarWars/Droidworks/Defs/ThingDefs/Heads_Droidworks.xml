<!-- ========================================================================
     DROIDWORKS_HEADS_BRAINS_SPIKES_1 (packet B3). The real per-family heads
     RSW_DW_DroidHead (Items_Droidworks.xml) was always a placeholder for -
     that generic item stays as-is (still the RSW_DW_DataSpike ingredient),
     these are the ones CompDWHeadDropper actually spawns on a droid's death.

     thingClass Thing_DWHead + CompProperties_HeadIdentity (Source/Droidworks/
     CompHeadIdentity.cs): a head dropped off a dying droid carries that
     droid's name into its own label and inspect string ("kill -> head drops
     with its name", the packet's own verify line); a head bought unused from
     a trader/Trade Moot stays generic until it is ever worn by a droid that
     then dies with it snapshotted in.

     Art: one existing portrait icon per family, picked from whichever
     donor race in that family (see Races_KotOR.xml/Races_OuterRim.xml/
     Races_JDS.xml's ParentName="DW_Family_*" blocks) already ships a
     single-image UI icon under KotOR/UI/ - Graphic_Single, no rotation-set
     risk (see Items_Droidworks.xml's own RSW_DW_DroidHead header for the
     Graphic_Multi/Graphic_Collection trap that art class avoids). Uniform
     stats across families: per-family stat variance is fine-parts territory
     (DROIDWORKS_FINE_PARTS_1, packet B4a), not this packet.
======================================================================== -->
<Defs>

  <ThingDef ParentName="ResourceBase">
    <defName>RSW_DW_Head_Labour</defName>
    <thingClass>RimMandrake.StarWars.Droidworks.Thing_DWHead</thingClass>
    <label>labour droid head</label>
    <description>A salvaged labour-chassis droid head - the imported brain trio, in its casing. If it came off a droid rather than off a shelf, it still carries that droid's identity.</description>
    <graphicData>
      <texPath>KotOR/UI/Icon_KM1HMD</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <Mass>1.5</Mass>
      <MaxHitPoints>60</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <MarketValue>300</MarketValue>
    </statBases>
    <techLevel>Spacer</techLevel>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <comps>
      <li Class="RimMandrake.StarWars.Droidworks.CompProperties_HeadIdentity" />
    </comps>
  </ThingDef>

