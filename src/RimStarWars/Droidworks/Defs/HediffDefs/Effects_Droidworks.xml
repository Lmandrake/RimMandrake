<?xml version="1.0" encoding="utf-8"?>
<!-- ========================================================================
     DROIDWORKS_FINE_PARTS_1 (packet B4a). Three quality-bucket HediffDefs per
     effectful part type (Leg/Manipulator/Sensor -> a capacity offset;
     Motivator/Servo -> a stat offset). PowerCell carries none (see
     Parts_Droidworks.xml's own header). Installed and swapped by
     Source/Droidworks/Recipe_InstallDroidPart.cs, which reads the consumed
     RSW_DW_Part_* item's CompQuality at bill-completion and picks ONE of
     the three below via the RecipeDef's own DroidPartEffectExtension -
     never more than one of a kind on a pawn at a time (the recipe removes
     whichever of the three it finds before adding the new one).

     Bucketing: Awful/Poor -> Inferior, Normal/Good -> Standard,
     Excellent/Masterwork/Legendary -> Superior. Offsets are FOUNDRY's own
     numbers (nothing in the design doc gives a figure) - "inferior sensor
     lowers Sight" is the one concrete claim the packet's verify line makes,
     and Standard(0)/Inferior(-)/Superior(+) around a Normal-quality
     baseline satisfies it by construction.
======================================================================== -->
<Defs>

  <HediffDef>
    <defName>RSW_DW_PartEffect_Leg_Inferior</defName>
    <label>leg actuator (inferior)</label>
    <description>An installed leg actuator, salvage-grade and it shows.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>1.0</maxSeverity>
    <isBad>true</isBad>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <capMods>
          <li><capacity>Moving</capacity><offset>-0.15</offset></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>RSW_DW_PartEffect_Leg_Standard</defName>
    <label>leg actuator (standard)</label>
    <description>An installed leg actuator, unremarkable and reliable.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <stages>
      <li><minSeverity>0</minSeverity></li>
    </stages>
  </HediffDef>
  <HediffDef>
