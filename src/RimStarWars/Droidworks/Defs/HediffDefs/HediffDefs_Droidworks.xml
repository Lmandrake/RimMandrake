<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ========================================================================
       RSW_DW_PoweredDown — state 3: downed/off. Backs
       Droidworks.HediffComp_PoweredDown (Source/Droidworks/HediffComp_PoweredDown.cs),
       whose CompPostTick pins severity at 1 and refuses all decay — this hediff
       does NOT self-clear; only Recipe_RebootDroid (see RecipeDefs below) removes
       it. The single stage's setMax mirrors JawaIonWeapons' own "overloaded"
       stage shape (RSW_JawaIon_Stun, HediffDefs_JawaIonStun.xml) — same mechanism,
       different door: Consciousness pinned under the vanilla downed threshold
       (~0.30) collapses the pawn alive.
  ======================================================================== -->
  <HediffDef>
    <defName>RSW_DW_PoweredDown</defName>
    <label>powered down</label>
    <description>This droid's power has run out. It cannot act until someone reboots it.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.5, 0.5, 0.5)</defaultLabelColor>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>1.0</maxSeverity>
    <isBad>true</isBad>
    <comps>
      <li Class="RimMandrake.StarWars.Droidworks.HediffCompProperties_PoweredDown" />
    </comps>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.10</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <!-- ========================================================================
       RSW_DW_IonOverload — PLACEHOLDER (per DROIDWORKS_PHASE0_XML_1's own spec: v0
       only, mirrors JawaIonWeapons' "overloaded" stage shape rather than the
       full 4-stage buildup ramp). Not yet wired to any DamageWorker/HediffComp -
       DROIDWORKS_ION_GUARD_1 is what makes RSW_JawaIon_Damage able to reach a droid
       at all; this def exists so a future pass has a real defName to target
       rather than inventing one at the point of use.
  ======================================================================== -->
  <HediffDef>
    <defName>RSW_DW_IonOverload</defName>
    <label>ion overload</label>
    <description>An accumulating ionic charge disrupting this droid's power bus. Enough of it drops the droid where it stands, powered down but intact.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.55, 0.75, 1.0)</defaultLabelColor>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>1.0</maxSeverity>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-1.2</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>overloaded</label>
        <minSeverity>0.9</minSeverity>
        <painFactor>0</painFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.10</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <!-- ========================================================================
       RSW_DW_RestrainingBolt — DROIDWORKS_BOLT_CORE_1. Started as pure vanilla
       HediffStage fields with zero custom comp — matches OuterRim_RestraintBolt
       exactly, read verbatim from the live mod XML (Droid Depot workshop 3096501398,
       1.6/Defs/HediffDefs/Droid_General.xml): "HediffWithComps, no comps",
       opinionOfOthersFactor 0, capMods Talking setMax 0 / Manipulation
       setMax 0.75, SlaveSuppressionFallRate 0 (Ideology-gated). Manipulation's
       25%-clumsier is a capMod setMax, NOT an offset/multiplier — offset is
       additive and vanilla capMods have no multiplicative field at all, so
       "0.75" IS the 25%-clumsier expression: it CAPS the capacity's ceiling
       at 75%, the same mechanism the mute cap uses at 0%.
       opinionOfOthersFactor is a HediffStage field, not a capMod — zeroes how
       much this pawn's opinion of others counts, the "no socialization" half
       of the ask.
       A Harmony prefix on MentalBreakWorker.BreakCanOccur (BoltCore
       sub-project, Source/BoltCore/BoltCorePatches.cs) suppresses mental
       breaks while this hediff is present — the "quells rebellion" half —
       copying the exact pattern droid_ruling.md section 3 documents.
  ======================================================================== -->
  <HediffDef>
    <defName>RSW_DW_RestrainingBolt</defName>
    <label>restraining bolt</label>
    <description>A restraining bolt, clamped or surgically fitted. Mutes the droid, makes its hands clumsier, and overrides its ability to form its own opinions of others.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.8, 0.3, 0.3)</defaultLabelColor>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>1.0</maxSeverity>
    <isBad>true</isBad>
    <!-- DROIDWORKS_BOLT_PAYOFF_1 (packet B5): "shear on damage". -->
    <comps>
      <li Class="RimMandrake.StarWars.Droidworks.HediffCompProperties_DWBoltShear">
        <shearChancePerDamage>0.02</shearChancePerDamage>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <opinionOfOthersFactor>0</opinionOfOthersFactor>
        <capMods>
          <li>
            <capacity>Talking</capacity>
            <setMax>0</setMax>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <setMax>0.75</setMax>
          </li>
        </capMods>
        <statFactors>
          <SlaveSuppressionFallRate MayRequire="Ludeon.RimWorld.Ideology">0</SlaveSuppressionFallRate>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <!-- ========================================================================
       RSW_DW_BoltResentment — hidden accumulator, backs
       Droidworks.HediffComp_DWBoltResentment (Source/Droidworks/
       HediffComp_DWBoltResentment.cs). Rises only while RSW_DW_RestrainingBolt is
       present on a Humanlike (sapient) pawn; pinned — never decays — once the
       bolt is removed (design/Jawa/droid_system_spec.md section 7:
       "Sapients accumulate resentment that persists after removal -> instant
       rebellion when freed"). Seeded onto a pawn by both application routes
       the moment a bolt goes on (Recipe_InstallRestrainingBolt.ApplyOnPawn /
       JobDriver_DWClampBolt's AddFinishAction), both via
       Droidworks.DroidworksBoltUtility.EnsureBoltResentment — so it is never
       present on a pawn that has never been bolted.

       STUB ACCUMULATOR ONLY — nothing reads this severity yet.
       // TODO: mood aura (a debuff radiating from a bolted pawn onto nearby
       //       colonists/droids — "depressing to be around", section 7)
       //       depends on a mood thought/aura system not yet built — phase 3.
       // TODO: idiosyncrasy-disable (bolts should suppress ALL born/
       //       experienced idiosyncratic traits, section 7) depends on the
       //       behavior-triad trait system from section 4/11, unbuilt.
       // TODO: instant-rebellion-on-removal is the payoff this accumulator
       //       feeds — not built here either; this item ships the
       //       accumulator only, per BENCH's own scope note.
       // TODO: the intended "player never sees a number for this" (see the
       //       C# comp's header) has no real field to carry it — `everVisible`
       //       doesn't exist on HediffDef and was silently dropped as a
       //       Config error (2026-09-08). Whoever builds a later phase should
       //       find the actual hide-from-health-tab idiom before this hediff
       //       does anything the player would notice.
  ======================================================================== -->
  <HediffDef>
    <defName>RSW_DW_BoltResentment</defName>
    <label>bolt resentment</label>
    <description>Accumulated resentment from being forced under a restraining bolt. Does not fade once the bolt is removed.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>1.0</maxSeverity>
    <isBad>true</isBad>
    <comps>
      <li Class="RimMandrake.StarWars.Droidworks.HediffCompProperties_DWBoltResentment">
        <severityPerDayWhileBolted>0.05</severityPerDayWhileBolted>
      </li>
    </comps>
  </HediffDef>

  <!-- ========================================================================
       RSW_DW_FormatTier — DROIDWORKS_FORMAT_TIERS_1 (packet B1). The droid's
       PERMANENT classification: what its programming makes it capable of feeling
       and doing. Not a state like RSW_DW_PoweredDown (which comes and goes and is
       cleared by a reboot) — this one is always present on every droid, put there
       at spawn by RimMandrake.StarWars.Droidworks.CompDWFormatTier (wired onto
       DW_Race_Base in Races_Base.xml) and moved only by the three format recipes.
       It COEXISTS with every other Droidworks hediff; nothing here replaces the
       powered-down / bolt / resentment hediffs, which answer different questions.

       Severity IS the ladder: 1 blank, 2 mindless, 3 programmable, 4 sapient
       (DroidFormatTierUtility.SeverityFor). Stage cuts sit at the half-points so a
       float can never land on a boundary. initialSeverity 3 = programmable, which
       is also the value minSeverity/maxSeverity bracket around (HediffDef
       ConfigErrors rejects minSeverity > initialSeverity).

       🔑 THE GATING IS PURE VANILLA XML, NOT HARMONY. Packet B1's own wording
       ("ShouldHaveNeed extension gating ... by stage; WorkTagIsDisabled postfix")
       described a C# route; two vanilla HediffStage fields do it natively and were
       used instead (Charter: "a named defName/xpath is an example, not a mandate"):
         * <disablesNeeds> is read by Pawn_NeedsTracker.ShouldHaveNeed itself, via
           HediffSet.DisablesNeed — the exact method the postfix would have wrapped.
           Vanilla precedent: Anomaly's VoidTouched (Hediffs_Global_Misc.xml).
         * <disabledWorkTags> is folded into Pawn.CombinedDisabledWorkTags, which is
           what Pawn.WorkTagIsDisabled returns — so a postfix there would have been
           re-implementing the field one line downstream. Vanilla precedent:
           Anomaly's CrumbledMind and BlissLobotomy, same file.
       Doing it in XML also makes the restrictions show up in the pawn's "incapable
       of" line and the hediff tooltip for free, which a Harmony postfix would not.

       NEEDS BY TIER — owner ruling 4, verbatim: "SAPIENT gets everything;
       PROGRAMMABLE gets Mood but not Joy/Beauty/Comfort; MINDLESS and BLANK have no
       needs." Outdoors is included with Joy/Beauty/Comfort per packet B1's own list.
       RSW_DW_Power is never disabled — every tier keeps it, which is what makes
       "mindless has Power only" true.

       WORK BY TIER — from the frozen sheet row abf_formatting: mindless is
       "only capable of low-level activities"; programmable "opens up many more
       complex skills especially dealing with other droids and machines, and
       includes self-defense/combat, repair, plant tending"; sapient adds
       "exceptional skill functions, savants, idiosyncracies, friendships &
       bonding". So: Artistic and Social are the sapient rungs (bonding and
       creativity), and "savants" is expressed as blocksInspirations rather than as
       a work tag, because that is the mechanism vanilla actually uses for it.
       ⚠️ Intellectual is deliberately LEFT ENABLED at programmable — the docs never
       place research on the sapient side, and an astromech slicing a computer is
       the canonical case. JUDGEMENT CALL, recorded in the item file.
  ======================================================================== -->
  <HediffDef>
    <defName>RSW_DW_FormatTier</defName>
    <label>format</label>
    <description>The level of programming this droid is running: what it is able to do, and what it is able to feel.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.55, 0.75, 0.65)</defaultLabelColor>
    <scenarioCanAdd>false</scenarioCanAdd>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <minSeverity>1</minSeverity>
    <maxSeverity>4</maxSeverity>
    <initialSeverity>3</initialSeverity>
    <stages>

      <!-- severity 1 — BLANK: a standby chassis, no programming at all. -->
      <li>
        <label>blank</label>
        <minSeverity>0</minSeverity>
        <blocksMentalBreaks>true</blocksMentalBreaks>
        <blocksInspirations>true</blocksInspirations>
        <disablesNeeds>
          <li>Mood</li>
          <li>Joy</li>
          <li>Beauty</li>
          <li>Comfort</li>
          <li>Outdoors</li>
        </disablesNeeds>
        <disabledWorkTags>
          <li>ManualDumb</li>
          <li>ManualSkilled</li>
          <li>Violent</li>
          <li>Caring</li>
          <li>Social</li>
          <li>Commoner</li>
          <li>Intellectual</li>
          <li>Animals</li>
          <li>Artistic</li>
          <li>Crafting</li>
          <li>Cooking</li>
          <li>Firefighting</li>
          <li>Cleaning</li>
          <li>Hauling</li>
          <li>PlantWork</li>
          <li>Mining</li>
          <li>Hunting</li>
          <li>Constructing</li>
          <li>Shooting</li>
        </disabledWorkTags>
      </li>

      <!-- severity 2 — MINDLESS: low-level labour only. Keeps ManualDumb,
           Hauling, Cleaning, Firefighting, Mining and Commoner. -->
      <li>
        <label>mindless</label>
        <minSeverity>1.5</minSeverity>
        <blocksMentalBreaks>true</blocksMentalBreaks>
        <blocksInspirations>true</blocksInspirations>
        <disablesNeeds>
          <li>Mood</li>
          <li>Joy</li>
          <li>Beauty</li>
          <li>Comfort</li>
          <li>Outdoors</li>
        </disablesNeeds>
        <disabledWorkTags>
          <li>ManualSkilled</li>
          <li>Violent</li>
          <li>Caring</li>
          <li>Social</li>
          <li>Intellectual</li>
          <li>Animals</li>
          <li>Artistic</li>
          <li>Crafting</li>
          <li>Cooking</li>
          <li>PlantWork</li>
          <li>Hunting</li>
          <li>Constructing</li>
          <li>Shooting</li>
        </disabledWorkTags>
      </li>

      <!-- severity 3 — PROGRAMMABLE: the ordinary working droid. Mood, no Joy. -->
      <li>
        <label>programmable</label>
        <minSeverity>2.5</minSeverity>
        <blocksInspirations>true</blocksInspirations>
        <disablesNeeds>
          <li>Joy</li>
          <li>Beauty</li>
          <li>Comfort</li>
          <li>Outdoors</li>
        </disablesNeeds>
        <disabledWorkTags>
          <li>Artistic</li>
          <li>Social</li>
        </disabledWorkTags>
      </li>

      <!-- severity 4 — SAPIENT: everything. No gating of any kind. -->
      <li>
        <label>sapient</label>
        <minSeverity>3.5</minSeverity>
      </li>

    </stages>
  </HediffDef>

  <!-- ========================================================================
       RSW_DW_RecentlyWiped — DROIDWORKS_WIPE_SEVERITY_1 (packet B10).
       Owner ruling 7, verbatim: "Wipes: 7-day debuff + service-record reset,
       and make it REALLY severe. Like it bumps into walls, learns how to use
       its body, and frequently forgets what it was doing during that week.
       Frequently also adds a permanent hardware quirk that cannot be reset but
       only accrete further."

       Added by RimMandrake.StarWars.Droidworks.Recipe_DWMemoryWipe.ApplyOnPawn
       (Source/Droidworks/Recipe_DWMemoryWipe.cs) — NOT wired onto DW_Race_Base
       like RSW_DW_FormatTier is: this is a temporary consequence of an
       operation, not a state every droid always carries.

       🔑 THE SEVEN DAYS ARE THE SEVERITY, and that is what makes the debuff
       TAPER rather than switch off. initialSeverity 1.0, HediffCompProperties_
       SeverityPerDay at -0.142857 (= -1/7), so severity crosses each stage
       boundary on schedule and hits 0 at day 7 — at which point Hediff.
       ShouldRemove (Severity <= 0) takes the hediff off by itself. Same
       mechanism RSW_DW_IonOverload above already uses, just over days instead
       of hours. NOT HediffCompProperties_Disappears: that expires a hediff at a
       fixed tick with the severity flat the whole time, which would give a
       droid identical impairment on day 6 as on day 1 and then cure it in one
       frame. "Learns how to use its body" is a ramp, not a timer.

         severity 1.00 → 0.67   days 0–2.3   blank-slate  (worst)
         severity 0.67 → 0.33   days 2.3–4.7 disoriented
         severity 0.33 → 0.00   days 4.7–7   relearning   (mildest)

       capMods carry "learns how to use its body". They are OFFSETS, not
       setMax: setMax caps a ceiling and would do nothing to a droid whose
       capacity was already below the cap, whereas an offset always bites.
       ⚠️ Consciousness is deliberately untouched — vanilla downs a pawn below
       ~0.30 Consciousness, and a wipe that collapsed the droid where it stood
       would be state 3 (powered down), not a debuff. Moving and Manipulation
       are the two capacities ruling 7 actually describes.

       HediffComp_DWWipeStumble (Source/Droidworks/HediffComp_DWWipeStumble.cs)
       carries the other two clauses — the job interruption ("frequently forgets
       what it was doing") and the blunder to a random nearby cell ("bumps into
       walls"). Its chance scales with severity, so the stumbling fades on the
       same curve the capMods do. See that file's header for why it is a
       HediffComp and not the JobGiver the packet's own wording named.

       ⚠️ The capMod numbers are FOUNDRY's own — ruling 7 gives an adjective
       ("REALLY severe"), not values. -0.45 Moving at worst is a droid moving at
       just over half speed.
  ======================================================================== -->
  <HediffDef>
    <defName>RSW_DW_RecentlyWiped</defName>
    <label>recently wiped</label>
    <description>This droid's memory was erased days ago. It is relearning how to move its own body, and keeps losing track of what it was doing.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.85, 0.75, 0.45)</defaultLabelColor>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>1.0</maxSeverity>
    <initialSeverity>1.0</initialSeverity>
    <isBad>true</isBad>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.142857</severityPerDay>
      </li>
      <li Class="RimMandrake.StarWars.Droidworks.HediffCompProperties_DWWipeStumble">
        <checkIntervalTicks>250</checkIntervalTicks>
        <stumbleChancePerCheck>0.05</stumbleChancePerCheck>
        <stumbleRadius>4</stumbleRadius>
      </li>
    </comps>
    <stages>

      <!-- days 4.7–7 — the tail. Nearly itself again. -->
      <li>
        <label>relearning</label>
        <minSeverity>0</minSeverity>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.10</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.10</offset>
          </li>
        </capMods>
      </li>

      <!-- days 2.3–4.7 — still visibly wrong. -->
      <li>
        <label>disoriented</label>
        <minSeverity>0.34</minSeverity>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.25</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.30</offset>
          </li>
        </capMods>
      </li>

      <!-- days 0–2.3 — the days immediately after the wipe. -->
      <li>
        <label>blank slate</label>
        <minSeverity>0.67</minSeverity>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.45</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.50</offset>
          </li>
        </capMods>
      </li>

    </stages>
  </HediffDef>

</Defs>
