<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ========================================================================
       RSW_DW_RebootDroid — the outside-help reboot. Backs
       RimMandrake.StarWars.Droidworks.Recipe_RebootDroid (Source/Droidworks/Recipe_RebootDroid.cs),
       whose AvailableOnNow/CompletableEver gate eligibility on
       HasHediff(RSW_DW_PoweredDown) in C# (AvailableOnNow reaches the
       operations menu via HealthCardUtility's AvailableReport call for a
       targetsBodyPart=false recipe - GetPartsToApplyOn is never called for
       this recipe). recipeUsers is left unset here: Races_Base.xml wires
       this recipe (and the other three below) onto DW_Race_Base's
       <recipes> instead, which every DW_Race_* race inherits.

       skillRequirements: the spec asked for "Crafting 4 or Medicine 4
       (either-or)". Vanilla RecipeDef.skillRequirements is an AND list, not OR -
       there is no XML-only way to express "either skill qualifies" without a
       custom RecipeWorker, which is a design change outside this item's scope
       (XML only, no C# changes here). v0 SIMPLIFICATION, flagged for the owner:
       Crafting 4 alone, the more droid-appropriate of the two skills. Revisit if
       the either-or requirement is load-bearing.
  ======================================================================== -->
  <RecipeDef>
    <defName>RSW_DW_RebootDroid</defName>
    <label>reboot droid</label>
    <description>Remove the powered-down state and restore enough charge for the droid to reach a charger under its own power.</description>
    <jobString>Rebooting droid.</jobString>
    <workerClass>RimMandrake.StarWars.Droidworks.Recipe_RebootDroid</workerClass>
    <workAmount>600</workAmount>
    <targetsBodyPart>false</targetsBodyPart>
    <anesthetize>false</anesthetize>
    <researchPrerequisite>RSW_DW_Research_Reboot</researchPrerequisite>
    <skillRequirements>
      <Crafting>4</Crafting>
    </skillRequirements>
  </RecipeDef>

  <!-- ========================================================================
       RSW_DW_InstallRestrainingBolt — DROIDWORKS_BOLT_CORE_1, the formal surgery
       route. Backs RimMandrake.StarWars.Droidworks.Recipe_InstallRestrainingBolt (Source/
       Droidworks/Recipe_InstallRestrainingBolt.cs), which is vanilla
       Recipe_InstallImplant plus one line seeding RSW_DW_BoltResentment — see
       that file's header. targetsBodyPart false + addsHediff needs ZERO
       override from vanilla Recipe_InstallImplant on its own
       (droid_ruling.md section 3's own OuterRim_AttachRestraintBolt proves
       this — it uses the bare vanilla class). surgerySuccessChanceFactor /
       isViolation / anesthetize copy that same recipe's shape exactly:
       "cannot fail," a violation, no anesthetic.
  ======================================================================== -->
  <RecipeDef>
    <defName>RSW_DW_InstallRestrainingBolt</defName>
    <label>install restraining bolt</label>
    <description>Fit a restraining bolt onto this droid: mute, clumsier, and unable to hold its own opinion of others.</description>
    <jobString>Installing restraining bolt.</jobString>
    <workerClass>RimMandrake.StarWars.Droidworks.Recipe_InstallRestrainingBolt</workerClass>
    <workAmount>600</workAmount>
    <targetsBodyPart>false</targetsBodyPart>
    <isViolation>true</isViolation>
    <anesthetize>false</anesthetize>
    <surgerySuccessChanceFactor>99999</surgerySuccessChanceFactor>
    <addsHediff>RSW_DW_RestrainingBolt</addsHediff>
    <researchPrerequisite>RSW_DW_Research_Bolting</researchPrerequisite>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>RSW_DW_RestrainingBoltItem</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>RSW_DW_RestrainingBoltItem</li>
      </thingDefs>
    </fixedIngredientFilter>
    <skillRequirements>
      <Crafting>4</Crafting>
    </skillRequirements>
  </RecipeDef>

  <!-- ========================================================================
       RSW_DW_RemoveRestrainingBolt — custom worker
       (RimMandrake.StarWars.Droidworks.Recipe_RemoveRestrainingBolt) because the bolt is a
       whole-pawn hediff (targetsBodyPart false) — the same reason
       OuterRimDroids ships its own Recipe_RemoveBolt rather than vanilla
       Recipe_RemoveImplant (droid_ruling.md section 3 /
       restraining_bolt_technical.md section 2). Deliberately does NOT touch
       RSW_DW_BoltResentment — the whole point of that hediff is that it survives
       removal.
  ======================================================================== -->
  <RecipeDef>
    <defName>RSW_DW_RemoveRestrainingBolt</defName>
    <label>remove restraining bolt</label>
    <description>Remove a restraining bolt from this droid.</description>
    <jobString>Removing restraining bolt.</jobString>
    <workerClass>RimMandrake.StarWars.Droidworks.Recipe_RemoveRestrainingBolt</workerClass>
    <workAmount>400</workAmount>
    <targetsBodyPart>false</targetsBodyPart>
    <isViolation>false</isViolation>
    <anesthetize>false</anesthetize>
    <removesHediff>RSW_DW_RestrainingBolt</removesHediff>
    <researchPrerequisite>RSW_DW_Research_Bolting</researchPrerequisite>
    <skillRequirements>
      <Crafting>3</Crafting>
    </skillRequirements>
  </RecipeDef>

  <!-- ========================================================================
       RSW_DW_LiberateHuttCaptive — DROID_HUTT_CAPTIVES_1 (packet C6). Custom
       worker (RimMandrake.StarWars.Droidworks.Recipe_LiberateHuttCaptive)
       because the gate is "prisoner AND already carries
       RSW_DW_RestrainingBolt" — no single vanilla RecipeDef field expresses
       that pair, same reason RSW_DW_RemoveRestrainingBolt above has its own
       GetPartsToApplyOn. Only ever offered on a captive found already bolted
       (StockGenerator_DWHuttCaptives, or a future site-cast route — see
       infrastructure/state/items/DROID_HUTT_CAPTIVES_1.md for the exact
       plug-in point); does not touch the bolt or its resentment at all —
       that stays RSW_DW_RemoveRestrainingBolt's job, rebellion check intact.
       isViolation false: freeing a prisoner from captivity is not a
       violation against the faction that held them.
  ======================================================================== -->
  <RecipeDef>
    <defName>RSW_DW_LiberateHuttCaptive</defName>
    <label>liberate captive</label>
    <description>Cut this captive free of its Hutt captivity. It joins you exactly as it is — bolt, and whatever resentment it has built up under it, both intact.</description>
    <jobString>Liberating captive.</jobString>
    <workerClass>RimMandrake.StarWars.Droidworks.Recipe_LiberateHuttCaptive</workerClass>
    <workAmount>250</workAmount>
    <targetsBodyPart>false</targetsBodyPart>
    <isViolation>false</isViolation>
    <anesthetize>false</anesthetize>
    <researchPrerequisite>RSW_DW_Research_Bolting</researchPrerequisite>
    <skillRequirements>
      <Crafting>2</Crafting>
    </skillRequirements>
  </RecipeDef>

  <!-- ========================================================================
       RSW_DW_MemoryWipe — DROIDWORKS_WIPE_AND_SPIKE_1. Backs
       RimMandrake.StarWars.Droidworks.Recipe_DWMemoryWipe (Source/Droidworks/Recipe_DWMemoryWipe.cs)
       — see that file's header for the full mechanism writeup (trait
       randomization via Verse.PawnGenerator.GenerateTraitsFor, relations via
       Pawn_RelationsTracker.ClearAllRelations, social memories via the same
       ISocialThought filter Anomaly's own Brainwipe ritual uses). Whole-pawn,
       no race restriction of its own — wired onto every DW_Race_* race
       via DW_Race_Base's <recipes> in Races_Base.xml, same as the other
       three Droidworks recipes.
       isViolation true — RecipeWorker.IsViolationOnPawn's own default logic
       already means "violation unless performed on your own faction's pawn",
       which is exactly right here: wiping your own droid is not a violation,
       wiping a captured hostile before/without consent is.

       DROIDWORKS_WIPE_SEVERITY_1 (packet B10) added the three teeth ruling 7
       asked for, all inside the same workerClass: the 7-day RSW_DW_RecentlyWiped
       debuff (HediffDefs_Droidworks.xml), a service-record reset against
       vanilla's Pawn_RecordsTracker, and a 60 %-per-wipe permanent hardware
       quirk from the TraitDefs_Droidworks.xml pool. Nothing about the recipe's
       own shape changed — only its description, which now warns the player.
  ======================================================================== -->
  <RecipeDef>
    <defName>RSW_DW_MemoryWipe</defName>
    <label>memory wipe</label>
    <description>Erase this droid's accumulated experience: clear its relations, social memories and service record, and roll a fresh set of personality traits. Sets the droid to your faction. Skills are untouched — they live in the body, not the mind. The droid spends the following week relearning how to move, and a wipe usually leaves a permanent hardware quirk behind.</description>
    <jobString>Wiping droid memory.</jobString>
    <workerClass>RimMandrake.StarWars.Droidworks.Recipe_DWMemoryWipe</workerClass>
    <workAmount>1200</workAmount>
    <targetsBodyPart>false</targetsBodyPart>
    <isViolation>true</isViolation>
    <anesthetize>false</anesthetize>
    <surgerySuccessChanceFactor>99999</surgerySuccessChanceFactor>
    <researchPrerequisite>RSW_DW_Research_Bolting</researchPrerequisite>
    <skillRequirements>
      <Crafting>5</Crafting>
    </skillRequirements>
  </RecipeDef>

  <!-- ========================================================================
       The three format recipes — DROIDWORKS_FORMAT_TIERS_1 (packet B1). All three
       back RimMandrake.StarWars.Droidworks.Recipe_DWFormatBase subclasses
       (Source/Droidworks/Recipe_DWFormat.cs), all whole-pawn
       (targetsBodyPart false, so AvailableOnNow/CompletableEver are the real
       gates — see Recipe_RebootDroid's header for why GetPartsToApplyOn is not),
       all wired onto every droid race through DW_Race_Base's <recipes> in
       Races_Base.xml.

       There is NO recipe that formats a droid UP to sapient, deliberately: the
       head-gate ruling (ruling 6) exists so no bench can manufacture a mind.
       Sapience is drifted into (DROIDWORKS_SERVICE_RECORD_DRIFT_1, packet E2).

       ⚠️ The Crafting numbers are a JUDGEMENT CALL — no design doc sets them. The
       ordering is the argument: destroying programming is easier than writing it.
       Research gating (RSW_DW_Research_Formatting) is DROIDWORKS_RESEARCH_ROWS_1's
       (packet B8) to add; these ship ungated.
  ======================================================================== -->
  <RecipeDef>
    <defName>RSW_DW_FormatDroid</defName>
    <label>format droid</label>
    <description>Install a standard working program on a blank or mindless droid, restoring it to normal function. Offered only on droids below the programmable tier — narrowing a sapient droid is a different operation.</description>
    <jobString>Formatting droid.</jobString>
    <workerClass>RimMandrake.StarWars.Droidworks.Recipe_DWFormatStandard</workerClass>
    <workAmount>1800</workAmount>
    <targetsBodyPart>false</targetsBodyPart>
    <isViolation>false</isViolation>
    <anesthetize>false</anesthetize>
    <surgerySuccessChanceFactor>99999</surgerySuccessChanceFactor>
    <researchPrerequisite>RSW_DW_Research_Formatting</researchPrerequisite>
    <skillRequirements>
      <Crafting>6</Crafting>
    </skillRequirements>
  </RecipeDef>

  <RecipeDef>
    <defName>RSW_DW_RestrictiveFormat</defName>
    <label>restrictive format</label>
    <description>Cut a droid's programming back to a mindless drone: hauling, cleaning, mining and nothing else. It will feel nothing, want nothing, and never break down. Doing this to a sapient droid destroys the mind that was there.</description>
    <jobString>Restrictively formatting droid.</jobString>
    <workerClass>RimMandrake.StarWars.Droidworks.Recipe_DWRestrictiveFormat</workerClass>
    <workAmount>1500</workAmount>
    <targetsBodyPart>false</targetsBodyPart>
    <isViolation>true</isViolation>
    <anesthetize>false</anesthetize>
    <surgerySuccessChanceFactor>99999</surgerySuccessChanceFactor>
    <researchPrerequisite>RSW_DW_Research_Formatting</researchPrerequisite>
    <skillRequirements>
      <Crafting>5</Crafting>
    </skillRequirements>
  </RecipeDef>

  <RecipeDef>
    <defName>RSW_DW_DeformatDroid</defName>
    <label>deformat droid</label>
    <description>Wipe a droid's programming entirely, leaving a blank standby chassis ready to be reformatted. Doing this to a sapient droid destroys the mind that was there.</description>
    <jobString>Deformatting droid.</jobString>
    <workerClass>RimMandrake.StarWars.Droidworks.Recipe_DWDeformat</workerClass>
    <workAmount>900</workAmount>
    <targetsBodyPart>false</targetsBodyPart>
    <isViolation>true</isViolation>
    <anesthetize>false</anesthetize>
    <surgerySuccessChanceFactor>99999</surgerySuccessChanceFactor>
    <researchPrerequisite>RSW_DW_Research_Formatting</researchPrerequisite>
    <skillRequirements>
      <Crafting>4</Crafting>
    </skillRequirements>
  </RecipeDef>

</Defs>
