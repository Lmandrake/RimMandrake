<?xml version="1.0" encoding="utf-8"?>
<!-- ========================================================================
     DROIDWORKS_FINE_PARTS_1 (packet B4a). One install recipe per effectful
     part type, all backed by the same
     RimMandrake.StarWars.Droidworks.Recipe_InstallDroidPart
     (Source/Droidworks/Recipe_InstallDroidPart.cs) - shape copied from
     RSW_DW_InstallRestrainingBolt (targetsBodyPart false, whole-pawn,
     ingredient filter on one ThingDef) with skillRequirements dropped to
     Crafting 2: this is a routine parts-swap, not the bolt's one-off
     violation-tier surgery. Not isViolation - installing a leg actuator on
     your own droid is ordinary maintenance.

     DroidPartEffectExtension names each recipe's own Inferior/Standard/
     Superior trio (Effects_Droidworks.xml). Wired onto DW_Race_Base's
     <recipes> (Races_Base.xml), same as the bolt/wipe/reboot/format
     recipes already there.
======================================================================== -->
<Defs>

  <RecipeDef>
    <defName>RSW_DW_InstallLegActuator</defName>
    <label>install leg actuator</label>
    <description>Fit a leg actuator. Quality tells: it changes how well this droid moves.</description>
    <jobString>Installing leg actuator.</jobString>
    <workerClass>RimMandrake.StarWars.Droidworks.Recipe_InstallDroidPartAtBench</workerClass>
    <workAmount>400</workAmount>
    <targetsBodyPart>false</targetsBodyPart>
    <anesthetize>false</anesthetize>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>RSW_DW_Part_Leg</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>RSW_DW_Part_Leg</li>
      </thingDefs>
    </fixedIngredientFilter>
    <skillRequirements>
      <Crafting>2</Crafting>
    </skillRequirements>
    <modExtensions>
      <li Class="RimMandrake.StarWars.Droidworks.DroidPartEffectExtension">
        <inferior>RSW_DW_PartEffect_Leg_Inferior</inferior>
        <standard>RSW_DW_PartEffect_Leg_Standard</standard>
        <superior>RSW_DW_PartEffect_Leg_Superior</superior>
      </li>
    </modExtensions>
  </RecipeDef>

