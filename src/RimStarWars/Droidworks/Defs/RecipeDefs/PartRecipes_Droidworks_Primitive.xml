<?xml version="1.0" encoding="utf-8"?>
<!-- ========================================================================
     DROIDWORKS_PRIMITIVE_TIER_1 (packet B9). Install recipes for
     Parts_Droidworks_Primitive.xml's 5 effectful Primitive parts (no Frame
     or PowerCell recipe here - see that file's own header for why). Reuses
     RimMandrake.StarWars.Droidworks.Recipe_InstallDroidPartAtBench VERBATIM
     (same worker class PartRecipes_Droidworks.xml's fine-part recipes use -
     the proximity-to-RSW_DW_RepairBench gate applies here too, it's still a
     bench job). No new C# - the "grossly inferior, always" behaviour comes
     entirely from pointing this RecipeDef's own DroidPartEffectExtension's
     inferior/standard/superior fields at the SAME def
     (Effects_Droidworks_Primitive.xml), so Recipe_InstallDroidPart.cs's own
     quality-bucketing switch (Awful/Poor/.../Legendary) always lands on
     that one hediff no matter what the consumed Primitive part's own
     CompQuality rolled.

     Wired onto DW_Race_Base's <recipes> (Races_Base.xml) alongside the fine
     tier's own 5 - ANY droid, any family, can be fitted with a cheap Jawa
     part (ruling 2's "use superior or inferior parts... be Jawa" economy is
     universal, not gated to the Primitive chassis itself). Available at
     Crafting 1 (fine tier is Crafting 2) - "very primitive" work needs no
     real expertise.
======================================================================== -->
<Defs>

  <RecipeDef>
    <defName>RSW_DW_InstallLegActuator_Primitive</defName>
    <label>install crude leg actuator</label>
    <description>Fit a Jawa-built leg actuator. Grossly inferior to a shop part, but it moves.</description>
    <jobString>Installing crude leg actuator.</jobString>
    <workerClass>RimMandrake.StarWars.Droidworks.Recipe_InstallDroidPartAtBench</workerClass>
    <workAmount>200</workAmount>
    <targetsBodyPart>false</targetsBodyPart>
    <anesthetize>false</anesthetize>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>RSW_DW_Part_Leg_Primitive</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>RSW_DW_Part_Leg_Primitive</li>
      </thingDefs>
    </fixedIngredientFilter>
    <researchPrerequisite>RSW_DW_Research_PrimitiveFabrication</researchPrerequisite>
    <skillRequirements>
      <Crafting>1</Crafting>
    </skillRequirements>
    <modExtensions>
      <li Class="RimMandrake.StarWars.Droidworks.DroidPartEffectExtension">
        <inferior>RSW_DW_PartEffect_Leg_Primitive</inferior>
        <standard>RSW_DW_PartEffect_Leg_Primitive</standard>
        <superior>RSW_DW_PartEffect_Leg_Primitive</superior>
      </li>
    </modExtensions>
  </RecipeDef>

