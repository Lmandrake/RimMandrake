<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Droidworks offline fuzz (Approach B, same shape as DivingInteraction/Bazaar/Ninefold). Plain net8.0, zero
    RimWorld/Unity references: ..\Droidworks\DroidworksKernel.cs is the PRODUCTION file the mod compiles, pulled in
    directly. If a `using Verse;` ever lands in it, this build breaks - the guard rail working.
    Run (builds on Windows via winbuild staging, then runs the exe):
      python3 src/RimMandrake/Utils/selftest_droidworks_fuzz.py [fuzz knobs]
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RimStarWarsDroidworks.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.StarWars.Droidworks.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Droidworks\DroidworksKernel.cs" />
    <Compile Include="DroidFuzz.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
