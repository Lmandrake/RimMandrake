<?xml version="1.0" encoding="utf-8"?>
<!--
  RSW_Transparisteel_GlassFold.xml          mandrake.rsw.armoury

  GLASS_TO_TRANSPARISTEEL_1 (design canon_materials_design_2026-10-09.md section 3.8): in the campaign tier
  transparisteel is the game's only glass. Stillsand (franchise-free, mandrake.rm.stillsand) is NOT edited and keeps
  RM_SunGlass / RM_LensGlass; this patch folds them away for the campaign only:
    - RM_MeltSunGlass and RM_MeltLensGlass are removed; ONE RSW_MeltTransparisteel (fine sand -> transparisteel at the
      sun furnace) replaces them (the solar oven crest no longer melts glass: glass sand must be sifted first)
    - every costList / product count of RM_SunGlass (4, 6, 20, 25, 30) becomes RSW_Transparisteel, per count
    - every recipe ingredient li RM_LensGlass becomes RSW_Transparisteel (precision, pearl, krayt lenses)
    - FlowWorks RM_Make_Bottle_Glass takes transparisteel instead of stone blocks
  RM_SunGlass / RM_LensGlass stay LOADABLE but unproduced and unused (saves; checked 2026-10-10: 0 occurrences in
  CANONICAL_ASHKARR_START_2026-09-12.rws and Gravship_v2_ring_2026-09-12.xml). Natural glasses are untouched.
  Guards: PatchOperationConditional on the defs existing, so with Stillsand/FlowWorks absent it is a silent no-op.
  Load order: Armoury loadAfter mandrake.rm.stillsand and mandrake.rm.flowworks (About.xml).
  Not a Mod Settings toggle: an XML patch cannot read a setting.
  PROVISIONAL: 10 fine sand -> 5 transparisteel (the old lens-glass ratio), 3 transparisteel -> 5 bottles; no calibration.
  Offline check: validation.transparisteel_fold_static (+ planted-defect selftest); Utils/canon_materials_audit.py.
-->
<Patch>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="RSW_Transparisteel"]</xpath>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="RM_FineSand"]</xpath>
      <match Class="PatchOperationSequence">
        <operations>
        <li Class="PatchOperationRemove">
          <success>Always</success>
          <xpath>/Defs/RecipeDef[defName="RM_MeltSunGlass"]</xpath>
        </li>
        <li Class="PatchOperationRemove">
          <success>Always</success>
          <xpath>/Defs/RecipeDef[defName="RM_MeltLensGlass"]</xpath>
        </li>
        <li Class="PatchOperationAdd">
          <success>Always</success>
          <xpath>/Defs</xpath>
          <value>
            <RecipeDef>
              <defName>RSW_MeltTransparisteel</defName>
              <label>melt transparisteel</label>
              <description>Fuse sifted fine sand into clear transparisteel in focused sunlight.</description>
              <jobString>Melting transparisteel.</jobString>
              <workAmount>1400</workAmount>
              <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
              <effectWorking>Smelt</effectWorking>
              <soundWorking>Recipe_Smelt</soundWorking>
              <workSkill>Crafting</workSkill>
              <workSkillLearnFactor>0.25</workSkillLearnFactor>
              <ingredients>
                <li>
                  <filter>
                    <thingDefs>
                      <li>RM_FineSand</li>
                    </thingDefs>
                  </filter>
                  <count>10</count>
                </li>
              </ingredients>
              <fixedIngredientFilter>
                <thingDefs>
                  <li>RM_FineSand</li>
                </thingDefs>
              </fixedIngredientFilter>
              <products>
                <RSW_Transparisteel>5</RSW_Transparisteel>
              </products>
              <recipeUsers>
                <li>RM_SunFurnace</li>
              </recipeUsers>
            </RecipeDef>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs//RM_SunGlass[text()="4"]</xpath>
          <value><RSW_Transparisteel>4</RSW_Transparisteel></value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs//RM_SunGlass[text()="6"]</xpath>
          <value><RSW_Transparisteel>6</RSW_Transparisteel></value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs//RM_SunGlass[text()="20"]</xpath>
          <value><RSW_Transparisteel>20</RSW_Transparisteel></value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs//RM_SunGlass[text()="25"]</xpath>
          <value><RSW_Transparisteel>25</RSW_Transparisteel></value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs//RM_SunGlass[text()="30"]</xpath>
          <value><RSW_Transparisteel>30</RSW_Transparisteel></value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/RecipeDef//li[text()="RM_LensGlass"]</xpath>
          <value><li>RSW_Transparisteel</li></value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="RM_GlassSand"]/description</xpath>
          <value><description>Pale, clean drift sand shovelled off a dune field. The grains are almost pure silica, worn round by the wind, with very little clay or iron in them. A sieve pulls the finest grains out of it, and the fine sand fuses into transparisteel.</description></value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="RM_FineSand"]/description</xpath>
          <value><description>The finest grains of desert silica, sifted clean and graded small. Traders buy it by the sack: glassmakers want it for transparisteel, and it has other uses besides. A sun furnace fuses it into transparisteel.</description></value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="RM_PrecisionLens"]/description</xpath>
          <value><description>A convex lens ground and polished from transparisteel and set in a thin metal rim. It is accurate enough for scopes and sighting optics, and for the condensers of high-performance solar stills.</description></value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="RM_PearlLens"]/description</xpath>
          <value><description>A lens ground around a glass pearl from the deep sand, milky at the rim and perfectly clear at the centre, seated in transparisteel. A pearl lens gathers light better than any lens ground from transparisteel alone. Set in a solar still, it doubles the still's output.</description></value>
        </li>
        </operations>
      </match>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="RSW_Transparisteel"]</xpath>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/RecipeDef[defName="RM_Make_Bottle_Glass"]</xpath>
      <match Class="PatchOperationSequence">
        <operations>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/RecipeDef[defName="RM_Make_Bottle_Glass"]/ingredients</xpath>
          <value>
            <ingredients>
              <li>
                <filter>
                  <thingDefs>
                    <li>RSW_Transparisteel</li>
                  </thingDefs>
                </filter>
                <count>3</count>
              </li>
            </ingredients>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/RecipeDef[defName="RM_Make_Bottle_Glass"]/fixedIngredientFilter</xpath>
          <value>
            <fixedIngredientFilter>
              <thingDefs>
                <li>RSW_Transparisteel</li>
              </thingDefs>
            </fixedIngredientFilter>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/RecipeDef[defName="RM_Make_Bottle_Glass"]/productHasIngredientStuff</xpath>
          <value>
            <productHasIngredientStuff>false</productHasIngredientStuff>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/RecipeDef[defName="RM_Make_Bottle_Glass"]/description</xpath>
          <value>
            <description>Fuse transparisteel into five clear glass bottles.</description>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <success>Always</success>
          <xpath>/Defs/RecipeDef[defName="RM_Make_Bottle_Glass"]/jobString</xpath>
          <value>
            <jobString>Making glass bottles from transparisteel.</jobString>
          </value>
        </li>
        </operations>
      </match>
    </match>
  </Operation>

</Patch>
