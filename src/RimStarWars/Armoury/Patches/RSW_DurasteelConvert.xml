<?xml version="1.0" encoding="utf-8"?>
<!--
  RSW_DurasteelConvert.xml          mandrake.rsw.armoury

  CANON_MATERIALS_BUILD_1 L2/L4-durasteel (design canon_materials_design_2026-10-09.md section 3.2). The donor
  guy762.mm.kotorcore / guy762.mm.kotorweapons make KOTOR_AlloyDurasteel; this patch points every use of it at
  RSW_Durasteel and then removes the donor def, so the donor alloy is no longer produced. The Armoury's absorbed
  copies (Defs/Absorbed_KotorCore, DEPLOY_HOLD) carry the same change in source. Old saves load
  KOTOR_AlloyDurasteel as RSW_Durasteel through RM_DefAliasDef (EnvironmentalHazards RM_MaterialMerges_Aliases.xml).

  Removed first: kotor_IngotDurasteel_recipe and its 10x variant (steel + uranium; uranium is not a canon input) and
  the KOTOR_MineableDurasteel entry in the junk-pile generator (the mineable def stays loadable for saves; its chunk
  KotORChunk_durasteel keeps smelting, now to RSW_Durasteel). Then one Replace per distinct stack count, because a
  PatchOperationReplace cannot rename an element and keep its text: the counts are the ones the donor uses today.
  A NEW count in a donor update would be left naming the removed def: the offline check in validation.py
  (durasteel_convert) lists the counts and fails when they drift from the source copy.
  Every operation is a no-op (success=Always) when its target is absent.
-->
<Patch>
  <Operation Class="PatchOperationRemove">
    <success>Always</success>
    <xpath>/Defs/RecipeDef[defName="kotor_IngotDurasteel_recipe" or defName="kotor_IngotDurasteel_10xrecipe"]</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <success>Always</success>
    <xpath>/Defs/ThingDef[defName="KOTOR_MineableJunk"]//KOTOR_MineableDurasteel</xpath>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs//KOTOR_AlloyDurasteel[text()="1"]</xpath>
    <value><RSW_Durasteel>1</RSW_Durasteel></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs//KOTOR_AlloyDurasteel[text()="5"]</xpath>
    <value><RSW_Durasteel>5</RSW_Durasteel></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>/Defs//KOTOR_AlloyDurasteel[text()="6"]</xpath>
    <value><RSW_Durasteel>6</RSW_Durasteel></value>
