<?xml version="1.0" encoding="utf-8"?>
<!--
  HediffDesc_ElectrostaffStun.xml           Jawa_Armoury, authored 2026-09-11

  BESTIARY_ARMOURY_DESC_BACKFILL_1: RSW_Electrostaff_Stun (HediffDef, absorbed
  from JDS Armory) carries the donor's literal "..." placeholder as its
  description in Absorbed_JDSArmory_Hediff.xml, GENERATED by
  gen_jds_armory_absorption.py; that generator applies no silent content
  fixes by its own stated rule ("a BENCH decision... belongs to the item, not
  this script"), so the text is patched here instead of hand-edited into the
  generated file, where a regen would silently drop it.
-->
<Patch>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/HediffDef[defName="RSW_Electrostaff_Stun"]/description</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/HediffDef[defName="RSW_Electrostaff_Stun"]/description</xpath>
      <value>
        <description>A jolt of current driven deep into muscle and nerve by an electrostaff strike. It locks up the body in pain long before it does any lasting harm.</description>
      </value>
    </match>
  </Operation>

</Patch>
