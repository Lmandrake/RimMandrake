                <spawnOnInteractionCell>true</spawnOnInteractionCell>
                <autoGrabFromHoppers>true</autoGrabFromHoppers>
                <autoInputSlots>
                  <li>(0,0,3)</li>
                  <li>(1,0,3)</li>
                  <li>(-1,0,3)</li>
                </autoInputSlots>
                <ticks>1600</ticks>
                <ingredients>
                  <li>
                    <thing>KotORChunk_plasteel</thing>
                    <countNeeded>1</countNeeded>
                  </li>
                </ingredients>
                <results>
                  <li>
                    <thing>Plasteel</thing>
