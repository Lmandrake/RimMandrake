<?xml version="1.0" encoding="utf-8"?>
<!--
  RSW_DurasteelProducersZeroed.xml          mandrake.rsw.armoury

  CANON_MATERIALS_BUILD_1 L1 (design canon_materials_design_2026-10-09.md section 3.2): "no mineable or deep-drill
  producer makes durasteel". RSW_DurasteelConvert_OuterRim.xml redirected LKDurasteel_Ore's mineableThing to
  RSW_Durasteel so the ore never names a dead def, but that left the ore a LIVE producer. The DefDump capture of
  2026-10-11 shows it: LKDurasteel_Ore scatters at commonality 0.5 (yield 40) and is listed in Core's PreciousLump
  GenStep and in Odyssey's Asteroid and Asteroid_NoRuins mineableCounts (40~45 each); KOTOR_MineableDurasteel scatters at
  0.15. This patch zeroes every one. The defs stay loadable (saves keep placed ore; mining it still yields RSW_Durasteel,
  which is the 1:1 conversion). Armoury loads after leutiankane.mineablesor (ModsConfig 506 vs 491), so LK's own
  GenStep additions are already in place when these removes run. The donor adds
  the shorthand form (<LKDurasteel_Ore>40~45</...>, workshop 3565716659 Patches/LKOre_PatchesAsteroidOR.xml), matched here. Every op is success=Always: audit with prove_canon_materials.py.
  Set-a-field is Conditional(Replace | Add): PatchOperationAddOrReplace is in no vanilla assembly and no installed mod
  (the first version used it, which would have failed to load). Meteorite and MineralRich gates: RSW_ZeroedOreGates.xml.
  NOT zeroed, deliberately: Ideology WorkSite_Mining's loot row and the trader/faction stock rows (sources by trade or
  raid loot, not mining producers).
-->
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods><li>LK Mineable Resources Outer Rim</li></mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/ThingDef[defName="LKDurasteel_Ore"]/building/mineableScatterCommonality</xpath>
          <match Class="PatchOperationReplace">
            <xpath>/Defs/ThingDef[defName="LKDurasteel_Ore"]/building/mineableScatterCommonality</xpath>
            <value><mineableScatterCommonality>0</mineableScatterCommonality></value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <success>Always</success>
            <xpath>/Defs/ThingDef[defName="LKDurasteel_Ore"]/building</xpath>
            <value><mineableScatterCommonality>0</mineableScatterCommonality></value>
          </nomatch>
        </li>
        <li Class="PatchOperationRemove">
          <success>Always</success>
          <xpath>/Defs/GenStepDef[defName="PreciousLump"]/genStep/mineables/li[text()="LKDurasteel_Ore"]</xpath>
        </li>
        <li Class="PatchOperationRemove">
          <success>Always</success>
          <xpath>/Defs/GenStepDef[defName="Asteroid" or defName="Asteroid_NoRuins" or defName="AsteroidBasic"]/genStep/mineableCounts/LKDurasteel_Ore</xpath>
        </li>
      </operations>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <success>Always</success>
    <xpath>/Defs/ThingDef[defName="KOTOR_MineableDurasteel"]/building/mineableScatterCommonality</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/ThingDef[defName="KOTOR_MineableDurasteel"]/building/mineableScatterCommonality</xpath>
      <value><mineableScatterCommonality>0</mineableScatterCommonality></value>
    </match>
  </Operation>
</Patch>
