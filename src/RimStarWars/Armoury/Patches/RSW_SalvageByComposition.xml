<?xml version="1.0" encoding="utf-8"?>
<!--
  RSW_SalvageByComposition.xml          mandrake.rsw.armoury

  CANON_MATERIALS_BUILD_1 L5 (design canon_materials_design_2026-10-09.md sections 0b, 3, 3.3, 6 duty 3): salvage yields
  durasteel, plasteel, duranium and doonium by what the wreck is made of. "A ship chunk can honestly yield durasteel plating,
  plasteel shells and components together; B1 remains give plasteel once." A large hull is the assembly of section 3: a
  durasteel shell, a plasteel housing, a duranium frame and a doonium core.

    salvage                                   what is added                         field (read from the def, not guessed)
    ShipChunk (Core; ShipChunkBase children    +20 RSW_Durasteel plating, +10 Plasteel  costList (deconstruct return)
      inherit it)
    ShuttleCrashed (Core; both Biotech        +30 RSW_Durasteel, +10 RSW_Duranium     costList (already 70 Plasteel)
      ShuttleCrashed_Exitable children)          frame, +5 RSW_Doonium core
    VFEP_ShipChunkReactor (VFE Pirates)       +10 RSW_Doonium reactor shielding        costList
    VFEP_CrashedShip parent (VFE Pirates;     +30 RSW_Durasteel, +15 Plasteel,        killedLeavings (no costList)
      four coloured wrecks)                      +10 RSW_Duranium, +5 RSW_Doonium
    B1 battle / security / commander droids   +12 Plasteel                            race butcherProducts (Pawn.ButcherProducts
      (Droidworks)                                                                       yields def.butcherProducts once)
  ShipChunk_durasteel (Armoury) already carries 40 RSW_Durasteel + 20 Plasteel + 11 components; untouched.
  B1 plasteel has ONE route: the droids' meatDef is Steel, leatherDef Leather_Human, no recipe or C# part dropper names
  Plasteel (prove_canon_materials.py L5 counts the routes and fails on two).
  Amounts PROVISIONAL (no calibration, no ruling). Every operation is a Conditional on the target existing, so an absent
  mod is a no-op; the VFE Pirates block is also FindMod-guarded.
-->
<Patch>
  <Operation Class="PatchOperationConditional">
    <success>Always</success>
    <xpath>/Defs/ThingDef[defName="ShipChunk"]/costList</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="ShipChunk"]/costList</xpath>
      <value><RSW_Durasteel>20</RSW_Durasteel><Plasteel>10</Plasteel></value>
    </match>
    <nomatch Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="ShipChunk"]</xpath>
      <match Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="ShipChunk"]</xpath>
        <value><costList><RSW_Durasteel>20</RSW_Durasteel><Plasteel>10</Plasteel></costList></value>
      </match>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <success>Always</success>
    <xpath>/Defs/ThingDef[defName="ShuttleCrashed"]/costList</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="ShuttleCrashed"]/costList</xpath>
      <value><RSW_Durasteel>30</RSW_Durasteel><RSW_Duranium>10</RSW_Duranium><RSW_Doonium>5</RSW_Doonium></value>
    </match>
    <nomatch Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="ShuttleCrashed"]</xpath>
      <match Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="ShuttleCrashed"]</xpath>
        <value><costList><RSW_Durasteel>30</RSW_Durasteel><RSW_Duranium>10</RSW_Duranium><RSW_Doonium>5</RSW_Doonium></costList></value>
      </match>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <success>Always</success>
    <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="RSW_DW_Race_JDSCIS_B1_Battle_Droid"]/butcherProducts</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="RSW_DW_Race_JDSCIS_B1_Battle_Droid"]/butcherProducts</xpath>
      <value><Plasteel>12</Plasteel></value>
    </match>
    <nomatch Class="PatchOperationConditional">
      <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="RSW_DW_Race_JDSCIS_B1_Battle_Droid"]</xpath>
      <match Class="PatchOperationAdd">
        <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="RSW_DW_Race_JDSCIS_B1_Battle_Droid"]</xpath>
        <value><butcherProducts><Plasteel>12</Plasteel></butcherProducts></value>
      </match>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <success>Always</success>
    <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="RSW_DW_Race_JDSCIS_B1_Security_Droid"]/butcherProducts</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="RSW_DW_Race_JDSCIS_B1_Security_Droid"]/butcherProducts</xpath>
      <value><Plasteel>12</Plasteel></value>
    </match>
    <nomatch Class="PatchOperationConditional">
      <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="RSW_DW_Race_JDSCIS_B1_Security_Droid"]</xpath>
      <match Class="PatchOperationAdd">
        <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="RSW_DW_Race_JDSCIS_B1_Security_Droid"]</xpath>
        <value><butcherProducts><Plasteel>12</Plasteel></butcherProducts></value>
      </match>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <success>Always</success>
    <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="RSW_DW_Race_JDSCIS_B1_Commander_Droid"]/butcherProducts</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="RSW_DW_Race_JDSCIS_B1_Commander_Droid"]/butcherProducts</xpath>
      <value><Plasteel>12</Plasteel></value>
    </match>
    <nomatch Class="PatchOperationConditional">
      <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="RSW_DW_Race_JDSCIS_B1_Commander_Droid"]</xpath>
      <match Class="PatchOperationAdd">
        <xpath>/Defs/AlienRace.ThingDef_AlienRace[defName="RSW_DW_Race_JDSCIS_B1_Commander_Droid"]</xpath>
        <value><butcherProducts><Plasteel>12</Plasteel></butcherProducts></value>
      </match>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationFindMod">
    <mods><li>Vanilla Factions Expanded - Pirates</li></mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationConditional">
          <success>Always</success>
          <xpath>/Defs/ThingDef[defName="VFEP_ShipChunkReactor"]/costList</xpath>
          <match Class="PatchOperationAdd">
            <xpath>/Defs/ThingDef[defName="VFEP_ShipChunkReactor"]/costList</xpath>
            <value><RSW_Doonium>10</RSW_Doonium></value>
          </match>
          <nomatch Class="PatchOperationConditional">
            <xpath>/Defs/ThingDef[defName="VFEP_ShipChunkReactor"]</xpath>
            <match Class="PatchOperationAdd">
              <xpath>/Defs/ThingDef[defName="VFEP_ShipChunkReactor"]</xpath>
              <value><costList><RSW_Doonium>10</RSW_Doonium></costList></value>
            </match>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <success>Always</success>
          <xpath>/Defs/ThingDef[@Name="VFEP_CrashedShip"]/killedLeavings</xpath>
          <match Class="PatchOperationAdd">
            <xpath>/Defs/ThingDef[@Name="VFEP_CrashedShip"]/killedLeavings</xpath>
            <value><RSW_Durasteel>30</RSW_Durasteel><Plasteel>15</Plasteel><RSW_Duranium>10</RSW_Duranium><RSW_Doonium>5</RSW_Doonium></value>
          </match>
          <nomatch Class="PatchOperationConditional">
            <xpath>/Defs/ThingDef[@Name="VFEP_CrashedShip"]</xpath>
            <match Class="PatchOperationAdd">
              <xpath>/Defs/ThingDef[@Name="VFEP_CrashedShip"]</xpath>
              <value><killedLeavings><RSW_Durasteel>30</RSW_Durasteel><Plasteel>15</Plasteel><RSW_Duranium>10</RSW_Duranium><RSW_Doonium>5</RSW_Doonium></killedLeavings></value>
            </match>
          </nomatch>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
