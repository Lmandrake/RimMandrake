  <TerrainDef ParentName="NaturalTerrainBase">
    <defName>SWCPTerrain_junkyardgarbage</defName>
    <label>trash-covered soil</label>
    <description>Ground so thoroughly buried in scrap and packaging that the soil beneath is a rumour. Walking it is slow, and nobody has ever called it pretty.</description>
    <texturePath>BiomeTerrain/trash</texturePath>
    <!-- <pollutionOverlayTexturePath>BiomeTerrain/trash_polluted</pollutionOverlayTexturePath> -->
    <pollutionOverlayTexturePath>Terrain/Surfaces/RoughStonePollutionOverlay</pollutionOverlayTexturePath>
    <pollutionShaderType MayRequire="Ludeon.RimWorld.Biotech">TerrainFadeRoughLinearAdd</pollutionShaderType>
    <pollutionColor>(1, 1, 1, 0.15)</pollutionColor>
    <edgeType>FadeRough</edgeType>
    <!-- <categoryType>Soil</categoryType> -->
    <renderPrecedence>340</renderPrecedence>
    <pathCost>6</pathCost>
    <statBases>
      <Beauty>-25</Beauty>
      <BeautyOutdoors>0</BeautyOutdoors>
      <Cleanliness>-25</Cleanliness>
    </statBases>
    <scatterType>Rocky</scatterType>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>GrowSoil</li>
      <li>Diggable</li>
    </affordances>
    <generatedFilth>Filth_Dirt</generatedFilth>
    <fertility>0.75</fertility>
    <takeFootprints>True</takeFootprints>
    <driesTo>Gravel</driesTo>
    <tools>
      <li>
        <label>dirt</label>
        <capacities>
          <li>KickMaterialInEyes</li>
        </capacities>
        <hediff>DirtInEyes</hediff>
        <cooldownTime>1.5</cooldownTime>
      </li>
    </tools>
    <tags>
      <li>SWCPOrdMantellTerrain_Soil</li>
    </tags>
  </TerrainDef>

