        <ConversionPower MayRequire="Ludeon.RimWorld.Ideology">0.2</ConversionPower>
        <NegotiationAbility>0.2</NegotiationAbility>
        <TradePriceImprovement>0.2</TradePriceImprovement>
      </equippedStatOffsets>
    </effects>
    <costList>
      <guy762_Headband_regalvisor>1</guy762_Headband_regalvisor>
    </costList>
    <researchPrerequisites>
      <li>guy762_ResearchKotOR_advupgrade</li>
    </researchPrerequisites>
  </ModularWeapons2.ModularPartsDef>

