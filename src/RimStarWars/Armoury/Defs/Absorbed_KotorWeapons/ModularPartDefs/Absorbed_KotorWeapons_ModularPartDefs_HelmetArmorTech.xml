<Defs>

  <ModularWeapons2.ModularPartsDef Name="guy762_KotORpartHelmetTech_verpine" ParentName="guy762_KotORModularPartBase">
    <defName>guy762_KotORpartHelmetTech_verpine</defName>
    <label>Verpine ocular enhancer</label>
    <labelShort>Verpine ocular enhancer</labelShort>
    <description>Verpine optics grafted into the helmet, ranging and correcting faster than the eye behind them. The wearer settles onto a target quickly and rarely misses it.</description>
    <attachedTo>guy762_KotORMount_helmettech</attachedTo>
    <effects>
      <statOffsets>
        <Mass>0.2</Mass>
        <EquipDelay>2</EquipDelay>
      </statOffsets>
      <equippedStatOffsets>
        <ShootingAccuracyPawn>0.2</ShootingAccuracyPawn>
        <AimingDelayFactor>-0.2</AimingDelayFactor>
      </equippedStatOffsets>
    </effects>
    <costList>
      <guy762_Headband_verpine>1</guy762_Headband_verpine>
    </costList>
    <researchPrerequisites>
      <li>guy762_ResearchKotOR_advupgrade</li>
    </researchPrerequisites>
  </ModularWeapons2.ModularPartsDef>

  <ModularWeapons2.ModularPartsDef Name="guy762_KotORpartHelmetTech_neural" ParentName="guy762_KotORModularPartBase">
    <defName>guy762_KotORpartHelmetTech_neural</defName>
    <label>neural stabilizers</label>
    <labelShort>neural stabilizers</labelShort>
    <description>Neural stabilizers clamped to the base of the skull, damping pain signals and the panic that follows them. The wearer stays standing, and stays sane, well past the point most would not.</description>
    <attachedTo>guy762_KotORMount_helmettech</attachedTo>
    <effects>
      <statOffsets>
        <Mass>0.2</Mass>
        <EquipDelay>2</EquipDelay>
      </statOffsets>
      <equippedStatOffsets>
        <PainShockThreshold>0.2</PainShockThreshold>
        <MentalBreakThreshold>-0.2</MentalBreakThreshold>
      </equippedStatOffsets>
    </effects>
    <costList>
      <guy762_Headband_nerualband>1</guy762_Headband_nerualband>
    </costList>
    <researchPrerequisites>
      <li>guy762_ResearchKotOR_advupgrade</li>
    </researchPrerequisites>
  </ModularWeapons2.ModularPartsDef>

  <ModularWeapons2.ModularPartsDef Name="guy762_KotORpartHelmetTech_lightscan" ParentName="guy762_KotORModularPartBase">
    <defName>guy762_KotORpartHelmetTech_lightscan</defName>
    <label>light-scan visor</label>
    <labelShort>light-scan visor</labelShort>
    <description>A visor that paints a low-power scanning grid across the ground ahead. Tripwires and pressure plates light up before a boot finds them.</description>
    <attachedTo>guy762_KotORMount_helmettech</attachedTo>
    <effects>
      <statOffsets>
        <Mass>0.2</Mass>
        <EquipDelay>2</EquipDelay>
      </statOffsets>
      <equippedStatOffsets>
        <PawnTrapSpringChance>-0.4</PawnTrapSpringChance>
      </equippedStatOffsets>
    </effects>
    <costList>
      <guy762_Headband_lightscan>1</guy762_Headband_lightscan>
    </costList>
    <researchPrerequisites>
      <li>guy762_ResearchKotOR_advupgrade</li>
    </researchPrerequisites>
  </ModularWeapons2.ModularPartsDef>

  <ModularWeapons2.ModularPartsDef Name="guy762_KotORpartHelmetTech_demovisor" ParentName="guy762_KotORModularPartBase">
    <defName>guy762_KotORpartHelmetTech_demovisor</defName>
    <label>demolitions visor</label>
    <labelShort>demolitions visor</labelShort>
    <description>A demolitions visor with the full ordnance suite: trap detection, fuse reading and firing solutions. Sappers and mortar crews are markedly better at their work, and markedly more likely to survive it.</description>
    <attachedTo>guy762_KotORMount_helmettech</attachedTo>
    <effects>
      <statOffsets>
        <Mass>0.4</Mass>
        <EquipDelay>4</EquipDelay>
      </statOffsets>
      <equippedStatOffsets>
        <PawnTrapSpringChance>-0.8</PawnTrapSpringChance>
        <MortarMissRadiusFactor>-0.4</MortarMissRadiusFactor>
      </equippedStatOffsets>
    </effects>
    <costList>
      <guy762_Headband_demovisor>1</guy762_Headband_demovisor>
    </costList>
    <researchPrerequisites>
      <li>guy762_ResearchKotOR_advupgrade</li>
    </researchPrerequisites>
  </ModularWeapons2.ModularPartsDef>

  <ModularWeapons2.ModularPartsDef Name="guy762_KotORpartHelmetTech_medical" ParentName="guy762_KotORModularPartBase">
    <defName>guy762_KotORpartHelmetTech_medical</defName>
    <label>medical interface visor</label>
    <labelShort>medical interface visor</labelShort>
    <description>A field surgeon's visor, overlaying anatomy, vitals and procedure onto whatever is bleeding in front of it. It turns a competent medic into a very good one.</description>
    <attachedTo>guy762_KotORMount_helmettech</attachedTo>
    <effects>
      <statOffsets>
        <Mass>0.4</Mass>
        <EquipDelay>4</EquipDelay>
      </statOffsets>
      <equippedStatOffsets>
        <MedicalSurgerySuccessChance>1</MedicalSurgerySuccessChance>
        <MedicalTendQualityOffset>1</MedicalTendQualityOffset>
        <MedicalTendSpeed>1</MedicalTendSpeed>
      </equippedStatOffsets>
    </effects>
    <costList>
      <guy762_Headband_medical>1</guy762_Headband_medical>
    </costList>
    <researchPrerequisites>
      <li>guy762_ResearchKotOR_advupgrade</li>
    </researchPrerequisites>
  </ModularWeapons2.ModularPartsDef>

  <ModularWeapons2.ModularPartsDef Name="guy762_KotORpartHelmetTech_breathmask" ParentName="guy762_KotORModularPartBase">
    <defName>guy762_KotORpartHelmetTech_breathmask</defName>
    <label>enhanced filtration system</label>
    <labelShort>enhanced filtration system</labelShort>
    <description>A sealed rebreather and scrubber stack fitted into the helmet. The wearer can work in fumes, spores and fallout and walk out unbothered.</description>
    <attachedTo>guy762_KotORMount_helmettech</attachedTo>
    <effects>
      <statOffsets>
        <Mass>0.3</Mass>
        <EquipDelay>3</EquipDelay>
      </statOffsets>
      <equippedStatOffsets>
        <ToxicEnvironmentResistance>1</ToxicEnvironmentResistance>
      </equippedStatOffsets>
    </effects>
    <costList>
      <guy762_Headband_breathmask>1</guy762_Headband_breathmask>
    </costList>
    <researchPrerequisites>
      <li>guy762_ResearchKotOR_advupgrade</li>
    </researchPrerequisites>
  </ModularWeapons2.ModularPartsDef>

