    <defName>guy762_KotORpartHelmetTech_regal</defName>
    <label>regal adornments</label>
    <labelShort>regal adornments</labelShort>
    <description>Inlay, filigree and a great deal of expensive trim added to an otherwise sensible helmet. It does nothing for the wearer's safety and a great deal for how seriously anyone takes them.</description>
    <attachedTo>guy762_KotORMount_helmettech</attachedTo>
    <effects>
      <statOffsets>
        <Mass>0.2</Mass>
        <EquipDelay>2</EquipDelay>
