  <ModularWeapons2.ModularPartsDef Name="guy762_KotORpartArmorTech_dex" ParentName="guy762_KotORModularPartBase">
    <defName>guy762_KotORpartArmorTech_dex</defName>
    <label>enhanced exoskeleton</label>
    <labelShort>enhanced exoskeleton</labelShort>
    <description>A full plasteel exoskeleton carrying the suit's weight so that the body inside does not. The wearer moves faster, dodges better and hauls more than should be possible in armour.</description>
    <attachedTo>guy762_KotORMount_armortech</attachedTo>
