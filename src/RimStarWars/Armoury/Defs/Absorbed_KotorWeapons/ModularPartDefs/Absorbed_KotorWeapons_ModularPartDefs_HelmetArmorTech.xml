        <MeleeDodgeChance>0.3</MeleeDodgeChance>
        <VEF_MassCarryCapacity MayRequire="OskarPotocki.VanillaFactionsExpanded.Core">30</VEF_MassCarryCapacity>
      </equippedStatOffsets>
    </effects>
    <costList>
