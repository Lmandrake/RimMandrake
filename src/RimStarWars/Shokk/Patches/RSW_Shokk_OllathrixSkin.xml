<?xml version="1.0" encoding="utf-8"?>
<!--
  RSW_Shokk_OllathrixSkin.xml                    mandrake.rsw.shokk

  OLLATHRIX_OWNER_SPECIES_1 (design/Jawa/worldbuilding/biomes/
  webwork_owner_and_nest_2026-09-23.md §1c, S6 rulings 1 and 6). The
  free-tier Webwork's owner species, RM_Ollathrix (mandrake.rm.webwork), is
  an invented spider that maps to the canon Wyyyschokk when this campaign
  layer is active — same shape as the Fever Wood's Sekkulaath -> dianoga.
  ONE defName, RM_Ollathrix, in both tiers: this patch swaps only the
  identity fields (label, labelPlural, description, the three lifeStages'
  bodyGraphicData.texPath) onto that same def. It never touches mechanics —
  RM_Ollathrix's stats, tools, comps and race fields are unchanged by this
  patch, per S6 ruling 6 ("the skin patch lives RSW, tier-correct for a Star
  Wars creature's LOOK") and per this item's own scope note (new mechanics —
  the bound hediff, spit, sun-scald, emergent-spawn — belong to
  SHOKK_SKIN_SHRINK_1, which moves them onto this same def from their
  current home in RSW_Shokk_Wyyyschokk.xml; NOT duplicated here).

  Every operation below is wrapped in PatchOperationConditional with match
  only (no nomatch) — a patch that matches nothing logs nothing, so a player
  running this mod without mandrake.rm.webwork's def present (should not
  happen — it is a hard modDependency/loadAfter, About.xml) gets a quiet
  no-op instead of a red error on every launch.

  Reuses the Wyyyschokk's already-shipped art path (swanimals/Wyyyschokk/
  Wyyyschokk{,_east,_north}) rather than commissioning new art — the same
  texPath RSW_Wyyyschokk's own PawnKindDef already uses, shipped by the
  donor mod `mlie.starwarsanimalcollection` (already a modDependency of
  this mod) and/or `mandrake.rsw.wyyyschokkartoverride`.

  UPDATE, SHOKK_SKIN_SHRINK_1 (2026-09-26): the mechanism move this file's
  own header once deferred is DONE — RM_Ollathrix now carries the mouth-loom
  spit, loom-bound and sun-scald mechanisms inline in mandrake.rm.webwork
  (RM_Ollathrix.xml), and this mod's own former RSW_Shokk_Wyyyschokk.xml
  (the patch that put them on the third-party donor) is retired. This file
  is now the WHOLE of this mod's mechanical content besides
  RSW_Shokk_FeraliskBrood.xml (a different item's content, untouched).

  🔴 STILL OPEN, not resolved by this move: MLIE_FAUNA_ABSORPTION_1
  (2026-09-18) separately ported the donor's Wyyyschokk in full as its own
  def, `RSW_Wyyyschokk` (src/RimStarWars/SWBestiary/Defs/ThingDefs_Races/
  RSW_Wyyyschokk.xml — its own BodyDef, egg-laying, shearable wool,
  TrophyCraft fang-drop recipe, tameable, combatPower 600, wildBiomes
  weighted to TropicalRainforest/TropicalSwamp). That port is mechanically
  unrelated to RM_Ollathrix (untameable, ambush-hunting, combatPower 160,
  bespoke body) and is not wired into any biome's wildAnimals — it is a
  SEPARATE, independent def this patch does not touch, reference or retire.
  A full campaign install therefore carries two things labelled
  "wyyyschokk": RSW_Wyyyschokk (homeless) and RM_Ollathrix wearing this
  patch's skin. Not a defName collision (both load fine) but a genuine
  identity/label collision — SHOKK_SKIN_SHRINK_1's scope was the mechanism
  move only; this needs an owner decision (retire/rename/re-wire
  RSW_Wyyyschokk, or accept two "wyyyschokk"s existing side by side) and is
  not adjudicated here.
-->
<Patch>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="RM_Ollathrix"]/label</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/ThingDef[defName="RM_Ollathrix"]/label</xpath>
      <value>
        <label>wyyyschokk</label>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="RM_Ollathrix"]/labelPlural</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/ThingDef[defName="RM_Ollathrix"]/labelPlural</xpath>
      <value>
        <labelPlural>wyyyschokk</labelPlural>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="RM_Ollathrix"]/description</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/ThingDef[defName="RM_Ollathrix"]/description</xpath>
      <value>
        <description>Wyyyschokk to the galaxy, feralisk on this world — a species of gigantic spider first catalogued on Kashyyyk, both highly intelligent and extremely hostile. Whatever web-thick world it is found on, it hunts the same way: by feel, through silk, never by sight.</description>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/PawnKindDef[defName="RM_Ollathrix"]/label</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/PawnKindDef[defName="RM_Ollathrix"]/label</xpath>
      <value>
        <label>wyyyschokk</label>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/PawnKindDef[defName="RM_Ollathrix"]/labelPlural</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/PawnKindDef[defName="RM_Ollathrix"]/labelPlural</xpath>
      <value>
        <labelPlural>wyyyschokk</labelPlural>
      </value>
    </match>
  </Operation>

  <!-- Art swap, one lifeStage at a time (baby/juvenile/adult, in that
       order in RM_Ollathrix.xml) — indices are positional, not a defName
       lookup, so a reordered lifeStages list on RM_Ollathrix simply
       stops matching (quiet no-op via the Conditional wrapper) rather
       than swapping the wrong stage's art. -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/PawnKindDef[defName="RM_Ollathrix"]/lifeStages/li[1]/bodyGraphicData/texPath</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/PawnKindDef[defName="RM_Ollathrix"]/lifeStages/li[1]/bodyGraphicData/texPath</xpath>
      <value>
        <texPath>swanimals/Wyyyschokk/Wyyyschokk</texPath>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/PawnKindDef[defName="RM_Ollathrix"]/lifeStages/li[2]/bodyGraphicData/texPath</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/PawnKindDef[defName="RM_Ollathrix"]/lifeStages/li[2]/bodyGraphicData/texPath</xpath>
      <value>
        <texPath>swanimals/Wyyyschokk/Wyyyschokk</texPath>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/PawnKindDef[defName="RM_Ollathrix"]/lifeStages/li[3]/bodyGraphicData/texPath</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/PawnKindDef[defName="RM_Ollathrix"]/lifeStages/li[3]/bodyGraphicData/texPath</xpath>
      <value>
        <texPath>swanimals/Wyyyschokk/Wyyyschokk</texPath>
      </value>
    </match>
  </Operation>

</Patch>
