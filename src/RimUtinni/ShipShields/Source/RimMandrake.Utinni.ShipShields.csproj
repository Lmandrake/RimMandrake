<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SHIELD_MODS_LEVERAGE_1 v1 slice (owner ruling, canon_reintegration_plan.md
    sec G.9, 2026-09-04: bespoke building-scale shield comp, NOW). One Harmony
    patch (CompProjectileInterceptor.CheckIntercept is not virtual, so the
    canon slow-projectile pass-through and the mode gate both need it), scoped
    to this mod's own CompShieldGenerator type only. Same recipe as
    src/RimMandrake/Aftermath/Source/RM_Aftermath.csproj.

    Build (the dotnet is WINDOWS-NATIVE and cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\Rimworld\src\RimUtinni\ShipShields\Source\RimMandrake.Utinni.ShipShields.csproj -c Release

    Output lands in ../Assemblies/, which is where RimWorld looks.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrake.Utinni.ShipShields</AssemblyName>
    <RootNamespace>RimMandrake.Utinni.ShipShields</RootNamespace>
    <Version>0.1.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HarmonyDll)' == ''">
    <HarmonyDll>C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\2009463077\Current\Assemblies\0Harmony.dll</HarmonyDll>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ShieldFieldMode.cs" />
    <Compile Include="ShieldModuleMapping.cs" />
    <Compile Include="CompProperties_ShieldGenerator.cs" />
    <Compile Include="CompShieldGenerator.cs" />
    <Compile Include="CompProperties_ShieldModuleSwitch.cs" />
    <Compile Include="CompShieldModuleSwitch.cs" />
    <Compile Include="CompProperties_ShieldThermalVeil.cs" />
    <Compile Include="CompShieldThermalVeil.cs" />
    <Compile Include="CompProperties_ShieldParticulateScreen.cs" />
    <Compile Include="CompShieldParticulateScreen.cs" />
    <Compile Include="ShieldLandingAdvisory.cs" />
    <Compile Include="HarmonyPatches.cs" />
    <Compile Include="ShipShieldsSettings.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
