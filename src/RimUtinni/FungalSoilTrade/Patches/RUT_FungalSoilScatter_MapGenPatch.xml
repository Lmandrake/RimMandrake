<?xml version="1.0" encoding="utf-8"?>
<!--
  Adds the fungal-ground scatter step globally, same shape as
  src/RimUtinni/LanternDeeps/Patches/RUT_LanternDeepEmergence_MapGenPatch.xml:
  GenStep_ScatterFungalGround self-gates to AB_MycoticJungle in its own
  Generate() override, so adding it to the shared base generator is safe - it
  silently no-ops on every other biome's maps.
-->
<Patch>

  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/MapGeneratorDef[@Name="MapCommonBase"]/genSteps</xpath>
    <value>
      <li>RUT_FungalSoilScatter</li>
    </value>
  </Operation>

</Patch>
