<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RimWorld 1.6 runs Unity/Mono against a .NET Framework 4.7.2 profile, so the mod
    DLL must target net472. Same shape as
    src/RimUtinni/RiverColors/Source/RimMandrake.Utinni.RiverColors.csproj (the
    HarmonyDll property); copy that file's header if this one goes stale.

    Build (dotnet is WINDOWS-NATIVE and cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\Rimworld\src\RimUtinni\FungalSoilTrade\Source\RimMandrake.Utinni.FungalSoilTrade.csproj -c Release

    Output lands in ../Assemblies/, which is where RimWorld looks. NOT built this
    session (no bridge/game access; the .csproj/.cs are the compile-clean deliverable,
    unverified against the real Windows-native dotnet toolchain).
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrake.Utinni.FungalSoilTrade</AssemblyName>
    <RootNamespace>RimMandrake.Utinni.FungalSoilTrade</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HarmonyDll)' == ''">
    <HarmonyDll>C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\2009463077\Current\Assemblies\0Harmony.dll</HarmonyDll>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="GenStep_ScatterFungalGround.cs" />
    <Compile Include="MapComponent_RotFungalDistress.cs" />
    <Compile Include="FungalSoilTradeOptions.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
