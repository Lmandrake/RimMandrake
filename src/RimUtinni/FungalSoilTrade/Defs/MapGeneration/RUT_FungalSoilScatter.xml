<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- FUNGAL_SOIL_TRADE_1. GenStep_ScatterFungalGround self-gates to
       RM_TheRot / RUT_TheRot (the Rot), so adding it to the shared base generator
       (see ../../Patches/RUT_FungalSoilScatter_MapGenPatch.xml) is safe: it
       no-ops on every other biome's maps, the same shape
       RUT_LanternDeepEmergence_Scatter uses.

       Density is the anti-exponential lever together with the mineable def's
       own fixed per-knot yield. countPer10kCellsRange 0.5~1 gives 3-6 clusters
       on a 250x250 map; each cluster covers (int)(validCells/10 x
       coveredCellsPer10Cells) cells (decompiled GenStep_ScatterGroup
       .CalculateScatterInformation), so 2~4 over a radius 1~2 rect (9-25 cells)
       is 1-10 knots per cluster. The old 0~0.01 truncated to 0 in every
       cluster and placed nothing (FUNGALSOIL_FIX_SCATTER_DENSITY_ZERO). Still a
       placeholder density pending the owner's call, same status LanternDeeps'
       own chancePerMap carries. -->

  <GenStepDef>
    <defName>RUT_FungalSoilScatter</defName>
    <order>322</order>
    <genStep Class="RimMandrake.Utinni.FungalSoilTrade.GenStep_ScatterFungalGround">
      <minSpacing>28</minSpacing>
      <!-- GenStep_Scatterer: no count/countPer10kCellsRange = zero scatters, silently. Placeholder density, a handful of clusters. -->
      <countPer10kCellsRange>0.5~1</countPer10kCellsRange>
      <groups>
        <li>
          <things>
            <RUT_MineableFungalGround>1</RUT_MineableFungalGround>
          </things>
          <coveredCellsPer10Cells>2~4</coveredCellsPer10Cells>
          <clusterRectRadius>1~2</clusterRectRadius>
        </li>
      </groups>
      <validators>
        <li Class="ScattererValidator_Buildable">
          <affordance>Heavy</affordance>
        </li>
        <li Class="ScattererValidator_NoNonNaturalEdifices" />
      </validators>
    </genStep>
  </GenStepDef>

</Defs>
