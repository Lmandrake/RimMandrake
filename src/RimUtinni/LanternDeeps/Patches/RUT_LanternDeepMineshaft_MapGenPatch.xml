<?xml version="1.0" encoding="utf-8"?>
<!--
  Adds the ruined-mineshaft scatter step globally, same as
  RUT_LanternDeepEmergence_MapGenPatch.xml does for the emergence entrance. The
  GenStep self-gates to the three allowed host biomes (GenStep_ScatterMineshaftPortal),
  so adding it to the shared base generator is safe: it silently no-ops on every
  other biome's maps.
-->
<Patch>

  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/MapGeneratorDef[@Name="MapCommonBase"]/genSteps</xpath>
    <value>
      <li>RUT_LanternDeepMineshaft_Scatter</li>
    </value>
  </Operation>

</Patch>
