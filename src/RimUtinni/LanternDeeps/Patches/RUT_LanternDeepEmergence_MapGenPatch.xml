<?xml version="1.0" encoding="utf-8"?>
<!--
  Adds the emergence-entrance scatter step globally, the same way Biomes! Caverns'
  own BMT_CrystalsGenerator ships (see
  .../294100/2969748433/1.6/Patches/BiomesCaverns_MapGeneration.xml). The GenStep
  itself (GenStep_ScatterCavePortal) self-gates to the three allowed host biomes,
  so adding it to the shared base generator is safe: it silently no-ops on every
  other biome's maps.
-->
<Patch>

  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/MapGeneratorDef[@Name="MapCommonBase"]/genSteps</xpath>
    <value>
      <li>RUT_LanternDeepEmergence_Scatter</li>
    </value>
  </Operation>

</Patch>
