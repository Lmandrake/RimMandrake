<?xml version="1.0" encoding="utf-8"?>
<!--
  CAVERNS_PARITY_BUILD_1 — the lanternstone floor, replacing the borrowed
  BMT_Crystal TerrainDef pair and the BMT_Crystal TerrainAffordanceDef.

  The affordance is load-bearing beyond decoration: the formation scatter
  (RUT_LanternstoneFormations) validates its spots with
  ScattererValidator_Buildable on this affordance, exactly as the donor's
  BMT_CrystalsGenerator did, which is what keeps the big crystals on the
  crystal shelves instead of all over the gravel.
-->
<Defs>

  <TerrainAffordanceDef>
    <defName>RUT_Lanternstone</defName>
    <label>lanternstone</label>
    <order>1200</order>
    <visualizeOnAffordanceOverlay>true</visualizeOnAffordanceOverlay>
    <affordanceOverlayColor>(119,189,239)</affordanceOverlayColor>
  </TerrainAffordanceDef>

  <TerrainDef ParentName="NaturalTerrainBase">
    <defName>RUT_LanternstoneFloor</defName>
    <label>lanternstone</label>
    <texturePath>RUT_LanternDeeps/Terrains/Lanternstone</texturePath>
    <isPaintable>false</isPaintable>
    <edgeType>FadeRough</edgeType>
    <renderPrecedence>335</renderPrecedence>
    <pathCost>3</pathCost>
    <statBases>
      <Beauty>4</Beauty>
      <BeautyOutdoors>4</BeautyOutdoors>
      <CleaningTimeFactor>0.75</CleaningTimeFactor>
      <Cleanliness>0</Cleanliness>
    </statBases>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>RUT_Lanternstone</li>
    </affordances>
    <fertility>0</fertility>
    <glowRadius>2</glowRadius>
    <glowColor>(119,189,239,0)</glowColor>
    <filthAcceptanceMask>
      <li>None</li>
    </filthAcceptanceMask>
    <takeFootprints>false</takeFootprints>
    <tags>
      <li>RUT_Lanternstone</li>
      <li>FineFloor</li>
    </tags>
  </TerrainDef>

  <TerrainDef ParentName="FloorBase">
    <defName>RUT_LanternstoneFloorConstructed</defName>
    <label>lanternstone floor</label>
    <description>Flooring cut from lanternstone hauled up out of the Deeps. Slow to lay, quite beautiful, and easy to clean. It glows faintly, forever.</description>
    <texturePath>RUT_LanternDeeps/Terrains/Lanternstone</texturePath>
    <isPaintable>false</isPaintable>
    <edgeType>Hard</edgeType>
    <renderPrecedence>335</renderPrecedence>
    <pathCost>0</pathCost>
    <statBases>
      <WorkToBuild>1100</WorkToBuild>
      <Beauty>4</Beauty>
      <BeautyOutdoors>4</BeautyOutdoors>
      <CleaningTimeFactor>0.75</CleaningTimeFactor>
      <Cleanliness>0</Cleanliness>
    </statBases>
    <researchPrerequisites>
      <li>Stonecutting</li>
    </researchPrerequisites>
    <costList>
      <RUT_Lanternstone>5</RUT_Lanternstone>
    </costList>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
    </affordances>
    <fertility>0</fertility>
    <glowRadius>2</glowRadius>
    <glowColor>(119,189,239,0)</glowColor>
    <filthAcceptanceMask>
      <li>None</li>
    </filthAcceptanceMask>
    <takeFootprints>false</takeFootprints>
    <tags>
      <li>RUT_Lanternstone</li>
      <li>FineFloor</li>
    </tags>
    <constructionSkillPrerequisite>3</constructionSkillPrerequisite>
  </TerrainDef>

</Defs>
