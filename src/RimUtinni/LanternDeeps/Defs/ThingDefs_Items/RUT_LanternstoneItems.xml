<?xml version="1.0" encoding="utf-8"?>
<!--
  CAVERNS_PARITY_BUILD_1 — lanternstone as a material and a chunk, replacing
  BMT_ResourceBlueCrystal and BMT_ChunkCrystal.

  Naming: the fiction rename that RUT_LanternstoneFictionRename.xml used to patch
  onto the donor's defs is now simply how these defs are written. Once Biomes!
  Caverns leaves the load that patch file is dead weight and gets deleted.

  ⚠️ stuffProps/appearance is vanilla `Smooth`, not the donor's
  BMT_AppearanceCrystal: a StuffAppearanceDef reference into a mod we are
  retiring would take the whole def down with it.

  DEEP_FLORA_RENAME_1 (owner ruling 2026-09-18): the Deeps' food crop is
  RUT_PufferTendrils, harvested from RUT_TwitchingPuffer (RUT_DeepFlora.xml) and
  the biome's foragedFood. Shape copied from RotSporeKit's raw-mushroom item so
  the two cook alike; no dependency on that mod.
-->
<Defs>

  <ThingDef ParentName="StoneBlocksBase">
    <defName>RUT_Lanternstone</defName>
    <label>lanternstone</label>
    <description>Blue native crystal cut out of the Lantern Deeps. It carries light: a block of it glows faintly and never stops. Structurally it behaves like a soft, brittle stone, and it is worth rather more than one.</description>
    <graphicData>
      <texPath>RUT_LanternDeeps/Things/Item/Lanternstone</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <tradeability>Sellable</tradeability>
    <generateCommonality>0</generateCommonality>
    <generateAllowChance>0</generateAllowChance>
    <deepCommonality>1</deepCommonality>
    <deepCountPerPortion>45</deepCountPerPortion>
    <deepLumpSizeRange>20~30</deepLumpSizeRange>
    <statBases>
      <MarketValue>1</MarketValue>
      <SharpDamageMultiplier>1.0</SharpDamageMultiplier>
      <BluntDamageMultiplier>0.6</BluntDamageMultiplier>
      <Beauty>4</Beauty>
      <ConstructionSpeedFactor>0.7</ConstructionSpeedFactor>
      <Mass>1</Mass>
    </statBases>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <stuffProps>
      <color>(106,173,222)</color>
      <commonality>0</commonality>
      <appearance>Smooth</appearance>
      <soundImpactBullet>BulletImpact_Ground</soundImpactBullet>
      <soundMeleeHitSharp>MeleeHit_Stone</soundMeleeHitSharp>
      <soundMeleeHitBlunt>MeleeHit_Stone</soundMeleeHitBlunt>
      <stuffAdjective>crystalline</stuffAdjective>
      <statFactors>
        <Beauty>1.25</Beauty>
        <MarketValue>0.6</MarketValue>
        <MaxHitPoints>1.8</MaxHitPoints>
        <Flammability>0</Flammability>
        <WorkToBuild>6.5</WorkToBuild>
        <WorkToMake>1.4</WorkToMake>
        <DoorOpenSpeed>0.5</DoorOpenSpeed>
        <MeleeWeapon_CooldownMultiplier>1.20</MeleeWeapon_CooldownMultiplier>
      </statFactors>
      <statOffsets>
        <Beauty>1</Beauty>
      </statOffsets>
    </stuffProps>
    <equipmentType>Primary</equipmentType>
    <techLevel>Neolithic</techLevel>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>1.75</glowRadius>
        <glowColor>(119,189,239,0)</glowColor>
      </li>
      <li>
        <compClass>CompEquippable</compClass>
      </li>
    </comps>
    <weaponClasses>
      <li>Melee</li>
      <li>MeleeBlunt</li>
      <li>Neolithic</li>
    </weaponClasses>
    <tools>
      <li>
        <label>crystal shard</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>11</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
  </ThingDef>

  <ThingDef ParentName="ChunkRockBase">
    <defName>RUT_ChunkLanternstone</defName>
    <label>lanternstone chunk</label>
    <description>A chunk of lanternstone. Can be cut into usable crystal at a stonecutter's table.</description>
    <graphicData>
      <texPath>RUT_LanternDeeps/Things/Chunks/LanternstoneChunk</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <color>(255,255,255)</color>
    </graphicData>
    <statBases>
      <Mass>20</Mass>
    </statBases>
    <soundDrop>ChunkRock_Drop</soundDrop>
    <butcherProducts>
      <RUT_Lanternstone>20</RUT_Lanternstone>
    </butcherProducts>
  </ThingDef>

  <ThingDef ParentName="PlantFoodRawBase">
    <defName>RUT_PufferTendrils</defName>
    <label>puffer tendrils</label>
    <description>Cut tentacles of the twitching puffer. They keep twitching for hours after harvest — pressure, not life — and are good to eat, even raw, if you can watch them.</description>
    <graphicData>
      <texPath>RUT_LanternDeeps/Things/Item/Crops/PufferTendrils</texPath>
    </graphicData>
    <statBases>
      <MarketValue>1.2</MarketValue>
      <Mass>0.027</Mass>
    </statBases>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>16</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <ingestible>
      <preferability>RawTasty</preferability>
      <foodType>Fungus</foodType>
    </ingestible>
    <ingredient>
      <mergeCompatibilityTags>
        <li MayRequire="Ludeon.RimWorld.Ideology">Fungus</li>
      </mergeCompatibilityTags>
    </ingredient>
  </ThingDef>

</Defs>
