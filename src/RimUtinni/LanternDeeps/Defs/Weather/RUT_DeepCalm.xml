<?xml version="1.0" encoding="utf-8"?>
<!--
  CAVERNS_PARITY_BUILD_1 — our own replacement for the borrowed BMT_Calm, the
  only weather an enclosed Deep ever runs (the_lantern_deeps.md §4b).

  Sky colours are the donor's, unchanged: they are what makes an enclosed cavern
  read as lit-from-within rather than as an overcast surface map.

  DEEPCALM_AMBIENT_SOUND_1: ambientSounds now points at RUT_DeepHum and
  RUT_DeepChorus (Defs/SoundDefs/RUT_DeepAmbience.xml) — our own SoundDefs, no
  new audio asset, both grains reused from Anomaly's shipped clips. Target:
  the_lantern_deeps.md §9, "the hum, rising to a Chorus".
-->
<Defs>

  <WeatherDef>
    <defName>RUT_DeepCalm</defName>
    <label>still air</label>
    <description>The air under the mountain does not move. No penalties or modifiers.</description>
    <repeatable>true</repeatable>
    <favorability>Good</favorability>
    <perceivePriority>0</perceivePriority>
    <windSpeedFactor>0</windSpeedFactor>
    <ambientSounds>
      <li>RUT_DeepHum</li>
      <li>RUT_DeepChorus</li>
    </ambientSounds>
    <skyColorsDay>
      <sky>(0.65,0.70,0.75)</sky>
      <shadow>(0.92,0.92,0.92)</shadow>
      <overlay>(0.5,0.5,0.5)</overlay>
      <saturation>0.9</saturation>
    </skyColorsDay>
    <skyColorsDusk>
      <sky>(0.65,0.70,0.75)</sky>
      <shadow>(0.92,0.92,0.92)</shadow>
      <overlay>(0.5,0.5,0.5)</overlay>
      <saturation>0.9</saturation>
    </skyColorsDusk>
    <skyColorsNightEdge>
      <sky>(0.65,0.70,0.75)</sky>
      <shadow>(0.92,0.92,0.92)</shadow>
      <overlay>(0.5,0.5,0.5)</overlay>
      <saturation>0.9</saturation>
    </skyColorsNightEdge>
    <skyColorsNightMid>
      <sky>(0.65,0.70,0.75)</sky>
      <shadow>(0.92,0.92,0.92)</shadow>
      <overlay>(0.5,0.5,0.5)</overlay>
      <saturation>0.9</saturation>
    </skyColorsNightMid>
  </WeatherDef>

</Defs>
