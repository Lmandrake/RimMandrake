<?xml version="1.0" encoding="utf-8"?>
<!-- FALL_LINE_ARRIVAL_MECHANISM_1, spec §8 pacing: "never more than one wreck a week, ... a rat
     every year or two". Both gated in C# on the Fall Line (RUT_FallLine mutator or a Fall Line
     world feature) unless the "anywhere" Mod Setting is on; allowedBiomes is belt-and-braces
     only. Frequency multipliers live in Mod Settings (BaseChanceThisGame). -->
<Defs>

  <IncidentDef>
    <defName>RUT_FallArrival</defName>
    <label>wreck falls</label>
    <category>Misc</category>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>RimMandrake.Utinni.FallLineArrivals.IncidentWorker_FallArrival</workerClass>
    <baseChance>2.0</baseChance>
    <minRefireDays>6</minRefireDays>
    <earliestDay>2</earliestDay>
  </IncidentDef>

  <!-- FALL_LINE_FERAL_SURVIVORS_BUILD_1 Band B drift-in (spec §5, §8: "a droid every couple of
       weeks"; at most maxFeralPerMap alive, default 3). The pool is spec §5.1's eight Droidworks
       utility kinds; MayRequire keeps the def loadable without Droidworks (an empty pool refuses). -->
  <IncidentDef>
    <defName>RUT_FallSurvivor</defName>
    <label>feral survivor</label>
    <category>Misc</category>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>RimMandrake.Utinni.FallLineArrivals.IncidentWorker_FallSurvivor</workerClass>
    <baseChance>0.8</baseChance>
    <minRefireDays>12</minRefireDays>
    <earliestDay>5</earliestDay>
    <modExtensions>
      <li Class="RimMandrake.Utinni.FallLineArrivals.FeralPoolExtension">
        <options>
          <li MayRequire="mandrake.rsw.droidworks"><kind>RSW_DW_OuterRim_MSEDroid</kind><weight>10</weight></li>
          <li MayRequire="mandrake.rsw.droidworks"><kind>RSW_DW_OuterRim_SalvageAssistDroid</kind><weight>10</weight></li>
          <li MayRequire="mandrake.rsw.droidworks"><kind>RSW_DW_OuterRim_DUMDroid</kind><weight>8</weight></li>
          <li MayRequire="mandrake.rsw.droidworks"><kind>RSW_DW_OuterRim_GNKDroid</kind><weight>8</weight></li>
          <li MayRequire="mandrake.rsw.droidworks"><kind>RSW_DW_OuterRim_RSeriesDroid</kind><weight>8</weight></li>
          <li MayRequire="mandrake.rsw.droidworks"><kind>RSW_DW_OuterRim_FX7Droid</kind><weight>5</weight></li>
          <li MayRequire="mandrake.rsw.droidworks"><kind>RSW_DW_OuterRim_MuckrakerDroid</kind><weight>5</weight></li>
          <li MayRequire="mandrake.rsw.droidworks"><kind>RSW_DW_OuterRim_DestroyerDroid</kind><weight>2</weight><dangerous>true</dangerous></li>
          <!-- FALL_LINE_FERAL_SURVIVOR_PAWNKIND_1: §8b's feral races, gated by their own Mod Setting. -->
          <li><kind>RUT_FeralSurvivor</kind><weight>8</weight><feralRace>true</feralRace></li>
        </options>
      </li>
    </modExtensions>
  </IncidentDef>

  <IncidentDef>
    <defName>RUT_LabRatFalls</defName>
    <label>specimen</label>
    <category>Misc</category>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>RimMandrake.Utinni.FallLineArrivals.IncidentWorker_LabRatFalls</workerClass>
    <baseChance>0.15</baseChance>
    <minRefireDays>90</minRefireDays>
    <earliestDay>10</earliestDay>
  </IncidentDef>

</Defs>
