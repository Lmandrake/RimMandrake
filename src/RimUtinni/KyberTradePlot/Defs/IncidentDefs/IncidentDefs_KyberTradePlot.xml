<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- KYBER_TRADE_PLOT_1. Neither incident is ever rolled by the storyteller (baseChance 0): GameComponent_KyberTrade
       (Source/KyberTrade.cs) fires each one when the kyber trade calls for it - the visit a day after the second sale,
       the donation once a door to it is open. Dev mode can fire either; the visit still comes only once per campaign. -->
  <IncidentDef>
    <defName>RUT_KyberHomesteadVisit</defName>
    <label>Homestead visitors asking about the kyber</label>
    <category>Misc</category>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>RimMandrake.Utinni.KyberTradePlot.IncidentWorker_KyberHomesteadVisit</workerClass>
    <requireColonistsPresent>true</requireColonistsPresent>
    <baseChance>0</baseChance>
  </IncidentDef>
  <!-- The donation is a quest (an ask the player can refuse); its plain GiveQuest worker subclass only reads the kill
       switch. -->
  <IncidentDef ParentName="GiveQuestBase">
    <defName>RUT_GiveQuest_KyberDonationSmuggle</defName>
    <label>kyber donation smuggle</label>
    <letterLabel>Quest available</letterLabel>
    <workerClass>RimMandrake.Utinni.KyberTradePlot.IncidentWorker_GiveQuest_KyberTradePlot</workerClass>
    <questScriptDef>RUT_KyberDonationSmuggle</questScriptDef>
    <baseChance>0</baseChance>
  </IncidentDef>
</Defs>
