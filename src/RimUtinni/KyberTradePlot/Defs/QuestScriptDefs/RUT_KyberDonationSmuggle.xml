<?xml version="1.0" encoding="utf-8" ?>
<!--
  RUT_KyberDonationSmuggle - KYBER_TRADE_PLOT_1 spec SS6, "The donation and the smuggle". Fired once per campaign by
  GameComponent_KyberTrade (Source/KyberTrade.cs) when a door to it opens: the Homestead visitors answered straight
  (SS5), or, when that visit went nowhere, Hutt interest reaching the Cartel fixer (SS4c). Built on vanilla's
  TradeRequestComp/QuestNode_TradeRequest_* (bring N of a named thing to a place inside a window), as
  src/RimUtinni/FungalSoilTrade/Defs/QuestScriptDefs/RUT_FungalSoilTradeRequest.xml does.

  THE RENDEZVOUS is a settlement of the smuggling lane, picked by QuestNode_GetKyberRendezvous
  (Source/QuestNode_GetKyberRendezvous.cs): non-hostile, Homestead (OutlanderCivil) or Hutt Cartel, the door's own
  faction first - never an Imperial outpost. The spec's "smuggler's cache" site template does not exist as a
  SitePartDef in this repo; a trade request at the lane's own settlement is the delivery mechanism instead.

  THE REWARD THAT IS NOT VICTORY (SS6.4, K2 RULED 2026-09-11 "the smuggle scrubs nothing - donation is pure cost,
  never laundering"): on fulfilment only a modest Homestead goodwill bump, a HistoryEvent and the letter of thanks.
  No QuestNode_GiveRewards, no silver back, no Heat change (the delivery is TradeRequestComp's, not a trade deal, so
  the kyber-sale hook never sees it), and nothing here or anywhere in this mod creates a faction, a pawn or a site for
  the Rebellion: "still no way to help it here: they lost, that's it."
-->
<Defs>

  <HistoryEventDef>
    <defName>RUT_KyberDonatedToCause</defName>
    <label>donated kyber to a cause that will never come back for it</label>
  </HistoryEventDef>

  <QuestScriptDef>
    <defName>RUT_KyberDonationSmuggle</defName>

    <rootSelectionWeight>0</rootSelectionWeight>
    <rootMinPoints>0</rootMinPoints>
    <defaultChallengeRating>1</defaultChallengeRating>
    <expireDaysRange>3~5</expireDaysRange>
    <everAcceptableInSpace>true</everAcceptableInSpace>

    <questNameRules>
      <rulesStrings>
        <li>questName->The ask: [settlement_label]</li>
        <li>questName->Kyber for the cause</li>
      </rulesStrings>
    </questNameRules>

    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->[theAsk]\n\n[requestedThingCount]x [requestedThing_label] (worth [requestedThingMarketValue_money]), given rather than sold, to be smuggled offworld on lanes the Hutts have run longer than the Empire has existed, to a cause still fighting it somewhere the war is not yet lost.\n\nThere is no payment coming back, and nothing it buys will ever reach this world: there is still no way to help it here. What you get is their thanks and the knowledge of where it went. Bring the kyber to [settlement_label] before the window closes, or don't; nobody will hold it against you either way. It will not be asked twice.[travelTime]</li>
        <li>theAsk(viaFixer==True,priority=1)->The Cartel's fixer passes along the message he swears he only carries: someone working the same lanes the Hutts do has a request.</li>
        <li>theAsk->The Homestead visitors you answered straight sent word, quietly: someone they trust has a request.</li>
        <li>travelTime(canCaravan==True,priority=1)-> The estimated travel time is [estimatedTravelTime_duration].</li>
        <li>travelTime-></li>
      </rulesStrings>
    </questDescriptionRules>

    <root Class="QuestNode_Sequence">
      <nodes>

        <li Class="QuestNode_GetMap">
          <canBeSpace>true</canBeSpace>
        </li>

        <li Class="QuestNode_QuestUnique">
          <tag>RUT_KyberDonationSmuggle</tag>
        </li>

        <!-- The rendezvous: a non-hostile settlement on the smuggling lane, never an Imperial one (vanilla's picker takes
             any faction). The door's own people first: the Homestead's for a straight answer, the Hutts' for the fixer. -->
        <li Class="RimMandrake.Utinni.KyberTradePlot.QuestNode_GetKyberRendezvous">
          <maxTileDistance>60</maxTileDistance>
          <storeAs>settlement</storeAs>
          <storeFactionAs>faction</storeFactionAs>
          <storeFactionLeaderAs>asker</storeFactionLeaderAs>
          <storeCanCaravanAs>canCaravan</storeCanCaravanAs>
          <storeViaFixerAs>viaFixer</storeViaFixerAs>
          <storeHomesteadAs>homestead</storeHomesteadAs>
          <storeKyberUnitValueAs>kyberUnitValue</storeKyberUnitValueAs>
        </li>
        <li Class="QuestNode_Letter">
          <inSignal>faction.BecameHostileToPlayer</inSignal>
          <label TKey="LetterLabelQuestFailed">Quest failed: [resolvedQuestName]</label>
          <text TKey="LetterTextQuestFailed">[faction_name] became hostile to you.</text>
        </li>
        <li Class="QuestNode_End">
          <inSignal>faction.BecameHostileToPlayer</inSignal>
          <outcome>Fail</outcome>
        </li>

        <li Class="QuestNode_TradeRequest_RandomOfferDuration">
          <settlement>$settlement</settlement>
          <storeAs>timeout</storeAs>
          <storeEstimatedTravelTimeAs>estimatedTravelTime</storeEstimatedTravelTimeAs>
        </li>

        <!-- Named explicitly, not vanilla's random picker (which filters candidates
             through PlayerItemAccessibilityUtility.PlayerCanMake and would never
             pick a mined-only crystal). convertTo>ThingDef< is required so
             [requestedThing_label] resolves in questDescriptionRules rather than
             blanking the whole description - the exact trap
             RUT_FungalSoilTradeRequest.xml's own header already documents.
             Binds to the donor defName per crystal_mods_inventory.md SS4 (kyber
             absorption owed separately); migrates to the tier grammar as ordinary
             owed work whenever that absorption lands (NAMING_SCHEME_EXECUTION_1
             closed 2026-08-31, no gate remains). -->
        <li Class="QuestNode_Set">
          <name>requestedThing</name>
          <value>Force_KyberCrystal</value>
          <convertTo>ThingDef</convertTo>
        </li>
        <li Class="QuestNode_Set">
          <name>requestedThingCount</name>
          <value>$(randInt(6,12))</value>
        </li>
        <li Class="QuestNode_Set">
          <name>requestedThingMarketValue</name>
          <value>$($requestedThingCount * $kyberUnitValue)</value>
        </li>

        <li Class="QuestNode_TradeRequest_Initiate">
          <settlement>$settlement</settlement>
          <requestedThingDef>$requestedThing</requestedThingDef>
          <requestedThingCount>$requestedThingCount</requestedThingCount>
          <duration>$timeout</duration>
        </li>

        <!-- Fulfillment: NO QuestNode_GiveRewards anywhere in this file (K2 - pure
             cost, never laundering). Only the goodwill bump, the memory, and the
             letter of thanks that is the reward the spec ruled. -->
        <!-- Only when a Homestead faction is left to remember it (the fixer door can be the only door). -->
        <li Class="QuestNode_IsSet">
          <name>homestead</name>
          <node Class="QuestNode_ChangeFactionGoodwill">
            <inSignal>settlement.TradeRequestFulfilled</inSignal>
            <faction>$homestead</faction>
            <change>5</change>
            <canSendMessage>false</canSendMessage>
            <canSendLetter>false</canSendLetter>
            <reason>RUT_KyberDonatedToCause</reason>
          </node>
        </li>

        <li Class="QuestNode_RecordHistoryEvent">
          <inSignal>settlement.TradeRequestFulfilled</inSignal>
          <historyDef>RUT_KyberDonatedToCause</historyDef>
        </li>

        <li Class="QuestNode_Letter">
          <inSignal>settlement.TradeRequestFulfilled</inSignal>
          <letterDef>NeutralEvent</letterDef>
          <label TKey="LetterLabelKyberDonationSmuggle">The crystals are gone</label>
          <text TKey="LetterTextKyberDonationSmuggle">The kyber changed hands and kept moving - past whatever the Empire calls a blockade, on lanes the Hutts have used longer than the Empire has existed. A short message comes back, once, secondhand: thanks, and nothing else. No word of how it will be spent, no promise it will change anything here.\n\nIt won't. There is still no way to help it here. Whatever war that kyber buys, it is a war fought somewhere else, by people who will never send anyone back for you.\n\nWord of it will reach the Homestead's sympathizers, and they will remember the gesture.</text>
        </li>

        <li Class="QuestNode_End">
          <inSignal>settlement.TradeRequestFulfilled</inSignal>
          <outcome>Success</outcome>
          <sendStandardLetter>false</sendStandardLetter>
        </li>

        <!-- Refusing or failing closes this for good (spec SS6.5): the kyber is
             lost with the caravan's normal fate, no revenge, no grudge - which is
             exactly what a plain, unembellished Fail outcome already is. -->
        <li Class="QuestNode_Delay">
          <delayTicks>$timeout</delayTicks>
          <isQuestTimeout>true</isQuestTimeout>
          <outSignalComplete>TradeRequestTimeout</outSignalComplete>
        </li>
        <li Class="QuestNode_End">
          <inSignal>TradeRequestTimeout</inSignal>
          <outcome>Fail</outcome>
        </li>
        <li Class="QuestNode_End">
          <inSignal>map.MapRemoved</inSignal>
          <outcome>Fail</outcome>
        </li>

      </nodes>
    </root>
  </QuestScriptDef>

</Defs>
