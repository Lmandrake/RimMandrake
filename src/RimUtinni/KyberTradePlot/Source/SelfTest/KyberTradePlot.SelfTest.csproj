<Project Sdk="Microsoft.NET.Sdk">

  <!--
    KYBER_TRADE_PLOT_1: the offline selftest of the kyber trade. A net48 console app that compiles this mod's REAL
    sources in (and Colony Visibility's component, the Empire meter a sale raises) against the game's real
    Assembly-CSharp, then drives them: the sale count over real Tradeable/TradeDeal objects, the Harmony patch applied
    to the real TradeDeal.TryExecute, the heat written into a real GameComponent_ColonyVisibility, and the plot's state
    machine through a long run of sales and ticks. Not the mod build: the mod's csproj lists its files by name.

    Run from a clone:  python3 src/RimMandrake/Utils/selftest_kyber_trade_plot.py
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>KyberTradePlot.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.Utinni.KyberTradePlot.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <DebugType>none</DebugType>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>
  <PropertyGroup Condition="'$(HarmonyDll)' == ''">
    <HarmonyDll>C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\2009463077\Current\Assemblies\0Harmony.dll</HarmonyDll>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Private=true: a standalone exe needs the game's assemblies copied beside it. -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(HarmonyDll)</HintPath><Private>true</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\KyberTradeKernel.cs" />
    <Compile Include="..\KyberTrade.cs" />
    <Compile Include="..\KyberHomesteadVisit.cs" />
    <Compile Include="..\QuestNode_GetKyberRendezvous.cs" />
    <Compile Include="..\KyberTradePlotIncidentWorker.cs" />
    <Compile Include="..\KyberTradePlotSettings.cs" />
    <Compile Include="..\..\..\..\RimMandrake\_Shared\SettingsKit\SettingsKitCore.cs" />
    <Compile Include="..\..\..\..\RimMandrake\_Shared\SettingsKit\SettingsKitDrawer.cs" />
    <Compile Include="..\..\..\..\RimMandrake\_Shared\HarmonyResilience\PatchApplier.cs" />
    <Compile Include="..\..\..\..\RimMandrake\Visibility\Source\Kernel\RM_VisibilityKernel.cs" />
    <Compile Include="..\..\..\..\RimMandrake\Visibility\Source\GameComponent_ColonyVisibility.cs" />
    <Compile Include="..\..\..\..\RimMandrake\Visibility\Source\RM_VisibilityMod.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
