<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- THEY_MOD_REPLICATION_1. Ports donor's Faction_Ants.xml 1:1.
       startingCountAtWorldCreation is declared 0 directly here rather than
       through a patch — UtinniPatches/Patches/FactionSlate/OnlyOurFactions.xml
       used to zero the donor's GiantAnt_Faction the same way; a freshly
       authored hidden faction just states the answer instead of needing a
       patch to reach it. -->
  <FactionDef>
    <defName>RUT_GreentideAntFaction</defName>
    <label>giant ant colony</label>
    <pawnSingular>ant</pawnSingular>
    <pawnsPlural>ants</pawnsPlural>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <startingCountAtWorldCreation>0</startingCountAtWorldCreation>
    <fixedName>They!</fixedName>

    <humanlikeFaction>false</humanlikeFaction>
    <hidden>true</hidden>
    <autoFlee>false</autoFlee>
    <canUseAvoidGrid>false</canUseAvoidGrid>
    <techLevel>Animal</techLevel>
    <permanentEnemy>true</permanentEnemy>

    <factionIconPath>World/WorldObjects/TribalSettlement</factionIconPath>
    <settlementTexturePath>World/WorldObjects/TribalSettlement</settlementTexturePath>

    <allowedArrivalTemperatureRange>-40~60</allowedArrivalTemperatureRange>

    <raidLootValueFromPointsCurve>
      <points>
        <li>(35, 8)</li>
        <li>(100, 60)</li>
        <li>(1000, 250)</li>
        <li>(2000, 400)</li>
        <li>(4000, 500)</li>
      </points>
    </raidLootValueFromPointsCurve>

    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(0,35)</li>
        <li>(70, 50)</li>
        <li>(700, 100)</li>
        <li>(1300, 150)</li>
        <li>(100000, 10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>

    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>100</commonality>
        <options>
          <RUT_GreentideAnt>100</RUT_GreentideAnt>
        </options>
      </li>
    </pawnGroupMakers>
  </FactionDef>
</Defs>
