      <li>ITab_Bills</li>
    </inspectorTabs>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
      <heatPerTickWhileWorking>-0.2</heatPerTickWhileWorking>
      <workTableRoomRole>Workshop</workTableRoomRole>
      <workTableNotInRoomRoleFactor>0.8</workTableNotInRoomRoleFactor>
    </building>
    <size>(3,2)</size>
    <fillPercent>1</fillPercent>
    <passability>PassThroughOnly</passability>
    <pathCost>20</pathCost>
    <canOverlapZones>false</canOverlapZones>
    <designationCategory>Production</designationCategory>
    <uiOrder>2540</uiOrder>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <constructionSkillPrerequisite>10</constructionSkillPrerequisite>
    <resourcesFractionWhenDeconstructed>1</resourcesFractionWhenDeconstructed>
    <researchPrerequisites>
      <li>GravForge</li>
    </researchPrerequisites>
    <costList>
      <Gravcore>2</Gravcore>
      <GravlitePanel>150</GravlitePanel>
      <Plasteel>200</Plasteel>
      <ComponentSpacer>10</ComponentSpacer>
    </costList>
    <terrainAffordanceNeeded>Substructure</terrainAffordanceNeeded>
    <minifiedDef />
    <thingCategories Inherit="false" />
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>1400</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Glower">
        <glowRadius>5</glowRadius>
        <glowColor>(40,50,60,70)</glowColor>
      </li>
      <li Class="CompProperties_GravshipFacility">
        <requiresLOS>false</requiresLOS>
        <maxSimultaneous>3</maxSimultaneous>
        <maxDistance>3.9</maxDistance>
      </li>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>ToolCabinet</li>
          <li>GravEngine</li>
        </linkableFacilities>
      </li>
    </comps>
    <surfaceType>Item</surfaceType>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
    <killedLeavings>
      <ChunkSlagPlasteel_GT>3</ChunkSlagPlasteel_GT>
      <GravlitePanel>30</GravlitePanel>
    </killedLeavings>
    <recipes>
      <li>Make_PlasteelGF</li>
      <li>Make_ComponentIndustrialGF</li>
      <li>Make_ComponentSpacerGF</li>
      <li>Make_GravlitePanelGF</li>
      <li>Make_GravcoreGF</li>
      <li>Copy_AIPersonaCoreGF</li>
    </recipes>
  </ThingDef>

