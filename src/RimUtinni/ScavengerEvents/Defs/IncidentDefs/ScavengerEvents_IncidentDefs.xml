<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- RUT_SCAVENGEREVENTS_BUILD_1, mechanism 1 of 8: Migration.
       Ambient wildlife passage - a small herd of biome-correct animals walks
       across the map and leaves. Not a threat, no manhunter state. Ported
       from MoreIncidents.MOIncidentWorker_Migration; see the mechanism
       reference in infrastructure/state/items/RUT_SCAVENGEREVENTS_BUILD_1.md
       for what was kept and what was cleaned up (the donor's animal-count
       formula was an opaque integer-division artifact, not load-bearing
       design; replaced with a plain Rand.RangeInclusive(2,8)). -->
  <IncidentDef>
    <defName>RUT_Migration</defName>
    <label>migration</label>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <category>Misc</category>
    <workerClass>RimMandrake.Utinni.ScavengerEvents.IncidentWorker_Migration</workerClass>
    <baseChance>5</baseChance>
    <minRefireDays>7</minRefireDays>
    <earliestDay>1</earliestDay>
  </IncidentDef>

  <!-- RUT_SCAVENGEREVENTS_BUILD_1, mechanism 2 of 8: SurvivalPod.
       Unconditional drop pod: Hyperweave survival outfit + 4 survival meals
       + an autopistol. Ported from MoreIncidents.MOIncidentWorker_SurvivalPod. -->
  <IncidentDef>
    <defName>RUT_SurvivalPod</defName>
    <label>survival pod</label>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <category>Misc</category>
    <workerClass>RimMandrake.Utinni.ScavengerEvents.IncidentWorker_SurvivalPod</workerClass>
    <baseChance>1.5</baseChance>
    <minRefireDays>25</minRefireDays>
  </IncidentDef>

  <!-- RUT_SCAVENGEREVENTS_BUILD_1, mechanism 7 of 8: Thanksgiving.
       Food-relief-when-hungry, gated on a non-hostile faction existing and
       the colony's edible nutrition running low. Ported from
       MoreIncidents.MOIncidentWorker_Thanksgiving. -->
  <IncidentDef>
    <defName>RUT_Thanksgiving</defName>
    <label>clan tribute</label>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <category>Misc</category>
    <workerClass>RimMandrake.Utinni.ScavengerEvents.IncidentWorker_Thanksgiving</workerClass>
    <baseChance>2</baseChance>
    <minRefireDays>40</minRefireDays>
  </IncidentDef>

  <!-- RUT_SCAVENGEREVENTS_BUILD_1, mechanism 3 of 8: PodCrashTribal
       (item's "spacer rescue"). Unconditional: one downed Villager-kind pawn
       from a random non-hostile faction, dropped in a pod, quest-hook
       letter. Ported from MoreIncidents.MOIncidentWorker_PodCrashTribal
       (donor defName MO_PodCrash). -->
  <IncidentDef>
    <defName>RUT_PodCrash</defName>
    <label>pod crash</label>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <category>Misc</category>
    <workerClass>RimMandrake.Utinni.ScavengerEvents.IncidentWorker_PodCrashTribal</workerClass>
    <baseChance>2</baseChance>
    <minRefireDays>20</minRefireDays>
  </IncidentDef>

  <!-- RUT_SCAVENGEREVENTS_BUILD_1, mechanism 5 of 8: Insect (item's "desert
       fauna"). Genuinely hostile: manhunter Spelopedes + Megaspiders, count
       scaled off colonist count. category ThreatBig, not Misc: matches the
       donor's own IncidentDef, which is the one mechanism here NOT filed
       under Misc. Ported from MoreIncidents.MOIncidentWorker_Insect. -->
  <IncidentDef>
    <defName>RUT_Insects</defName>
    <label>insect</label>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <category>ThreatBig</category>
    <workerClass>RimMandrake.Utinni.ScavengerEvents.IncidentWorker_Insect</workerClass>
    <baseChance>1.5</baseChance>
    <minRefireDays>30</minRefireDays>
    <earliestDay>20</earliestDay>
  </IncidentDef>

  <!-- RUT_SCAVENGEREVENTS_BUILD_1, mechanism 6 of 8: Stroke. category
       DiseaseHuman, pointsScaleable false: matches the donor's own
       IncidentDef. Ported from MoreIncidents.MOIncidentWorker_Stroke. -->
  <IncidentDef>
    <defName>RUT_Stroke</defName>
    <label>stroke</label>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <category>DiseaseHuman</category>
    <workerClass>RimMandrake.Utinni.ScavengerEvents.IncidentWorker_Stroke</workerClass>
    <baseChance>1.5</baseChance>
    <minRefireDays>15</minRefireDays>
    <pointsScaleable>false</pointsScaleable>
  </IncidentDef>

</Defs>
