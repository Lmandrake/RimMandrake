<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Same namespace and scenPartClass as upstream's RuthlessPursuingMechanoids.xml, deliberately,
       for save/scenario compatibility — see About.xml for why this REPLACES the original mod rather
       than running alongside it. The defName is NOT upstream's: Rename Phase 2a (aa759446e4) turned
       upstream's RuthlessPursuingMechanoids into RUT_RuthlessPursuingMechanoids. -->
  <ScenPartDef Class="RuthlessPursuingMechanoids.ScenPartDef_RuthlessPursuit">
    <defName>RUT_RuthlessPursuingMechanoids</defName>
    <label>ruthless faction pursuit</label>
    <category>Misc</category>
    <scenPartClass>RuthlessPursuingMechanoids.ScenPart_RuthlessPursuingMechanoids</scenPartClass>
    <!-- Owner-editable survey-shadow list (EMPIRE_PURSUIT_SURVEY_SHADOW_1): a settled map on
         one of these biomes gets its raid (and warning) delay multiplied instead of the
         global raidDelayHours. Add more biomes here freely; no code change needed. Each li names
         the mod that brings its biome (MayRequire; RM_Abyss ships composed in mandrake.rm.biomes),
         so a list without it loads the rest instead of logging a cross-reference error. -->
    <surveyShadowMultiplier>4</surveyShadowMultiplier>
    <surveyShadowBiomes>
      <li MayRequire="mandrake.rut.patches">RUT_Abyss</li> <!-- the campaign def the world's tiles carry -->
      <li MayRequire="mandrake.rm.biomes">RM_Abyss</li> <!-- the free-tier biome -->
    </surveyShadowBiomes>
  </ScenPartDef>
</Defs>
