<Project Sdk="Microsoft.NET.Sdk">

  <!--
    EMPIRE_ESCALATION_LADDER_1: offline selftest of the ladder's pure arithmetic
    (EmpireLadderMath.cs, compiled in directly from one directory up). That file uses only
    System, so no RimWorld assemblies are referenced here. The mod build (EmpirePursuit.csproj)
    lists its Compile items explicitly, so this subfolder never leaks into the mod DLL.

    Run via the wrapper:  python3 src/RimMandrake/Utils/selftest_empire_ladder.py
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>EmpireLadder.SelfTest</AssemblyName>
    <RootNamespace>RuthlessPursuingMechanoids.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DebugType>none</DebugType>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\EmpireLadderMath.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
