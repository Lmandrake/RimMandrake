      <xpath>/Defs/ThingDef[defName="RM_Olumetha"]/statBases/BoneAmount</xpath>
      <value><BoneAmount>125</BoneAmount></value>
    </match>
    <nomatch Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="RM_Olumetha"]/statBases</xpath>
