<?xml version="1.0" encoding="utf-8"?>
<!-- MegafaunaYield_OwnedPorts.xml - hand-written companion to the GENERATED MegafaunaYield.xml
     (gen_megafauna_yield.py; do not hand-edit that one). ABYSS_SHEET_DONOR_PORT_1, 2026-10-06.

     The Abyss's donor creatures were ported to owned RM_ defs, so the generated ops that tune
     the donors no longer reach the animals the Abyss casts. These ops carry the SAME values
     (bodySize^2 rule: base = unit x bodySize) onto the ports, numbers copied from the generated
     file's donor ops. PROVISIONAL until the generator is re-run on a def dump that holds the
     ports; once it emits ops for them, delete this file (the generated ops would set the same
     values). BoneAmount assumes the bones stat mod the generated file already assumes. -->
<Patch>

  <!-- RM_Olumetha (port of AA_NightRam), bodySize 2.5 -->
  <!-- RM_Olumetha MeatAmount 350 -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="RM_Olumetha"]/statBases/MeatAmount</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/ThingDef[defName="RM_Olumetha"]/statBases/MeatAmount</xpath>
      <value><MeatAmount>350</MeatAmount></value>
    </match>
    <nomatch Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="RM_Olumetha"]/statBases</xpath>
      <match Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="RM_Olumetha"]/statBases</xpath>
        <value><MeatAmount>350</MeatAmount></value>
      </match>
    </nomatch>
  </Operation>
  <!-- RM_Olumetha BoneAmount 125 -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="RM_Olumetha"]/statBases/BoneAmount</xpath>
