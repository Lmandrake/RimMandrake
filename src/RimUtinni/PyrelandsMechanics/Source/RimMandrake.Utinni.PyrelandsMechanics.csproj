<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RimWorld 1.6 runs Unity/Mono against a .NET Framework 4.7.2 profile, so
    the mod DLL must target net472. Same shape as
    src/RimUtinni/ScavengerEvents/Source/RimMandrake.Utinni.ScavengerEvents.csproj,
    copy that file's own header if this one goes stale.

    Build (dotnet is WINDOWS-NATIVE, cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\Rimworld\src\RimUtinni\PyrelandsMechanics\Source\RimMandrake.Utinni.PyrelandsMechanics.csproj -c Release

    Output lands in ../Assemblies/, which is where RimWorld looks.

    PYRELANDS_RM_MOD_BUILD_1 §6 absorbed the franchise-free two-thirds of this
    kit (burn-line, fire clock, fire-hawk, furnace-beast thermal circuit —
    along with its one Harmony rule, Patch_FurnaceBeastHeatImmunity) into
    mandrake.rm.pyrelands. What remains here names the Deep Desert Tribes and
    needs no Harmony at all — every mechanism left rides a vanilla extension
    point (ThinkNode_JobGiver, LordJob, IncidentWorker). This assembly now
    REFERENCES mandrake.rm.pyrelands's own FireEcologyHook.dll (built first;
    both mods load in the same AppDomain, and this one already loadAfter's
    it) for MapComponent_BurnLine, PyrelandsTuning and PyrelandsFireRiteHook.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrake.Utinni.PyrelandsMechanics</AssemblyName>
    <RootNamespace>RimMandrake.Utinni.PyrelandsMechanics</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="PyrelandsMechanicsDefOf.cs" />
    <Compile Include="PyrelandsFactions.cs" />
    <Compile Include="PyrelandsFireRite.cs" />
    <Compile Include="LordJob_RUT_FireRite.cs" />
    <Compile Include="JobGiver_RUT_HarvestScorchFruit.cs" />
    <Compile Include="IncidentWorker_FlameHarvest.cs" />
    <Compile Include="IncidentWorker_FireRaid.cs" />
    <Compile Include="PyrelandsMechanicsMod.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- mandrake.rm.pyrelands — MapComponent_BurnLine, PyrelandsTuning,
         PyrelandsFireRiteHook. Not copied local: both DLLs sit in the game's
         Mods folder side by side and the runtime resolves it there; a copy
         here would be a second, driftable binary. -->
    <Reference Include="FireEcologyHook">
      <HintPath>..\..\..\RimMandrake\Pyrelands\Assemblies\FireEcologyHook.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
