<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RimWorld 1.6 runs Unity/Mono against a .NET Framework 4.7.2 profile, so
    the mod DLL must target net472. Same shape as
    src/RimUtinni/ScavengerEvents/Source/RimMandrake.Utinni.ScavengerEvents.csproj,
    copy that file's own header if this one goes stale.

    Build (dotnet is WINDOWS-NATIVE, cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\Rimworld\src\RimUtinni\PyrelandsMechanics\Source\RimMandrake.Utinni.PyrelandsMechanics.csproj -c Release

    Output lands in ../Assemblies/, which is where RimWorld looks.

    Harmony is referenced for exactly ONE rule and must stay that way:
    Patch_FurnaceBeastHeatImmunity (FURNACEBEAST_THERMAL_CYCLE_1). Every other
    mechanism in this assembly rides a vanilla extension point (MapComponent,
    ThingComp, ThinkNode_JobGiver, JobDriver, IncidentWorker) and needs no
    patch. 0Harmony is <Private>false</Private>: the game and brrainz.harmony
    supply it at runtime, it must never be copied into ..\Assemblies\.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrake.Utinni.PyrelandsMechanics</AssemblyName>
    <RootNamespace>RimMandrake.Utinni.PyrelandsMechanics</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <!-- Same path shape as src/RimMandrake/Pyrelands/Source/FireEcologyHook.csproj;
       copy that file's if this one goes stale. -->
  <PropertyGroup Condition="'$(HarmonyDll)' == ''">
    <HarmonyDll>C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\2009463077\Current\Assemblies\0Harmony.dll</HarmonyDll>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="PyrelandsTuning.cs" />
    <Compile Include="PyrelandsMechanicsDefOf.cs" />
    <Compile Include="PyrelandsFactions.cs" />
    <Compile Include="MapComponent_BurnLine.cs" />
    <Compile Include="PyrelandsFireFront.cs" />
    <Compile Include="CompFireHawkSpread.cs" />
    <Compile Include="JobGiver_RUT_FireHawkCarryEmber.cs" />
    <Compile Include="JobDriver_RUT_FireHawkCarryEmber.cs" />
    <Compile Include="CompFurnaceWarmthAura.cs" />
    <Compile Include="CompFurnaceBedIgnition.cs" />
    <Compile Include="CompFurnaceThermalCharge.cs" />
    <Compile Include="JobGiver_RUT_FurnaceThermalCycle.cs" />
    <Compile Include="Patch_FurnaceBeastHeatImmunity.cs" />
    <Compile Include="IncidentWorker_FlameHarvest.cs" />
    <Compile Include="IncidentWorker_FireRaid.cs" />
    <Compile Include="PyrelandsMechanicsMod.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
