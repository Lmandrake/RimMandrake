<?xml version="1.0" encoding="utf-8"?>
<!--
  GRAVSHIP_ACOUSTIC_SCANNER_1: the acoustic-scanner payload for every Utinni-tier BiomeDef except the deleted CrackedLands twin (its own file). A twin carried its RimMandrake twin's targets.
  Owner decision by question card 2026-10-06: the payload goes on EVERY biome of ours.

  Pure XML, FindMod-guarded on "RimMandrake: Acoustic Scanner", so the extension class
  is only named while its assembly is active. Every def is a defName STRING resolved
  at pulse time (GetNamedSilentFail), so a target naming another mod's def just hears
  nothing when that mod is absent. Each target is drawn from this biome's own content;
  the biome's sitting may re-author it. The reading is always banded by the scanner.
-->
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>RimMandrake: Acoustic Scanner</li>
    </mods>
    <match Class="PatchOperationAddModExtension">
      <xpath>/Defs/BiomeDef[defName="RUT_Jawa_BackgroundWater"]</xpath>
      <value>
        <li Class="RimMandrake.AcousticScanner.RM_AcousticPayloadExtension">
          <quietText>Sediment-heavy water all the way down. Rock, and nothing in it.</quietText>
          <targets>
            <li>
              <label>void in the bed</label>
              <reading>The echo drops into a hollow under the sediment.</reading>
              <color>(0.6, 0.6, 0.9)</color>
              <hiddenCaves>true</hiddenCaves>
              <cellSampleStride>4</cellSampleStride>
            </li>
          </targets>
        </li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>RimMandrake: Acoustic Scanner</li>
    </mods>
    <match Class="PatchOperationAddModExtension">
      <xpath>/Defs/BiomeDef[defName="RUT_Umbra"]</xpath>
      <value>
        <li Class="RimMandrake.AcousticScanner.RM_AcousticPayloadExtension">
          <quietText>Black ice and pooled propane. The pulse comes back clean and cold.</quietText>
          <targets>
            <li>
              <label>something that never stops burning</label>
              <reading>A heat in the ice that the cold never touches, moving slowly.</reading>
              <color>(1, 0.45, 0.3)</color>
              <weight>3</weight>
              <pawnRaces>
                <li>RUT_BurnerAscendant</li>
              </pawnRaces>
            </li>
            <li>
              <label>void in the ice</label>
              <reading>The echo falls into a pocket under the frozen flats.</reading>
              <color>(0.6, 0.6, 0.9)</color>
              <hiddenCaves>true</hiddenCaves>
              <cellSampleStride>4</cellSampleStride>
            </li>
          </targets>
        </li>
      </value>
    </match>
  </Operation>
</Patch>
