<?xml version="1.0" encoding="utf-8"?>
<!--
  Warscar_Rename.xml — owner's Warscar sheet, ruled 2026-10-05 (warscar_sheet_2026-10-05.decisions.json).
  Label / description only; no defName, stat or art field is touched.
    AA_Helixien           "Rename to Bileworm" — text written from the picked render (gapall_AA_Helixien_v1).
                          The only patch naming this def (owner: "Bileworm everywhere"), so it holds for every biome.
  RG_Rimclaw and SW_Juggernautbeetles had their "redo description" blocks here too; WARSCAR_SHEET_DONOR_PORT_1
  (2026-10-06) ported both to RM_Rimclaw / RM_JuggernautBeetle (mandrake.rm.warscar), which carry those descriptions
  themselves, and no biome casts either donor any more, so the blocks were deleted. AA_Helixien's block stays: the
  donor is still cast in the Miasma, Cauldron, Slime and Contagion (the Warscar casts the port, RM_Bileworm).
-->
<Patch>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="AA_Helixien"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="AA_Helixien"]/label</xpath>
          <value><label>bileworm</label></value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="AA_Helixien"]/description</xpath>
          <value><description>A vast, slow slug in mottled grey-green skin, ribbed along its pale underside and pitted with a row of dark breathing holes down each flank, its two eye-stalks nodding over a cluster of yellow, finger-like mouthparts. It breathes out a foul, corrosive gas wherever it goes: mostly harmless to the living, but murder on the dead. Anything it passes near rots in minutes into a black, reeking fluid, which the bileworm then happily drinks.</description></value>
        </li>
      </operations>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/PawnKindDef[defName="AA_Helixien"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/PawnKindDef[defName="AA_Helixien"]/label</xpath>
      <value><label>bileworm</label></value>
    </match>
  </Operation>

</Patch>
