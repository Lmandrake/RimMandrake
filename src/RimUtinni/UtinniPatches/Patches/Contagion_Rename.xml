<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Contagion_Rename.xml            RimUtinni Patches — new file 2026-09-24

       NONCANON_BEAST_RENAME_1 batch 3c — the Contagion. Owner ruled batch 3
       applied 2026-09-24 (design/Jawa/worldbuilding/biomes/
       noncanon_beast_names_crags_nightside_contagion_slime.md). Fifteen donor
       ThingDef+PawnKindDef pairs (13 Alpha Animals AA_, 1 Alpha Genes AG_, 1
       Vanilla Genetics Expanded GR_) get a label/description patch, on the
       PatchOperationConditional gate pattern of RotSpecies_NamesAndSizes.xml.

       LABEL ONLY on the identity; no defName, stat, or art field is touched.

       Not applied here: AA_Razorjack ("skezzar" drafted in the source doc's
       3c table) — the doc's own Appendix B flags an UNRESOLVED conflict with
       the owner's separate card pick "sytheclaw" already live on the
       Pyrelands port RUT_Sytheclaw (RAZORJACK_IDENTITY_RESTYLE_1, 2026-09-14),
       and forward-references "batch 5 flag 1" as where it is meant to be
       settled. Left untouched pending that resolution.
       Not drafted: AA_Swarmling (chittik, ruled in the Rot pass, already
       applied) and AA_Eyeling (ikee, owner ruling 2026-08-15, already
       applied). -->

  <!-- ============== AA_RedGoo -> ghaaz ============== -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="AA_RedGoo"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="AA_RedGoo"]/label</xpath>
          <value><label>ghaaz</label></value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="AA_RedGoo"]/description</xpath>
          <value><description>The body of the valley itself — a spreading, bubbling mass that creeps to the rain line, feeding on the dead and the strange vegetation alike, and budding off new pieces of itself every time the Bloom comes round.</description></value>
        </li>
      </operations>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/PawnKindDef[defName="AA_RedGoo"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/PawnKindDef[defName="AA_RedGoo"]/label</xpath>
      <value><label>ghaaz</label></value>
    </match>
  </Operation>

