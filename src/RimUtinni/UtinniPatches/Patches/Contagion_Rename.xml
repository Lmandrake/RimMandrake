<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Contagion_Rename.xml            RimUtinni Patches — new file 2026-09-24

       NONCANON_BEAST_RENAME_1 batch 3c — the Contagion. Owner ruled batch 3
       applied 2026-09-24 (design/Jawa/worldbuilding/biomes/
       noncanon_beast_names_crags_nightside_contagion_slime.md). The batch
       renamed fifteen donor ThingDef+PawnKindDef pairs; one is left. The 13
       Alpha Animals AA_ pairs went with sarg.alphaanimals (ea19b46b37) and
       AG_OcularSlinger -> pellorax with Alpha Genes (c5731f7247): their defs
       no longer load, so their ops were deleted.

       What remains: Vanilla Genetics Expanded's GR_Fleshling -> pibbo
       (a live def, VGE 1.6 Races_Animal_Failures.xml), label and description
       only, on the PatchOperationConditional gate pattern of
       RotSpecies_NamesAndSizes.xml. No defName, stat or art field is touched. -->

  <!-- ============== GR_Fleshling -> pibbo ============== -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="GR_Fleshling"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="GR_Fleshling"]/label</xpath>
          <value><label>pibbo</label></value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="GR_Fleshling"]/description</xpath>
          <value><description>Something in the valley went wrong to make this one, and it knows it — a small, struggling thing that fights for every breath. It means no harm to anyone. Given real attention, a pibbo can find the strength to make it another day; left alone, it usually doesn't.</description></value>
        </li>
      </operations>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/PawnKindDef[defName="GR_Fleshling"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/PawnKindDef[defName="GR_Fleshling"]/label</xpath>
      <value><label>pibbo</label></value>
    </match>
  </Operation>

</Patch>
