<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  WildAnimals_LongShade.xml                 UtinniPatches — new file 2026-09-24
  ============================================================================

  Puts the campaign's Long Shade fauna roster onto RM_LongShade, adding onto the
  two native creatures src/RimMandrake/LongShade/Defs/BiomeDefs/RM_LongShade.xml
  ships on its own (JOE_Landopus, JOE_Cephalope — non-Star-Wars donor fauna,
  already this mod's own def, kept there per §7 Q9). The Star Wars cast reaches
  RM_LongShade HERE, never in the LongShade mod itself — same shape as
  WildAnimals_Greentide.xml / WildAnimals_Pyrelands.xml.

  WHY THIS FILE HAS TO EXIST. §7 Q11 (owner, 2026-09-22): "RimMandrake should not
  name star wars ever." So RM_LongShade may not carry this cast, and at Phase B of
  design/RimMandrake/biome_mod_architecture.md the RUT_Desert def that currently
  carries it dies and RM_LongShade takes the tiles. Without this patch in place by
  then, the Long Shade would lose 51 of its 53 wild-animal rows on the live world.

  🔑 SOURCE OF TRUTH (AT AUTHORING, 2026-09-24): every weight below is a verbatim
  copy of Defs/BiomeDefs/RUT_Desert.xml's own wildAnimals block (frozen the same
  pass, LONGSHADE_RM_MOD_BUILD_1 step 3/4) minus its two native rows — nothing
  rescaled. 51 rows summing to 15.1 (MEASURED via python xml.etree against this
  file as written). RUT_Desert.xml stays at 53 rows / 15.1+1.0 (its own two
  native rows, 0.5 each, included) by design (frozen). Any doc still quoting 53
  rows for RM_LongShade's own wildAnimals node is reading the twin, not this mod.

  Unlike WildAnimals_Greentide.xml, there is NO PatchOperationReplace here:
  RM_LongShade does not ship a Core-only placeholder roster to swap out — its two
  native rows are the biome's real content and stay put. This file is Add-only,
  same shape as WildAnimals_Pyrelands.xml's second block.

  🔴 OUR DEFS, NOT THE DONOR'S. Owner ruling 2026-09-19, verbatim: "They should be
  using OUR creatures, not the donor references. The donor references, if any,
  should never be used again." Every row below is already this repo's own RSW_
  port (RUT_Desert.xml's own inline comments confirm each one 1:1 by commonality
  against the pre-port donor/bare name in rosters/desert.json — see
  LONGSHADE_RM_MOD_BUILD_1's own MEASURED STATE section 5) — nothing here casts a
  donor's bare defName.

  ============================================================================
  KNOWN OPEN QUESTIONS — carried from the item, not resolved here
  ============================================================================

  1. roster row AA_SandLion (0.5, "sand burrower swimmer") has no wired def row —
     UNCERTAIN whether superseded by JOE_Cephalope's near-identical description or
     genuinely dropped. Not invented here.
  2. def rows RSW_Stoneback (0.5) and RSW_TruffleMole (0.5) are wired here (per the
     frozen twin) but absent from rosters/desert.json — the roster file is stale
     by these 2 additions, not this file.
  3. ✅ FIXED 2026-09-25 (SW_FAUNA_NEVER_IN_RM_TIER_1 audit): wildPlants' 6 RSW_-tier
     rows were found sitting inline on RM_LongShade in violation of the ruling —
     the claim this section used to make ("same still-open gap every other
     RimMandrake biome mod carries, no patch route exists anywhere") was false;
     every other biome mod's wildPlants list was already clean, and the fix is
     just an Add op in THIS file (Op 2, below), same file the wildAnimals rows
     already use. foragedFood (RSW_RawHubbaGourd) and the 5 pack-animal rows
     stay inline on RM_LongShade — those fields are out of this item's scope
     (wildAnimals/wildPlants/fishTypes only) and unaddressed here.

  ⚠️ A patch that matches nothing logs nothing — PatchOperationConditional returns
  true on no match, and an unmatched PatchOperationAdd is silent. A clean
  validate_patch.py run is NOT proof a row landed. 🔴 UNVERIFIED AGAINST A LOAD:
  authored offline, no def dump and no game here (LONGSHADE_RM_MOD_BUILD_1 step 5
  is Desktop-only and owed). Confirm all 51 rows from a post-load def dump on the
  Desktop before believing this file works.
-->
<Patch>

  <!-- The Star Wars cast, all 51 as OUR OWN RSW_ defs (never the donor's bare
       names). Weights verbatim from RUT_Desert.xml. Add-only: RM_LongShade's own
       wildAnimals node already exists (JOE_Landopus/JOE_Cephalope), guarded on
       the target node rather than on a donor so this is a silent no-op if
       mandrake.rm.longshade is ever not loaded. -->
  <Operation Class="PatchOperationConditional" MayRequire="mandrake.rsw.swbestiary">
    <xpath>Defs/BiomeDef[defName="RM_LongShade"]/wildAnimals</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/BiomeDef[defName="RM_LongShade"]/wildAnimals</xpath>
      <value>
        <RSW_Bantha>0.8</RSW_Bantha>
        <RSW_Kreetle>1.3</RSW_Kreetle>
        <RSW_Jellypot>0.7</RSW_Jellypot>
        <RSW_Shyrack>0.6</RSW_Shyrack>
        <RSW_Gorg>0.4</RSW_Gorg>
        <RSW_Gutkurr>0.4</RSW_Gutkurr>
        <RSW_Jamel>0.4</RSW_Jamel>
        <RSW_LongtailGorg>0.4</RSW_LongtailGorg>
        <RSW_Ronto>0.4</RSW_Ronto>
        <RSW_Sketto>0.8</RSW_Sketto>
        <RSW_Wraid>0.4</RSW_Wraid>
        <RSW_WraidAlpha>0.15</RSW_WraidAlpha>
        <RSW_Ossik>0.4</RSW_Ossik>
        <RSW_Eopie>0.3</RSW_Eopie>
        <RSW_Hrumph>0.3</RSW_Hrumph>
        <RSW_IridonianReek>0.3</RSW_IridonianReek>
        <RSW_Jimvu>0.3</RSW_Jimvu>
        <RSW_Kwi>0.3</RSW_Kwi>
        <RSW_Skalder>0.3</RSW_Skalder>
        <RSW_Uvak>0.3</RSW_Uvak>
        <RSW_Varactyl>0.3</RSW_Varactyl>
        <RSW_Zeer>0.3</RSW_Zeer>
        <RSW_Falumpaset>0.2</RSW_Falumpaset>
        <RSW_FrilledGorg>0.2</RSW_FrilledGorg>
        <RSW_Jakobeast>0.2</RSW_Jakobeast>
        <RSW_Nerf>0.2</RSW_Nerf>
        <RSW_Nuna>0.2</RSW_Nuna>
        <RSW_Shaak>0.2</RSW_Shaak>
        <RSW_TeeMuss>0.2</RSW_TeeMuss>
        <RSW_Worrt>0.2</RSW_Worrt>
        <RSW_Kudda>0.2</RSW_Kudda>
        <RSW_Bolotaur>0.1</RSW_Bolotaur>
        <RSW_Clodhopper>0.1</RSW_Clodhopper>
        <RSW_FeralGrazer>0.1</RSW_FeralGrazer>
        <RSW_Gizka>0.1</RSW_Gizka>
        <RSW_Iriaz>0.1</RSW_Iriaz>
        <RSW_Krykna>0.1</RSW_Krykna>
        <RSW_Runyip>0.1</RSW_Runyip>
        <RSW_Voorpak>0.05</RSW_Voorpak>
        <RSW_Thurra>0.05</RSW_Thurra>
        <RSW_Vosska>0.05</RSW_Vosska>
        <RSW_Khorrak>0.035</RSW_Khorrak>
        <RSW_Ommok>0.025</RSW_Ommok>
        <RSW_Ulgga>0.015</RSW_Ulgga>
        <RSW_Horax>0.01</RSW_Horax>
        <RSW_ShadeWhale>0.015</RSW_ShadeWhale>
        <RSW_Bokka>0.5</RSW_Bokka>
        <RSW_TruffleMole>0.5</RSW_TruffleMole>
        <RSW_GreatDevourer>0.5</RSW_GreatDevourer>
        <RSW_Groundrunner>0.5</RSW_Groundrunner>
        <RSW_MatureFleshbeast>0.5</RSW_MatureFleshbeast>
      </value>
    </match>
  </Operation>

  <!-- SW_FAUNA_NEVER_IN_RM_TIER_1, 2026-09-25: the 6 RSW_-tier wildPlants rows
       moved out of RM_LongShade.xml (see that file's own header for what was
       found and why). Add-only: RM_LongShade's own wildPlants node already
       exists (RM_Leachmoss/RM_Vorrel/RM_Venomvine), same shape as Op 1 above.
       Weights unchanged from what RM_LongShade.xml carried inline. -->
  <Operation Class="PatchOperationConditional" MayRequire="mandrake.rsw.swbestiary">
    <xpath>Defs/BiomeDef[defName="RM_LongShade"]/wildPlants</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/BiomeDef[defName="RM_LongShade"]/wildPlants</xpath>
      <value>
        <RSW_Ultracactus>0.8</RSW_Ultracactus>
        <RSW_SurraGrass>0.6</RSW_SurraGrass>
        <RSW_Plant_Chakroot_Wild>0.3</RSW_Plant_Chakroot_Wild>
        <RSW_Plant_HubbaGourd_Wild>0.2</RSW_Plant_HubbaGourd_Wild>
        <RSW_VellaraBloom>0.12</RSW_VellaraBloom>
        <RSW_DommoTree>0.06</RSW_DommoTree>
      </value>
    </match>
  </Operation>

</Patch>
