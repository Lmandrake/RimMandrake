<?xml version="1.0" encoding="utf-8"?>
<!--
  RUT_Miasma_PollinationGate.xml       UtinniPatches - MIASMA_KARRATHIL_POLLINATION_GATE_1

  Wires the new, generic RM_PollinationGateExtension (src/RimMandrake/
  EnvironmentalHazards/Source/RM_PollinationGateExtension.cs, and its
  Harmony choke point RM_Patch_PollinationGate.cs) onto the two Miasma
  mangal ThingDefs the design doc names: "the disease vector and the
  mangals' only pollinator, one and the same swarm. You cannot have the
  trees without the fever" (the_miasma.md §4; miasma_fauna_roster_
  2026-09-23.md §3 row 5, RUT_Karrathil.xml). Desktop engine check (this
  item, this pass): see RM_PollinationGateExtension.cs's own header for the
  full citation — no Plant-level comp hook exists for reproduction; the
  real choke point is WildPlantSpawner.CalculatePlantsWhichCanGrowAt, the
  same private method RM_LeachmossWildSpawnGatePatch (a sibling in this
  same assembly) already proves patchable.

  Targets: AB_MangroveTree and AB_ParasiticMangrove — the Alpha Biomes
  donor ThingDefs RUT_Miasma.xml (the frozen campaign twin, still carrying
  the live save's painted tiles) still carries in its own <wildPlants> —
  PLUS, 🔴 added by MIASMA_FAUNA_FLOOR_ROSTER_1 once MIASMA_FLORA_ROSTER_1
  landed RM_Thessamor/RM_Quennath as real ThingDefs (exactly the follow-on
  this header used to ask for): RM_Thessamor and RM_Quennath, RM_Miasma's
  own replacements for AB_MangroveTree/AB_ParasiticMangrove respectively
  (miasma_flora_roster_2026-09-23.md §3). Both sets of operations stay —
  the AB_ pair for the frozen twin's still-live wildPlants, the RM_ pair for
  the franchise-free mod's own flora — so the fever bargain is real on
  both. AB_MangrovePalm is deliberately left out: its own roster successor
  (RM_Ilbareen) is recast around dying in place as a salt-line gauge, a
  different mechanism from the flowering bargain this item covers.

  PatchOperationAddModExtension (a real vanilla class, confirmed against
  the live 1.6 decompile — Verse/PatchOperationAddModExtension.cs) rather
  than a raw PatchOperationAdd onto ".../modExtensions": it creates the
  <modExtensions> list on the target if one is not already there, so this
  patch cannot silently no-op against a donor def that happens to carry no
  extensions of its own yet. Wrapped in PatchOperationConditional per this
  repo's own "a patch that matches nothing logs nothing" posture — if Alpha
  Biomes is absent, both operations simply no-op, no error. MayRequire on
  the added <li> itself: the Class lives in mandrake.rm.environmentalhazards,
  and an unresolvable Class on a <li> discards the WHOLE host def silently
  (this repo's own named trap) if that mod is ever missing from a load
  order that somehow still has Alpha Biomes.
-->
<Patch>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="AB_MangroveTree"]</xpath>
    <match Class="PatchOperationAddModExtension">
      <xpath>/Defs/ThingDef[defName="AB_MangroveTree"]</xpath>
      <value>
        <li Class="RimMandrake.EnvironmentalHazards.RM_PollinationGateExtension" MayRequire="mandrake.rm.environmentalhazards">
          <pollinatorRace>RUT_Karrathil</pollinatorRace>
        </li>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="AB_ParasiticMangrove"]</xpath>
    <match Class="PatchOperationAddModExtension">
      <xpath>/Defs/ThingDef[defName="AB_ParasiticMangrove"]</xpath>
      <value>
        <li Class="RimMandrake.EnvironmentalHazards.RM_PollinationGateExtension" MayRequire="mandrake.rm.environmentalhazards">
          <pollinatorRace>RUT_Karrathil</pollinatorRace>
        </li>
      </value>
    </match>
  </Operation>

  <!-- MIASMA_FAUNA_FLOOR_ROSTER_1: RM_Miasma's own flora roster replacements
       for the two AB_ mangals above. RM_Thessamor/RM_Quennath only exist
       once mandrake.rm.miasma is active, so this is conditional the same
       way. -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="RM_Thessamor"]</xpath>
    <match Class="PatchOperationAddModExtension">
      <xpath>/Defs/ThingDef[defName="RM_Thessamor"]</xpath>
      <value>
        <li Class="RimMandrake.EnvironmentalHazards.RM_PollinationGateExtension" MayRequire="mandrake.rm.environmentalhazards">
          <pollinatorRace>RUT_Karrathil</pollinatorRace>
        </li>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="RM_Quennath"]</xpath>
    <match Class="PatchOperationAddModExtension">
      <xpath>/Defs/ThingDef[defName="RM_Quennath"]</xpath>
      <value>
        <li Class="RimMandrake.EnvironmentalHazards.RM_PollinationGateExtension" MayRequire="mandrake.rm.environmentalhazards">
          <pollinatorRace>RUT_Karrathil</pollinatorRace>
        </li>
      </value>
    </match>
  </Operation>

</Patch>
