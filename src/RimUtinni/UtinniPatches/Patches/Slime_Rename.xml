        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="AA_AcanthamoebaGiganteaSmall"]/description</xpath>
          <value><description>A young oomb, freshly split from its parent and not yet grown into its full spiked bulk.</description></value>
        </li>
      </operations>
