    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="AA_Mime"]/label</xpath>
          <value><label>hennul</label></value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="AA_Mime"]/description</xpath>
          <value><description>A quiet, unsettling thing that wears a human face and a human voice well enough to live among a colony for months before anyone notices. A hennul eats what the colony eats, right up until the food runs short — then it stops pretending.</description></value>
        </li>
      </operations>
