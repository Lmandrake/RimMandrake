          <value><label>greater oomb</label></value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="AA_AcanthamoebaGiganteaHuge"]/description</xpath>
          <value><description>An oomb swollen past its usual size, still growing on whatever refuse it can find before it finally splits.</description></value>
        </li>
      </operations>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/PawnKindDef[defName="AA_AcanthamoebaGiganteaHuge"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/PawnKindDef[defName="AA_AcanthamoebaGiganteaHuge"]/label</xpath>
      <value><label>greater oomb</label></value>
    </match>
  </Operation>

  <!-- ============== AA_AcanthamoebaGiganteaSmall -> lesser oomb (Scarlands) ============== -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="AA_AcanthamoebaGiganteaSmall"]</xpath>
