<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Slime_Rename.xml            RimUtinni Patches — new file 2026-09-24

       NONCANON_BEAST_RENAME_1 batch 3d — the Slime. Owner ruled batch 3
       applied 2026-09-24 (design/Jawa/worldbuilding/biomes/
       noncanon_beast_names_crags_nightside_contagion_slime.md). Eleven donor
       ThingDef+PawnKindDef pairs (9 Alpha Animals AA_, 2 Vanilla Genetics
       Expanded GR_) get a label/description patch, on the
       PatchOperationConditional gate pattern of RotSpecies_NamesAndSizes.xml.
       Slime-law monosyllables (owner ruling 2026-09-24, rule 8) on the
       gel-bodied residents: wuum, oomb (+greater/lesser), bezzul... no,
       bezzul is a snail not a slime — see the source doc's rule 8 note.

       LABEL ONLY on the identity; no defName, stat, or art field is touched.

       Not drafted here: AA_Helixien (vulloth, Contagion batch — a slug, not
       a slime, rule 8 does not take it). RM_Titanoslime — the doc records
       this only as an OFFER ("if he wants it... otherwise it stands"), not a
       ruling; left untouched pending his word. -->

  <!-- ============== AA_GreenGoo -> wuum ============== -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="AA_GreenGoo"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="AA_GreenGoo"]/label</xpath>
          <value><label>wuum</label></value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="AA_GreenGoo"]/description</xpath>
          <value><description>Countless small bodies that all belong to one vast, spreading thing — every wuum you see is a cell of the same superorganism, working toward the same single purpose: grow, and keep growing.</description></value>
        </li>
      </operations>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/PawnKindDef[defName="AA_GreenGoo"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/PawnKindDef[defName="AA_GreenGoo"]/label</xpath>
      <value><label>wuum</label></value>
    </match>
  </Operation>

  <!-- ============== AA_AcanthamoebaGiganteaLarge -> oomb ============== -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="AA_AcanthamoebaGiganteaLarge"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="AA_AcanthamoebaGiganteaLarge"]/label</xpath>
          <value><label>oomb</label></value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="AA_AcanthamoebaGiganteaLarge"]/description</xpath>
          <value><description>A great spiked lobe of a cell, genetically built to eat whatever non-metal trash is put in front of it. An oomb that feeds enough swells and splits clean in two.</description></value>
        </li>
      </operations>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/PawnKindDef[defName="AA_AcanthamoebaGiganteaLarge"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/PawnKindDef[defName="AA_AcanthamoebaGiganteaLarge"]/label</xpath>
      <value><label>oomb</label></value>
    </match>
  </Operation>

  <!-- ============== AA_AcanthamoebaGiganteaHuge -> greater oomb ============== -->
