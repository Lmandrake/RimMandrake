    <xpath>/Defs/ThingDef[defName="AA_DecayDrake"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="AA_DecayDrake"]/label</xpath>
          <value><label>mubbaro</label></value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="AA_DecayDrake"]/description</xpath>
          <value><description>A winged, flightless lizard that breathes out a slow ferment over any greenery nearby and then eats the result — getting thoroughly, contentedly drunk on it, which its four livers were apparently built to handle. Hard to tame, but a mubbaro that accepts you, especially with a drink in hand, makes a fine hunting companion.</description></value>
        </li>
      </operations>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/PawnKindDef[defName="AA_DecayDrake"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/PawnKindDef[defName="AA_DecayDrake"]/label</xpath>
      <value><label>mubbaro</label></value>
    </match>
  </Operation>

