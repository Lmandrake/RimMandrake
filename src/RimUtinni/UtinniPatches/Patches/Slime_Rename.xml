    <xpath>/Defs/ThingDef[defName="GR_Manbear"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="GR_Manbear"]/label</xpath>
          <value><label>yollum</label></value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="GR_Manbear"]/description</xpath>
          <value><description>A round, waist-high shape that talks like a person and looks, at a glance, almost cuddly. It is useless in a fight and knows it, but a yollum can talk a prisoner into joining the colony faster than anyone would expect from something built like a stuffed toy.</description></value>
