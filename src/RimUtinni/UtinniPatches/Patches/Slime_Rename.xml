  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/PawnKindDef[defName="AA_AcanthamoebaGiganteaSmall"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/PawnKindDef[defName="AA_AcanthamoebaGiganteaSmall"]/label</xpath>
