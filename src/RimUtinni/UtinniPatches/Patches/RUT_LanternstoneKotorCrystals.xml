<?xml version="1.0" encoding="utf-8" ?>
<!-- CAVERNS_PARITY_BUILD_1 (2026-09-18): the Armoury's generated injector
     (Absorbed_Kotorweapons_BiomesCaverns_Patch_KotORCrystalFormationInjector.xml)
     appends these two KotOR crystal groups onto the DONOR's
     BMT_CrystalsGenerator, which the Lantern Deeps no longer consume. That
     file is GENERATED and gated on the donor, so it is not edited; this
     hand-authored twin injects the SAME two groups (weights, radii and
     coverage verbatim from it) onto our own RUT_LanternstoneFormations, so
     KotOR crystals keep appearing in the Deeps now and after the donor cut.
     Gated on the Armoury by mod NAME (PatchOperationFindMod matches names,
     not packageIds) because the KOTOR_* defs live there.

     LANTERNDEEPS_RM_MOD_BUILD_1 (2026-09-25): moved from the LanternDeeps mod
     into this Utinni layer with the mod's other three Star Wars carve-outs
     when RM_LanternDeeps split off as a RimMandrake-tier mod; xpath retargeted
     RUT_LanternstoneFormations -> RM_LanternstoneFormations, the def's new
     name (unchanged content otherwise).

     CANON_MATERIALS_BUILD_1 L6 (2026-10-11): the KOTOR_StygiumCrystal rows are gone from both groups.
     Stygium is trade-only (canon_materials_design_2026-10-09.md section 3.6); the Armoury's
     RSW_StygiumConvert.xml strips the formation's yield and its other genstep rows. -->
<Patch>

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Jawa Armoury Rebalance</li>
    </mods>
    <match Class="PatchOperationAdd">
      <xpath>Defs/GenStepDef[defName="RM_LanternstoneFormations"]/genStep/groups</xpath>
      <order>Append</order>
      <value>
        <li>
          <things>
            <KOTOR_SmallCrystal_red>0.15</KOTOR_SmallCrystal_red>
            <KOTOR_SmallCrystal_orange>0.15</KOTOR_SmallCrystal_orange>
            <KOTOR_SmallCrystal_yellow>0.15</KOTOR_SmallCrystal_yellow>
            <KOTOR_SmallCrystal_green>0.15</KOTOR_SmallCrystal_green>
            <KOTOR_SmallCrystal_blue>0.15</KOTOR_SmallCrystal_blue>
            <KOTOR_SmallCrystal_purple>0.15</KOTOR_SmallCrystal_purple>
            <KOTOR_SmallCrystal_white>0.10</KOTOR_SmallCrystal_white>
            <KOTOR_MediumCrystal_cool>0.1</KOTOR_MediumCrystal_cool>
            <KOTOR_MediumCrystal_soft>0.1</KOTOR_MediumCrystal_soft>
            <KOTOR_MediumCrystal_warm>0.1</KOTOR_MediumCrystal_warm>
            <KOTOR_LargeCrystal_cool>0.0833</KOTOR_LargeCrystal_cool>
            <KOTOR_LargeCrystal_warm>0.0833</KOTOR_LargeCrystal_warm>
          </things>
          <indoorRuin>false</indoorRuin>
          <coveredCellsPer10Cells>0~1</coveredCellsPer10Cells>
          <clusterRectRadius>3~5</clusterRectRadius>
        </li>
        <li>
          <things>
            <KOTOR_SmallCrystal_red>0.05</KOTOR_SmallCrystal_red>
            <KOTOR_SmallCrystal_orange>0.05</KOTOR_SmallCrystal_orange>
            <KOTOR_SmallCrystal_yellow>0.05</KOTOR_SmallCrystal_yellow>
            <KOTOR_SmallCrystal_green>0.05</KOTOR_SmallCrystal_green>
            <KOTOR_SmallCrystal_blue>0.05</KOTOR_SmallCrystal_blue>
            <KOTOR_SmallCrystal_purple>0.05</KOTOR_SmallCrystal_purple>
            <KOTOR_SmallCrystal_white>0.05</KOTOR_SmallCrystal_white>
            <KOTOR_MediumCrystal_cool>0.1</KOTOR_MediumCrystal_cool>
            <KOTOR_MediumCrystal_soft>0.1</KOTOR_MediumCrystal_soft>
            <KOTOR_MediumCrystal_warm>0.1</KOTOR_MediumCrystal_warm>
            <KOTOR_LargeCrystal_cool>0.0833</KOTOR_LargeCrystal_cool>
            <KOTOR_LargeCrystal_warm>0.0833</KOTOR_LargeCrystal_warm>
          </things>
          <indoorRuin>false</indoorRuin>
          <coveredCellsPer10Cells>0~1</coveredCellsPer10Cells>
          <clusterRectRadius>4~5</clusterRectRadius>
        </li>
      </value>
    </match>
  </Operation>

</Patch>
