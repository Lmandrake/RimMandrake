<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Cauldron_Rename.xml            RimUtinni Patches — new file 2026-10-09

       The owner's Cauldron art sheet (Transient/biome_ffar/cauldron_sheet_2026-10-04.decisions.json),
       rows ruled 2026-10-09: three donor creatures get a new name and description written from the art he
       picked (shipped in this mod, Textures/RimUtinni/UtinniPatches/<Name>/, via Patches/ArtFold/). Invented exotic names, not canon IP.
         AM_Dryad_Corruptor  "Recreate name and description from art, but art is good."       -> rhossak
         AM_Dryad_Tumorous   "Regenerate name and description but art is good, a tumorous
                              version of the above creature."                                  -> galled rhossak
         GR_Beetlefleet      "this is a hideous creature now named Garsulix that Hungers ..."  -> garsulix
         AA_Radyak           "Good start, more alien please. Rename and regen description."   -> ossrith
                             (written from the redo render enact_f3decf4d_radyak_v1: bone-white hide,
                             skull-plated face, a ridge of green crystal down the spine; the crystal
                             harvest the donor def ships is kept in the text, since its comp is unchanged)
       LABEL/DESCRIPTION ONLY; no defName, stat or art field is touched. Gate pattern of Contagion_Rename.xml.
       These supersede the unapplied drafts "tessik" / "tumorous tessik" / "skibbex" in
       design/Jawa/worldbuilding/biomes/noncanon_beast_names_poison_miasma_desert_scar_rot_dune_waste_cracked.md. -->

  <!-- RHOSSAK_MIGRATE_ROOTS_TAKE_HOLD (2026-10-19): the Cauldron now spawns our own RM_Rhossak / RM_GalledRhossak (RimMandrake Cauldron,
       Defs/ThingDefs_Races/RM_Rhossak.xml), which carry this text themselves; the four ops below only touch the donor defs
       if Alpha Memes ever loads again, and match nothing otherwise. -->
  <!-- ============== AM_Dryad_Corruptor -> rhossak ============== -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="AM_Dryad_Corruptor"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="AM_Dryad_Corruptor"]/label</xpath>
          <value><label>rhossak</label></value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="AM_Dryad_Corruptor"]/description</xpath>
          <value><description>A stag-shaped animal grown from tightly wound living roots, with branching antlers and split seed-husks exposing wet red seeds along its back. It binds to a nearby twisting thornwood and sprouts new growth where it rests. Three rhossaks standing together long enough can root a new thornwood.</description></value>
        </li>
      </operations>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/PawnKindDef[defName="AM_Dryad_Corruptor"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/PawnKindDef[defName="AM_Dryad_Corruptor"]/label</xpath>
      <value><label>rhossak</label></value>
    </match>
  </Operation>

  <!-- ============== AM_Dryad_Tumorous -> galled rhossak ============== -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="AM_Dryad_Tumorous"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="AM_Dryad_Tumorous"]/label</xpath>
          <value><label>galled rhossak</label></value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="AM_Dryad_Tumorous"]/description</xpath>
          <value><description>A rhossak swollen with pale, fleshy galls beneath hanging moss, even along its legs and antlers. It binds to a twisting thornwood like its healthy kin, but is slower, gentler and carries no seed. It sheds the galls as new ones grow; they make a serviceable meat substitute.</description></value>
        </li>
      </operations>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/PawnKindDef[defName="AM_Dryad_Tumorous"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/PawnKindDef[defName="AM_Dryad_Tumorous"]/label</xpath>
      <value><label>galled rhossak</label></value>
    </match>
  </Operation>

  <!-- ============== GR_Beetlefleet -> garsulix ============== -->
  <!-- The Cauldron now spawns our port RM_Garsulix (RimMandrake Cauldron, 2026-10-18), which carries this text itself;
       these ops only touch the donor def if VGE + Alpha Animals ever load again, and match nothing otherwise. -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="GR_Beetlefleet"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="GR_Beetlefleet"]/label</xpath>
          <value><label>garsulix</label></value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="GR_Beetlefleet"]/description</xpath>
          <value><description>A hideous thing that hungers. A floating, chitinous, insect-like ball of gas: a swollen, veined sac held up by its own lift, plated over the top and hung beneath with hooked legs and a working mouth. It drifts ever closer, slowly but surely, intent on devouring your flesh. Its gas burns; a garsulix that dies close by takes you with it.</description></value>
        </li>
      </operations>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/PawnKindDef[defName="GR_Beetlefleet"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/PawnKindDef[defName="GR_Beetlefleet"]/label</xpath>
      <value><label>garsulix</label></value>
    </match>
  </Operation>

  <!-- ============== AA_Radyak -> ossrith ============== -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="AA_Radyak"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="AA_Radyak"]/label</xpath>
          <value><label>ossrith</label></value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="AA_Radyak"]/description</xpath>
          <value><description>A placid herd grazer with long legs, bone-white armour and a bare skull-like face. Green crystals grow through its spinal plates as it expels metals taken from the Cauldron's vegetation. The crystals can be harvested periodically and refined into uranium at a biofuel refinery.</description></value>
        </li>
      </operations>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/PawnKindDef[defName="AA_Radyak"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/PawnKindDef[defName="AA_Radyak"]/label</xpath>
          <value><label>ossrith</label></value>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/PawnKindDef[defName="AA_Radyak"]/lifeStages/li[1]/label</xpath>
          <match Class="PatchOperationReplace">
            <xpath>/Defs/PawnKindDef[defName="AA_Radyak"]/lifeStages/li[1]/label</xpath>
            <value><label>ossrith calf</label></value>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/PawnKindDef[defName="AA_Radyak"]/lifeStages/li[1]/labelPlural</xpath>
          <match Class="PatchOperationReplace">
            <xpath>/Defs/PawnKindDef[defName="AA_Radyak"]/lifeStages/li[1]/labelPlural</xpath>
            <value><labelPlural>ossrith calves</labelPlural></value>
          </match>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
