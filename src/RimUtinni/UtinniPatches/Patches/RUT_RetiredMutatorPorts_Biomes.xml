        <li>RM_Miasma</li>
        <li>RM_FeverWood</li>
        <li>RM_Greentide</li>
        <li>RM_FloodedCanyon</li>
        <li>RM_WeepingStones</li>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/TileMutatorDef[defName="RM_QuicksandPits"]/biomeWhitelist</xpath>
