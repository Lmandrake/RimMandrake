<?xml version="1.0" encoding="utf-8"?>
<!-- RETIRED_MUTATORS_PORT (owner, 2026-10-19: "Reproduce the mutators into our own code, then proceed with
     deprecation of the donors."). The Utinni layer's half of the ported world-tile mutators: adds to each port's
     biomeWhitelist the Ash'karr RUT_ biomes its tiles actually sit on in the canonical save
     (CANONICAL_ASHKARR_START_2026-09-12.rws, tileBiome grid decoded per mutator tile, MEASURED 2026-10-19), so a
     whitelist never refuses a tile the repaint or the save rename gives it. Ports whose donor had only a blacklist
     need nothing here. Mapping: design/RimMandrake/retired_mutators_port_2026-10-19.md.
     Each op is Conditional on the mutator existing (the RM_/RSW_ mods may be inactive), so a miss logs nothing. -->
<Patch>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/TileMutatorDef[defName="RM_DerelictClusters"]/biomeWhitelist</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/TileMutatorDef[defName="RM_DerelictClusters"]/biomeWhitelist</xpath>
      <value>
        <li>RM_RustCathedral</li>
        <li>RM_Stillsand</li>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/TileMutatorDef[defName="RM_EdibleAirborneMicrofungi"]/biomeWhitelist</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/TileMutatorDef[defName="RM_EdibleAirborneMicrofungi"]/biomeWhitelist</xpath>
      <value>
        <li>RM_TheRot</li>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/TileMutatorDef[defName="RM_MoldyEnvironment"]/biomeWhitelist</xpath>
