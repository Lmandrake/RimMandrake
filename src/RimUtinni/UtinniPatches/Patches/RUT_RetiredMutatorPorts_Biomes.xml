      <value>
        <li>RM_Wastes</li>
        <li>RM_LongShade</li>
        <li>RM_Stillsand</li>
        <li>RM_LeaningScrub</li>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/TileMutatorDef[defName="RSW_WildTattooinePlants"]/biomeWhitelist</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/TileMutatorDef[defName="RSW_WildTattooinePlants"]/biomeWhitelist</xpath>
      <value>
        <li>RM_Stillsand</li>
        <li>RM_LeaningScrub</li>
        <li>RM_LongShade</li>
        <li>RM_Contagion</li>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/TileMutatorDef[defName="RSW_WildGalacticPlants"]/biomeWhitelist</xpath>
