          </match>
        </li>

        <li Class="PatchOperationConditional">
          <xpath>/Defs/BiomeDef[defName="AB_OcularForest"]/preventGenSteps</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/BiomeDef[defName="AB_OcularForest"]</xpath>
            <value><preventGenSteps><li>ScatterShrines</li></preventGenSteps></value>
          </nomatch>
          <match Class="PatchOperationAdd">
            <xpath>/Defs/BiomeDef[defName="AB_OcularForest"]/preventGenSteps</xpath>
            <value><li>ScatterShrines</li></value>
          </match>
        </li>

        <li Class="PatchOperationConditional">
          <xpath>/Defs/BiomeDef[defName="AB_FeraliskInfestedJungle"]/preventGenSteps</xpath>
