          </nomatch>
          <match Class="PatchOperationAdd">
            <xpath>/Defs/BiomeDef[defName="AB_MiasmicMangrove"]/preventGenSteps</xpath>
            <value><li>ScatterShrines</li></value>
          </match>
        </li>

        <li Class="PatchOperationConditional">
          <xpath>/Defs/BiomeDef[defName="AB_RockyCrags"]/preventGenSteps</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/BiomeDef[defName="AB_RockyCrags"]</xpath>
