<?xml version="1.0" encoding="utf-8"?>
<!--
  RaptorShrimp_ArtFold.xml - ART_OVERRIDE_FOLD_ALL_1 (precedent SILOOTH_ART_FOLD_1)

  Art: the RaptorShrimp redraw that the standalone RaptorShrimpArtOverride mod used to paint over sarg.alphaanimals's art at the same path. It now lives in this mod at Textures/RimUtinni/UtinniPatches/RaptorShrimp/ and the donor's texPath is pointed at it below; our own defs that drew the donor path were edited in place.
  The donor's own PawnKindDef texPath is matched by VALUE (any life stage, any graphic slot, and an
  abstract parent if the donor inherits), so every slot the old same-path override reached is
  redirected and nothing else. Conditional: a load without the donor matches nothing and logs nothing.
  Checked offline by src/RimMandrake/Utils/art_fold_check.py (manifest row "RaptorShrimp").
-->
<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/PawnKindDef//texPath[text()="Things/Pawn/Animal/AA_RaptorShrimp/AA_RaptorShrimp"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/PawnKindDef//texPath[text()="Things/Pawn/Animal/AA_RaptorShrimp/AA_RaptorShrimp"]</xpath>
      <value><texPath>RimUtinni/UtinniPatches/RaptorShrimp/AA_RaptorShrimp</texPath></value>
    </match>
  </Operation>
  <!-- Alternate graphics (ALTGAP sweep 2026-10-10): the donor draws these paths via alternateGraphics, which the old same-path override never painted; repointed to the painted set (colour variants of the same animal). -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/PawnKindDef//texPath[text()="Things/Pawn/Animal/AA_RaptorShrimp/AA_RaptorShrimp2"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/PawnKindDef//texPath[text()="Things/Pawn/Animal/AA_RaptorShrimp/AA_RaptorShrimp2"]</xpath>
      <value><texPath>RimUtinni/UtinniPatches/RaptorShrimp/AA_RaptorShrimp</texPath></value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/PawnKindDef//texPath[text()="Things/Pawn/Animal/AA_RaptorShrimp/AA_RaptorShrimp3"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/PawnKindDef//texPath[text()="Things/Pawn/Animal/AA_RaptorShrimp/AA_RaptorShrimp3"]</xpath>
      <value><texPath>RimUtinni/UtinniPatches/RaptorShrimp/AA_RaptorShrimp</texPath></value>
    </match>
  </Operation>
</Patch>
