<?xml version="1.0" encoding="utf-8"?>
<!--
  Beetlefleet_ArtFold.xml - ART_OVERRIDE_FOLD_ALL_1 (precedent SILOOTH_ART_FOLD_1)

  Art: the Beetlefleet redraw that the standalone BeetlefleetArtOverride mod used to paint over vanillaexpanded.vgeneticse's art at the same path. It now lives in this mod at Textures/RimUtinni/UtinniPatches/Beetlefleet/ and the donor's texPath is pointed at it below; our own defs that drew the donor path were edited in place.
  The donor's own PawnKindDef texPath is matched by VALUE (any life stage, any graphic slot, and an
  abstract parent if the donor inherits), so every slot the old same-path override reached is
  redirected and nothing else. Conditional: a load without the donor matches nothing and logs nothing.
  Checked offline by src/RimMandrake/Utils/art_fold_check.py (manifest row "Beetlefleet").
-->
<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/PawnKindDef//texPath[text()="Things/Pawn/Animal/AlphaAnimals/Insectoid/GR_Beetlefleet"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/PawnKindDef//texPath[text()="Things/Pawn/Animal/AlphaAnimals/Insectoid/GR_Beetlefleet"]</xpath>
      <value><texPath>RimUtinni/UtinniPatches/Beetlefleet/GR_Beetlefleet</texPath></value>
    </match>
  </Operation>
</Patch>
