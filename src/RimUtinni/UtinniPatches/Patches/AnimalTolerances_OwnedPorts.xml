<?xml version="1.0" encoding="utf-8"?>
<!-- AnimalTolerances_OwnedPorts.xml - hand-written companion to the GENERATED
     AnimalTolerances_Ashkarr.xml (design/Jawa/fauna/animal_tolerances.py; do not hand-edit that one).
     ABYSS_SHEET_DONOR_PORT_1, 2026-10-06.

     The generated file pins the donors' comfy bands (temperature is a HARD SPAWN GATE). The Abyss
     now casts owned ports, which carry the donor's RAW band (e.g. the moravatha's raw minimum is -10
     where the donor ran at -35.7), so these ops give each port the band its donor actually had in
     the campaign. PROVISIONAL: delete once the generator fits the ports from the cast itself.
     RM_Olumetha / RM_Sesserith: their donors (AA_NightRam / AA_Nightling) carry no op there.
     RM_Lirrith: its donor AA_Murkling's -35..71.1 band is not carried; that pin was fitted while it
     also lived in the Cracked Lands (where the donor still ships), and the port's -35 minimum already
     matches it. -->
<Patch>

  <!-- RM_Aveluthia (port of AA_NightMule): -55..62.3 -->
  <!-- RM_Aveluthia ComfyTemperatureMin -55 -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="RM_Aveluthia"]/statBases/ComfyTemperatureMin</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/ThingDef[defName="RM_Aveluthia"]/statBases/ComfyTemperatureMin</xpath>
      <value><ComfyTemperatureMin>-55</ComfyTemperatureMin></value>
    </match>
    <nomatch Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="RM_Aveluthia"]/statBases</xpath>
      <match Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="RM_Aveluthia"]/statBases</xpath>
        <value><ComfyTemperatureMin>-55</ComfyTemperatureMin></value>
      </match>
    </nomatch>
  </Operation>
  <!-- RM_Aveluthia ComfyTemperatureMax 62.3 -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="RM_Aveluthia"]/statBases/ComfyTemperatureMax</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/ThingDef[defName="RM_Aveluthia"]/statBases/ComfyTemperatureMax</xpath>
      <value><ComfyTemperatureMax>62.3</ComfyTemperatureMax></value>
    </match>
    <nomatch Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="RM_Aveluthia"]/statBases</xpath>
