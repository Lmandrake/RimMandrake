<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  WildAnimals_NightsideIce.xml              UtinniPatches — new file 2026-09-24
  ============================================================================

  Wires the Star Wars canon rows (Q11a, owner ruling 2026-09-22: a genuinely
  canon name is IP and must route through the Utinni campaign patch layer, never
  the franchise-free RimMandrake tier) onto RM_NightsideIce: the cave lemming,
  and (NIGHTSIDEICE_HEAT_DIAL_BUILD_1 row 0, owner card 2026-10-01) the tauntaun
  and the wampa, visitor-dying at 0.03 each. The wampa is our absorbed port
  RSW_Wampa; the tauntaun has no port yet and names the donor's own def.

  Weight (0.03) and MayRequire copied verbatim from the twin's own row,
  RUT_NightsideIce.xml (frozen): RSW_CaveLemming MayRequire="mandrake.rsw.swbestiary"
  0.03. Per NIGHTSIDEICE_RM_MOD_BUILD_1's own MEASURED reading, this row is a
  deliberate 2026-09-21 owner override of ECOSYSTEM_PYRAMID_LAW_1's small/giant
  ratio (a LARGE-bodySize visitor at 0.03, chosen over a compensating 0.003) —
  not a defect to fix here, and not re-litigated by this file.

  ⚠️ A patch that matches nothing logs nothing — PatchOperationConditional
  returns true on no match, and an unmatched PatchOperationAdd is silent. A clean
  validate_patch.py run is NOT proof the row landed. 🔴 UNVERIFIED AGAINST A LOAD
  (step 5 is Desktop-only and OWED) — confirm RSW_CaveLemming actually lands via a
  post-load def dump before believing this file works.
-->
<Patch>

  <Operation Class="PatchOperationConditional" MayRequire="mandrake.rsw.swbestiary">
    <xpath>Defs/BiomeDef[defName="RM_NightsideIce"]/wildAnimals</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/BiomeDef[defName="RM_NightsideIce"]/wildAnimals</xpath>
      <value>
        <RSW_CaveLemming>0.03</RSW_CaveLemming>
        <RSW_Wampa MayRequire="mandrake.rsw.swbestiary">0.03</RSW_Wampa>
      </value>
    </match>
  </Operation>

  <!-- MayRequire on a top-level <Operation> is ignored by the 1.6 engine (PATCH_MAYREQUIRE_GUARD_INERT_1),
       so the donor guard is a FindMod, and the row itself carries MayRequire too. -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Star Wars Animal Collection (Continued)</li>
    </mods>
    <match Class="PatchOperationConditional">
      <xpath>Defs/BiomeDef[defName="RM_NightsideIce"]/wildAnimals</xpath>
      <match Class="PatchOperationAdd">
        <xpath>Defs/BiomeDef[defName="RM_NightsideIce"]/wildAnimals</xpath>
        <value>
          <Tauntaun MayRequire="mlie.starwarsanimalcollection">0.03</Tauntaun>
        </value>
      </match>
    </match>
  </Operation>

</Patch>
