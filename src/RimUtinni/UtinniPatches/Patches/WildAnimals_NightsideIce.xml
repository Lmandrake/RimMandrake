<Patch>

  <Operation Class="PatchOperationConditional" MayRequire="mandrake.rsw.swbestiary">
    <xpath>Defs/BiomeDef[defName="RM_NightsideIce"]/wildAnimals</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/BiomeDef[defName="RM_NightsideIce"]/wildAnimals</xpath>
      <value>
        <RSW_CaveLemming>0.03</RSW_CaveLemming>
      </value>
    </match>
  </Operation>

</Patch>
