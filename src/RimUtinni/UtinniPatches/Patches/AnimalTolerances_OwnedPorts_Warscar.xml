<?xml version="1.0" encoding="utf-8"?>
<!-- AnimalTolerances_OwnedPorts_Warscar.xml - hand-written companion to the GENERATED
     AnimalTolerances_Ashkarr.xml (design/Jawa/fauna/animal_tolerances.py; do not hand-edit that one).
     WARSCAR_SHEET_DONOR_PORT_1, 2026-10-06; same shape as AnimalTolerances_OwnedPorts.xml (the Abyss pass).

     The generated file pins the donors' comfy bands (temperature is a HARD SPAWN GATE). The Warscar now casts
     owned ports, which carry the donor's RAW band, so these ops give each port the band its donor ran at in the
     campaign (the generated file's pinned live values). PROVISIONAL: delete once the generator fits the ports
     from the cast itself. RM_JuggernautBeetle: its donor carries no op there (raw -40..160 stands). -->
<Patch>

  <!-- RM_Bileworm (port of AA_Helixien): -21.1..77.8 -->
  <!-- RM_Bileworm ComfyTemperatureMin -21.1 -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="RM_Bileworm"]/statBases/ComfyTemperatureMin</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/ThingDef[defName="RM_Bileworm"]/statBases/ComfyTemperatureMin</xpath>
      <value><ComfyTemperatureMin>-21.1</ComfyTemperatureMin></value>
    </match>
    <nomatch Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="RM_Bileworm"]/statBases</xpath>
      <match Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="RM_Bileworm"]/statBases</xpath>
        <value><ComfyTemperatureMin>-21.1</ComfyTemperatureMin></value>
      </match>
    </nomatch>
  </Operation>
  <!-- RM_Bileworm ComfyTemperatureMax 77.8 -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="RM_Bileworm"]/statBases/ComfyTemperatureMax</xpath>
