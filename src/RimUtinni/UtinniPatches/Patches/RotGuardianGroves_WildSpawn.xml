<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- ROT_GUARDIAN_GROVES_1 ("guardian groves"). Wild-spawns the three
       defended tea-source mushrooms plus the RUT_FalseFruit lure ring onto
       RUT_TheRot at Prime-like rarity (0.01-0.05, spec's own stated range —
       AB_AgariluxPrime itself sits at 0.01 in this same wildPlants list).

       A NEW, separate patch file per the build brief: other tickets are
       concurrently adding their own wildPlants entries in their own files
       tonight (e.g. RotPaleTree_WildSpawn.xml, ROT_PALE_TREE_1) — RUT_TheRot.xml
       itself is never hand-edited here. PatchOperationAdd APPENDS to the
       existing <wildPlants> node rather than replacing it (unlike
       BiomeFlora_Ashkarr.xml's own PatchOperationConditional+Replace
       precedent, which only fits a full-node handoff): safe to run
       alongside any number of other Add-only wildPlants patches, in any
       load order, since none of them touch each other's entries.

       Gated twice, same double-gate ManyWaters_RiverSteam_Ashkarr.xml and
       RotDecayHarvest_LivingProduce.xml already use in this directory:
       PatchOperationFindMod on RotSporeKit (a Class= naming a type no
       loaded assembly has DISCARDS THE WHOLE ThingDef silently — all four
       plants below carry RimMandrake.CreatureBehaviors.* or
       RimMandrake.EnvironmentalHazards.* Class= references) PLUS MayRequire
       on each injected wildPlants child, matching every other RUT_ entry
       already living in this same wildPlants list (RUT_Dewshrooms etc.) —
       never MayRequire on the <Operation> itself (INERT, measured
       2026-09-17, killed a cold load). -->

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>RimUtinni: Rot Spore Kit</li>
    </mods>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/BiomeDef[defName="RUT_TheRot"]/wildPlants</xpath>
      <value>
        <RUT_AgelessCap MayRequire="mandrake.rut.rotsporekit">0.03</RUT_AgelessCap> <!-- guardian: spore gas -->
        <RUT_RegenerantVeil MayRequire="mandrake.rut.rotsporekit">0.03</RUT_RegenerantVeil> <!-- guardian: network alarm -->
        <RUT_EuphoricCrown MayRequire="mandrake.rut.rotsporekit">0.02</RUT_EuphoricCrown> <!-- guardian: ringed by false fruit, below -->
        <RUT_FalseFruit MayRequire="mandrake.rut.rotsporekit">0.05</RUT_FalseFruit> <!-- the lure ring itself -->
      </value>
    </match>
  </Operation>
</Patch>
