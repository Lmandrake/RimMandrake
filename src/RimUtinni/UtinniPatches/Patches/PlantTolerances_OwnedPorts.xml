<!-- PlantTolerances_OwnedPorts.xml - hand-written companion to the GENERATED PlantTolerances_Ashkarr.xml
     (design/Jawa/mods/plant_tolerances.py; do not hand-edit that one). ABYSS_SHEET_DONOR_PORT_1, 2026-10-06.

     The Abyss's donor plants were ported to owned RM_ defs that carry no growth-temperature fields
     (PlantBase defaults), so the generated refit no longer reaches what the Abyss grows. These ops
     carry each donor's four refitted fields onto its port (all four move together: Plant growth is
     InverseLerp(min, minOptimal, temp)). PROVISIONAL: delete once the generator fits the ports itself.
     NOT carried: RM_GlowGlobe (AG_Gamma) and RM_PaddleVine (AG_Septimum). Their donor ops were fitted
     to a hot biome (home 26.9..70.8), not the Abyss, so copying them would stop both growing in the
     Abyss; that refit is owed by the generator. -->
<Patch>

  <!-- RM_GiantGlowGlobe (port of AB_GiantGamma): -34.7 / -25.1 / 32.4 / 58 -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="RM_GiantGlowGlobe"]/plant</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/ThingDef[defName="RM_GiantGlowGlobe"]/plant/minGrowthTemperature</xpath>
          <match Class="PatchOperationReplace">
            <xpath>/Defs/ThingDef[defName="RM_GiantGlowGlobe"]/plant/minGrowthTemperature</xpath>
            <value><minGrowthTemperature>-34.7</minGrowthTemperature></value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/ThingDef[defName="RM_GiantGlowGlobe"]/plant</xpath>
            <value><minGrowthTemperature>-34.7</minGrowthTemperature></value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/ThingDef[defName="RM_GiantGlowGlobe"]/plant/minOptimalGrowthTemperature</xpath>
          <match Class="PatchOperationReplace">
            <xpath>/Defs/ThingDef[defName="RM_GiantGlowGlobe"]/plant/minOptimalGrowthTemperature</xpath>
            <value><minOptimalGrowthTemperature>-25.1</minOptimalGrowthTemperature></value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/ThingDef[defName="RM_GiantGlowGlobe"]/plant</xpath>
            <value><minOptimalGrowthTemperature>-25.1</minOptimalGrowthTemperature></value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/ThingDef[defName="RM_GiantGlowGlobe"]/plant/maxOptimalGrowthTemperature</xpath>
          <match Class="PatchOperationReplace">
            <xpath>/Defs/ThingDef[defName="RM_GiantGlowGlobe"]/plant/maxOptimalGrowthTemperature</xpath>
            <value><maxOptimalGrowthTemperature>32.4</maxOptimalGrowthTemperature></value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/ThingDef[defName="RM_GiantGlowGlobe"]/plant</xpath>
            <value><maxOptimalGrowthTemperature>32.4</maxOptimalGrowthTemperature></value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/ThingDef[defName="RM_GiantGlowGlobe"]/plant/maxGrowthTemperature</xpath>
          <match Class="PatchOperationReplace">
            <xpath>/Defs/ThingDef[defName="RM_GiantGlowGlobe"]/plant/maxGrowthTemperature</xpath>
            <value><maxGrowthTemperature>58</maxGrowthTemperature></value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/ThingDef[defName="RM_GiantGlowGlobe"]/plant</xpath>
            <value><maxGrowthTemperature>58</maxGrowthTemperature></value>
          </nomatch>
        </li>
      </operations>
    </match>
  </Operation>

