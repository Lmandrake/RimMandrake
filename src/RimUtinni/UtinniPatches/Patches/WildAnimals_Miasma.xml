<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  WildAnimals_Miasma.xml                    UtinniPatches - new file 2026-09-25
  ============================================================================
  MIASMA_RM_MOD_BUILD_1 (Phase A). Wires the 17 genuine Star Wars wildAnimals
  rows the frozen RUT_Miasma.xml still carries inline onto the new standalone
  RM_Miasma def instead, per the Q11a naming-tier ruling (invented exotic
  names stay in the franchise-free RM_ tier; genuine canon IP routes through
  this Utinni patch layer). Shape copied from this same folder's own
  WildAnimals_Pyrelands.xml precedent.

  Every defName and commonality weight below is copied verbatim from
  src/RimUtinni/UtinniPatches/Defs/BiomeDefs/RUT_Miasma.xml's own <wildAnimals>
  (frozen, unchanged) - not re-derived or rescaled here. Two groups, split by
  their real source mod so each PatchOperationConditional/Add block gates on
  the mod that actually owns the defNames it adds - a patch gated on the
  wrong mod is a silent no-op waiting to happen.

  🔴 MLIE_ABSORPTION_BIOME_WIRING_1 (2026-09-25): the 7 rows below all already
  have our own RSW_ ports too (each with both a ThingDef and a PawnKindDef) —
  retargeted to mandrake.rsw.swbestiary, so this file no longer casts any
  bare mlie.starwarsanimalcollection defName. Former donor rows, now RSW_:
    RSW_Runyip      0.5   muck-forager
    RSW_Shiro       0.4   arthropod-floor
    RSW_Anooba      0.3   scavenger
    RSW_Grank       0.3   channel-predator
    RSW_Whisperbird 0.3   flier
    RSW_Vornskyr    0.15  strange
    RSW_Zakkeg      0.05  big-wanderer

  mandrake.rsw.swbestiary (this repo's own Star Wars ports), 7 further rows —
  all juveniles of a genuine CANON parent (mee/faa/laa scalefish, pale
  yobshrimp, opee sea killer):
    RSW_PodWorm          0.5   large grazer (bodySize 4, not a predator)
    RSW_CrestedDragon    0.4   channel-predator
    RSW_MeeJuv           0.4   nursery, juvenile-locked (MIASMA_NURSERY_KINDS_1)
    RSW_FaaJuv           0.3   nursery, juvenile-locked
    RSW_LaaJuv           0.3   nursery, juvenile-locked
    RSW_YobshrimpJuv     0.3   nursery, juvenile-locked
    RSW_OpeeSeaKillerJuv 0.05  nursery-guard, juvenile-locked

  🔴 SEA_BEASTS_TIER_RULING_1 (2026-09-25): RSW_RustNipperJuv and
  RSW_SiltLampreyJuv were removed from this list — their parents (rust
  nipper, silt lamprey) are two of the roster's 11 INVENTED sea beasts
  (verified against Wookieepedia's search API: no canon hit), so gating
  their juveniles on mandrake.rsw.swbestiary left the franchise-free Miasma
  without two of its seven nursery juveniles. Both now ship inline in
  RM_Miasma.xml's own wildAnimals as `RM_RustNipperJuv`/`RM_SiltLampreyJuv`
  (RM_SeaBeasts_Invented.xml, mandrake.rm.terminalbiomes), at the same
  0.25 commonality, MayRequire-gated on that mod instead since the parent
  adults live there.

  Miasma sheet 2026-10-08: RSW_AaroxisDendoria removed — owner moved it to the
  RimMandrake tier as RM_Liliana, cast inline in RM_Miasma.xml.

  LEFT OUT (roster eviction, not carried into either mod - rosters/
  the_miasma.json's own evictions[]): RSW_Kreetle (-> AridShrubland),
  Yobshrimp (-> RUT_TwilightSea), RSW_Gembug (-> the_lantern_deeps),
  AA_BloodShrimp (-> AB_OcularForest), AA_Plasmorph (-> PoisonForest).
  ============================================================================
-->
<Patch>

  <!-- PATCH_MAYREQUIRE_GUARD_INERT_1: the comma MayRequire above is ignored
       by vanilla on a top-level <Operation> and was dropped rather than
       fixed. Real coverage: the outer <xpath> below targets RM_Miasma
       itself, a def mandrake.rm.miasma owns, so with that mod absent the
       test matches nothing and this Add never runs. mandrake.rsw.swbestiary
       (owner of several of the species named below) is CONFIRMED active in
       the canonical/live mod list (MEASURED against ModsConfig.xml,
       2026-09-27) - a hard dependency for now, not re-verified per-species. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/BiomeDef[defName="RM_Miasma"]/wildAnimals</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/BiomeDef[defName="RM_Miasma"]/wildAnimals</xpath>
      <value>
        <RSW_Runyip>0.5</RSW_Runyip>
        <RSW_Shiro>0.4</RSW_Shiro>
        <RSW_Anooba>0.3</RSW_Anooba>
        <RSW_Grank>0.3</RSW_Grank>
        <RSW_Whisperbird>0.3</RSW_Whisperbird>
        <RSW_Vornskyr>0.15</RSW_Vornskyr>
        <RSW_Zakkeg>0.05</RSW_Zakkeg>
        <RSW_PodWorm>0.5</RSW_PodWorm>
        <RSW_CrestedDragon>0.4</RSW_CrestedDragon>
        <RSW_MeeJuv>0.4</RSW_MeeJuv>
        <RSW_FaaJuv>0.3</RSW_FaaJuv>
        <RSW_LaaJuv>0.3</RSW_LaaJuv>
        <RSW_YobshrimpJuv>0.3</RSW_YobshrimpJuv>
        <RSW_OpeeSeaKillerJuv>0.05</RSW_OpeeSeaKillerJuv>
        <!-- MIASMA_ROUND2_IMPORTS_1: owner-ruled round-2 imports (rosters/the_miasma.json, commonality 0.5 each).
             RSW_Blarth is also faction stock (dual-listed); the faction-stock half is not wired here. -->
        <RSW_Blarth>0.5</RSW_Blarth>
        <RSW_Blixus>0.5</RSW_Blixus>
        <RSW_Bogwing>0.5</RSW_Bogwing>
        <RSW_MarshHaunt>0.5</RSW_MarshHaunt>
      </value>
    </match>
  </Operation>

</Patch>
