  <!-- Core's four orbital trader kinds name TradersGuild as their faction (MayRequire Odyssey), so with Odyssey every
       bulk-goods, combat-supplier, exotic and pirate-merchant ship arrives "from the Space Exchange", and
       IncidentWorker_OrbitalTraderArrival.GetFaction picks the instance with no hidden or defeated test. Removing the
       element gives the pre-Odyssey behaviour: a factionless ship (CanSpawn returns true when trader.faction is null),
       and StockGenerator_Techprints with a null faction offers any techprint, so no techprint source is lost. -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/TraderKindDef[defName="Orbital_BulkGoods"]/faction</xpath>
    <match Class="PatchOperationRemove">
      <xpath>/Defs/TraderKindDef[defName="Orbital_BulkGoods"]/faction</xpath>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/TraderKindDef[defName="Orbital_CombatSupplier"]/faction</xpath>
    <match Class="PatchOperationRemove">
      <xpath>/Defs/TraderKindDef[defName="Orbital_CombatSupplier"]/faction</xpath>
    </match>
