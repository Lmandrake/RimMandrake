<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  RotPaleTree_WildSpawn.xml   UtinniPatches - new file 2026-09-17
  ============================================================================
  ROT_PALE_TREE_1 (design/Jawa/worldbuilding/biomes/kits/rot_kit_spec.md §M8,
  ticket 8, owner card 4). Adds a rare `RUT_PaleTree` entry to `RUT_TheRot`'s
  `wildPlants` WITHOUT editing `RUT_TheRot.xml` itself (another agent holds that
  file this pass) — a separate patch appending one node.

  🔴 wildPlants is a LoadDataFromXmlCustom field: the node NAME is the plant
  defName and its VALUE is the commonality, same trap noted in
  BiomeFlora_Ashkarr.xml. This uses PatchOperationAdd with a plain named child
  node (the confirmed-working append pattern already in this repo, e.g.
  Absorbed_VESucculents_BiomesPatch.xml) — never a bare `<li>` under
  `wildPlants`, which would discard the WHOLE BiomeDef silently.

  Royalty-dependent content: `RUT_PaleTree` (RotSporeKit) is itself
  `MayRequire="Ludeon.RimWorld.Royalty"`-gated, so this whole Operation sits
  inside `PatchOperationFindMod` for Royalty too — without Royalty the tree def
  never loads, and an unwrapped wildPlants entry naming a nonexistent defName is
  a silent no-op that reads as success rather than a real gate. Per the standing
  law (owner, 2026-09-17): gating uses `PatchOperationFindMod` or `MayRequire` on
  the injected node itself — NEVER `MayRequire` on a Patch `<Operation>` (INERT,
  measured, killed a cold load).
-->
<Patch>

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Royalty</li>
    </mods>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/BiomeDef[defName="RUT_TheRot"]/wildPlants</xpath>
      <value>
        <RUT_PaleTree>0.01</RUT_PaleTree> <!-- the pale tree - rare, a door ajar -->
      </value>
    </match>
  </Operation>

</Patch>
