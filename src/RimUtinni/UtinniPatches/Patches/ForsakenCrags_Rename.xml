<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- ForsakenCrags_Rename.xml            RimUtinni Patches — new file 2026-09-24

       NONCANON_BEAST_RENAME_1 batch 3a — Forsaken Crags. Owner ruled batch 3
       applied 2026-09-24 (design/Jawa/worldbuilding/biomes/
       noncanon_beast_names_crags_nightside_contagion_slime.md). Fourteen donor
       ThingDef+PawnKindDef pairs (13 Alpha Animals AA_, 1 Vanilla Genetics
       Expanded GR_) get a label/description patch, following the
       PatchOperationConditional gate pattern of RotSpecies_NamesAndSizes.xml:
       each block is gated on the ThingDef's own xpath existing, so an absent
       donor mod makes the block no-op silently — no MayRequire needed.

       LABEL ONLY on the identity; no defName, stat, or art field is touched.
       Not drafted here: AA_DuskRat (owner ruled the name IS the joke, kept),
       AA_SandProwler (already port-named RSW_Vosska "vosska"). -->

  <!-- ============== AA_Nightling -> vrakk ============== -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="AA_Nightling"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="AA_Nightling"]/label</xpath>
          <value><label>vrakk</label></value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="AA_Nightling"]/description</xpath>
          <value><description>A sleek nocturnal hunter, crowned with rows of quills it can throw to bring down prey many times its own size. A vrakk's jaws finish what the quills start. It never hunts by day.</description></value>
        </li>
      </operations>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/PawnKindDef[defName="AA_Nightling"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/PawnKindDef[defName="AA_Nightling"]/label</xpath>
          <value><label>vrakk</label></value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/PawnKindDef[defName="AA_Nightling"]/lifeStages/li[1]/label</xpath>
          <value><label>vrakk cub</label></value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/PawnKindDef[defName="AA_Nightling"]/lifeStages/li[1]/labelPlural</xpath>
          <value><labelPlural>vrakk puppies</labelPlural></value>
        </li>
      </operations>
    </match>
  </Operation>

