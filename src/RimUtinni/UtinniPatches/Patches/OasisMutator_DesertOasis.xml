<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  OasisMutator_DesertOasis.xml          RimUtinni Patches · added 2026-09-08
  ============================================================================
  OASIS_MUTATOR_PATCH_1. Vanilla/Odyssey TileMutatorDef Oasis ships with

      <biomeWhitelist>
        <li>Desert</li>
        <li>ExtremeDesert</li>
      </biomeWhitelist>

  (verified via RimSage get_def_details, Ludeon Odyssey Defs/Odyssey/TileMutators)
  — it does NOT list zylle.MoreVanillaBiomes' ZBiome_DesertOasis, which is our
  Ash'karr oasis biome (renamed/repatched by BiomeNames_Ashkarr.xml,
  BiomeFlora_Ashkarr.xml, BiomeCast_Ashkarr.xml, SWDesertWeather_Attach.xml).
  w9_run.py (src/RimMandrake/Utils/w9_run.py, search "Oasis") already assumes
  this whitelist add is needed and reads back live tile mutator counts to
  prove it landed — this patch is the other half of that check.

  Three cleanups the donor def (zylle.MoreVanillaBiomes,
  Defs/BiomeDefs/ZBiome_DesertOasis.xml, read directly off disk from the
  Workshop item since it isn't in this repo) still carries wrong for an
  Ash'karr desert biome:

    1. baseWeatherCommonalities still has SnowGentle(4) / SnowHard(4) — a
       tidally-locked desert world (JawaWorld_BiomeMix.xml) never snows.
    2. foragedFood=RawAgave was CHECKED, not repointed: RawAgave is a Core
       ThingDef (Data/Core/Defs/ThingDefs_Items/Items_Resource_RawPlant.xml),
       always present regardless of mod list — it resolves fine and is left
       alone. (Plant_Agave, the plant that used to justify it, was dropped
       from this biome's wildPlants by BiomeFlora_Ashkarr.xml, but foraging
       doesn't require the source plant to be in wildPlants, so this is
       thematic drift, not a broken cross-reference — no fix filed for it.)
    3. additionalWildPlants is NOT a BiomeDef field — donor ZBiome_DesertOasis
       has none. It lives on TileMutatorDef Oasis itself (vanilla):
       Plant_TreePalm/Plant_RatPalm/Plant_Grass/Plant_GrayGrass/Plant_Reeds,
       all real vanilla plants, not donor placeholders. The only RUT_-prefixed
       plant in the repo, RUT_SweetlineTree
       (src/RimUtinni/AshkarrFlora/Defs/ThingDefs_Plants/RUT_AshkarrFlora_Plants.xml),
       is explicitly documented as one-per-landmark, NOT random wildPlants
       scatter — using it here would contradict that design note, so it is
       deliberately NOT added. Instead this adds two plants already curated
       into this biome's own wildPlants roster by BiomeFlora_Ashkarr.xml
       (TreePalma, VEE_Plant_DatePalm) so the mutator's bonus flora matches
       Ash'karr's oasis roster instead of vanilla's generic set.

  SAFETY: every op is PatchOperationConditional on the target node (or
  target-node-minus-existing-entry) so a missing DLC/mod or an already-applied
  entry yields a silent no-op, never a red error.
  ============================================================================
-->
<Patch>

  <!-- ================= 1. WHITELIST our oasis biome ================= -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/TileMutatorDef[defName="Oasis"]/biomeWhitelist[not(li="ZBiome_DesertOasis")]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/TileMutatorDef[defName="Oasis"]/biomeWhitelist</xpath>
      <value>
        <li MayRequire="zylle.MoreVanillaBiomes">ZBiome_DesertOasis</li>
      </value>
    </match>
  </Operation>

  <!-- ================= 2. STRIP donor snow weathers ================= -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/BiomeDef[defName="ZBiome_DesertOasis"]/baseWeatherCommonalities/SnowGentle</xpath>
    <match Class="PatchOperationRemove">
      <xpath>/Defs/BiomeDef[defName="ZBiome_DesertOasis"]/baseWeatherCommonalities/SnowGentle</xpath>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/BiomeDef[defName="ZBiome_DesertOasis"]/baseWeatherCommonalities/SnowHard</xpath>
    <match Class="PatchOperationRemove">
      <xpath>/Defs/BiomeDef[defName="ZBiome_DesertOasis"]/baseWeatherCommonalities/SnowHard</xpath>
    </match>
  </Operation>

  <!-- ========== 3. Oasis bonus flora: NO Earth palms for our roster ========== -->
  <!-- WEEPINGSTONES_OASIS_MUTATOR_FLORA_1: the 2026-09-08 op that ADDED TreePalma 3 / VEE_Plant_DatePalm 2 to
       Oasis.additionalWildPlants is removed (it put date palms in every oasis, our Weeping Stones included).
       Weeping Stones tiles instead get native blade flora via RM_OasisFloraExtension (RM worker swap). -->

  <!-- ========== 4. Weeping Stones campaign twin ========== -->
  <!-- FindMod matches the exact About <name>; Weeping Stones ships folded inside the composed mod 'RimMandrake: Baroque Biomes', so that is the name that is active. RUT_WeepingStones is FROZEN (def file says do not edit), so its
       whitelist entry and the flora extension are patched in from here. The extension class lives in
       mandrake.rm.weepingstones: without that mod the class is unknown and would discard the def, hence the guard.
       The worker swap itself (Oasis.workerClass) is the RM mod's patch RM_OasisMutatorFlora.xml. Weights copied
       from RM_WeepingStones (INVENTED, mirror vanilla 5/4/6/5). -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>RimMandrake: Baroque Biomes</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/TileMutatorDef[defName="Oasis"]/biomeWhitelist[not(li="RUT_WeepingStones")]</xpath>
          <match Class="PatchOperationAdd">
            <xpath>/Defs/TileMutatorDef[defName="Oasis"]/biomeWhitelist</xpath>
            <value>
              <li>RUT_WeepingStones</li>
            </value>
          </match>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/BiomeDef[defName="RUT_WeepingStones"]/modExtensions[not(li[@Class="RimMandrake.WeepingStones.RM_OasisFloraExtension"])]</xpath>
          <match Class="PatchOperationAdd">
            <xpath>/Defs/BiomeDef[defName="RUT_WeepingStones"]/modExtensions</xpath>
            <value>
              <li Class="RimMandrake.WeepingStones.RM_OasisFloraExtension">
                <stripDefNames>
                  <li>Plant_TreePalm</li>
                  <li>Plant_RatPalm</li>
                  <li>Plant_Grass</li>
                  <li>Plant_GrayGrass</li>
                  <li>TreePalma</li>
                  <li>VEE_Plant_DatePalm</li>
                </stripDefNames>
                <plants>
                  <RM_Dewblade>6</RM_Dewblade>
                  <RM_Bladderquill>4</RM_Bladderquill>
                  <RM_Steamfrond>3</RM_Steamfrond>
                  <RM_Dripfringe>1</RM_Dripfringe>
                </plants>
              </li>
            </value>
          </match>
        </li>
      </operations>
    </match>
  </Operation>

</Patch>
