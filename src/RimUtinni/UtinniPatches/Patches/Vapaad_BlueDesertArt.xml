<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!--
    Vapaad, the Blue Desert's canon row (WildAnimals_BlueDesert.xml), drawn as Blue Desert
    hydrocarbon life: owner's pick B (render bluedesert_Vapaad_v2) on the Blue Desert art
    sheet 2026-10-04 — "This needs to be made into hydrocarbon-based resolution please."
    Our sprites live at Things/Pawn/Animal/RUT_Vapaad/ (a path the donor does not use).
    Body graphic only, plus the canon description (Wookieepedia Vaapad/Legends, owner 2026-10-05); desiccated stays on donor art. Guarded with PatchOperationFindMod —
    MayRequire on an <Operation> is ignored by 1.6.
  -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Star Wars Animal Collection (Continued)</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>Defs/PawnKindDef[defName="Vapaad"]/lifeStages/li[1]/bodyGraphicData/texPath</xpath>
          <value><texPath>Things/Pawn/Animal/RUT_Vapaad/RUT_Vapaad</texPath></value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/PawnKindDef[defName="Vapaad"]/lifeStages/li[2]/bodyGraphicData/texPath</xpath>
          <value><texPath>Things/Pawn/Animal/RUT_Vapaad/RUT_Vapaad</texPath></value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/PawnKindDef[defName="Vapaad"]/lifeStages/li[3]/bodyGraphicData/texPath</xpath>
          <value><texPath>Things/Pawn/Animal/RUT_Vapaad/RUT_Vapaad</texPath></value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="Vapaad"]/description</xpath>
          <value><description>A squat, brown, ball-bodied predator from the energy-world Sarapin and its moons, with two yellow eyes and a mass of whip-like tentacles, seven at the least and as many as twenty-three in the largest specimen on record. It kills by lashing its prey so fast that the tentacles are only a blur to the naked eye, and no one can say how many it carries until it is dead.</description></value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
