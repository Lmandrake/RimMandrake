<?xml version="1.0" encoding="utf-8"?>
<Patch>

<!--
    BetterInfestations_SilenceOwnEvents.xml                      UtinniPatches
    ============================================================================
    Owner ruling 2026-10-10 (RETIREMENT WAVE 1, WAVE1_BETTER_INFESTATIONS_SILENCE_OWN_EVENTS):
    Better Infestations stays loaded, but its two storyteller threats never fire.
    BI_SwarmingHorde (baseChance 70, ThreatBig) and BI_InsectRaid (baseChance 7.4,
    ThreatBig) are zeroed. Same mechanism as Infestation_PlanetwideBan.xml:
    baseChance 0 is the repo's established "the incident never fires again".

    Neither def sets baseChanceWithRoyalty (default -1), so the engine reads
    baseChance whichever DLCs are active; zeroing baseChance alone is enough.
    BI_WorldInfestation is NOT touched (not named by the ruling).

    PatchOperationFindMod matches the mod's <name> (packageId zal.betterinfestations,
    already in UtinniPatches' loadAfter).
-->

  <Operation Class="PatchOperationFindMod">
    <mods><li>Better Infestations (Continued)</li></mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/IncidentDef[defName="BI_SwarmingHorde"]/baseChance</xpath>
          <value><baseChance>0</baseChance></value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/IncidentDef[defName="BI_InsectRaid"]/baseChance</xpath>
          <value><baseChance>0</baseChance></value>
        </li>
      </operations>
    </match>
  </Operation>

</Patch>
