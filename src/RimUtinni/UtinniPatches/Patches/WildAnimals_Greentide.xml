<?xml version="1.0" encoding="utf-8"?>
<!--
  WildAnimals_Greentide.xml          GREENTIDE_FREE_ROSTER_OWNED_1

  The free RM_Greentide owns its whole animal list and its yearning fruit
  (mandrake.rm.greentide). This file only ADDS the canon and donor rows on top,
  each gated by PatchOperationFindMod. A top-level Operation MayRequire is
  ignored by the 1.6 engine (PATCH_MAYREQUIRE_GUARD_INERT_1), so never use one.

  The canopy swinger is the free RM_CanopySwinger now. The dianoga stays out:
  its slot was filled by two new terrors, the Illisk and the Vurrak
  (GREENTIDE_TERROR_REPLACEMENT_1, owner card 2026-09-23), built in the free
  tier. Shorthand-dictionary form throughout (`<RSW_Gizka>1.0</RSW_Gizka>`),
  the only form BiomeAnimalRecord reads. A patch that matches nothing logs
  nothing: confirm rows from a post-load def dump, not from a clean validate.
-->
<Patch>

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>mandrake.rsw.swbestiary</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <Operation Class="PatchOperationConditional">
          <xpath>Defs/BiomeDef[defName="RM_Greentide"]/wildAnimals</xpath>
          <match Class="PatchOperationAdd">
            <xpath>Defs/BiomeDef[defName="RM_Greentide"]/wildAnimals</xpath>
            <value>
              <RSW_Gizka>1.0</RSW_Gizka>
              <RSW_Clodhopper>0.7</RSW_Clodhopper>
              <RSW_Whisperbird>0.7</RSW_Whisperbird>
              <RSW_Worrt>0.7</RSW_Worrt>
              <RSW_Shiro>0.5</RSW_Shiro>
              <RSW_ShiroTrap>0.5</RSW_ShiroTrap>
              <RSW_Diggerpede>0.4</RSW_Diggerpede>
              <RSW_Klorslug>0.4</RSW_Klorslug>
              <RSW_Mott>0.4</RSW_Mott>
              <RSW_Nuna>0.4</RSW_Nuna>
              <RSW_Convor>0.3</RSW_Convor>
              <RSW_Falumpaset>0.3</RSW_Falumpaset>
              <RSW_Gelagrub>0.3</RSW_Gelagrub>
              <RSW_Kinrath>0.3</RSW_Kinrath>
              <RSW_Fambaa>0.25</RSW_Fambaa>
              <RSW_PekoPeko>0.2</RSW_PekoPeko>
              <RSW_Dalgo>0.18</RSW_Dalgo>
              <RSW_Hawkbat>0.18</RSW_Hawkbat>
              <RSW_Hssiss>0.18</RSW_Hssiss>
              <!-- RSW_Dianoga 0.15 REMOVED 2026-09-23 (owner ruling, see the header). Do not restore it. -->
              <RSW_Dragonsnake>0.12</RSW_Dragonsnake>
              <RSW_Lylek>0.05</RSW_Lylek>
              <RSW_Beldon>0.008</RSW_Beldon>
            </value>
          </match>
        </Operation>
      </operations>
    </match>
  </Operation>

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>sarg.alphaanimals</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <Operation Class="PatchOperationConditional">
          <xpath>Defs/BiomeDef[defName="RM_Greentide"]/wildAnimals</xpath>
          <match Class="PatchOperationAdd">
            <xpath>Defs/BiomeDef[defName="RM_Greentide"]/wildAnimals</xpath>
            <value>
              <AA_Needlepost MayRequire="sarg.alphaanimals">0.3</AA_Needlepost>
              <AA_BloodShrimp MayRequire="sarg.alphaanimals">0.2</AA_BloodShrimp>
            </value>
          </match>
        </Operation>
      </operations>
    </match>
  </Operation>

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>oskarpotocki.vfe.insectoid2</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <Operation Class="PatchOperationConditional">
          <xpath>Defs/BiomeDef[defName="RM_Greentide"]/wildAnimals</xpath>
          <match Class="PatchOperationAdd">
            <xpath>Defs/BiomeDef[defName="RM_Greentide"]/wildAnimals</xpath>
            <value>
              <VFEI2_Swarmling MayRequire="oskarpotocki.vfe.insectoid2">0.4</VFEI2_Swarmling>
            </value>
          </match>
        </Operation>
      </operations>
    </match>
  </Operation>

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>mandrake.rsw.swbestiary</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <Operation Class="PatchOperationConditional">
          <xpath>Defs/BiomeDef[defName="RM_Greentide"]/fishTypes/freshwater_Common</xpath>
          <match Class="PatchOperationAdd">
            <xpath>Defs/BiomeDef[defName="RM_Greentide"]/fishTypes/freshwater_Common</xpath>
            <value>
              <RSW_MeeCatch>0.4</RSW_MeeCatch>
            </value>
          </match>
        </Operation>
      </operations>
    </match>
  </Operation>

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>mandrake.rsw.swbestiary</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <Operation Class="PatchOperationConditional">
          <xpath>Defs/BiomeDef[defName="RM_Greentide"]/fishTypes/freshwater_Uncommon</xpath>
          <match Class="PatchOperationAdd">
            <xpath>Defs/BiomeDef[defName="RM_Greentide"]/fishTypes/freshwater_Uncommon</xpath>
            <value>
              <RSW_FaaCatch>0.3</RSW_FaaCatch>
              <RSW_LaaCatch>0.3</RSW_LaaCatch>
            </value>
          </match>
        </Operation>
      </operations>
    </match>
  </Operation>

</Patch>
