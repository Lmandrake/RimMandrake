<?xml version="1.0" encoding="utf-8"?>
<!-- HOIST_FIXED_SITE_FRAMES_1, first reuse (design §3b): a ruined head-frame beside every foundry tower door, so
     heavy salvage comes up without carrying. Guarded on RM_HoistFrame existing (mandrake.rm.keelhoist active):
     the extension's Class lives in that mod, and an unresolvable modExtension class discards the whole def.
     MayRequire on an <Operation> is ignored by the engine, so the guard is a Conditional. -->
<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="RM_HoistFrame"]</xpath>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="RUT_FoundryTowerEntrance"]/modExtensions</xpath>
      <match Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="RUT_FoundryTowerEntrance"]/modExtensions</xpath>
        <value>
          <li Class="RimMandrake.KeelHoist.RM_HoistFrameSiteExtension">
            <chance>1</chance>
            <maxDistance>7</maxDistance>
          </li>
        </value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="RUT_FoundryTowerEntrance"]</xpath>
        <value>
          <modExtensions>
            <li Class="RimMandrake.KeelHoist.RM_HoistFrameSiteExtension">
              <chance>1</chance>
              <maxDistance>7</maxDistance>
            </li>
          </modExtensions>
        </value>
      </nomatch>
    </match>
  </Operation>
</Patch>
