      <xpath>/Defs/BiomeDef[defName="Wasteland"]/wildAnimals/AA_Eyeling[2]</xpath>
    </match>
  </Operation>

  <!-- 3. AA_Eyeling x ZBiome_DesertOasis (record 2 of 2) -->
