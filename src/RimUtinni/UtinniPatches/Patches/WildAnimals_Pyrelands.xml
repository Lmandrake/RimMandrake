<?xml version="1.0" encoding="utf-8"?>
<!--
  WildAnimals_Pyrelands.xml                 UtinniPatches

  The Pyrelands' eight invented residents (fire-hawk, furnace-beast, emberscythe, sytheclaw,
  barbslinger, fire-wasp, flamefang, ashwallow) are owned RM_ defs in src/RimMandrake/Pyrelands
  and sit inline in RM_Pyrelands' <wildAnimals> (PYRELANDS_FAUNA_TIER_PORT_BUILD_1, Q11a/Q12).
  This campaign file only ADDS the seven Star Wars canon rows from SWBestiary, at the weights the
  owner ruled (design/Jawa/worldbuilding/biomes/rosters/the_pyrelands.json). It no longer replaces
  anything; the free list is the free tier's own.

  Gate: PatchOperationFindMod on SWBestiary's NAME. A top-level <Operation MayRequire=...> is ignored
  by the 1.6 engine (PATCH_MAYREQUIRE_GUARD_INERT_1), so it cannot be the gate.

    RSW_Anooba 0.35 medium-predator    RSW_Iriaz 0.50 small-herd    RSW_Nuna 0.50 small
    RSW_Orray  0.25 predator+burrower  RSW_Zeer  0.60 large-herd    RSW_Dalgo 0.18 brake
    RSW_Gizka  1.00 quick grain-forager

  Shorthand dictionary form (<Def>weight</Def>) is the ONLY form BiomeAnimalRecord's custom loader reads.
-->
<Patch>

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>RimMandrake: SW — Bestiary</li>
    </mods>
    <match Class="PatchOperationAdd">
      <xpath>Defs/BiomeDef[defName="RM_Pyrelands"]/wildAnimals</xpath>
      <value>
        <RSW_Anooba>0.35</RSW_Anooba>
        <RSW_Iriaz>0.5</RSW_Iriaz>
        <RSW_Nuna>0.5</RSW_Nuna>
        <RSW_Orray>0.25</RSW_Orray>
        <RSW_Zeer>0.6</RSW_Zeer>
        <RSW_Dalgo>0.18</RSW_Dalgo>
        <RSW_Gizka>1.0</RSW_Gizka>
      </value>
    </match>
  </Operation>

</Patch>
