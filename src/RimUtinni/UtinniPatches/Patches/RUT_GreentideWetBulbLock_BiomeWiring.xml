<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  RUT_GreentideWetBulbLock_BiomeWiring.xml   UtinniPatches · GREENTIDE_MECHANICS_2 M1
  ============================================================================
  Wires the permanent wet-bulb condition (Defs/GameConditionDefs/
  RUT_GreentideWetBulbLock.xml) onto RUT_Greentide as a PATCH rather than a
  direct edit to RUT_Greentide.xml's own biomeMapConditions field —
  RUT_GreentideWetBulbLock only exists when mandrake.rm.environmentalhazards
  is active (MayRequire-gated def), so a bare <li> baked directly into the
  BiomeDef would be a dangling cross-reference the moment that mod is
  absent. MayRequire on the Operation itself makes this patch a true no-op
  (not merely a silently-false match) when the mod is missing. Same shape
  as RUT_ScaldSteamLock_BiomeWiring.xml (SCALD_MECHANICS_1 S1).

  RUT_Greentide.xml carried no <biomeMapConditions> node at all when this
  file was first authored (M1), so this originally only added the whole
  element. GREENTIDE_MECHANICS_2 M4 build pass: RUT_RoilLock_BiomeWiring.xml
  now ALSO touches this same node, and PatchOperation order between two
  same-mod files is not something either file controls — a bare
  nomatch-only Operation would silently do nothing (add no <li> at all, no
  error, no log) if the node already exists by the time this one runs. Added
  the symmetric <match> branch below so this patch is correct regardless of
  which of the two lock-wiring patches happens to run first.
  ============================================================================
-->
<Patch>

  <Operation Class="PatchOperationConditional" MayRequire="mandrake.rm.environmentalhazards">
    <xpath>/Defs/BiomeDef[defName="RUT_Greentide"]/biomeMapConditions</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/BiomeDef[defName="RUT_Greentide"]/biomeMapConditions</xpath>
      <value>
        <li>RUT_GreentideWetBulbLock</li>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/BiomeDef[defName="RUT_Greentide"]</xpath>
      <value>
        <biomeMapConditions>
          <li>RUT_GreentideWetBulbLock</li>
        </biomeMapConditions>
      </value>
    </nomatch>
  </Operation>

</Patch>
