<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  WildAnimals_TheRot.xml                 UtinniPatches — THEROT_RM_MOD_BUILD_1, trimmed by ROT_RM_CAST_MIGRATION_1
  ============================================================================

  Wires the campaign's genuine Star Wars fauna onto RM_TheRot. Owner ruling Q12
  (design/RimMandrake/biome_mod_architecture.md §7, Q11a "the tier line is IP,
  not flavour"): an RM_-tier def may not hard-name Star Wars IP. The ten invented
  residents (thozzik, illoth, brullith, brogg, grellik, skerrith and the hive
  forms) are NOT here any more: they are owned RM_ defs in the free mod's
  Defs/Fauna and sit inline in RM_TheRot's own wildAnimals. What remains is
  RSW_ShiroTrap (a canon Shiro variant) and Snoruuk (a donor creature).

  ⚠️ A patch that matches nothing logs nothing — PatchOperationConditional
  returns true on no match, and an unmatched PatchOperationAdd is silent.
  Top-level <Operation MayRequire=…> is inert in 1.6, so the guard rides the
  row element itself (PATCH_MAYREQUIRE_OPERATION_SWEEP_1's family).
-->
<Patch>

  <!-- RSW_ShiroTrap: a canon Shiro variant, our own RSW_ def (never the donor's name). -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/BiomeDef[defName="RM_TheRot"]/wildAnimals</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/BiomeDef[defName="RM_TheRot"]/wildAnimals</xpath>
      <value>
        <RSW_ShiroTrap MayRequire="mandrake.rsw.swbestiary">0.5</RSW_ShiroTrap>
      </value>
    </match>
  </Operation>

  <!-- Snoruuk: Star Wars Animal Collection (Continued) donor, unambiguous
       exile per the item's own §3 forensics (mlie.starwarsanimalcollection,
       never this repo's own def). -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/BiomeDef[defName="RM_TheRot"]/wildAnimals</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/BiomeDef[defName="RM_TheRot"]/wildAnimals</xpath>
      <value>
        <Snoruuk MayRequire="mlie.starwarsanimalcollection">0.5</Snoruuk>
      </value>
    </match>
  </Operation>

</Patch>
