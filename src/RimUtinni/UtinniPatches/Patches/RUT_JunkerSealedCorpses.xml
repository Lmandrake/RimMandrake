<?xml version="1.0" encoding="utf-8"?>
<!-- WARCASKET_JUNKER_KINDS_BUILD_1: sealed-corpse scatter on the Wasteland (wasteland.md §7). Counts PROVISIONAL.
     Adds a GenStepDef (class RM_GenStep_SealedCorpses, mandrake.rm.warcasket) and registers it in RM_Wasteland.extraGenSteps. -->
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods><li>RimMandrake: Warcasket</li></mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAdd">
          <xpath>Defs</xpath>
          <value>
            <GenStepDef>
              <defName>RUT_SealedJunkerCorpses_Wasteland</defName>
              <order>970</order>
              <genStep Class="RimMandrake.Warcasket.RM_GenStep_SealedCorpses">
                <pawnKind>RUT_Jawa_Junkers_CaskedScavenger</pawnKind>
                <countRange>1~3</countRange>
                <biomeDefNames><li>RM_Wasteland</li></biomeDefNames>
                <daysDead>12</daysDead>
              </genStep>
            </GenStepDef>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/BiomeDef[defName="RM_Wasteland"]/extraGenSteps</xpath>
          <value><li>RUT_SealedJunkerCorpses_Wasteland</li></value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
