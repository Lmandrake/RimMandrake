  <!-- Plant_Brambles.flammability: 1 -> 0   (arid_shrubland.json)
       arid_shrubland.md §6 ban 9 (frozen): 'No flammable living flora. The native plants resist
       fire greatly and burn only grudgingly.' Interim stand-ins kept because no donor passes;
       the designed fuzz/venomvine flora is non-flammable by design and this patch retires with
       them.
  -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="Plant_Brambles"]/statBases</xpath>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="Plant_Brambles"]/statBases/Flammability</xpath>
      <match Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="Plant_Brambles"]/statBases/Flammability</xpath>
        <value><Flammability>0</Flammability></value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="Plant_Brambles"]/statBases</xpath>
        <value><Flammability>0</Flammability></value>
      </nomatch>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="Plant_Brambles"]</xpath>
      <value><statBases><Flammability>0</Flammability></statBases></value>
    </nomatch>
  </Operation>

