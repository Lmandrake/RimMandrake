<?xml version="1.0" encoding="utf-8"?>
<!--
  SALVAGE_WRECKAGE_EVERYWHERE_1 (design §4 The Forge: "RUT_FoundrySalvage extra table"): what a foundry
  salvage cache gives on careful deconstruction, on top of its Carapace roll (RUT_WreckWeathering_ForgeWarm
  names it as extraLoot). "Forge-tech salvage as the prize" (forge_kit_spec.md F4): the foundry made
  plasteel and parts. INVENTED, PROVISIONAL counts and chances.
-->
<Defs>

  <ThingSetMakerDef>
    <defName>RUT_SalvageLoot_Foundry</defName>
    <root Class="ThingSetMaker_Sum">
      <options>
        <li>
          <chance>0.9</chance>
          <thingSetMaker Class="ThingSetMaker_StackCount">
            <fixedParams>
              <filter>
                <thingDefs>
                  <li>Plasteel</li>
                </thingDefs>
              </filter>
              <countRange>5~15</countRange>
            </fixedParams>
          </thingSetMaker>
        </li>
        <li>
          <chance>1.0</chance>
          <thingSetMaker Class="ThingSetMaker_StackCount">
            <fixedParams>
              <filter>
                <thingDefs>
                  <li>ComponentIndustrial</li>
                </thingDefs>
              </filter>
              <countRange>1~3</countRange>
            </fixedParams>
          </thingSetMaker>
        </li>
        <li>
          <chance>0.15</chance>
          <thingSetMaker Class="ThingSetMaker_StackCount">
            <fixedParams>
              <filter>
                <thingDefs>
                  <li>ComponentSpacer</li>
                </thingDefs>
              </filter>
              <countRange>1</countRange>
            </fixedParams>
          </thingSetMaker>
        </li>
      </options>
    </root>
  </ThingSetMakerDef>

</Defs>
