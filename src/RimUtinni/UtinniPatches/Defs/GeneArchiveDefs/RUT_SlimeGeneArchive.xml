      <!-- A23 battle premonition: STRUCK, owner ruling 2026-09-06. Do not add. -->

      <!-- A24-A34: from the local denizens. -->
      <li>RM_Gene_A24_Sleepless</li>
      <li>RM_Gene_A25_ClottingFlesh</li>
