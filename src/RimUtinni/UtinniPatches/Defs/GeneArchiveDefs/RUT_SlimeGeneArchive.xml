      <li>RM_Gene_A1_AmphibiousLungs</li>
      <li>RM_Gene_A2_KoltoGlands</li>
      <li>RM_Gene_A3_LimbRegrowth</li>
      <li>RM_Gene_A4_GreatFrame</li>
      <li>RM_Gene_A5_LowLightEyes</li>
      <li>RM_Gene_A6_HeatPitSenses</li>
      <li>RM_Gene_A7_ToxinProofGut</li>
      <li>RM_Gene_A8_LeatherHide</li>
      <li>RM_Gene_A9_AmmoniaLungs</li>
      <li>RM_Gene_A10_ThickBlubber</li>
      <li>RM_Gene_A11_SpringLegs</li>
      <li>RM_Gene_A12_NaturalClaws</li>
