<?xml version="1.0" encoding="utf-8" ?>
<!-- FEVER_WOOD_MECHANICS_1 F7 build ("Bore-caves and the trunks — pure
     reuse of the Greatbole class"). Exact same mineable-edifice pattern as
     GREENTIDE_MECHANICS_2 M12's RUT_GreatboleHeartwood (cribbed directly,
     per the kit spec's own text): ParentName="RockBase", mineable=true,
     building.mineableThing — both fields already verified real against
     Source/Verse/ThingDef.cs:280 / Source/RimWorld/BuildingProperties.cs:267
     by that pass's own spike, not re-verified here.

     mineableThing=WoodLog (vanilla), NOT RUT_Hardwood: RUT_Hardwood's own
     description text is Greentide-flavor-specific ("cut from the living
     heart of a Greatbole... worth real money off-world") — wrong lore for
     a Fever Wood trunk, and inventing a second bespoke wood-resource
     economy here is exactly the kind of unrequested design this item's own
     prior passes (F8/F9) already declined to do. Vanilla WoodLog is the
     honest neutral choice; a Fever-Wood-specific resource item, if the
     owner wants one later, is a naming/economy call outside this pass's
     scope.

     PLACEHOLDER ART: UtinniPatches ships its own Textures/Things/Building/
     namespace (validate_patch.py's own ownership check — a "Things/" path
     with no real file underneath it is an ERROR here, same shape
     RUT_GreatboleHeartwood's own header already documents), so a genuine
     flat-color placeholder PNG ships instead
     (Textures/Things/Building/RUT_FeverTrunkHeartwood/RUT_FeverTrunkHeartwood.png)
     — real bespoke art (a pale, still, waterlogged wood grain, not
     Greentide's dark living-wood) is owed. -->
<Defs>

  <ThingDef ParentName="RockBase">
    <defName>RUT_FeverTrunkHeartwood</defName>
    <label>fever trunk heartwood</label>
    <description>The outer mass of a giant trunk, grown dense and still over the still water below — packed tight enough to dig into like stone. Cut a chamber into it and it heals, slower than the Greentide's own boles ever did; this biome does everything slowly.</description>
    <graphicData>
      <texPath>Things/Building/RUT_FeverTrunkHeartwood/RUT_FeverTrunkHeartwood</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>900</MaxHitPoints>
    </statBases>
    <mineable>true</mineable>
    <building>
      <isResourceRock>true</isResourceRock>
      <mineableThing>WoodLog</mineableThing>
      <mineableYield>15</mineableYield>
      <mineableDropChance>1</mineableDropChance>
      <veinMineable>false</veinMineable>
      <mineableScatterCommonality>0</mineableScatterCommonality>
    </building>
  </ThingDef>

</Defs>
