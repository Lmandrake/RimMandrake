<?xml version="1.0" encoding="utf-8" ?>
<!-- GREENTIDE_MECHANICS_2 M12 build. The marker building
     RM_GenStep_LivingBoles spawns at the center of each heartwood blob —
     holds the bole's identity (RM_CompLivingBoleMarker registers/
     deregisters it with RM_MapComponent_LivingRegrowth). Pure bookkeeping:
     the blob around it (RUT_GreatboleHeartwood) is what the player is meant
     to see and mine, so this def draws nothing (GREATBOLE_BARK_EDGE_ART_1).

     Impassable/not mineable itself — a player never digs out the core, only
     the heartwood blob around it (RUT_GreatboleHeartwood).

     DRAWS NOTHING (drawerType None, no graphicData) — same idiom as
     RM_SuperdeepPit and vanilla's DelayedEffecterSpawner: a bookkeeping
     Thing whose cell's visual is already fully described by something else
     (here, the heartwood blob), so a second sprite on top of it would be a
     contradicting statement, not a placeholder. This def previously carried
     a retinted vanilla DeepDrillPowered texture at drawSize (7,7), which
     rendered a fake mining-drill sprite across the middle of the greatbole
     blob — the real defect GREATBOLE_BARK_EDGE_ART_1 named. The bark-edge
     atlas art commission for RUT_GreatboleHeartwood itself is separate and
     still owed; this def was never that art's home. -->
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>RUT_GreatboleCore</defName>
    <label>greatbole core</label>
    <description>The living heart of a Greatbole — the one cell of it that never goes still, and never mines out. Everything the tree does starts here.</description>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <neverMultiSelect>true</neverMultiSelect>
    <passability>Impassable</passability>
    <fillPercent>1.0</fillPercent>
    <coversFloor>true</coversFloor>
    <holdsRoof>true</holdsRoof>
    <useHitPoints>true</useHitPoints>
    <drawerType>None</drawerType>
    <altitudeLayer>Building</altitudeLayer>
    <statBases>
      <MaxHitPoints>1200</MaxHitPoints>
      <Flammability>0.3</Flammability>
      <Beauty>-2</Beauty>
    </statBases>
    <building>
      <claimable>false</claimable>
      <deconstructible>false</deconstructible>
    </building>
    <comps>
      <li MayRequire="mandrake.rm.environmentalhazards" Class="RimMandrake.EnvironmentalHazards.CompProperties_LivingBoleMarker">
        <regrowthThing>RUT_GreatboleHeartwood</regrowthThing>
        <sealantTerrain>RUT_ToxinSealant</sealantTerrain>
        <regrowDaysRange>3~6</regrowDaysRange>
        <!-- GREATBOLE_HARVEST_LADDER_1 §2b, "the violent healing": past this
             fraction of the footprint removed, healing outpaces mining —
             "below the line you mine faster than it heals; above it, it
             heals faster than you mine" (spec §1's organising rule). The
             threshold itself is a Mod Settings slider
             (UtinniPatchesSettings.greatboleHealingThreshold, default 0.60);
             this field only supplies the speed-up multiplier once that
             fraction is crossed. 20x is INVENTED — no number is ruled, only
             "faster than a person can dig". -->
        <acceleratedRegrowThreshold>0.6</acceleratedRegrowThreshold>
        <acceleratedRegrowSpeedMultiplier>20</acceleratedRegrowSpeedMultiplier>
      </li>
      <li Class="RimMandrake.Utinni.UtinniPatches.RUT_CompProperties_GreatboleHarvestLadder">
        <fruitDef>RM_GreatboleFruit</fruitDef>
        <grubKindDef>RM_GreatboleGrub</grubKindDef>
        <hardwoodDef>RUT_Hardwood</hardwoodDef>
        <trunkSegmentDef>RUT_GreatboleTrunkSegment</trunkSegmentDef>
        <deadHuskDef>RUT_GreatboleDeadHusk</deadHuskDef>
        <wildsteamFactionDef>RUT_Jawa_WildsteamClan</wildsteamFactionDef>
      </li>
    </comps>
  </ThingDef>

</Defs>
