        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Megatardi/Megatardi_Dessicated</texPath>
          <drawSize>3</drawSize>
        </dessicatedBodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>

