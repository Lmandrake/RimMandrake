  <ThingDef Name="VAEWaste_RawMeatBase" Abstract="True" ParentName="OrganicProductBase">
    <label>Base meat properties</label>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>2</daysToRotStart>
        <rotDestroys>True</rotDestroys>
      </li>
    </comps>
    <statBases>
      <Nutrition>0.05</Nutrition>
      <Flammability>0.5</Flammability>
      <FoodPoisonChanceFixedHuman>0.02</FoodPoisonChanceFixedHuman>
    </statBases>
    <ingestible>
      <foodType>Meat</foodType>
      <preferability>DesperateOnly</preferability>
      <ingestEffect>EatMeat</ingestEffect>
      <ingestSound>RawMeat_Eat</ingestSound>
    </ingestible>
    <ingredient>
      <mergeCompatibilityTags>
        <li>VAEWaste_ToxicMeat</li>
      </mergeCompatibilityTags>
    </ingredient>
    <thingCategories>
      <li>MeatRaw</li>
    </thingCategories>
  </ThingDef>

  <ThingDef ParentName="VAEWaste_RawMeatBase">
    <defName>VAEWaste_ToxicMeat</defName>
    <label>toxic meat</label>
    <description>Raw meat from a toxic animal.\n\nChewy, gelatinous and disgusting.</description>
    <graphicData>
      <texPath>Things/Item/ToxicMeat</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <Mass>0.03</Mass>
      <MarketValue>2</MarketValue>
    </statBases>
    <ingestible>
      <specialThoughtDirect>VAEWaste_AteToxicMeatDirect</specialThoughtDirect>
      <specialThoughtAsIngredient>VAEWaste_AteToxicMeatAsIngredient</specialThoughtAsIngredient>
      <outcomeDoers>
        <li Class="VanillaAnimalsExpandedWaste.IngestionOutcomeDoer_Toxic">
          <severity>0.05</severity>
        </li>
      </outcomeDoers>
    </ingestible>
  </ThingDef>

  <ThingDef ParentName="LeatherBase">
    <defName>VAEWaste_ToxicLeather</defName>
    <label>wasteleather</label>
    <description>A poor, dark-greenish brown coloured leather that flakes quite easily. Very flammable.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Leather</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(87,70,14)</color>
    </graphicData>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <DeteriorationRate>2</DeteriorationRate>
      <Mass>0.03</Mass>
      <Flammability>2</Flammability>
      <MarketValue>1.7</MarketValue>
      <StuffPower_Armor_Sharp>0.7</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Blunt>0.15</StuffPower_Armor_Blunt>
      <StuffPower_Armor_Heat>0.8</StuffPower_Armor_Heat>
      <StuffPower_Insulation_Cold>14</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>14</StuffPower_Insulation_Heat>
    </statBases>
    <stuffProps>
      <color>(87,70,14)</color>
      <commonality>0</commonality>
      <statFactors>
        <MaxHitPoints>1.2</MaxHitPoints>
        <Flammability>2</Flammability>
        <Beauty>0.7</Beauty>
      </statFactors>
    </stuffProps>
  </ThingDef>

  <ThoughtDef>
    <defName>VAEWaste_AteToxicMeatDirect</defName>
    <showBubble>true</showBubble>
    <icon>Things/Mote/ThoughtSymbol/Food</icon>
    <durationDays>1</durationDays>
    <stages>
      <li>
        <label>ate toxic meat</label>
        <description>I ate some toxic meat. It was, possibly, the most disgusting thing I've ever tasted.</description>
        <baseMoodEffect>-6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>VAEWaste_AteToxicMeatAsIngredient</defName>
    <showBubble>true</showBubble>
    <icon>Things/Mote/ThoughtSymbol/Food</icon>
    <durationDays>1</durationDays>
    <stages>
      <li>
        <label>ate cooked toxic meat</label>
        <description>I ate a meal cooked from toxic meat. The seasoning partly covered the taste, but it still tasted quite poisonous.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
