<?xml version="1.0" encoding="utf-8"?>
<!--
  CRYSTAL_INGEST_EXECUTION_1 item 2: kyber's replacement Deeps-only scatter. Same "gate
  by genStep-list membership" trick as RUT_LanternDeepPyrinthScatter.xml === this
  GenStepDef always exists (it is ours), but every `things` entry carries
  MayRequireAnyOf="mandrake.rsw.armoury,lee.theforce.lightsaber" (our absorbed copy in
  Armoury, or the donor; LIGHTSABER_ABSORB_COPY_DEPLOYED_BESIDE_DONOR, same shape as
  RM_LanternDeepPyrinthScatter, whose AnyOf row the 2026-10-26 dump shows kept with its donor
  retired), so it is a harmless no-op only if neither is active, and
  RUT_LanternDeepGenerator.genSteps can reference it unconditionally.

  order=335, not 211 (DIRTY_CODE_REVIEW_STANDING_LOOP_1 fix, see
  RUT_LanternDeepPyrinthScatter.xml's header for the full mechanism): genStep execution
  order is global GenStepDef.order, not XML list position. 211 tied this against vanilla
  Terrain(210)/MutatorPostTerrain(220), long before BMT_CrystalsGenerator(320) it was
  meant to sit alongside. 335 keeps it right after Pyrinth's 330, both before
  PlaceCaveExit(400).
-->
<Defs>

  <GenStepDef>
    <defName>RUT_LanternDeepKyberScatter</defName>
    <order>335</order>
    <genStep Class="GenStep_ScatterGroup">
      <minSpacing>20</minSpacing>
      <!-- GenStep_Scatterer: no count/countPer10kCellsRange = zero scatters, silently. Placeholder density,
           kept modest. On the 66x66 Deeps pocket map 1~2 rounds to 0-1 clusters; 2~3 is exactly 1. -->
      <countPer10kCellsRange>2~3</countPer10kCellsRange>
      <groups>
        <li>
          <things>
            <Force_CrystalFormation_Small MayRequireAnyOf="mandrake.rsw.armoury,lee.theforce.lightsaber">0.4</Force_CrystalFormation_Small>
            <Force_CrystalFormation_Medium MayRequireAnyOf="mandrake.rsw.armoury,lee.theforce.lightsaber">0.4</Force_CrystalFormation_Medium>
            <Force_CrystalFormation_Large MayRequireAnyOf="mandrake.rsw.armoury,lee.theforce.lightsaber">0.2</Force_CrystalFormation_Large>
          </things>
          <!-- SCATTER_AUDIT_DENSITY_TRUNCATES_ZERO: 0~0.4 at r1~2 covered (int)(9|25/10 * d) = 0 cells for
               nearly every draw (max 1, and Medium is 1x2, Large 2x2). r2~3 at 0.6~1.0 covers 1-2 cells at
               r2 and 2-4 at r3, so Large fits only in the bigger clusters. Placeholder, kept modest. -->
          <coveredCellsPer10Cells>0.6~1.0</coveredCellsPer10Cells>
          <clusterRectRadius>2~3</clusterRectRadius>
        </li>
      </groups>
      <validators>
        <li Class="ScattererValidator_Buildable">
          <affordance>Heavy</affordance>
        </li>
      </validators>
    </genStep>
  </GenStepDef>

</Defs>
