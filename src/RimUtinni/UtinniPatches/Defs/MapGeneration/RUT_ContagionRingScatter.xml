<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  RUT_ContagionRingScatter.xml           UtinniPatches · FORGE_MECHANICS_1 F5
  ============================================================================
  forge_kit_spec.md F5: "a scatter pass in the biome's terrain GenStep
  painting RUT_DeadCreep filth/ground-cover along the map-edge band on
  Pyroclastic maps (INVENTED: band 8-15 cells in from the edge, patchy)."

  Uses RM_GenStep_EdgeBandFilth (new this pass, src/RimMandrake/
  EnvironmentalHazards/Source/) rather than RM_GenStep_PlacedSetPieces or
  vanilla's own GenStep_ScatterThings — both of those pick N discrete SITES;
  this paints a contiguous patchy band, a different shape entirely. See that
  class's own header for the full reasoning.

  biomes lists RUT_TheForge only — the ONE merged BiomeDef per
  BIOME_OWNERSHIP_WAVE_1 (the sheet's three donor zones, including the
  "Pyroclastic" skirts this spec names, are now one def), so there is no
  separate Pyroclastic-only BiomeDef to gate against; the class-level
  "config error if empty" guard is satisfied with this one entry.

  order 968 — after GenStep_Terrain (vanilla ~210) so terrain is already
  painted, and after the wreck-scatter precedent's own 965-967 band (this
  paints filth on TOP of whatever scattered there, which is fine — filth is
  a separate non-edifice layer, same as RUT_DeadCreep/RUT_DyingCreep
  co-existing with any building).
  ============================================================================
-->
<Defs>

  <GenStepDef MayRequire="mandrake.rm.environmentalhazards">
    <defName>RUT_ContagionRingScatter</defName>
    <order>968</order>
    <genStep Class="RimMandrake.EnvironmentalHazards.RM_GenStep_EdgeBandFilth">
      <filthDef>RUT_DeadCreep</filthDef>
      <biomes>
        <li>RUT_TheForge</li>
      </biomes>
      <cellsFromEdgeRange>8~15</cellsFromEdgeRange>
      <chancePerCell>0.35</chancePerCell>
    </genStep>
  </GenStepDef>

</Defs>
