<Defs>

  <TerrainDef>
    <defName>RUT_BoughSoil</defName>
    <label>bough-soil</label>
    <description>A living bed of silt and scale-mat, thick along the boughways and heaped where the trunks crown out — the only ground in the Fever Wood's canopy where anything can put down roots.</description>
    <renderPrecedence>330</renderPrecedence>
    <texturePath>Terrain/Surfaces/SoilRich</texturePath>
    <pathCost>3</pathCost>
    <fertility>1.4</fertility>
    <edgeType>FadeRough</edgeType>
    <color>(74,84,58)</color>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>GrowSoil</li>
    </affordances>
    <statBases>
      <Beauty>2</Beauty>
    </statBases>
  </TerrainDef>

</Defs>
