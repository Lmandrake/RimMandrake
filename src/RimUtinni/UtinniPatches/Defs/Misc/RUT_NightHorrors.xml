<?xml version="1.0" encoding="utf-8"?>
<!--
  RUT_NightHorrors.xml - HORRORS_RAIDING_FACTION_1 (2026-11-02). The Horrors as a RAIDING faction of the nightside: the
  starved-cold Assailant weapon on patrol (design/Jawa/worldbuilding/biomes/assailant_weapon_remnants.md, items 2 and 3).
  Owner ruled 2026-09-09: the reach is nightside/cold, "a threat you walk toward, not one that finds you".

  - FactionDef RUT_Horrors: vanilla Insect's shape (hidden, not humanlike, a ZERO raidCommonalityFromPointsCurve, so
    vanilla RaidEnemy's weighted faction pick never lands on it). No settlements, never generated with a world
    (requiredCountAtGameStart 0): the faction is made the first time it is needed, by RUT_NightHorrors.cs
    (RUT_HorrorFaction.GetOrCreate), on the frozen shipped world, which makes no settlement.
  - IncidentDef RUT_HorrorRaid: the only way a Horror raid happens. Its worker fires only on a map whose tile is in the
    WeatherSuite nightside band (WeatherGeometryUtility.MapInNightsideBand); on the dayside and in the terminator it
    cannot fire. Mod Setting: nightHorrorRaidsEnabled.
  - GenStepDef RUT_NightHorrorLairs, registered on Base_Player and Encounter by Patches/RUT_NightHorrorLairs_Register.xml:
    self-gating (setting nightHorrorLairsEnabled + nightside band), it places one to three lairs: a hive, a den, burrows,
    a sinkhole, a mite larder and dormant crysalises. A crysalis wakes when anyone not of the weapon comes within its
    radius or its cell thaws above freezing ("Mining is warming"), with a small burst of stored energy, and the form that
    steps out joins the Horrors and attacks.
  Forms: RM_Visceral (RM_Visceral.xml) and RUT_HorrorBulwark/Harvester/Prowler/BroodLord (RUT_NightHorrors_Races.xml).
  Art: donor bundle textures, stand-in (Textures/RimUtinni/UtinniPatches/NightHorrors/).
  Not built here: the sinkhole as a working door into a cave pocket map (filed as its own item, see the item's notes).
-->
<Defs>

  <FactionDef ParentName="FactionBase">
    <defName>RUT_Horrors</defName>
    <label>the Assailant horrors</label>
    <description>What is left of the Assailant bioweapon on the nightside: starved of energy and prey, it has degraded less there than anywhere else. Slow, patient and cold-adapted, its spore forms lie dormant in crysalises under the ice and come out of the cold to hunt, to break walls, and to collect the living as samples for a master who no longer exists. It holds no ground anyone could visit and it does not bargain. It does not come to the warm side: you walk toward it.</description>
    <pawnSingular>horror</pawnSingular>
    <pawnsPlural>horrors</pawnsPlural>
    <fixedName>The Assailant Weapon</fixedName>
    <requiredCountAtGameStart>0</requiredCountAtGameStart>
    <maxConfigurableAtWorldCreation>0</maxConfigurableAtWorldCreation>
    <factionIconPath>World/WorldObjects/Expanding/Insects</factionIconPath>
    <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
    <colorSpectrum>
      <li>(0.45, 0.0, 0.45)</li>
      <li>(0.20, 0.02, 0.18)</li>
      <li>(0.0, 0.06, 0.18)</li>
    </colorSpectrum>
    <raidCommonalityFromPointsCurve>
      <points>
        <li>(0, 0)</li>
      </points>
    </raidCommonalityFromPointsCurve>
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(0,35)</li>
        <li>(70, 50)</li>
        <li>(700, 160)</li>
        <li>(1300, 450)</li>
        <li>(4000, 1000)</li>
        <li>(100000, 10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>100</commonality>
        <options>
          <RM_Visceral>200</RM_Visceral>
          <RUT_HorrorProwler>40</RUT_HorrorProwler>
          <RUT_HorrorHarvester>10</RUT_HorrorHarvester>
          <RUT_HorrorBroodLord>5</RUT_HorrorBroodLord>
        </options>
      </li>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>100</commonality>
        <options>
          <RM_Visceral>500</RM_Visceral>
          <RUT_HorrorProwler>100</RUT_HorrorProwler>
        </options>
      </li>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>30</commonality>
        <options>
          <RM_Visceral>400</RM_Visceral>
          <RUT_HorrorBulwark>200</RUT_HorrorBulwark>
        </options>
      </li>
    </pawnGroupMakers>
    <humanlikeFaction>false</humanlikeFaction>
    <hidden>true</hidden>
    <permanentEnemy>true</permanentEnemy>
    <autoFlee>false</autoFlee>
    <canSiege>false</canSiege>
    <canStageAttacks>false</canStageAttacks>
    <canUseAvoidGrid>false</canUseAvoidGrid>
    <techLevel>Animal</techLevel>
    <animalsFleeDanger>false</animalsFleeDanger>
    <allowedArrivalTemperatureRange>-100~45</allowedArrivalTemperatureRange>
    <configurationListOrderPriority>1001</configurationListOrderPriority>
  </FactionDef>

  <IncidentDef>
    <defName>RUT_HorrorRaid</defName>
    <label>horror patrol</label>
    <targetTags>
      <li>Map_PlayerHome</li>
      <li>Map_TempIncident</li>
      <li>Map_Misc</li>
    </targetTags>
    <workerClass>RimMandrake.Utinni.UtinniPatches.RUT_IncidentWorker_HorrorRaid</workerClass>
    <baseChance>2.5</baseChance>
    <minRefireDays>6</minRefireDays>
    <category>ThreatBig</category>
    <pointsScaleable>true</pointsScaleable>
    <tale>Raid</tale>
    <canOccurOnAllPlanetLayers>true</canOccurOnAllPlanetLayers>
  </IncidentDef>

  <GenStepDef>
    <defName>RUT_NightHorrorLairs</defName>
    <order>1450</order>
    <genStep Class="RimMandrake.Utinni.UtinniPatches.RUT_GenStep_NightHorrorLairs">
      <lairCountRange>1~3</lairCountRange>
      <hive>RUT_HorrorHive</hive>
      <den>RUT_HorrorDen</den>
      <burrow>RUT_HorrorBurrow</burrow>
      <sinkhole>RUT_HorrorSinkhole</sinkhole>
      <larder>RUT_HorrorMiteLarder</larder>
      <crysalises>
        <li>RUT_HorrorCrysalis_Visceral</li>
        <li>RUT_HorrorCrysalis_Visceral</li>
        <li>RUT_HorrorCrysalis_Prowler</li>
        <li>RUT_HorrorCrysalis_Harvester</li>
        <li>RUT_HorrorCrysalis_Bulwark</li>
      </crysalises>
    </genStep>
  </GenStepDef>

  <!-- ===== lair structures: natural, not buildable, not claimable ===== -->

  <ThingDef Name="RUT_HorrorLairBase" ParentName="BuildingNaturalBase" Abstract="True">
    <thingClass>Building</thingClass>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>0.6</fillPercent>
    <rotatable>false</rotatable>
    <useHitPoints>true</useHitPoints>
    <filthLeaving>Filth_Slime</filthLeaving>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <Flammability>0.4</Flammability>
      <Beauty>-40</Beauty>
    </statBases>
    <building>
      <claimable>false</claimable>
      <deconstructible>false</deconstructible>
      <artificialForMeditationPurposes>false</artificialForMeditationPurposes>
    </building>
  </ThingDef>

  <ThingDef ParentName="RUT_HorrorLairBase">
    <defName>RUT_HorrorHive</defName>
    <label>horror hive</label>
    <description>A heaped, ribbed mass of resin and frozen tissue: the heart of an Assailant lair. Whatever fed it is long dead; it keeps itself, barely, against the cold.</description>
    <size>(2,2)</size>
    <graphicData>
      <texPath>RimUtinni/UtinniPatches/NightHorrors/Hive/HorrorHive</texPath>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>800</MaxHitPoints>
    </statBases>
    <killedLeavings>
      <InsectJelly>30</InsectJelly>
    </killedLeavings>
  </ThingDef>

  <ThingDef ParentName="RUT_HorrorLairBase">
    <defName>RUT_HorrorDen</defName>
    <label>horror den</label>
    <description>A low, roofed shell of resin where the weapon's forms wait out the long cold. It smells of nothing at all.</description>
    <size>(2,2)</size>
    <graphicData>
      <texPath>RimUtinni/UtinniPatches/NightHorrors/Hive/HorrorDen</texPath>
      <drawSize>(2.6,2.6)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>500</MaxHitPoints>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="RUT_HorrorLairBase">
    <defName>RUT_HorrorBurrow</defName>
    <label>horror burrow</label>
    <description>A resin-lined hole bored down through the frozen ground. Something wide went down it, or came up.</description>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.2</fillPercent>
    <graphicData>
      <texPath>RimUtinni/UtinniPatches/NightHorrors/Hive/HorrorBurrow</texPath>
      <drawSize>(1.2,1.2)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="RUT_HorrorLairBase">
    <defName>RUT_HorrorSinkhole</defName>
    <label>horror sinkhole</label>
    <description>The ground has given way into the cave dark beneath the ice. The weapon's forms come and go by it; no rope you carry reaches the bottom.</description>
    <size>(3,3)</size>
    <useHitPoints>false</useHitPoints>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <fillPercent>0</fillPercent>
    <graphicData>
      <texPath>RimUtinni/UtinniPatches/NightHorrors/Hive/HorrorSinkhole</texPath>
      <drawSize>(3.4,3.4)</drawSize>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="RUT_HorrorLairBase">
    <defName>RUT_HorrorMiteLarder</defName>
    <label>mite-nest larder</label>
    <description>A crusted nest where the weapon stores what it collects: prey sealed in jelly, and whatever the prey was carrying. Break it open to take the larder.</description>
    <fillPercent>0.4</fillPercent>
    <graphicData>
      <texPath>RimUtinni/UtinniPatches/NightHorrors/Hive/HorrorMiteLarder</texPath>
      <drawSize>(1.5,1.5)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
    </statBases>
    <killedLeavings>
      <InsectJelly>40</InsectJelly>
      <Silver>60</Silver>
      <ComponentIndustrial>2</ComponentIndustrial>
      <MedicineIndustrial>2</MedicineIndustrial>
    </killedLeavings>
  </ThingDef>

  <!-- ===== crysalises: the cold-dormancy mechanic ===== -->

  <ThingDef Name="RUT_HorrorCrysalisBase" ParentName="RUT_HorrorLairBase" Abstract="True">
    <tickerType>Normal</tickerType>
    <fillPercent>0.5</fillPercent>
    <graphicData>
      <texPath>RimUtinni/UtinniPatches/NightHorrors/Hive/HorrorCrysalis</texPath>
      <drawSize>(1.6,1.6)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="RUT_HorrorCrysalisBase">
    <defName>RUT_HorrorCrysalis_Visceral</defName>
    <label>visceral crysalis</label>
    <description>A frozen husk holding a dormant visceral. It is cold-asleep, not dead: walk too close, or let it thaw, and the stored energy in it breaks it open.</description>
    <comps>
      <li Class="RimMandrake.Utinni.UtinniPatches.RUT_CompProperties_HorrorCrysalis">
        <pawnKind>RM_Visceral</pawnKind>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="RUT_HorrorCrysalisBase">
    <defName>RUT_HorrorCrysalis_Prowler</defName>
    <label>prowler crysalis</label>
    <description>A frozen husk holding a dormant prowler. It is cold-asleep, not dead: walk too close, or let it thaw, and the stored energy in it breaks it open.</description>
    <comps>
      <li Class="RimMandrake.Utinni.UtinniPatches.RUT_CompProperties_HorrorCrysalis">
        <pawnKind>RUT_HorrorProwler</pawnKind>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="RUT_HorrorCrysalisBase">
    <defName>RUT_HorrorCrysalis_Harvester</defName>
    <label>harvester crysalis</label>
    <description>A frozen husk holding a dormant harvester. It is cold-asleep, not dead: walk too close, or let it thaw, and the stored energy in it breaks it open.</description>
    <graphicData>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <comps>
      <li Class="RimMandrake.Utinni.UtinniPatches.RUT_CompProperties_HorrorCrysalis">
        <pawnKind>RUT_HorrorHarvester</pawnKind>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="RUT_HorrorCrysalisBase">
    <defName>RUT_HorrorCrysalis_Bulwark</defName>
    <label>bulwark crysalis</label>
    <description>A great frozen husk holding a dormant bulwark. It is cold-asleep, not dead: walk too close, or let it thaw, and the stored energy in it breaks it open.</description>
    <size>(2,2)</size>
    <graphicData>
      <drawSize>(2.6,2.6)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
    </statBases>
    <comps>
      <li Class="RimMandrake.Utinni.UtinniPatches.RUT_CompProperties_HorrorCrysalis">
        <pawnKind>RUT_HorrorBulwark</pawnKind>
        <triggerRadius>6</triggerRadius>
      </li>
    </comps>
  </ThingDef>

</Defs>
