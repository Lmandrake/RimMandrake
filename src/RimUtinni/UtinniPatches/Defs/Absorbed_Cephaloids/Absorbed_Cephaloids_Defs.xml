	<ThingDef ParentName="AnimalThingBase">
		<defName>JOE_Landopus</defName>
		<label>landopus</label>
		<description>Despite the name, this bad-tempered creature evolved from squid and has eight tentacles and two arms. The landopus has a venomous bite and a full load of its deadly neurotoxin will kill a healthy adult human in a minute or less.</description>
		<statBases>
			<MoveSpeed>1.8</MoveSpeed>
			<MarketValue>50</MarketValue>
			<ComfyTemperatureMin>5</ComfyTemperatureMin>
			<FilthRate>2</FilthRate>
			<Wildness>0.9</Wildness>
		</statBases>
		<tools>
			<li>
				<capacities>
					<li>ToxicBite</li>
				</capacities>
				<power>32</power>
				<cooldownTime>.5</cooldownTime>
				<linkedBodyPartsGroup>Beak</linkedBodyPartsGroup>
				<chanceFactor>.95</chanceFactor>
				<surpriseAttack>
				<extraMeleeDamages>
					<li>
					<def>Stun</def>
					<amount>34</amount>
					</li>
				</extraMeleeDamages>
				</surpriseAttack>
			</li>
		</tools>
		<race>
			<body>Cephaloid</body>
			<predator>true</predator>
			<maxPreyBodySize>2.0</maxPreyBodySize>
			<baseBodySize>0.15</baseBodySize>
			<baseHungerRate>0.5</baseHungerRate>
			<baseHealthScale>0.5</baseHealthScale>
			<foodType>CarnivoreAnimal</foodType>
			<leatherDef>Leather_Light</leatherDef>
			<lifeExpectancy>12</lifeExpectancy>
			<manhunterOnTameFailChance>0.10</manhunterOnTameFailChance>
			<trainability>None</trainability>
			<waterSeeker>true</waterSeeker>
      		<waterCellCost>1</waterCellCost>
      		<canFishForFood>true</canFishForFood>
			<lifeStageAges>
				<li>
					<def>AnimalAdult</def>
					<minAge>0.5</minAge>
					<soundWounded>Pawn_Cobra_Wounded</soundWounded>
					<soundDeath>Pawn_Cobra_Death</soundDeath>
					<soundCall>Pawn_Cobra_Call</soundCall>
					<soundAngry>Pawn_Cobra_Angry</soundAngry>
				</li>
			</lifeStageAges>
			<soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
			<soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
			<soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
		</race>
