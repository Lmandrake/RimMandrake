<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  RUT_ContagionProbe.xml                 UtinniPatches · FORGE_MECHANICS_1 F5
  ============================================================================
  forge_kit_spec.md F5: "RUT_ContagionProbe IncidentDef (weighted only into
  Forge biomes, MTB-ish commonality — INVENTED: ~1 per 8 days) spawning a
  cluster of RUT_DyingCreep plant-things at a map edge... Letter on arrival,
  quiet death."

  workerClass -> RUT_IncidentWorker_ContagionProbe (new this pass,
  src/RimMandrake/EnvironmentalHazards/Source/) hardcodes the RUT_TheForge
  biome check in CanFireNowSub — see that class's own header for why this
  is a direct check rather than an XML-settable biome list.

  minRefireDays ~8 (INVENTED, "MTB-ish ~1 per 8 days" read directly as the
  refire floor, same conversion RUT_FeverWood_MirrorBreak.xml's own
  baseChance/minRefireDays pair uses — a kit spec's plain-English MTB
  becomes minRefireDays, not a literal Rand.MTBEventOccurs roll, because
  IncidentDef's own storyteller-driven baseChance/minRefireDays pair is the
  idiomatic vanilla mechanism for "roughly once every N days," not a custom
  MTB check inside the worker). baseChance scaled down from
  RUT_FlameHarvest's 4 (a "generous, narrow-gated" incident) to match this
  one's own framing — an ambient atmosphere beat with only a passive biome
  gate, not a narrow-gated harvest event.
  ============================================================================
-->
<Defs>

  <IncidentDef MayRequire="mandrake.rm.environmentalhazards">
    <defName>RUT_ContagionProbe</defName>
    <label>Contagion probe</label>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <category>Misc</category>
    <workerClass>RimMandrake.EnvironmentalHazards.RUT_IncidentWorker_ContagionProbe</workerClass>
    <baseChance>1.5</baseChance>
    <minRefireDays>8</minRefireDays>
  </IncidentDef>

</Defs>
