        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Warg/Dessicated_Warg</texPath>
          <drawSize>0.7</drawSize>
        </dessicatedBodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/Warg/Warg</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.05</drawSize>
          <color>(90,92,95)</color>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Warg/Dessicated_Warg</texPath>
          <drawSize>1.05</drawSize>
        </dessicatedBodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/Warg/Warg</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.4</drawSize>
          <color>(90,92,95)</color>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Warg/Dessicated_Warg</texPath>
          <drawSize>1.4</drawSize>
        </dessicatedBodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>

  <!-- =================================================================
       VEKKIT — the Picker (§5)
       ================================================================= -->

  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Vekkit</defName>
    <label>vekkit</label>
    <description>A knee-high thing that walks like a folding chair, two long jointed forelimbs ending in hooks it uses to pick a frozen carcass apart one flake at a time. You find them on the line where the ice gives things up: a dozen of them standing around a fallen hull or a freeze-dried spacer, working, patient, not interested in you unless you are lying down. The crews call them linewalkers and follow them to the good salvage.</description>
    <statBases>
      <MoveSpeed>4.2</MoveSpeed>
      <Mass>27</Mass>
      <Flammability>0.1</Flammability>
      <MeatAmount>0</MeatAmount>
      <LeatherAmount>0</LeatherAmount>
      <ComfyTemperatureMin>-100</ComfyTemperatureMin>
      <ComfyTemperatureMax>-11</ComfyTemperatureMax>
      <Wildness>0.9</Wildness>
    </statBases>
    <tools>
      <li>
        <label>hook</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>6</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
      </li>
      <li>
        <label>beak</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>4</power>
        <cooldownTime>1.8</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
      </li>
    </tools>
    <race>
      <body>QuadrupedAnimalWithPawsAndTail</body>
      <bloodDef>Filth_Blood</bloodDef>
      <bloodSmearDef>Filth_BloodSmear</bloodSmearDef>
      <hediffGiverSets>
        <li>OrganicStandard</li>
      </hediffGiverSets>
      <baseBodySize>0.45</baseBodySize>
      <baseHealthScale>0.45</baseHealthScale>
      <baseHungerRate>0.2</baseHungerRate>
      <foodType>CarnivoreAnimal</foodType>
      <predator>false</predator>
      <trainability>None</trainability>
      <lifeExpectancy>10</lifeExpectancy>
      <manhunterOnDamageChance>0.05</manhunterOnDamageChance>
      <herdAnimal>true</herdAnimal>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.2</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.4</minAge>
        </li>
      </lifeStageAges>
      <butcherProducts>
        <RM_ColdWax>2</RM_ColdWax>
      </butcherProducts>
    </race>
    <modExtensions>
      <li Class="RimMandrake.BlueDesert.RM_HydrocarbonNativeExtension" />
    </modExtensions>
    <tradeTags>
      <li>AnimalCommon</li>
    </tradeTags>
  </ThingDef>

  <PawnKindDef ParentName="AnimalKindBase">
    <defName>RM_Vekkit</defName>
    <label>vekkit</label>
    <race>RM_Vekkit</race>
    <combatPower>30</combatPower>
    <wildGroupSize>3~7</wildGroupSize>
    <ecoSystemWeight>0.3</ecoSystemWeight>
    <startingHediffs>
      <li>
        <def>RM_VekkitCharge</def>
        <severity>1</severity>
      </li>
    </startingHediffs>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/Squirrel/Squirrel</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>0.5</drawSize>
          <color>(120,122,126)</color>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
