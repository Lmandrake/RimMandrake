<!--
  EMBERSCYTHE_PYRELANDS_REHOME_1 — moved here from RotSporeKit 2026-09-19 (owner
  ruling: MOVE, not cut — Pyrelands fauna belongs in the Pyrelands mod, not riding
  along in a Rot-only mod). Nothing below the original header changed.

  EMBERSCYTHE_MANTIS_REAUTHOR_1 — re-author of the dead GR_Mantistanis
  (Genetic Rim's cut, stated donor Vanilla Genetics Expanded — MEASURED
  absent from every active mod, 2026-09-12). Owner, verbatim: "Launch a sub
  agent to totally handle and fix the mantis. That's silly."

  Roster intent preserved from design/Jawa/fauna/cast_assignment.csv (the
  ZBiome_Grasslands GR_Mantistanis row): the Pyrelands' §4 fire-follower,
  large-predator band, pack 3, commonality 0.05, MEASURED speed 7.0,
  self-healing suits repeated burns, "second flame-edge hunter beside
  Anooba." This is a CLONE built from our own live vanilla stat references
  (mcp__rimsage__get_def_details this pass), not a port of any donor's XML —
  no GR_/VGE class or comp is referenced anywhere below.

  Shape cloned from this mod's own RUT_ScarRoach
  (RustCathedralRoaches/Defs/ThingDefs_Races/RUT_ScarRoach.xml): ParentName
  AnimalThingBase + manual Insectoid race block, so this ships as ordinary
  wildlife (breeds, ages, roams via wildAnimals commonality) rather than a
  BaseInsect hive spawn — BaseInsect's CompProperties_CanBeDormant/
  WakeUpDormant are for cave-hatched insectoid swarms (Megaspider/
  Megascarab), wrong shape for a biome predator that hunts year-round.

  Body BeetleLikeWithClaw (MEASURED via get_def_details) is Megaspider's own
  body — same HeadClaw/Mouth/HeadAttackTool groups reused here as the
  "scythe forelimb" mantis flavor, mandibles, and a blunt head fallback.
  Stats benchmarked against Warg (large-predator tier, baseBodySize 1.4,
  MoveSpeed 5) and Megaspider (Insectoid armor/tools), then MoveSpeed set to
  the cast row's own MEASURED 7.0 — the standout trait that makes this a
  hunter, not a tank.

  Self-healing ("suits repeated burns"): v1 is the honest cheap route the
  item brief calls for — a flat InjuryHealingFactor statBase (real StatDef,
  MEASURED via rimsage: "multiplier applied to a person's injury healing
  rate", defaultBaseValue 1). No new C# comp: nothing in
  RimMandrake.CreatureBehaviors/EnvironmentalHazards fits a SOLO self-heal
  (RM_HediffComp_KinMending needs 2+ tagged kin nearby;
  RM_HediffComp_ForgeOnSurvival is a disease-recovery boon roll, gated to a
  named biome + a HediffDef of comps, not a race trait). A fire-specific
  hardening comp in the ForgeOnSurvival shape would be a nicer v2 — OWED,
  not built here.

  Fire-follower flavor (label/description only, no mechanism): ember-dark
  chitin, reduced Flammability vs. the insect baseline (0.7 on Megaspider/
  Megascarab) and a raised ComfyTemperatureMax.

  Art: PLACEHOLDER texPath reusing Megascarab's own shipped vanilla
  Things/Pawn/Animal/Megascarab/Megascarab art (MEASURED via
  get_def_details on the Megascarab PawnKindDef) with an ember-red tint, the
  same "recolored placeholder, no new art" idiom RUT_Placeholder_SumpMouse
  already uses on Squirrel. Bespoke Emberscythe art is OWED.

  Mod Settings: RotSporeKit has no settings infrastructure at all (no
  Settings/*.cs, checked this pass) — a spawn toggle is not cheap here.
  OWED, not built.
-->
<Defs>

  <ThingDef ParentName="AnimalThingBase">
    <defName>RUT_Emberscythe</defName>
    <label>emberscythe mantis</label>
    <description>A large, quick-striking mantis with ember-dark chitin, native to the Pyrelands' fire-scoured edges. It follows burns to hunt what the flames flush out, and its shell shrugs off scorching that would cripple a duller predator. A second flame-edge hunter beside the anooba — where the anooba runs its prey down, the emberscythe waits in the ash and takes it in one cut.</description>
    <statBases>
      <MoveSpeed>7.0</MoveSpeed>
      <Mass>55</Mass>
      <Flammability>0.45</Flammability>
      <LeatherAmount>0</LeatherAmount>
      <ArmorRating_Blunt>0.15</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.32</ArmorRating_Sharp>
      <ToxicResistance>0.6</ToxicResistance>
      <ComfyTemperatureMin>-10</ComfyTemperatureMin>
      <ComfyTemperatureMax>80</ComfyTemperatureMax>
      <MarketValue>320</MarketValue>
      <Wildness>0.6</Wildness>
      <InjuryHealingFactor>1.6</InjuryHealingFactor>
    </statBases>
    <uiIconScale>1.3</uiIconScale>
    <tools>
      <li>
        <label>mandibles</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
      </li>
      <li>
        <label>scythe forelimb</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>16</power>
        <cooldownTime>2.2</cooldownTime>
        <linkedBodyPartsGroup>HeadClaw</linkedBodyPartsGroup>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>6</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.15</chanceFactor>
      </li>
    </tools>
    <race>
      <body>BeetleLikeWithClaw</body>
      <predator>true</predator>
      <baseBodySize>1.3</baseBodySize>
      <baseHungerRate>0.28</baseHungerRate>
      <baseHealthScale>1.4</baseHealthScale>
      <maxPreyBodySize>2.2</maxPreyBodySize>
      <useMeatFrom>Megaspider</useMeatFrom>
      <lifeExpectancy>9</lifeExpectancy>
      <trainability>Intermediate</trainability>
      <fleshType>Insectoid</fleshType>
      <bloodDef>Filth_BloodInsect</bloodDef>
      <bloodSmearDef>Filth_BloodSmear</bloodSmearDef>
      <meatColor>(160,168,139)</meatColor>
      <meatMarketValue>0.5</meatMarketValue>
      <foodType>CarnivoreAnimalStrict</foodType>
      <manhunterOnDamageChance>0.5</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0.4</manhunterOnTameFailChance>
      <gestationPeriodDays>9</gestationPeriodDays>
      <soundEating>Insectoid_Eat</soundEating>
      <litterSizeCurve>
        <points>
          <li>(0.5, 0)</li>
          <li>(1, 1)</li>
          <li>(2, 1.4)</li>
          <li>(2.5, 0)</li>
        </points>
      </litterSizeCurve>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.2</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.5</minAge>
          <soundWounded>Pawn_BigInsect_Pain</soundWounded>
          <soundDeath>Pawn_BigInsect_Death</soundDeath>
          <soundCall>Pawn_BigInsect_Call</soundCall>
          <soundAngry>Pawn_BigInsect_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
    </race>
    <tradeTags>
      <li>AnimalInsect</li>
      <li>AnimalFighter</li>
    </tradeTags>
  </ThingDef>

  <PawnKindDef ParentName="AnimalKindBase">
    <defName>RUT_Emberscythe</defName>
    <label>emberscythe mantis</label>
    <race>RUT_Emberscythe</race>
    <combatPower>130</combatPower>
    <wildGroupSize>2~4</wildGroupSize>
    <ecoSystemWeight>0.4</ecoSystemWeight>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/Megascarab/Megascarab</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.1</drawSize>
          <color>(140,45,25)</color>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Megascarab/Dessicated_Megascarab</texPath>
          <drawSize>1.1</drawSize>
        </dessicatedBodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/Megascarab/Megascarab</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.7</drawSize>
          <color>(140,45,25)</color>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Megascarab/Dessicated_Megascarab</texPath>
          <drawSize>1.7</drawSize>
        </dessicatedBodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/Megascarab/Megascarab</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>2.2</drawSize>
          <color>(140,45,25)</color>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Megascarab/Dessicated_Megascarab</texPath>
          <drawSize>2.2</drawSize>
        </dessicatedBodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>

</Defs>
