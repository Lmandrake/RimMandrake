  <ThingDef ParentName="AnimalThingBase">
    <defName>RUT_FurnaceBeast</defName>
    <label>furnace-beast</label>
    <description>A migratory megafauna whose banded mineral hide stores heat like a stove: weeks basking in the deep dayside, then walking out across the grass radiating warmth from glowing seams between its plates. Travelers follow the herds for warmth in the cold and give them a wide, respectful berth in the dry -- their bed-down grounds have been known to smolder alight on their own. Nothing on this planet has ever kept one.</description>
    <statBases>
      <MoveSpeed>3.6</MoveSpeed>
      <MarketValue>900</MarketValue>
      <ComfyTemperatureMin>-10</ComfyTemperatureMin>
      <ComfyTemperatureMax>70</ComfyTemperatureMax>
      <ArmorRating_Blunt>0.35</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.3</ArmorRating_Sharp>
      <ArmorRating_Heat>0.6</ArmorRating_Heat>
      <Wildness>0.97</Wildness>
    </statBases>
    <tools>
      <li>
        <label>horn</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>18</power>
        <cooldownTime>2.4</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
      </li>
      <li>
        <label>left foot</label>
        <labelNoLocation>foot</labelNoLocation>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>15</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftLeg</linkedBodyPartsGroup>
      </li>
      <li>
        <label>right foot</label>
        <labelNoLocation>foot</labelNoLocation>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>15</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>FrontRightLeg</linkedBodyPartsGroup>
      </li>
    </tools>
    <comps>
      <li Class="VEF.AnimalBehaviours.CompProperties_Untameable" MayRequire="oskarpotocki.vanillafactionsexpanded.core">
        <message>Nothing on this planet has ever kept a furnace-beast.</message>
        <sendMessage>true</sendMessage>
        <goesManhunter>false</goesManhunter>
      </li>
    </comps>
    <race>
      <body>QuadrupedAnimalWithHoovesAndHorn</body>
      <herdAnimal>true</herdAnimal>
      <predator>false</predator>
      <trainability>None</trainability>
      <baseBodySize>3.2</baseBodySize>
      <baseHealthScale>2.8</baseHealthScale>
      <baseHungerRate>1.4</baseHungerRate>
      <foodType>VegetarianRoughAnimal</foodType>
      <leatherDef>Leather_Heavy</leatherDef>
      <gestationPeriodDays>12</gestationPeriodDays>
      <manhunterOnDamageChance>0.15</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0.9</manhunterOnTameFailChance>
      <litterSizeCurve>
        <points>
          <li>(0.5, 0)</li>
          <li>(1, 1)</li>
          <li>(1.5, 0)</li>
        </points>
      </litterSizeCurve>
      <lifeExpectancy>45</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.3</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.6</minAge>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
      <soundEating>Herbivore_Eat</soundEating>
    </race>
    <tradeTags>
      <li>AnimalExotic</li>
    </tradeTags>
  </ThingDef>

