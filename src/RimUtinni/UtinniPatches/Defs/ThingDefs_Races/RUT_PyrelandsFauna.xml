<?xml version="1.0" encoding="utf-8"?>
<!--
  PYRELANDS_FIRE_WEB_COMMISSION_1: owner sitting ruling, 2026-09-10: commission
  the fire-hawk and furnace-beast, the biome's two "irreplaceable igniters"
  (design/Jawa/worldbuilding/biomes/the_pyrelands.md SS4). Roster entry:
  design/Jawa/worldbuilding/biomes/rosters/the_pyrelands.json "new_defs".

  Scope: the roster-level def (stats, art, wildAnimals placement) only.

  The special mechanics the sheet names - fire-hawk twig-carrying,
  furnace-beast heat aura and bed-down ignition - are BUILT, in their own mod:
  src/RimUtinni/PyrelandsMechanics (mandrake.rut.pyrelandsmechanics,
  PYRELANDS_MECHANICS_1). That mod loads after this one and attaches its comps
  to both defs by PatchOperation (Patches/RUT_PyrelandsIgniters_Comps.xml), so
  no def in this file references a class from another assembly.

  🟢 BAN 5 REVERSED (owner ruling, 2026-09-10; the_pyrelands.md §6 line 5):
  both igniters are TAMEABLE - "Make them both tameable... and that's insane.
  Fires all the time! I love it." The five def changes §8a of
  design/Jawa/worldbuilding/creatures/RUT_ruled_commissions_wave2.md orders
  are applied below on the furnace-beast: the VEF Untameable comp is GONE,
  trainability is Intermediate (matching the hawk), the description's closing
  line is rewritten, manhunterOnTameFailChance stays 0.9 as the taming
  gauntlet, and leatherDef is RUT_FurnaceHide.

  🔴 Wildness must stay strictly BELOW 1.0 or the reversal is silently undone:
  TameUtility.CanTame hard-refuses Wildness >= 1.0 (verified at source,
  RimWorld/TameUtility.cs:49). The furnace-beast sits at 0.97 - thrumbo-class
  and deliberately just under the line.

  Art: generated for real via the live artpipe daemon (infrastructure/artpipe/),
  transparent background, one east-facing sprite each: see
  infrastructure/artpipe/done/pyrelands_firehawk_v1.manifest.json and
  pyrelands_furnacebeast_v1.manifest.json for the generation record. Single
  texPath reused across all lifeStages, matching this campaign's own sea-beast
  precedent (SWBestiary/Defs/SeaBeasts) rather than inventing a facing set this
  pass owes no design gate for.
-->
<Defs>

  <ThingDef ParentName="AnimalThingBase">
    <defName>RUT_FireHawk</defName>
    <label>fire-hawk</label>
    <description>A lean raptor of the standing burn, ash-grey and ember-orange, that flushes prey ahead of the flame-line and is said to carry a burning twig from one fire to the next when the burn stalls. The Pyrelands' first igniter with wings.</description>
    <statBases>
      <MoveSpeed>5.2</MoveSpeed>
      <MarketValue>180</MarketValue>
      <ComfyTemperatureMin>10</ComfyTemperatureMin>
      <ComfyTemperatureMax>65</ComfyTemperatureMax>
      <ArmorRating_Heat>0.3</ArmorRating_Heat>
      <Wildness>0.9</Wildness>
    </statBases>
    <tools>
      <!-- body Bird (Defs/Core/Bodies/Bodies_Animal_Bird.xml) has no
           FrontLeftLeg/FrontRightLeg groups; those exist only on
           quadruped bodies (see FurnaceBeast below). Both feet share a
           single "Feet" group, same as every vanilla bird's claw tool
           (e.g. Defs/Odyssey/ThingDefs_Races/Races_Animal_Birds.xml):
           the two talon tools below were dead (unreachable body part
           group, never usable) before this fix. -->
      <li>
        <label>talons</label>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Feet</linkedBodyPartsGroup>
      </li>
      <li>
        <label>talons</label>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Feet</linkedBodyPartsGroup>
      </li>
      <!-- Bite belongs on the Beak body part group (present on Bird's
           Head/Beak subpart), not HeadAttackTool: HeadAttackTool is the
           whole-head fallback vanilla birds use for a separate, low-power
           Blunt "head" tool, not for the primary bite. -->
      <li>
        <label>beak</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>7</power>
        <cooldownTime>1.8</cooldownTime>
        <linkedBodyPartsGroup>Beak</linkedBodyPartsGroup>
      </li>
    </tools>
    <race>
      <body>Bird</body>
      <predator>true</predator>
      <maxPreyBodySize>0.5</maxPreyBodySize>
      <baseBodySize>0.65</baseBodySize>
      <baseHealthScale>0.6</baseHealthScale>
      <baseHungerRate>0.35</baseHungerRate>
      <foodType>CarnivoreAnimal</foodType>
      <trainability>Intermediate</trainability>
      <gestationPeriodDays>7</gestationPeriodDays>
      <manhunterOnDamageChance>0.15</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0.1</manhunterOnTameFailChance>
      <litterSizeCurve>
        <points>
          <li>(0.5, 0)</li>
          <li>(1, 1)</li>
          <li>(2, 0.5)</li>
          <li>(2.5, 0)</li>
        </points>
      </litterSizeCurve>
      <lifeExpectancy>14</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.15</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.4</minAge>
        </li>
      </lifeStageAges>
    </race>
    <tradeTags>
      <li>AnimalUncommon</li>
    </tradeTags>
  </ThingDef>

  <PawnKindDef ParentName="AnimalKindBase">
    <defName>RUT_FireHawk</defName>
    <label>fire-hawk</label>
    <race>RUT_FireHawk</race>
    <combatPower>60</combatPower>
    <wildGroupSize>1~2</wildGroupSize>
    <ecoSystemWeight>0.3</ecoSystemWeight>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/Pyrelands/FireHawk/FireHawk</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>0.6</drawSize>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/Pyrelands/FireHawk/FireHawk</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>0.85</drawSize>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/Pyrelands/FireHawk/FireHawk</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.1</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>


  <ThingDef ParentName="AnimalThingBase">
    <defName>RUT_FurnaceBeast</defName>
    <label>furnace-beast</label>
    <description>A migratory megafauna whose banded mineral hide stores heat like a stove: weeks basking in the deep dayside, then walking out across the grass radiating warmth from glowing seams between its plates. Travelers follow the herds for warmth in the cold and give them a wide, respectful berth in the dry -- their bed-down grounds have been known to smolder alight on their own. Keeping one is possible. It is very hard, it goes badly more often than it goes well, and it never stops being a fire hazard: a kept beast heats your barn for nothing, and every so often it sets the floor of that barn alight.</description>
    <statBases>
      <MoveSpeed>3.6</MoveSpeed>
      <MarketValue>900</MarketValue>
      <ComfyTemperatureMin>-10</ComfyTemperatureMin>
      <ComfyTemperatureMax>70</ComfyTemperatureMax>
      <ArmorRating_Blunt>0.35</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.3</ArmorRating_Sharp>
      <ArmorRating_Heat>0.6</ArmorRating_Heat>
      <Wildness>0.97</Wildness>
    </statBases>
    <tools>
      <!-- HornAttackTool, not HeadAttackTool: body
           QuadrupedAnimalWithHoovesAndHorn carries a Horn subpart with its
           own HornAttackTool group specifically so a horn attack is tied
           to the horn organ (and stops working if it's lost), matching
           every vanilla horned animal (e.g.
           Defs/Core/ThingDefs_Races/Races_Animal_CowGroup.xml). -->
      <li>
        <label>horn</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>18</power>
        <cooldownTime>2.4</cooldownTime>
        <linkedBodyPartsGroup>HornAttackTool</linkedBodyPartsGroup>
      </li>
      <li>
        <label>left foot</label>
        <labelNoLocation>foot</labelNoLocation>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>15</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftLeg</linkedBodyPartsGroup>
      </li>
      <li>
        <label>right foot</label>
        <labelNoLocation>foot</labelNoLocation>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>15</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>FrontRightLeg</linkedBodyPartsGroup>
      </li>
    </tools>
    <race>
      <body>QuadrupedAnimalWithHoovesAndHorn</body>
      <herdAnimal>true</herdAnimal>
      <predator>false</predator>
      <!-- §8a change 2: off None. Intermediate matches the fire-hawk, so the
           two igniters train alike; the gauntlet is the taming, not the
           training. -->
      <trainability>Intermediate</trainability>
      <baseBodySize>3.2</baseBodySize>
      <baseHealthScale>2.8</baseHealthScale>
      <baseHungerRate>1.4</baseHungerRate>
      <foodType>VegetarianRoughAnimal</foodType>
      <!-- §8a change 5 / §12: the bespoke hide, Defs/ThingDefs_Items/RUT_FurnaceHide.xml. -->
      <leatherDef>RUT_FurnaceHide</leatherDef>
      <gestationPeriodDays>12</gestationPeriodDays>
      <manhunterOnDamageChance>0.15</manhunterOnDamageChance>
      <!-- §8a change 4: KEEP. Dead weight while the beast was untameable; now
           it is the taming gauntlet - every failed attempt is a furious stove.
           Do not lower it to "make taming work". -->
      <manhunterOnTameFailChance>0.9</manhunterOnTameFailChance>
      <litterSizeCurve>
        <points>
          <li>(0.5, 0)</li>
          <li>(1, 1)</li>
          <li>(1.5, 0)</li>
        </points>
      </litterSizeCurve>
      <lifeExpectancy>45</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.3</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.6</minAge>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
      <soundEating>Herbivore_Eat</soundEating>
    </race>
    <tradeTags>
      <li>AnimalExotic</li>
    </tradeTags>
  </ThingDef>

  <PawnKindDef ParentName="AnimalKindBase">
    <defName>RUT_FurnaceBeast</defName>
    <label>furnace-beast</label>
    <race>RUT_FurnaceBeast</race>
    <combatPower>220</combatPower>
    <wildGroupSize>3~7</wildGroupSize>
    <ecoSystemWeight>0.6</ecoSystemWeight>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/Pyrelands/FurnaceBeast/FurnaceBeast</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.6</drawSize>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/Pyrelands/FurnaceBeast/FurnaceBeast</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>2.4</drawSize>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/Pyrelands/FurnaceBeast/FurnaceBeast</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>3.2</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>

</Defs>
