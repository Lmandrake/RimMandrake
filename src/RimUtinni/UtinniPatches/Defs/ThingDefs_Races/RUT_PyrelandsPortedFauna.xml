  <!-- ======================================================================
       RUT_FireWasp — was AA_FireWasp (Alpha Animals).
       Small-predator band, Pyrelands commonality 0.40. Label unchanged;
       description rewritten, and deliberately makes no promise about eggs,
       because the donor's heat-producing egg items are not ported.
       Body is Core's BeetleLike (Mouth + HeadAttackTool). The donor's third
       tool linked LegAttackTool, a group BeetleLike does not carry, so it is
       dropped rather than written dead — see RUT_PyrelandsFauna.xml's fire-hawk
       note for the same class of defect found and fixed there.
       ====================================================================== -->
  <ThingDef ParentName="AnimalThingBase">
    <defName>RUT_FireWasp</defName>
    <label>fire wasp</label>
    <description>A slow, drifting insect that lives inside the heat rather than beside it, plated in a scale that will not take a flame at all. Fire wasps hang over a burn in loose swarms, riding the column of hot air and dropping onto whatever the fire has already killed or crippled; a single one is barely a threat to a grown person, and a swarm of them over a fresh burn is a reason to walk the long way around.</description>
    <statBases>
      <MoveSpeed>1.5</MoveSpeed>
      <ComfyTemperatureMin>10</ComfyTemperatureMin>
      <ComfyTemperatureMax>175</ComfyTemperatureMax>
      <MarketValue>350</MarketValue>
      <ArmorRating_Heat>1</ArmorRating_Heat>
      <Flammability>0</Flammability>
      <Wildness>0.7</Wildness>
    </statBases>
    <tools>
      <li>
        <label>sting</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>3</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
        <chanceFactor>0.8</chanceFactor>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>2</power>
        <cooldownTime>1.85</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.1</chanceFactor>
      </li>
    </tools>
    <race>
      <body>BeetleLike</body>
      <herdAnimal>true</herdAnimal>
      <predator>true</predator>
      <maxPreyBodySize>0.5</maxPreyBodySize>
      <baseBodySize>0.79</baseBodySize>
      <baseHealthScale>2</baseHealthScale>
      <baseHungerRate>0.3</baseHungerRate>
      <foodType>OmnivoreAnimal</foodType>
      <manhunterOnDamageChance>0.02</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0.02</manhunterOnTameFailChance>
      <trainability>None</trainability>
      <fleshType>Insectoid</fleshType>
      <leatherDef>Leather_Chitin</leatherDef>
      <bloodDef>Filth_BloodInsect</bloodDef>
      <bloodSmearDef>Filth_BloodSmear</bloodSmearDef>
      <useMeatFrom>Megaspider</useMeatFrom>
      <gestationPeriodDays>8</gestationPeriodDays>
      <litterSizeCurve>
        <points>
          <li>(0.99, 0)</li>
          <li>(1, 1)</li>
          <li>(1.01, 0)</li>
        </points>
      </litterSizeCurve>
      <lifeExpectancy>15</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.25</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.5</minAge>
          <soundWounded>Pawn_BigInsect_Pain</soundWounded>
          <soundDeath>Pawn_BigInsect_Death</soundDeath>
          <soundCall>Pawn_BigInsect_Call</soundCall>
          <soundAngry>Pawn_BigInsect_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
      <soundEating>Insectoid_Eat</soundEating>
    </race>
    <tradeTags>
      <li>AnimalUncommon</li>
      <li>AnimalInsect</li>
    </tradeTags>
  </ThingDef>

