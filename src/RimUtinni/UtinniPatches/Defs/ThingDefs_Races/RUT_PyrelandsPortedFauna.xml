        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>20</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>HeadClaw</linkedBodyPartsGroup>
      </li>
      <li>
        <label>right pincer</label>
        <labelNoLocation>pincer</labelNoLocation>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>20</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>HeadClaw</linkedBodyPartsGroup>
      </li>
      <li>
        <label>sting</label>
        <capacities>
          <li>ToxicBite</li>
        </capacities>
        <power>15</power>
        <cooldownTime>2</cooldownTime>
