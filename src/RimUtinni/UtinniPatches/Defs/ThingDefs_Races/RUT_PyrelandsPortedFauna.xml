  <!-- ======================================================================
       RUT_Sytheclaw — was AA_Razorjack (Alpha Animals).
       Fire-follower band, Pyrelands commonality 0.20; also the floor-predator /
       "the-pickers" rows in RUT_Greentide, RUT_Contagion, BiomeCypreJungle and
       AB_OcularForest, all repointed here in the same change.
       Body: the donor's AA_DualJawedQuadruped is an Alpha Animals BodyDef, so
       this uses Core's QuadrupedAnimalWithPawsAndTail instead — MEASURED to
       carry the exact four groups the donor's tools link to (FrontLeftPaw,
       FrontRightPaw, Teeth, HeadAttackTool), because vanilla Warg links the
       same four on that same body. The dual jaw was lore, never a body part.
       ====================================================================== -->
  <ThingDef ParentName="AnimalThingBase">
    <defName>RUT_Sytheclaw</defName>
    <label>sytheclaw</label>
    <description>A low-slung pack predator built for the tall gold grass of the burning plains. Above, its plates are the same dry yellow-gold as the standing quickgrass, so a hunting sytheclaw is a ripple in the field and nothing more; below, its underside is a raw furnace red that the prey only sees late. It trails the fire fronts the way other things trail water, taking whatever the smoke pushes out of cover, and its serrated forelimb blades leave a wound that ash gets into and keeps.</description>
    <statBases>
      <MoveSpeed>4.00</MoveSpeed>
      <ComfyTemperatureMin>-50</ComfyTemperatureMin>
      <ComfyTemperatureMax>74.3</ComfyTemperatureMax>
      <MarketValue>350</MarketValue>
      <FilthRate>2</FilthRate>
      <Wildness>0.75</Wildness>
    </statBases>
    <tools>
      <li>
        <label>left blade</label>
        <labelNoLocation>blade</labelNoLocation>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>13</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>14</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>right blade</label>
        <labelNoLocation>blade</labelNoLocation>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>13</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>14</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>fangs</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>15</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        <chanceFactor>0.9</chanceFactor>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>14</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>5</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <race>
      <body>QuadrupedAnimalWithPawsAndTail</body>
      <predator>true</predator>
      <maxPreyBodySize>2</maxPreyBodySize>
      <baseBodySize>1</baseBodySize>
      <baseHealthScale>2</baseHealthScale>
      <baseHungerRate>0.05</baseHungerRate>
      <foodType>OmnivoreRoughAnimal</foodType>
      <leatherDef>Leather_Plain</leatherDef>
      <trainability>Advanced</trainability>
      <specialTrainables>
        <li MayRequire="Ludeon.RimWorld.Odyssey">AttackTarget</li>
      </specialTrainables>
      <manhunterOnTameFailChance>0.10</manhunterOnTameFailChance>
      <manhunterOnDamageChance>0.75</manhunterOnDamageChance>
      <gestationPeriodDays>10</gestationPeriodDays>
