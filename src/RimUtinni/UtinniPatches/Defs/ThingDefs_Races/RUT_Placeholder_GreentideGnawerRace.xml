<?xml version="1.0" encoding="utf-8"?>
<!--
  RUT_Placeholder_GreentideGnawerRace.xml   UtinniPatches — GREENTIDE_MECHANICS_2 M6

  PLACEHOLDER Gnawer race for feller 3 ("gnawed from below") — NOT the real
  Greentide Gnawer the roster pass eventually authors (this task's own
  brief explicitly forbids authoring that here). Same recolored-Squirrel
  stub shape RUT_Placeholder_SumpMouseRace already established in this repo
  for the identical situation (a mechanic needing SOME live creature to
  prove it compiles and is reachable, roster content owed) — read that
  file's own header in full before writing this one; every field below
  mirrors it except the modExtension and the tint.

  ParentName="AnimalThingBase" (not "Squirrel" — Squirrel carries no
  Name="..." attribute, confirmed the same way SumpMouseRace's own header
  already records; every Squirrel-specific field AnimalThingBase does not
  already provide is copied down directly, identical set).

  No new art: recolored via the PawnKindDef's own lifeStages
  (RUT_Placeholder_GreentideGnawer.xml, PawnKindDefs/) reusing Squirrel's
  own real texPath with a mossy-green tint, distinct from SumpMouse's own
  near-black recolor of the same base sprite — zero new sprites, and (per
  that file's own header) this exact reuse already proved safe once in
  this repo (no DEPLOY_HOLD needed).

  modExtensions: RM_GnawTreeBaseExtension is the marker+tuning
  RM_JobGiver_GnawTreeBase.TryGiveJob checks for (RM_JobGiver_GnawTreeBase.cs)
  — see that class's own header for why the seam is a globally-inserted,
  marker-gated JobGiver rather than a per-race ThinkTreeDef override.
-->
<Defs>

  <ThingDef ParentName="AnimalThingBase">
    <defName>RUT_Placeholder_GreentideGnawerRace</defName>
    <label>gnawer (placeholder)</label>
    <description>PLACEHOLDER — a recolored squirrel standing in for the real Greentide gnawer (roster pass owed). Works a giant's roots at the base until the whole canopy comes down.</description>
    <race>
      <body>QuadrupedAnimalWithPawsAndTail</body>
      <baseBodySize>0.3</baseBodySize>
      <baseHealthScale>0.35</baseHealthScale>
      <baseHungerRate>0.12</baseHungerRate>
      <foodType>VegetarianRoughAnimal</foodType>
      <leatherDef>Leather_Light</leatherDef>
      <gestationPeriodDays>5.661</gestationPeriodDays>
      <soundEating>Rodent_Eat</soundEating>
      <litterSizeCurve>
        <points>
          <li>(0.5, 0)</li>
          <li>(1, 1)</li>
          <li>(1.8, 1)</li>
          <li>(2.4, 0)</li>
        </points>
      </litterSizeCurve>
      <lifeExpectancy>8</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.11</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.2222</minAge>
          <soundWounded>Pawn_Rodent_Wounded</soundWounded>
          <soundDeath>Pawn_Rodent_Death</soundDeath>
          <soundCall>Pawn_Rodent_Call</soundCall>
          <soundAngry>Pawn_Rodent_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
      <headPosPerRotation>
        <li>(0.0, 0, 0.17)</li>
        <li>(0.2, 0, 0)</li>
        <li>(0.0, 0, -0.15)</li>
        <li>(-0.2, 0, 0)</li>
      </headPosPerRotation>
    </race>
    <statBases>
      <MoveSpeed>4.6</MoveSpeed>
      <MarketValue>35</MarketValue>
      <ComfyTemperatureMin>-25</ComfyTemperatureMin>
      <Wildness>0.75</Wildness>
    </statBases>
    <tools>
      <li>
        <label>left claw</label>
        <labelNoLocation>claw</labelNoLocation>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>4</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
      </li>
      <li>
        <label>right claw</label>
        <labelNoLocation>claw</labelNoLocation>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>4</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup>
      </li>
      <li>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>7</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        <chanceFactor>0.7</chanceFactor>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>2</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <modExtensions>
      <li Class="RimMandrake.EnvironmentalHazards.RM_GnawTreeBaseExtension" MayRequire="mandrake.rm.environmentalhazards">
        <searchRadius>40</searchRadius>
        <chewTicksToFell>2400</chewTicksToFell>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
