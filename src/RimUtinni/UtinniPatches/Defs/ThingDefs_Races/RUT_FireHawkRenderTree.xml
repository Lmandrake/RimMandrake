<?xml version="1.0" encoding="utf-8" ?>
<!-- FIREHAWK_FLIGHT_BEHAVIOR_1: wing-flap animation for RUT_FireHawk.
     Ground truth for this shape: vanilla Anomaly "Toughspike" render tree,
     Data/Anomaly/Defs/PawnRenderTreeDefs/PawnRenderTreeDefs.xml (Body node
     PawnRenderNode_AnimalPart + child PawnRenderNodeProperties_Spastic
     appendage nodes, linkedBodyPartsGroup + rotationRange/durationTicksRange/
     nextSpasmTicksRange + per-facing drawData) and its BodyPartGroupDef pair
     LeftSpike/RightSpike (Data/Anomaly/Defs/Bodies/Bodies_Fleshbeasts.xml,
     bare cosmetic groups: defName/label/labelShort/listOrder, no other
     fields). Base game engine type, no DLL, no MayRequire. -->
<Defs>

  <BodyPartGroupDef>
    <defName>RUT_FireHawkWing</defName>
    <label>wing</label>
    <labelShort>wing</labelShort>
    <listOrder>78</listOrder>
  </BodyPartGroupDef>

  <!-- Vanilla Bird corePart (Data/Core/Defs/Bodies/Bodies_Animal_Bird.xml),
       copied verbatim, plus one anchor part (a second Tail-def part,
       customLabel "wing", tiny coverage) tagged with RUT_FireHawkWing so the
       Spastic node below has a linkedBodyPartsGroup to attach to. Coverage is
       kept at 0.02 on purpose: this part must not meaningfully change combat
       (hit chance / damage spread), it only exists as a render anchor. -->
  <BodyDef>
    <defName>RUT_FireHawkBody</defName>
    <label>fire-hawk</label>
    <corePart>
      <def>Body</def>
      <height>Middle</height>
      <depth>Outside</depth>
      <parts>
        <li>
          <def>Tail</def>
          <coverage>0.10</coverage>
        </li>
        <li>
          <def>Tail</def>
          <customLabel>wing</customLabel>
          <coverage>0.02</coverage>
          <depth>Outside</depth>
          <groups>
            <li>RUT_FireHawkWing</li>
          </groups>
        </li>
        <li>
          <def>Spine</def>
          <coverage>0.05</coverage>
          <depth>Inside</depth>
        </li>
        <li>
          <def>Stomach</def>
          <coverage>0.04</coverage>
          <depth>Inside</depth>
        </li>
        <li>
          <def>Heart</def>
          <coverage>0.03</coverage>
          <depth>Inside</depth>
        </li>
        <li>
          <def>Lung</def>
          <customLabel>left lung</customLabel>
          <coverage>0.04</coverage>
          <depth>Inside</depth>
        </li>
        <li>
          <def>Lung</def>
          <customLabel>right lung</customLabel>
          <coverage>0.04</coverage>
          <depth>Inside</depth>
        </li>
        <li>
          <def>Kidney</def>
          <customLabel>left kidney</customLabel>
          <coverage>0.03</coverage>
          <depth>Inside</depth>
        </li>
        <li>
          <def>Kidney</def>
          <customLabel>right kidney</customLabel>
          <coverage>0.03</coverage>
          <depth>Inside</depth>
        </li>
        <li>
          <def>Liver</def>
          <coverage>0.05</coverage>
          <depth>Inside</depth>
        </li>
        <li>
          <def>Neck</def>
          <coverage>0.2</coverage>
          <height>Top</height>
          <parts>
            <li>
              <def>HeadWithEarHoles</def>
              <coverage>0.75</coverage>
              <groups>
                <li>HeadAttackTool</li>
              </groups>
              <parts>
                <li>
                  <def>Skull</def>
                  <coverage>0.30</coverage>
                  <depth>Inside</depth>
                  <parts>
                    <li>
                      <def>Brain</def>
                      <coverage>0.60</coverage>
                      <depth>Inside</depth>
                    </li>
                  </parts>
                </li>
                <li>
                  <def>Eye</def>
                  <customLabel>left eye</customLabel>
                  <coverage>0.12</coverage>
                </li>
                <li>
                  <def>Eye</def>
                  <customLabel>right eye</customLabel>
                  <coverage>0.12</coverage>
                </li>
                <li>
                  <def>Beak</def>
                  <coverage>0.25</coverage>
                  <groups>
                    <li>Beak</li>
                  </groups>
                </li>
              </parts>
            </li>
          </parts>
        </li>
        <li>
          <def>Leg</def>
          <customLabel>left leg</customLabel>
          <coverage>0.10</coverage>
          <height>Bottom</height>
          <parts>
            <li>
              <def>Foot</def>
              <customLabel>left foot</customLabel>
              <coverage>0.5</coverage>
              <groups>
                <li>Feet</li>
              </groups>
            </li>
          </parts>
        </li>
        <li>
          <def>Leg</def>
          <customLabel>right leg</customLabel>
          <coverage>0.10</coverage>
          <height>Bottom</height>
          <parts>
            <li>
              <def>Foot</def>
              <customLabel>right foot</customLabel>
              <coverage>0.5</coverage>
              <groups>
                <li>Feet</li>
              </groups>
            </li>
          </parts>
        </li>
      </parts>
    </corePart>
  </BodyDef>

  <!-- Single whole-wing flap: one Spastic node over the body layer, not a
       separate L/R split (no clean L/R sprites — north/south art is already
       a symmetric pair, east is a single near-wing). Fields copied from
       Toughspike's SpikeL/SpikeR, values tuned gentler per the item's ask
       (rotationRange -18~18, durationTicksRange 8~22, nextSpasmTicksRange
       15~60) — a slow flap, not a seizure. drawSize 0.85 matches the FireHawk
       PawnKindDef's ADULT lifeStage bodyGraphicData.drawSize; baby (0.6) and
       juvenile (kept at the AnimalJuvenile default, see PawnKindDef) stages
       will show the wing overlay at adult scale since a render tree is not
       life-stage-indexed — a known v1 mismatch, not a defect to chase now. -->
  <PawnRenderTreeDef>
    <defName>RUT_FireHawk</defName>
    <root Class="PawnRenderNodeProperties_Parent">
      <debugLabel>Root</debugLabel>
      <tagDef>Root</tagDef>
      <children>
        <li>
          <debugLabel>Body</debugLabel>
          <tagDef>Body</tagDef>
          <useRottenColor>true</useRottenColor>
          <nodeClass>PawnRenderNode_AnimalPart</nodeClass>
          <children>
            <li Class="PawnRenderNodeProperties_Spastic">
              <debugLabel>Wings</debugLabel>
              <linkedBodyPartsGroup>RUT_FireHawkWing</linkedBodyPartsGroup>
              <texPath>Things/Pawn/Animal/Pyrelands/FireHawk/FireHawk_Wing</texPath>
              <rotateFacing>false</rotateFacing>
              <rotationRange>-18~18</rotationRange>
              <durationTicksRange>8~22</durationTicksRange>
              <nextSpasmTicksRange>15~60</nextSpasmTicksRange>
              <drawSize>0.85</drawSize>
              <baseLayer>10</baseLayer>
              <useRottenColor>true</useRottenColor>
              <drawData>
                <dataNorth>
                  <offset>(0, 0.01, 0)</offset>
                </dataNorth>
                <dataEast>
                  <offset>(0, 0, 0)</offset>
                </dataEast>
                <dataSouth>
                  <offset>(0, 0, 0)</offset>
                </dataSouth>
                <dataWest>
                  <offset>(0, 0, 0)</offset>
                  <flip>true</flip>
                </dataWest>
              </drawData>
            </li>
          </children>
        </li>
        <li Class="PawnRenderNodeProperties_Carried">
          <debugLabel>Carried thing</debugLabel>
          <workerClass>PawnRenderNodeWorker_Carried</workerClass>
        </li>
      </children>
    </root>
  </PawnRenderTreeDef>

</Defs>
