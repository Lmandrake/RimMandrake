<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_Visceral.xml - plain port of mlie.horrors' Visceral (+ its BodyVisceral / RaptorialLegs body parts), 2026-10-18,
  so the donor can retire (TAIL_DONOR_ART_RETIREMENT). Stats, verbs, body and life stages are verbatim; dropped: the
  donor's HiveMind/HorrorConstant think trees and NamerAnimalHorrors (that mod's AI/namer), the Horrors faction link.
  Art: the finished Visceral redraw already in this mod (Textures/RimUtinni/UtinniPatches/Visceral/), formerly
  folded over the donor path by ArtFold/Visceral_ArtFold.xml. Meat: RUT_VisceralMeat (RUT_CauldronPrizedMeats.xml),
  set here directly instead of by the old Cauldron_ToxicPrizedMeat.xml patch. Yield rows baked in from MegafaunaYield
  (meat 168).
-->
<Defs>
  <BodyPartGroupDef>
    <defName>RM_RaptorialLegs</defName>
    <label>raptorial legs</label>
  </BodyPartGroupDef>
  <BodyPartDef>
    <defName>RM_LeftRaptorialLeg</defName>
    <label>left raptorial leg</label>
    <hitPoints>20</hitPoints>
    <frostbiteVulnerability>5</frostbiteVulnerability>
    <skinCovered>false</skinCovered>
    <tags>
      <li>ManipulationLimbCore</li>
    </tags>
  </BodyPartDef>
  <BodyPartDef>
    <defName>RM_RightRaptorialLeg</defName>
    <label>right raptorial leg</label>
    <hitPoints>20</hitPoints>
    <frostbiteVulnerability>5</frostbiteVulnerability>
    <skinCovered>false</skinCovered>
    <tags>
      <li>ManipulationLimbCore</li>
    </tags>
  </BodyPartDef>
  <BodyDef>
    <defName>RM_BodyVisceral</defName>
    <label>quadroped with raptorial legs</label>
    <corePart>
      <def>Shell</def>
      <height>Middle</height>
      <depth>Outside</depth>
      <parts>
        <li><def>Elytra</def><coverage>0.05</coverage></li>
        <li><def>Elytra</def><coverage>0.05</coverage></li>
        <li><def>Stomach</def><coverage>0.05</coverage><depth>Inside</depth></li>
        <li><def>InsectHeart</def><coverage>0.03</coverage><depth>Inside</depth></li>
        <li>
          <def>Pronotum</def>
          <coverage>0.08</coverage>
          <height>Top</height>
          <parts>
            <li>
              <def>InsectHead</def>
              <coverage>0.65</coverage>
              <parts>
                <li><def>Brain</def><coverage>0.2</coverage><depth>Inside</depth></li>
                <li><def>Eye</def><coverage>0.15</coverage></li>
                <li><def>Eye</def><coverage>0.15</coverage></li>
                <li><def>Antenna</def><coverage>0.05</coverage></li>
                <li><def>Antenna</def><coverage>0.05</coverage></li>
                <li><def>InsectNostril</def><coverage>0.1</coverage></li>
                <li><def>InsectMouth</def><coverage>0.05</coverage><groups><li>Mouth</li></groups></li>
              </parts>
            </li>
          </parts>
        </li>
        <li><def>RM_LeftRaptorialLeg</def><coverage>0.06</coverage><height>Top</height><groups><li>RM_RaptorialLegs</li></groups></li>
        <li><def>RM_RightRaptorialLeg</def><coverage>0.06</coverage><height>Top</height><groups><li>RM_RaptorialLegs</li></groups></li>
        <li><def>InsectLeg</def><coverage>0.06</coverage><height>Bottom</height></li>
        <li><def>InsectLeg</def><coverage>0.06</coverage><height>Bottom</height></li>
        <li><def>InsectLeg</def><coverage>0.06</coverage><height>Bottom</height></li>
        <li><def>InsectLeg</def><coverage>0.06</coverage><height>Bottom</height></li>
      </parts>
    </corePart>
  </BodyDef>

  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Visceral</defName>
    <label>visceral</label>
    <description>An alien (or at least unknown) creature of rigor and veracity. About the size of a human and much more dangerous. Armed with rending raptorial legs and a maw capable of tearing into even the toughest hide.</description>
    <statBases>
      <MoveSpeed>3.85</MoveSpeed>
      <ComfyTemperatureMin>-40</ComfyTemperatureMin>
      <MarketValue>700</MarketValue>
      <LeatherAmount>0</LeatherAmount>
      <Flammability>1.0</Flammability>
      <ArmorRating_Blunt>0.1</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.15</ArmorRating_Sharp>
      <Wildness>0.95</Wildness>
      <ToxicResistance>1</ToxicResistance>
      <ToxicEnvironmentResistance MayRequire="Ludeon.RimWorld.Biotech">0.8</ToxicEnvironmentResistance>
      <MeatAmount>168</MeatAmount>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_MeleeAttackDamage</verbClass>
        <defaultCooldownTime>1.9</defaultCooldownTime>
        <meleeDamageBaseAmount>18</meleeDamageBaseAmount>
        <meleeDamageDef>Cut</meleeDamageDef>
        <linkedBodyPartsGroup>RM_RaptorialLegs</linkedBodyPartsGroup>
      </li>
      <li>
        <verbClass>Verb_MeleeAttackDamage</verbClass>
        <defaultCooldownTime>1.9</defaultCooldownTime>
        <meleeDamageBaseAmount>6</meleeDamageBaseAmount>
        <meleeDamageDef>Bite</meleeDamageDef>
        <linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
      </li>
    </verbs>
    <race>
      <body>RM_BodyVisceral</body>
      <fleshType>Insectoid</fleshType>
      <bloodDef>Filth_BloodInsect</bloodDef>
      <meatColor>(160,150,140)</meatColor>
      <specificMeatDef>RUT_VisceralMeat</specificMeatDef>
      <foodType>CarnivoreAnimal, AnimalProduct</foodType>
      <intelligence>Animal</intelligence>
      <hasGenders>false</hasGenders>
      <herdAnimal>true</herdAnimal>
      <predator>true</predator>
      <manhunterOnDamageChance>1</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0.11</manhunterOnTameFailChance>
      <nameOnTameChance>1</nameOnTameChance>
      <trainability>Advanced</trainability>
      <baseHungerRate>0.35</baseHungerRate>
      <baseBodySize>1.2</baseBodySize>
      <baseHealthScale>1.5</baseHealthScale>
      <gestationPeriodDays>10</gestationPeriodDays>
      <meatLabel>insect meat</meatLabel>
      <lifeExpectancy>6</lifeExpectancy>
      <lifeStageAges>
        <li><def>EusocialInsectLarva</def><minAge>0</minAge></li>
        <li><def>EusocialInsectJuvenile</def><minAge>0.03</minAge></li>
        <li>
          <def>EusocialInsectAdult</def>
          <minAge>0.2</minAge>
          <soundWounded>Pawn_BigInsect_Pain</soundWounded>
          <soundDeath>Pawn_BigInsect_Death</soundDeath>
          <soundCall>Pawn_BigInsect_Call</soundCall>
          <soundAngry>Pawn_BigInsect_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
    </race>
    <ingredient>
      <mergeCompatibilityTags>
        <li MayRequire="Ludeon.RimWorld.Ideology">InsectMeat</li>
      </mergeCompatibilityTags>
    </ingredient>
    <tradeTags>
      <li>Insectoid</li>
    </tradeTags>
  </ThingDef>
  <PawnKindDef ParentName="AnimalKindBase">
    <defName>RM_Visceral</defName>
    <label>Visceral</label>
    <race>RM_Visceral</race>
    <combatPower>150</combatPower>
    <ecoSystemWeight>0.2</ecoSystemWeight>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>RimUtinni/UtinniPatches/Visceral/VisceralBaby</texPath>
          <drawSize>1.8</drawSize>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Megaspider/Dessicated_Megaspider</texPath>
          <drawSize>2</drawSize>
        </dessicatedBodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>RimUtinni/UtinniPatches/Visceral/VisceralTeen</texPath>
          <drawSize>2.4</drawSize>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Megaspider/Dessicated_Megaspider</texPath>
          <drawSize>2.4</drawSize>
        </dessicatedBodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>RimUtinni/UtinniPatches/Visceral/Visceral</texPath>
          <drawSize>2.5</drawSize>
          <shadowData>
            <volume>(0.5, 0.7, 0.43)</volume>
            <offset>(0,0,-0.1)</offset>
          </shadowData>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Megaspider/Dessicated_Megaspider</texPath>
          <drawSize>2.5</drawSize>
        </dessicatedBodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>
</Defs>
