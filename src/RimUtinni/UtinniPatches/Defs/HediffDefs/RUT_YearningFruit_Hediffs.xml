<?xml version="1.0" encoding="utf-8"?>
<!--
  RUT_YearningFruit_Hediffs.xml          UtinniPatches - COMMISSION_LEDGER_CLEANUP_1

  The digestive-accelerant hediff RUT_YearningFruit.xml applies. Ships the
  "digests fast / hunger returns / brief waddle" half of the_greentide.md
  §4's mechanic with real vanilla stats — HungerRateMultiplier (statFactors)
  and a short MoveSpeed penalty. hediffClass is HediffWithComps explicitly
  (RUT_Vorrel_Hediffs.xml's own header names the trap: the default
  Verse.Hediff carries no comps at all, so a comps block on an unstated
  class loads clean and silently does nothing).

  GREENTIDE_YEARNING_FRUIT_FILTH_1 (built this pass) closes the "passes seed
  quickly, filth follows, the ground sprouts" half: RM_HediffComp_SeedPassage
  (mandrake.rm.creaturebehaviors, same shape as RM_HediffComp_ShadeStagger,
  DESERT_STAGGERSEED_BUILD_1, but firing on the hediff's own natural end
  rather than on the carrier's death) drops filth and rolls a chance to
  germinate a fresh RUT_YearningFruit seedling wherever the eater happens to
  be standing when the accelerant runs its course — colonist or wild grazer
  alike. Filth_AnimalFilth is vanilla (confirmed elsewhere in this repo,
  e.g. Ikee_Tuning.xml, RSW_BeastLairs_Buildings.xml) and reads as manure/
  droppings, which is exactly the "seed-rich droppings" flavor this wants —
  no new art needed.
-->
<Defs>

  <HediffDef>
    <defName>RUT_DigestiveAccelerant</defName>
    <label>digestive accelerant</label>
    <description>A gutful of accelerant compounds off a yearning fruit, pushing everything through fast. The calories land quickly and so does the appetite again after — and for a short while after eating, the body would rather sit still than move.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9, 0.55, 0.25)</defaultLabelColor>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <isBad>false</isBad>
    <makesAlert>false</makesAlert>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <!-- ~4 game hours from a full 1.0 dose (1.0 / 6.0 * 24) — "a brief
           waddle", not a lasting condition. -->
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-6.0</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
      <!-- GREENTIDE_YEARNING_FRUIT_FILTH_1: fires once, when severity decays
           to 0 and the hediff is naturally removed. -->
      <li Class="RimMandrake.CreatureBehaviors.RM_HediffCompProperties_SeedPassage" MayRequire="mandrake.rm.creaturebehaviors">
        <filthDef>Filth_AnimalFilth</filthDef>
        <filthCount>1</filthCount>
        <germinateThingDef>RUT_YearningFruit</germinateThingDef>
        <germinateChance>0.5</germinateChance>
        <germinateCount>1~2</germinateCount>
        <germinateRadius>2.5</germinateRadius>
        <germinateGrowth>0.05</germinateGrowth>
      </li>
    </comps>
    <stages>
      <li>
        <label>digesting fast</label>
        <statFactors>
          <HungerRateMultiplier>1.6</HungerRateMultiplier>
          <MoveSpeed>0.75</MoveSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

</Defs>
