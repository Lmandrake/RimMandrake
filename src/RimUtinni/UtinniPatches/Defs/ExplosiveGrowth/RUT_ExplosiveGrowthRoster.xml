<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    EXPLOSIVE_PLANT_GROWTH_1 — the CAMPAIGN half of the roster: the RUT_ and
    RSW_ plants and the Star Wars donor flora the frozen world rosters carry.
    Ships in the Utinni patch layer (mandrake.rut.patches), which hard-depends
    on mandrake.rm.biomes (the engine's home). Moved here from the retired
    mandrake.rut.plantgrowth (PLANT_GROWTH_MERGE_NEVER_MEANT_APART, 2026-10-16).
    The RM-tier half (AB_/RG_/vanilla/RM_ rows) ships with the engine.

    scopeAllBiomes: the engine (everyday bands and the soak) runs only in Baroque
    Biomes' own biomes by default, with an unsupported option for every biome.
    The owner called that option "irrelevant in Utinni": this campaign's world IS
    the game, and its RUT_ twins of our biomes are UtinniPatches BiomeDefs outside
    Baroque Biomes. So while this roster is loaded every biome is in scope
    (exemptions still apply) and the option is moot. This is the former Jawa
    Plant Growth's "every plant from every mod", unchanged for the campaign.

    Source: design/RimUtinni/explosive_plant_growth_roster.md, regenerated
    2026-09-21 against ruling 4 (water scarcity decides). CHURN is the default
    and is not listed. Where the roster names a donor SW crop by its bare
    donor name (Plant_*_Wild) AND our port carries an RSW_ twin, BOTH are listed
    (the roster's own UNMEASURED note: which name the game loads is not known
    offline) — an absent name is skipped silently.
  -->
  <RimMandrake.ExplosiveGrowth.RM_ExplosiveGrowthRosterDef>
    <defName>RUT_ExplosiveGrowthRoster_Campaign</defName>
    <scopeAllBiomes>true</scopeAllBiomes>

    <plants>
      <!-- BURST — dry-adapted: one chance in years, spent all at once. -->
      <li><plant>RM_BloomCrop</plant><top>Burst</top></li>                 <!-- the flagship; RUT_BloomBurst's sprout -->
      <li><plant>Plant_HubbaGourd_Wild</plant><top>Burst</top></li>         <!-- ruled 2026-09-21: bursts in the Greentide too -->
      <li><plant>RSW_Plant_HubbaGourd_Wild</plant><top>Burst</top></li>
      <li><plant>RSW_Scrubgrass</plant><top>Burst</top></li>
      <li><plant>RM_CrackedThornwood</plant><top>Burst</top></li>        <!-- hard call 4 -->
      <li><plant>RM_TwistingThornweed</plant><top>Burst</top></li>
      <li><plant>RM_TwistingThorngrass</plant><top>Burst</top></li>

      <!-- FLUSH — the Fever Wood giant. -->
      <li><plant>RSW_Plant_HydenockTree_Wild</plant><top>Flush</top></li>

      <!-- RUPTURE — the RustPuff under its old RUT_ name (RM_ row is in the RM roster). -->
      <li><plant>RUT_RustPuff</plant><top>Rupture</top></li>

      <!-- CHURN, heavy produce — former GLUT rows. 🄸 produceFactor 2.5. -->
      <li><plant>Plant_MujaFruit_Wild</plant><top>Churn</top><produceFactor>2.5</produceFactor></li>
      <li><plant>RSW_Plant_MujaFruit_Wild</plant><top>Churn</top><produceFactor>2.5</produceFactor></li>
      <li><plant>RSW_Plant_JoganTree_Wild</plant><top>Churn</top><produceFactor>2.5</produceFactor></li>
      <li><plant>RM_GiantLeaf</plant><top>Churn</top><produceFactor>2.5</produceFactor></li>
      <li><plant>Plant_FelucianGlowspore_Wild</plant><top>Churn</top><produceFactor>2.5</produceFactor></li>
      <li><plant>Plant_Bubblespore_Wild</plant><top>Churn</top><produceFactor>2.5</produceFactor></li>
      <li><plant>Plant_Chakroot_Wild</plant><top>Churn</top><produceFactor>2.5</produceFactor></li>
      <li><plant>RSW_Plant_Chakroot_Wild</plant><top>Churn</top><produceFactor>2.5</produceFactor></li>

      <!-- NONE — the roster's deliberate exclusions, campaign-tier names. -->
      <li><plant>RUT_PaleTree</plant><top>None</top></li>
      <li><plant>RUT_PaleMoss</plant><top>None</top></li>
      <li><plant>RM_DyingCreep</plant><top>None</top></li>                 <!-- hard call 3 -->
      <li><plant>RM_Ollim</plant><top>None</top></li>
      <li><plant>RM_LightPipeNub</plant><top>None</top></li>
      <li><plant>RM_SweetlineTree</plant><top>None</top></li>
      <li><plant>RM_ScorchedStars</plant><top>None</top></li>              <!-- hoarder, hard call 1 -->
      <li><plant>RM_HeatsinkFungus</plant><top>None</top></li>
      <li><plant>RUT_Placeholder_GreentideGiantTree</plant><top>None</top></li>
    </plants>

    <!-- Soak carve-outs (design doc §3). The terminator never soaks (R-G3:
         its water arrives as trace); the deep desert has HARD BAN 4, no fast
         growth at all (deep_desert.md §6, mapped to RUT_ExtremeDesert by
         elimination per design doc §8). A carve-out on the SOAK, never on the
         top: a dry plant anywhere else still bursts. -->
    <noSoakBiomes>
      <li>PoisonForest</li>
      <li>RM_Cauldron</li>
      <li>RUT_Cauldron</li>
      <li>RUT_ExtremeDesert</li>
    </noSoakBiomes>

    <!-- EVERYDAY BANDS, campaign half. The stalled (terminator) band: PoisonForest
         (Advanced Biomes) and the Cauldron, both tiers (sprint S0-7, agreed by card
         2026-10-16 on BIOME_SPRINT_PROVE_SCRUB_SETS_PACE: "add RUT_/RM_Cauldron to the
         stalled band and keep the RUT_ExtremeDesert x4 exemption"). RUT_ExtremeDesert
         stays OUT of this list: it is held still by noSoakBiomes above (HARD BAN 4). -->
    <terminatorBiomes>
      <li>PoisonForest</li>
      <li>RM_Cauldron</li>
      <li>RUT_Cauldron</li>
    </terminatorBiomes>
    <!-- Archetype seeds, campaign half (spec §4.3): the RUT_ twins of the wet biomes (C1, WP3). -->
    <wetNativeBiomes>
      <li>RUT_Greentide</li>
      <li>RUT_Miasma</li>
      <li>RUT_FeverWood</li>
      <li>RUT_Webwork</li>
      <li>RUT_Contagion</li>
      <!-- tree_burst_design_2026-10-17.md §6 (Q8): the Rot follows the wet-biome rulings; its plants' rows are in the RM roster. -->
      <li>RUT_TheRot</li>
    </wetNativeBiomes>
    <!-- OQ-3 (owner 2026-10-16): "Blowing snow melts like water and rain yes. It doesn't snow fuel." No Ash'karr biome
         snows any more: the only one that did, RUT_Umbra (the Auroral Umbra), now rains PROPANE instead (owner 2026-10-19:
         "it should NOT snow, it should rain propane"), and propane rain (rainRate 0) waters nothing. So no snowmelt biome is
         listed; the mechanism stays for any biome that adds one. -->
    <!-- OQ-7 (by card): Ash'karr is tidally locked: "always lit means always growing", so a lit plant never rests. -->
    <tidallyLockedWorld>true</tidallyLockedWorld>
  </RimMandrake.ExplosiveGrowth.RM_ExplosiveGrowthRosterDef>

</Defs>
