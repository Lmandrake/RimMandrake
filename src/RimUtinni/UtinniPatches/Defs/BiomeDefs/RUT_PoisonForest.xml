<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    RUT_PoisonForest                               UtinniPatches - authored 2026-09-09
    BIOME_OWNERSHIP_WAVE_1. Full sheet: design/Jawa/worldbuilding/biomes/
    poison_forest.md (FROZEN).

    MEASURED live on V26 (sheet SS2, owner accepted 2026-09-08): 557 tiles, arc
    envelope 56-115, core p10/p90 82-107, median 91.3 — straddling the terminator.
    Driving forces: weak scattered light, a cold stable ceiling (no day-night swing
    to drive one), and a ground that exhales metal-rich cold gas (SS3; explicitly NOT
    volcanic — ban 1 "No volcanism, lava, magma, steam or geysers. The vents are
    COLD").

    Weather: the donor's own baseWeatherCommonalities carries only one custom entry,
    `PoisonForestSpores` (BiomesPlus's own WeatherDef) — kept out of our own def
    rather than pulled in with a fresh MayRequire dependency, since a bespoke
    vent-gas WeatherDef is itself still-owed content (no sheet section authors one).
    Substituted with vanilla Fog at the donor's commonality (18 -> scaled to fill the
    table): "the light never changes and never comes from anywhere... lit like the
    inside of an overcast dawn that will not resolve" (SS1) reads as permanent fog
    more honestly than Clear. Clear itself zeroed: SS6 bans "direct sunlight cues —
    no beams, no dappling, no cast shadows." Rain/RainyThunderstorm/SnowGentle/
    SnowHard zeroed: ban 5 "No potable water source," and nothing in the sheet names
    a precipitation event (its whole water economy is condensate you must not drink,
    SS5).

    wildAnimals/wildPlants: transplanted from BiomeCast_Ashkarr.xml /
    BiomeFlora_Ashkarr.xml against rosters/poison_forest.json.

    NOT this pass's scope: the vent-gas WeatherDef itself (SS Owed); capped
    wellheads/gas-tap scaffold structures (SS8).

    COMMISSION_LEDGER_CLEANUP_1 (2026-09-24/25): the toxic-meat Star Wars cuisine
    chain landed (RUT_PoisonForestPrizedMeats.xml + Patches/
    PoisonForest_ToxicPrizedMeat.xml, same mod) — the line above calling it
    out-of-scope was true when written and is not true any more. Also added this
    pass: RSW_VentStalker (the ground-sense ambusher) and RUT_DarkCrust (the
    phototroph flora), both wired into wildAnimals/wildPlants below.

    FROZEN 2026-09-25 (POISONFOREST_RM_MOD_BUILD_1) — carrying the world until
    the terminal paint; content lives in mandrake.rm.poisonforest from here on;
    do not edit here.

  -->

  <BiomeDef>
    <defName>RUT_PoisonForest</defName>
    <generatesNaturally>false</generatesNaturally>
    <label>the Cauldron</label>
    <description>A low, wet-black forest standing in permanent dusk over ground that breathes. The light never changes and casts nothing you could call a shadow; trunks weep a grey metallic sweat that hardens into scabs and crystal fans. Nearly everything alive here is either sealed against the vented metal-rich gas or has processed the load and become toxic itself -- and nothing is fast, because a chemosynthetic budget is thin.</description>
    <workerClass>BiomesPlus.BiomeWorker_PoisonForest</workerClass>
    <lakeBeachTerrain>Marsh</lakeBeachTerrain>
    <mudTerrain>Marsh</mudTerrain>
    <riverbankTerrain>Riverbank</riverbankTerrain>
    <foragedFood>RawBerries</foragedFood>
    <allowRoads>true</allowRoads>
    <allowRivers>true</allowRivers>
    <allowFarmingCamps>true</allowFarmingCamps>
    <animalDensity>0.8</animalDensity>
    <plantDensity>0.5</plantDensity>
    <forageability>1.0</forageability>
    <movementDifficulty>2</movementDifficulty>
    <texture>Biomes/PoisonForest</texture>
    <diseaseMtbDays>30</diseaseMtbDays>
    <diseases>
      <li>
        <diseaseInc>Disease_Flu</diseaseInc>
        <commonality>100</commonality>
      </li>
      <li>
        <diseaseInc>Disease_Plague</diseaseInc>
        <commonality>100</commonality>
      </li>
      <li>
        <diseaseInc>Disease_Malaria</diseaseInc>
        <commonality>160</commonality>
      </li>
      <li>
        <diseaseInc>Disease_SleepingSickness</diseaseInc>
        <commonality>140</commonality>
      </li>
      <li>
        <diseaseInc>Disease_FibrousMechanites</diseaseInc>
        <commonality>30</commonality>
      </li>
      <li>
        <diseaseInc>Disease_SensoryMechanites</diseaseInc>
        <commonality>30</commonality>
      </li>
      <li>
        <diseaseInc>Disease_GutWorms</diseaseInc>
        <commonality>80</commonality>
      </li>
      <li>
        <diseaseInc>Disease_MuscleParasites</diseaseInc>
        <commonality>80</commonality>
      </li>
    </diseases>
    <terrainsByFertility>
      <li>
        <terrain>PoisonSoil</terrain>
        <min>-999</min>
        <max>0.87</max>
      </li>
      <li>
        <terrain>PoisonSoilRich</terrain>
        <min>0.87</min>
        <max>999</max>
      </li>
    </terrainsByFertility>
    <baseWeatherCommonalities>
      <Fog>90</Fog>
      <Clear>0</Clear>
      <DryThunderstorm>1</DryThunderstorm>
      <Rain>0</Rain>
      <RainyThunderstorm>0</RainyThunderstorm>
      <SnowGentle>0</SnowGentle>
      <SnowHard>0</SnowHard>
    </baseWeatherCommonalities>
    <wildAnimals>
      <Neebray MayRequire="mlie.starwarsanimalcollection">0.8</Neebray>  <!-- neebray - small-flier, keep -->
      <GR_Beetlefleet MayRequire="vanillaexpanded.vgeneticse">0.7</GR_Beetlefleet>  <!-- beetlefleet - small-shelled, keep -->
      <AA_InfectedAerofleet MayRequire="sarg.alphaanimals">0.5</AA_InfectedAerofleet>  <!-- infected aerofleet - small, keep -->
      <AA_OcularJelly MayRequire="sarg.alphaanimals">0.5</AA_OcularJelly>  <!-- ocular jelly - small, keep -->
      <AM_Dryad_Corruptor MayRequire="sarg.alphamemes">0.4</AM_Dryad_Corruptor>  <!-- corruptor dryad - small, keep -->
      <AM_Dryad_Ocular MayRequire="sarg.alphamemes">0.4</AM_Dryad_Ocular>  <!-- ocular dryad - small, keep -->
      <AM_Dryad_Tumorous MayRequire="sarg.alphamemes">0.4</AM_Dryad_Tumorous>  <!-- tumorous dryad - small, keep -->
      <!-- MULTI-HOMED ON PURPOSE - owner approved 2026-09-22 (BIOME_SPECIFIC_FAUNA_LAW_1):
           the screecher is a real flier (MaxFlightTime 35.0) that MIGRATES from this wetter
           biome into the hot Wasteland to lay. It is the law's own carve-out, not a violation.
           ⛔ Do not "fix" it by cutting either home. -->
      <RSW_Screecher MayRequire="mandrake.rsw.swbestiary">0.35</RSW_Screecher>  <!-- screecher - medium-pred, keep; wet end of the migration -->
      <Visceral MayRequire="mlie.horrors">0.35</Visceral>  <!-- visceral - medium-pred, keep -->
      <AA_BedBug MayRequire="sarg.alphaanimals">0.3</AA_BedBug>  <!-- bedbug - small-pred, keep -->
      <Mynock MayRequire="mlie.starwarsanimalcollection">0.2</Mynock>  <!-- mynock - small, import -->
      <GraniteSlug MayRequire="mlie.starwarsanimalcollection">0.15</GraniteSlug>  <!-- granite slug - grain, import -->
      <AA_CrystalMit MayRequire="sarg.alphaanimals">0.15</AA_CrystalMit>  <!-- crystalmit - small, import -->
      <AA_GiantCrownedSilkie MayRequire="sarg.alphaanimals">0.15</AA_GiantCrownedSilkie>  <!-- giant crowned silkie - medium, keep -->
      <AA_DecayDrake MayRequire="sarg.alphaanimals">0.1</AA_DecayDrake>  <!-- decay drake - medium, keep -->
      <AA_Helixien MayRequire="sarg.alphaanimals">0.1</AA_Helixien>  <!-- helixien - giant, keep -->
      <AA_Wildpod MayRequire="sarg.alphaanimals">0.05</AA_Wildpod>  <!-- wildpod - giant, keep -->
      <!-- COMMISSION_LEDGER_CLEANUP_1: eyeless-vibration-sensing-ambusher-the-signature.
           Body/art reskinned from the already-ported RSW_Kinrath (which stays placed at
           RUT_Greentide, cast_assignment.csv row 184): new defName, zero new PNGs. -->
      <RSW_VentStalker MayRequire="mandrake.rsw.swbestiary">0.25</RSW_VentStalker>  <!-- vent stalker - medium-pred, new -->
    </wildAnimals>
    <coastalWildAnimals />
    <wildPlants>
      <RUT_TwistingThornwood>0.6</RUT_TwistingThornwood>  <!-- twisting thornwood - tree -->
      <AB_CrystalFlower>0.5</AB_CrystalFlower>  <!-- crystal flower -->
      <RUT_TreeMartyr>0.5</RUT_TreeMartyr>  <!-- martyr tree - tree -->
      <AB_BloodBouquet>0.4</AB_BloodBouquet>  <!-- blood bouquet -->
      <AB_RavenNettle>0.4</AB_RavenNettle>  <!-- raven nettle -->
      <AB_GiantAgariTox>0.3</AB_GiantAgariTox>  <!-- agaritox - tree -->
      <AB_RedBugloss>0.3</AB_RedBugloss>  <!-- red bugloss -->
      <AB_KeeningCordax>0.2</AB_KeeningCordax>  <!-- keening cordax - tree -->
      <!-- SHEET_ORPHAN_CONSUMPTION_1, owner review 2026-09-20: AB_CrystalHorn moved OUT
           ("propane lakes and blue desert only") and AB_GiantToxicFlower moved IN from
           wasteland ("poison forest"). Both rulings landed in rosters/poison_forest.json
           and reached the game only through BiomeFlora_Ashkarr.xml's now-retired replace
           operation; transplanted here by BIOMEFLORA_PATCH_WIPES_WILDPLANTS_1. -->
      <AB_GiantToxicFlower>0.08</AB_GiantToxicFlower>  <!-- giant toxic flower -->
      <!-- COMMISSION_LEDGER_CLEANUP_1: dark-crust-phototroph-flora-black-purple-red-films-on-starwa.
           Own new PlantDef (RUT_PollutedFlora.xml, same mod): no donor crust/lichen form exists. -->
      <RUT_DarkCrust>0.25</RUT_DarkCrust>  <!-- dark crust - phototroph film, new -->
    </wildPlants>
    <wildPlantRegrowDays>15</wildPlantRegrowDays>
  </BiomeDef>

</Defs>
