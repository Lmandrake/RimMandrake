<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    RUT_Miasma                                     UtinniPatches - authored 2026-09-09
    BIOME_OWNERSHIP_WAVE_1. Full sheet: design/Jawa/worldbuilding/biomes/
    the_miasma.md (FROZEN). Replaces the donor `AB_MiasmicMangrove` (Alpha Biomes).

    MEASURED (sheet SS0): 93 tiles strung along the Salt Gate (the Grey Sea's
    deltas). Elevation median 22 m, the lowest ground on the dayside; 32 river
    tiles, 6 sea tiles; temp median 42.8 C. Rain: zero on 89 of 93 tiles — "the
    delta itself has never once been rained on" (the donor's Rain/RainyThunderstorm
    commonalities are kept anyway, see below, because the biome's own SS3 breath-tide
    mechanism reads them as SEA SURGE, not sky rain).

    animalDensity/movementDifficulty/diseaseMtbDays kept at the donor's own values:
    sheet SS0 explicitly names all three as "kept and explained" — 6.5 is refugee
    crowding (SS3 "the lifeboat"), 4 is the root-maze and muck, 15 is "the Working's
    failures leaking out" (SS4b, fever-forged).

    Weather: MIASMA_MECHANICS_1's M4 build pass (2026-09-13) landed the real lock —
    biomeMapConditions below now forces RUT_MiasmaWeather permanently via
    GameCondition.ForcedWeather(), which overrides vanilla's WeatherDecider outright.
    The donor's own Rain/RainyThunderstorm/FoggyRain/DryThunderstorm/Fog/Clear
    baseWeatherCommonalities entries below are now INERT — ForcedWeather() always
    wins regardless of what WeatherDecider rolls internally — kept only because
    removing them changes nothing observable and a biome with an empty
    baseWeatherCommonalities list is itself a latent config-error risk. Ban 5
    ("No rain") is now actually, mechanically true, not merely read that way.
    Snow zeroed (42.8 C median).

    diseases: the three Alpha Biomes-specific entries (BacterialGangrene/
    ViralAbasia/RavagingIntestinalParasites) kept MayRequire-gated — these ARE
    "the Working's failures" (SS3/SS4b), i.e. the sheet's own central mechanism, not
    generic dressing.

    wildAnimals/wildPlants: transplanted from BiomeCast_Ashkarr.xml /
    BiomeFlora_Ashkarr.xml against rosters/the_miasma.json.

    MIASMA_MECHANICS_1 M4/M1 build pass (2026-09-13): biomeMapConditions +
    modExtensions below wire the weather lock/light/exposure (M4) and the
    fresh->brine gradient axis (M1, RM_GenStep_GradientAxis registered onto
    Base_Player in Patches/RUT_Miasma_GradientAxis_Register.xml). Full details
    and honest gaps: infrastructure/state/items/MIASMA_MECHANICS_1.md.

    STILL NOT this pass's scope: M2 (breath-tide surge), M3 (stranding pools),
    M5 (fever-forged boon tables), M6 (warden-mother set-piece placement); the
    attar refinement chain; any world repaint.

    MIASMA_NURSERY_KINDS_1 (2026-09-10): the nursery-band RSW_* entries below spawn
    the *Juv defNames (SWBestiary SeaBeasts_NurseryJuveniles.xml (moved 2026-09-11: cross-mod ParentName inheritance is unsupported, defs now live beside their parents)), not the base
    species: those are juvenile-locked (lifeStageAges dropped below AnimalAdult, so
    LifeStageUtility caps them at Juvenile forever regardless of rolled age). The
    Grey Sea/terminator roster keeps the un-capped base defNames for the adults.

  -->

  <BiomeDef>
    <defName>RUT_Miasma</defName>
    <label>the Miasma</label>
    <description>A salt-crusted, stilt-rooted mangal forest standing in brackish channels between a dying sea and the rivers that feed it, under a green-gold haze of its own breath. Walking is hard, the air hangs thick, and the water crowds with life -- because everything ends up here: the water, the sins it carries, and the life running from the salt. Threaded through the stink, improbably, beauty: rainbow-hued plants, young animals everywhere, and the stubborn sense the place is on the verge of something.</description>
    <workerClass>AlphaBiomes.BiomeWorker_MiasmicMangrove</workerClass>
    <foragedFood>RawBerries</foragedFood>
    <allowRoads>true</allowRoads>
    <allowRivers>true</allowRivers>
    <allowFarmingCamps>true</allowFarmingCamps>
    <animalDensity>6.5</animalDensity>
    <plantDensity>0.7</plantDensity>
    <forageability>1.0</forageability>
    <movementDifficulty>4</movementDifficulty>
    <texture>Biomes/AB_MiasmicMangrove</texture>
    <diseaseMtbDays>15</diseaseMtbDays>
    <biomeMapConditions>
      <li MayRequire="mandrake.rm.environmentalhazards">RUT_MiasmaWeatherLock</li>
    </biomeMapConditions>
    <modExtensions>
      <!-- M4: "seen through breath", not the Lantern's dark (kit spec's own INVENTED 0.85). -->
      <li MayRequire="mandrake.rm.environmentalhazards" Class="RimMandrake.EnvironmentalHazards.BiomeGlowMultiplierExtension">
        <glowMultiplier>0.85</glowMultiplier>
      </li>
      <!-- M1: the fresh->brine axis. Fresh band left unnamed (leaves vanilla
           water untouched); brackish/brine grades from LIQUID_TYPES_MOD_1
           (merged into mandrake.rm.flowworks 2026-09-16); the driest brine-adjacent band reuses
           this same mod's own RUT_Jawa_SaltCrust (no new terrain def), only
           ever repainting the two muck terrains RUT_Miasma's own
           terrainsByFertility already uses below. -->
      <li MayRequire="mandrake.rm.environmentalhazards" Class="RimMandrake.EnvironmentalHazards.RM_GradientAxisExtension">
        <waterBands>
          <li>
            <max>0.34</max>
          </li>
          <li MayRequire="mandrake.rm.flowworks">
            <max>0.66</max>
            <terrainShallow>RM_WaterBrackishShallow</terrainShallow>
            <terrainDeep>RM_WaterBrackishDeep</terrainDeep>
          </li>
          <li MayRequire="mandrake.rm.flowworks">
            <max>1</max>
            <terrainShallow>RM_WaterBrineShallow</terrainShallow>
            <terrainDeep>RM_WaterBrineDeep</terrainDeep>
          </li>
        </waterBands>
        <landRepaintMinSalinity>0.85</landRepaintMinSalinity>
        <landRepaintSource>
          <li>Mud</li>
          <li MayRequire="sarg.alphabiomes">AB_FertileMud</li>
        </landRepaintSource>
        <landTerrain>RUT_Jawa_SaltCrust</landTerrain>
      </li>
      <!-- M2: the breath-tide surge's own MTB/magnitude tuning, shared by
           RM_MapComponent_GradientAxis.TickSurgeRoll (fires RUT_Surge) and
           RM_GameCondition_GradientSurge (sizes the shove/recede). Every
           figure here is the kit spec's own INVENTED number except
           stormWindSpeedThreshold/residualFraction, which the spec left
           unspecified and this build pass picked and recorded (see
           RM_GradientSurgeExtension.cs's own header for why). -->
      <li MayRequire="mandrake.rm.environmentalhazards" Class="RimMandrake.EnvironmentalHazards.RM_GradientSurgeExtension">
        <incidentDef>RUT_Surge</incidentDef>
        <baseMtbDays>5</baseMtbDays>
        <stormMtbMultiplier>0.25</stormMtbMultiplier>
        <stormWindSpeedThreshold>1.2</stormWindSpeedThreshold>
        <frontCellsRange>15~35</frontCellsRange>
        <recedeDaysRange>2~4</recedeDaysRange>
        <residualFraction>0.15</residualFraction>
      </li>
      <!-- M3: stranding pools and the stranded, armed by M2's own recede
           signal (RM_MapComponent_GradientAxis.LastRecedeCompletedTick).
           strandedSpawnList below is a PLACEHOLDER — the real
           RUT_StrandedSpawnList roster (gills-going-leathery, fins-splaying-
           to-feet transitional endemics, the sheet's own §4) is the roster
           pass's to author, not this kit's; ONE existing shipped
           PawnKindDef is wired here only so the spawner/lifecycle actually
           runs end-to-end rather than compiling against an empty list. -->
      <li MayRequire="mandrake.rm.environmentalhazards" Class="RimMandrake.EnvironmentalHazards.RM_StrandingPoolsExtension">
        <strandedSpawnList>
          <!-- PLACEHOLDER: an existing shipped aquatic kind already listed
               in this biome's own wildAnimals below, wired here only to
               prove the weighted spawn roll compiles and runs — not a
               roster decision. -->
          <li MayRequire="mlie.starwarsanimalcollection">Yobshrimp</li>
        </strandedSpawnList>
        <emptyWeight>40</emptyWeight>
        <smallWeight>50</smallWeight>
        <bigWeight>10</bigWeight>
        <strandedCountSmall>1~2</strandedCountSmall>
        <strandedCountBig>3~5</strandedCountBig>
        <decayDaysRange>3~8</decayDaysRange>
        <poolSizeThreshold>4</poolSizeThreshold>
        <searchRadius>60</searchRadius>
        <dryTerrain>RUT_Jawa_SaltCrust</dryTerrain>
      </li>
    </modExtensions>
    <diseases>
      <li MayRequire="sarg.alphabiomes">
        <diseaseInc>AB_Disease_BacterialGangrene</diseaseInc>
        <commonality>100</commonality>
      </li>
      <li MayRequire="sarg.alphabiomes">
        <diseaseInc>AB_Disease_ViralAbasia</diseaseInc>
        <commonality>100</commonality>
      </li>
      <li MayRequire="sarg.alphabiomes">
        <diseaseInc>AB_Disease_RavagingIntestinalParasites</diseaseInc>
        <commonality>100</commonality>
      </li>
      <li>
        <diseaseInc>Disease_Malaria</diseaseInc>
        <commonality>160</commonality>
      </li>
      <li>
        <diseaseInc>Disease_SleepingSickness</diseaseInc>
        <commonality>140</commonality>
      </li>
      <li>
        <diseaseInc>Disease_Flu</diseaseInc>
        <commonality>100</commonality>
      </li>
      <li>
        <diseaseInc>Disease_Plague</diseaseInc>
        <commonality>100</commonality>
      </li>
      <li>
        <diseaseInc>Disease_GutWorms</diseaseInc>
        <commonality>80</commonality>
      </li>
      <li>
        <diseaseInc>Disease_MuscleParasites</diseaseInc>
        <commonality>80</commonality>
      </li>
    </diseases>
    <terrainsByFertility>
      <li>
        <terrain>Mud</terrain>
        <min>-999</min>
        <max>0.65</max>
      </li>
      <li>
        <terrain>AB_FertileMud</terrain>
        <min>0.65</min>
        <max>999</max>
      </li>
    </terrainsByFertility>
    <baseWeatherCommonalities>
      <Clear>8</Clear>
      <Fog>5</Fog>
      <Rain>10</Rain>
      <DryThunderstorm>0.9</DryThunderstorm>
      <RainyThunderstorm>5</RainyThunderstorm>
      <FoggyRain>4</FoggyRain>
      <SnowGentle>0</SnowGentle>
      <SnowHard>0</SnowHard>
    </baseWeatherCommonalities>
    <wildAnimals>
      <Kreetle MayRequire="mlie.starwarsanimalcollection">1.0</Kreetle>  <!-- kreetle - arthropod-floor, keep -->
      <Yobshrimp MayRequire="mlie.starwarsanimalcollection">0.8</Yobshrimp>  <!-- yobshrimp - arthropod-floor, import -->
      <VFEI2_Swarmling MayRequire="oskarpotocki.vfe.insectoid2">0.7</VFEI2_Swarmling>  <!-- swarmlings - vermin, keep -->
      <RSW_Gembug MayRequire="mandrake.rsw.swbestiary">0.5</RSW_Gembug>  <!-- gembug - arthropod-floor, keep -->
      <Runyip MayRequire="mlie.starwarsanimalcollection">0.5</Runyip>  <!-- runyip - muck-forager, adjust-keep -->
      <VFEI2_BlackSwarmling MayRequire="sarg.alphaanimals">0.5</VFEI2_BlackSwarmling>  <!-- black swarmlings - vermin, keep -->
      <RSW_CrestedDragon MayRequire="mandrake.rsw.swbestiary">0.4</RSW_CrestedDragon>  <!-- crested dragon - channel-predator, keep -->
      <RSW_MeeJuv MayRequire="mandrake.rsw.swbestiary">0.4</RSW_MeeJuv>  <!-- mee scalefish - nursery, juvenile-locked (MIASMA_NURSERY_KINDS_1) -->
      <Shiro MayRequire="mlie.starwarsanimalcollection">0.4</Shiro>  <!-- shiro - arthropod-floor, keep -->
      <RSW_AaroxisDendoria MayRequire="mandrake.rsw.swbestiary">0.3</RSW_AaroxisDendoria>  <!-- aaroxis dendoria - strange, keep -->
      <RSW_FaaJuv MayRequire="mandrake.rsw.swbestiary">0.3</RSW_FaaJuv>  <!-- faa scalefish - nursery, juvenile-locked -->
      <RSW_LaaJuv MayRequire="mandrake.rsw.swbestiary">0.3</RSW_LaaJuv>  <!-- laa scalefish - nursery, juvenile-locked -->
      <RSW_YobshrimpJuv MayRequire="mandrake.rsw.swbestiary">0.3</RSW_YobshrimpJuv>  <!-- pale yobshrimp - nursery, juvenile-locked -->
      <Anooba MayRequire="mlie.starwarsanimalcollection">0.3</Anooba>  <!-- anooba - scavenger, keep -->
      <Grank MayRequire="mlie.starwarsanimalcollection">0.3</Grank>  <!-- Grank - channel-predator, import -->
      <Whisperbird MayRequire="mlie.starwarsanimalcollection">0.3</Whisperbird>  <!-- whisperbird - flier, keep -->
      <RSW_RustNipperJuv MayRequire="mandrake.rsw.swbestiary">0.25</RSW_RustNipperJuv>  <!-- rust nipper - nursery, juvenile-locked -->
      <RSW_SiltLampreyJuv MayRequire="mandrake.rsw.swbestiary">0.25</RSW_SiltLampreyJuv>  <!-- silt lamprey - nursery, juvenile-locked -->
      <AA_Lockjaw MayRequire="sarg.alphaanimals">0.2</AA_Lockjaw>  <!-- lockjaw - channel-predator, keep -->
      <AA_Mantrap MayRequire="sarg.alphaanimals">0.2</AA_Mantrap>  <!-- mantrap - root-ambush, keep -->
      <AA_RaptorShrimp MayRequire="sarg.alphaanimals">0.2</AA_RaptorShrimp>  <!-- raptor shrimp - channel-predator, keep -->
      <Vornskyr MayRequire="mlie.starwarsanimalcollection">0.15</Vornskyr>  <!-- vornskyr - strange, keep -->
      <AA_BloodShrimp MayRequire="sarg.alphaanimals">0.1</AA_BloodShrimp>  <!-- blood shrimp - channel-predator, keep -->
      <AA_DecayDrake MayRequire="sarg.alphaanimals">0.1</AA_DecayDrake>  <!-- decay drake - composter, keep -->
      <AA_Helixien MayRequire="sarg.alphaanimals">0.1</AA_Helixien>  <!-- helixien - strange, keep -->
      <AA_Slurrypede MayRequire="sarg.alphaanimals">0.1</AA_Slurrypede>  <!-- slurrypede - composter, adjust-keep -->
      <AA_Thermadon MayRequire="sarg.alphaanimals">0.1</AA_Thermadon>  <!-- thermadon - channel-predator, keep -->
      <RSW_OpeeSeaKillerJuv MayRequire="mandrake.rsw.swbestiary">0.05</RSW_OpeeSeaKillerJuv>  <!-- opee sea killer - nursery-guard, juvenile-locked -->
      <Zakkeg MayRequire="mlie.starwarsanimalcollection">0.05</Zakkeg>  <!-- zakkeg - big-wanderer, keep -->
      <AA_Plasmorph MayRequire="sarg.alphaanimals">0.05</AA_Plasmorph>  <!-- plasmorph - strange, keep -->
    </wildAnimals>
    <coastalWildAnimals />
    <wildPlants>
      <AB_MangroveTree>25</AB_MangroveTree>  <!-- mangrove tree - tree -->
      <AB_ParasiticMangrove>8</AB_ParasiticMangrove>  <!-- parasitic mangrove -->
      <AB_MangrovePalm>6</AB_MangrovePalm>  <!-- mangrove palm - tree -->
    </wildPlants>
    <wildPlantRegrowDays>13</wildPlantRegrowDays>
  </BiomeDef>

</Defs>
