<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- FORSAKENCRAGS_RM_MOD_BUILD_1, 2026-09-25: carrying the world until the terminal
       paint; content lives in mandrake.rm.abyss; do not edit here. -->

  <!--
    RUT_Abyss                              UtinniPatches - authored 2026-09-09
    BIOME_OWNERSHIP_WAVE_1. Full sheet: design/Jawa/worldbuilding/biomes/
    abyss.md (FROZEN). Replaces the donor `AB_RockyCrags` (Alpha Biomes'
    "Abyss") — donor content incorporated wholesale per the sheet's own
    ruling, then bent (SS0).

    MEASURED (sheet SS0): 1,170 tiles (an earlier "4,440" in the grammar README was
    wrong per this sheet's own correction), arc p10/median/p90 100.3/108.2/115.7
    (10-31 deg below horizon, past-terminator true night). Hilliest def on the
    planet: 614 tiles at large-hills or worse.

    Weather: ban 4 is explicit — "No permanent Clear — Clear weather commonality
    stays 0" — matched exactly (donor already carried Clear:0). AB_ForsakenNight/
    AB_ForsakenThunderstorm/AB_ForsakenRainyNight (all Alpha Biomes WeatherDefs, kept
    MayRequire-gated on sarg.alphabiomes since they are optional content, unlike the
    terrain/texture fields which already assume that mod stays installed) carry the
    donor's re-skinned physics per the sheet: "the Dark" (permanent), "the
    Unveiling" (rare illumination rise, still un-authored as its own WeatherDef —
    SS Owed), "Etchfall" (never water, ban 3), "Witchfire storms." Ban 1 (no
    geothermal) and ban 2 (no steady wind, gust-pattern only) are mechanic-level, not
    weather-commonality fields, and are not claimed as satisfied by this def alone.

    wildAnimals/wildPlants: transplanted from BiomeCast_Ashkarr.xml /
    BiomeFlora_Ashkarr.xml against rosters/abyss.json — "the donor roster
    IS the population" per the sheet's own ruling (SS4), the 13-species nocturnal
    transplanted family. Dusk rat, frostling, night ave and sand prowler (vosska)
    cut by the owner 2026-10-05 (Abyss sheet, twin cut ruled by question card).

    NOT this pass's scope: the Unveiling as its own rare WeatherDef; the darkbeast,
    the Dark-folding mechanism, gust-wind variability (all C#, SS Owed); Lightfall
    chasm authoring (`LIGHTFALL_CHASM_AUTHORING_1`); any world repaint.

  -->

  <BiomeDef>
    <defName>RUT_Abyss</defName>
    <label>the Abyss</label>
    <description>A country of obsidian-black stone twisted into shapes no wind carved, drowned in a darkness that behaves like a substance: it fills the air, it pools, it parts without warning into pockets of impossibly clear air, and it closes again. Light is eaten in transit here, not merely absent. The only reliable illumination is biological -- glowing grass, blue darklight gammas, yellow giant flora -- a land lit like a harbor at night, by its own lamps.</description>
    <workerClass>AlphaBiomes.BiomeWorker_RockyCrags</workerClass>
    <foragedFood>RawAgave</foragedFood>
    <allowRoads>true</allowRoads>
    <allowRivers>true</allowRivers>
    <allowFarmingCamps>true</allowFarmingCamps>
    <animalDensity>1.8</animalDensity>
    <plantDensity>0.5</plantDensity>
    <forageability>0.5</forageability>
    <movementDifficulty>1</movementDifficulty>
    <texture>Biomes/AB_RockyCrags</texture>
    <diseaseMtbDays>65</diseaseMtbDays>
    <diseases>
      <li>
        <diseaseInc>Disease_Flu</diseaseInc>
        <commonality>100</commonality>
      </li>
      <li>
        <diseaseInc>Disease_Plague</diseaseInc>
        <commonality>100</commonality>
      </li>
      <li>
        <diseaseInc>Disease_GutWorms</diseaseInc>
        <commonality>60</commonality>
      </li>
      <li>
        <diseaseInc>Disease_MuscleParasites</diseaseInc>
        <commonality>60</commonality>
      </li>
      <li>
        <diseaseInc>Disease_FibrousMechanites</diseaseInc>
        <commonality>30</commonality>
      </li>
      <li>
        <diseaseInc>Disease_SensoryMechanites</diseaseInc>
        <commonality>30</commonality>
      </li>
      <li>
        <diseaseInc>Disease_AnimalFlu</diseaseInc>
        <commonality>100</commonality>
      </li>
      <li>
        <diseaseInc>Disease_AnimalPlague</diseaseInc>
        <commonality>100</commonality>
      </li>
    </diseases>
    <terrainsByFertility>
      <li>
        <terrain>AB_FineForsakenSand</terrain>
        <min>-999</min>
        <max>0.5</max>
      </li>
      <li>
        <terrain>AB_ForsakenSand</terrain>
        <min>0.5</min>
        <max>999</max>
      </li>
    </terrainsByFertility>
    <baseWeatherCommonalities>
      <Clear>0</Clear>
      <AB_ForsakenNight MayRequire="sarg.alphabiomes">70</AB_ForsakenNight>
      <AB_ForsakenThunderstorm MayRequire="sarg.alphabiomes">4</AB_ForsakenThunderstorm>
      <AB_ForsakenRainyNight MayRequire="sarg.alphabiomes">4</AB_ForsakenRainyNight>
    </baseWeatherCommonalities>
    <wildAnimals>
      <!-- ECOSYSTEM_PYRAMID_LAW_1 (owner, 2026-09-20: "50% small"): this roster read
           33.3% small (the worst real, non-near-empty roster in the sweep). No unwired
           small fauna exists in this biome's own frozen roster
           (design/Jawa/worldbuilding/biomes/rosters/abyss.json) to add instead,
           so the fix raises the grain already here, same shape as the Gizka fix in
           Pyrelands (ECOSYSTEM_PYRAMID_LAW_1's first application): the two existing
           small residents become more common, no megafauna cut. -->
      <RM_Lirrith MayRequire="mandrake.rm.biomes">1.0</RM_Lirrith>
      <RM_Cindermare MayRequire="mandrake.rm.biomes">0.04</RM_Cindermare>  <!-- ABYSS_INVENTED_CREATURES_TO_RM_1: free-tier predators, same rows as RM_Abyss -->
      <RM_Skarnix MayRequire="mandrake.rm.biomes">0.09</RM_Skarnix>  <!-- murkling - small, keep; boosted from 0.5 for the ecosystem pyramid law -->
      <RM_Drokattak MayRequire="mandrake.rm.biomes">0.12</RM_Drokattak>  <!-- ABYSS_DONOR_BEASTS_FREED_1: same rows as RM_Abyss -->
      <RM_Summ MayRequire="mandrake.rm.biomes">0.01</RM_Summ>
      <RM_Aveluthia MayRequire="mandrake.rm.biomes">0.5</RM_Aveluthia>  <!-- nightmule - large, keep -->
      <RM_Moravatha MayRequire="mandrake.rm.biomes">0.35</RM_Moravatha>  <!-- Crepuscular Beetle - large, keep -->
      <RM_Ysvaltha MayRequire="mandrake.rm.biomes">0.2</RM_Ysvaltha>  <!-- dusk prowler - medium-pred, keep -->
      <RM_Sesserith MayRequire="mandrake.rm.biomes">0.2</RM_Sesserith>  <!-- nightling - medium-apex, keep -->
      <RM_Ossumatha MayRequire="mandrake.rm.biomes">0.15</RM_Ossumatha>  <!-- dark vandal - medium, keep -->
      <RM_Olumetha MayRequire="mandrake.rm.biomes">0.09</RM_Olumetha>  <!-- nightram - large, keep -->
      <RM_Nevarithia MayRequire="mandrake.rm.biomes">0.005</RM_Nevarithia>  <!-- darkbeast - medium, keep -->
    </wildAnimals>
    <coastalWildAnimals />
    <wildPlants>
      <AB_GlowingGrass>1.0</AB_GlowingGrass>  <!-- grass -->
      <RM_SicklyGlowMushroom MayRequire="mandrake.rm.biomes">0.6</RM_SicklyGlowMushroom>  <!-- toxic gamma - tree -->
      <RM_GiantGlowGlobe MayRequire="mandrake.rm.biomes">0.5</RM_GiantGlowGlobe>  <!-- giant gamma -->
      <RM_GlowberryBush MayRequire="mandrake.rm.biomes">0.5</RM_GlowberryBush>  <!-- wild ragadast -->
      <!-- SHEET_ORPHAN_CONSUMPTION_1, owner review 2026-09-11 ("to crags" / "elsewhere,
           not heat resistant"): AG_Gamma and AG_Septimum moved here from the_forge, whose
           42-56 C floor is above their optimal band (opt max 42 C, MEASURED plant_pool.csv)
           and where AB_GiantGamma above was already their resident kin. The ruling landed
           in rosters/abyss.json and reached the game only through
           BiomeFlora_Ashkarr.xml's now-retired replace operation; transplanted here by
           BIOMEFLORA_PATCH_WIPES_WILDPLANTS_1 so this def carries it itself. -->
      <RM_GlowGlobe MayRequire="mandrake.rm.biomes">0.5</RM_GlowGlobe>  <!-- gamma -->
      <RM_TreeMushroom MayRequire="mandrake.rm.biomes">0.3</RM_TreeMushroom>  <!-- giant stikehr -->
      <RM_PaddleVine MayRequire="mandrake.rm.biomes">0.25</RM_PaddleVine>  <!-- septimum -->
      <RM_GiantFibreStalk MayRequire="mandrake.rm.biomes">0.2</RM_GiantFibreStalk>  <!-- giant septimum - tree -->
    </wildPlants>
    <wildPlantRegrowDays>27</wildPlantRegrowDays>
  </BiomeDef>

</Defs>
