<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    RUT_CrackedLands                               UtinniPatches - authored 2026-09-09

    🔴 FLOODEDCANYON_RM_MOD_BUILD_1 (2026-09-21): carrying the world until the
    terminal paint; content lives in `mandrake.rm.floodedcanyon`; do not edit
    here.

    BIOME_OWNERSHIP_WAVE_1. Full sheet: design/Jawa/worldbuilding/biomes/
    the_cracked_lands.md (FROZEN). Replaces the donor `ZBiome_Badlands` (More
    Vanilla Biomes, Zylleon — a deliberately thin donor whose only real
    contribution is the shape; the biome's name is THE CRACKED LANDS, owner's pick).

    MEASURED (sheet SS0): 985 tiles, arc 17-116 (median 69, sun ~21 deg above
    horizon), temp p10/median/p90 9/27/45 C, most mixed relief on the planet.

    Weather: ban 5 is explicit "No rain in the canyons (R-H1); the peaks rain, and
    those peaks are the Contagion's where they do" — Rain/RainyThunderstorm/
    FoggyRain/Fog all zeroed. SS4b names the standing state as "Clear, hot, still"
    plus sandstorms across the flats and dry lightning off the Contagion's storms at
    the ridge — Clear made dominant, Sandstorm(Odyssey) and DryThunderstorm kept.
    Snow zeroed (arc/temp band and the sheet's own theme give no basis for it).

    plantDensity trimmed from the donor's own value toward the low end: ban 2 is
    explicit "No green outside the shade line — a flora def resident on open
    sun-flats is a violation; the lush rule's thin line, not a region," and SS7's
    "Soil... not great, but soil" argues the biome is farmable but never abundant.
    animalDensity kept at the donor's own 0.6 (not disputed by the sheet).

    wildAnimals/wildPlants: transplanted from BiomeCast_Ashkarr.xml /
    BiomeFlora_Ashkarr.xml against rosters/the_cracked_lands.json.

    NOT this pass's scope: the flood as an engine event (warning, wall of water,
    drowning, soil deposition — SS Owed); water chimes, discovery surveys,
    crack-wax item defs; the Moisture Farmer homestead templates
    (`MOISTURE_FARM_TEMPLATES_1`); the flier-commute vector line to the Desert
    sheet; `EXPLOSIVE_PLANT_GROWTH_1`; any world repaint.

  -->

  <BiomeDef>
    <defName>RUT_CrackedLands</defName>
    <generatesNaturally>false</generatesNaturally>
    <label>the Cracked Lands</label>
    <description>Canyon country below the only dayside mountains that rain: mesas, hoodoos, slot canyons, clay pans split into polygons, dry and cracked and still. Then, rarely and without warning, the water comes down -- violent floods of hot, crud-laden water that are fertilizer, life, death and disaster all at once. It tears the canyon and leaves behind the one thing nowhere else on the dryland ladder has: actual soil, in the shade.</description>
    <workerClass>VanillaBiomes.BiomeWorker_Badlands</workerClass>
    <lakeBeachTerrain>Sand</lakeBeachTerrain>
    <riverbankTerrain>Sand</riverbankTerrain>
    <foragedFood>RawBerries</foragedFood>
    <allowRoads>true</allowRoads>
    <allowRivers>true</allowRivers>
    <allowFarmingCamps>true</allowFarmingCamps>
    <animalDensity>0.6</animalDensity>
    <plantDensity>0.15</plantDensity>
    <forageability>0.1</forageability>
    <movementDifficulty>1</movementDifficulty>
    <texture>World/Biomes/ZBiome_Badlands</texture>
    <diseaseMtbDays>90</diseaseMtbDays>
    <diseases>
      <li>
        <diseaseInc>Disease_Flu</diseaseInc>
        <commonality>100</commonality>
      </li>
      <li>
        <diseaseInc>Disease_Plague</diseaseInc>
        <commonality>80</commonality>
      </li>
      <li>
        <diseaseInc>Disease_GutWorms</diseaseInc>
        <commonality>40</commonality>
      </li>
      <li>
        <diseaseInc>Disease_MuscleParasites</diseaseInc>
        <commonality>40</commonality>
      </li>
      <li>
        <diseaseInc>Disease_FibrousMechanites</diseaseInc>
        <commonality>30</commonality>
      </li>
      <li>
        <diseaseInc>Disease_SensoryMechanites</diseaseInc>
        <commonality>30</commonality>
      </li>
      <li>
        <diseaseInc>Disease_AnimalFlu</diseaseInc>
        <commonality>100</commonality>
      </li>
      <li>
        <diseaseInc>Disease_AnimalPlague</diseaseInc>
        <commonality>80</commonality>
      </li>
    </diseases>
    <terrainsByFertility>
      <li>
        <terrain>Sand</terrain>
        <min>-999</min>
        <max>999</max>
      </li>
    </terrainsByFertility>
    <baseWeatherCommonalities>
      <Clear>85</Clear>
      <DryThunderstorm>3</DryThunderstorm>
      <Sandstorm MayRequire="Ludeon.RimWorld.Odyssey">8</Sandstorm>
      <Fog>0</Fog>
      <Rain>0</Rain>
      <RainyThunderstorm>0</RainyThunderstorm>
      <FoggyRain>0</FoggyRain>
      <SnowGentle>0</SnowGentle>
      <SnowHard>0</SnowHard>
    </baseWeatherCommonalities>
    <wildAnimals>
      <RSW_MutagenicNorphea MayRequire="mandrake.rsw.swbestiary">0.4</RSW_MutagenicNorphea>  <!-- mutagenic norphea - the-Sealed, keep -->
      <Gornt MayRequire="mlie.starwarsanimalcollection">0.3</Gornt>  <!-- gornt - the-Patient, keep -->
      <Eopie MayRequire="mlie.starwarsanimalcollection">0.25</Eopie>  <!-- eopie - the-Patient, keep -->
      <RSW_SandLeaper MayRequire="mandrake.rsw.swbestiary">0.2</RSW_SandLeaper>  <!-- sand leaper - the-Spenders, adjust-keep -->
      <CanCell MayRequire="mlie.starwarsanimalcollection">0.2</CanCell>  <!-- can-cell - flier-commuter, keep -->
      <Convor MayRequire="mlie.starwarsanimalcollection">0.2</Convor>  <!-- convor - flier-commuter, import -->
      <AA_Murkling MayRequire="sarg.alphaanimals">0.2</AA_Murkling>  <!-- murkling - the-Spenders, adjust-keep -->
      <RSW_Creature_Mantrap MayRequire="mandrake.rsw.swbestiary">0.15</RSW_Creature_Mantrap>  <!-- mantrap - the-Patient, import -->
      <Woolamander MayRequire="mlie.starwarsanimalcollection">0.15</Woolamander>  <!-- woolamander - flier-commuter, import -->
      <AA_SandSquid MayRequire="sarg.alphaanimals">0.1</AA_SandSquid>  <!-- sand squid - the-Sealed, adjust-keep -->
      <!-- COMMISSION_LEDGER_CLEANUP_1: two signature commissions the roster's
           own new_defs list flagged as unbuilt ("no live def answers to it" /
           the flagship vs. the existing sort-fillers above). -->
      <RUT_EmperorVulture>0.15</RUT_EmperorVulture>  <!-- emperor vulture - the-Patient, new -->
      <RUT_SealedSleeper>0.2</RUT_SealedSleeper>  <!-- Sealed sleeper - the-Sealed signature, new -->
    </wildAnimals>
    <coastalWildAnimals />
    <wildPlants>
      <AB_HardyGrass>1.0</AB_HardyGrass>  <!-- hardy grass -->
      <GRimMoss>0.8</GRimMoss>  <!-- moss -->
      <RUT_TwistingThorngrass>0.5</RUT_TwistingThorngrass>  <!-- twisting thorngrass -->
      <RUT_TwistingThornweed>0.4</RUT_TwistingThornweed>  <!-- twisting thornweed -->
      <RUT_TwistingThornwood>0.2</RUT_TwistingThornwood>  <!-- twisting thornwood - tree -->
      <AB_GargantuanLithops>0.15</AB_GargantuanLithops>  <!-- gargantuan lithops -->
    </wildPlants>
    <wildPlantRegrowDays>28</wildPlantRegrowDays>

    <!-- FISH_BESTIARY_BUILD_1 wave 3 (2026-09-18): fishTypes/maxFishPopulation
         wired DIRECTLY onto this def — same dead-mechanism correction as
         RUT_WeepingStones.xml (see its header for the full finding).
         `SandFishing_CrackedLands.xml` patched the donor `ZBiome_Badlands`'s
         fishTypes (wave 1/2), but this def (`RUT_CrackedLands`,
         BIOME_OWNERSHIP_WAVE_1) is a standalone BiomeDef with no ParentName
         and was never patched itself — MEASURED via
         `world/ASHKARR_WORLDMAP_tiles.csv` (2026-09-12): RUT_CrackedLands
         covers 970 tiles, ZBiome_Badlands covers zero. The BiomeDef-patching
         Operation in `SandFishing_CrackedLands.xml` is removed this wave
         (dead, superseded by the block below); its OTHER Operation (the
         RUT_Vhessa addition to `RSW_RareSandCatches`, a different mod's
         ThingSetMakerDef, unaffected by this bug) is untouched. Values below
         are copied verbatim from that now-dead patch — no roster change. -->
    <maxFishPopulation>90</maxFishPopulation>
    <fishTypes MayRequire="Ludeon.RimWorld.Odyssey">
      <freshwater_Common>
        <RSW_DuneCrawler MayRequire="mandrake.rsw.swbestiary">1</RSW_DuneCrawler>
        <RUT_Tubbik>1</RUT_Tubbik>
        <RUT_Zhurr>0.6</RUT_Zhurr>
      </freshwater_Common>
      <freshwater_Uncommon>
        <BMT_Rocktooth MayRequire="biomesteam.biomescaverns">1</BMT_Rocktooth>
        <BMT_Boneblade MayRequire="biomesteam.biomescaverns">1</BMT_Boneblade>
        <RUT_Hurrok>0.8</RUT_Hurrok>
        <RUT_Vhessa>0.4</RUT_Vhessa>
      </freshwater_Uncommon>
      <rareCatchesSetMaker MayRequire="mandrake.rsw.swbestiary">RSW_RareSandCatches</rareCatchesSetMaker>
    </fishTypes>
  </BiomeDef>

</Defs>
