<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  RUT_GreySea.xml                        UtinniPatches · authored 2026-09-06
  ============================================================================
  LIQUID_BIOMES_MAP_1 — OFFLINE HALF. The second of the item's two "brine
  seas", per design/Jawa/worldbuilding/biomes/terminator_sea.md §2: "the
  Grey Sea (θ 92, bearing 8, salt-encrusted, shrinking)." Reconciled against
  world/ASHKARR_WORLDMAP_tiles.csv: region "Grey Sea" is 617 tiles total,
  biome breakdown Ocean 381 / SeaIce 91 / land shore (AridShrubland 89,
  Desert 34, ZBiome_Badlands 12, AB_MiasmicMangrove 6, Wasteland 4). This
  def concerns the 381 Ocean-biome (liquid) tiles only, same scope rule as
  RUT_TwilightSea.xml.

  See RUT_TwilightSea.xml for the shared provenance this file does not
  repeat: the Name= trap on vanilla Ocean and why a dedicated def is needed
  even though Ocean's 823 tiles split cleanly 442/381 with the Twilight Sea
  and nothing left over; why water terrain is deliberately left at vanilla
  WaterOceanDeep/WaterOceanShallow (Saltwater is the engine's only
  hypersaline-adjacent tier); and why wildAnimals/coastalWildAnimals/
  fishTypes are left empty and documented rather than invented — the Grey
  Sea's own endemic monoculture (terminator_sea.md: "the Grey Sea holds a
  different one [mat]" from the Twilight Sea's) is SEAS_WATERLINE_PASS_1's
  job, not this item's.

  canon.yml / ASHKARR_WORLD_DEFINITION.md's Sea table gives the Grey Sea a
  0 m sink elevation and "salt-encrusted, shrinking" as its one-line
  character, distinct from the Twilight Sea's "moldy" — the description
  below reflects that distinction; nothing else about the two defs differs
  mechanically in this pass.
  ============================================================================
-->
<Defs>

  <BiomeDef>
    <defName>RUT_GreySea</defName>
    <label>the Grey Sea</label>
    <description>A hypersaline terminal sea on the terminator band, its own endemic mat holding it alone the way the Twilight Sea's holds that one. Salt-encrusted and shrinking faster than its sister sea — the planet's chemical works, and the retreating shoreline is free surveying for anyone who can read the terraces.</description>
    <workerClass>BiomeWorker_Ocean</workerClass>
    <isWaterBiome>true</isWaterBiome>
    <canBuildBase>false</canBuildBase>
    <!-- allowRoads TRUE by owner ruling 2026-09-07: "All of our biomes should allow roads." 91 authored road links crossed RUT_NightsideIce and were invisible - the links were structurally valid (asymmetric 0, nonAdjacent 0), the biome simply refused to draw them. -->
    <allowRoads>true</allowRoads>
    <allowRivers>false</allowRivers>
    <hasVirtualPlants>false</hasVirtualPlants>
    <texture>World/Biomes/Ocean</texture>
    <impassable>true</impassable>
    <isBackgroundBiome>true</isBackgroundBiome>
    <!-- WILD ANIMALS, landed 2026-09-09 by BIOME_FAUNA_ASSIGNMENT_SITTING_1 from
         design/Jawa/worldbuilding/biomes/rosters/the_grey_sea.json. This supersedes
         the "left empty, SEAS_WATERLINE_PASS_1's job" note above.
         The Reefback is the warden lineage's ADULT side only - they breed and die in
         the Miasma (freeze R11), so the crèche rows live in the Miasma roster. The
         Aerofleet is the shore drifter shared with the Twilight Sea (endemism binds
         giants; fliers range, R17); it never touches the Grey Deep's three-resident cap.
         🔴 No <li>: the node NAME is the animal, the node TEXT is the commonality.
         ⚠️ No animalDensity was declared and the engine default is 0, so neither
         resident could ever spawn. CLOSED 2026-09-09 (fix wave,
         BIOME_FAUNA_ASSIGNMENT_SITTING_1): 0.1 declared below. -->
    <wildAnimals>
      <AA_Aerofleet MayRequire="sarg.alphaanimals">0.05</AA_Aerofleet>              <!-- aerofleet - drifter, import -->
      <RSW_Reefback MayRequire="mandrake.rsw.swbestiary">0.005</RSW_Reefback>       <!-- reefback - endemic giant (warden adult), import -->
    </wildAnimals>
    <!-- animalDensity: undeclared (engine default 0) -> 0.1, DESIGNED interim
         (2026-09-09 fix wave). the_grey_deep.md / terminator_sea.md population
         doctrine: the Grey Deep runs a THREE-RESIDENT CAP and its giants are endemic -
         deliberate scarcity, not emptiness. Held equal to the Twilight Sea (the two
         terminator seas share one doctrine) and to vanilla SeaIce's 0.1 (MEASURED from
         the def dump). ⚠️ A quicktest tune is OWED. -->
    <animalDensity>0.1</animalDensity>
    <coastalWildAnimals />

    <!-- GRAVTIDE SUPPORT, added 2026-09-07 (UNDERWATER_BIOME_SUPPORT_1).
         GravTide's arrival gate is generic - OceanArrivalPatches.IsOceanTile and
         OceanTileFeatures.IsWater both test PrimaryBiome.isWaterBiome - so this sea
         already qualifies for a gravship landing and a dive. What it lacked is the
         three things GravTide patches onto vanilla Ocean/Lake BY defName, which never
         reach a modded biome:
           1. terrainsByFertility - THE CRITICAL ONE. MapGenUtility.TerrainFrom() finds
              no terrain without it, logs "No terrain found in biome <X>" and falls back
              to TerrainDefOf.Sand, which is why an unpatched water biome generates an
              all-SAND map instead of a sea.
           2. baseWeatherCommonalities - otherwise every landing logs
              "All weather commonalities were zero. Defaulting to Clear."
           3. wildAnimalsCanWanderInto false - land animals have nowhere to walk from.
         Depth comes from NEGATIVE elevation (OceanTileFeatures.DepthOf = max(0,-elev));
         these tiles sit at -350 m, so ~350 m: past the ~150 m high-pressure nervous
         syndrome threshold, inside drysuit range (800 m). -->
    <wildAnimalsCanWanderInto>false</wildAnimalsCanWanderInto>
    <baseWeatherCommonalities>
      <Clear>12</Clear>
      <Fog>7</Fog>
      <Rain>4</Rain>
    </baseWeatherCommonalities>
    <terrainsByFertility>
      <li>
        <terrain>WaterOceanDeep</terrain>
        <min>-999</min>
        <max>999</max>
      </li>
    </terrainsByFertility>
  </BiomeDef>

</Defs>
