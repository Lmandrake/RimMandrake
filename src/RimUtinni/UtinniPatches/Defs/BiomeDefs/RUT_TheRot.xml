        <commonality>100</commonality>
      </li>
      <li>
        <diseaseInc>Disease_AnimalPlague</diseaseInc>
        <commonality>100</commonality>
      </li>
    </diseases>
    <terrainsByFertility>
      <li>
        <terrain>AB_MycoticGrass</terrain>
        <min>-999</min>
        <max>0.87</max>
      </li>
      <li>
        <terrain>AB_MycoticSoilRich</terrain>
        <min>0.87</min>
        <max>999</max>
      </li>
    </terrainsByFertility>
    <baseWeatherCommonalities>
      <Clear>8</Clear>
      <Rain>10</Rain>
      <DryThunderstorm>1</DryThunderstorm>
      <RainyThunderstorm>10</RainyThunderstorm>
      <FoggyRain>10</FoggyRain>
    </baseWeatherCommonalities>
    <wildAnimals>
