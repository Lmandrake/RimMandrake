<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    RUT_FeverWood                                  UtinniPatches - authored 2026-09-09
    BIOME_OWNERSHIP_WAVE_1. Full sheet: design/Jawa/worldbuilding/biomes/
    the_fever_wood.md (FROZEN). Replaces the donor `COMIGO_GreaterSwamp_Tropical`
    (Comigo's Greater Swamps, donor label "tropical swamp"). Sheet name: THE FEVER
    WOOD (the map's own region name).

    MEASURED (sheet SS0): 43 tiles, every one in the Fever Wood region, one
    contiguous lowland patch at 22 m, flat (43/43). Sun median +43 deg; temp median
    45.5 C. **Zero rivers, zero water tiles, zero rain** — the wet is the water
    table, tamed (SS3).

    Weather zeroed hard on rain and river-adjacent entries (Rain/RainyThunderstorm/
    FoggyRain all 0): the sheet's own MEASURED line is explicit — zero rain, zero
    rivers — the water table feeds the roots, not the sky (SS3 "Water from below,
    life from above. No rain, no rivers"). Fog kept modest (dim ground level, "dark
    mirrors... unrippled," SS1) but this is a placeholder, not a sheet-named weather
    event — no bespoke WeatherDef exists for the crown-vs-ground light split
    (SS Owed, `FEVER_WOOD_MECHANICS_1`).

    animalDensity/plantDensity kept at the donor's own values (sheet SS0: "kept and
    explained — animalDensity 2.3 low (the ground level's emptiness; the crown is
    where the life is), plantDensity 0.9" — note 0.9 read down slightly here since
    ground-level plantDensity in the engine cannot distinguish "crown" from "floor";
    flagged as an interim compromise, not a measured figure).

    wildAnimals/wildPlants: transplanted from BiomeCast_Ashkarr.xml /
    BiomeFlora_Ashkarr.xml against rosters/the_fever_wood.json. Ban 1 (the deep thing
    never resolved in ordinary play) and ban 2 (the Ants never an existing faction)
    are both plot/roster-level, not BiomeDef fields, and are not claimed satisfied by
    this def alone.

    NOT this pass's scope: `FEVER_WOOD_MECHANICS_1` in full (boughway network,
    nectar-for-safety economy, the two-front war, the deep thing built in full);
    Sporefall's treetop-town template; any world repaint.

  -->

  <BiomeDef>
    <defName>RUT_FeverWood</defName>
    <generatesNaturally>false</generatesNaturally>
    <label>the Fever Wood</label>
    <description>The place where trees finally won. Great solid trunks, much more than one tile wide, have rooted the backswamp still and solid, tamed the flowing waters into shallow surface pools with deep, deep mud beneath. Their arches and branches have grown into byways well above the dark still pools -- roads made of living wood. In the crown: a whole arboreal world. Below: the black mirrors, unrippled. Nothing goes in the water here. Everything remembers why.</description>
    <workerClass>ReGrowthCore.UniversalBiomeWorker</workerClass>
    <foragedFood>RawBerries</foragedFood>
    <allowRoads>true</allowRoads>
    <allowRivers>true</allowRivers>
    <allowFarmingCamps>true</allowFarmingCamps>
    <animalDensity>2.3</animalDensity>
    <plantDensity>0.7</plantDensity>
    <forageability>0.6</forageability>
    <movementDifficulty>5</movementDifficulty>
    <texture>World/Biomes/GreaterTropicalSwamp</texture>
    <diseaseMtbDays>20</diseaseMtbDays>
    <diseases>
      <li>
        <diseaseInc>Disease_Flu</diseaseInc>
        <commonality>70</commonality>
      </li>
      <li>
        <diseaseInc>Disease_Plague</diseaseInc>
        <commonality>50</commonality>
      </li>
      <li>
        <diseaseInc>Disease_Malaria</diseaseInc>
        <commonality>140</commonality>
      </li>
      <li>
        <diseaseInc>Disease_GutWorms</diseaseInc>
        <commonality>75</commonality>
      </li>
      <li>
        <diseaseInc>Disease_MuscleParasites</diseaseInc>
        <commonality>50</commonality>
      </li>
      <li>
        <diseaseInc>Disease_AnimalFlu</diseaseInc>
        <commonality>70</commonality>
      </li>
      <li>
        <diseaseInc>Disease_AnimalPlague</diseaseInc>
        <commonality>100</commonality>
      </li>
    </diseases>
    <terrainsByFertility>
      <li>
        <terrain>Soil</terrain>
        <min>-999</min>
        <max>0.9</max>
      </li>
      <li>
        <terrain>SoilRich</terrain>
        <min>0.9</min>
        <max>999</max>
      </li>
    </terrainsByFertility>
    <!--
      FEVER_WOOD_MECHANICS_1 F6/F7 build pass, 2026-09-14. Both extensions
      are generic RM_-tier (mandrake.rm.environmentalhazards), same
      GREENTIDE_MECHANICS_2 M9/M12 classes RUT_Greentide.xml itself already
      wires this exact way — cribbed directly, see RM_LivingBoleBiomeExtension.cs
      / RM_RootCausewayBiomeExtension.cs for the full field docs. A direct
      BiomeDef edit (not a Patch), matching RUT_Greentide.xml's own
      precedent for these two extensions specifically: each risky cross-
      reference is guarded at its own <li MayRequire=...>, not by wrapping
      the whole addition in a patch layer.
    -->
    <modExtensions>
      <!-- F7: the trunk. Cribbed straight from RUT_Greentide.xml's own
           boleCountRange/boleRadius/minSpacing/edgeMargin (kit spec gives
           no separate numbers for Fever Wood); roofDef left unset so the
           GenStep's own default (RoofDefOf.RoofRockThick) applies, same as
           Greentide. -->
      <li MayRequire="mandrake.rm.environmentalhazards" Class="RimMandrake.EnvironmentalHazards.RM_LivingBoleBiomeExtension">
        <heartwoodThing>RUT_FeverTrunkHeartwood</heartwoodThing>
        <coreMarkerThing>RUT_FeverTrunkCore</coreMarkerThing>
        <boleCountRange>1~2</boleCountRange>
        <boleRadius>4~6</boleRadius>
        <minSpacing>30</minSpacing>
        <edgeMargin>12</edgeMargin>
      </li>
      <!-- F6: the boughway network. Primary profile is the elevated
           network (RUT_Boughway); additionalPasses carries the "ground
           causeway... same GenStep's second pass" from the kit spec's own
           text (RUT_RootCauseway, reused verbatim from the sibling kit
           rather than a second terrain def — same "one def, reused
           cross-kit" shape RUT_Scald already set), narrower/shorter/fewer
           per anchor so it reads as the modest, cheap-to-walk alternative
           rather than a second full network. FEVERWOOD_BOUGH_SOIL_TERRAIN_1
           build: a third pass (RUT_BoughSoil) was added below, same
           machinery, painting fertile crown soil along that same anchor
           set — see its own comment on the <li> for why. basinTerrains on
           ALL THREE passes is Fever Wood's own two buildable ground
           terrains (terrainsByFertility above) — an ALLOWLIST that doubles
           as the water-avoidance answer to the spec's own ❓, see
           RUT_Boughway.xml's own header for the full resolution (map-gen
           SetTerrain has no Bridgeable-style gate to reuse in the first
           place; routing around the registered pools is the honest fix,
           not a drawn-fiction bridge). No basin hazard of its own to route
           OVER here (unlike Greentide's churnmud), so this is purely an
           exclude. -->
      <!-- F1: the mirror pools. OWNER RULING 2026-09-18 (FEVER_WOOD_MECHANICS_1
           ledger): "3-6 small pools per generated map, scattered with a
           minimum spacing between them, never a single large landmark-sized
           pool" — see RM_MirrorPoolBiomeExtension.cs's own field docs for how
           poolCountRange/poolRadiusRange encode that. poolTerrain is the F1
           TerrainDef itself (RUT_FeverWoodMirrorPool.xml), which already
           carries RM_LurkingWaterExtension — RUT_MapComponent_TheTenant scans
           the terrain grid for that extension directly, so painting this
           terrain is the whole wiring; no marker Thing or pool-identity list
           is needed. Ordered (RUT_FeverWood_ScatterPoolsGenStep.xml, order
           226) between F7's boles (222) and F6's causeways (228) so the
           causeways' basinTerrains allowlist below correctly routes around
           real pool cells. -->
      <li MayRequire="mandrake.rm.environmentalhazards" Class="RimMandrake.EnvironmentalHazards.RM_MirrorPoolBiomeExtension">
        <poolTerrain>RUT_FeverWoodMirrorPool</poolTerrain>
      </li>
      <li MayRequire="mandrake.rm.environmentalhazards" Class="RimMandrake.EnvironmentalHazards.RM_RootCausewayBiomeExtension">
        <causewayTerrain>RUT_Boughway</causewayTerrain>
        <basinTerrains>
          <li>Soil</li>
          <li>SoilRich</li>
        </basinTerrains>
        <pathsPerAnchorRange>3~6</pathsPerAnchorRange>
        <laneWidthRange>1~2</laneWidthRange>
        <pathLengthRange>20~40</pathLengthRange>
        <fallbackAnchorCountRange>1~3</fallbackAnchorCountRange>
        <fallbackMinAnchorSpacing>25</fallbackMinAnchorSpacing>
        <fallbackEdgeMargin>10</fallbackEdgeMargin>
        <additionalPasses>
          <li>
            <!-- RUT_RootCauseway carries no MayRequire of its own (plain
                 UtinniPatches TerrainDef, unlike RUT_ToxinSealant) — so
                 this reference needs none either. -->
            <causewayTerrain>RUT_RootCauseway</causewayTerrain>
            <basinTerrains>
              <li>Soil</li>
              <li>SoilRich</li>
            </basinTerrains>
            <pathsPerAnchorRange>1~2</pathsPerAnchorRange>
            <laneWidthRange>1~1</laneWidthRange>
            <pathLengthRange>10~20</pathLengthRange>
            <turnChancePerStep>0.3</turnChancePerStep>
          </li>
          <!-- FEVERWOOD_BOUGH_SOIL_TERRAIN_1 build. §6b: "a bespoke
               high-fertility terrain painted along the boughways and
               trunk tops" — third pass over the SAME anchor set (the
               registered bole centers, i.e. the trunk tops themselves;
               TraceSpline's own first PaintFootprint call is always at
               the anchor, so trunk tops get bough-soil even when a
               traced spline is short). basinTerrains is the identical
               Soil/SoilRich allowlist the two passes above already use —
               reusing the exact same list (not a new one) is what keeps
               the pool-exclusion property intact per the item's own
               warning: cells already converted to RUT_Boughway/
               RUT_RootCauseway by the two earlier passes, or painted
               RUT_FeverWoodMirrorPool by F1, are no longer Soil/SoilRich
               by the time this pass runs and so are automatically
               skipped — no lane or pool is ever overwritten.
               laneWidthRange/pathsPerAnchorRange wider than the boughway
               lane's own (1~2 / 3~6) so the fertile bed reads as a bed
               beside/around the network rather than a third narrow lane;
               pathLengthRange shorter since it doesn't need to span the
               map the way a travel lane does. All four numeric fields are
               an ENGINEERING DEFAULT — the item file's own "open, and NOT
               to be guessed" section: cell-selection footprint is UNSET
               by the owner. Flag for live tuning together with
               RUT_BoughSoil.xml's own fertility value. -->
          <li>
            <causewayTerrain>RUT_BoughSoil</causewayTerrain>
            <basinTerrains>
              <li>Soil</li>
              <li>SoilRich</li>
            </basinTerrains>
            <pathsPerAnchorRange>4~8</pathsPerAnchorRange>
            <laneWidthRange>2~4</laneWidthRange>
            <pathLengthRange>15~30</pathLengthRange>
            <turnChancePerStep>0.4</turnChancePerStep>
          </li>
        </additionalPasses>
      </li>
      <!-- F5 point 1: ground building-refusal. FEVER_WOOD_MECHANICS_1's own
           continuation pass (2026-09-13) flagged and declined to guess
           through a real gap: hard ban 4 ("no heavy structures on the
           ground") was not actually enforced anywhere, since Soil/SoilRich
           (terrainsByFertility above) both carry Heavy. Fixed via a GenStep
           sweep (RUT_FeverWood_GroundRefusalGenStep.xml, order 230 — after
           F1/F6's pool/causeway/bough-soil painting, order 226/228) rather
           than editing terrainsByFertility itself, per
           FEVERWOOD_BOUGH_SOIL_TERRAIN_1's own same-day "Watch out": that
           table is off-limits pending the terminal biome-paint pass. Reuses
           vanilla MarshyTerrain (no Medium/Heavy affordance, MEASURED
           against the shipped Core XML) rather than a bespoke terrain — no
           MayRequire needed, no invented fertility/texture value. See
           RM_GroundRefusalBiomeExtension.cs's own header for the full
           account. -->
      <li MayRequire="mandrake.rm.environmentalhazards" Class="RimMandrake.EnvironmentalHazards.RM_GroundRefusalBiomeExtension">
        <refusalTerrain>MarshyTerrain</refusalTerrain>
        <convertFromTerrains>
          <li>Soil</li>
          <li>SoilRich</li>
        </convertFromTerrains>
      </li>
    </modExtensions>
    <baseWeatherCommonalities>
      <Clear>30</Clear>
      <Fog>10</Fog>
      <Rain>0</Rain>
      <DryThunderstorm>1</DryThunderstorm>
      <RainyThunderstorm>0</RainyThunderstorm>
      <FoggyRain>0</FoggyRain>
      <SnowGentle>0</SnowGentle>
      <SnowHard>0</SnowHard>
      <Overcast MayRequire="Ludeon.RimWorld.Odyssey">2</Overcast>
    </baseWeatherCommonalities>
    <wildAnimals>
      <RSW_GlowSlug MayRequire="mandrake.rsw.swbestiary">0.5</RSW_GlowSlug>  <!-- glowslug - sap-drinker, keep -->
      <Urusai MayRequire="mlie.starwarsanimalcollection">0.5</Urusai>  <!-- urusai - crown-flier, keep -->
      <VFEI2_Megathrips MayRequire="oskarpotocki.vfe.insectoid2">0.5</VFEI2_Megathrips>  <!-- megathrips - wood-borer, keep -->
      <Gelagrub MayRequire="mlie.starwarsanimalcollection">0.4</Gelagrub>  <!-- gelagrub - crown-grazer, adjust-keep -->
      <RSW_Nuna MayRequire="mandrake.rsw.swbestiary">0.4</RSW_Nuna>  <!-- nuna - grazer, keep; DUPLICATE_CANON_DEFNAME_PAIRS_1: repointed from donor Nuna to the RSW_ port, owner-ruled merge 2026-09-23 -->
      <Convor MayRequire="mlie.starwarsanimalcollection">0.3</Convor>  <!-- convor - crown-flier, import -->
      <LongtailGorg MayRequire="mlie.starwarsanimalcollection">0.3</LongtailGorg>  <!-- longtail gorg - wait-ambush, keep -->
      <Whisperbird MayRequire="mlie.starwarsanimalcollection">0.3</Whisperbird>  <!-- whisperbird - crown-flier, import -->
      <RSW_JewelBeetle MayRequire="mandrake.rsw.swbestiary">0.2</RSW_JewelBeetle>  <!-- jewel beetle - crown-grazer, import -->
      <RSW_AcidSlug MayRequire="mandrake.rsw.swbestiary">0.05</RSW_AcidSlug>  <!-- acid slug - ground-slow, keep -->
      <Fambaa MayRequire="mlie.starwarsanimalcollection">0.02</Fambaa>  <!-- fambaa - the-terribly-lost, import -->
    </wildAnimals>
    <coastalWildAnimals />
    <wildPlants>
      <!-- DIRTY_CODE_REVIEW_STANDING_LOOP_1 wave 17: none of these seven carried a
           MayRequire, unlike every wildAnimals entry above and the sibling
           RUT_Greentide.xml's own wildPlants (which gates these exact same
           defNames). Verified owner against the live def dump
           (/DefDump/defs.sqlite): all seven belong to third-party mods, so
           without the guard an inactive donor throws an unresolved
           cross-reference at load instead of the silent MayRequire no-op
           every other cross-mod ref in this file relies on. -->
      <Plant_HydenockTree_Wild MayRequire="mlie.starwarsanimalcollection">1.5</Plant_HydenockTree_Wild>  <!-- wild hydenock tree - tree -->
      <AB_KeeningCordax MayRequire="sarg.alphabiomes">1.2</AB_KeeningCordax>  <!-- keening cordax - tree -->
      <RUT_GiantLeaf>0.8</RUT_GiantLeaf>  <!-- giant leaf -->
      <Plant_JoganTree_Wild MayRequire="mlie.starwarsanimalcollection">0.6</Plant_JoganTree_Wild>  <!-- wild jogan tree - tree -->
      <AB_Iashiphus MayRequire="sarg.alphabiomes">0.5</AB_Iashiphus>  <!-- iashiphus -->
      <AB_Gomphoeria MayRequire="sarg.alphabiomes">0.4</AB_Gomphoeria>  <!-- gomphoeria -->
      <Plant_Chakroot_Wild MayRequire="mlie.starwarsanimalcollection">0.4</Plant_Chakroot_Wild>  <!-- wild chak-root plant -->
    </wildPlants>
    <wildPlantRegrowDays>15</wildPlantRegrowDays>
  </BiomeDef>

</Defs>
