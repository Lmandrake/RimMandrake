<Defs>

  <ThingDef ParentName="PlantBase">
    <defName>RUT_BloomCrop</defName>
    <label>bloom crop</label>
    <description>A fast, gaudy annual that lives its whole life inside a single flood week — it germinates in standing water, races to full size in days, and sets seed before the flats dry back out from under it. Farmers who time a planting to the roar upstream get one of the biggest harvests on the planet; get it wrong and there is nothing here at all.</description>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <Flammability>0.3</Flammability>
      <Nutrition>0.35</Nutrition>
      <Beauty>2</Beauty>
    </statBases>
    <graphicData>
      <!-- Job rutbloomcrop_v1, filed this pass. Pending until the daemon lands it. -->
      <texPath>Things/Plant/RUT_BloomCrop</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <shadowData>
        <volume>(0.4, 0.2, 0.2)</volume>
        <offset>(0,0,-0.2)</offset>
      </shadowData>
    </graphicData>
    <selectable>true</selectable>
    <fillPercent>0.25</fillPercent>
    <pathCost>15</pathCost>
    <ingestible>
      <foodType>VegetableOrFruit</foodType>
      <preferability>RawTasty</preferability>
    </ingestible>
    <plant>
      <fertilityMin>0.5</fertilityMin>
      <fertilitySensitivity>0.9</fertilitySensitivity>
      <growDays>2.5</growDays>
      <growMinGlow>0.3</growMinGlow>
      <visualSizeRange>0.4~1.3</visualSizeRange>
      <topWindExposure>0.6</topWindExposure>
      <harvestYield>14</harvestYield>
      <harvestWork>250</harvestWork>
      <harvestTag>Standard</harvestTag>
      <harvestedThingDef>RawBerries</harvestedThingDef>
      <sowTags>
        <li>Ground</li>
      </sowTags>
      <sowMinSkill>3</sowMinSkill>
      <purpose>Food</purpose>
      <wildOrder>1.5</wildOrder>
    </plant>
  </ThingDef>

</Defs>
