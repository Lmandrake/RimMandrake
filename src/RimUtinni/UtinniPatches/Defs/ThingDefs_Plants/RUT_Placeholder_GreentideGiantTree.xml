<?xml version="1.0" encoding="utf-8" ?>
<!--
  RUT_Placeholder_GreentideGiantTree.xml   UtinniPatches — GREENTIDE_MECHANICS_2 M6

  PLACEHOLDER giant-tree Plant def — NOT the real roster giant that the
  flora roster pass eventually authors (this task's own brief explicitly
  forbids authoring that here, same posture RUT_Placeholder_SumpMouseRace
  already set for its own roster gap). Exists only so RM_TreeFallUtility,
  RM_CompCrackFall (feller 1) and RM_FellableTreeExtension are reachable and
  provably wired end-to-end, not just compiling in isolation. Confirmed by
  grep before this pass started: zero RUT_/RM_-named giant-tree Plant
  ThingDefs exist anywhere in src/ yet.

  ParentName="TreeBase" (Data/Core/Defs/ThingDefs_Plants/Plants_Bases.xml,
  read in full) — the same abstract every vanilla tree (Oak, Pine, etc.)
  descends from. Overrides sized up for "a giant comes down across ten
  tiles" (the kit spec's own player-experience line): MaxHitPoints and
  visualSizeRange raised well past a normal tree's, drawSize on the
  graphic bumped past the 1x1 footprint the same oversized-sprite-on-a-
  small-footprint idiom RUT_GreatboleCore (M12, this same folder tree)
  already established for this repo — GraphicData.drawSize is independent
  of collision size, verified by that item's own spike pass. All size/HP
  numbers below are INVENTED; no lore source gives a giant tree's exact
  stats.

  modExtensions: RM_FellableTreeExtension (isGiantClass=true) is what
  RM_TreeFallUtility.FellTree, the HediffComp_PeriodicAreaAttack hook
  (feller 2) and RM_JobGiver_GnawTreeBase (feller 3) all key off — see that
  extension's own header. greenwoodDef/hardwoodDef point at this same
  pass's RUT_Greenwood (ThingDefs_Items/) and the already-shipped
  RUT_Hardwood (M12).

  comps: CompProperties_CrackFall (feller 1) — see RM_CompCrackFall.cs's
  own header for the exact MTB/growth-scaling formula.

  PLACEHOLDER ART: flat-color placeholder PNG
  (Textures/Things/Plant/GreentideGiantTree/RUT_Placeholder_GreentideGiantTree.png),
  same discipline RUT_Hardwood.xml/RUT_Greenwood.xml already use in this
  pass — a real donor texPath under Things/Plants/ (AB_JungleTree and
  siblings) was deliberately NOT poached: those are reserved, already
  roster-tracked art (infrastructure/artpipe/done/jungletree_v1.json etc.)
  for the flora roster pass's own real giant, not this mechanism-proof
  stub — reusing the same file here risked a defName/asset collision with
  that future real def. DEPLOY_HOLD.
-->
<Defs>

  <ThingDef ParentName="TreeBase" MayRequire="mandrake.rm.environmentalhazards">
    <defName>RUT_Placeholder_GreentideGiantTree</defName>
    <label>giant tree (placeholder)</label>
    <description>PLACEHOLDER — stands in for the Greentide's real canopy giant (roster pass owed). Old, immense, and never quite stable on its own roots.</description>
    <graphicData>
      <texPath>Things/Plant/GreentideGiantTree/RUT_Placeholder_GreentideGiantTree</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(6,6)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>900</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <Nutrition>2.0</Nutrition>
      <Mass>1200</Mass>
    </statBases>
    <plant>
      <visualSizeRange>3.5~5.0</visualSizeRange>
      <growDays>90</growDays>
      <harvestYield>0</harvestYield>
      <wildClusterRadius>10</wildClusterRadius>
      <wildClusterWeight>2</wildClusterWeight>
    </plant>
    <modExtensions>
      <li Class="RimMandrake.EnvironmentalHazards.RM_FellableTreeExtension">
        <isGiantClass>true</isGiantClass>
        <fellLength>10</fellLength>
        <fallDamageRange>70~120</fallDamageRange>
        <heartRadius>1</heartRadius>
        <hardwoodDropRange>2~4</hardwoodDropRange>
        <greenwoodStackRange>10~25</greenwoodStackRange>
        <greenwoodDropChancePerCell>0.6</greenwoodDropChancePerCell>
        <greenwoodDef>RUT_Greenwood</greenwoodDef>
        <hardwoodDef>RUT_Hardwood</hardwoodDef>
      </li>
    </modExtensions>
    <comps>
      <li Class="RimMandrake.EnvironmentalHazards.CompProperties_CrackFall">
        <mtbDaysAtFullGrowth>8</mtbDaysAtFullGrowth>
        <minGrowthFraction>0.9</minGrowthFraction>
        <fallDelayTicksRange>300~900</fallDelayTicksRange>
      </li>
    </comps>
  </ThingDef>

</Defs>
