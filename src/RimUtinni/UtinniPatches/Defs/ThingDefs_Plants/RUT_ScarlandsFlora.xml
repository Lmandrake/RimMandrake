  Art: genuinely new, no existing render found. One job filed this pass,
  rutglower_v1 (infrastructure/artpipe/pending/rutglower_v1.json).
-->
<Defs>

  <ThingDef ParentName="PlantBase">
    <defName>RUT_Glower</defName>
    <label>the Glowers</label>
    <description>A glassy black varnish of moss and lichen, spread thick over crater bowls and hotspots wherever the ground still runs hot — it eats the radiation itself, the same trick Old Earth's own radiotrophic molds are said to have known. It thickens for centuries undisturbed. Scraped up, it burns crude and hot, and its ash makes a pigment nothing else on the planet can match.</description>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Flammability>0.1</Flammability>
      <Nutrition>0.1</Nutrition>
      <Beauty>0</Beauty>
    </statBases>
    <graphicData>
      <!-- Job rutglower_v1, filed this pass. Pending until the daemon lands it. -->
      <texPath>Things/Plant/RUT_Glower</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <drawSize>0.9</drawSize>
    </graphicData>
    <selectable>false</selectable>
    <hideAtSnowOrSandDepth>0.5</hideAtSnowOrSandDepth>
    <plant>
      <fertilityMin>0.02</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      <growDays>10</growDays>
      <dieIfLeafless>false</dieIfLeafless>
      <maxMeshCount>3</maxMeshCount>
      <visualSizeRange>0.5~0.9</visualSizeRange>
      <topWindExposure>0</topWindExposure>
      <harvestTag>Standard</harvestTag>
      <harvestedThingDef>RUT_GlowerCrust</harvestedThingDef>
      <harvestYield>3</harvestYield>
      <harvestWork>220</harvestWork>
      <harvestAfterGrowth>0.4</harvestAfterGrowth>
      <wildOrder>1</wildOrder>
      <purpose>Misc</purpose>
    </plant>
  </ThingDef>

</Defs>
