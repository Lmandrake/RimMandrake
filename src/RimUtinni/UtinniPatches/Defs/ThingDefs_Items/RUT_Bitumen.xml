<Defs>

  <ThingDef ParentName="ResourceBase">
    <defName>RUT_Bitumen</defName>
    <label>bitumen</label>
    <description>Solid black pitch, rendered from raw tar until it sets hard. Waterproofing, adhesive, torch-fuel, road-metal — half the Sump's economy runs on this one substance in one form or another, and the old paved roads were made from exactly this.</description>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <graphicData>
      <texPath>Things/Item/Resource/RUT_Bitumen</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(24, 22, 20)</color>
    </graphicData>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <MarketValue>1.8</MarketValue>
      <Mass>0.35</Mass>
      <Flammability>0.7</Flammability>
      <DeteriorationRate>1</DeteriorationRate>
    </statBases>
    <stackLimit>100</stackLimit>
    <techLevel>Neolithic</techLevel>
  </ThingDef>

</Defs>
