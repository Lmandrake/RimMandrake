<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  RUT_DeadCreep.xml                      UtinniPatches · FORGE_MECHANICS_1 F5
  ============================================================================
  forge_kit_spec.md F5 "the Contagion die-off ring" (§4, §5). "Every so often
  the Contagion pushes a tongue of red up the slope, it blackens and dies
  within hours, and the ring is renewed." This is the blackened remainder —
  left behind at the map-edge scatter pass (RUT_ContagionRingScatter.xml,
  this pass) and at every RUT_DyingCreep instance's own death
  (RM_CompScriptedDieOff.deadThingDef, wired in RUT_DyingCreep.xml).

  Plain filth, no comps — same crib shape RM_FE_Filth_LooseAsh.xml already
  established (ParentName="BaseFilth", thingClass Filth, no C# needed:
  RM_CompScriptedDieOff's own DieNow() spawns it via
  FilthMaker.TryMakeFilth). disappearsInDays kept LONG (the sheet's own
  "always fresh" framing means the ring should read as standing ground
  cover between Contagion pushes, not vanish in days like ordinary blood).
  rainWashes false, deliberately: ban 6 (no ordinary rain reaches this
  biome — F1's RUT_ForgePulse forces RUT_ForgeStill/RUT_BoilingRain
  unconditionally) means SteadyEnvironmentEffects' rain-wash path is
  structurally unreachable here anyway, but leaving it true would be a
  silent lie about a mechanism that can never fire.

  🔴 Texture: intended to reuse vanilla Filth_Blood's own art
  (Things/Filth/Spatter) with a darker/desaturated tint — "blackens" per
  the sheet's own line — but validate_patch.py flags that choice as a hard
  ERROR under its own-namespace heuristic (UtinniPatches already ships its
  own Things/* tree elsewhere, so it cannot distinguish a deliberate
  cross-mod reuse from a typo in this mod's own art; see RUT_TibannaGas.xml's
  own header for the full reasoning). Points at its OWN new texPath instead
  (Things/Filth/RUT_DeadCreep) and is held via src/DEPLOY_HOLD.txt until art
  lands.
  ============================================================================
-->
<Defs>

  <ThingDef ParentName="BaseFilth">
    <defName>RUT_DeadCreep</defName>
    <label>dead creep</label>
    <description>A blackened, dried-out mat of creep — the Contagion's own dead, left on ground it could not hold.</description>
    <altitudeLayer>Filth</altitudeLayer>
    <category>Filth</category>
    <drawerType>MapMeshOnly</drawerType>
    <filth>
      <cleaningSound>Interact_CleanFilth</cleaningSound>
      <ignoreFilthMultiplierStat>true</ignoreFilthMultiplierStat>
      <disappearsInDays>25~35</disappearsInDays>
      <rainWashes>false</rainWashes>
      <cleaningWorkToReduceThickness>70</cleaningWorkToReduceThickness>
      <canFilthAttach>true</canFilthAttach>
    </filth>
    <graphicData>
      <graphicClass>Graphic_Cluster</graphicClass>
      <shaderType>Transparent</shaderType>
      <texPath>Things/Filth/RUT_DeadCreep</texPath>
      <color>(40, 34, 30, 200)</color>
    </graphicData>
    <statBases>
      <Beauty>-14</Beauty>
      <Cleanliness>-10</Cleanliness>
    </statBases>
    <thingClass>Filth</thingClass>
    <useHitPoints>false</useHitPoints>
  </ThingDef>

</Defs>
