<?xml version="1.0" encoding="utf-8"?>
<!--
  BLUE_DESERT_LIFE_AUTHORING_1 (step 2-5) — RM_ColdWax, per design brief §7.
  Adopted from RUT_hydrocarbon_ecology_commission.md §14g ("cold wax ...
  refines to chemfuel at a cold-handled recipe ... warm storage detonates
  it"). One item for every native's butchery (§3a/§4a/§5a butcherProducts)
  and every flora card's harvest (RM_BlueDesertFlora.xml harvestedThingDef).

  comps, verbatim chemfuel shape (Core ThingDef Chemfuel, raw) plus the two
  that make "cold-handled only" a fact about ROOMS rather than a recipe gate
  (§7): CompProperties_TemperatureRuinable ruins the stack in a warm room
  (~79s real time at maxSafeTemperature -1, brief §2c arithmetic) and
  broadcasts "RuinedByTemperature"; RM_CompRuinedDetonator (BlueDesertLife.cs)
  is the missing wire that makes CompExplosive listen for that signal and
  start its wick — CompExplosive does not listen for it on its own.

  MarketValue intentionally NOT set here — parked on ECONOMY_TRADE_SWEEP_1,
  same as the prior brief. A refinery recipe (RM_ColdWax x5 -> Chemfuel x10,
  brief §7) is OWED, not built in this pass: no vanilla "refinery" workbench
  exists to hang it on, and the biome's life/wiring/settings are this item's
  scope — the recipe is scoped for a future pass, not silently dropped.
-->
<Defs>

  <ThingDef ParentName="ResourceBase">
    <defName>RM_ColdWax</defName>
    <label>cold wax</label>
    <description>A waxy hydrocarbon rendered from a Blue Desert native's fuel glands or gut-oil, or harvested straight from its fractal flora. Inert and stable in the cold; store or refine it anywhere warm and it will not stay inert for long.</description>
    <possessionCount>20</possessionCount>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Item/Resource/RM_ColdWax/RM_ColdWax</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.85</drawSize>
    </graphicData>
    <stackLimit>75</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <Mass>0.05</Mass>
      <Flammability>2</Flammability>
      <DeteriorationRate>1</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Explosive">
        <explosiveRadius>1.1</explosiveRadius>
        <explosiveDamageType>Flame</explosiveDamageType>
        <explosiveExpandPerStackcount>0.037</explosiveExpandPerStackcount>
        <startWickOnDamageTaken>
          <li>Flame</li>
        </startWickOnDamageTaken>
        <startWickHitPointsPercent>0.333</startWickHitPointsPercent>
        <preExplosionSpawnThingDef>Filth_Fuel</preExplosionSpawnThingDef>
        <preExplosionSpawnChance>1</preExplosionSpawnChance>
        <wickTicks>70~150</wickTicks>
      </li>
      <li Class="CompProperties_TemperatureRuinable">
        <minSafeTemperature>-273</minSafeTemperature>
        <maxSafeTemperature>-1</maxSafeTemperature>
        <progressPerDegreePerTick>1E-05</progressPerDegreePerTick>
      </li>
      <li Class="Verse.CompProperties">
        <compClass>RimMandrake.BlueDesert.RM_CompRuinedDetonator</compClass>
      </li>
    </comps>
  </ThingDef>

</Defs>
