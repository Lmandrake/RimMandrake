<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RimWorld 1.6 runs Unity/Mono against a .NET Framework 4.7.2 profile, so
    the mod DLL must target net472. Same shape as
    src/RimUtinni/LanternDeeps/Source/RimMandrake.Utinni.LanternDeeps.csproj,
    copy that file's own header if this one goes stale. No Harmony reference:
    GenStep_ScatterGeysersDensityField is a plain GenStep_ScatterGeysers
    subclass (GEOTHERMAL_DENSITY_FIELD_1), discovered by RimWorld's own
    GenStepDef the moment Patches/GeothermalDensityField.xml points its
    genStep Class at it; no patch registration call needed.

    References RimMandrake.WeatherSuite's WeatherSuiteHook.dll for
    WeatherGeometryUtility.ArcFromSubstellar — the shared arc/terminator
    formula, not reinvented here. mandrake.rm.weathersuite (and, at runtime,
    mandrake.rut.weathersuite for the actual PlanetGeometryDef data) are
    declared as modDependencies in ../About/About.xml.

    Build (dotnet is WINDOWS-NATIVE, cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\Rimworld\src\RimUtinni\UtinniPatches\Source\RimMandrake.Utinni.UtinniPatches.csproj -c Release

    Output lands in ../Assemblies/, which is where RimWorld looks.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrake.Utinni.UtinniPatches</AssemblyName>
    <RootNamespace>RimMandrake.Utinni.UtinniPatches</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="GeothermalDensityField.cs" />
    <!-- TWINKLE_FLORA_SPIKE_1 (2026-09-10): timeboxed feasibility spike, not
         a shipped feature: see the .cs file's own header and
         infrastructure/state/items/TWINKLE_FLORA_SPIKE_1.md. -->
    <Compile Include="TwinkleFloraSpike.cs" />
    <!-- SHRINE_GUARDIAN_BIOME_GATE_1 (2026-09-10): plain subclass of Core's
         SymbolResolver_Interior_AncientTemple, swapped in by
         Patches/AmbientShrineGuardians.xml. Still no Harmony reference on this
         project — see that file's and the .cs header's own notes. -->
    <Compile Include="AmbientShrineGuardians.cs" />
    <Compile Include="UtinniPatchesSettings.cs" />
    <!-- UTINNI_WORLDMAP_FLIGHT_ICON_1 (2026-09-12): the PatchOperation subclass
         that lets Patches/UtinniWorldIcon.xml respect a Mod Settings toggle.
         Named by Class= in that XML, so it has no C# caller — do not read the
         absence of one as dead code. -->
    <Compile Include="PatchOperationSettingGate.cs" />
    <!-- BLUE_DESERT_LIFE_AUTHORING_1 (2026-09-21): dorrak/krissek/vekkit and the
         transparent fractal flora's mechanics. Namespace is RimMandrake.BlueDesert,
         not RimMandrake.Utinni.UtinniPatches; see the file's own header for why
         (RimMandrake-tier content housed here only until BLUEDESERT_RM_MOD_BUILD_1
         scaffolds mandrake.rm.bluedesert). -->
    <!-- CRACKED_LANDS_SEALED_WAKE_MECHANISM_1 (2026-09-25): the water-terrain
         wake trigger + crack-wax ground-drop RUT_SealedSleeper.xml's own
         header deferred. See the .cs file's own header for the mechanism. -->
    <Compile Include="RUT_CompWaterWakeTrigger.cs" />
    <!-- GREATBOLE_HARVEST_LADDER_1 (2026-09-25): the three named threshold
         events (Great Shaking/violent healing/catastrophe) on RUT_GreatboleCore,
         and the Fruitfall random incident. Both need
         RimMandrake.EnvironmentalHazards's RM_MapComponent_LivingRegrowth /
         RM_CompLivingBoleMarker — see the assembly Reference below. -->
    <Compile Include="RUT_CompGreatboleHarvestLadder.cs" />
    <Compile Include="RUT_IncidentWorker_GreatboleFruitfall.cs" />
    <!-- SUMP_UTINNI_LAYER_1 (2026-09-26): the flame statue's "perform the
         sun-rite" Use interaction — fires RUT_PerformedHolyFlameAct so the
         RUT_HolyFlame_Revered ideoligion precept can grant its memory
         thought. See the .cs file's own header for the mechanism. -->
    <Compile Include="RUT_CompUseEffect_HolyFlame.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The shared arc/terminator engine (RimMandrake.StarWars.WeatherSuite.
         WeatherGeometryUtility.ArcFromSubstellar) — built from the repo copy
         at src/RimMandrake/WeatherSuite/Source, output already committed at
         src/RimMandrake/WeatherSuite/Assemblies/WeatherSuiteHook.dll. Not
         referenced from the deployed Mods folder: this repo path is the one
         guaranteed to exist for anyone building from source. -->
    <Reference Include="WeatherSuiteHook">
      <HintPath>..\..\..\RimMandrake\WeatherSuite\Assemblies\WeatherSuiteHook.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- GREATBOLE_HARVEST_LADDER_1: RM_MapComponent_LivingRegrowth's small
         read-only query API (GetRemovedFraction/GetBoleCenter/
         GetFootprintCells/AllBoleIds) and RM_CompLivingBoleMarker.BoleId —
         same "reference the repo-built dll directly" posture as
         WeatherSuiteHook above. -->
    <Reference Include="RimMandrake.EnvironmentalHazards">
      <HintPath>..\..\..\RimMandrake\EnvironmentalHazards\Assemblies\RimMandrake.EnvironmentalHazards.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
