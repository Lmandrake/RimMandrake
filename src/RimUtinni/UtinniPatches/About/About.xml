<?xml version="1.0" encoding="utf-8"?>
<ModMetaData>
  <packageId>mandrake.rut.patches</packageId>
  <name>RimUtinni Patches (Jawa campaign)</name>
  <author>mandrake</author>
  <description>The Utinni campaign patch layer: factions, scenario, doctrine, Ash'karr worldbuilding patches. Split 2026-09-04 from Jawa Patches (mandrake.jawa.patches) per JAWA_PATCHES_SPLIT_1; tiers per infrastructure/state/jawa_patches_split_map.csv, owner-confirmed 2026-09-01. Every patch is MayRequire/Conditional-guarded. LOAD LAST of the three patch tiers, after every mod it touches.</description>
  <supportedVersions>
    <li>1.6</li>
  </supportedVersions>
<loadAfter>
