    <li>Neronix17.OuterRim.RebelAlliance</li>               <!-- OuterRim_RebelAlliance       RebelAlliance_Suppress.xml -->
    <li>Neronix17.OuterRim.GalacticDiversity</li>           <!-- OuterRim_Jawa, OuterRim_WookieeHead -->
    <li>Neronix17.OuterRim.DroidDepot</li>                  <!-- OuterRim_*Droid              DroidFemaleTexture_Fix.xml -->
    <li>Neronix17.Outland.Genetics</li>                     <!-- Outland_AllMale              JawaAppearance_Tuning.xml -->
    <li>LazyFridayStudio.GenesExpandedEyes</li>             <!-- Eyes_*_Feline / Eyes_*_Reptile -->
