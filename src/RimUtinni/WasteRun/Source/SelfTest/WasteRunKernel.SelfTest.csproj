<Project Sdk="Microsoft.NET.Sdk">
  <!--
    WASTE_RUN_STUBS_1. Offline, no-game selftest: compiles the REAL WasteRunKernel.cs.
    NOT the mod build (RimMandrake.Utinni.WasteRun.csproj, one directory up, lists no file in this folder).
    Run: python3 src/RimUtinni/WasteRun/selftest_wasterun_kernel.py
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WasteRunKernel.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.Utinni.WasteRun.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DebugType>none</DebugType>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Compile Include="Program.cs" />
    <Compile Include="..\WasteRunKernel.cs" Link="WasteRunKernel.cs" />
  </ItemGroup>
</Project>
