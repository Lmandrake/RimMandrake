<?xml version="1.0" encoding="utf-8"?>
<!--
  RUT_SpireCommandConsole - ASHFALL_RESEARCH_BASE_1's core reveal-beat: "an
  isolated system within the command center (dark spire)" (ashfall_research_
  base.md §6, owner verbatim) that held the Rakatan command codes and, per
  §2, the base's own datafiles (the Overdrive program, the Helix-Assailant
  lineage reveal). Same discipline as RUT_WarLabArchive/
  RUT_DarkTowerControlConsole: a narrative-anchor claimable building, no new
  C# reveal system this pass (the doc's own §6 reveal-gating ruling -
  "encrypted, the antiquities literacy ladder unlocks" - needs the
  Antiquities mod's literacy system wired to this specific object, which is
  real follow-up work, not invented here; flagged rather than guessed).

  RUT_RakatanCommandCodes (the portable prize) is placed ADJACENT to this
  console in the KCSG grid (Source/Ashfall/gen_ashfall_layout.py), not
  generated BY it - the console is where the crew reads what the Helix were
  doing; the codes are what the crew physically walks out with.

  Art: reuses Things/Building/Ship/ShipComputerCore, the same placeholder
  RUT_WarLabArchive/RUT_VaultHeart/RUT_DarkTowerControlConsole already use -
  no new art authored this pass, matching that established convention.
-->
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>RUT_SpireCommandConsole</defName>
    <label>the command console</label>
    <description>An isolated system, still drawing power from somewhere that was never supposed to still be running. It was never connected to anything outside this room — not the Cathedral, not the network the Helix built over it, nothing. Whoever built this wanted exactly one thing to always be true: that only a hand physically in this room could ever touch what it holds.\n\nThe datafiles here are the Overdrive's own paperwork — what the Helix are doing to the Contagion, filed, initialed, and overridden — and beneath all of it, older by an age, the codes.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Ship/ShipComputerCore</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1.5,1.5)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>1</fillPercent>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>800</MaxHitPoints>
      <Flammability>0</Flammability>
      <Beauty>-5</Beauty>
    </statBases>
    <building>
      <deconstructible>false</deconstructible>
      <claimable>true</claimable>
    </building>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>7</glowRadius>
        <glowColor>(180,150,255,0)</glowColor>
      </li>
    </comps>
  </ThingDef>
</Defs>
