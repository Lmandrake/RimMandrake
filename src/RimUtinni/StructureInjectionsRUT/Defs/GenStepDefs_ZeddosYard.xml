<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Zeddo's Salvage Yard - PLAYER_START_SITE_1, the formal player start (owner card 2026-09-08:
       "Zeddo's Yard", tile 17007, one tile from Zeddo's Toll 17006; canon.yml planet.start_tile).
       Scenario_Utinni's crawl: "The Hutts keep a mountain of the galaxy's discards out here".

       The plan (Templates/zeddos_yard.txt) is GENERATED by
       Source/ZeddosYard/gen_zeddos_yard_plan.py - edit the generator, never the .txt. It is a ring of
       hauled ship junk (the real skyline) piled against two broken arcs of AncientMegastructure ground
       (the injected skyline), around an EMPTY landing clearing of 100 x 94 at the map centre: the v2
       Utinni ring hull is 92 x 86, plus the 2-cell margin GRAVSHIP_LANDING_FOG_REVEAL_1 asks for.

       Order 400 is deliberate: Odyssey's GenStep_ReserveGravshipArea runs at 600 and picks the landing
       spot by overlap-cost minimisation, so the yard must already stand when it looks, and the empty
       middle is where the ship comes down.

       No biomeWhitelist: this mutator is placed by hand on exactly one tile, 17007, and that tile's
       biome is repainted at the end (BIOME_PAINT_ONCE_AT_THE_END_1, canon.yml
       planet.start_tile_mutator). -->
  <GenStepDef>
    <defName>RUT_GenStep_ZeddosYard</defName>
    <genStep Class="RimMandrake.StructureInjections.GenStep_RimplacePlan">
      <planFile>Templates/zeddos_yard.txt</planFile>
      <centerOnMap>true</centerOnMap>
    </genStep>
    <order>400</order>
  </GenStepDef>

  <TileMutatorDef>
    <defName>RUT_ZeddosYard</defName>
    <label>Zeddo's salvage yard</label>
    <description>A Hutt junkyard: a mountain of the galaxy's discards, hauled in over decades along Zeddo's toll road and piled against the broken arcs of something far older than the Cartel. The middle of the yard is kept clear for whatever lands next.</description>
    <extraGenSteps>
      <li>RUT_GenStep_ZeddosYard</li>
    </extraGenSteps>
  </TileMutatorDef>

</Defs>
