<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  AshfallBattery.xml   StructureInjectionsRUT (mandrake.rut.injections)   TILE_STRUCTURE_DESIGNS_1
  ============================================================================
  Wires PROMISE #17 The Ashfall Battery onto vanilla `AncientLaunchSite`
  (Ludeon.RimWorld.Odyssey, workerClass RimWorld.TileMutatorWorker_
  AncientStructure) - the same def `sacred_sites_pass_1.md` §1a cites as its
  own "worked example". Confirmed a real TileMutatorDef by direct read of
  `unused_mutators_census.md`'s Part-1 in-use-mutator list (measured from
  the offline def dump, per that doc's own 2026-09-07 correction) - NOT
  `tile_augmentation_catalogue.md`'s own table, which mistakenly lists
  AncientLaunchSite as a LandmarkDef. Resolved against the live def dump
  itself (2026-09-18T05-05-13Z capture, defs/TileMutatorDef.json), not
  either doc: `defType: "TileMutatorDef"` on the def record.

  `AncientLaunchSite` carries `extraGenSteps: []` in that same capture -
  confirmed by direct read, not guessed - so this Add targets the
  TileMutatorDef node itself and adds a WHOLE `<extraGenSteps>` element,
  same shape as Dunes/DryLake/Hollow/Caves/AncientUplink (this pass's own
  SignalMast.xml, RM tier), not the "append one more <li>" shape used where
  the target already carries one (RUT_Monument, RUT_BrokenRing,
  sw_SarlaccLair).

  Same safety convention as every prior whisper/promise patch in this
  program: the PatchOperationAdd is wrapped in a PatchOperationConditional
  whose xpath is IDENTICAL to the inner operation's target, so an
  absent/renamed def makes the whole <li> a silent no-op.
  ============================================================================
-->
<Patch>

  <!-- PROMISE #17 The Ashfall Battery -> AncientLaunchSite (Ludeon.RimWorld.Odyssey). -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/TileMutatorDef[defName="AncientLaunchSite"]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/TileMutatorDef[defName="AncientLaunchSite"]</xpath>
      <value>
        <extraGenSteps>
          <li>RUT_GenStep_AshfallBattery</li>
        </extraGenSteps>
      </value>
    </match>
  </Operation>

</Patch>
