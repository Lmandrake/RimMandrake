<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WAR_LAB_CRATER_HOOK_1: the ignition-to-crater worldmap-tile mutation.
    First C# for this mod (previously XML+KCSG only, via the python layout
    generators in Source/WarLab, VaultDungeons, DarkTower). No Harmony:
    GameComponent and ThingComp are vanilla extension points, nothing is
    patched. Mirrors src/RimUtinni/ShipMemory/Source/RimMandrake.Utinni.ShipMemory.csproj
    (net472, OutputPath ..\Assemblies\, no Harmony reference).

    Build (the dotnet is WINDOWS NATIVE and cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\Rimworld\src\RimUtinni\StructureInjectionsRUT\Source\RimMandrake.Utinni.StructureInjectionsRUT.csproj -c Release

    Output lands in ../Assemblies/, which is where RimWorld looks.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrake.Utinni.StructureInjectionsRUT</AssemblyName>
    <RootNamespace>RimMandrake.Utinni.StructureInjectionsRUT</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="WarLab\WarLabCraterMutation.cs" />
    <Compile Include="WarLab\GameComponent_WarLabCrater.cs" />
    <Compile Include="WarLab\CompIgniteCraterOnDestroy.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
