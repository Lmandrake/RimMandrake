<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RECLAMATION_TRIGGER_REWIRE_WOKEN_COUNT: offline selftest of the woken-ancients
    counting rule. Compiles the REAL production WokenAncientsKernel.cs (no Verse
    dependency, so no RimWorld references). NOT the mod build: the mod's csproj one
    directory up sets EnableDefaultCompileItems false and never lists this folder.

    Run via the wrapper:
      python3 src/RimMandrake/Utils/selftest_reclamation_trigger.py
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>StructureInjectionsRUT.SelfTest</AssemblyName>
    <RootNamespace>StructureInjectionsRUT.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <DebugType>none</DebugType>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\VaultDungeons\WokenAncientsKernel.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
