<?xml version="1.0" encoding="utf-8"?>
<!--
  RUT_Sinking.xml                  mandrake.rut.rites - SUMP_SINKING_RITE_BUILD_1

  The Sinking, Ishko's rite at the tar (Sump Rite A). Worshippers give a thing of worth to the tar and it is gone.
  Rulings: Ishko's; it NEVER lowers Imperial Heat - it holds the Empire off (the next Imperial probe or raid comes 5x
  further away) and keeps a lull on ordinary (non-Empire) raids beside it.

    RUT_ImperialHoldOff   condition: Imperial raids/probes refused at the door; the EmpirePursuit ladder moved out 5x
    RUT_TarLull_Raids     condition: ordinary enemy raids fire at a lowered chance
    RM_TarLull_Beast      condition (pitch offering): building, digging and pumping do not wake the bulges; damage still does
    RUT_Ritual_Sinking    the precept. §1 (the inscription that grants it) is out of scope: until it lands, the dev action
                          "Grant the Sinking (Ishko) to the player ideo" (Source/Sinking/SinkingProbe.cs) adds it.

  Workers: Source/Sinking/*.cs, deciding through Source/Kernel/SinkingKernel.cs. No hediff or stat on participants:
  cohesion is the outcome memory only. No material reward. Faction suspicion is not erased.
  Gate: Ideology on every ritual def type; the three conditions are plain GameConditionDefs.
-->
<Defs>

  <GameConditionDef>
    <defName>RUT_ImperialHoldOff</defName>
    <conditionClass>GameCondition</conditionClass>
    <label>Imperial hold-off</label>
    <description>Something was given to the tar, and the Empire's eye slides off this ground. Their next probe or raid comes much later than it would have. (Imperial attention itself is unchanged: this only delays it.)</description>
  </GameConditionDef>

  <GameConditionDef>
    <defName>RUT_TarLull_Raids</defName>
    <conditionClass>GameCondition</conditionClass>
    <label>tar lull</label>
    <description>The smell of the tar hangs over the colony since the Sinking. Ordinary raiders think twice about coming: raids are less likely while it lasts.</description>
  </GameConditionDef>

  <GameConditionDef>
    <defName>RM_TarLull_Beast</defName>
    <conditionClass>GameCondition</conditionClass>
    <label>the bulges lie still</label>
    <description>Pitch was given back to the pitch. While this lasts, building near a tar bulge, digging deep or running a pump will not wake what sleeps in it. A blow or a blast still will.</description>
  </GameConditionDef>

  <ThoughtDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>RUT_SankItForIshko</defName>
    <thoughtClass>Thought_AttendedRitual</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>3</stackLimit>
    <stages>
      <li>
        <label>we gave it to the tar</label>
        <description>We stood at the tar and watched it go down, slowly, until the last bubble broke. Ishko has it now. Let them come looking.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <PreceptDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>RUT_Ritual_Sinking</defName>
    <label>the Sinking</label>
    <description>What the tar takes, no one can find. Worshippers give a thing of worth to the tar for Ishko, the Unmaskable, and it sinks out of every ledger. The offering must lie at the tar's edge. The Empire's eye slides off the colony for a while, ordinary raiders think twice, and foreign claims on the colony's things are wiped. Pitch given back calms the bulges; a find given back to the depth spoils the next traps in the dig. Never a person, never a body.</description>
    <issue>Ritual</issue>
    <impact>Medium</impact>
    <iconPath>UI/Icons/Rituals/RitualScarification</iconPath>
    <preceptClass>Precept_Ritual</preceptClass>
    <ritualPatternBase>RUT_SinkingPattern</ritualPatternBase>
    <allowDuplicates>false</allowDuplicates>
    <countsTowardsPreceptLimit>false</countsTowardsPreceptLimit>
    <canGenerateAsSpecialPrecept>false</canGenerateAsSpecialPrecept>
    <receivesExpectationsQualityOffset>true</receivesExpectationsQualityOffset>
    <notifyPlayerOnOpportunity>false</notifyPlayerOnOpportunity>
  </PreceptDef>

  <RitualPatternDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>RUT_SinkingPattern</defName>
    <ritualBehavior>RUT_SinkingBehavior</ritualBehavior>
    <ritualObligationTargetFilter>RUT_SinkingOffering</ritualObligationTargetFilter>
    <ritualOutcomeEffect>RUT_SinkingOutcome</ritualOutcomeEffect>
    <canStartAnytime>true</canStartAnytime>
    <alwaysStartAnytime>true</alwaysStartAnytime>
    <shortDescOverride>the Sinking</shortDescOverride>
    <descOverride>Worshippers give a thing of worth to the tar for Ishko, and watch it go down.</descOverride>
    <ritualExplanation>Select an item of worth: pitch, a find from the dig, or anything else valuable. It is destroyed. The Empire's next probe comes later, raids ease for a while, and foreign claims on the colony's things are wiped. Imperial attention itself does not fall. People and bodies are refused.</ritualExplanation>
  </RitualPatternDef>

  <RitualObligationTargetFilterDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>RUT_SinkingOffering</defName>
    <workerClass>RimMandrake.Utinni.Rites.RUT_RitualObligationTargetWorker_SinkingOffering</workerClass>
  </RitualObligationTargetFilterDef>

  <RitualBehaviorDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>RUT_SinkingBehavior</defName>
    <workerClass>RimMandrake.Utinni.Rites.RUT_RitualBehaviorWorker_Sinking</workerClass><!-- forbids the offering at the start, unforbids it on cancel -->
    <durationTicks>2500</durationTicks>
    <roles /><!-- Dialog_BeginRitual.CreateRitualRoleAssignments foreach-es behavior.def.roles; null NREs the rite start -->
    <spectatorsLabel>Witnesses</spectatorsLabel>
    <spectatorGerund>witness</spectatorGerund>
    <stages>
      <li>
        <defaultDuty>Spectate</defaultDuty>
        <essential>True</essential>
        <endTriggers>
          <li Class="StageEndTrigger_DurationPercentage">
            <percentage>1</percentage>
          </li>
        </endTriggers>
      </li>
    </stages>
  </RitualBehaviorDef>

  <RitualOutcomeEffectDef MayRequire="Ludeon.RimWorld.Ideology">
    <defName>RUT_SinkingOutcome</defName>
    <description>The offering sinks into the tar and is gone. The Empire's next probe comes later, raids ease, and foreign claims on the colony's things are wiped.</description>
    <workerClass>RimMandrake.Utinni.Rites.RUT_RitualOutcomeEffectWorker_Sinking</workerClass>
    <startingQuality>0.3</startingQuality>
    <comps>
      <li Class="RimMandrake.Utinni.Rites.RUT_RitualOutcomeComp_OfferingValue">
        <label>offering's worth</label>
        <curve>
          <points>
            <li>(50, 0.0)</li>
            <li>(500, 0.15)</li>
            <li>(3000, 0.3)</li>
          </points>
        </curve>
      </li>
      <li Class="RitualOutcomeComp_ParticipantCount">
        <label>witnesses</label>
        <curve>
          <points>
            <li>(1, 0.0)</li>
            <li>(4, 0.3)</li>
            <li>(8, 0.5)</li>
          </points>
        </curve>
      </li>
    </comps>
    <outcomeChances>
      <li>
        <chance>0.2</chance>
        <label>Poor</label>
        <description>The {0} was hurried. The tar took it all the same.</description>
        <positivityIndex>-1</positivityIndex>
      </li>
      <li>
        <chance>0.4</chance>
        <label>Fair</label>
        <description>The {0} was done. It went down slowly.</description>
        <positivityIndex>1</positivityIndex>
      </li>
      <li>
        <chance>0.3</chance>
        <label>Good</label>
        <description>The {0} was done well. Everyone watched the last bubble break.</description>
        <memory>RUT_SankItForIshko</memory>
        <positivityIndex>2</positivityIndex>
      </li>
      <li>
        <chance>0.1</chance>
        <label>Excellent</label>
        <description>The {0} will be told of. No one spoke until the tar was still.</description>
        <memory>RUT_SankItForIshko</memory>
        <positivityIndex>3</positivityIndex>
      </li>
    </outcomeChances>
  </RitualOutcomeEffectDef>

</Defs>
