<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Salvation Rites' C#: the Ninefold nine-god favour engine (folded in from
    mandrake.rm.ninefold on the owner's 2026-10-22 ruling, "the Nine Gods
    belong in Salvation Rites"): the satiation/mood vector, band ladder, Mood
    random walk, the Patch_*.cs event hooks, favour tilts, the Nine Faults
    rite's workers, the offerings and the settings screen. NinefoldLegacyTypes.cs
    keeps saves written with the old RimMandrake.Ninefold namespace loading.
    Harmony (0Harmony.dll) is a dependency for the hooks. Every reference is
    Private=false: nothing but our own DLL may land next to the mod.

    Build: python3 src/RimMandrake/Utils/winbuild.py Rites
    Output lands in ../Assemblies/, which is where RimWorld looks.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrake.Utinni.Rites</AssemblyName>
    <RootNamespace>RimMandrake.Utinni.Rites</RootNamespace>
    <Version>0.1.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <!-- Default SDK glob compiles every *.cs here. A hand-maintained
         <Compile Include> list silently dropped 10 Patch_*.cs (incl. both
         Pawn.Kill hooks): the DLL built clean and Harmony attached only the 6
         listed methods, so the hooks never fired and nothing logged. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HarmonyDll)' == ''">
    <HarmonyDll>C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\2009463077\Current\Assemblies\0Harmony.dll</HarmonyDll>
  </PropertyGroup>

  <ItemGroup>
    <!-- the offline fuzz project lives under Source/SelfTest; it must never compile into the mod -->
    <Compile Remove="SelfTest\**" />
    <Compile Include="..\..\..\RimMandrake\_Shared\HarmonyResilience\PatchApplier.cs" Link="Shared\PatchApplier.cs" />
    <Compile Include="..\..\..\RimMandrake\_Shared\SettingsKit\SettingsKitCore.cs" Link="Shared\SettingsKitCore.cs" />
    <Compile Include="..\..\..\RimMandrake\_Shared\SettingsKit\SettingsKitDrawer.cs" Link="Shared\SettingsKitDrawer.cs" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
