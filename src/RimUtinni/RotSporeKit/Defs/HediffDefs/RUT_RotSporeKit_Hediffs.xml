<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Ported verbatim (vanilla HediffWithComps + vanilla comp classes only, no donor
    dependency) from BiomesCaverns_src 1.6/Defs/Incidents/BMT_GameConditions_SporeCloud.xml
    (BMT_SporesBuildup) and 1.6/Defs/HediffDefs/BMT_Diseases.xml (BMT_SporeFlesh).
  -->

  <HediffDef>
    <defName>RUT_SporesBuildup</defName>
    <label>spore buildup</label>
    <description>Spores accumulated in the respiratory tract. It is generally not dangerous, but if the spores continue to accumulate, the effect can be fatal.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.7, 1.0, 0.7)</defaultLabelColor>
    <lethalSeverity>2</lethalSeverity>
    <makesSickThought>true</makesSickThought>
    <scenarioCanAdd>true</scenarioCanAdd>
    <taleOnVisible>ToxicityRevealed</taleOnVisible>
    <comps>
      <li Class="HediffCompProperties_Immunizable">
        <compClass>HediffComp_ImmunizableToxic</compClass>
        <severityPerDayNotImmune>-0.08</severityPerDayNotImmune>
      </li>
    </comps>
    <stages>
      <li>
        <label>initial</label>
        <becomeVisible>false</becomeVisible>
        <capMods>
          <li><capacity>Breathing</capacity><setMax>1.0</setMax></li>
        </capMods>
      </li>
      <li>
        <label>initial</label>
        <minSeverity>0.04</minSeverity>
        <capMods>
          <li><capacity>Breathing</capacity><setMax>0.99</setMax></li>
        </capMods>
      </li>
      <li>
        <label>minor</label>
        <minSeverity>0.2</minSeverity>
        <capMods>
          <li><capacity>Breathing</capacity><setMax>0.90</setMax></li>
        </capMods>
      </li>
      <li>
        <label>moderate</label>
        <minSeverity>0.40</minSeverity>
        <vomitMtbDays>5</vomitMtbDays>
        <capMods>
          <li><capacity>Breathing</capacity><setMax>0.80</setMax></li>
        </capMods>
      </li>
      <li>
        <label>serious</label>
        <minSeverity>0.60</minSeverity>
        <vomitMtbDays>1</vomitMtbDays>
        <capMods>
          <li><capacity>Breathing</capacity><setMax>0.75</setMax></li>
        </capMods>
      </li>
      <li>
        <label>extreme</label>
        <minSeverity>0.80</minSeverity>
        <vomitMtbDays>0.5</vomitMtbDays>
        <capMods>
          <li><capacity>Breathing</capacity><setMax>0.50</setMax></li>
        </capMods>
      </li>
      <li>
        <label>extreme</label>
        <minSeverity>1.20</minSeverity>
        <vomitMtbDays>0.5</vomitMtbDays>
        <capMods>
          <li><capacity>Breathing</capacity><setMax>0.35</setMax></li>
        </capMods>
      </li>
      <li>
        <label>extreme</label>
        <minSeverity>1.50</minSeverity>
        <vomitMtbDays>0.5</vomitMtbDays>
        <capMods>
          <li><capacity>Breathing</capacity><setMax>0.10</setMax></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="InfectionBase">
    <defName>RUT_SporeFlesh</defName>
    <label>spore flesh</label>
    <description>Unique mycelia have invaded the body of the afflicted, numbing their pain and slowing their bleeding while drawing nutrients from their body. It will slowly alter the brain chemistry of the afflicted, driving them increasingly to aggression. While potentially fatal, it can be cured with good medical care.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <makesSickThought>true</makesSickThought>
    <lethalSeverity>1</lethalSeverity>
    <tendable>true</tendable>
    <comps>
      <li Class="HediffCompProperties_TendDuration">
        <baseTendDurationHours>10</baseTendDurationHours>
        <severityPerDayTended>-0.12</severityPerDayTended>
      </li>
      <li Class="HediffCompProperties_Immunizable">
        <severityPerDayNotImmune>0.37</severityPerDayNotImmune>
        <immunityPerDaySick>0.3</immunityPerDaySick>
        <severityPerDayImmune>-0.45</severityPerDayImmune>
        <immunityPerDayNotSick>-0.05</immunityPerDayNotSick>
      </li>
    </comps>
    <stages>
      <li>
        <label>minor</label>
        <totalBleedFactor>0.90</totalBleedFactor>
        <painFactor>0.75</painFactor>
        <hungerRateFactor>1.10</hungerRateFactor>
      </li>
      <li>
        <label>major</label>
        <minSeverity>0.55</minSeverity>
        <totalBleedFactor>0.70</totalBleedFactor>
        <painFactor>0.45</painFactor>
        <hungerRateFactor>1.30</hungerRateFactor>
        <mentalStateGivers>
          <li><mentalState>Tantrum</mentalState><mtbDays>6</mtbDays></li>
        </mentalStateGivers>
        <forgetMemoryThoughtMtbDays>10</forgetMemoryThoughtMtbDays>
      </li>
      <li>
        <minSeverity>0.8</minSeverity>
        <label>extreme</label>
        <lifeThreatening>true</lifeThreatening>
        <totalBleedFactor>0.50</totalBleedFactor>
        <painFactor>0.25</painFactor>
        <hungerRateFactor>1.50</hungerRateFactor>
        <mentalStateGivers>
          <li><mentalState>Berserk</mentalState><mtbDays>12</mtbDays></li>
        </mentalStateGivers>
        <forgetMemoryThoughtMtbDays>7</forgetMemoryThoughtMtbDays>
      </li>
    </stages>
  </HediffDef>

  <!-- Skulltop's own toxic-spore-lung disease, ported from BMT_Skulltop.xml. -->
  <HediffDef ParentName="DiseaseBase">
    <defName>RUT_HediffSkulltopSpores</defName>
    <label>skulltop spores</label>
    <description>The toxic spores of the fungus settled in the creature's lungs. Prolonged exposure can be fatal.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.7, 1.0, 0.7)</defaultLabelColor>
    <lethalSeverity>1</lethalSeverity>
    <makesSickThought>true</makesSickThought>
    <scenarioCanAdd>true</scenarioCanAdd>
    <taleOnVisible>ToxicityRevealed</taleOnVisible>
    <comps>
      <li Class="HediffCompProperties_Immunizable">
        <compClass>HediffComp_ImmunizableToxic</compClass>
        <severityPerDayNotImmune>-0.08</severityPerDayNotImmune>
      </li>
    </comps>
    <stages>
      <li>
        <label>initial</label>
        <becomeVisible>false</becomeVisible>
      </li>
      <li>
        <label>initial</label>
        <minSeverity>0.04</minSeverity>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.05</offset></li>
        </capMods>
      </li>
      <li>
        <label>minor</label>
        <minSeverity>0.2</minSeverity>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.10</offset></li>
        </capMods>
      </li>
      <li>
        <label>moderate</label>
        <minSeverity>0.40</minSeverity>
        <vomitMtbDays>5</vomitMtbDays>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.15</offset></li>
        </capMods>
        <hediffGivers>
          <li Class="HediffGiver_Random">
            <hediff>Asthma</hediff>
            <mtbDays>146</mtbDays>
            <partsToAffect><li>Lung</li></partsToAffect>
          </li>
        </hediffGivers>
      </li>
      <li>
        <label>serious</label>
        <minSeverity>0.60</minSeverity>
        <vomitMtbDays>1</vomitMtbDays>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.25</offset></li>
        </capMods>
        <hediffGivers>
          <li Class="HediffGiver_Random">
            <hediff>Asthma</hediff>
            <mtbDays>37</mtbDays>
            <partsToAffect><li>Lung</li></partsToAffect>
          </li>
        </hediffGivers>
      </li>
      <li>
        <label>extreme</label>
        <minSeverity>0.80</minSeverity>
        <vomitMtbDays>0.5</vomitMtbDays>
        <capMods>
          <li><capacity>Consciousness</capacity><setMax>0.25</setMax></li>
        </capMods>
        <hediffGivers>
          <li Class="HediffGiver_Random">
            <hediff>Asthma</hediff>
            <mtbDays>13</mtbDays>
            <partsToAffect><li>Lung</li></partsToAffect>
          </li>
        </hediffGivers>
      </li>
    </stages>
  </HediffDef>
</Defs>
