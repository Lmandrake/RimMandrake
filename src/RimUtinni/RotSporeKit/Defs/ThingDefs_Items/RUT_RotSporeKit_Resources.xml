<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Ported from BiomesCaverns_src 1.6/Defs/Items/BMT_MushroomLog.xml (log + leather),
    1.6/Defs/Items/BMT_GlowGoo.xml (dropped its own "specific caste of insectoid"
    sourcing line — fauna-tied, out of scope; kept as a plain biological resource,
    which fits the_rot.md §5 "all useful light is biological") and
    1.6/Defs/Items/BMT_CaveSpiderHead.xml (trophy/weapon, all-vanilla mechanics).
    tasteThought fields dropped (donor ThoughtDefs not ported).
  -->

  <ThingDef ParentName="ResourceVerbBase">
    <defName>RUT_MushroomLog</defName>
    <label>mushroom log</label>
    <description>Material from large fibrous fungi. Useful for building structures and weapons. Good animal feed, but largely inedible for humans.\n\nDoes not burn easily and cannot be used as fuel for normal burning but can be used for darklight sources.</description>
    <graphicData>
      <texPath>RotSporeKit/Things/Item/MushroomLog</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <equippedAngleOffset>-20</equippedAngleOffset>
    <soundInteract>Wood_Drop</soundInteract>
    <soundDrop>Wood_Drop</soundDrop>
    <statBases>
      <Nutrition>0.05</Nutrition>
      <FoodPoisonChanceFixedHuman>0.02</FoodPoisonChanceFixedHuman>
      <MarketValue>1.1</MarketValue>
      <MaxHitPoints>130</MaxHitPoints>
      <Mass>0.4</Mass>
      <Flammability>0</Flammability>
      <DeteriorationRate>0.5</DeteriorationRate>
      <StuffPower_Armor_Sharp>0.54</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Blunt>0.54</StuffPower_Armor_Blunt>
      <StuffPower_Armor_Heat>0.40</StuffPower_Armor_Heat>
      <StuffPower_Insulation_Cold>8</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>4</StuffPower_Insulation_Heat>
      <SharpDamageMultiplier>0.40</SharpDamageMultiplier>
      <BluntDamageMultiplier>0.9</BluntDamageMultiplier>
    </statBases>
    <ingestible>
      <preferability>DesperateOnlyForHumanlikes</preferability>
      <ingestEffect>EatVegetarian</ingestEffect>
      <ingestSound>RawVegetable_Eat</ingestSound>
      <foodType>Fungus</foodType>
      <optimalityOffsetFeedingAnimals>7</optimalityOffsetFeedingAnimals>
    </ingestible>
    <burnableByRecipe>true</burnableByRecipe>
    <healthAffectsPrice>false</healthAffectsPrice>
    <minRewardCount>10</minRewardCount>
    <stuffProps>
      <stuffAdjective>fungal</stuffAdjective>
      <categories>
        <li>Woody</li>
      </categories>
      <commonality>1.00</commonality>
      <color>(195,195,195)</color>
      <constructEffect>ConstructWood</constructEffect>
      <appearance>Planks</appearance>
      <soundImpactBullet>BulletImpact_Wood</soundImpactBullet>
      <soundMeleeHitSharp>MeleeHit_Wood</soundMeleeHitSharp>
      <soundMeleeHitBlunt>MeleeHit_Wood</soundMeleeHitBlunt>
      <statFactors>
        <MaxHitPoints>0.55</MaxHitPoints>
        <Beauty>1</Beauty>
        <Flammability>0</Flammability>
        <WorkToMake>0.7</WorkToMake>
        <WorkToBuild>0.7</WorkToBuild>
        <DoorOpenSpeed>1.2</DoorOpenSpeed>
      </statFactors>
      <canSuggestUseDefaultStuff>true</canSuggestUseDefaultStuff>
    </stuffProps>
    <thingCategories>
      <li>ResourcesRaw</li>
      <li>Foods</li>
    </thingCategories>
    <weaponClasses>
      <li>Melee</li>
      <li>MeleeBlunt</li>
      <li>Neolithic</li>
    </weaponClasses>
    <tools>
      <li>
        <label>mushroom log</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>10</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <tickerType>Rare</tickerType>
    <socialPropernessMatters>true</socialPropernessMatters>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <allowedArchonexusCount>200</allowedArchonexusCount>
  </ThingDef>

  <ThingDef ParentName="LeatherBase">
    <defName>RUT_MushroomLeather</defName>
    <label>mushroom leather</label>
    <description>A squishy damp fabric, not really leather.</description>
    <graphicData>
      <color>(195,195,195)</color>
    </graphicData>
    <statBases>
      <DeteriorationRate>4</DeteriorationRate>
      <Mass>0.03</Mass>
      <Flammability>0.2</Flammability>
      <StuffPower_Armor_Sharp>0.22</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Blunt>0.22</StuffPower_Armor_Blunt>
      <StuffPower_Armor_Heat>1.8</StuffPower_Armor_Heat>
      <StuffPower_Insulation_Cold>22</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>8</StuffPower_Insulation_Heat>
    </statBases>
    <stuffProps>
      <color>(195,195,195)</color>
      <commonality>0.002</commonality>
    </stuffProps>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>RUT_GlowGoo</defName>
    <label>glow goo</label>
    <description>An organic glowing goo, secreted by the Rot's own biology. When used properly, it can illuminate dark areas without burning anything.</description>
    <possessionCount>20</possessionCount>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>RotSporeKit/Things/Item/GlowGoo</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>0.85</drawSize>
    </graphicData>
    <stackLimit>150</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <intricate>true</intricate>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <MarketValue>1.5</MarketValue>
      <Mass>0.05</Mass>
      <Beauty>1</Beauty>
      <Flammability>0.75</Flammability>
      <DeteriorationRate>1.0</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <tradeTags>
      <li>ExoticMisc</li>
    </tradeTags>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>1.75</glowRadius>
        <glowColor>(168,226,109,0)</glowColor>
      </li>
    </comps>
    <allowedArchonexusCount>100</allowedArchonexusCount>
  </ThingDef>

  <ThingDef ParentName="ResourceVerbBase">
    <defName>RUT_CaveSpiderHead</defName>
    <label>cave spider head</label>
    <description>The head of a giant cave spider. It's priceless in most markets. This is a true trophy and needed for special items. It can also be used as a weird weapon.</description>
    <graphicData>
      <texPath>RotSporeKit/Things/Item/SpiderHead/SpiderHead</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <techLevel>Neolithic</techLevel>
    <equippedAngleOffset>-40</equippedAngleOffset>
    <soundInteract>Standard_Pickup</soundInteract>
    <soundDrop>Standard_Pickup</soundDrop>
    <statBases>
      <MarketValue>200</MarketValue>
      <MaxHitPoints>150</MaxHitPoints>
      <Mass>3</Mass>
      <Flammability>0.4</Flammability>
      <DeteriorationRate>0.5</DeteriorationRate>
    </statBases>
    <useHitPoints>true</useHitPoints>
    <stackLimit>5</stackLimit>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <weaponClasses>
      <li>Melee</li>
      <li>MeleePiercer</li>
    </weaponClasses>
    <tools>
      <li>
        <label>venom-fangs</label>
        <capacities>
          <li>ToxicBite</li>
        </capacities>
        <power>12</power>
        <cooldownTime>1</cooldownTime>
        <chanceFactor>0.75</chanceFactor>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>14</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>base</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>8</power>
        <cooldownTime>1.5</cooldownTime>
        <chanceFactor>0.25</chanceFactor>
      </li>
    </tools>
    <thingCategories>
      <li>ItemsMisc</li>
    </thingCategories>
    <tradeTags>
      <li>ExoticMisc</li>
    </tradeTags>
    <thingSetMakerTags>
      <li>AnimalPart</li>
    </thingSetMakerTags>
    <comps>
      <li Class="CompProperties_Styleable"></li>
    </comps>
  </ThingDef>

  <!--
    New (not a straight port): a buildable chitin material so RUT_Apparel_ChitinSpiderHelmet
    can actually be crafted without pulling in BMT_RoyalChitin/BMT_RoyalRhinoHorn (Royal
    Rhino Beetle byproducts — a different animal, out of this raid's scope).
  -->
  <ThingDef ParentName="ResourceBase">
    <defName>RUT_ChitinPlating</defName>
    <label>chitin plating</label>
    <description>Cured plates of insectoid chitin, layered and bonded for armor. Light, tough, and faintly iridescent.</description>
    <graphicData>
      <texPath>RotSporeKit/Things/Item/SpiderHead/SpiderHead</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <stackLimit>75</stackLimit>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <MarketValue>3.2</MarketValue>
      <Mass>0.4</Mass>
      <Flammability>0.3</Flammability>
      <DeteriorationRate>1.5</DeteriorationRate>
      <StuffPower_Armor_Sharp>0.9</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Blunt>0.7</StuffPower_Armor_Blunt>
      <StuffPower_Armor_Heat>0.3</StuffPower_Armor_Heat>
      <StuffPower_Insulation_Cold>10</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>6</StuffPower_Insulation_Heat>
    </statBases>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <stuffProps>
      <categories>
        <li>RUT_ChitinStuff</li>
      </categories>
      <commonality>0.05</commonality>
      <color>(184,178,150)</color>
      <constructEffect>ConstructMetal</constructEffect>
      <statFactors>
        <MaxHitPoints>0.6</MaxHitPoints>
        <WorkToMake>1.1</WorkToMake>
      </statFactors>
    </stuffProps>
  </ThingDef>
</Defs>
