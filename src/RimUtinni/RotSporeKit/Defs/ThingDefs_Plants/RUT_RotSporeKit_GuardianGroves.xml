<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    ROT_GUARDIAN_GROVES_1 (rot_kit_spec.md M6, "potency implies guardianship",
    ban 8: nothing worth taking here is undefended).

    Three defended tea-source mushrooms, one guardian pattern each, maximal
    RC reuse per the spec's own text:

    - RUT_AgelessCap: RC1 CompActiveGasEmitter + Gas_Damaging, riding the
      already-ported RUT_ToxicSpores DamageDef through the NEW RUT_ChokingSpores
      gas def below. Zero new C# (spec's own words) — the donor's own
      AB_AgariluxPrime proves the exact same shape (AlphaBiomes.CompProperties_GasProducer,
      radius 8, gas AB_MycoticSpores — read verbatim from
      vendor/mod_sources.../1.6/Defs/ThingDefs_Plants/Plants_MycoticJungle.xml
      this pass), just on our own RM_ comp instead of AlphaBiomes' donor class.

    - RUT_RegenerantVeil: carries RM_CompPlantAlarm (mandrake.rm.creaturebehaviors,
      NEW this pass — see that assembly's own header for why
      RM_CompBeastWakeRelay does not fit). Damaging it (harvest OR combat)
      wakes nearby tagged fauna via a forced Manhunter mental state.

    - RUT_EuphoricCrown: undefended directly — ban 8 is satisfied by its own
      entourage, RUT_FalseFruit below, not by the crown itself. This matches
      the spec's own text: "the false fruiting body you reached for turns out
      to be bait", not the real crown.

    - RUT_FalseFruit: the lure ring. thingClass overridden to
      RimMandrake.CreatureBehaviors.RUT_Plant_FalseFruit (NEW this pass),
      whose PlantCollected override (RimSage-verified seam,
      RimWorld/Plant.cs + RimWorld/JobDriver_PlantWork.cs, fires on both
      Harvest and Cut-Plant jobs) applies RUT_MatGrip and pings the same
      RM_CompPlantAlarm. harvestedThingDef is vanilla RawFungus — worthless
      on purpose, the trap is the point, not the yield.

    Runtime dependency note: this file's Class= references into
    RimMandrake.CreatureBehaviors need that assembly active. RotSporeKit's
    About.xml now declares mandrake.rm.creaturebehaviors in loadAfter
    (fixed DIRTY_CODE_REVIEW_STANDING_LOOP_1 wave 79 — it was still missing
    as of this comment's original wording, while mandrake.rm.environmentalhazards
    was already present). Type resolution itself does not need load ORDER
    regardless (RimWorld loads every active mod's Assemblies before resolving
    any def, per RM_ShipVermin.csproj's own header note), only ACTIVATION,
    which this campaign's fixed mod list already guarantees for both
    assemblies (MEASURED against infrastructure/state/modlists/
    ModsConfig.PRESWAP.20260924_182608.xml: both mandrake.rm.creaturebehaviors
    and mandrake.rm.environmentalhazards are active, 621 mods total).

    Placeholder texPaths only (no new art this pass, per the build brief):
    reused from already-shipped RotSporeKit/donor mushroom assets. Owed to
    the art pipeline: bespoke sprites for all four defNames below.
  -->

  <!-- ============== The choking-spore gas (RUT_AgelessCap's own defense) ============== -->
  <ThingDef ParentName="RM_BaseGasDamaging">
    <defName>RUT_ChokingSpores</defName>
    <label>choking spores</label>
    <description>A dense violet cloud vented by an ageless cap disturbed too closely. Breathing it brings on the same toxic buildup as the Rot's other guardian spores.</description>
    <graphicData>
      <texPath>RotSporeKit/Things/Item/BoomSpore/BoomSpore_A</texPath>
      <color>(140,60,150,150)</color>
    </graphicData>
    <gas>
      <expireSeconds>18~26</expireSeconds>
    </gas>
    <modExtensions>
      <li Class="RimMandrake.EnvironmentalHazards.GasDamageExtension">
        <tickIntervalTicks>120</tickIntervalTicks>
        <damageDef>RUT_ToxicSpores</damageDef>
        <damageAmount>2</damageAmount>
        <onlyUnroofed>false</onlyUnroofed>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- ============== RUT_AgelessCap (age-reversal source; guardian: spore gas) ============== -->
  <ThingDef ParentName="PlantBase">
    <defName>RUT_AgelessCap</defName>
    <label>orlath cap</label>
    <description>A pale, swollen cap said to give back years to anyone who drinks it brewed right — and it must be brewed here, alive, or not at all. It bears no malice; disturbing its mycelium is simply what makes it vent a choking cloud, and the cloud does not care why you came.</description>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <Beauty>18</Beauty>
      <Nutrition>0</Nutrition>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <graphicData>
      <texPath>RotSporeKit/Things/Plant/AgelessCap</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <ingestible>
      <preferability>NeverForNutrition</preferability>
    </ingestible>
    <selectable>true</selectable>
    <plant>
      <fertilityMin>0.5</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      <growDays>20</growDays>
      <dieIfLeafless>false</dieIfLeafless>
      <harvestYield>3</harvestYield>
      <harvestTag>Standard</harvestTag>
      <harvestedThingDef>RUT_LiveIngredient_AgelessCap</harvestedThingDef>
      <topWindExposure>0.1</topWindExposure>
      <visualSizeRange>1.3~1.6</visualSizeRange>
      <purpose>Misc</purpose>
      <wildClusterRadius>3</wildClusterRadius>
      <wildClusterWeight>2</wildClusterWeight>
    </plant>
    <comps>
      <!-- RC1, zero new C# (spec's own text) — same mechanism as the donor's
           AB_AgariluxPrime, our own comp/gas/damage chain throughout.
           INVENTED tuning: smaller radius and slower cadence than the
           Prime's own (radius 8, rate 0.4) since this is a lesser guardian,
           not the biome's own apex specimen. -->
      <li Class="RimMandrake.EnvironmentalHazards.CompProperties_ActiveGasEmitter">
        <gasType>RUT_ChokingSpores</gasType>
        <radius>5.9</radius>
        <rate>0.3</rate>
        <tickIntervalTicks>400</tickIntervalTicks>
      </li>
    </comps>
  </ThingDef>

  <!-- ============== RUT_RegenerantVeil (bioregeneration source; guardian: network alarm) ============== -->
  <ThingDef ParentName="PlantBase">
    <defName>RUT_RegenerantVeil</defName>
    <label>mirrash veil</label>
    <description>A translucent, slow-pulsing veil of fungal tissue laid over the ground, threaded straight into the grove's own mycelial network, from which the pale forest's healing tea is brewed alive. Wound it and the whole network answers.</description>
    <statBases>
      <MaxHitPoints>140</MaxHitPoints>
      <Beauty>15</Beauty>
      <Nutrition>0</Nutrition>
    </statBases>
    <graphicData>
      <texPath>RotSporeKit/Things/Plant/RegenerantVeil</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <ingestible>
      <preferability>NeverForNutrition</preferability>
    </ingestible>
    <selectable>true</selectable>
    <plant>
      <fertilityMin>0.5</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      <growDays>18</growDays>
      <dieIfLeafless>false</dieIfLeafless>
      <harvestYield>3</harvestYield>
      <harvestTag>Standard</harvestTag>
      <harvestedThingDef>RUT_LiveIngredient_RegenerantVeil</harvestedThingDef>
      <visualSizeRange>1.0~1.3</visualSizeRange>
      <wildClusterRadius>3</wildClusterRadius>
      <wildClusterWeight>2</wildClusterWeight>
    </plant>
    <comps>
      <li Class="RimMandrake.CreatureBehaviors.RM_CompProperties_PlantAlarm">
        <radius>18</radius>
      </li>
    </comps>
  </ThingDef>

  <!-- ============== RUT_EuphoricCrown (pleasure-brew source; undefended — its guardian is RUT_FalseFruit below) ============== -->
  <ThingDef ParentName="PlantBase">
    <defName>RUT_EuphoricCrown</defName>
    <label>lussa crown</label>
    <description>A broad, faintly luminous crown of a cap that brews into the pale forest's own pleasure tea — brewed here, alive, the day it is cut, or not at all. It keeps no defence of its own; ringed the way it is, it has never needed one.</description>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <Beauty>22</Beauty>
      <Nutrition>0</Nutrition>
    </statBases>
    <graphicData>
      <texPath>RotSporeKit/Things/Plant/EuphoricCrown</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <ingestible>
      <preferability>NeverForNutrition</preferability>
    </ingestible>
    <selectable>true</selectable>
    <plant>
      <fertilityMin>0.5</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      <growDays>16</growDays>
      <dieIfLeafless>false</dieIfLeafless>
      <harvestYield>3</harvestYield>
      <harvestTag>Standard</harvestTag>
      <harvestedThingDef>RUT_LiveIngredient_EuphoricCrown</harvestedThingDef>
      <visualSizeRange>1.2~1.5</visualSizeRange>
      <wildClusterRadius>4</wildClusterRadius>
      <wildClusterWeight>2</wildClusterWeight>
    </plant>
  </ThingDef>

  <!-- ============== RUT_FalseFruit (the mimic-lure ring around RUT_EuphoricCrown) ============== -->
  <ThingDef ParentName="PlantBase">
    <defName>RUT_FalseFruit</defName>
    <label>pekk fruit</label>
    <description>Grown at the edge of a lussa crown's root mat and shaped to match it: a small pale fruiting body that looks exactly like the good stuff. It is not — touch one and the whole grove knows you are there, and what lives in the grove comes to see.</description>
    <thingClass>RimMandrake.CreatureBehaviors.RUT_Plant_FalseFruit</thingClass>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Beauty>5</Beauty>
      <Nutrition>0</Nutrition>
    </statBases>
    <graphicData>
      <texPath>RotSporeKit/Things/Plant/FalseFruit</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <ingestible>
      <preferability>NeverForNutrition</preferability>
    </ingestible>
    <selectable>true</selectable>
    <plant>
      <fertilityMin>0.4</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      <growDays>6</growDays>
      <dieIfLeafless>false</dieIfLeafless>
      <harvestYield>1</harvestYield>
      <harvestTag>Standard</harvestTag>
      <!-- Worthless on purpose (vanilla RawFungus) — same yield the donor's
           own AB_AgariluxPrime uses, confirmed live in Plants_MycoticJungle.xml.
           The trap is the point, not the reward. -->
      <harvestedThingDef>RawFungus</harvestedThingDef>
      <visualSizeRange>0.4~0.6</visualSizeRange>
      <wildClusterRadius>2</wildClusterRadius>
      <wildClusterWeight>4</wildClusterWeight>
    </plant>
    <comps>
      <li Class="RimMandrake.CreatureBehaviors.RM_CompProperties_PlantAlarm">
        <radius>18</radius>
      </li>
    </comps>
  </ThingDef>
</Defs>
