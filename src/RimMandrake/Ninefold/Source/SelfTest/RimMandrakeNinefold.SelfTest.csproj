<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ninefold satiation-engine offline fuzz (Approach B, same shape as FlowWorks/GimmeSomeSlack/Bazaar). Plain net8.0,
    zero RimWorld/Unity references: ../RM_NinefoldKernel.cs and ../SatiationBand.cs are the PRODUCTION files the mod
    compiles, pulled in directly. Ninefold.csproj removes SelfTest\** from its own glob, so none of this ships.
    Run (builds on Windows via winbuild staging, then runs the exe):
      python3 src/RimMandrake/Utils/selftest_ninefold_fuzz.py [fuzz knobs]
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RimMandrakeNinefold.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.Ninefold.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\RM_NinefoldKernel.cs" />
    <Compile Include="..\SatiationBand.cs" />
    <Compile Include="NinefoldFuzz.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
