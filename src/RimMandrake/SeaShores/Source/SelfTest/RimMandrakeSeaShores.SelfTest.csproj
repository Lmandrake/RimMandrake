<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline, no-game selftest harness for mandrake.rm.seashores
    (SEA_FLOOR_AND_CATCH_PASS_1) - the two pure decisions in
    RM_SeaShoreUtility: which terrain a sea's shore is made of, and which
    catch band answers for a water body. Same shape/reasoning as
    RimMandrakeAftermath.SelfTest.csproj: compile the REAL production .cs
    files in directly where they have no live-game dependency, rather than
    reimplementing them and drifting out of sync.

    NOT the mod build (RM_SeaShores.csproj, one directory up: its own
    EnableDefaultCompileItems is false and its own explicit Compile list
    does not mention this folder).

    Targets net472 (like the real mod) because BiomeDef/TerrainDef/
    BiomeFishTypes need the real Assembly-CSharp.dll to resolve, even though
    nothing called here needs a running game.

    Run via src/RimMandrake/Utils/selftest_seashores.py, or directly
    (Windows path required, dotnet.exe cannot take /mnt/d):
      "%USERPROFILE%\.dotnet\dotnet.exe" run [dash][dash]project D:\Luke\dev\Rimworld\src\RimMandrake\SeaShores\Source\SelfTest\RimMandrakeSeaShores.SelfTest.csproj -c Release
      (written apart only because an XML comment cannot hold two adjacent hyphens)
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrakeSeaShores.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.SeaShores.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <DebugType>none</DebugType>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Private=true here (unlike a real mod .csproj) - this is a standalone
       .exe, not a mod loaded into a running RimWorld process. -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- The REAL production source files, compiled in directly. None of the
         call sites exercised here touch Find/Game/DefDatabase; the settings
         and Mod classes come along only because RM_SeaShoreUtility.FishBiomeFor
         names RM_SeaShoresSettings.Cur, which is never called from here. -->
    <Compile Include="..\RM_SeaShoreExtension.cs" />
    <Compile Include="..\RM_SeaShoreUtility.cs" />
    <Compile Include="..\RM_SeaShoresSettings.cs" />
    <Compile Include="..\RM_SeaShoresMod.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
