<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SeaShores offline fuzz (Approach B). Plain net8.0, zero RimWorld/Unity references: ../../Kernel/RM_SeaKernel.cs is the PRODUCTION file the
    mod compiles, pulled in directly. A `using Verse;` landing in it breaks this build - that is the guard rail working.
    Run: python3 src/RimMandrake/Utils/selftest_seashores_fuzz.py [fuzz knobs]
    (The older net472 check of the def-typed terrain resolution is ../RimMandrakeSeaShores.SelfTest.csproj, run by selftest_seashores.py.)
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RimMandrakeSeaShores.Fuzz</AssemblyName>
    <RootNamespace>RimMandrake.SeaShores.Fuzz</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Kernel\RM_SeaKernel.cs" />
    <Compile Include="SeaShoresFuzz.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
