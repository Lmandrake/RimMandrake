     needed to flush. -->
<Defs>

  <WorkGiverDef>
    <defName>RM_WatcherFlush</defName>
    <label>flush hiding animals</label>
    <giverClass>RimMandrake.Watchers.RM_WorkGiver_Flush</giverClass>
    <workType>Hunting</workType>
    <priorityInType>110</priorityInType>
    <verb>flush</verb>
    <gerund>flushing</gerund>
    <tagToGive>Fieldwork</tagToGive>
    <requiredCapacities>
      <li>Moving</li>
    </requiredCapacities>
  </WorkGiverDef>

</Defs>
