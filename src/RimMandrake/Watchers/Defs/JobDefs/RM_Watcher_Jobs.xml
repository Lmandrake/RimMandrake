<?xml version="1.0" encoding="utf-8"?>
<!-- WATCHER_CREATURES_MOD_1. RM_WatcherWatch: the watch cycle (RM_JobDriver_Watch).
     RM_WatcherRelocate: vanilla JobDriver_Goto under its own def, so the medium backstop can tell
     its own walk home from any other goto. RM_WatcherFlush: a hunter walking to a sign to make the
     watcher bolt (RM_JobDriver_Flush). -->
<Defs>

  <JobDef>
    <defName>RM_WatcherWatch</defName>
    <driverClass>RimMandrake.Watchers.RM_JobDriver_Watch</driverClass>
    <reportString>watching.</reportString>
    <casualInterruptible>true</casualInterruptible>
  </JobDef>

  <JobDef>
    <defName>RM_WatcherRelocate</defName>
    <driverClass>JobDriver_Goto</driverClass>
    <reportString>heading back to its ground.</reportString>
  </JobDef>

  <JobDef>
    <defName>RM_WatcherFlush</defName>
    <driverClass>RimMandrake.Watchers.RM_JobDriver_Flush</driverClass>
    <reportString>flushing TargetA.</reportString>
  </JobDef>

</Defs>
