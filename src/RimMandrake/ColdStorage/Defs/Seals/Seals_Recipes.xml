<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Seal and preserve bills (§4.4). 0.5 nutrition of food makes 10 units. Brine and salt agents come from other
       mods (MayRequire); a bill whose agent no loaded mod provides is hidden at startup (hideIfIngredientEmpty).
       Star Wars Cuisine adds Taozin brine and bestiary roe by patch. -->

  <RecipeDef ParentName="RM_SealRecipeBase">
    <defName>RM_SealResinFruit</defName>
    <label>seal fruit in resin</label>
    <description>Seal fruit in resin.</description>
    <jobString>Sealing fruit in resin.</jobString>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>PlantFoodRaw</li>
          </categories>
          <disallowedThingDefs>
            <li>RawFungus</li>
          </disallowedThingDefs>
          <disallowedCategories>
            <li>RM_AgedFoods</li>
          </disallowedCategories>
        </filter>
        <count>0.5</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>RM_SealingResin</li>
          </thingDefs>
        </filter>
        <count>3</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>RM_SealingResin</li>
      </thingDefs>
      <categories>
        <li>PlantFoodRaw</li>
      </categories>
      <disallowedThingDefs>
        <li>RawFungus</li>
      </disallowedThingDefs>
      <disallowedCategories>
        <li>RM_AgedFoods</li>
      </disallowedCategories>
    </fixedIngredientFilter>
    <products>
      <RM_ResinSealedFruit>10</RM_ResinSealedFruit>
    </products>
    <recipeUsers>
      <li>RM_ResinSealingJarShelf</li>
    </recipeUsers>
    <researchPrerequisite>RM_ResinWork</researchPrerequisite>
    <modExtensions>
      <li Class="RimMandrake.ColdStorage.ColdStorageGateExtension">
        <gate>Resin</gate>
      </li>
    </modExtensions>
  </RecipeDef>

