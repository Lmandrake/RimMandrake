<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Seal and preserve products made in this mod (§4.4). Generated once from a table; edit freely.
       Interim vanilla textures until the queued art lands. -->

  <ThingDef ParentName="ResourceBase">
    <defName>RM_SealingResin</defName>
    <label>sealing resin</label>
    <description>Tree sap boiled down to a thick, sticky resin. Poured over food in a jar it hardens into a seal that keeps out air and rot. Drawn from trees by a resin tap.</description>
    <thingClass>ThingWithComps</thingClass>
    <graphicData>
      <texPath>Things/Item/Resource/Chemfuel</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.85</drawSize>
    </graphicData>
    <stackLimit>75</stackLimit>
    <statBases>
      <MarketValue>1.2</MarketValue>
      <Mass>0.1</Mass>
      <Flammability>1.2</Flammability>
      <DeteriorationRate>1</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
  </ThingDef>

  <ThingDef ParentName="RM_SealedFoodBase">
    <defName>RM_ResinSealedFruit</defName>
    <label>resin-sealed fruit</label>
    <description>A jar of fruit under a coat of hardened resin. It will not spoil while the seal holds, and in about twenty days it turns to amber-aged fruit. Break the seal to eat it; after that it rots like fresh food.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Chocolate</texPath>
      <drawSize>0.88</drawSize>
    </graphicData>
    <ingestible>
      <ingestEffect>EatVegetarian</ingestEffect>
    </ingestible>
    <comps>
      <li Class="RimMandrake.ColdStorage.CompProperties_Sealed">
        <method>RM_ColdMethod_ResinSeal</method>
        <agesInto>RM_AmberAgedFruit</agesInto>
        <agingDays>20</agingDays>
        <failureChance>0.03</failureChance>
      </li>
      <li Class="CompProperties_Ingredients">
        <noIngredientsFoodKind>Plant</noIngredientsFoodKind>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="RM_AgedFoodBase">
    <defName>RM_AmberAgedFruit</defName>
    <label>amber-aged fruit</label>
    <description>Resin-sealed fruit left to age. Sweet, resinous and faintly antiseptic, like the amber of a portaak tree. Most people love it; a few find it strange.</description>
    <graphicData>
      <texPath>Things/Item/Resource/AnimalProductRaw/InsectJelly</texPath>
    </graphicData>
    <thingCategories>
      <li>RM_AgedFoods</li>
      <li>PlantFoodRaw</li>
    </thingCategories>
    <ingestible>
      <ingestEffect>EatVegetarian</ingestEffect>
      <outcomeDoers>
        <li Class="RimMandrake.ColdStorage.IngestionOutcomeDoer_PreservedTaste">
          <liked>RM_AtePreservedDelicacy</liked>
          <strange>RM_AteStrangePreserved</strange>
          <strangeChance>0.15</strangeChance>
        </li>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>RM_AmberAntiseptic</hediffDef>
          <severity>1</severity>
        </li>
      </outcomeDoers>
    </ingestible>
    <comps>
      <li Class="CompProperties_Ingredients">
        <noIngredientsFoodKind>Plant</noIngredientsFoodKind>
      </li>
    </comps>
    <modExtensions>
      <li Class="RimMandrake.ColdStorage.ColdStoragePreservedExtension">
        <method>RM_ColdMethod_ResinSeal</method>
        <flavours>
          <li>amber</li>
          <li>sweet</li>
          <li>resinous</li>
        </flavours>
      </li>
    </modExtensions>
  </ThingDef>

