<Project Sdk="Microsoft.NET.Sdk">

  <!--
    COLD_STORAGE_ENGINE_BUILD_CLIMATE_COMP: offline selftest of the cold storage engine. Compiles the REAL
    Kernel/ColdStorageKernel.cs the mod ships and checks it against the game's own
    GenTemperature.RotRateAtTemperature (real Assembly-CSharp.dll, Private=true because this is a standalone exe).
    Run: python3 src/RimMandrake/ColdStorage/selftest_coldstorage.py
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrakeColdStorage.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.ColdStorage.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <DebugType>none</DebugType>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Kernel\ColdStorageKernel.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
