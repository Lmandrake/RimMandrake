<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_PoisonForestItems.xml            CAULDRON_RULED_CONTENT_1, new 2026-09-29

  RM_Vexxith: the shear material. Owner ruling: shearing a LIVING vexxiss
  yields a rare material "immune to powerful acids and temperature", not
  metal, and never from a corpse. It is obtainable ONLY through the vexxiss's
  CompProperties_Shearable (RM_PoisonForestFauna.xml); it has no recipe, no
  butcher product, no generateCommonality and stuffProps commonality 0, so
  nothing else can produce it.
    - Temperature immunity: stuffProps Flammability factor 0, heat armour
      power high, insulation stats left at 0 (it neither holds nor sheds heat).
    - Acid immunity: there is no vanilla acid stat. It is NOT expressed here;
      it belongs with the mechanics ticket (CAULDRON_MECHANICS_BUILD_1) and
      needs C# or a GameCondition/damage-def hook. Stubbed, not faked.
    - stuffCategories is Metallic only because the material must be workable
      at a bench and no non-metal category exists that recipes accept; the
      fiction ("not metal") lives in the label/description. A dedicated
      StuffCategoryDef is a follow-on.

  RM_ZisskaMeat: owner-ruled "toxic prized meat" for the zisska. Same shape
  as RUT_NeebrayMeat in UtinniPatches (hand-authored specificMeatDef target,
  ThingDefGenerator_Meat skips a race that names one), EXCEPT the toxic half:
  the donor IngestionOutcomeDoer_Toxic lives only in the Utinni layer's
  absorbed assembly, which the RM tier may not assume, so this uses vanilla
  IngestionOutcomeDoer_GiveHediff with ToxicBuildup. Prized half: RawTasty
  preferability and an above-market MarketValue. No special thought defs (no
  RM-tier thoughts exist for this yet).
  Placeholder art: the vanilla Meat_Small stack texture, retinted (no PNG).
-->
<Defs>

  <ThingDef ParentName="ResourceBase">
    <defName>RM_Vexxith</defName>
    <label>vexxith</label>
    <description>A sheared vexxith plate, still holding the curve of the animal's flank. Acid beads off it. Fire cannot warm it. The forge-hands say working it is like arguing with something that has already decided -- and everything made from it outlives the argument, the forge, and the smith.</description>
    <graphicData>
      <texPath>Things/Item/RM_Vexxith/RM_Vexxith</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Standard_Drop</soundDrop>
    <useHitPoints>false</useHitPoints>
    <healthAffectsPrice>false</healthAffectsPrice>
    <generateCommonality>0</generateCommonality>
    <statBases>
      <MarketValue>18</MarketValue>
      <Mass>1</Mass>
      <Flammability>0</Flammability>
      <StuffPower_Armor_Sharp>1.1</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Blunt>0.5</StuffPower_Armor_Blunt>
      <StuffPower_Armor_Heat>1.4</StuffPower_Armor_Heat>
      <StuffPower_Insulation_Cold>0</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>0</StuffPower_Insulation_Heat>
      <SharpDamageMultiplier>1.2</SharpDamageMultiplier>
      <BluntDamageMultiplier>0.9</BluntDamageMultiplier>
    </statBases>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <tradeability>Sellable</tradeability>
    <stuffProps>
      <categories>
        <li>Metallic</li>
      </categories>
      <color>(46,38,52)</color>
      <commonality>0</commonality>
      <appearance>Metal</appearance>
      <soundImpactBullet>BulletImpact_Metal</soundImpactBullet>
      <soundMeleeHitSharp>MeleeHit_Metal_Sharp</soundMeleeHitSharp>
      <soundMeleeHitBlunt>MeleeHit_Metal_Blunt</soundMeleeHitBlunt>
      <stuffAdjective>vexxith</stuffAdjective>
      <statFactors>
        <MaxHitPoints>1.6</MaxHitPoints>
        <Flammability>0</Flammability>
        <WorkToMake>2.2</WorkToMake>
        <WorkToBuild>2.2</WorkToBuild>
        <MeleeWeapon_CooldownMultiplier>1.1</MeleeWeapon_CooldownMultiplier>
      </statFactors>
    </stuffProps>
  </ThingDef>

  <ThingDef ParentName="OrganicProductBase">
    <defName>RM_ZisskaMeat</defName>
    <label>zisska meat</label>
    <description>Dense, dark meat off a zisska, carrying every ring of mineral the animal rasped off the forest's stone. Nobody eats it plain -- a cook works it the way you'd work a fish that could kill you, and the reputation for surviving the dish travels further than the dish itself does.</description>
    <graphicData>
      <texPath>Things/Item/Resource/MeatFoodRaw/Meat_Small</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(78,66,84)</color>
    </graphicData>
    <thingCategories>
      <li>MeatRaw</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <MarketValue>9</MarketValue>
      <Mass>0.02</Mass>
      <Flammability>0.5</Flammability>
      <DeteriorationRate>6</DeteriorationRate>
      <Nutrition>0.05</Nutrition>
      <FoodPoisonChanceFixedHuman>0.02</FoodPoisonChanceFixedHuman>
    </statBases>
    <socialPropernessMatters>true</socialPropernessMatters>
    <ingestible>
      <foodType>Meat</foodType>
      <preferability>RawTasty</preferability>
      <ingestEffect>EatMeat</ingestEffect>
      <ingestSound>RawMeat_Eat</ingestSound>
      <outcomeDoers>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>ToxicBuildup</hediffDef>
          <severity>0.05</severity>
        </li>
      </outcomeDoers>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>2</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <tickerType>Rare</tickerType>
  </ThingDef>

</Defs>
