<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_VentMetalLoad.xml        CAULDRON_MECHANICS_BUILD_1 part 2 (tranche 1)

  The stacking metal-load hediff of the vent bloom (RM_VentBloom). Granted
  and raised ONLY by RimMandrake.PoisonForest.RM_MapComponent_VentBloomExposure:
  pawns outdoors and unroofed while the bloom is the current weather, same
  interval (3451 ticks) and same resistance math as vanilla's
  ToxicUtility.DoPawnToxicDamage (ToxicResistance x ToxicEnvironmentResistance,
  so a sealed suit keeps it off exactly as it keeps toxic buildup off).

  It is a separate hediff from vanilla ToxicBuildup on purpose: the bloom does
  not set doToxicBuildup, so a pawn is never taxed twice for the same breath.

  Severity rates and stage effects are this build's INVENTED tuning. It sheds
  slowly on its own (the metal leaves the body over days, not hours) and is not
  lethal: at the top stage it cripples, it does not kill.
-->
<Defs>

  <HediffDef>
    <defName>RM_VentMetalLoad</defName>
    <label>metal load</label>
    <description>Metal-heavy vent breath settled in the lungs and blood. It builds while the ground is blooming and you stand under open sky, and leaves the body slowly once you're out of it. A roof or a sealed suit keeps it off.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.62,0.60,0.68)</defaultLabelColor>
    <isBad>true</isBad>
    <makesSickThought>true</makesSickThought>
    <tendable>false</tendable>
    <initialSeverity>0.01</initialSeverity>
    <minSeverity>0</minSeverity>
    <maxSeverity>1</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.08</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>trace</label>
        <becomeVisible>false</becomeVisible>
      </li>
      <li>
        <minSeverity>0.1</minSeverity>
        <label>light</label>
        <capMods>
          <li>
            <capacity>BloodFiltration</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.35</minSeverity>
        <label>heavy</label>
        <painOffset>0.05</painOffset>
        <capMods>
          <li>
            <capacity>BloodFiltration</capacity>
            <offset>-0.15</offset>
          </li>
          <li>
            <capacity>Breathing</capacity>
            <offset>-0.08</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.7</minSeverity>
        <label>crushing</label>
        <painOffset>0.12</painOffset>
        <capMods>
          <li>
            <capacity>BloodFiltration</capacity>
            <offset>-0.3</offset>
          </li>
          <li>
            <capacity>Breathing</capacity>
            <offset>-0.15</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.12</offset>
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
