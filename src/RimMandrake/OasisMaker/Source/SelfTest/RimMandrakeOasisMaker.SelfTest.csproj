<Project Sdk="Microsoft.NET.Sdk">

  <!--
    OasisMaker offline fuzz (Approach B, same shape as KeelHoist/ExplosiveGrowth). Plain net8.0, zero RimWorld/Unity references:
    ../Kernel/*.cs are the PRODUCTION files the mod compiles, pulled in directly. A `using Verse;` landing in one of them
    breaks this build - that is the guard rail working.
      python3 src/RimMandrake/Utils/selftest_oasismaker_fuzz.py [fuzz knobs]
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>OasisMaker.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.OasisMaker.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Kernel\RM_OasisKernel.cs" />
    <Compile Include="OasisMakerFuzz.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
