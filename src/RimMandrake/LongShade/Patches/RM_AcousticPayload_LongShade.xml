<?xml version="1.0" encoding="utf-8"?>
<!--
  GRAVSHIP_ACOUSTIC_SCANNER_1: the acoustic-scanner payload for RM_LongShade.
  Owner decision by question card 2026-10-06: the payload goes on EVERY biome of ours.

  Pure XML, FindMod-guarded on "RimMandrake: Acoustic Scanner", so the extension class
  is only named while its assembly is active. Every def is a defName STRING resolved
  at pulse time (GetNamedSilentFail), so a target naming another mod's def just hears
  nothing when that mod is absent. Each target is drawn from this biome's own content;
  the biome's sitting may re-author it. The reading is always banded by the scanner.
-->
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>RimMandrake: Acoustic Scanner</li>
    </mods>
    <match Class="PatchOperationAddModExtension">
      <xpath>/Defs/BiomeDef[defName="RM_LongShade"]</xpath>
      <value>
        <li Class="RimMandrake.AcousticScanner.RM_AcousticPayloadExtension">
          <quietText>Hot rock and drifted sand. Everything that lives here is already in the shade, and none of it is hiding.</quietText>
          <targets>
            <li>
              <label>something enormous lying still</label>
              <reading>A huge body lying very still in a shadow. It does not move when the pulse goes by.</reading>
              <color>(1, 0.4, 0.3)</color>
              <weight>3</weight>
              <pawnRaces>
                <li>RM_GreatDevourer</li>
                <li>RM_Gloomcast</li>
              </pawnRaces>
            </li>
            <li>
              <label>midden heap</label>
              <reading>A soft, layered echo in the lee of a rock: years of windblown leavings, and things in them.</reading>
              <color>(0.9, 0.75, 0.45)</color>
              <thingDefs>
                <li>RM_LongShadeMidden</li>
              </thingDefs>
            </li>
            <li>
              <label>wrecked cart</label>
              <reading>Wood and iron, half drowned in sand: a cart left where it broke.</reading>
              <color>(0.8, 0.8, 0.85)</color>
              <thingDefs>
                <li>RM_WreckedCart</li>
              </thingDefs>
            </li>
            <li>
              <label>cool hollow</label>
              <reading>The pulse finds a cool, shaded hollow inside the rock.</reading>
              <color>(0.6, 0.6, 0.9)</color>
              <hiddenCaves>true</hiddenCaves>
              <cellSampleStride>4</cellSampleStride>
            </li>
          </targets>
        </li>
      </value>
    </match>
  </Operation>
</Patch>
