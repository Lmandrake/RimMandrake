<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_LongShade_GenSteps.xml     LONGSHADE_BEDAZZLE_MECHANICS_1 parts 4 and 5 (tranche 2)

  Two map-generation steps, named only in RM_LongShade's <extraGenSteps>
  (MapGenerator.GenerateMap concatenates a biome's extraGenSteps — RimSage),
  so they run on Long Shade maps and nowhere else. Code:
  Source/RM_LongShadeMapgen.cs. Toggles: Long Shade Mod Settings.

  Order: after Plants (900), so big plants' shadows count, and before
  Animals (1200), so the herds spawn into the road's shade.

  RM_GenStep_CrawlerRoad (§6.4): the RM tier lays RM_WreckedCart links only;
  mandrake.rsw.injections patches in the skiff and crawler-tread links and
  the dead-sandcrawler terminus (Patches/CrawlerRoad_LongShade.xml there).

  RM_GenStep_SunGraves (§6.5, the Long Carry): Drifter and Dromedary are
  Core defs. The readable is a vanilla Novel: lore, pointing nowhere (the
  gnomon line was CUT).

  PROVISIONAL numbers (owner ruling 2026-10-03, first guesses tuned live later): road spacingFactor
  0.8, spacingCells 6~24, minGapSpacings 1.5, maxGapCells 160; graves count 1~3, the load (silver 80,
  components 2, herbal medicine 4, pemmican 20) and readableChance 0.5.
-->
<Defs>

  <GenStepDef>
    <defName>RM_GenStep_CrawlerRoad</defName>
    <order>950</order>
    <genStep Class="RimMandrake.LongShade.RM_GenStep_CrawlerRoad">
      <linkDefs>
        <li>RM_WreckedCart</li>
      </linkDefs>
      <terminusMarker>RM_CrawlerRoadTerminus</terminusMarker>
      <spacingFactor>0.8</spacingFactor>  <!-- PROVISIONAL -->
      <spacingCells>6~24</spacingCells>
      <minGapSpacings>1.5</minGapSpacings>
      <maxGapCells>160</maxGapCells>
    </genStep>
  </GenStepDef>

  <GenStepDef>
    <defName>RM_GenStep_SunGraves</defName>
    <order>960</order>
    <genStep Class="RimMandrake.LongShade.RM_GenStep_SunGraves">
      <count>1~3</count>  <!-- PROVISIONAL -->
      <travellerKinds>
        <li>Drifter</li>
      </travellerKinds>
      <packAnimalKinds>
        <li>Dromedary</li>
      </packAnimalKinds>
      <load>  <!-- PROVISIONAL -->
        <Silver>80</Silver>
        <ComponentIndustrial>2</ComponentIndustrial>
        <MedicineHerbal>4</MedicineHerbal>
        <Pemmican>20</Pemmican>
      </load>
      <readable>Novel</readable>
      <readableChance>0.5</readableChance>
      <gearDef>RM_Parasol</gearDef>
    </genStep>
  </GenStepDef>

</Defs>
