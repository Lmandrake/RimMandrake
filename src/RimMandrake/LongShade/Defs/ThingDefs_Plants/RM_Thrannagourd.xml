<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_Thrannagourd - PLANT_TIERS_RECONCILE_MOST_ARE_BAROQUE (owner 2026-10-16: "Star Wars will have a very few canon plants, and those can just be reskins of non-canon versions we create in the Baroque Biomes"; by card "Invent 7 new Baroque bases").
  Invented, franchise-free base whose growth, harvest and stats are copied 1:1 from the canon RSW_Plant_HubbaGourd_Wild
  (SWBestiary RSW_DesertPortB_Plants.xml), which is now a pure reskin of this def (ParentName="RM_Thrannagourd").
  Home: RM_LongShade. ART: own folder Things/Plant/RM_Thrannagourd, empty until the base art is ruled and installed (raw item keeps a vanilla placeholder).
-->
<Defs>

  <ThingDef ParentName="PlantBase" Name="RM_Thrannagourd">
    <defName>RM_Thrannagourd</defName>
    <label>wild thrannagourd</label>
    <description>A ground-hugging vine with leathery, sun-scorched leaves and a few hard, ridged gourds the colour of dust. It shrugs off heat that kills almost everything else, and its gourds keep for months without any cold at all - which makes it the staple of anyone who has to live out here.</description>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <Nutrition>0.2</Nutrition>
    </statBases>
    <graphicData>
      <!-- own texPath; folder empty until the owner rules the base-art sheet (pink until then) -->
      <texPath>Things/RM_Thrannagourd/RM_Thrannagourd</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <selectable>true</selectable>
    <pathCost>14</pathCost>
    <ingestible />
    <plant>
      <wildClusterRadius>5</wildClusterRadius>
      <wildClusterWeight>250</wildClusterWeight>
      <sowTags Inherit="False" />
      <immatureGraphicPath>Things/Plant/RM_Thrannagourd</immatureGraphicPath>
      <fertilitySensitivity>0.8</fertilitySensitivity>
      <dieIfLeafless>true</dieIfLeafless>
      <harvestTag>Standard</harvestTag>
      <harvestedThingDef>RM_RawThrannagourd</harvestedThingDef>
      <harvestYield>2</harvestYield>
      <sowTags>
        <li>Ground</li>
        <li>Hydroponic</li>
      </sowTags>
      <topWindExposure>0.1</topWindExposure>
      <growDays>3</growDays>
      <visualSizeRange>0.5~1.0</visualSizeRange>
      <wildOrder>2</wildOrder>
      <purpose>Food</purpose>
      <humanFoodPlant>true</humanFoodPlant>
      <maxGrowthTemperature>75</maxGrowthTemperature>
    </plant>
  </ThingDef>

  <ThingDef ParentName="PlantFoodRawBase" Name="RM_RawThrannagourd">
    <defName>RM_RawThrannagourd</defName>
    <label>thrannagourd</label>
    <description>Raw thrannagourd. Hard-shelled and slow to spoil, it stays edible for a long time without refrigeration.</description>
    <possessionCount>10</possessionCount>
    <graphicData>
      <!-- TEMP placeholder (vanilla) -->
      <texPath>Things/Item/Resource/PlantFoodRaw/Potatoes</texPath>
    </graphicData>
    <statBases>
      <MarketValue>1.3</MarketValue>
      <Nutrition>0.25</Nutrition>
    </statBases>
    <ingestible>
      <foodType>VegetableOrFruit</foodType>
      <tasteThought>AteRawFood</tasteThought>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>60</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
  </ThingDef>

</Defs>
