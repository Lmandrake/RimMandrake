<?xml version="1.0" encoding="utf-8"?>
<!--
  PLANT_TIERS_RECONCILE_MOST_ARE_BAROQUE (owner, 2026-10-16: "I bet most of it is supposed to be in Baroque
  anyway"): surra grass and vellara bloom are invented, not Star Wars canon, so they leave SWBestiary's
  DesertPort (RSW_DesertPortMisc_Plants.xml) for this mod under RM_ names. Fields carried verbatim; textures moved
  through the art ledger. A saved RSW_ name loads as the RM_ def through RM_PlantTierReconcile_Aliases.xml
  (EnvironmentalHazards). Wild in RM_LongShade (inline, this mod) and RUT_Desert.
-->
<Defs>

	<ThingDef ParentName="PlantBase">
		<defName>RM_SurraGrass</defName>
<altitudeLayer>FloorEmplacement</altitudeLayer>  <!-- ground cover: under every LowPlant plant (owner 2026-10-14) -->
		<label>surra grass</label>
		<description>A wiry, tufted grass that grows on thin soil in sheltered shade.</description>
		<statBases>
			<MaxHitPoints>85</MaxHitPoints>
			<Flammability>1.3</Flammability>
			<Nutrition>0.15</Nutrition>
		</statBases>
		<graphicData>
			<texPath>Things/Plant/RM_SurraGrass</texPath>
			<graphicClass>Graphic_Random</graphicClass>
		</graphicData>
		<hideAtSnowOrSandDepth>0.5</hideAtSnowOrSandDepth>
		<ingestible/>
		<plant>
			<!-- RULED (owner, 2026-09-20, SURRA_GRASS_FERTILITYMIN_1): KEEP fertilityMin at
			     0.30, deliberately above Core Sand's 0.10 fertility, so surra grass is confined
			     to Soil islands rather than spreading across Sand. This is intentional, not a
			     bug: the grass being confined to the damper soil patches is the player's signal
			     that water is near — green means water. Do NOT lower this to spread the grass
			     onto Sand. -->
			<fertilityMin>0.30</fertilityMin>
			<fertilitySensitivity>0.3</fertilitySensitivity>
			<growDays>2.5</growDays>
			<pollution>Any</pollution>
			<harvestWork>40</harvestWork>
			<maxMeshCount>9</maxMeshCount>
			<visualSizeRange>0.4~0.6</visualSizeRange>
			<topWindExposure>0.4</topWindExposure>
			<wildOrder>1</wildOrder>
		</plant>
	</ThingDef>

	<ThingDef ParentName="BushBase">
		<defName>RM_VellaraBloom</defName>
		<label>vellara bloom</label>
		<description>A rare, thick-leaved rosette bearing huge flowers of pink, gold and violet. Its strong, sweet scent makes it popular in gardens wherever shelter allows it to grow.</description>
		<statBases>
			<Beauty>10</Beauty>
		</statBases>
		<graphicData>
			<texPath>Things/Plant/RM_VellaraBloom</texPath>
			<graphicClass>Graphic_Random</graphicClass>
			<drawSize>1.5</drawSize>
			<shadowData>
				<volume>(0.55, 0.2, 0.2)</volume>
				<offset>(0,0,-0.1)</offset>
			</shadowData>
		</graphicData>
		<plant>
			<topWindExposure>0.07</topWindExposure>
			<wildClusterRadius>-1</wildClusterRadius>
			<!-- AUTHORED: donor left visualSizeRange unset (inherits BushBase's own default, itself UNMEASURED by the census); set explicitly here rather than left ambiguous. -->
			<visualSizeRange>0.7~1.0</visualSizeRange>
		</plant>
	</ThingDef>

</Defs>
