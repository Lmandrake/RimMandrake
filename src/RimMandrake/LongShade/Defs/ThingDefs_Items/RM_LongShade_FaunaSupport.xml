<!--
  RM_LongShade_FaunaSupport.xml             LONGSHADE_RULED_CONTENT_1, Q1

  Satellite item defs owed exclusively by one of the 13 fauna in
  RM_LongShade_Fauna.xml (verified each is used by no other def anywhere in
  src/RimStarWars before moving it — a shared material stayed behind instead,
  see below): the bokka's and ossik's own eggs, the ulgga's own eggs, the
  great devourer's own eggs, and the ulgga's own black-chitin leather.

  The kudda's leatherDef/specificMeatDef (RM_CactusHide/RM_CactusMeat) are
  duplicated here rather than reusing the SW-tier RSW_CactusHide/RSW_CactusMeat
  they were ported with — those two materials are ALSO used by RSW_Chikka and
  RSW_Skorra, two SW-tier creatures that are not part of this ruling and stay
  in the Utinni layer, so sharing them would give this free mod's kudda a
  cross-mod material reference. Same stats/texPath as the SW-tier originals.
-->
<Defs>

  <ThingDef ParentName="EggFertBase">
    <defName>RM_EggBokkaFertilized</defName>
    <label>bokka egg (fert.)</label>
    <description>A fertilized bokka egg. If all goes well, it should hatch into a baby bokka. It can be eaten raw, but it's much better cooked.</description>
    <graphicData>
      <texPath>Things/Item/Resource/AnimalProductRaw/EggRound</texPath>
      <color>(230,212,193)</color>
      <drawSize>0.8</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>45</MarketValue>
    </statBases>
    <comps>
      <li Class="CompProperties_Hatcher">
        <hatcherDaystoHatch>3.5</hatcherDaystoHatch>
        <hatcherPawn>RM_Bokka</hatcherPawn>
      </li>
    </comps>
  </ThingDef>


  <ThingDef ParentName="EggUnfertBase">
    <defName>RM_EggBokkaUnfertilized</defName>
    <label>bokka egg (unfert.)</label>
    <description>An unfertilized bokka egg. It can be eaten raw, but it's much, much better cooked.</description>
    <graphicData>
      <texPath>Things/Item/Resource/AnimalProductRaw/EggRound</texPath>
      <color>(220,202,183)</color>
      <drawSize>0.8</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>20.0</MarketValue>
    </statBases>
  </ThingDef>


