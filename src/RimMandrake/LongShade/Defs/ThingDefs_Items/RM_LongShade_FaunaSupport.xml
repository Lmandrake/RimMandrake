	<ThingDef ParentName="EggUnfertBase">
		<defName>RM_EggPirrikUnfertilized</defName>
		<label>pirrik egg (unfert.)</label>
		<description>An unfertilized pirrik egg. It can be eaten raw, but it's much better cooked.</description>
		<graphicData>
			<color>(226,214,150)</color>
			<drawSize>0.5</drawSize>
		</graphicData>
		<statBases>
			<MarketValue>20.0</MarketValue>
		</statBases>
	</ThingDef>

</Defs>
