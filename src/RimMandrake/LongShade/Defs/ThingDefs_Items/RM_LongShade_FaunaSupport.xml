	<!-- Gloomcast's own leather and meat — duplicated off RSW_Leather_Horax /
	     RSW_Saurian_Meat (ThingDefs_Items/RSW_MlieWaveC_Resources.xml,
	     RSW_MlieWaveB_Resources.xml), same stats and texPath, because those two
	     originals are also used by ~18 other SW-tier creatures (Dewback, Wraid,
	     Hssiss, Massiff, Boma, ...) that stay in the Utinni layer. -->
	<ThingDef ParentName="LeatherBase">
		<defName>RM_GloomcastHide</defName>
		<label>gloomcast hide</label>
		<description>Tanned, dried gloomcast hide. Strong, durable and pricey.</description>
		<graphicData>
			<texPath>swresource/Leather_Heavy</texPath>
			<color>(0,76,156)</color>
		</graphicData>
		<statBases>
			<MarketValue>15.0</MarketValue>
			<StuffPower_Armor_Sharp>2.2</StuffPower_Armor_Sharp>
			<StuffPower_Armor_Blunt>2.4</StuffPower_Armor_Blunt>
			<StuffPower_Insulation_Cold>10</StuffPower_Insulation_Cold>
			<StuffPower_Insulation_Heat>20</StuffPower_Insulation_Heat>
		</statBases>
		<stuffProps>
			<color>(0,76,156)</color>
			<commonality>0.025</commonality>
			<statFactors>
				<MaxHitPoints>1.0</MaxHitPoints>
			</statFactors>
		</stuffProps>
	</ThingDef>

	<!-- LIVE-CHECKED (validate_patch.py against the 630-mod load set): vanilla
	     ships no abstract "MeatBase" at all — RimWorld generates most raw
	     meats procedurally off race.meatDef. RSW_Saurian_Meat's own parent,
	     RSW_SWanimals_RawMeatBase, is itself just OrganicProductBase (real
	     vanilla abstract) plus the standard raw-meat shape; inlined here
	     directly rather than duplicating a second abstract for one def. -->
	<ThingDef ParentName="OrganicProductBase">
		<defName>RM_GloomcastMeat</defName>
		<label>gloomcast meat</label>
		<description>A piece of meat from a gloomcast.</description>
		<thingClass>ThingWithComps</thingClass>
		<graphicData>
			<texPath>swresource/Meat_Saurian</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<socialPropernessMatters>true</socialPropernessMatters>
		<statBases>
			<MarketValue>2.0</MarketValue>
			<Nutrition>0.1</Nutrition>
			<Flammability>0.5</Flammability>
			<Mass>0.03</Mass>
			<FoodPoisonChanceFixedHuman>0.02</FoodPoisonChanceFixedHuman>
		</statBases>
		<ingestible>
			<foodType>Meat</foodType>
			<preferability>DesperateOnly</preferability>
			<ingestEffect>EatMeat</ingestEffect>
			<ingestSound>RawMeat_Eat</ingestSound>
		</ingestible>
		<thingCategories>
			<li>MeatRaw</li>
		</thingCategories>
		<comps>
			<li Class="CompProperties_Rottable">
				<daysToRotStart>2</daysToRotStart>
				<rotDestroys>True</rotDestroys>
			</li>
		</comps>
	</ThingDef>

	<!-- Gloomcast's own dung/leavings filth — moved from RSW_Filth_WhaleDung
	     (ThingDefs_Misc/RSW_Filth_WhaleDung.xml), exclusive to this creature,
	     def and PNG both. FILTH_ON_NATURAL_TERRAIN_NOOP_1's finding still
	     applies unchanged: [Unnatural] placementMask, not Core's
	     Filth_AnimalFilth's [Terrain]-only mask, is what actually shows up on
	     Sand/SoftSand (NaturalTerrainBase's own filthAcceptanceMask). -->
	<ThingDef ParentName="BaseFilth">
		<defName>RM_Filth_Gloomcast</defName>
		<label>gloomcast dung</label>
		<description>A massive deposit left by a gloomcast — the megafauna's own fertiliser, and the visible mark of where it stopped.</description>
		<graphicData>
			<texPath>Things/Filth/RM_WhaleDung</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<color>(97,65,48,97)</color>
		</graphicData>
		<filth>
			<placementMask>
				<li>Unnatural</li>
			</placementMask>
			<rainWashes>true</rainWashes>
			<disappearsInDays>45~50</disappearsInDays>
			<cleaningWorkToReduceThickness>35</cleaningWorkToReduceThickness>
			<canFilthAttach>true</canFilthAttach>
		</filth>
	</ThingDef>


