<?xml version="1.0" encoding="utf-8"?>
<!-- LONGSHADE_TOLLOK_TICKS_1. The tollok are tick-like shade-dwellers in the deep middle of OLD WILD patches. Anything that sits
     long there picks them up; shade you built is clean. Added by RM_MapComponent_Tollok (RM_ShadeExtras.cs). All numbers PROVISIONAL. -->
<Defs>
  <HediffDef>
    <defName>RM_TollokInfestation</defName>
    <label>tollok infestation</label>
    <description>Tick-like shade-dwellers from the deep middle of an old natural patch of shade. They itch, then they bleed. They do not live in shade that somebody built, and they die off in a few days if the host stays out of the old patches.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <tendable>true</tendable>
    <makesSickThought>false</makesSickThought>
    <initialSeverity>0.05</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.1</severityPerDay>
      </li>
      <li Class="HediffCompProperties_TendDuration">
        <baseTendDurationHours>24</baseTendDurationHours>
        <severityPerDayTended>-0.2</severityPerDayTended>
      </li>
    </comps>
    <stages>
      <li>
        <label>itching</label>
        <painOffset>0.03</painOffset>
      </li>
      <li>
        <label>feeding</label>
        <minSeverity>0.35</minSeverity>
        <painOffset>0.08</painOffset>
        <bleedRate>0.02</bleedRate>
      </li>
      <li>
        <label>swarming</label>
        <minSeverity>0.75</minSeverity>
        <painOffset>0.15</painOffset>
        <bleedRate>0.05</bleedRate>
      </li>
    </stages>
  </HediffDef>
</Defs>
