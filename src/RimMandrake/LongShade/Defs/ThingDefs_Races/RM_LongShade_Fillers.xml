  <!-- ============== pirrik — LONGSHADE_BEDAZZLE_CONTENT_1 part 4 ==============
       RSW_GlitterBird (src/RimStarWars/SWBestiary/Defs/ThingDefs_Races/
       RSW_GlitterBird.xml, DELETED this pass) and the sitting's own "pirrik"
       filler were one creature — the sheet's name for a tiny shadow commensal
       that lives its whole life in the gloomcast's shade. Q11a: "glitter-bird"
       is descriptive English, not canon Star Wars IP, so it belongs in the
       RM_ tier, cast inline, not behind the Utinni patch layer. This def
       carries the donor's shadow-follow wiring (RM_ShadowFollowerExtension,
       unchanged) but is otherwise built fresh: vanilla "Bird" body (matching
       the since-cut RM_Ossik, not the donor's cross-mod RSW_FlyingAvian) and
       the sheet's own pirrik art (real renders, not a Whisperbird reskin) —
       no flying animation flip-book frames exist for this art, so none are
       declared; "never block flight waiting on frames" (CLAUDE.md) — the
       MaxFlightTime/FlightCooldown stat pair alone is what makes it a real
       flyer. Wired inline on RM_LongShade at the donor's old 0.2 weight
       (WildAnimals_LongShade.xml's Add block no longer carries this row). -->
  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Pirrik</defName>
    <label>pirrik</label>
    <description>A palm-sized flier with plumage that throws back what little light reaches the shade it lives in — a scatter of colour with no source of its own. It is born, feeds, breeds and dies inside the moving shadow of a single gloomcast, never landing on open sand: leaving the shadow even for a moment, in this light, is not a risk this bird is built to survive. When its gloomcast dies, so, eventually, does it.</description>
    <statBases>
      <MoveSpeed>3.0</MoveSpeed>
      <MarketValue>90</MarketValue>
      <ComfyTemperatureMin>-5</ComfyTemperatureMin>
      <ComfyTemperatureMax>60</ComfyTemperatureMax>
      <FilthRate>4</FilthRate>
      <Wildness>0.4</Wildness>
      <MaxFlightTime>30</MaxFlightTime>
      <FlightCooldown>10</FlightCooldown>
    </statBases>
    <tools>
      <li>
        <label>claws</label>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>5</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>Feet</linkedBodyPartsGroup>
      </li>
      <li>
        <label>beak</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>6</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Beak</linkedBodyPartsGroup>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>4</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
