<!--
  RM_LongShade_Fills.xml                    LONGSHADE_BEDAZZLE_CONTENT_1 spec point 8

  Four of the seven owner-kept fills (review sheet Transient/longshade_fills_art.decisions.json,
  ruled 2026-10-02): skarrok, vrekka, sippra, tazzok. The plants (maidenbloom, shadespire,
  pavecrust) are in ../ThingDefs_Plants/RM_LongShade_FillPlants.xml. Roles from
  design/Jawa/worldbuilding/biomes/longshade_bedazzle_review_2026-09-29.md "Roster gaps".
  Art: tazzok and skarrok use the ruled "_b" sets; vrekka and sippra their single sets.
  Bodies are vanilla (the free tier cannot carry a cross-mod BodyDef). All stats are first
  values, tuned by looking. Mechanics the roles describe (skarrok's scarp-drop strike,
  vrekka's corpse-following, sippra's shade-line gate, tazzok's ash-keyed dormancy) are
  NOT built here: spec point 8 is defs and art; the mechanics are owed.
-->
<Defs>

  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Skarrok</defName>
    <label>skarrok</label>
    <description>A pale, plated raptor-lizard with a hooked beak, a flaring crest of orange spines and long folded wings whose vanes blush coral at the edges. It roosts on the shaded face of standing rock, then falls onto whatever surfaces at the rim below: one strike with dark, hooked talons, one glide back into the shadow. Its long banded tail ends in a fan of coloured feathers that steers it in the drop.</description>
    <statBases>
      <MoveSpeed>5.0</MoveSpeed>
      <MarketValue>420</MarketValue>
      <ComfyTemperatureMin>-10</ComfyTemperatureMin>
      <ComfyTemperatureMax>80</ComfyTemperatureMax>
      <FilthRate>3</FilthRate>
      <Wildness>0.8</Wildness>
      <MaxFlightTime>20</MaxFlightTime>
      <FlightCooldown>12</FlightCooldown>
    </statBases>
    <tools>
      <li>
        <label>talons</label>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>11</power>
        <cooldownTime>1.6</cooldownTime>
        <linkedBodyPartsGroup>Feet</linkedBodyPartsGroup>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>8</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>beak</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>Beak</linkedBodyPartsGroup>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>4</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <race>
      <body>Bird</body>
      <herdAnimal>false</herdAnimal>
      <predator>true</predator>
      <maxPreyBodySize>1.2</maxPreyBodySize>
      <baseBodySize>0.9</baseBodySize>
      <baseHealthScale>0.9</baseHealthScale>
      <baseHungerRate>0.35</baseHungerRate>
      <foodType>CarnivoreAnimal</foodType>
      <leatherDef>Leather_Bird</leatherDef>
      <trainability>Intermediate</trainability>
      <petness>0</petness>
      <lifeExpectancy>14</lifeExpectancy>
      <flightStartChanceOnJobStart>0.1</flightStartChanceOnJobStart>
      <canFlyIntoMap>true</canFlyIntoMap>
      <manhunterOnDamageChance>0.3</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0.1</manhunterOnTameFailChance>
      <lifeStageAges>
        <li><def>AnimalBaby</def><minAge>0</minAge></li>
        <li><def>AnimalJuvenile</def><minAge>0.15</minAge></li>
        <li><def>AnimalAdult</def><minAge>0.3</minAge></li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
      <soundEating>Bird_Eat</soundEating>
    </race>
    <tradeTags>
      <li>AnimalExotic</li>
    </tradeTags>
  </ThingDef>

