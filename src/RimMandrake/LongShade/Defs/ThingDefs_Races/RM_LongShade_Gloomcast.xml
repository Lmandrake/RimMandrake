<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_LongShade_Gloomcast.xml                LONGSHADE_RULED_CONTENT_1, Q1 + Q5

  The shade whale, moved off src/RimStarWars/SWBestiary/Defs/ThingDefs_Races/
  RSW_ShadeWhale.xml and renamed RM_Gloomcast — Q5's ruling: the owner typed
  his own coinage "gloomcast" into the card, superseding the "thommak" DRAFT
  offer and the old "shade whale" working English-compound label outright
  (unlike the other 13 Q1 rows, this label was explicitly ruled, not frozen
  for the batch-4c sitting).

  This creature needed more than a rename: RSW_ShadeWhale was built as a
  reskin of RSW_Horax (same body, same leather, same meat, same sounds, same
  art, "zero new PNGs" by design, desert.md §4c) and Horax itself stays in
  the Utinni/Star-Wars layer — it is NOT part of this ruling's 14 rows. So
  every asset the reskin shared with Horax needed its own RM-tier copy so
  this mod carries no RSW_ reference:
    - body: RSW_Horax (BodyDef) -> RM_GloomcastBody, duplicated verbatim in
      RM_LongShade_Bodies.xml, with its three custom groups renamed
      RSW_SWLeftHoof/RSW_SWRightHoof/RSW_SWTailAttackTool ->
      RM_GloomcastLeftHoof/RM_GloomcastRightHoof/RM_GloomcastTailAttackTool
      (also duplicated there — those three are shared by many other SW-tier
      creatures, e.g. RSW_Dewback's tail, so they could not be renamed in
      place).
    - leather/meat: RSW_Leather_Horax / RSW_Saurian_Meat are shared by ~18
      other SW-tier creatures (Bolotaur, Boma, Dewback, Wraid, Hssiss, Massiff,
      Kwi, Shiro, Zakkeg, ...) and stay put; this mod gets its own
      RM_GloomcastHide / RM_GloomcastMeat, same stats, duplicated in
      RM_LongShade_FaunaSupport.xml.
    - art: the actual PNGs (not new renders) were copied from
      src/RimStarWars/HoraxArtOverride/Textures/swanimals/Horax/ and
      src/RimStarWars/SWBestiary/Textures/swanimals/Horax/Horax_Dessicated.png
      into this mod's own Textures/swanimals/Gloomcast/ — CLAUDE.md's "loose
      PNG beats AssetBundle donor art" and this item's own "existing art
      carries over, don't regenerate" instruction, extended from Ultracactus
      (where it was stated) to this creature (where the same reskin-reuse
      precedent already applied on the SW-tier side).
    - dung/leavings filth: RSW_Filth_WhaleDung (its own real extracted-Core
      art, exclusive to this creature) -> RM_Filth_Gloomcast, def + PNG both
      moved, in RM_LongShade_FaunaSupport.xml / this mod's own Textures/
      Things/Filth/.
    - dropped: nameGenerator/nameGeneratorFemale (SWAnimalNamerMale/Female,
      a generic SW-tier name generator used by 100+ creatures — falls back to
      the vanilla default animal namer) and the four RSW_Pawn_Horax_*
      Wounded/Death/Call/Angry SoundDefs (cosmetic, cross-mod, not
      duplicated) — same simplification shape as the 13 in
      RM_LongShade_Fauna.xml.
    - kept unchanged: every RimMandrake.CreatureBehaviors modExtension/comp
      (RM_ShadeSeekingWanderExtension, RM_FilterFeedExtension,
      RM_CompProperties_DungSeeder, RM_CompProperties_ShadowCaster) — these
      were ALREADY RimMandrake-tier C# (mandrake.rm.creaturebehaviors, a
      loadAfter dependency RM_LongShade already declares), never RSW_-tier,
      so no change was needed there. seedPlants repointed RSW_Ultracactus ->
      RM_UltrissPad (moved the same pass, Q2).
-->
<Defs>

<!-- ThingDef -->
<ThingDef ParentName="AnimalThingBase" ADogSaidBody="LegsTail">
    <defName>RM_Gloomcast</defName>
    <label>gloomcast</label>
    <description>A colossal, slow-moving grazer that crosses the open dayside in a single committed march, absorbing a furnace's worth of heat along the way. It filter-feeds through the sand as it goes, straining the buried canopy and the small life sheltering in it, and radiates the crossing's heat fiercely once it reaches shade — which is also the only moving shadow most of this desert ever sees. Nothing this large has a predator. Everything that can reach it rides in its shadow instead.</description>
    <statBases>
      <MoveSpeed>2.2</MoveSpeed>
      <MarketValue>6000</MarketValue>
      <ComfyTemperatureMin>-10</ComfyTemperatureMin>
      <ComfyTemperatureMax>95</ComfyTemperatureMax>
      <FilthRate>24</FilthRate>
      <ArmorRating_Sharp>0.55</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.60</ArmorRating_Blunt>
      <ArmorRating_Heat>0.70</ArmorRating_Heat>
      <Wildness>0.9</Wildness>
    </statBases>
    <tools>
      <li>
        <label>left foot</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>16</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>RM_GloomcastLeftHoof</linkedBodyPartsGroup>
      </li>
      <li>
        <label>right foot</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>16</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>RM_GloomcastRightHoof</linkedBodyPartsGroup>
      </li>
      <li>
        <label>spiked club-tail</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>18</power>
        <cooldownTime>2.6</cooldownTime>
        <linkedBodyPartsGroup>RM_GloomcastTailAttackTool</linkedBodyPartsGroup>
        <chanceFactor>0.3</chanceFactor>
      </li>
    </tools>
    <modExtensions>
      <!-- DESERT_SHADE_GRID_KEYSTONE_1's shade-seeking wander insert — steers
           idle wandering toward RM_MapComponent_ShadeGrid.ShadeAt cells
           instead of a uniform-random destination. Existing infrastructure,
           first real consumer. mandrake.rm.creaturebehaviors, already this
           mod's own loadAfter dependency — unchanged by the tier move. -->
      <li Class="RimMandrake.CreatureBehaviors.RM_ShadeSeekingWanderExtension">
        <minShadeToPrefer>0.5</minShadeToPrefer>
      </li>
      <!-- DESERT_SHADE_WHALE_FILTERFEED_1. desert.md §4c: "They filter-feed
           through the sand, straining the buried canopy and the small life
           grazing it. Anything that slow needs food that cannot run."
           Sand and SoftSand only — the buried canopy it strains is the
           ultracactus (RM_UltrissPad, fertilityMin 0.05 "so it takes Sand"),
           and open sand is the one ground in this biome the ultracactus owns
           uncontested. -->
      <li Class="RimMandrake.CreatureBehaviors.RM_FilterFeedExtension">
        <feedTerrainDefNames>
          <li>Sand</li>
          <li>SoftSand</li>
        </feedTerrainDefNames>
        <beginBelowFoodPercent>0.75</beginBelowFoodPercent>
        <foodPercentPerBout>0.10</foodPercentPerBout>
        <boutDurationTicks>1200</boutDurationTicks>
        <searchRadius>20</searchRadius>
        <leavingsFilthDef>RM_Filth_Gloomcast</leavingsFilthDef>
        <leavingsFilthCount>1</leavingsFilthCount>
      </li>
    </modExtensions>
    <comps>
      <!-- DESERT_SHADE_WHALE_FILTERFEED_1. desert.md §4c: "They leave massive
           dung at shade patches, and that dung immediately seeds young plants
           and young creatures around it." Gated on
           RM_MapComponent_ShadeGrid.ShadeAt, so a dung drop on the open
           crossing leaves filth and nothing else, and only a stop in a
           harbour actually fertilises it. -->
      <li Class="RimMandrake.CreatureBehaviors.RM_CompProperties_DungSeeder">
        <intervalTicksRange>15000~30000</intervalTicksRange>
        <minShadeToSeed>0.35</minShadeToSeed>
        <dungFilthDef>RM_Filth_Gloomcast</dungFilthDef>
        <dungFilthCount>4</dungFilthCount>
        <seedRadius>5.9</seedRadius>
        <growthBoost>0.25</growthBoost>
        <maxPlantsBoosted>12</maxPlantsBoosted>
        <seedPlants>
          <li>RM_UltrissPad</li>
        </seedPlants>
        <seedPlantCount>1~3</seedPlantCount>
        <seedPlantGrowth>0.05</seedPlantGrowth>
        <wildlifeSpawnChance>0.15</wildlifeSpawnChance>
        <maxWildlifeBodySize>0.6</maxWildlifeBodySize>
        <seededWildlifeAgeYears>0.4</seededWildlifeAgeYears>
      </li>
      <!-- DESERT_GLITTER_BIRDS_COMMENSALS_1. Marks this def as a legitimate
           shadow-follow host for RM_JobGiver_FollowShadowCaster. Generic
           mechanism, mandrake.rm.creaturebehaviors — unchanged by the tier
           move. Its RSW-tier consumer (RSW_GlitterBird) still finds this def
           fine cross-mod: a follower reading a host comp is not the kind of
           reference this item's "no RSW_ reference in the free mod" bar is
           about — the free mod itself declares nothing SW-tier. -->
      <li Class="RimMandrake.CreatureBehaviors.RM_CompProperties_ShadowCaster">
        <commensalFollowRadius>4</commensalFollowRadius>
        <!-- LONGSHADE_GPT_ENRICHMENT_1 §2 ("the gloomcast moves shade", owner-picked
             by card 2026-09-30): its body is a real moving shade caster in the shade
             grid, so every shade-seeking creature, not only its riders, can shelter
             in it, and it cools whoever stands in it.
             TUNED: height 2.0 (twice a rock: "colossal", bodySize 16) and a 3x3 body
             footprint (radius 1) are first values for the owner to judge in game;
             no ruling gives them. -->
        <castShadeHeight>2.0</castShadeHeight>
        <castShadeRadius>1</castShadeRadius>
        <castShadeDepth>1.0</castShadeDepth>
      </li>
      <!-- LONGSHADE_GPT_ENRICHMENT_1 §3: footfalls heard before it is seen
           (RM_Gloomcast_Footfall, wide distRange). TUNED: one every 1.5 s of walking. -->
      <li Class="RimMandrake.CreatureBehaviors.RM_CompProperties_Footfalls" MayRequire="mandrake.rm.biomes">
        <sound>RM_Gloomcast_Footfall</sound>
        <intervalTicks>90</intervalTicks>
      </li>
    </comps>
    <race>
      <body>RM_GloomcastBody</body>
      <predator>false</predator>
      <herdAnimal>false</herdAnimal> <!-- solitary — "a megafauna IS a mobile shade patch, the only one that exists" (desert.md §4c) -->
      <baseBodySize>16.0</baseBodySize>
      <baseHealthScale>12.0</baseHealthScale>
      <baseHungerRate>2.2</baseHungerRate>
      <foodType>VegetarianRoughAnimal</foodType>
      <gestationPeriodDays>25</gestationPeriodDays>
      <leatherDef>RM_GloomcastHide</leatherDef>
      <specificMeatDef>RM_GloomcastMeat</specificMeatDef>
      <trainability>None</trainability>
      <manhunterOnTameFailChance>0.05</manhunterOnTameFailChance>
      <manhunterOnDamageChance>0.10</manhunterOnDamageChance>
      <lifeExpectancy>90</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.5</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>1.0</minAge>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
      <soundEating>Herbivore_Eat</soundEating>
    </race>
    <tradeTags>
      <li>AnimalExotic</li>
      <li>AnimalFarm</li>
    </tradeTags>
  </ThingDef>

<!-- PawnKindDef -->
<PawnKindDef ParentName="AnimalKindBase">
    <defName>RM_Gloomcast</defName>
    <label>gloomcast</label>
    <race>RM_Gloomcast</race>
    <combatPower>650</combatPower>
    <ecoSystemWeight>0.08</ecoSystemWeight>
    <wildGroupSize>1</wildGroupSize>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>swanimals/Gloomcast/Gloomcast</texPath>
          <!-- GLOOMCAST OWN ART 2026-10-02: own 3-facing render (artpipe RM_Gloomcast_{north,east,south}, downscaled 1024->512); the old ochre body tint is dropped because the colour is baked in. Dessicated sprite is still the Horax-derived copy. -->
          <drawSize>2.2</drawSize>
          <shadowData>
            <volume>(0.4, 0.3, 0.3)</volume>
            <offset>(0,0,-0.2)</offset>
          </shadowData>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>swanimals/Gloomcast/Gloomcast_Dessicated</texPath>
          <drawSize>2.2</drawSize>
        </dessicatedBodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>swanimals/Gloomcast/Gloomcast</texPath>
          <drawSize>6.4</drawSize>
          <shadowData>
            <volume>(0.6, 0.45, 0.45)</volume>
            <offset>(0,0,-0.25)</offset>
          </shadowData>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>swanimals/Gloomcast/Gloomcast_Dessicated</texPath>
          <drawSize>6.4</drawSize>
        </dessicatedBodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>swanimals/Gloomcast/Gloomcast</texPath>
          <drawSize>8.8</drawSize>
          <shadowData>
            <volume>(0.8, 0.6, 0.6)</volume>
            <offset>(0,0,-0.3)</offset>
          </shadowData>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>swanimals/Gloomcast/Gloomcast_Dessicated</texPath>
          <drawSize>8.8</drawSize>
        </dessicatedBodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>

</Defs>
