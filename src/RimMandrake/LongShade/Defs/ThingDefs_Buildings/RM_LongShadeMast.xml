<?xml version="1.0" encoding="utf-8"?>
<!--
  BIOME_SHIP_CONTRIBUTIONS_1 — the Long Shade's gift to the ship. Delegated design (the agent's call, logged on the
  item), set by a fresh design judge (evidence/design_judge_r2.json: the lure awning only shades its footprint, which
  a roof beats, so the biome needed a gift of its own). The Long Shade is the band of long shadows under a low sun;
  this mast carries that onto the deck: a tall black-chitin vane whose LEE runs the length of an open deck when the
  sun is low, where a roof would close the deck and a 1.5-high sun shield shades two or three cells.
  Mechanics are the shade-gear engine's lee mode (RimMandrake.CreatureBehaviors.RM_CompProperties_ShadeGear,
  RM_MapComponent_ShadeGrid: lee length = leeHeight x the sun's cells-per-height, capped at 16 cells; at least one
  cell under a high sun). leeHeight 4.5 (a wall is 1.0, the sun shield 1.5), shadeDepth 0.9, lowSunFactor 1,
  overheadFactor 0.6: weak at noon overhead, strongest exactly where the Direct Sun is long and low. PROVISIONAL.
  Black chitin (RM_BlackChitin) is the Long Shade insectoids' leather. Ship-buildable: Light affordance, no
  placeWorker, minifiable. Checked by src/RimMandrake/Utils/ship_contributions.py.
  ART: own textures Things/Building/Temperature/RM_LongShadeMast_south/_north/_east (384 px each; west mirrors
  east; installed 2026-11-12, judged KEEP, whittle/biome_ship_contributions_1/evidence/art2/verdict_r2.md). With no drawOffset the 3x3 canvas leaves the vane two cells of
  height; a drawOffset (0,0,1) would let it stand taller.
-->
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>RM_LongShadeMast</defName>
    <label>long-shade mast</label>
    <description>A tall vane of overlapping black chitin on a stepped mast, set edge-on to the sun the way the Long Shade's own spires stand. Its shadow lies on the far side from the sun and runs as long as the sun is low: at dawn and dusk one mast shades a strip of open deck a dozen cells long, where a roof would close the deck in. Under a sun straight overhead it shades little more than its own foot.</description>
    <graphicData>
      <texPath>Things/Building/Temperature/RM_LongShadeMast</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,3)</drawSize>
      <damageData>
        <rect>(0.2,0.1,0.6,0.8)</rect>
      </damageData>
    </graphicData>
    <size>(3,1)</size>
    <rotatable>true</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.4</fillPercent>
    <canOverlapZones>true</canOverlapZones>
    <staticSunShadowHeight>1</staticSunShadowHeight>
    <designationCategory>Temperature</designationCategory>
    <uiOrder>2112</uiOrder>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsTemperature</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>220</MaxHitPoints>
      <WorkToBuild>1600</WorkToBuild>
      <Mass>14</Mass>
      <Flammability>0.3</Flammability>
      <Beauty>2</Beauty>
    </statBases>
    <costList>
      <RM_BlackChitin>50</RM_BlackChitin>
      <Steel>30</Steel>
    </costList>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <building>
      <destroySound>BuildingDestroyed_Soft_Small</destroySound>
    </building>
    <comps>
      <li Class="RimMandrake.CreatureBehaviors.RM_CompProperties_ShadeGear">
        <mode>lee</mode>
        <shadeDepth>0.9</shadeDepth>
        <overheadFactor>0.6</overheadFactor>
        <lowSunFactor>1</lowSunFactor>
        <leeHeight>4.5</leeHeight>
        <fallbackLeeCells>4</fallbackLeeCells>
      </li>
    </comps>
  </ThingDef>
</Defs>
