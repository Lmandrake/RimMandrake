<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_LongShade_Middens.xml                         LONGSHADE_MIDDENS_DESIGN_1

  Owner rulings 2026-10-03 (question card): a midden is a heap searched once and spent (ruled 2026-10-08); searching yields VANILLA items only; the vrekka builds the heaps, and killing or
  driving them off stops the regrowth. C#: Source/RM_LongShadeMiddens.cs (header there says
  which precedents the shape is copied from: SWBestiary's scrap nest, Scarlands' ordnance search).

  Every number below is PROVISIONAL. With one vrekka tending: a layer per ~5 days at the
  half-day cooldown and 0.1 per tend, so an empty heap is full (4 layers) in ~3 weeks.

  ART OWED: no midden-heap art exists in artpipe (artpipe_state.py find midden/heap, 2026-10-06:
  only the Wasteland's middenshell family). The graphic is vanilla's slag-chunk set, tinted, as a
  stand-in. Wanted: a low mound of sand, bone-white scraps and dull scrap metal in a lee.
-->
<Defs>

  <ThingDef ParentName="BuildingNaturalBase">
    <defName>RM_LongShadeMidden</defName>
    <label>midden heap</label>
    <description>A low heap in the lee of rock, where everything the wind carries across this desert finally stops: sand-polished bones, split water vessels, hide scraps, dung and wind-sorted scrap. Vrekka drag more onto it and pick it over, and as long as they keep at it the heap keeps growing. Dig through it and you will find something worth keeping; leave the vrekka alive and it will be worth digging again.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <altitudeLayer>Building</altitudeLayer>
    <!-- PLACEHOLDER: vanilla slag-chunk sprites, tinted. Real art owed (see header). -->
    <graphicData>
      <texPath>Things/Item/Chunk/ChunkSlag</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <drawSize>1.4</drawSize>
      <color>(150, 128, 100)</color>
    </graphicData>
    <drawerType>MapMeshOnly</drawerType>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.25</fillPercent>
    <scatterableOnMapGen>false</scatterableOnMapGen>
    <filthLeaving>Filth_RubbleBuilding</filthLeaving>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <Flammability>0.4</Flammability>
      <Beauty>-4</Beauty>
    </statBases>
    <building>
      <claimable>false</claimable>
      <isInert>true</isInert>
      <artificialForMeditationPurposes>false</artificialForMeditationPurposes>
    </building>
    <comps>
      <li Class="RimMandrake.LongShade.CompProperties_RM_MiddenHeap">
        <builderRaces>
          <li>RM_Vrekka</li>
        </builderRaces>
        <maxLayers>4</maxLayers>
        <startLayers>1</startLayers>
        <tendGain>0.1</tendGain>
        <tendCooldownTicks>30000</tendCooldownTicks>
        <tendDurationTicks>400</tendDurationTicks>
        <searchTicks>900</searchTicks>
        <rollsPerLayer>2</rollsPerLayer>
        <maxHeapsPerMap>6</maxHeapsPerMap>
        <minHeapSpacing>16</minHeapSpacing>
        <heapSearchRadius>30</heapSearchRadius>
        <buildRadius>10</buildRadius>
        <minBuildShade>0.5</minBuildShade>
        <!-- Vanilla items only (ruled). Bones/dung/vessels have no vanilla item; their salvage is what is listed. -->
        <yields>
          <li><thing>Steel</thing><count>4~12</count><weight>3</weight></li>
          <li><thing>ChunkSlagSteel</thing><count>1~1</count><weight>2</weight></li>
          <li><thing>Leather_Plain</thing><count>3~8</count><weight>2</weight></li>
          <li><thing>Cloth</thing><count>3~8</count><weight>1.5</weight></li>
          <li><thing>WoodLog</thing><count>4~10</count><weight>1.5</weight></li>
          <li><thing>Silver</thing><count>5~20</count><weight>1</weight></li>
          <li><thing>MedicineHerbal</thing><count>1~2</count><weight>0.4</weight></li>
          <li><thing>ComponentIndustrial</thing><count>1~2</count><weight>0.4</weight></li>
        </yields>
      </li>
    </comps>
  </ThingDef>

  <!-- The clean-patch tell. PLACEHOLDER: vanilla sand-filth sprite, pale. Real art queued in artpipe
       (RM_LongShadeCleanPatch). Selectable, walkable, no collision. -->
  <ThingDef ParentName="BuildingNaturalBase">
    <defName>RM_LongShadeCleanPatch</defName>
    <label>unnaturally clean ground</label>
    <description>Ground scoured smooth: no drift, no pebbles, no tracks. Something lairs in the shade here and keeps its floor swept.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <graphicData>
      <texPath>Things/Filth/Sand</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <drawSize>2.2</drawSize>
      <color>(232, 220, 196)</color>
    </graphicData>
    <drawerType>MapMeshOnly</drawerType>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <fillPercent>0</fillPercent>
    <scatterableOnMapGen>false</scatterableOnMapGen>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <building>
      <claimable>false</claimable>
      <isInert>true</isInert>
      <deconstructible>false</deconstructible>
    </building>
    <comps>
      <li Class="RimMandrake.LongShade.CompProperties_RM_CleanPatchTell">
        <line>Unnaturally clean.</line>
      </li>
    </comps>
  </ThingDef>

  <JobDef>
    <defName>RM_VrekkaTendMidden</defName>
    <driverClass>RimMandrake.LongShade.JobDriver_RM_VrekkaTendMidden</driverClass>
    <reportString>adding to the midden.</reportString>
    <casualInterruptible>true</casualInterruptible>
  </JobDef>

  <JobDef>
    <defName>RM_SearchMidden</defName>
    <driverClass>RimMandrake.LongShade.JobDriver_RM_SearchMidden</driverClass>
    <reportString>searching TargetA.</reportString>
  </JobDef>

  <WorkGiverDef>
    <defName>RM_SearchMidden</defName>
    <label>search midden heaps</label>
    <giverClass>RimMandrake.LongShade.WorkGiver_RM_SearchMidden</giverClass>
    <workType>Mining</workType>
    <priorityInType>40</priorityInType>
    <verb>search</verb>
    <gerund>searching</gerund>
    <scanThings>true</scanThings>
    <prioritizeSustains>false</prioritizeSustains>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <!--
    Inserted at vanilla's Animal_PreMain hook (same route as SWBestiary's RSW_ScrapHoarderInsert),
    so no animal think tree is cloned. The giver returns at once for any race not named in the
    heap's builderRaces, and gates itself on hunger, rest and danger.
  -->
  <ThinkTreeDef>
    <defName>RM_VrekkaMiddenInsert</defName>
    <insertTag>Animal_PreMain</insertTag>
    <insertPriority>45</insertPriority>
    <thinkRoot Class="ThinkNode_Priority">
      <subNodes>
        <li Class="RimMandrake.LongShade.JobGiver_RM_VrekkaMidden" />
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>

</Defs>
