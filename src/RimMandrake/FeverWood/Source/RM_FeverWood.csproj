<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FEVERWOOD_RM_MOD_BUILD_1. Same recipe as
    src/RimMandrake/Greentide/Source/RM_Greentide.csproj — copy that header
    if this one goes stale.

    Build (the dotnet is WINDOWS-NATIVE and cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\Rimworld\src\RimMandrake\FeverWood\Source\RM_FeverWood.csproj -c Release

    Output lands in ../Assemblies/, which is where RimWorld looks.

    No Harmony: the one class here (RM_BiomeWorker_FeverWood) is a plain
    engine extension point (BiomeWorker). The biome's own hazard mechanics
    (F1/F2/F3/F5/F6/F7 spike C#) stay in mandrake.rm.environmentalhazards —
    packaging them into this mod is a separate, not-yet-made call (see
    FEVERWOOD_RM_MOD_BUILD_1's own item file); this mod's XML references
    those classes cross-assembly, same as the RUT_FeverWood twin already
    does.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrake.FeverWood</AssemblyName>
    <RootNamespace>RimMandrake.FeverWood</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="RM_BiomeWorker_FeverWood.cs" />
    <Compile Include="RM_FeverWoodMod.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
