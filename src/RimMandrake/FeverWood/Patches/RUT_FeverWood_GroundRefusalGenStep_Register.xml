<?xml version="1.0" encoding="utf-8"?>
<!--
  RUT_FeverWood_GroundRefusalGenStep_Register.xml   UtinniPatches - FEVER_WOOD_MECHANICS_1 F5 build pass

  Registers RUT_GenStep_GroundRefusal onto Base_Player, same target/shape as
  RUT_FeverWood_ScatterPoolsGenStep_Register.xml (read directly before
  writing this).
-->
<Patch>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/MapGeneratorDef[defName="Base_Player"]/genSteps</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/MapGeneratorDef[defName="Base_Player"]/genSteps</xpath>
      <value>
        <li MayRequire="mandrake.rm.environmentalhazards">RUT_GenStep_GroundRefusal</li>
      </value>
    </match>
  </Operation>

</Patch>
