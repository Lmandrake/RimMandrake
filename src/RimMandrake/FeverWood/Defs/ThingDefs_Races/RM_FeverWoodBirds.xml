  <!-- 1. RM_Chellow — tameable, the chorus you can keep              -->
  <!-- ============================================================ -->

  <ThingDef ParentName="RM_FeverWoodBirdBase">
    <defName>RM_Chellow</defName>
    <label>chellow</label>
    <description>Squat and round, with no feathers on its head at all — bare wrinkled skin and a translucent throat-fan it inflates to call, veined and lit faintly from behind. Easy to win over and easy to keep, a cultivated flock of chellow makes a private chorus outside the walls: as long as they are calling, the water below is quiet.</description>
    <statBases>
      <MarketValue>75</MarketValue>
      <Wildness>0.35</Wildness>
      <MaxFlightTime>8</MaxFlightTime>
      <FlightCooldown>6</FlightCooldown>
    </statBases>
    <race>
      <baseBodySize>0.3</baseBodySize>
      <baseHealthScale>0.4</baseHealthScale>
      <trainability>Intermediate</trainability>
      <lifeExpectancy>7</lifeExpectancy>
    </race>
  </ThingDef>

