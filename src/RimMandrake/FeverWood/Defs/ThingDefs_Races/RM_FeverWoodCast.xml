  <!-- wave (item §3), not built here.                                 -->
  <!-- ============================================================ -->

  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Gorrameth</defName>
    <label>gorrameth</label>
    <description>A huge, round-backed grey browser with a low-slung drinking head, built so that it always looks about to kneel at the wrong pool. It wanders the Fever Wood placidly and alone, drinks from the still black mirrors, and every so often one of them takes it. Nothing in the wood hunts it. Nothing needs to.</description>
