<?xml version="1.0" encoding="utf-8"?>
<!--
  FEVERWOOD_RM_CAST_COMPLETION_1, pass 1 of the seven ratified creatures:
  lommerel, nemmel, grolth. Spec: the item's §1 table; descriptions from the
  roster's art briefs (design/Jawa/worldbuilding/biomes/fever_wood_fauna_roster_2026-09-23.md
  rows 6, and fever_wood_rm_cast_proposal_2026-09-24.md for nemmel/grolth).
  All three are franchise-free invented names (RM_ tier, Q11a) and live ONLY
  in RM_FeverWood (one home; rows inline on RM_FeverWood/wildAnimals).

  Every stat below that is not a ruled value (bodySize, diet, commonality are
  ruled by the item) is INVENTED / PROVISIONAL — tuned against vanilla
  analogues (muffalo-ish grazer, hare-ish small grazer, tortoise-ish slow
  body), never owner-set.

  Behaviour is vanilla throughout, deliberately:
   - lommerel/nemmel: ordinary herd grazers (VegetarianRoughAnimal).
   - grolth: CarnivoreAnimal with predator=false — vanilla never hunts with
     it, so it only ever eats corpses/meat it finds ("waits, never chases",
     the sheet's ban on native chase predators). Slow on purpose.
  ⚠️ The lommerel's "slung UNDER the bough, reads upside-down" is a SPRITE
  property (art), not a body/AI property — do not "correct" the art upright.

  Art: finished artpipe renders exist for all three (feverwood_<name>_{east,
  north,south}, _artsrc/), installed via art.py install (mechanical reason
  artpipe-collect) into Textures/Things/Pawn/Animal/RM_<Name>/.
-->
<Defs>

  <!-- ============================================================ -->
  <!-- RM_Lommerel — the crown's grazer, slung under the boughs        -->
  <!-- ============================================================ -->

  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Lommerel</defName>
    <label>lommerel</label>
    <description>A soft-bodied grazer that hangs beneath a bough rather than standing on it, gripping with short hooked limbs, its back permanently silted and mossy from the crown's own debris. It eats the verrow's gourds and the bough-soil's cover, and is the reason the crown's small patient hunters have anything to wait for.\n\nIt is the only thing in the crown that lives upside-down.</description>
    <statBases>
      <MoveSpeed>3.0</MoveSpeed>  <!-- PROVISIONAL -->
      <MarketValue>200</MarketValue>  <!-- PROVISIONAL -->
      <ComfyTemperatureMin>5</ComfyTemperatureMin>  <!-- PROVISIONAL -->
      <ComfyTemperatureMax>50</ComfyTemperatureMax>  <!-- PROVISIONAL -->
      <Wildness>0.6</Wildness>  <!-- PROVISIONAL -->
    </statBases>
    <tools>
      <li>
        <label>hooked forelimb</label>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>6</power>  <!-- PROVISIONAL -->
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>5</power>  <!-- PROVISIONAL -->
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <chanceFactor>0.3</chanceFactor>
      </li>
    </tools>
    <race>
      <body>QuadrupedAnimalWithPaws</body>
      <herdAnimal>true</herdAnimal>
      <predator>false</predator>
      <baseBodySize>1.0</baseBodySize>  <!-- ruled ~1.0 -->
      <baseHealthScale>0.9</baseHealthScale>  <!-- PROVISIONAL -->
      <baseHungerRate>0.7</baseHungerRate>  <!-- PROVISIONAL -->
      <foodType>VegetarianRoughAnimal</foodType>
      <leatherDef>Leather_Plain</leatherDef>
      <manhunterOnDamageChance>0.05</manhunterOnDamageChance>  <!-- PROVISIONAL -->
      <manhunterOnTameFailChance>0.02</manhunterOnTameFailChance>  <!-- PROVISIONAL -->
      <trainability>None</trainability>
      <gestationPeriodDays>20</gestationPeriodDays>  <!-- PROVISIONAL -->
      <lifeExpectancy>12</lifeExpectancy>  <!-- PROVISIONAL -->
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.25</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.6</minAge>
          <soundWounded>Pawn_Muffalo_Wounded</soundWounded>
          <soundDeath>Pawn_Muffalo_Death</soundDeath>
          <soundCall>Pawn_Muffalo_Call</soundCall>
          <soundAngry>Pawn_Muffalo_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <tradeTags>
      <li>AnimalUncommon</li>
    </tradeTags>
  </ThingDef>

  <PawnKindDef ParentName="AnimalKindBase">
    <defName>RM_Lommerel</defName>
