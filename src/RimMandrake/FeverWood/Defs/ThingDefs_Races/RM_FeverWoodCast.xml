  <!-- ============================================================ -->
  <!-- RM_Grolth — the causeway margins' carrion-dissolver             -->
  <!-- ============================================================ -->

  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Grolth</defName>
    <label>grolth</label>
    <description>A wet, dark hummock of a body with no head anyone has found, working the causeway margins so slowly it reads as part of the mud. A pale, dissolving slick spreads from under its front edge, and whatever dead thing that slick reaches is gone by morning. It does not chase. It does not need to: in the Fever Wood, something is always dying near the water.</description>
    <statBases>
      <MoveSpeed>1.4</MoveSpeed>  <!-- PROVISIONAL: slow on purpose, never a chaser -->
      <MarketValue>90</MarketValue>  <!-- PROVISIONAL -->
      <ComfyTemperatureMin>5</ComfyTemperatureMin>  <!-- PROVISIONAL -->
      <ComfyTemperatureMax>50</ComfyTemperatureMax>  <!-- PROVISIONAL -->
      <Wildness>0.9</Wildness>  <!-- PROVISIONAL -->
    </statBases>
    <tools>
      <li>
        <label>dissolving slick</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>8</power>  <!-- PROVISIONAL -->
        <cooldownTime>2.6</cooldownTime>
        <linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
      </li>
    </tools>
    <race>
      <body>Snake</body>
      <herdAnimal>false</herdAnimal>
      <predator>false</predator>  <!-- ban 3: vanilla never hunts with it; corpses only -->
      <baseBodySize>0.8</baseBodySize>  <!-- ruled ~0.8 -->
      <baseHealthScale>1.0</baseHealthScale>  <!-- PROVISIONAL -->
      <baseHungerRate>0.35</baseHungerRate>  <!-- PROVISIONAL -->
      <foodType>CarnivoreAnimal</foodType>
      <manhunterOnDamageChance>0</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0</manhunterOnTameFailChance>
      <trainability>None</trainability>
      <lifeExpectancy>15</lifeExpectancy>  <!-- PROVISIONAL -->
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.3</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.8</minAge>
          <soundWounded>Pawn_BigInsect_Pain</soundWounded>
          <soundDeath>Pawn_BigInsect_Death</soundDeath>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
