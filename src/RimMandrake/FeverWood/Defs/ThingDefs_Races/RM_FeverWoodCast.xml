  <!-- ============================================================ -->
  <!-- RM_Brathek — the wood-borer that keeps digging                  -->
  <!-- The roster leaves its dig RATE and whether it can be DIRECTED   -->
  <!-- open, so this build does not guess either: it ships no wall,    -->
  <!-- building or boughway damage at all. Its only wood damage is     -->
  <!-- vanilla tree-eating (foodType Tree, the megathrips-like "wood   -->
  <!-- pulp" diet the item allows "at most"), and the Mod Settings     -->
  <!-- toggle "Brathek bores into living wood" strips that flag at     -->
  <!-- startup (RM_BrathekBoring.cs). Every number is INVENTED.        -->
  <!-- ============================================================ -->

  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Brathek</defName>
    <label>brathek</label>
    <description>A fat, ringed larva as long as a forearm, pale and wet, its soft body carried on rows of short gripper pegs that clamp into bark and hold it fast while it works. The front end is all mouth: a ring of hard rasping plates that grind into living wood a mouthful at a time, so the brathek does not bore so much as scrape its way in. It is usually seen half-buried in a gallery mouth, pegs braced against the rim, or as a slow-moving bulge under bark. It eats wood, and it keeps eating.</description>
    <statBases>
      <MoveSpeed>2.0</MoveSpeed>  <!-- INVENTED / PROVISIONAL: slow and visible -->
      <MarketValue>120</MarketValue>  <!-- INVENTED / PROVISIONAL -->
      <ComfyTemperatureMin>5</ComfyTemperatureMin>  <!-- INVENTED / PROVISIONAL -->
      <ComfyTemperatureMax>50</ComfyTemperatureMax>  <!-- INVENTED / PROVISIONAL -->
      <Wildness>0.8</Wildness>  <!-- INVENTED / PROVISIONAL -->
    </statBases>
    <tools>
      <li>
        <label>rasping head-plate</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>9</power>  <!-- INVENTED / PROVISIONAL -->
        <cooldownTime>2.4</cooldownTime>
        <linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
      </li>
    </tools>
    <race>
      <body>Snake</body>
      <herdAnimal>false</herdAnimal>
      <predator>false</predator>
      <baseBodySize>0.9</baseBodySize>  <!-- ruled ~0.9 -->
      <baseHealthScale>1.0</baseHealthScale>  <!-- INVENTED / PROVISIONAL -->
      <baseHungerRate>0.5</baseHungerRate>  <!-- INVENTED / PROVISIONAL -->
      <foodType>VegetarianRoughAnimal, Tree</foodType>  <!-- wood pulp; Tree stripped when the setting is off -->
      <manhunterOnDamageChance>0.05</manhunterOnDamageChance>  <!-- INVENTED / PROVISIONAL -->
      <manhunterOnTameFailChance>0</manhunterOnTameFailChance>
      <trainability>None</trainability>  <!-- "directed" is an open ruling; not guessed -->
      <lifeExpectancy>6</lifeExpectancy>  <!-- INVENTED / PROVISIONAL -->
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.15</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.4</minAge>
          <soundWounded>Pawn_BigInsect_Pain</soundWounded>
          <soundDeath>Pawn_BigInsect_Death</soundDeath>
          <soundCall>Pawn_BigInsect_Call</soundCall>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <tradeTags>
      <li>AnimalUncommon</li>
    </tradeTags>
  </ThingDef>

  <PawnKindDef ParentName="AnimalKindBase">
    <defName>RM_Brathek</defName>
    <label>brathek</label>
    <race>RM_Brathek</race>
    <combatPower>40</combatPower>  <!-- INVENTED / PROVISIONAL -->
    <canArriveManhunter>false</canArriveManhunter>
    <wildGroupSize>1~3</wildGroupSize>  <!-- INVENTED / PROVISIONAL -->
