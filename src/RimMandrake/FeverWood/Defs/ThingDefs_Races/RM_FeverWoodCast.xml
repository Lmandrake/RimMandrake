      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/RM_Lommerel/RM_Lommerel</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.8</drawSize>
        </bodyGraphicData>
      </li>
