  <!-- ============================================================ -->
  <!-- RM_Nemmel — the floor's one honest meal                         -->
  <!-- ============================================================ -->

  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Nemmel</defName>
    <label>nemmel</label>
    <description>A plump, short-legged, mud-brown grazer of the causeway edges, walking on oversized splayed feet that work like mud-shoes and leave a broad flat print. Nothing about it is a trick. On a floor where every pool lies and every ally is a bargain, the nemmel is simply meat that eats grass — the Fever Wood's one honest meal.</description>
    <statBases>
      <MoveSpeed>3.8</MoveSpeed>  <!-- PROVISIONAL -->
      <MarketValue>70</MarketValue>  <!-- PROVISIONAL -->
      <ComfyTemperatureMin>5</ComfyTemperatureMin>  <!-- PROVISIONAL -->
      <ComfyTemperatureMax>50</ComfyTemperatureMax>  <!-- PROVISIONAL -->
      <Wildness>0.5</Wildness>  <!-- PROVISIONAL -->
    </statBases>
    <tools>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>4</power>  <!-- PROVISIONAL -->
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
      </li>
    </tools>
    <race>
      <body>QuadrupedAnimalWithPaws</body>
      <herdAnimal>true</herdAnimal>
      <predator>false</predator>
      <baseBodySize>0.3</baseBodySize>  <!-- ruled ~0.3 -->
      <baseHealthScale>0.5</baseHealthScale>  <!-- PROVISIONAL -->
      <baseHungerRate>0.4</baseHungerRate>  <!-- PROVISIONAL -->
      <foodType>VegetarianRoughAnimal</foodType>
      <leatherDef>Leather_Plain</leatherDef>
      <manhunterOnDamageChance>0</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0</manhunterOnTameFailChance>
      <trainability>None</trainability>
      <gestationPeriodDays>10</gestationPeriodDays>  <!-- PROVISIONAL -->
      <litterSizeCurve>
        <points>
          <li>(0.5, 0)</li>
          <li>(1, 1)</li>
          <li>(2, 1)</li>
          <li>(3, 0)</li>
        </points>
      </litterSizeCurve>
      <lifeExpectancy>7</lifeExpectancy>  <!-- PROVISIONAL -->
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.15</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.35</minAge>
          <soundWounded>Pawn_Tortoise_Wounded</soundWounded>
          <soundDeath>Pawn_Tortoise_Death</soundDeath>
          <soundCall>Pawn_Tortoise_Call</soundCall>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <tradeTags>
      <li>AnimalUncommon</li>
    </tradeTags>
  </ThingDef>

