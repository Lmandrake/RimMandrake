  <!-- ============================================================ -->
  <!-- RM_Silloch — the crown's patient predator                       -->
  <!-- predator=false, so vanilla never hunts with it (ban 3). Its     -->
  <!-- only attack is RM_CompSillochAmbush (this mod's own source):    -->
  <!-- it waits pressed against a tree trunk, strikes what steps       -->
  <!-- within reach, and gives up the moment the victim gets clear.    -->
  <!-- The FeverWoodCrown tag answers the ollareth's scream            -->
  <!-- (RM_SapSuckerGuild.xml) — the one-line finish that file named.  -->
  <!-- ============================================================ -->

  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Silloch</defName>
    <label>silloch</label>
    <description>There is almost nothing to see: a flat mottled wedge the colour of wet bark, folded utterly motionless against a trunk, with only a pair of forward limbs held cocked. It does not stalk. It waits, sometimes for days, and then it is simply attached to something.</description>
    <statBases>
      <MoveSpeed>3.0</MoveSpeed>  <!-- PROVISIONAL: never needs to be fast -->
      <MarketValue>150</MarketValue>  <!-- PROVISIONAL -->
      <ComfyTemperatureMin>5</ComfyTemperatureMin>  <!-- PROVISIONAL -->
      <ComfyTemperatureMax>50</ComfyTemperatureMax>  <!-- PROVISIONAL -->
      <Wildness>0.9</Wildness>  <!-- PROVISIONAL -->
    </statBases>
    <tools>
      <li>
        <label>cocked forelimbs</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>10</power>  <!-- PROVISIONAL -->
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadClaw</linkedBodyPartsGroup>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>4</power>  <!-- PROVISIONAL -->
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <comps>
      <li Class="RimMandrake.FeverWood.RM_CompProperties_SillochAmbush">
        <strikeRangeCells>1.9</strikeRangeCells>  <!-- adjacent only -->
        <maxPreyBodySize>1.0</maxPreyBodySize>  <!-- PROVISIONAL: up to a lommerel -->
        <strikeDamageRange>8~14</strikeDamageRange>  <!-- PROVISIONAL -->
        <leashCells>4</leashCells>  <!-- PROVISIONAL: past this it lets go, never chases -->
        <trunkSearchRadius>10</trunkSearchRadius>  <!-- PROVISIONAL -->
        <waitTicks>2500</waitTicks>  <!-- PROVISIONAL -->
      </li>
    </comps>
    <race>
      <body>BeetleLikeWithClaw</body>
      <herdAnimal>false</herdAnimal>
      <predator>false</predator>  <!-- ban 3: the comp ambushes, vanilla never hunts -->
      <baseBodySize>0.6</baseBodySize>  <!-- ruled ~0.6 -->
      <baseHealthScale>0.8</baseHealthScale>  <!-- PROVISIONAL -->
      <baseHungerRate>0.3</baseHungerRate>  <!-- PROVISIONAL: waits for days -->
      <foodType>CarnivoreAnimal</foodType>
      <manhunterOnDamageChance>0.3</manhunterOnDamageChance>  <!-- PROVISIONAL -->
      <manhunterOnTameFailChance>0.1</manhunterOnTameFailChance>  <!-- PROVISIONAL -->
      <trainability>None</trainability>
      <lifeExpectancy>8</lifeExpectancy>  <!-- PROVISIONAL -->
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.2</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.5</minAge>
          <soundWounded>Pawn_BigInsect_Pain</soundWounded>
          <soundDeath>Pawn_BigInsect_Death</soundDeath>
          <soundAngry>Pawn_BigInsect_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <tradeTags>
      <li>AnimalUncommon</li>
    </tradeTags>
    <modExtensions>
      <li Class="RimMandrake.CreatureBehaviors.RM_AlarmResponderExtension">
        <tag>FeverWoodCrown</tag>
      </li>
    </modExtensions>
  </ThingDef>

