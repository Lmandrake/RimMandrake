<?xml version="1.0" encoding="utf-8"?>
<!--
  FEVERWOOD_RM_CAST_COMPLETION_1, pass 1 of the seven ratified creatures:
  lommerel, nemmel, grolth. Spec: the item's §1 table; descriptions from the
  roster's art briefs (design/Jawa/worldbuilding/biomes/fever_wood_fauna_roster_2026-09-23.md
  rows 6, and fever_wood_rm_cast_proposal_2026-09-24.md for nemmel/grolth).
  All three are franchise-free invented names (RM_ tier, Q11a) and live ONLY
  in RM_FeverWood (one home; rows inline on RM_FeverWood/wildAnimals).

  Every stat below that is not a ruled value (bodySize, diet, commonality are
  ruled by the item) is INVENTED / PROVISIONAL — tuned against vanilla
  analogues (muffalo-ish grazer, hare-ish small grazer, tortoise-ish slow
  body), never owner-set.

  Behaviour is vanilla throughout, deliberately:
   - lommerel/nemmel: ordinary herd grazers (VegetarianRoughAnimal).
   - grolth: CarnivoreAnimal with predator=false — vanilla never hunts with
     it, so it only ever eats corpses/meat it finds ("waits, never chases",
     the sheet's ban on native chase predators). Slow on purpose.
  ⚠️ The lommerel's "slung UNDER the bough, reads upside-down" is a SPRITE
  property (art), not a body/AI property — do not "correct" the art upright.

  Art: finished artpipe renders exist for all three (feverwood_<name>_{east,
  north,south}, _artsrc/), installed via art.py install (mechanical reason
  artpipe-collect) into Textures/Things/Pawn/Animal/RM_<Name>/.
-->
<Defs>

  <!-- ============================================================ -->
  <!-- RM_Grolth — the causeway margins' carrion-dissolver             -->
  <!-- ============================================================ -->

  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Grolth</defName>
    <label>grolth</label>
    <description>A slumped, glistening mound of dark olive flesh, heaped in heavy folds and rolls with no head anyone has found, moss and lichen taking hold on its back as if it were a fallen log. It moves on short, splayed, toe-padded stumps, so slowly it reads as part of the mud. From under its front edge pours a pale, yellow-green slime that eats into whatever it touches, and the grolth leaves a dissolving trail of it wherever it has been. Anything dead that the slime reaches is gone by morning. It does not chase; in the Fever Wood, something is always dying near the water.</description>
    <statBases>
      <MoveSpeed>1.4</MoveSpeed>  <!-- PROVISIONAL: slow on purpose, never a chaser -->
      <MarketValue>90</MarketValue>  <!-- PROVISIONAL -->
      <ComfyTemperatureMin>5</ComfyTemperatureMin>  <!-- PROVISIONAL -->
      <ComfyTemperatureMax>50</ComfyTemperatureMax>  <!-- PROVISIONAL -->
      <Wildness>0.9</Wildness>  <!-- PROVISIONAL -->
    </statBases>
    <tools>
      <li>
        <label>dissolving slick</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>8</power>  <!-- PROVISIONAL -->
        <cooldownTime>2.6</cooldownTime>
        <linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
      </li>
    </tools>
    <race>
      <body>Snake</body>
      <herdAnimal>false</herdAnimal>
      <predator>false</predator>  <!-- ban 3: vanilla never hunts with it; corpses only -->
      <baseBodySize>0.8</baseBodySize>  <!-- ruled ~0.8 -->
      <baseHealthScale>1.0</baseHealthScale>  <!-- PROVISIONAL -->
      <baseHungerRate>0.35</baseHungerRate>  <!-- PROVISIONAL -->
      <foodType>CarnivoreAnimal</foodType>
      <manhunterOnDamageChance>0</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0</manhunterOnTameFailChance>
      <trainability>None</trainability>
      <lifeExpectancy>15</lifeExpectancy>  <!-- PROVISIONAL -->
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.3</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.8</minAge>
          <soundWounded>Pawn_BigInsect_Pain</soundWounded>
          <soundDeath>Pawn_BigInsect_Death</soundDeath>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <tradeTags>
      <li>AnimalUncommon</li>
    </tradeTags>
  </ThingDef>

  <PawnKindDef ParentName="AnimalKindBase">
    <defName>RM_Grolth</defName>
    <label>grolth</label>
    <race>RM_Grolth</race>
    <combatPower>35</combatPower>  <!-- PROVISIONAL -->
    <canArriveManhunter>false</canArriveManhunter>
    <wildGroupSize>1~1</wildGroupSize>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/RM_Grolth/RM_Grolth</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>0.9</drawSize>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/RM_Grolth/RM_Grolth</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.2</drawSize>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/RM_Grolth/RM_Grolth</texPath>
