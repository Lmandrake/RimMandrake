<!-- FEVERWOOD_ANT_HIVE_DUNGEON_1 / fever_wood_rm_cast_proposal_2026-09-24.md
     row F9 ("kurreth", NEW, RM_Kurreth): "the ant-swarm — the raider from
     the dry direction; steals nectar-beasts ALIVE; hive castes as
     plain-modifier variants (kurreth queen)". Art brief: "glossy red-black
     segmented worker, oversized carry-mandibles, always drawn mid-haul".

     🔴 Never a `wildAnimals` row (roster's own ban: "0 — never a
     wildAnimals row, off-map only") — these ThingDefs exist to populate the
     ant hive dungeon (this item) and the off-map raiding faction
     (FEVERWOOD_TWO_FRONT_LURE_1, not built by this pass). RM_ tier per
     Q11a: kurreth is an INVENTED name, not Star Wars canon, so it lives
     franchise-free and inline here rather than behind a Utinni patch.

     Art: real generated renders (feverwood_kurreth_{south,east,north},
     infrastructure/artpipe/_artsrc/, rimflow_item_id FEVERWOOD_RM_MOD_BUILD_1,
     state generated/awaiting_verdict — not yet owner-ruled, but not a
     placeholder either) copied into this mod's own Textures/. The queen
     reuses the same three renders at a larger drawSize: no bespoke queen art
     exists yet (queued as owed, not invented from nothing).

     Ground-based, no flight — ants are not "airborne in the fiction", so
     the standing flyer rule does not apply here.

     The hive reaction (alarm/rally) is wired below on both castes via the
     shared CreatureBehaviors reaction source. ⛔ NOT built here: the off-map
     theft-hauling lord/job
     (FEVERWOOD_TWO_FRONT_LURE_1's F9 scope, "Ant theft-hauling: a
     steal-the-herd lord"). Both castes below are the shared population these
     defs owe either consumer, undecorated by either's behaviour. -->
<Defs>

  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Kurreth</defName>
    <label>kurreth</label>
    <description>A glossy red-black segmented ant the size of a large dog, oversized mandibles held forward as if perpetually mid-haul. Alone it is dangerous but not much of a threat; a whole hive of them is why nothing sensible digs where they have already dug.</description>
    <statBases>
      <MoveSpeed>3.6</MoveSpeed>
      <MarketValue>90</MarketValue>
      <ComfyTemperatureMin>5</ComfyTemperatureMin>
      <ComfyTemperatureMax>50</ComfyTemperatureMax>
      <ArmorRating_Sharp>0.2</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.1</ArmorRating_Blunt>
      <Wildness>1</Wildness>
    </statBases>
    <tools>
      <li>
        <label>mandibles</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>11</power>
        <cooldownTime>1.8</cooldownTime>
        <linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
        <chanceFactor>1</chanceFactor>
      </li>
    </tools>
    <race>
      <body>BeetleLikeWithClaw</body>
      <herdAnimal>false</herdAnimal>
      <predator>false</predator>
      <baseBodySize>0.55</baseBodySize>
      <baseHealthScale>0.85</baseHealthScale>
      <baseHungerRate>0.5</baseHungerRate>
      <foodType>OmnivoreAnimal</foodType>
      <manhunterOnDamageChance>0.1</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0.1</manhunterOnTameFailChance>
      <trainability>None</trainability>
      <fleshType>Insectoid</fleshType>
      <bloodDef>Filth_BloodInsect</bloodDef>
      <bloodSmearDef>Filth_BloodSmear</bloodSmearDef>
      <useMeatFrom>Megaspider</useMeatFrom>
      <gestationPeriodDays>6</gestationPeriodDays>
      <litterSizeCurve>
        <points>
          <li>(0.99, 0)</li>
          <li>(1, 1)</li>
          <li>(1.01, 0)</li>
        </points>
      </litterSizeCurve>
      <lifeExpectancy>3</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.15</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.3</minAge>
          <soundWounded>Pawn_Megascarab_Wounded</soundWounded>
          <soundDeath>Pawn_Megascarab_Death</soundDeath>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
      <soundEating>Insectoid_Eat</soundEating>
    </race>
    <tradeTags>
      <li>AnimalInsect</li>
    </tradeTags>
    <!-- REACTION_MECHANISM_GENERALISE_1 step 3 / FEVERWOOD_ANT_HIVE_DUNGEON_1:
         the hive reacts. A wild (faction-less) kurreth that SEES an intruder
         within 7 cells, or is hurt, rings an alarm; the alarm hops resident to
         resident (9 cells per hop, through the corridors) and each one reached
         rallies after the intruder. BUDGET, stated as a total: one disturbance
         rallies at most 11 kurreth (the ringer + 10 reached by propagation;
         rallying itself costs nothing so the total is exactly the hop count).
         Telegraph: an angry chitter + a ThreatBig message once per alarm, and
         a "!" over every kurreth that answers. Raiding-column kurreth carry a
         faction and ignore all of this (they answer their lord).
         Disengage at 45 cells from the alarm's origin: leave the hive's reach
         and the hunt ends. Stench smoke (Greentide grenade) suppresses it. -->
    <comps>
      <li Class="RimMandrake.CreatureBehaviors.RM_CompProperties_ReactionSource">
        <tag>KurrethHive</tag>
        <eventBudget>10</eventBudget>
        <cooldownTicks>2500</cooldownTicks>
        <detectRadius>7</detectRadius>
        <detectIntervalTicks>120</detectIntervalTicks>
        <propagation Class="RimMandrake.CreatureBehaviors.RM_ReactionPropagationRule_RespondersWithinRadius">
          <radius>9</radius>
          <budgetPerNeighbor>1</budgetPerNeighbor>
        </propagation>
        <response Class="RimMandrake.CreatureBehaviors.RM_ReactionResponseRule_Rally">
          <mentalState>RM_HiveRally</mentalState>
          <disengageRadius>45</disengageRadius>
          <budgetCost>0</budgetCost>
          <alarmSound>Pawn_Megascarab_Angry</alarmSound>
          <alarmMessage>The kurreth hive has noticed you. The alarm is spreading through the tunnels.</alarmMessage>
        </response>
      </li>
      <li Class="RimMandrake.CreatureBehaviors.RM_CompProperties_HomeTether">
        <tetherRadius>6</tetherRadius>
      </li>
    </comps>
    <modExtensions>
      <li Class="RimMandrake.CreatureBehaviors.RM_AlarmResponderExtension">
        <tag>KurrethHive</tag>
      </li>
    </modExtensions>
  </ThingDef>

  <PawnKindDef ParentName="AnimalKindBase">
    <defName>RM_Kurreth</defName>
    <label>kurreth</label>
    <race>RM_Kurreth</race>
    <combatPower>45</combatPower>
    <canArriveManhunter>false</canArriveManhunter>
    <ecoSystemWeight>0</ecoSystemWeight>
    <wildGroupSize>1~1</wildGroupSize>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/Kurreth/Kurreth</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.0</drawSize>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/Kurreth/Kurreth</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.2</drawSize>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/Kurreth/Kurreth</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.4</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>

