<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
  RM_Kasselith: owned RM_ port of the megathrips (VFEI2_Megathrips, oskarpotocki.vfe.insectoid2
  1.6/Defs/ThingDefs_Races/Races_Megathrips.xml; its parent VFEI2_BaseInsect inlined), plain XML copy 2026-10-18 for
  donor retirement (owner: "Just put in placeholder art for now or donor copies and retire these mods!!! Just get it
  done."). Free RM_ tier, home mod Fever Wood (RM_FeverWood 0.5 and its campaign twin RUT_FeverWood 0.5, wood-borer).
  Name and description are the Feverwood sheet's (2026-10-08, "Redo name and description."), formerly applied to the
  donor def by UtinniPatches/Patches/FeverWood_Rename.xml; the Ashkarr tolerance pin 0..78.1 is folded in.
  Departures, all to make it plain XML with no VFE Insectoids reference:
    - tool capacity VFEI2_AcidBite -> vanilla Bite, and VEF CompProperties_InitialHediff VFEI2_AcidImmunity dropped:
      the acid burn is gone, so the description no longer promises acid.
    - leatherDef VFEI2_Chitin dropped: no leather (LeatherAmount 0), as vanilla's own insectoids.
    - dessicated graphic, colour tint and CutoutComplex dropped (the drawn art carries its own colour).
  ART: the UtinniPatches same-path redraw of the donor's megathrips (what the game showed), copied through the art
  ledger to OUR path below.
  -->
  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Kasselith</defName>
    <label>kasselith</label>
    <description>A narrow, hard-shelled insect the length of a forearm, built in plates like a folded blade, that works the Fever Wood's rotten trunks in endless files. Kasselith are hive workers, bred long ago for war: their mandibles shear through bark and armour alike. A kasselith cannot breed on its own — it belongs to a hive somewhere, and where one is seen boring into a trunk, more are already inside.</description>
    <statBases>
      <MoveSpeed>3.68</MoveSpeed>
      <Flammability>0.7</Flammability>
      <ComfyTemperatureMin>0</ComfyTemperatureMin>
      <ComfyTemperatureMax>78.1</ComfyTemperatureMax>
      <MarketValue>100</MarketValue>
      <ArmorRating_Blunt>0.16</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.64</ArmorRating_Sharp>
      <ToxicResistance>1</ToxicResistance>
      <ToxicEnvironmentResistance MayRequire="Ludeon.RimWorld.Biotech">1</ToxicEnvironmentResistance>
      <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">1</VacuumResistance>
      <LeatherAmount>0</LeatherAmount>
      <Wildness>0.2</Wildness>
    </statBases>
    <tools>
      <li>
        <label>mandibles</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <armorPenetration>0.07</armorPenetration>
        <power>5</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>4</power>
        <armorPenetration>0.06</armorPenetration>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.1</chanceFactor>
      </li>
    </tools>
    <race>
      <body>BeetleLike</body>
      <fleshType>Insectoid</fleshType>
      <bloodDef>Filth_BloodInsect</bloodDef>
      <meatColor>(160,168,139)</meatColor>
      <meatMarketValue>0.5</meatMarketValue>
      <foodType>OmnivoreAnimal, AnimalProduct</foodType>
      <manhunterOnDamageChance>0.50</manhunterOnDamageChance>
      <soundEating>Insectoid_Eat</soundEating>
      <canBeVacuumBurnt>false</canBeVacuumBurnt>
      <baseHungerRate>0.14</baseHungerRate>
      <baseBodySize>0.35</baseBodySize>
      <baseHealthScale>0.18</baseHealthScale>
      <useMeatFrom>Megaspider</useMeatFrom>
      <lifeExpectancy>10</lifeExpectancy>
      <trainability>Intermediate</trainability>
      <lifeStageAges>
        <li>
          <def>EusocialInsectLarva</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>EusocialInsectJuvenile</def>
          <minAge>0.03</minAge>
        </li>
        <li>
          <def>EusocialInsectAdult</def>
          <minAge>0.4</minAge>
          <soundWounded>Pawn_Megascarab_Wounded</soundWounded>
          <soundDeath>Pawn_Megascarab_Death</soundDeath>
          <soundCall>Pawn_Megascarab_Call</soundCall>
          <soundAngry>Pawn_Megascarab_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <ingredient>
      <mergeCompatibilityTags>
        <li MayRequire="Ludeon.RimWorld.Ideology">InsectMeat</li>
      </mergeCompatibilityTags>
    </ingredient>
  </ThingDef>
  <PawnKindDef ParentName="AnimalKindBase">
    <defName>RM_Kasselith</defName>
    <label>kasselith</label>
    <race>RM_Kasselith</race>
    <combatPower>40</combatPower>
    <ecoSystemWeight>0.50</ecoSystemWeight>
    <aiAvoidCover>false</aiAvoidCover>
    <defendPointRadius>0</defendPointRadius>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/RM_Kasselith/RM_Kasselith</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1</drawSize>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/RM_Kasselith/RM_Kasselith</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.25</drawSize>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/RM_Kasselith/RM_Kasselith</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.5</drawSize>
          <shadowData>
            <volume>(0.5, 0.7, 0.43)</volume>
            <offset>(0,0,-0.1)</offset>
          </shadowData>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>
</Defs>
