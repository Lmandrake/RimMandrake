  -->
  <!-- RM_Iashiphus: port of AB_Iashiphus (Alpha Biomes 1.6/Defs/ThingDefs_Plants/Plants_TarPits.xml), plain XML copy 2026-10-18 for donor retirement.
       Dropped/replaced: harvest AB iashiphus fruit -> vanilla RawBerries. -->
  <ThingDef ParentName="BushBase">
    <defName>RM_Iashiphus</defName>
    <label>iashiphus</label>
    <description>This vivid green plant seem to be related to cacti. Though it's fleshy bark is not edible, it produces flowers than can be consumed by humans.\n\nPlant details: Iashiphus is a wild plant that cannot be cultivated, and it needs minimum terrain fertility of 0.7. Can be harvested for raw iashiphus fruit.</description>
    <descriptionHyperlinks>
      <ThingDef>RawBerries</ThingDef>
    </descriptionHyperlinks>
    <statBases>
      <Beauty>2</Beauty>
    </statBases>
    <graphicData>
      <texPath>StandIn/Things/Plants/RM_Iashiphus</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shadowData>
        <volume>(0.3, 0.2, 0.15)</volume>
        <offset>(0,0,-0.1)</offset>
      </shadowData>
    </graphicData>
    <plant>
      <!-- PLANT_ECONOMY_TUNE_EVERY_NUMBER_AT_ONCE (2026-11-01, bar: design/RimMandrake/plant_economy_rule_2026-11-01.md): E2: was 10 berries in 3 days -->
      <wildClusterRadius>3</wildClusterRadius>
      <wildClusterWeight>4</wildClusterWeight>
      <!-- ART_SIZES_AUDIT_AFTER_DONORS_LEAVE (2026-11-03): owner order "4 squares wide" (flora_assignment_register.decisions.json, 2026-09-11) enacted; was 2 cells. -->
      <visualSizeRange>3~4</visualSizeRange>
      <harvestYield>8</harvestYield>
      <harvestWork>250</harvestWork>
      <harvestTag>Standard</harvestTag>
      <harvestAfterGrowth>0.30</harvestAfterGrowth>
      <harvestedThingDef>RawBerries</harvestedThingDef>
    </plant>
  </ThingDef>
</Defs>
