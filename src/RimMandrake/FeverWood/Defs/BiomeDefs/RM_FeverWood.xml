<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_FeverWood                                    FEVERWOOD_RM_MOD_BUILD_1

  RimMandrake-tier standalone build of the Fever Wood, derived from the
  frozen campaign twin src/RimUtinni/UtinniPatches/Defs/BiomeDefs/
  RUT_FeverWood.xml (232 lines, FROZEN — see that file's own header). This
  copy carries: vanilla terrainsByFertility/diseases/baseWeatherCommonalities
  unchanged; the 3 modExtensions (already mandrake.rm.environmentalhazards-
  tier, so they need only be present here, not re-authored) re-pointed at
  this def simply by being nested inside it; its own workerClass replacing
  the twin's donor ReGrowthCore.UniversalBiomeWorker; and the vanilla +
  non-Star-Wars-donor rows of wildAnimals/wildPlants only.

  ⛔ Star Wars canon fauna/flora do NOT ship here (Q11a) — every RSW_/donor
  row that carries a canon or franchise name rides
  src/RimUtinni/UtinniPatches/Patches/WildAnimals_FeverWood.xml instead (10
  animal rows, 3 plant rows). VFEI2_Megathrips (non-Star-Wars donor) stays
  inline per Q9. RUT_GiantLeaf is duplicated as this mod's own RM_GiantLeaf
  (Q13 — see Defs/ThingDefs_Plants/RM_GiantLeaf.xml for why this is a
  duplicate, not a move: the donor def is also an unconditional row in
  RUT_Greentide.xml). FEVERWOOD_FLORA_ROSTER_1 cut the 3 AB_* donor
  placeholder rows (AB_KeeningCordax/AB_Iashiphus/AB_Gomphoeria,
  sarg.alphabiomes) that used to stay inline here and replaced them with
  18 RM_-tier invented rows (RM_FeverWoodFlora.xml).

  generatesNaturally stays false, unchanged from the twin: the Fever Wood is
  a campaign-placed biome, not one meant to win natural worldgen scoring —
  RM_BiomeWorker_FeverWood exists (and is real, not a stub) so the def still
  loads cleanly and so a future generatesNaturally=true flip on someone
  else's world is not starting from a null workerClass.

  World map texture: the twin's `World/Biomes/GreaterTropicalSwamp` is DONOR
  ART (Steam Workshop item 3620545124), a hard dependency the RM tier may
  not assume. PLACEHOLDER: `World/Biomes/RM_FeverWood.png`, a flat dark
  swamp-green/brown 512x512 tone at this mod's own texture path — not a
  regen, not an artpipe job, just enough to load without borrowing the
  donor's file. Real bespoke world-map art is owed to the standing art
  pipeline.
-->
<Defs>

  <BiomeDef>
    <defName>RM_FeverWood</defName>
    <generatesNaturally>false</generatesNaturally>
    <label>the Fever Wood</label>
    <description>The place where trees finally won. Great solid trunks, much more than one tile wide, have rooted the backswamp still and solid, tamed the flowing waters into shallow surface pools with deep, deep mud beneath. Their arches and branches have grown into byways well above the dark still pools -- roads made of living wood. In the crown: a whole arboreal world. Below: the black mirrors, unrippled. Nothing goes in the water here. Everything remembers why.</description>
    <workerClass>RimMandrake.FeverWood.RM_BiomeWorker_FeverWood</workerClass>
    <!-- FEVERWOOD_TIER_LEAKS_FIX_1: no ancient dangers here. The donor twin got this only from a
         campaign patch (AncientDangerGenSteps_AmbientDoctrine.xml); it is the place's own doctrine
         (vanilla genstep, no IP), so the free def declares it. Same field Pyrelands uses. -->
    <preventGenSteps>
      <li>ScatterShrines</li>
    </preventGenSteps>
    <foragedFood>RawBerries</foragedFood>
    <allowRoads>true</allowRoads>
    <allowRivers>true</allowRivers>
    <allowFarmingCamps>true</allowFarmingCamps>
    <animalDensity>2.3</animalDensity>
    <!-- FEVERWOOD_CROWN_SOUND_HEAT_1: the crown's working hum; RM_MapComponent_SilenceCue hushes it while a
         sentinel is up (section 6k), so the silence cuts something real. -->
    <soundsAmbient>
      <li>RM_FeverWood_CrownHum</li>
    </soundsAmbient>
    <plantDensity>0.7</plantDensity>
    <forageability>0.6</forageability>
    <movementDifficulty>5</movementDifficulty>
    <texture>World/Biomes/RM_FeverWood</texture>
    <diseaseMtbDays>20</diseaseMtbDays>
    <diseases>
      <li>
        <diseaseInc>Disease_Flu</diseaseInc>
        <commonality>70</commonality>
      </li>
      <li>
        <diseaseInc>Disease_Plague</diseaseInc>
        <commonality>50</commonality>
      </li>
      <li>
        <diseaseInc>Disease_Malaria</diseaseInc>
        <commonality>140</commonality>
      </li>
      <li>
        <diseaseInc>Disease_GutWorms</diseaseInc>
        <commonality>75</commonality>
      </li>
      <li>
        <diseaseInc>Disease_MuscleParasites</diseaseInc>
        <commonality>50</commonality>
      </li>
      <li>
        <diseaseInc>Disease_AnimalFlu</diseaseInc>
        <commonality>70</commonality>
      </li>
      <li>
        <diseaseInc>Disease_AnimalPlague</diseaseInc>
        <commonality>100</commonality>
      </li>
    </diseases>
    <terrainsByFertility>
      <li>
        <terrain>Soil</terrain>
        <min>-999</min>
        <max>0.9</max>
      </li>
      <li>
        <terrain>SoilRich</terrain>
        <min>0.9</min>
        <max>999</max>
      </li>
    </terrainsByFertility>
    <!-- The 3 hazard modExtensions, unchanged from the twin — all already
         mandrake.rm.environmentalhazards-tier, re-pointed at this def
         simply by being nested here. See RUT_FeverWood.xml's own comments
         for the full field-by-field rationale; not repeated here. -->
    <modExtensions>
      <li Class="RimMandrake.EnvironmentalHazards.RM_LivingBoleBiomeExtension">
        <heartwoodThing>RUT_FeverTrunkHeartwood</heartwoodThing>
        <coreMarkerThing>RUT_FeverTrunkCore</coreMarkerThing>
        <boleCountRange>1~2</boleCountRange>
        <boleRadius>4~6</boleRadius>
        <minSpacing>30</minSpacing>
        <edgeMargin>12</edgeMargin>
      </li>
      <li Class="RimMandrake.EnvironmentalHazards.RM_MirrorPoolBiomeExtension">
        <poolTerrain>RUT_FeverWoodMirrorPool</poolTerrain>
      </li>
      <li Class="RimMandrake.EnvironmentalHazards.RM_RootCausewayBiomeExtension">
        <causewayTerrain>RUT_Boughway</causewayTerrain>
        <basinTerrains>
          <li>Soil</li>
          <li>SoilRich</li>
        </basinTerrains>
        <pathsPerAnchorRange>3~6</pathsPerAnchorRange>
        <laneWidthRange>1~2</laneWidthRange>
        <pathLengthRange>20~40</pathLengthRange>
        <fallbackAnchorCountRange>1~3</fallbackAnchorCountRange>
        <fallbackMinAnchorSpacing>25</fallbackMinAnchorSpacing>
        <fallbackEdgeMargin>10</fallbackEdgeMargin>
        <additionalPasses>
          <li>
            <causewayTerrain>RM_RootCauseway</causewayTerrain>
            <basinTerrains>
              <li>Soil</li>
              <li>SoilRich</li>
            </basinTerrains>
            <pathsPerAnchorRange>1~2</pathsPerAnchorRange>
            <laneWidthRange>1~1</laneWidthRange>
            <pathLengthRange>10~20</pathLengthRange>
            <turnChancePerStep>0.3</turnChancePerStep>
          </li>
          <li>
            <causewayTerrain>RUT_BoughSoil</causewayTerrain>
            <basinTerrains>
              <li>Soil</li>
              <li>SoilRich</li>
            </basinTerrains>
            <pathsPerAnchorRange>4~8</pathsPerAnchorRange>
            <laneWidthRange>2~4</laneWidthRange>
            <pathLengthRange>15~30</pathLengthRange>
            <turnChancePerStep>0.4</turnChancePerStep>
          </li>
        </additionalPasses>
      </li>
      <li Class="RimMandrake.EnvironmentalHazards.RM_GroundRefusalBiomeExtension">
        <refusalTerrain>MarshyTerrain</refusalTerrain>
        <convertFromTerrains>
          <li>Soil</li>
          <li>SoilRich</li>
        </convertFromTerrains>
      </li>
      <!-- FEVERWOOD_ANT_HIVE_DUNGEON_1: procedural layout, kurreth workers +
           queen that react (the race's own reaction source), and chamber 1 of
           3, the thornbug farm, and chamber 2, the glomvar parasite. The guard
           chamber is FEVERWOOD_HIVE_GUARD_CHAMBER_1. -->
      <li Class="RimMandrake.FeverWood.RM_AntHiveBiomeExtension">
        <workerKind>RM_Kurreth</workerKind>
        <queenKind>RM_KurrethQueen</queenKind>
        <farmKind>RM_Thornbug</farmKind>
        <parasiteKind>RM_Glomvar</parasiteKind>
      </li>
      <!-- FEVERWOOD_CROWN_SOUND_HEAT_1 / SOLAR_HEAT_EXPOSURE_1: sun heat kind "ambient" - still, shadeless
           heat under the crown: shade does nothing, only insulation or leaving helps. Vanilla temperature
           only, no hediff. heatOffsetC is an INVENTED first value for the owner-watched sitting, same
           posture as the Greentide's. -->
      <li Class="RimMandrake.CreatureBehaviors.RM_SunHeatExtension" MayRequire="mandrake.rm.biomes">
        <heatKind>ambient</heatKind>
        <heatOffsetC>8</heatOffsetC>
      </li>
    </modExtensions>
    <baseWeatherCommonalities>
      <Clear>30</Clear>
      <Fog>10</Fog>
      <Rain>0</Rain>
      <DryThunderstorm>1</DryThunderstorm>
      <!-- FEVERWOOD_OIL_BOIL_WEATHER_1: hot still days only (temperatureRange gate, Mod Settings) -->
      <RM_FeverWood_OilBoil>2</RM_FeverWood_OilBoil>
      <RainyThunderstorm>0</RainyThunderstorm>
      <FoggyRain>0</FoggyRain>
      <SnowGentle>0</SnowGentle>
      <SnowHard>0</SnowHard>
      <Overcast MayRequire="Ludeon.RimWorld.Odyssey">2</Overcast>
    </baseWeatherCommonalities>
    <!-- Only the non-Star-Wars-donor row — Q9. The other 10 wildAnimals
         rows from the twin ride WildAnimals_FeverWood.xml (Utinni patch)
         instead — Q11a. -->
    <wildAnimals>
      <VFEI2_Megathrips MayRequire="oskarpotocki.vfe.insectoid2">0.5</VFEI2_Megathrips>  <!-- kasselith (renamed from megathrips, Feverwood sheet 2026-10-08) - wood-borer, keep -->

      <!-- FEVERWOOD_SAP_SUCKER_GUILD_1: the sap-drinker guild, four species,
           one rule ("clamped to bark, drinks sap, does not flee"), four
           refusals. Commonalities are ENGINEERING DEFAULTS, not owner-set
           values, same posture as the flora roster's own §8 — thornbug
           highest (the existing, most numerous nectar-contract herd),
           the other three lower and roughly even. -->
      <RM_Thornbug>0.6</RM_Thornbug>  <!-- thornbug - the nectar contract -->
      <RM_Vaulm>0.3</RM_Vaulm>  <!-- vaulm - seals itself in hardened sap -->
      <RM_Ollareth>0.3</RM_Ollareth>  <!-- ollareth - screams for help -->
      <RM_Drommath>0.3</RM_Drommath>  <!-- drommath - swells until it can't be pulled off -->

      <!-- FEVERWOOD_ALIEN_BIRD_CHORUS_1: the crown's four birds — the
           "loudest place on the planet, deliberately" cast whose ambient
           chorus is the thing that falls silent for the water (see
           RM_FeverWoodBirds.xml's own header). Commonalities are
           ENGINEERING DEFAULTS, chellow highest since it is the tameable
           row the owner explicitly wants cultivated near a base. -->
      <RM_Chellow>0.5</RM_Chellow>  <!-- chellow - tameable, the chorus you can keep -->
      <RM_Murrelith>0.35</RM_Murrelith>  <!-- murrelith - plumage worth money -->
      <RM_Skellick>0.25</RM_Skellick>  <!-- skellick - steals your things -->

      <!-- FEVERWOOD_RM_CAST_COMPLETION_1: ratified cast, commonalities as
           ruled in that item's §1 table (defs: RM_FeverWoodCast.xml). -->
      <RM_Grolth>0.05</RM_Grolth>  <!-- grolth - carrion-dissolver, waits, never chases -->
      <RM_Brathek>0.5</RM_Brathek>  <!-- brathek - the wood-borer that keeps digging -->
      <RM_Silloch>0.3</RM_Silloch>  <!-- silloch - the crown's wait-ambusher, reads as bark -->
      <!-- Feverwood art sheet 2026-10-08 (owner): RM_Thavrik, RM_Lommerel, RM_Nemmel, RM_Gorrameth CUT from this roster ("no longer needed" / "cut no longer needed"); scoped to the Fever Wood only, defs kept. -->
    </wildAnimals>
    <coastalWildAnimals />
    <!-- FEVERWOOD_FLORA_ROSTER_1: the 3 AB_* donor placeholder rows
         (AB_KeeningCordax/AB_Iashiphus/AB_Gomphoeria, sarg.alphabiomes) are
         CUT here per the roster doc's own §6 disposition table — they were
         placeholders to replace, not a base to extend (AB_KeeningCordax's
         own roster note called it "an interim single-tile body for the
         tower-trunks"). Replaced by the 18 RM_-tier invented rows below
         (design/Jawa/worldbuilding/biomes/fever_wood_flora_roster_2026-09-23.md),
         defs in RM_FeverWoodFlora.xml. RM_GiantLeaf is untouched — it was
         already RM_-tier invented content, never one of the donor rows this
         roster replaces. The 3 genuine canon Star Wars rows
         (Plant_HydenockTree_Wild/Plant_JoganTree_Wild/Plant_Chakroot_Wild)
         stay on the Utinni patch layer (WildAnimals_FeverWood.xml, Q11a),
         kept at their existing low commonality as additive flavour —
         untouched by this change.

         🔴 Commonalities are ENGINEERING DEFAULTS, not owner-set values —
         the roster doc's own §8 says every number is "a slot, not a value."
         Ordered by height group per the roster's "at a glance" table. -->
    <wildPlants>
      <RM_GiantLeaf>0.8</RM_GiantLeaf>  <!-- giant leaf -->

      <!-- the giants (towers) — rare, huge-canvas flavour, matches the
           1~2 boles per map RM_LivingBoleBiomeExtension already spawns -->
      <RM_Thulvane>0.05</RM_Thulvane>  <!-- thulvane - colossal fused column -->
      <RM_Varnoth>0.03</RM_Varnoth>  <!-- varnoth - stilt-tripod in the pool -->

      <!-- the crown (on bough-soil, fertilityMin 1.0) -->
      <RM_Plennith>0.9</RM_Plennith>  <!-- plennith - makes the bough-soil -->
      <RM_Ossagrel>0.5</RM_Ossagrel>  <!-- ossagrel - sap-sucker host cane -->
      <RM_Cistrel>0.3</RM_Cistrel>  <!-- cistrel - the only safe water -->
      <RM_Maulith>0.3</RM_Maulith>  <!-- maulith - hanging curtain, privacy screen -->
      <RM_Verrow>0.6</RM_Verrow>  <!-- verrow - the crown's fruit -->
      <RM_Nubrith>0.25</RM_Nubrith>  <!-- nubrith - the only light -->
      <RM_Halquin>0.2</RM_Halquin>  <!-- halquin - the medicine -->
      <RM_Ammeth>0.35</RM_Ammeth>  <!-- ammeth - the roof panels -->

      <!-- the pool margin -->
      <RM_Claithe>0.3</RM_Claithe>  <!-- claithe - binds the potter's clay -->
      <RM_Corvath>0.05</RM_Corvath>  <!-- corvath - grows only where it has fed -->
      <RM_Sodderel>0.25</RM_Sodderel>  <!-- sodderel - the bog-timber -->
      <RM_Seepril>0.2</RM_Seepril>  <!-- seepril - sits in the oil -->

      <!-- the ground (thin, deliberately) -->
      <RM_Skimmel>0.4</RM_Skimmel>  <!-- skimmel - hides the sink-mud -->
      <RM_Wanlith>0.4</RM_Wanlith>  <!-- wanlith - the pale one -->
      <RM_Tullick>0.25</RM_Tullick>  <!-- tullick - the tuber -->
      <!-- Feverwood art sheet 2026-10-08 (owner): RM_Skethral CUT from this roster ("cut no longer needed"); scoped to the Fever Wood only, def kept. -->
    </wildPlants>
    <wildPlantRegrowDays>15</wildPlantRegrowDays>
  </BiomeDef>

</Defs>
