<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_LumbrelTree - PLANT_TIERS_RECONCILE_MOST_ARE_BAROQUE (owner 2026-10-16: "Star Wars will have a very few canon plants, and those can just be reskins of non-canon versions we create in the Baroque Biomes"; by card "Invent 7 new Baroque bases").
  Invented, franchise-free base whose growth, harvest and stats are copied 1:1 from the canon RSW_Plant_JoganTree_Wild
  (SWBestiary RSW_DonorPack_P1_Plants.xml), which is now a pure reskin of this def (ParentName="RM_LumbrelTree").
  Home: RM_FeverWood. ART: own folder Things/Plant/RM_LumbrelTree, empty until the base art is ruled and installed (raw item keeps a vanilla placeholder).
-->
<Defs>

  <ThingDef ParentName="TreeBase" Name="RM_LumbrelTree">
    <defName>RM_LumbrelTree</defName>
    <label>wild lumbrel tree</label>
    <description>A broad, umbrella-crowned tree with smooth grey-green bark and dense dark foliage, hung underneath with clusters of pale gold, teardrop fruit. The fruit is sweet and crisp, and people who find a stand of lumbrels tend to come back for it.</description>
    <graphicData>
      <!-- own texPath; folder empty until the owner rules the base-art sheet (pink until then) -->
      <texPath>Things/RM_LumbrelTree/RM_LumbrelTree</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <shadowData>
        <volume>(0.15, 0.3, 0.15)</volume>
        <offset>(0,0,-0.38)</offset>
      </shadowData>
    </graphicData>
    <selectable>true</selectable>
    <neverMultiSelect>false</neverMultiSelect>
    <statBases>
      <Beauty>10</Beauty>
      <BeautyOutdoors>10</BeautyOutdoors>
      <Nutrition>1.5</Nutrition>
    </statBases>
    <minifiedDef>MinifiedTree</minifiedDef>
    <ingestible />
    <plant>
      <wildClusterRadius>5</wildClusterRadius>
      <wildClusterWeight>150</wildClusterWeight>
      <sowTags Inherit="False" />
      <sowResearchPrerequisites Inherit="False" />
      <fertilitySensitivity>0.8</fertilitySensitivity>
      <dieIfLeafless>true</dieIfLeafless>
      <growDays>10</growDays>
      <visualSizeRange>5~8</visualSizeRange>
      <topWindExposure>0.15</topWindExposure>
      <mustBeWildToSow>false</mustBeWildToSow>
      <immatureGraphicPath>Things/Plant/RM_LumbrelTree</immatureGraphicPath>
      <harvestWork>280</harvestWork>
      <harvestTag>Standard</harvestTag>
      <forceIsTree>true</forceIsTree>
      <harvestYield>40</harvestYield>
      <harvestedThingDef>RM_RawLumbrelFruit</harvestedThingDef>
      <harvestFailable>true</harvestFailable>
      <harvestAfterGrowth>0.30</harvestAfterGrowth>
    </plant>
  </ThingDef>

  <ThoughtDef>
    <defName>RM_AteLumbrelFruit</defName>
    <durationDays>1</durationDays>
    <stages>
      <li>
        <label>ate lumbrel fruit</label>
        <description>Sweet and crisp - that was lumbrel fruit.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThingDef ParentName="PlantFoodRawBase" Name="RM_RawLumbrelFruit">
    <defName>RM_RawLumbrelFruit</defName>
    <label>lumbrel fruit</label>
    <description>Raw lumbrel fruit. A pale gold teardrop fruit, wanted for its sweet, crisp flesh.</description>
    <possessionCount>10</possessionCount>
    <graphicData>
      <!-- TEMP placeholder (vanilla) -->
      <texPath>Things/Item/Resource/PlantFoodRaw/Berries</texPath>
    </graphicData>
    <statBases>
      <MarketValue>2.6</MarketValue>
    </statBases>
    <ingestible>
      <foodType>VegetableOrFruit</foodType>
      <tasteThought>RM_AteLumbrelFruit</tasteThought>
      <specialThoughtAsIngredient>RM_AteLumbrelFruit</specialThoughtAsIngredient>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>15</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
  </ThingDef>

</Defs>
