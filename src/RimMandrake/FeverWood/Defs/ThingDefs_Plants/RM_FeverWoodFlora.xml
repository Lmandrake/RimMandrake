      <harvestWork>300</harvestWork>
      <harvestedThingDef>RM_SeepOil</harvestedThingDef>
      <harvestTag>Standard</harvestTag>
      <visualSizeRange>0.7~1.0</visualSizeRange>
      <wildOrder>2</wildOrder>
      <wildClusterRadius>3</wildClusterRadius>
      <wildClusterWeight>10</wildClusterWeight>
      <purpose>None</purpose>
      <interferesWithRoof>false</interferesWithRoof>
    </plant>
  </ThingDef>

  <!-- RESOLVED 2026-09-23 (roster doc §4): RM_Seepril owns the seep-oils as a
       harvested plant resource, not a terrain feature and not
       LIQUID_TYPES_MOD_1 — that pointer in the frozen sheet's cross-flow
       ledger is superseded. Real LiquidDef/FlowWorks integration, if wanted
