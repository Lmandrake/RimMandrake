    </plant>
  </ThingDef>

  <ThingDef ParentName="PlantBase">
    <defName>RM_Seepril</defName>
    <label>seepril</label>
    <description>A low dull barrel of a stem sitting in its own iridescent slick, the rainbow film spreading a cell or two around its base. Leafless above; just the barrel and the sheen. The seep-oils gather around it — perfume, lubricant, fuel. Its rainbow is the planet's honest register: just oil, just useful.</description>
    <statBases>
      <MaxHitPoints>30</MaxHitPoints>
      <Flammability>0.7</Flammability>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/RM_Seepril/RM_Seepril_a</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <selectable>true</selectable>
    <pathCost>3</pathCost>
    <plant>
      <fertilityMin>0.2</fertilityMin>
      <fertilitySensitivity>0.2</fertilitySensitivity>
      <growDays>16</growDays>
