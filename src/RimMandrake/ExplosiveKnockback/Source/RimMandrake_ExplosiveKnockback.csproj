<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Explosive Knockback (design/RimMandrake/explosive_knockback_design_2026-10-06.md). Same recipe as
    ProximityHatch plus Harmony (reference only; brrainz.harmony provides it at runtime).
    EnableDefaultCompileItems is FALSE: a new .cs needs its own Compile line below, or it compiles into nothing.
    Build: python3 src/RimMandrake/Utils/winbuild.py src/RimMandrake/ExplosiveKnockback/Source/RimMandrake_ExplosiveKnockback.csproj
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrakeExplosiveKnockback</AssemblyName>
    <RootNamespace>RimMandrake.ExplosiveKnockback</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    Proof code (RM_KnockbackProof, RM_PatchApplierProbe, MapComponent.ProofSchedule, Compat.ForgetClosed/FillToSurface)
    compiles only under RM_PROOFS, so the release DLL (the one committed and deployed by default) has no proof type or
    bridge entry point. Opt IN, never out, as JawaBench does with JAWA_GM_TOOLS:
      python3 src/RimMandrake/Utils/winbuild.py ExplosiveKnockback, then a double dash, then -p:RmProofs=true
    That overwrites Assemblies/ in the clone: never commit it (selftest_explosiveknockback_proofgate.py refuses a
    committed DLL that carries a proof type); rebuild without the flag after the live proof.
  -->
  <PropertyGroup>
    <RmProofs Condition="'$(RmProofs)' == ''">false</RmProofs>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RmProofs)' == 'true'">
    <DefineConstants>$(DefineConstants);RM_PROOFS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HarmonyDll)' == ''">
    <HarmonyDll>C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\2009463077\Current\Assemblies\0Harmony.dll</HarmonyDll>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\_Shared\HarmonyResilience\PatchApplier.cs" Link="Shared\PatchApplier.cs" />
    <Compile Include="RM_KnockbackMath.cs" />
    <Compile Include="RM_KnockbackMod.cs" />
    <Compile Include="..\..\_Shared\SettingsKit\SettingsKitCore.cs" Link="Shared\SettingsKitCore.cs" />
    <Compile Include="..\..\_Shared\SettingsKit\SettingsKitDrawer.cs" Link="Shared\SettingsKitDrawer.cs" />
    <Compile Include="RM_KnockbackCompat.cs" />
    <Compile Include="RM_Patch_DamageWorker_ExplosionKnockback.cs" />
    <Compile Include="RM_MapComponent_Knockback.cs" />
    <Compile Include="RM_ThingFlyer_Knockback.cs" />
    <Compile Include="RM_PawnFlyerPatches.cs" />
    <Compile Include="RM_KnockbackProof.cs" />
    <Compile Include="RM_PatchApplierProbe.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
