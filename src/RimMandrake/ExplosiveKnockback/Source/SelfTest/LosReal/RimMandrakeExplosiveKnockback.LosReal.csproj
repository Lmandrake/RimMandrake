<Project Sdk="Microsoft.NET.Sdk">
  <!-- The situation map with its sight lines witnessed by the game's own GenSight.LineOfSight (LosRealWitness.cs).
       Links the game's Assembly-CSharp; no Unity player. Run: python3 src/RimMandrake/ExplosiveKnockback/selftest_explosiveknockback_los_real.py -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <NoWarn>MSB3277;CS0618;CS0436</NoWarn>
    <AssemblyName>RimMandrakeExplosiveKnockback.LosReal</AssemblyName>
    <StartupObject>LosRealWitness</StartupObject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <DefineConstants>$(DefineConstants);RM_KB_SELFTEST</DefineConstants>
    <RimWorldManaged Condition="'$(RimWorldManaged)'==''">D:\SteamLibrary\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\RM_KnockbackMath.cs" />
    <Compile Include="..\..\RM_KnockbackPlan.cs" />
    <Compile Include="..\..\RM_KnockbackVerdicts.cs" />
    <Compile Include="..\KnockbackFuzz.cs" />
    <Compile Include="..\KnockbackSweep.cs" />
    <Compile Include="..\KnockbackMap.cs" />
    <Compile Include="..\Program.cs" />
    <Compile Include="LosRealWitness.cs" />
  </ItemGroup>
</Project>
