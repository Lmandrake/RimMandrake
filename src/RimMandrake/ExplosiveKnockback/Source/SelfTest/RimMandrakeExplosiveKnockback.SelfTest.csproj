<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline kernel selftest (design 8.1). Compiles the PRODUCTION RM_KnockbackMath.cs; no RimWorld refs.
       Run: python3 src/RimMandrake/ExplosiveKnockback/selftest_explosiveknockback_kernel.py -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>RimMandrakeExplosiveKnockback.SelfTest</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\RM_KnockbackMath.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
