<?xml version="1.0" encoding="utf-8"?>
<!-- Design 3.1: Bomb throws (force 1.0; BombSuper inherits it from its Name="Bomb" parent). Fire and incendiary
     (Flame, and Anomaly's ElectricalBurn through ParentName) throw at half strength (RIMMANDRAKE_THROW_ALL_HARMFUL_BLASTS,
     owner card 2026-11-11 d_c_which_blasts). EMP, smoke, firefoam and tox gas carry an explicit 0; Stun is harmsHealth
     false, so the unpatched default never reaches it. success=Always: ToxGas is Biotech's. -->
<Patch>
  <Operation Class="PatchOperationAddModExtension">
    <success>Always</success>
    <xpath>Defs/DamageDef[defName="Bomb"]</xpath>
    <value>
      <li Class="RimMandrake.ExplosiveKnockback.RM_KnockbackExtension"><force>1.0</force></li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <success>Always</success>
    <xpath>Defs/DamageDef[defName="Flame"]</xpath>
    <value>
      <li Class="RimMandrake.ExplosiveKnockback.RM_KnockbackExtension"><force>0.5</force></li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <success>Always</success>
    <xpath>Defs/DamageDef[defName="EMP"]</xpath>
    <value>
      <li Class="RimMandrake.ExplosiveKnockback.RM_KnockbackExtension"><force>0</force></li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <success>Always</success>
    <xpath>Defs/DamageDef[defName="Smoke"]</xpath>
    <value>
      <li Class="RimMandrake.ExplosiveKnockback.RM_KnockbackExtension"><force>0</force></li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <success>Always</success>
    <xpath>Defs/DamageDef[defName="Extinguish"]</xpath>
    <value>
      <li Class="RimMandrake.ExplosiveKnockback.RM_KnockbackExtension"><force>0</force></li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <success>Always</success>
    <xpath>Defs/DamageDef[defName="ToxGas"]</xpath>
    <value>
      <li Class="RimMandrake.ExplosiveKnockback.RM_KnockbackExtension"><force>0</force></li>
    </value>
  </Operation>
</Patch>
