<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline unit harness for map awareness (THING_LOOKUP_BUILD_OWNER_IS_NOT_PAINTER,
    INCIDENT_JOURNAL_BUILD_CALLED_IS_NOT_FIRED, PAWN_ORIGIN_BUILD_SAY_ORIGIN_UNKNOWN). Plain net8.0, zero
    RimWorld/Unity references: ..\JawaBench.BridgeTools\JawaBenchAwarenessCore.cs is the PRODUCTION file the
    companion compiles, pulled in directly - a `using Verse;` landing in it breaks this build, which is the
    guard rail. Lives BESIDE the companion folder, never inside it.
    Run: python3 src/RimMandrake/Utils/selftest_map_awareness_core.py
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>AwarenessSelfTest</AssemblyName>
    <RootNamespace>JawaBench.BridgeTools</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchAwarenessCore.cs" />
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchTpsMath.cs" />
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchTpsSettings.cs" />
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchSafetyCore.cs" />
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchVitalsCore.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="UnitsSafety.cs" />
    <Compile Include="UnitsVitals.cs" />
  </ItemGroup>

</Project>
