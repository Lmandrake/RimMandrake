<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline harness for the mods' test hooks (RIMMANDRAKE_BUILD_MOD_TRACE_AND_RESET_HOOKS_BY_REFLECTION): the PRODUCTION cores (or
    planted copies, -p:CoreDir=), net8.0, no RimWorld, and seven net472 fixture mods built with the SHIPPED hooks file (or a planted
    copy, -p:HooksFile=). Run: python3 src/RimMandrake/bridgetools/selftest_test_hooks.py
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>TestHooksSelfTest</AssemblyName>
    <RootNamespace>JawaBench.BridgeTools</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CoreDir Condition="'$(CoreDir)' == ''">..\JawaBench.BridgeTools\</CoreDir>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchCondCore.cs" />
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchRunLockCore.cs" />
    <Compile Include="$(CoreDir)JawaBenchSceneTickCore.cs" />
    <Compile Include="$(CoreDir)JawaBenchModHooksCore.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

  <!-- built with the harness, never referenced by it: the harness loads them by path, as the game loads a mod -->
  <ItemGroup>
    <ProjectReference Include="Fixtures\A\RimMandrake.HookFixtureA.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="Fixtures\B\RimMandrake.HookFixtureB.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="Fixtures\None\RimMandrake.HookFixtureNone.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="Fixtures\Wrong\RimMandrake.HookFixtureWrong.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="Fixtures\Proof\RimMandrake.HookFixtureProof.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="Fixtures\Const\RimMandrake.HookFixtureConst.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="Fixtures\Leak\RimMandrake.HookFixtureLeak.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

</Project>
