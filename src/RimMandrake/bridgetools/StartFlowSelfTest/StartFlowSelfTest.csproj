<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline unit harness for the new-game start-flow decisions (scenario name matching, .rid path
    resolution, start-tile candidate choice). Plain net8.0, zero RimWorld/Unity references:
    ..\JawaBench.BridgeTools\JawaBenchStartFlowCore.cs is the PRODUCTION file the companion compiles,
    pulled in directly - a `using Verse;` landing in it breaks this build, which is the guard rail.
    Lives BESIDE the companion folder, never inside it.
    Run: python3 src/RimMandrake/Utils/selftest_start_flow_core.py
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>StartFlowSelfTest</AssemblyName>
    <RootNamespace>JawaBench.BridgeTools</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchStartFlowCore.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
