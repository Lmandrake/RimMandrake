<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline harness for the four wreck reads (RIMMANDRAKE_SCRIPT_WRECKED_MACHINES_SCENES_EVERY_REPAIR_A_FOIL): the PRODUCTION core
    (or planted copies, -p:CoreDir=), net8.0, no RimWorld. Run: python3 src/RimMandrake/bridgetools/selftest_wreck_reads.py
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>WreckReadsSelfTest</AssemblyName>
    <RootNamespace>JawaBench.BridgeTools</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CoreDir Condition="'$(CoreDir)' == ''">..\JawaBench.BridgeTools\</CoreDir>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(CoreDir)JawaBenchWreckReadsCore.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
