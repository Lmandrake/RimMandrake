<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline twin harness for the bridge condition evaluator (CONDCORE_BUILD_THREE_VALUED_TREES). Plain net8.0, zero
    RimWorld/Unity references: ..\JawaBench.BridgeTools\JawaBenchCondCore.cs is the PRODUCTION file the companion
    compiles, pulled in directly - a `using Verse;` landing in it breaks this build, which is the guard rail. Lives
    BESIDE the companion folder, never inside it: the companion csproj compiles every .cs under its own folder.
    Reads the vectors JSON on stdin, prints one "name<TAB>result" line per vector.
    Run: python3 src/RimMandrake/Utils/selftest_conds_vectors.py
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>CondSelfTest</AssemblyName>
    <RootNamespace>JawaBench.BridgeTools</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchCondCore.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
