<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline harness for jawa/alloc_probe's Verse-free core (MONO_ALLOC_MEASURE_PER_TICK_ON_GAME): the PRODUCTION
    JawaBenchAllocCore.cs arrives as $(CoreFile), a copy the runner writes outside the clone, so a mutant changes text,
    never a tree file. Lives BESIDE the companion folder: the companion csproj compiles every .cs under its own folder.
    Run: python3 src/RimMandrake/Utils/selftest_alloc_probe.py
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>AllocProbeSelfTest</AssemblyName>
    <RootNamespace>JawaBench.BridgeTools</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(CoreFile)" Condition="'$(CoreFile)' != ''" />
  </ItemGroup>

</Project>
