<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline harness for the scene gates (incident, quest, mental) and the incident queue hold of BRIDGE v2.0
    (RIMMANDRAKE_BUILD_INCIDENT_QUEST_MENTAL_GATES_BEFORE_CERTIFICATE): the PRODUCTION cores (or a planted copy of the gates core,
    -p:CoreDir=), net8.0, no RimWorld. Run: python3 src/RimMandrake/bridgetools/selftest_scene_gates.py
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>GatesSelfTest</AssemblyName>
    <RootNamespace>JawaBench.BridgeTools</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CoreDir Condition="'$(CoreDir)' == ''">..\JawaBench.BridgeTools\</CoreDir>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchCondCore.cs" />
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchRunLockCore.cs" />
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchSceneTickCore.cs" />
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchHookGuard.cs" />
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchTpsMath.cs" />
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchCastCore.cs" />
    <Compile Include="$(CoreDir)JawaBenchGatesCore.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
