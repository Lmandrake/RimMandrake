<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline harness for the life cycle of a run (RIMMANDRAKE_HARDEN_RUN_LIFE_CYCLE_KILL_CANCEL_THROWN_TICK): the PRODUCTION cores
    (or planted copies, -p:CoreDir=), net8.0, no RimWorld. Run: python3 src/RimMandrake/bridgetools/selftest_run_life_cycle.py
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RunLifeCycleSelfTest</AssemblyName>
    <RootNamespace>JawaBench.BridgeTools</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CoreDir Condition="'$(CoreDir)' == ''">..\JawaBench.BridgeTools\</CoreDir>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(CoreDir)JawaBenchCondCore.cs" />
    <Compile Include="$(CoreDir)JawaBenchRunLockCore.cs" />
    <Compile Include="$(CoreDir)JawaBenchSceneTickCore.cs" />
    <Compile Include="$(CoreDir)JawaBenchPathCore.cs" />
    <Compile Include="$(CoreDir)JawaBenchHandsCore.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
