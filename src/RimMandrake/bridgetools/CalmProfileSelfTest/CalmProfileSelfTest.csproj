<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline harness for the calm profile of BRIDGE v2.0 (RIMMANDRAKE_BUILD_CALM_PROFILE_BREACH_LOG_AND_LEASE):
    the PRODUCTION cores (or a planted copy of the calm profile core,
    -p:CoreDir=), net8.0, no RimWorld. Run: python3 src/RimMandrake/bridgetools/selftest_calm_profile.py
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>CalmProfileSelfTest</AssemblyName>
    <RootNamespace>JawaBench.BridgeTools</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CoreDir Condition="'$(CoreDir)' == ''">..\JawaBench.BridgeTools\</CoreDir>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchCondCore.cs" />
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchRunLockCore.cs" />
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchSceneTickCore.cs" />
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchHookGuard.cs" />
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchTpsMath.cs" />
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchCastCore.cs" />
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchGatesCore.cs" />
    <Compile Include="$(CoreDir)JawaBenchCalmProfileCore.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
