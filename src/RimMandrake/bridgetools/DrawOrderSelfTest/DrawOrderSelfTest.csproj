<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline harness for the draw-order readings (RIMMANDRAKE_DRAW_SCRAPPER_JETTIES_HEAVY_BRIDGE_IN_HIS_PICKED_MANNER): the
    PRODUCTION core (or planted copies, -p:CoreDir=), net8.0, no RimWorld. Run: python3 src/RimMandrake/bridgetools/selftest_draw_order.py
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>DrawOrderSelfTest</AssemblyName>
    <RootNamespace>JawaBench.BridgeTools</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CoreDir Condition="'$(CoreDir)' == ''">..\JawaBench.BridgeTools\</CoreDir>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(CoreDir)JawaBenchDrawOrderCore.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
