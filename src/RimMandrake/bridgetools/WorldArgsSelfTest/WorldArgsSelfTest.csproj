<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline unit harness for the world-tool argument parsing (tile-id lists and ranges clamped to the grid,
    object-id lists, the finite-number check). Plain net8.0, zero RimWorld/Unity references:
    ..\JawaBench.BridgeTools\JawaBenchWorldArgsCore.cs is the PRODUCTION file the companion compiles,
    pulled in directly - a `using Verse;` landing in it breaks this build, which is the guard rail.
    Lives BESIDE the companion folder, never inside it.
    Run: python3 src/RimMandrake/Utils/selftest_world_args_core.py
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>WorldArgsSelfTest</AssemblyName>
    <RootNamespace>JawaBench.BridgeTools</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchWorldArgsCore.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
