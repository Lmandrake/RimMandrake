<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline unit harness for jawa/run_scenes' pure half (RIMMANDRAKE_BUILD_SHARED_SCENE_RUNNER_FIRST_SLICE). Plain net8.0,
    zero RimWorld/Unity references: ..\JawaBench.BridgeTools\JawaBenchSceneRunnerCore.cs is the PRODUCTION file the
    companion compiles and ..\..\_Shared\SceneRunner\RMTestAttribute.cs the PRODUCTION attribute a mod's proof build
    compiles (RM_PROOFS defined here), both pulled in directly - a `using Verse;` landing in either breaks this build.
    Run: python3 src/RimMandrake/Utils/selftest_scene_runner_core.py
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>SceneRunnerSelfTest</AssemblyName>
    <RootNamespace>JawaBench.BridgeTools</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);RM_PROOFS</DefineConstants>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchSceneRunnerCore.cs" />
    <Compile Include="..\..\_Shared\SceneRunner\RMTestAttribute.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
