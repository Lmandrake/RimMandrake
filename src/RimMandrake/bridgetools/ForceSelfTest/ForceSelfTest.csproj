<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline harness for the order through the giver, the motive and the force record of BRIDGE v2.0
    (RIMMANDRAKE_BUILD_CAST_ASSERTS_AND_ORDER_THROUGH_GIVER): the PRODUCTION core (or a planted copy,
    -p:CoreDir=), net8.0, no RimWorld. Run: python3 src/RimMandrake/bridgetools/selftest_scene_force.py
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>ForceSelfTest</AssemblyName>
    <RootNamespace>JawaBench.BridgeTools</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CoreDir Condition="'$(CoreDir)' == ''">..\JawaBench.BridgeTools\</CoreDir>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(CoreDir)JawaBenchForceCore.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
