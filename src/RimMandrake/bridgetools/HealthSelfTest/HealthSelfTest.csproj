<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline unit harness for the game-health metrics (game_health_record.md: tps.frame-hist, tps.log-counts,
    tps.bridge-occupancy, tps.capability-inventory, opt.profiler incl. the merged opt.own-counters, spike.gc-timing).
    Plain net8.0, zero RimWorld/Unity references: ..\JawaBench.BridgeTools\JawaBenchHealthCore.cs is the PRODUCTION
    file the companion compiles, pulled in directly - a `using Verse;` landing in it breaks this build, which is the
    guard rail. Lives BESIDE the companion folder, never inside it.
    Run: python3 src/RimMandrake/Utils/selftest_health_core.py
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>HealthSelfTest</AssemblyName>
    <RootNamespace>JawaBench.BridgeTools</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchHealthCore.cs" />
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchTpsMath.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
