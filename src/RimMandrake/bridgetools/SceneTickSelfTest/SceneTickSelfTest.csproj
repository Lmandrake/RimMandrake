<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline harness for the scene run stepped in the tick (RIMMANDRAKE_WIRE_COND_RUN_INTO_TICK_BUILT_NEVER_JOINED): the
    PRODUCTION JawaBenchSceneTickCore.cs (or a planted copy, -p:CoreFile=) and JawaBenchCondCore.cs, net8.0, no RimWorld.
    Run: python3 src/RimMandrake/bridgetools/selftest_scene_tick_wiring.py
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>SceneTickSelfTest</AssemblyName>
    <RootNamespace>JawaBench.BridgeTools</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchCondCore.cs" />
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchRunLockCore.cs" />
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchSceneTickCore.cs" Condition="'$(CoreFile)' == ''" />
    <Compile Include="$(CoreFile)" Condition="'$(CoreFile)' != ''" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
