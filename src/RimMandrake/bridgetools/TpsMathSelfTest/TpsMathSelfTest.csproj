<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline parity harness for the TPS record maths (BRIDGE_TPS_REGULAR_REPORT_1). Plain net8.0, zero
    RimWorld/Unity references: ..\JawaBench.BridgeTools\JawaBenchTpsMath.cs is the PRODUCTION file the
    companion compiles, pulled in directly - a `using Verse;` landing in it breaks this build, which is
    the guard rail working. Lives BESIDE the companion folder, never inside it: the companion csproj
    compiles every .cs under its own folder.
    Run: python3 src/RimMandrake/Utils/selftest_tps_record.py
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>TpsMathSelfTest</AssemblyName>
    <RootNamespace>JawaBench.BridgeTools</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchTpsMath.cs" />
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchTpsWriter.cs" />
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchTpsWatchdog.cs" />
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchTpsStages.cs" />
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchTpsLifecycle.cs" />
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchTpsSettings.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="Units*.cs" />
  </ItemGroup>

</Project>
