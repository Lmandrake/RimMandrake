<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline harness for the hands of BRIDGE v2.0 (RIMMANDRAKE_WIDEN_SLICE_INTO_RUN_UNTIL_AND_ACT_BATCH): the PRODUCTION cores
    (or planted copies, -p:CoreDir=), net8.0, no RimWorld. Run: python3 src/RimMandrake/bridgetools/selftest_run_until.py
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RunUntilSelfTest</AssemblyName>
    <RootNamespace>JawaBench.BridgeTools</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CoreDir Condition="'$(CoreDir)' == ''">..\JawaBench.BridgeTools\</CoreDir>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(CoreDir)JawaBenchCondCore.cs" />
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchRunLockCore.cs" />
    <Compile Include="$(CoreDir)JawaBenchSceneTickCore.cs" />
    <Compile Include="$(CoreDir)JawaBenchPathCore.cs" />
    <Compile Include="$(CoreDir)JawaBenchHandsCore.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
