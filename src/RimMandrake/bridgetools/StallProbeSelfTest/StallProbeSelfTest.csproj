<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline harness for the stall probe's "top job" read (BRIDGE_STALL_DIAGNOSTIC_1). Plain net8.0 with STUB Verse and
    HarmonyLib types (Stubs.cs): the PRODUCTION JawaBenchStallProbe.cs is compiled whole against them, and the two
    probe lines of JawaBenchTpsProfiler.cs (TlPre's Enter, TlFin's body) are cut from its text into a generated seam.
    Both arrive as files the runner writes outside the clone ($(ProbeFile), $(SeamFile)), so a mutant changes text,
    never a tree file. Lives BESIDE the companion folder: the companion csproj compiles every .cs under its own folder.
    Run: python3 src/RimMandrake/Utils/selftest_stall_probe.py
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>StallProbeSelfTest</AssemblyName>
    <RootNamespace>JawaBench.BridgeTools</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\JawaBench.BridgeTools\JawaBenchTpsMath.cs" />
    <Compile Include="Stubs.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="$(ProbeFile)" Condition="'$(ProbeFile)' != ''" />
    <Compile Include="$(SeamFile)" Condition="'$(SeamFile)' != ''" />
  </ItemGroup>

</Project>
