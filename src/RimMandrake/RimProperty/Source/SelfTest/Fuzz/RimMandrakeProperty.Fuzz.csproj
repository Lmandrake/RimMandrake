<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RimProperty offline fuzz, Approach B (same shape as KeelHoist/ExplosiveGrowth). Plain net8.0, zero RimWorld/Unity
    references: ../../Kernel/*.cs are the PRODUCTION files the mod compiles, pulled in directly. A `using Verse;` landing
    in one of them breaks this build - that is the guard rail working. This is NOT the older net472 selftest in ../
    (RimMandrakeProperty.SelfTest.csproj: ClaimantRef equality against the game DLLs); the two do not share files.
    Run (builds on Windows via winbuild staging, then runs the exe):
      python3 src/RimMandrake/Utils/selftest_property_fuzz.py [fuzz knobs]
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RimMandrakeProperty.Fuzz</AssemblyName>
    <RootNamespace>RimMandrake.Property.Fuzz</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Kernel\RM_PropertyKernel.cs" />
    <Compile Include="PropertyFuzz.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
