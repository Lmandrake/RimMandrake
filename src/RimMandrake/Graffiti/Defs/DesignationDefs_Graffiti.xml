<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- GRAFFITI_PUNK_IDEOLIGION_SCOPE_1 mechanism 4's Designator placer:
       marks a wall cell for a colonist to paint on, same shape as vanilla's
       own cell designations (Mine, PlantsHarvest). Reuses a vanilla UI icon
       (UI/Designators/Mine) rather than owing new UI art for a tiny gizmo
       glyph - Designator_PaintGraffitiMark.cs's own icon (shown on the
       gizmo button itself) is RM_Graffiti_Vandal's own texture instead. -->
  <DesignationDef>
    <defName>RM_PaintGraffitiHere</defName>
    <texturePath>UI/Designators/Mine</texturePath>
    <targetType>Cell</targetType>
  </DesignationDef>

  <!-- Design 1.7, fork F7: "a scrub designator overrides" the protection own-colony and devotional marks have from the cleaning rounds
       (Designator_ScrubGraffiti, WorkGiver_ScrubGraffitiDesignated). Vanilla's own remove-paint overlay: it is paint coming off. -->
  <DesignationDef>
    <defName>RM_ScrubGraffiti</defName>
    <texturePath>Designations/RemovePaint</texturePath>
    <targetType>Thing</targetType>
  </DesignationDef>

</Defs>
