    <label>warning glyph</label>
    <description>A settler's warning daubed on the wall for whoever reads it next.</description>
    <graphicData>
      <graphicClass>Graphic_Random</graphicClass>
      <texPath>Things/Filth/Art/RM_Graffiti_WarningGlyph</texPath>
      <drawSize>(1.2, 1)</drawSize>
      <shaderType>Mote</shaderType>
    </graphicData>
    <statBases>
      <Beauty>-6</Beauty>
      <Cleanliness>-3</Cleanliness>
    </statBases>
    <!-- design/RM_GRAFFITI_SCOPE_WIDENING.md §2.2 (fork F10, ruled
         2026-10-09): the three shipped marks are the Glyph-form / Code-category
         default members, and WarningGlyph is this engine's one generic
         taunt-funnel example - breachLure reads
         through BreachBiasHook.cs with zero new content. -->
    <modExtensions>
      <li Class="RimMandrake.Graffiti.ModExtension_Graffiti">
        <category>Code</category>
        <form>Glyph</form>
        <poolWeight>1</poolWeight>
        <designatorEligible>true</designatorEligible>
        <breachLure>true</breachLure>
      </li>
    </modExtensions>
  </ThingDef>

