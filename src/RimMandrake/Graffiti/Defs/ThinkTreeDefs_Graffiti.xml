<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThinkTreeDef>
    <defName>RM_GraffitiPaintingSpreeThinkTree</defName>
    <insertTag>Humanlike_PostMentalState</insertTag>
    <insertPriority>1</insertPriority>
    <thinkRoot Class="ThinkNode_Priority">
      <subNodes>
        <li Class="ThinkNode_ConditionalMentalState">
          <state>RM_GraffitiPaintingSpreeState</state>
          <subNodes>
            <!-- Fixed 2026-09-02 (opus code review, re-review pass): food/rest
                 now come BEFORE the paint giver, matching vanilla's own
                 MentalStateNonCritical subtree order
                 (Data/Core/Defs/ThinkTreeDefs/SubTrees_Misc.xml). The
                 original order (byte-identical to the donor mod this was
                 ported from) let a spree pawn paint through the whole
                 25000-45000 tick duration instead of eating or sleeping. -->
            <li Class="ThinkNode_PrioritySorter">
              <subNodes>
                <li Class="JobGiver_GetFood">
                  <maxLevelPercentage>0.05</maxLevelPercentage>
                </li>
                <li Class="JobGiver_GetRest">
                  <maxLevelPercentage>0.15</maxLevelPercentage>
                </li>
              </subNodes>
            </li>
            <li Class="RimMandrake.Graffiti.JobGiver_GraffitiPaintingSpree" />
            <li Class="JobGiver_WanderColony" />
          </subNodes>
        </li>
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>

  <!-- A clean freak's fit (MentalState_GraffitiCompulsiveClean): food and rest first, then the nearest mark in the Home area, then a wander. -->
  <ThinkTreeDef>
    <defName>RM_GraffitiCompulsiveCleaningThinkTree</defName>
    <insertTag>Humanlike_PostMentalState</insertTag>
    <insertPriority>1</insertPriority>
    <thinkRoot Class="ThinkNode_Priority">
      <subNodes>
        <li Class="ThinkNode_ConditionalMentalState">
          <state>RM_GraffitiCompulsiveCleaningState</state>
          <subNodes>
            <li Class="ThinkNode_PrioritySorter">
              <subNodes>
                <li Class="JobGiver_GetFood">
                  <maxLevelPercentage>0.05</maxLevelPercentage>
                </li>
                <li Class="JobGiver_GetRest">
                  <maxLevelPercentage>0.15</maxLevelPercentage>
                </li>
              </subNodes>
            </li>
            <li Class="RimMandrake.Graffiti.JobGiver_GraffitiCompulsiveClean" />
            <li Class="JobGiver_WanderColony" />
          </subNodes>
        </li>
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>

  <!-- Somebody has something to answer on a wall: seen to at the next free moment (JobGiver_AnswerMark). -->
  <ThinkTreeDef>
    <defName>RM_GraffitiAnswerMarkThinkTree</defName>
    <insertTag>Humanlike_PreMain</insertTag>
    <insertPriority>1</insertPriority>
    <thinkRoot Class="ThinkNode_ConditionalColonist">
      <subNodes>
        <li Class="RimMandrake.Graffiti.JobGiver_AnswerMark" />
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>

  <!-- An idle hand tags the wall (JobGiver_IdleTag): after work, before the idle wander. -->
  <ThinkTreeDef>
    <defName>RM_GraffitiIdleTagThinkTree</defName>
    <insertTag>Humanlike_PostMain</insertTag>
    <insertPriority>1</insertPriority>
    <thinkRoot Class="ThinkNode_ConditionalColonist">
      <subNodes>
        <li Class="ThinkNode_Tagger">
          <tagToGive>Idle</tagToGive>
          <subNodes>
            <li Class="RimMandrake.Graffiti.JobGiver_IdleTag" />
          </subNodes>
        </li>
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>

</Defs>
