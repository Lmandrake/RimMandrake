    <defName>RM_Graffiti_Humiliated</defName>
    <durationDays>3</durationDays>
    <stackLimit>2</stackLimit>
    <stages>
      <li>
        <label>mocked on the wall by {0}</label>
        <description>{0} painted me up there, for everyone to read. Everyone has read it.</description>
        <baseMoodEffect>-8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RM_Graffiti_PaintedMe</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>20</durationDays>
    <stackLimit>100</stackLimit>
    <stackLimitForSameOtherPawn>3</stackLimitForSameOtherPawn>
    <stackedEffectMultiplier>0.8</stackedEffectMultiplier>
    <stages>
      <li>
        <label>painted me on the wall</label>
        <baseOpinionOffset>-30</baseOpinionOffset>
