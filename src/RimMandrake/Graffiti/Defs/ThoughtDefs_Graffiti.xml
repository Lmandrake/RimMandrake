<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- GRAFFITI_V1_LIVE_PROOF_1 (criterion A5): the hostile-maker reaction the design names
       (design/RM_GRAFFITI_SCOPE_WIDENING.md, onViewHostileMaker: "your colonist sees a mark a hostile
       faction left (unease - the 'we were here')"). Every raidExitEligible mark points its
       onViewHostileMaker at this def, so a raid's departing tag unsettles the colonists who pass it.
       ThoughtWorker_ViewedGraffitiMark resolves the viewer's relation to the mark's maker and grants
       only this def when the maker's faction is hostile to the viewer's (and no closer relation wins). -->
  <ThoughtDef>
    <defName>RM_Graffiti_ViewedHostileMark</defName>
    <workerClass>RimMandrake.Graffiti.ThoughtWorker_ViewedGraffitiMark</workerClass>
    <stages>
      <li>
        <label>enemy graffiti nearby</label>
        <description>Someone hostile painted their mark here on the way out. They were here, they know the way, and they wanted us to know it.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Passing by: what's on the wall near you, while you're near it. Read through the relation-keyed slots on each mark. -->
  <ThoughtDef>
    <defName>RM_Graffiti_NearOwnSign</defName>
    <workerClass>RimMandrake.Graffiti.ThoughtWorker_ViewedGraffitiMark</workerClass>
    <stages>
      <li>
        <label>our sign nearby</label>
        <description>Our sign is on the wall here. Somebody here believes what I believe.</description>
        <baseMoodEffect>1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RM_Graffiti_NearForeignSign</defName>
    <workerClass>RimMandrake.Graffiti.ThoughtWorker_ViewedGraffitiMark</workerClass>
    <stages>
      <li>
        <label>foreign creed nearby</label>
        <description>Another creed's sign is on the wall here. I'd rather not have to look at it.</description>
        <baseMoodEffect>-1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RM_Graffiti_NearOurPiece</defName>
    <workerClass>RimMandrake.Graffiti.ThoughtWorker_ViewedGraffitiMark</workerClass>
    <stages>
      <li>
        <label>our wall piece nearby</label>
        <description>One of ours painted this. The place looks like somebody lives in it.</description>
        <baseMoodEffect>1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Territory: however far from the marks you are, you know they're there. -->
  <ThoughtDef>
    <defName>RM_Graffiti_EnemyClaim</defName>
    <workerClass>RimMandrake.Graffiti.ThoughtWorker_EnemyClaim</workerClass>
    <stages>
      <li>
        <label>enemy marks on our walls</label>
        <description>Their mark is still on our walls. Nobody has done anything about it.</description>
        <baseMoodEffect>-1</baseMoodEffect>
      </li>
      <li>
        <label>enemy marks all over our walls</label>
        <description>They've marked this place as theirs, again and again, and it's all still there.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
      <li>
        <label>they've claimed our walls</label>
        <description>Every wall I pass says this place belongs to them. Why does nobody clean it off?</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Reading a mark: a memory the moment someone reads it (GraffitiSocial.Apply), read again while the mark stands. Mood and opinion are separate defs, the game's own pattern. -->
