    <stages>
      <li>
        <label>enemy marks on our walls</label>
        <description>Their mark is still on our walls. Nobody has done anything about it.</description>
        <baseMoodEffect>-1</baseMoodEffect>
      </li>
      <li>
        <label>enemy marks all over our walls</label>
        <description>They've marked this place as theirs, again and again, and it's all still there.</description>
        <baseMoodEffect>-2</baseMoodEffect>
