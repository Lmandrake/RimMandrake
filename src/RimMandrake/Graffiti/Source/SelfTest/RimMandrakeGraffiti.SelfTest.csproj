<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Graffiti offline fuzz, Approach B. Plain net8.0, zero RimWorld/Unity references: ../Kernel/*.cs are the
    PRODUCTION files the mod compiles, pulled in directly. A `using Verse;` landing in one of them breaks this build -
    that is the guard rail working.
    Run (builds on Windows via winbuild staging, then runs the exe):
      python3 src/RimMandrake/Utils/selftest_graffiti_fuzz.py [fuzz knobs]
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RimMandrakeGraffiti.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.Graffiti.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Kernel\RM_GraffitiKernel.cs" />
    <Compile Include="..\GraffitiForm.cs" />
    <Compile Include="..\GraffitiCategory.cs" />
    <Compile Include="GraffitiFuzz.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
