<?xml version="1.0" encoding="utf-8"?>
<!-- FLAME_STATUES_MOD_BUILD_1 step 7, statue_mods_spec.md §2.3: with Vanilla Helixien Gas Expanded active, each flame
     statue takes a PipeSystem resource trader on VHGE_HelixienNet (the VHGE_GasSunLamp shape). RM_CompFlamePoints reads
     its ResourceOn and, while gas flows, refunds what the chemfuel tank burned. FindMod matches the mod NAME.
     consumptionPerTick values are PROVISIONAL (the sun lamp uses 1). -->
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Helixien Gas Expanded</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="RM_FlameStatue_Ember"]/comps</xpath>
          <value>
            <li Class="PipeSystem.CompProperties_ResourceTrader">
              <pipeNet>VHGE_HelixienNet</pipeNet>
              <consumptionPerTick>0.25</consumptionPerTick>
            </li>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="RM_FlameStatue_Dancer"]/comps</xpath>
          <value>
            <li Class="PipeSystem.CompProperties_ResourceTrader">
              <pipeNet>VHGE_HelixienNet</pipeNet>
              <consumptionPerTick>0.5</consumptionPerTick>
            </li>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="RM_FlameStatue_Colossus"]/comps</xpath>
          <value>
            <li Class="PipeSystem.CompProperties_ResourceTrader">
              <pipeNet>VHGE_HelixienNet</pipeNet>
              <consumptionPerTick>1</consumptionPerTick>
            </li>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
