<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_FlameStatues.xml        FlameStatues (mandrake.rm.flamestatues) — FLAME_STATUES_MOD_BUILD_1

  design/RimMandrake/statue_mods_spec.md §3 steps 4-5: three fuelled sculptures, each burning a SET of flames
  through RM_CompFlamePoints (vanilla Graphic_Flicker reads only the first fire-overlay comp, §2.2). Chemfuel
  only, no wood (ruling R4). Woody stuff dropped (§2.1).
  Statbases/footprints copy vanilla SculptureSmall / SculptureLarge / SculptureGrand (Buildings_Art.xml).

  Art: one PNG per def from artpipe rm_flamestatue_*_v3 (2026-10-10), shipped at half the authored canvas.
  Point offsets are MEASURED from those PNGs (spec §2.6): x = (px - 0.5) * drawSize, z = (0.5 - py) * drawSize,
  then lifted +0.25 * size so the flame stands on the vent. The colossus art carries its two lower vents in
  the fire-pit ring, not the palms, so its points follow the art. PROVISIONAL: fuel capacity, glow radius,
  flame sizes. Consumption is the spec's (Ember 0.12/day, Dancer 0.28, Colossus 0.5).
-->
<Defs>

  <ThingDef Name="RM_FlameStatueBase" ParentName="SculptureBase" Abstract="True">
    <tickerType>Normal</tickerType>   <!-- CompRefuelable burns fuel in CompTick -->
    <!-- BuildingBase is MapMeshOnly, and comp PostDraw (the flames) only runs for realtime drawers -->
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stuffCategories>
      <li>Stony</li>
      <li>Metallic</li>
    </stuffCategories>
    <recipeMaker>
      <useIngredientsForColor>true</useIngredientsForColor>
    </recipeMaker>
    <designationCategory>Furniture</designationCategory>
  </ThingDef>

  <ThingDef ParentName="RM_FlameStatueBase">
    <defName>RM_FlameStatue_Ember</defName>
    <label>ember idol</label>
    <description>A squat brazier-figure carved around a single crown vent. Fed with chemfuel, a flame stands on its head and lights the room; left dry, it is only a sculpture.</description>
    <graphicData>
      <texPath>Things/Building/Art/RM_FlameStatues/RM_FlameStatue_Ember</texPath>
      <drawSize>(1.5,1.5)</drawSize>
    </graphicData>
    <fillPercent>0.35</fillPercent>
    <costStuffCount>50</costStuffCount>
    <statBases>
      <MaxHitPoints>90</MaxHitPoints>
      <Mass>3</Mass>
      <Beauty>50</Beauty>
      <WorkToMake>18000</WorkToMake>
      <StyleDominance>10</StyleDominance>
    </statBases>
    <comps>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>0.12</fuelConsumptionRate>
        <fuelCapacity>5</fuelCapacity>
        <initialFuelPercent>0</initialFuelPercent>
        <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
        <initialConfigurableTargetFuelLevel>5</initialConfigurableTargetFuelLevel>
        <autoRefuelPercent>0.35</autoRefuelPercent>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <drawOutOfFuelOverlay>true</drawOutOfFuelOverlay>
        <fuelLabel>chemfuel</fuelLabel>
        <fuelGizmoLabel>Chemfuel</fuelGizmoLabel>
        <outOfFuelMessage>Ember idol out of fuel</outOfFuelMessage>
        <fuelFilter><thingDefs><li>Chemfuel</li></thingDefs></fuelFilter>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>4</glowRadius>
        <glowColor>(255,120,40,0)</glowColor>
        <colorPickerEnabled>false</colorPickerEnabled>
      </li>
      <li Class="RimMandrake.FlameStatues.RM_CompProperties_FlamePoints">
        <points>
          <li><offset>(0,0,0.60)</offset><size>0.35</size></li>   <!-- crown vent, measured (0.50,0.16) -->
        </points>
        <qualityScalingEnabled>true</qualityScalingEnabled>
        <fireGlowFleckIntervalTicks>90</fireGlowFleckIntervalTicks>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="RM_FlameStatueBase">
    <defName>RM_FlameStatue_Dancer</defName>
    <label>flame dancer</label>
    <description>A lithe abstract figure with arms raised and palms cupped upward as vents, a third vent in its crown. Fed with chemfuel, all three vents burn.</description>
    <graphicData>
      <texPath>Things/Building/Art/RM_FlameStatues/RM_FlameStatue_Dancer</texPath>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <fillPercent>0.5</fillPercent>
    <costStuffCount>100</costStuffCount>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <Mass>7</Mass>
      <Beauty>100</Beauty>
      <WorkToMake>30000</WorkToMake>
      <StyleDominance>20</StyleDominance>
    </statBases>
    <comps>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>0.28</fuelConsumptionRate>
        <fuelCapacity>10</fuelCapacity>
        <initialFuelPercent>0</initialFuelPercent>
        <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
        <initialConfigurableTargetFuelLevel>10</initialConfigurableTargetFuelLevel>
        <autoRefuelPercent>0.35</autoRefuelPercent>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <drawOutOfFuelOverlay>true</drawOutOfFuelOverlay>
        <fuelLabel>chemfuel</fuelLabel>
        <fuelGizmoLabel>Chemfuel</fuelGizmoLabel>
        <outOfFuelMessage>Flame dancer out of fuel</outOfFuelMessage>
        <fuelFilter><thingDefs><li>Chemfuel</li></thingDefs></fuelFilter>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>6</glowRadius>
        <glowColor>(255,120,40,0)</glowColor>
        <colorPickerEnabled>false</colorPickerEnabled>
      </li>
      <li Class="RimMandrake.FlameStatues.RM_CompProperties_FlamePoints">
        <points>
          <li><offset>(0.66,0,1.34)</offset><size>0.35</size></li>   <!-- right palm, measured (0.72,0.08) -->
          <li><offset>(-0.67,0,1.34)</offset><size>0.35</size></li>   <!-- left palm, measured (0.28,0.08) -->
          <li><offset>(0,0,1.27)</offset><size>0.55</size></li>   <!-- crown, measured (0.50,0.125) -->
        </points>
        <qualityScalingEnabled>true</qualityScalingEnabled>
        <fireGlowFleckIntervalTicks>90</fireGlowFleckIntervalTicks>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="RM_FlameStatueBase">
    <defName>RM_FlameStatue_Colossus</defName>
    <label>pyre colossus</label>
    <description>A seated giant on a carved fire-pit ring, palms up, with vents in its crown and shoulders. Fed with chemfuel, all five vents burn and light a wide room.</description>
    <size>(2,2)</size>
    <graphicData>
      <texPath>Things/Building/Art/RM_FlameStatues/RM_FlameStatue_Colossus</texPath>
      <drawSize>(4,4)</drawSize>
    </graphicData>
    <fillPercent>0.5</fillPercent>
    <costStuffCount>400</costStuffCount>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <Mass>28</Mass>
      <Beauty>400</Beauty>
      <WorkToMake>105000</WorkToMake>
      <StyleDominance>40</StyleDominance>
    </statBases>
    <comps>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>0.5</fuelConsumptionRate>
        <fuelCapacity>20</fuelCapacity>
        <initialFuelPercent>0</initialFuelPercent>
        <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
        <initialConfigurableTargetFuelLevel>20</initialConfigurableTargetFuelLevel>
        <autoRefuelPercent>0.35</autoRefuelPercent>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <drawOutOfFuelOverlay>true</drawOutOfFuelOverlay>
        <fuelLabel>chemfuel</fuelLabel>
        <fuelGizmoLabel>Chemfuel</fuelGizmoLabel>
        <outOfFuelMessage>Pyre colossus out of fuel</outOfFuelMessage>
        <fuelFilter><thingDefs><li>Chemfuel</li></thingDefs></fuelFilter>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>9</glowRadius>
        <glowColor>(255,120,40,0)</glowColor>
        <colorPickerEnabled>false</colorPickerEnabled>
      </li>
      <li Class="RimMandrake.FlameStatues.RM_CompProperties_FlamePoints">
        <points>
          <li><offset>(1.32,0,-0.95)</offset><size>0.45</size></li>   <!-- right fire-pit vent, measured (0.83,0.765) -->
          <li><offset>(-1.32,0,-0.95)</offset><size>0.45</size></li>   <!-- left fire-pit vent, measured (0.17,0.765) -->
          <li><offset>(0,0,2.03)</offset><size>0.7</size></li>   <!-- crown, measured (0.50,0.035) -->
          <li><offset>(0.72,0,1.17)</offset><size>0.35</size></li>   <!-- right shoulder vent, measured (0.68,0.23) -->
          <li><offset>(-0.72,0,1.17)</offset><size>0.35</size></li>   <!-- left shoulder vent, measured (0.32,0.23) -->
        </points>
        <qualityScalingEnabled>true</qualityScalingEnabled>
        <fireGlowFleckIntervalTicks>90</fireGlowFleckIntervalTicks>
      </li>
    </comps>
  </ThingDef>

</Defs>
