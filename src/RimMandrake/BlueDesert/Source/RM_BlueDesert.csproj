<Project Sdk="Microsoft.NET.Sdk">

  <!--
    BLUEDESERT_RM_MOD_BUILD_1. Same recipe as
    src/RimMandrake/Abyss/Source/RM_Abyss.csproj — copy that
    header if this one goes stale.

    NO HARMONY REFERENCE. Every mechanic here (plant/fauna detonation chains,
    cold-wax warm-reactivity, the krissek halo, the butane-gut ingestion
    penalty) is a vanilla extension point (ThingComp/HediffComp/CompEffecter/
    IngestionOutcomeDoer/DeathActionWorker), not an engine patch, so nothing
    here breaks on a game update that renames a method. About.xml carries no
    brrainz.harmony dependency either.

    workerClass on the BiomeDef stays the vanilla Core BiomeWorker_IceSheet
    (the twin never named a donor type), so this mod owes no
    RM_BiomeWorker_BlueDesert and no custom worker C# at all.

    Build (the dotnet is WINDOWS-NATIVE and cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\Rimworld\src\RimMandrake\BlueDesert\Source\RM_BlueDesert.csproj -c Release

    Output lands in ../Assemblies/, which is where RimWorld looks.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrake.BlueDesert</AssemblyName>
    <RootNamespace>RimMandrake.BlueDesert</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <!-- BLUEDESERT_MECHANICS_BUILD_1 §4: Mod Settings register a gate with the
       shared EnvironmentalHazards RM_MechanicGates registry (the Haze
       carrier condition's class lives there), so this compiles against that
       assembly and About.xml declares mandrake.rm.environmentalhazards.
       Same recipe as RM_LeaningScrub.csproj. -->
  <PropertyGroup Condition="'$(EnvironmentalHazardsDll)' == ''">
    <EnvironmentalHazardsDll>$(MSBuildThisFileDirectory)..\..\EnvironmentalHazards\Assemblies\RimMandrake.EnvironmentalHazards.dll</EnvironmentalHazardsDll>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="RM_BlueDesertMod.cs" />
    <Compile Include="RM_BlueDesertWeatherTable.cs" />
    <Compile Include="BlueDesertLife.cs" />
    <Compile Include="RM_VhaulkDetonation.cs" />
    <Compile Include="RM_BlueIceThaw.cs" />
    <Compile Include="RM_MurrekDrift.cs" />
    <Compile Include="RM_ColdSink.cs" />
    <Compile Include="RM_AblationSalvage.cs" />
    <Compile Include="RM_VhaulkRoad.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RimMandrake.EnvironmentalHazards">
      <HintPath>$(EnvironmentalHazardsDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
