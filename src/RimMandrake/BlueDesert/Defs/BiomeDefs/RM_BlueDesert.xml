  <BiomeDef>
    <defName>RM_BlueDesert</defName>
    <label>the Blue Desert</label>
    <description>From orbit the bluest thing on the planet; underfoot, colorless. A plateau of the oldest ice on Ash'karr, its "sand" ice grain, its "snow" that same sand blowing, scoured bare by cold wind draining off higher ground. Nothing here runs on water: what lives is a fuel charge stable only in the cold, and warmth is detonation. It is usually clear, silent, and almost empty — then the ablation line gives something up.</description>
    <workerClass>BiomeWorker_IceSheet</workerClass>
    <settleWarning>The Blue Desert is a hydrocarbon-ice plateau with no water-based life and no soil. Everything native here is a cold-stable fuel charge that detonates on warming — mining and heating are both a hazard, not just a convenience.</settleWarning>
    <!-- allowRoads true per the standing owner ruling (RUT_NightsideIce's own comment, 2026-09-07): "All of our biomes should allow roads." -->
    <allowRoads>true</allowRoads>
    <allowRivers>false</allowRivers>
    <allowFarmingCamps>false</allowFarmingCamps>
    <isExtremeBiome>true</isExtremeBiome>
    <animalDensity>0.5</animalDensity>
    <plantDensity>0.33</plantDensity>
    <!-- BLUEDESERT_RULED_CONTENT_1 §4/§5: the ban-1 tension is RESOLVED —
         turn-2 ruling 1 (bible §0/review §5): "The three donor water-plants:
         CUT. The ban stands — no water plants make sense here." AB_ToxiGrass,
         AB_CrystalHorn and PoisonPlantTallGrass are removed from this biome's
         rows (AB_CrystalHorn keeps its Propane Lakes home — RUT_PropaneLake
         is untouched by this change). RM_Virr joins the three ratified
         native flora at the bible's own §6 roster numbers. Shorthand element
         form only — a <li> here would silently discard the whole entry. -->
    <wildPlants>
      <RM_Palefloss>1.0</RM_Palefloss>
      <RM_Glassfern>0.5</RM_Glassfern>
      <RM_Virr>0.4</RM_Virr>
      <RM_Chimeglobe>0.25</RM_Chimeglobe>
    </wildPlants>
    <hasVirtualPlants>false</hasVirtualPlants>
    <forageability>0</forageability>
    <movementDifficulty>1.5</movementDifficulty>
    <lakeBeachTerrain>Ice</lakeBeachTerrain>
    <mudTerrain>Ice</mudTerrain>
    <texture>World/Biomes/IceSheet</texture> <!-- placeholder, per RUT_NightsideIce's own note; the sheet's real "extremely blue from far away" art is separate, unowed work -->
    <diseaseMtbDays>90</diseaseMtbDays>
    <diseases>
      <li>
        <diseaseInc>Disease_Flu</diseaseInc>
        <commonality>100</commonality>
      </li>
      <li>
        <diseaseInc>Disease_Plague</diseaseInc>
        <commonality>80</commonality>
      </li>
    </diseases>
    <terrainsByFertility>
      <li>
        <terrain>Ice</terrain>
        <min>-999</min>
        <max>999</max>
      </li>
    </terrainsByFertility>
    <!-- BLUEDESERT_MECHANICS_BUILD_1 §4: the three ruled weathers
         (WeatherDefs/RM_BlueDesertWeathers.xml) replace the shipped
         "Clear 100". Clear stays the common state (§4b). The 60/15/15/10
         split is this build's INVENTED tuning. Mod Settings'
         "Blue Desert weathers" off zeroes the three at runtime
         (RM_BlueDesertWeatherTable), leaving Clear alone. -->
    <biomeMapConditions>
      <li>RM_BlueDesertHazeCarrier</li>
    </biomeMapConditions>
    <baseWeatherCommonalities>
      <Clear>60</Clear>
      <RM_Haze>15</RM_Haze>
      <RM_IceSandDrift>15</RM_IceSandDrift>
      <RM_IceFog>10</RM_IceFog>
      <Fog>0</Fog>
      <Rain>0</Rain>
      <DryThunderstorm>0</DryThunderstorm>
      <RainyThunderstorm>0</RainyThunderstorm>
      <FoggyRain>0</FoggyRain>
      <SnowGentle>0</SnowGentle>
      <SnowHard>0</SnowHard>
      <GrayPall MayRequire="Ludeon.RimWorld.Anomaly">0</GrayPall>
      <Windy MayRequire="Ludeon.RimWorld.Odyssey">0</Windy>
      <Overcast MayRequire="Ludeon.RimWorld.Odyssey">0</Overcast>
      <Blizzard MayRequire="Ludeon.RimWorld.Odyssey">0</Blizzard>
    </baseWeatherCommonalities>
    <!-- Resident fauna: the original three (design brief §6c) plus
         BLUEDESERT_RULED_CONTENT_1's full ruled cast — the 2026-09-24 depth
         four (zhaaz/vrisk/dovvik/utikka) and the 2026-09-28 bedazzle four
         (vhaulk/murrek/ossivel), at the cast bible's own §6 commonalities
         (vhaulk the ruled 0.02-class rare). AA_Thunderbeast is the roster's
         trace-experiment import (Alpha Animals, non-Star-Wars, see this
         file's own correction note above) — ships inline, MayRequire-gated.
         `Vapaad` (genuinely canon) rides the Utinni patch layer instead —
         see WildAnimals_BlueDesert.xml. Shorthand element form only. -->
    <wildAnimals>
      <RM_Vekkit>0.8</RM_Vekkit>
      <RM_Utikka>0.7</RM_Utikka>
      <RM_Dorrak>0.5</RM_Dorrak>
      <RM_Ossivel>0.5</RM_Ossivel>
      <RM_Krissek>0.35</RM_Krissek>
      <RM_Vrisk>0.3</RM_Vrisk>
      <RM_Murrek>0.25</RM_Murrek>
      <RM_Dovvik>0.2</RM_Dovvik>
      <RM_Zhaaz>0.1</RM_Zhaaz>
      <RM_Vhaulk>0.02</RM_Vhaulk>
      <AA_Thunderbeast MayRequire="sarg.alphaanimals">0.005</AA_Thunderbeast>  <!-- thunderbeast (yuddra) - trace-experiment import -->
    </wildAnimals>
    <coastalWildAnimals />
    <allowedPackAnimals />
  </BiomeDef>

</Defs>
