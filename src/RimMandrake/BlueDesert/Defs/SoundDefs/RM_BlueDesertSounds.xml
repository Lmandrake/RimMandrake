<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_BlueDesertSounds.xml     BLUEDESERT_MECHANICS_BUILD_1 §5 (tranche 1)

  "Vanilla SFX reuse/retint FIRST (artpipe is images; audio is a new pipeline
  ask — scope small)." RM_PhaseCrack is the one audio MECHANIC: the crack a
  warming charge-plant makes one long tick before it detonates
  (CompPlantCharge.PlayCrackCue, BlueDesertLife.cs). It reuses vanilla's
  GestatorGlassShattered clip folder (Defs/Core/SoundDefs/
  Building_Oneshots_Misc.xml, RimSage-read 2026-09-29) pitched UP and made
  shorter-reaching — a brittle crack rather than a shatter. Pitch and volume
  are this build's INVENTED retint; a bespoke clip is owed audio, not here.

  The weather ambients reuse vanilla wind loops on the WeatherDefs
  themselves (Ambient_Wind_Clear / _Storm / _Fog). Virr-field whistling and
  ossivel choirs need new clips and are NOT here.
-->
<Defs>

  <SoundDef>
    <defName>RM_PhaseCrack</defName>
    <context>MapOnly</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Folder">
            <clipFolderPath>Buildings/GestatorGlassShattering</clipFolderPath>
          </li>
        </grains>
        <volumeRange>55~70</volumeRange>
        <distRange>20~45</distRange>
        <pitchRange>1.35~1.6</pitchRange>
        <repeatMode>NeverTwice</repeatMode>
        <canVacuumDampen>false</canVacuumDampen>
      </li>
    </subSounds>
  </SoundDef>

  <!-- BLUEDESERT_GPT_ENRICHMENT_1. Same vanilla-reuse law as RM_PhaseCrack:
       every clip folder below is RimSage-verified (2026-09-30) against Core
       or Anomaly SoundDefs; pitch/volume are this build's INVENTED retint.
       Anomaly clips are safe to name: every DLC is a shipping prerequisite
       (owner, 2026-09-26). Bespoke clips are owed audio, not here. -->

  <!-- §1 the cold rack settling as its blocks melt (Anomaly's undercave
       collapse rumble, pitched up and small). -->
  <SoundDef>
    <defName>RM_ColdSinkGroan</defName>
    <context>MapOnly</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Folder">
            <clipFolderPath>Ambience/Undercave/Collapsing/Rumble</clipFolderPath>
          </li>
        </grains>
        <volumeRange>14~20</volumeRange>
        <distRange>6~22</distRange>
        <pitchRange>1.3~1.6</pitchRange>
      </li>
    </subSounds>
  </SoundDef>

</Defs>
