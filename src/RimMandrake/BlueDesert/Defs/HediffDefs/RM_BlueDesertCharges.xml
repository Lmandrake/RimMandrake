  <!-- §2f: given to a foreign (water-based) grazer that eats the flora, by
       RM_IngestionOutcomeDoer_ButaneGut. ToxicBuildup-shaped: severity per
       meal, lethal at 1, slow natural decay — so occasional grazing is
       survivable but a foreign animal that keeps eating a field dies of it and
       takes whatever room it is in with it (radius 1.9, §2f). -->
  <HediffDef>
    <defName>RM_ButaneGut</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>butane gut</label>
    <description>A build-up of unmetabolized hydrocarbon from grazing on Blue Desert flora. A water-based digestive system cannot process it; it is stable until warmed, and lethal in enough quantity either way.</description>
    <defaultLabelColor>(0.6, 0.7, 1)</defaultLabelColor>
    <isBad>true</isBad>
    <tendable>false</tendable>
    <lethalSeverity>1.0</lethalSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.15</severityPerDay>
      </li>
      <li Class="HediffCompProperties_ExplodeOnDeath">
        <explosionRadius>1.9</explosionRadius>
        <damageDef>Flame</damageDef>
        <damageAmount>40</damageAmount>
        <destroyBody>true</destroyBody>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <label>mild</label>
        <painOffset>0.02</painOffset>
      </li>
      <li>
        <minSeverity>0.5</minSeverity>
        <label>severe</label>
        <painOffset>0.1</painOffset>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.2</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
