  <!-- BLUEDESERT_MECHANICS_BUILD_1 §1: the RULED trigger gate (sheet
       amendment (2), bible §1 "Danger frame"). One comp does both halves —
       RimMandrake.BlueDesert.RM_HediffComp_HeatGatedExplodeOnDeath
       (Source/RM_VhaulkDetonation.cs): detonate ONLY on a heat-family
       killing blow (Flame/Burn; lightning's strike damage IS Flame, so it
       comes free; heatstroke or a burn wound as the culprit hediff also
       counts), and the ion trap — ANY EMP damage against a LIVING vhaulk
       detonates it on the hit. A kinetic or cold kill leaves the cistern
       intact to butcher. Mod Settings can restore the ungated any-death
       blast or disable the EMP trap. -->
  <HediffDef>
    <defName>RM_VhaulkCharge</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>hydrocarbon charge (cistern)</label>
    <description>A rolling cistern of pentane sludge, sealed and vast. The largest charge on the planet's surface -- do not still the mountain.</description>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <comps>
      <li Class="RimMandrake.BlueDesert.RM_HediffCompProperties_HeatGatedExplodeOnDeath">
        <heatDamageDefs>
          <li>Flame</li>
          <li>Burn</li>
        </heatDamageDefs>
        <heatCulpritHediffs>
          <li>Heatstroke</li>
          <li>Burn</li>
        </heatCulpritHediffs>
        <empDamageDefs>
          <li>EMP</li>
        </empDamageDefs>
        <explosionRadius>15</explosionRadius>
        <damageDef>Flame</damageDef>
        <damageAmount>40</damageAmount>
        <destroyBody>false</destroyBody>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>RM_MurrekCharge</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>hydrocarbon charge</label>
