    </lifeStages>
  </PawnKindDef>

  <ToolCapacityDef>
    <defName>RM_ThunderbeastShock</defName>
    <label>electric shock</label>
  </ToolCapacityDef>

  <ManeuverDef>
    <defName>RM_ThunderbeastShock</defName>
    <requiredCapacity>RM_ThunderbeastShock</requiredCapacity>
    <verb>
      <verbClass>Verb_MeleeAttackDamage</verbClass>
      <meleeDamageDef>ElectricalBurn</meleeDamageDef>
    </verb>
    <logEntryDef>MeleeAttack</logEntryDef>
    <combatLogRulesHit>Maneuver_Smash_MeleeHit</combatLogRulesHit>
    <combatLogRulesDeflect>Maneuver_Smash_MeleeDeflect</combatLogRulesDeflect>
    <combatLogRulesMiss>Maneuver_Smash_MeleeMiss</combatLogRulesMiss>
    <combatLogRulesDodge>Maneuver_Smash_MeleeDodge</combatLogRulesDodge>
  </ManeuverDef>

  <AbilityDef>
    <defName>RM_ThunderbeastArc</defName>
    <label>static arc</label>
    <description>Discharge the current stored in the crest plates in one long, crackling arc that burns whatever it strikes.</description>
    <iconPath>UI/Abilities/BlindingPulse</iconPath>
    <cooldownTicksRange>300</cooldownTicksRange>
    <aiCanUse>true</aiCanUse>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <writeCombatLog>true</writeCombatLog>
    <verbProperties>
      <verbClass>Verb_AbilityShoot</verbClass>
      <defaultProjectile>RM_ThunderbeastArc</defaultProjectile>
      <accuracyTouch>0.9</accuracyTouch>
      <accuracyShort>0.85</accuracyShort>
      <accuracyMedium>0.8</accuracyMedium>
      <accuracyLong>0.75</accuracyLong>
      <range>15</range>
      <muzzleFlashScale>0</muzzleFlashScale>
      <warmupTime>5</warmupTime>
      <soundCast>Shot_ChargeRifle</soundCast>
      <commonality>0.8</commonality>
      <minRange>2</minRange>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
      </targetParams>
      <ai_IsWeapon>false</ai_IsWeapon>
    </verbProperties>
  </AbilityDef>

  <ThingDef ParentName="BaseBullet">
    <defName>RM_ThunderbeastArc</defName>
    <label>static arc</label>
    <graphicData>
      <texPath>Things/Projectile/Charge_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
      <color>(255,240,140)</color>
    </graphicData>
    <projectile>
      <flyOverhead>false</flyOverhead>
      <damageDef>ElectricalBurn</damageDef>
      <damageAmountBase>10</damageAmountBase>
      <speed>75</speed>
    </projectile>
  </ThingDef>

</Defs>
