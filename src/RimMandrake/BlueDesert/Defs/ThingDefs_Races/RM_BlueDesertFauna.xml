  <!-- =================================================================
       KRISSEK — the Burner (§4)
       ================================================================= -->

  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Krissek</defName>
    <label>krissek</label>
    <description>Low, long, all haunch and jaw, running in a colour you only see at the edge of a welding arc. Standing still it is a grey thing on grey ice; the moment it runs or fights, blue fire stands off its whole body like a coat. They do not live long and they do not seem to mind. When one is hurt past a certain point it does not fall over — it goes, all at once, and the field goes with it. The crews call them torches and never, ever go for the body shot.</description>
    <statBases>
      <MoveSpeed>6.5</MoveSpeed>
      <Mass>54</Mass>
      <Flammability>0</Flammability>
      <MeatAmount>0</MeatAmount>
      <LeatherAmount>0</LeatherAmount>
      <ArmorRating_Heat>0</ArmorRating_Heat>
      <ComfyTemperatureMin>-100</ComfyTemperatureMin>
      <ComfyTemperatureMax>-11</ComfyTemperatureMax>
      <!-- BLUEDESERT_RULED_CONTENT_1 §6: still very hard to tame — a fast
           predator that detonates when killed is the roster's danger case
           ("a krissek pet is a torch in the kitchen", life brief §10) — but
           per-def now, not a blanket 1.0/None law. -->
      <Wildness>0.95</Wildness>
    </statBases>
    <tools>
      <li>
        <label>jaws</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>14</power>
        <cooldownTime>1.6</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
      </li>
      <li>
        <label>claw</label>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>8</power>
        <cooldownTime>1.2</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
      </li>
    </tools>
    <race>
      <body>QuadrupedAnimalWithPawsAndTail</body>
      <bloodDef>Filth_Blood</bloodDef>
      <bloodSmearDef>Filth_BloodSmear</bloodSmearDef>
      <hediffGiverSets>
        <li>OrganicStandard</li>
      </hediffGiverSets>
      <baseBodySize>0.9</baseBodySize>
      <baseHealthScale>0.6</baseHealthScale>
      <baseHungerRate>0.3</baseHungerRate>
      <foodType>CarnivoreAnimal</foodType>
      <predator>true</predator>
      <maxPreyBodySize>0.6</maxPreyBodySize>
      <trainability>None</trainability>
      <lifeExpectancy>4</lifeExpectancy>
      <manhunterOnDamageChance>1.0</manhunterOnDamageChance>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.15</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.3</minAge>
        </li>
      </lifeStageAges>
      <!-- §4d / COMMISSION_LEDGER_CLEANUP_1: "it goes, all at once, and the
           field goes with it" (this def's own description above): wraps
           vanilla DeathActionWorker_BigExplosion behind nativeDetonationsEnabled. -->
      <deathAction>
        <workerClass>RimMandrake.BlueDesert.RM_DeathActionWorker_BurnerBlast</workerClass>
      </deathAction>
    </race>
    <butcherProducts>
      <RM_ColdWax>6</RM_ColdWax>
    </butcherProducts>
    <comps>
      <!-- §4b: the halo shows only while jogging/fleeing/fighting/hunting
           (RM_CompEffecter_Halo.ShouldShowEffecter, BlueDesertLife.cs). -->
      <li Class="CompProperties_Effecter">
        <compClass>RimMandrake.BlueDesert.RM_CompEffecter_Halo</compClass>
        <effecterDef>RM_KrissekHalo</effecterDef>
      </li>
    </comps>
    <modExtensions>
      <li Class="RimMandrake.BlueDesert.RM_HydrocarbonNativeExtension" />
    </modExtensions>
    <tradeTags>
      <li>AnimalFighter</li>
    </tradeTags>
  </ThingDef>

