<?xml version="1.0" encoding="utf-8"?>
<!-- BLUEDESERT_RM_MOD_BUILD_1: moved here unchanged from
     src/RimUtinni/UtinniPatches/Defs/ThingDefs_Races/RM_BlueDesertFauna.xml.
     Every Class="RimMandrake.BlueDesert...." reference below still resolves —
     namespace and class names are unchanged, only the assembly moved
     (src/RimMandrake/BlueDesert/Source/BlueDesertLife.cs). -->
<!--
  BLUE_DESERT_LIFE_AUTHORING_1 (steps 2-5) — the Blue Desert's three resident
  fauna, per design/Jawa/worldbuilding/creatures/blue_desert_hydrocarbon_life.md
  §3-§5. RM_ tier (mandrake.rm.bluedesert eventually — see BlueDesertLife.cs's
  header for why this file lives here for now instead).

  Shape cloned from this mod's own RUT_Emberscythe.xml (ParentName
  AnimalThingBase + manual race block — ordinary wildlife via wildAnimals
  commonality, not a hive/BaseInsect spawn).

  Every native carries `hediffGiverSets: OrganicStandard` — the free
  heatstroke mechanism (§1f) that IS the warm-reactivity ban-3 requires: a
  native with ComfyTemperatureMax -11 takes heatstroke above -1C (butane's
  boiling point) and dies of it, which fires its RM_*Charge hediff below.

  Art: PLACEHOLDER texPaths reusing vanilla shipped art (Thrumbo/Warg/Squirrel)
  with a grey tint, same "recolored placeholder, no new art" idiom
  RUT_Placeholder_SumpMouse/RUT_Emberscythe already use — bespoke sprites are
  QUEUED via fill_queue.py (art_lists/blue_desert_life.csv), not landed yet.
  Palette: biome_palette_anchors.json `the_blue_desert` family — dorrak
  darkest, vekkit one step lighter, krissek mid-grey at rest so its halo
  (RM_KrissekHalo, see EffecterDefs) is the only colour it ever has (§8).

  MeatAmount/LeatherAmount 0 on all three (§3a/§4a/§5a): the only butcherProduct
  is RM_ColdWax (§7). Untameable-by-training (trainability None, brief §10)
  is the only tameness field this brief sets — no explicit tameable override,
  per the item's own instruction to leave AnimalThingBase's default alone.

  ADDED 2026-09-25 (COMMISSION_LEDGER_CLEANUP_1, the_propane_lakes sheet):
  RM_Krissek's own description already reads "it goes, all at once, and the
  field goes with it" — checked this pass and no deathAction node backed that
  text at all. Wired race.deathAction to RM_DeathActionWorker_BurnerBlast
  (BlueDesertLife.cs §4d — wraps vanilla DeathActionWorker_BigExplosion,
  the Boomalope's own mechanism, behind the existing nativeDetonationsEnabled
  toggle). Filed alongside the propane lake's ascendant form, whose own
  roster row explicitly calls this "shared authoring with the Blue Desert's
  Burners" — see RUT_PropaneLakeFauna.xml.
-->
<Defs>

  <!-- =================================================================
       DORRAK — the Swallower (§3)
       ================================================================= -->

  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Dorrak</defName>
    <label>dorrak</label>
    <description>A slab of a beast on six short legs, plated like a boiler and about as talkative. It walks up to a glassfern, closes its whole face over it like a lid, pulls the thing out of the ice roots and all, and stands there a while. The crews call them casks and give them the road. Nobody who has shot one in the belly has described it afterwards.</description>
    <statBases>
      <MoveSpeed>1.8</MoveSpeed>
      <Mass>96</Mass>
      <Flammability>0.1</Flammability>
      <MeatAmount>0</MeatAmount>
      <LeatherAmount>0</LeatherAmount>
      <ArmorRating_Sharp>0.6</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.4</ArmorRating_Blunt>
      <ArmorRating_Heat>0</ArmorRating_Heat>
      <ComfyTemperatureMin>-100</ComfyTemperatureMin>
      <ComfyTemperatureMax>-11</ComfyTemperatureMax>
      <!-- BLUEDESERT_RULED_CONTENT_1 §6 (tameability pass): the blanket
           all-untameable stance is dead. Dorrak is slow, armoured and a
           lumbering grazer — a tameable cask, not a fighter — so it gets
           the roster's most forgiving Wildness/trainability pairing. -->
      <Wildness>0.85</Wildness>
    </statBases>
    <tools>
      <li>
        <label>crush</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>22</power>
        <cooldownTime>3.2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
      </li>
      <li>
        <label>maw</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>12</power>
        <cooldownTime>2.2</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
      </li>
    </tools>
    <race>
      <body>QuadrupedAnimalWithHoovesAndHump</body>
      <bloodDef>Filth_Blood</bloodDef>
      <bloodSmearDef>Filth_BloodSmear</bloodSmearDef>
      <hediffGiverSets>
        <li>OrganicStandard</li>
      </hediffGiverSets>
      <baseBodySize>1.6</baseBodySize>
      <baseHealthScale>1.6</baseHealthScale>
      <baseHungerRate>0.35</baseHungerRate>
      <foodType>VegetarianRoughAnimal</foodType>
      <predator>false</predator>
      <trainability>Intermediate</trainability>
      <lifeExpectancy>30</lifeExpectancy>
      <manhunterOnDamageChance>0.5</manhunterOnDamageChance>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.4</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.8</minAge>
        </li>
      </lifeStageAges>
    </race>
    <butcherProducts>
      <RM_ColdWax>12</RM_ColdWax>
    </butcherProducts>
    <!-- BLUE_DESERT_LIFE_AUTHORING_1: the sealed-gut hydrocarbon charge
         (RM_DorrakCharge, HediffDefs/RM_BlueDesertCharges.xml) is given at
         generation via PawnKindDef.startingHediffs below, not here. -->
    <modExtensions>
      <li Class="RimMandrake.BlueDesert.RM_HydrocarbonNativeExtension" />
    </modExtensions>
    <tradeTags>
      <li>AnimalUncommon</li>
    </tradeTags>
  </ThingDef>

