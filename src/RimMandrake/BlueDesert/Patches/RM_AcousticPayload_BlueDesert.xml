<?xml version="1.0" encoding="utf-8"?>
<!--
  GRAVSHIP_ACOUSTIC_SCANNER_1: the acoustic-scanner payload for RM_BlueDesert.
  Owner decision by question card 2026-10-06: the payload goes on EVERY biome of ours.

  Pure XML, FindMod-guarded on "RimMandrake: Acoustic Scanner", so the extension class
  is only named while its assembly is active. Every def is a defName STRING resolved
  at pulse time (GetNamedSilentFail), so a target naming another mod's def just hears
  nothing when that mod is absent. Each target is drawn from this biome's own content;
  the biome's sitting may re-author it. The reading is always banded by the scanner.
-->
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>RimMandrake: Acoustic Scanner</li>
    </mods>
    <match Class="PatchOperationAddModExtension">
      <xpath>/Defs/BiomeDef[defName="RM_BlueDesert"]</xpath>
      <value>
        <li Class="RimMandrake.AcousticScanner.RM_AcousticPayloadExtension">
          <quietText>Clean ice all the way down, ringing like a struck glass. Nothing in it but cold.</quietText>
          <targets>
            <li>
              <label>something rising through the ice</label>
              <reading>A deep crack note, and under it a slow push from below. The ice there is thinning.</reading>
              <color>(1, 0.45, 0.35)</color>
              <weight>3</weight>
              <thingDefs>
                <li>RM_AblationEmergence</li>
              </thingDefs>
            </li>
            <li>
              <label>something lying under the drift</label>
              <reading>A soft dead spot in the ice-sand, the shape of a body that does not want to be found.</reading>
              <color>(1, 0.6, 0.4)</color>
              <weight>2</weight>
              <pawnRaces>
                <li>RM_Murrek</li>
                <li>RM_Zhaaz</li>
                <li>RM_Vhaulk</li>
              </pawnRaces>
            </li>
            <li>
              <label>ice-locked wreck</label>
              <reading>Hollow metal held stiff in the ice: a hull, frozen where it fell.</reading>
              <color>(0.8, 0.8, 0.85)</color>
              <thingDefs>
                <li>RM_BlueDesertWreckHull</li>
                <li>RM_BlueDesertWreckFrame</li>
              </thingDefs>
            </li>
            <li>
              <label>blue ice</label>
              <reading>A denser, purer ring than the grain around it: old blue ice, close under the surface.</reading>
              <color>(0.45, 0.7, 1)</color>
              <weight>0.3</weight>
              <thingDefs>
                <li>RM_BlueIceMineable</li>
              </thingDefs>
              <onlyFogged>true</onlyFogged>
            </li>
          </targets>
        </li>
      </value>
    </match>
  </Operation>
</Patch>
