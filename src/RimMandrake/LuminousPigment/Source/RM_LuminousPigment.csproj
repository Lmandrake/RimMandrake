<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DEEPFIRE_PIGMENT_MOD_1 — LuminousPigment, Phase 1 (the chain: crowncarpet,
    the press, the GlowTank, Deepfire itself). Painting/status/gods/cuisine
    are DEEPFIRE_PAINT_STATUS_CUISINE_1, not this project.

    Harmony via brrainz.harmony at runtime (never bundled) — used only to
    keep RM_DeepfireRefining hidden until a mat is seen
    (Source/HarmonyPatches.cs); nothing else here patches an engine method.

    Build (the dotnet is WINDOWS-NATIVE and cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\Rimworld\src\RimMandrake\LuminousPigment\Source\RM_LuminousPigment.csproj -c Release

    Output lands in ../Assemblies/, which is where RimWorld looks.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrakeLuminousPigment</AssemblyName>
    <RootNamespace>RimMandrake.LuminousPigment</RootNamespace>
    <Version>0.1.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HarmonyDll)' == ''">
    <HarmonyDll>C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\2009463077\Current\Assemblies\0Harmony.dll</HarmonyDll>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="LuminousPigmentMod.cs" />
    <Compile Include="GameComponent_Deepfire.cs" />
    <Compile Include="CompMatVitality.cs" />
    <Compile Include="CompMatDiscovery.cs" />
    <Compile Include="GenStep_ShoreMats.cs" />
    <Compile Include="Building_GlowTank.cs" />
    <Compile Include="HarmonyPatches.cs" />
    <!-- DEEPFIRE_PAINT_STATUS_CUISINE_1: Cuisine, the Ninefold god bridge,
         and the sumptuary status engine. Painting/worn-glow (piece 1/2) are
         not here, deferred to DEEPFIRE_PAINT_LIVE_VERIFY_1. -->
    <Compile Include="DeepfireFamilies.cs" />
    <Compile Include="HediffComp_DeepfireGlow.cs" />
    <Compile Include="CompSkillSteeredOutcome.cs" />
    <Compile Include="SteeredFamilyExtension.cs" />
    <Compile Include="GenRecipePatch.cs" />
    <Compile Include="IngestionOutcomeDoer_SteeredFamily.cs" />
    <Compile Include="NinefoldDeltaBridge.cs" />
    <Compile Include="DeepfireGodExtension.cs" />
    <Compile Include="SumptuaryEngine.cs" />
    <Compile Include="ThoughtWorkers_Sumptuary.cs" />
    <!-- DEEPFIRE_PAINT_LIVE_VERIFY_1, spec §10 step 5: painting Deepfire
         onto walls/floors-furniture/art/apparel/weapons, and the proxy-
         glower light system step 1 answered (spawned invisible 1x1 Thing,
         never an unspawned proxy). -->
    <Compile Include="DeepfireDefOf.cs" />
    <Compile Include="DeepfirePaintUtility.cs" />
    <Compile Include="MapComponent_DeepfireLights.cs" />
    <Compile Include="CompDeepfire.cs" />
    <Compile Include="CompInjector_Deepfire.cs" />
    <Compile Include="Designator_Deepfire.cs" />
    <Compile Include="WorkGiver_ApplyDeepfire.cs" />
    <Compile Include="JobDriver_ApplyDeepfire.cs" />
    <!-- DEEPFIRE_FLOOR_PAINT_1, spec §10 step 6: floor grid + 3x3 clustering,
         terrain/beauty Harmony hooks, the floor-cell job, dev proof actions. -->
    <Compile Include="MapComponent_DeepfireLights.Clusters.cs" />
    <Compile Include="DeepfireFloorPatches.cs" />
    <Compile Include="DeepfireFloorJobs.cs" />
    <Compile Include="DeepfireFloorDebugActions.cs" />
    <!-- DEEPFIRE_FIRSTCOAT_BONUS_1, spec §10 step 7: first-coat quality
         bump (art items) + RM_StatPart_Deepfire on Beauty (everything
         else), dev proof actions. -->
    <Compile Include="DeepfireFirstCoatBonus.cs" />
    <Compile Include="RM_StatPart_Deepfire.cs" />
    <Compile Include="DeepfireFirstCoatDebugActions.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
