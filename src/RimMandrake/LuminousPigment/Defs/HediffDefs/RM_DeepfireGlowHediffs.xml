  </HediffDef>

  <!-- 12. Pulse-glow -->
  <HediffDef>
    <defName>RM_Glow_Pulse</defName>
    <label>pulse-glow</label>
    <description>The whole pawn glows dimly from within — the showpiece family, and a real cardiac risk at its worst.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <everCurableByItem>false</everCurableByItem>
    <initialSeverity>0.5</initialSeverity>
    <maxSeverity>2.999</maxSeverity>
    <comps>
      <li Class="RimMandrake.LuminousPigment.HediffCompProperties_DeepfireGlow">
        <glowColor>(1,0.7,0.75,0)</glowColor>
        <glowRadiusByStage><li>0.8</li><li>1.2</li><li>1.8</li></glowRadiusByStage>
        <!-- PROVISIONAL (auto-decided 2026-10-09, HEDIFF_GLOW_TARGETING_PULSE_1): the
             unread pulsesWithHeartRate flag was removed; this light is steady. -->
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <label>tier I</label>
        <capMods><li><capacity>BloodPumping</capacity><offset>0.05</offset></li></capMods>
      </li>
      <li>
        <minSeverity>1</minSeverity>
        <label>tier II</label>
        <capMods><li><capacity>BloodPumping</capacity><offset>0.12</offset></li></capMods>
        <statOffsets><MoveSpeed>0.05</MoveSpeed></statOffsets>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <label>tier III</label>
        <capMods><li><capacity>BloodPumping</capacity><offset>0.20</offset></li></capMods>
