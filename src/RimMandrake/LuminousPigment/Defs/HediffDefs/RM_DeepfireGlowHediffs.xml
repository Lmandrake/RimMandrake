    <defName>RM_Glow_Nerves</defName>
    <label>nerve-glow</label>
    <description>Nothing shows — the nerves themselves burn brighter. Every scratch is sharper; the mind runs a little clearer for it.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <everCurableByItem>false</everCurableByItem>
    <initialSeverity>0.5</initialSeverity>
    <maxSeverity>2.999</maxSeverity>
    <!-- No glow comp — "none" at every tier (spec). -->
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <label>tier I</label>
        <painFactor>1.15</painFactor>
        <capMods><li><capacity>Consciousness</capacity><offset>0.03</offset></li></capMods>
      </li>
      <li>
        <minSeverity>1</minSeverity>
        <label>tier II</label>
        <painFactor>1.35</painFactor>
        <capMods><li><capacity>Consciousness</capacity><offset>0.06</offset></li></capMods>
