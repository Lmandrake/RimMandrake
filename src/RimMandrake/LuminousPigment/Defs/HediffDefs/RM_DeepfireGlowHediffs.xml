          <li Class="HediffGiver_Random">
            <hediff>HeartAttack</hediff>
            <mtbDays>90</mtbDays>
          </li>
        </hediffGivers>
      </li>
    </stages>
  </HediffDef>

  <!-- 13. Lung-glow -->
  <HediffDef>
    <defName>RM_Glow_Lungs</defName>
    <label>lung-glow</label>
    <description>The breath itself runs warm and amber in cold air. Talk comes easier; breath comes harder.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <everCurableByItem>false</everCurableByItem>
    <initialSeverity>0.5</initialSeverity>
    <maxSeverity>2.999</maxSeverity>
    <!-- No glow comp: the visible tell is breath flecks in cold air, a
         cosmetic-only fleck emitter trimmed for this pass (file header). -->
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <label>tier I</label>
        <capMods><li><capacity>Talking</capacity><offset>0.10</offset></li></capMods>
      </li>
      <li>
        <minSeverity>1</minSeverity>
        <label>tier II</label>
        <capMods>
          <li><capacity>Talking</capacity><offset>0.20</offset></li>
          <li><capacity>Breathing</capacity><offset>-0.08</offset></li>
        </capMods>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <label>tier III</label>
        <capMods>
          <li><capacity>Talking</capacity><offset>0.30</offset></li>
          <li><capacity>Breathing</capacity><offset>-0.20</offset></li>
        </capMods>
        <statFactors><ToxicEnvironmentResistance>1.20</ToxicEnvironmentResistance></statFactors>
      </li>
    </stages>
  </HediffDef>

  <!-- 14. Whole-body glow — the vermilion. Steered-only, never rolled at
       random (RM_IngestionOutcomeDoer_SteeredFamily excludes it from every
       random and every re-roll pool); its recipe alone requires
       vermilionMinSkill (default 14). Reaching tier III fires an Ishko
       penalty via NinefoldDeltaBridge (HediffComp_DeepfireGlow). -->
  <HediffDef>
    <defName>RM_Glow_Whole</defName>
    <label>whole-body glow</label>
    <description>The entire pawn glows in their own skin colour — deepfire cuisine's prestige family, master chefs only. It cannot be hidden.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <everCurableByItem>false</everCurableByItem>
    <initialSeverity>0.5</initialSeverity>
    <maxSeverity>2.999</maxSeverity>
    <comps>
      <li Class="RimMandrake.LuminousPigment.HediffCompProperties_DeepfireGlow">
        <useSkinColor>true</useSkinColor>
        <glowRadiusByStage><li>1.5</li><li>2.5</li><li>3.5</li></glowRadiusByStage>
        <glowTargetFactorOverride>1.5</glowTargetFactorOverride>
        <ishkoPenaltyOnStage3>true</ishkoPenaltyOnStage3>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <label>tier I</label>
        <statOffsets><Beauty>3</Beauty></statOffsets>
      </li>
      <li>
        <minSeverity>1</minSeverity>
        <label>tier II</label>
        <statOffsets><Beauty>5</Beauty></statOffsets>
        <statFactors><SocialImpact>1.15</SocialImpact></statFactors>
        <restFallFactor>1.2</restFallFactor>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <label>tier III</label>
        <statOffsets><Beauty>8</Beauty></statOffsets>
        <restFallFactor>1.4</restFallFactor>
      </li>
    </stages>
  </HediffDef>

</Defs>
