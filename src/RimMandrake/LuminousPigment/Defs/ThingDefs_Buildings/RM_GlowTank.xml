<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  RM_GlowTank.xml                        LuminousPigment · DEEPFIRE_PIGMENT_MOD_1
  ============================================================================
  Spec §2.5. "Hydroponics-like, very low yield, moderate power/resources/
  space" (ruling). 2x2 (four plant cells via fertility/size, vanilla
  Building_PlantGrower shape — pattern taken from Core's own HydroponicsBasin,
  RimSage-verified). Must be seeded with one unit of fresh crowncarpet
  (CompRefuelable, fuelFilter RM_CrowncarpetFresh, capacity 1) before
  RM_Building_GlowTank.CanAcceptSowNow allows sowing — the sowTag
  "RM_GlowTank" is exclusive to RM_CrowncarpetCultured, so nothing else can
  be sown here even once seeded. Losing power for tankPowerGraceHours (Mod
  Settings, default 6h) kills the crop and the seed culture
  (Source/Building_GlowTank.cs).

  The FlowWorks ocean-water requirement (spec §2.5: needs salt or boiling
  water when FlowWorks is loaded) is NOT built in this pass — it needs a
  reflection accessor into FlowWorks' liquid-terrain lookup that the spec
  itself flags UNMEASURED, plus how a carried liquid becomes a haulable
  thing (also UNMEASURED there). The tank runs on power + a seed alone here,
  with or without FlowWorks present; the water gate is filed as follow-on
  work under DEEPFIRE_PAINT_STATUS_CUISINE_1's note.
  ============================================================================
-->
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>RM_GlowTank</defName>
    <label>glowtank</label>
    <description>A squat glass-and-iron vat that cultures crowncarpet from a seed of the fresh mat. Slow and low-yield compared to a wild shore, but it needs no ocean — only power, a seed, and patience.</description>
    <thingClass>RimMandrake.LuminousPigment.Building_GlowTank</thingClass>
    <category>Building</category>
    <altitudeLayer>LowPlant</altitudeLayer>
    <drawerType>MapMeshOnly</drawerType>
    <tickerType>Rare</tickerType>
    <graphicData>
      <texPath>Things/Building/Production/RM_GlowTank</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <size>(2,2)</size>
    <fertility>1.0</fertility>
    <canOverlapZones>false</canOverlapZones>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.4</fillPercent>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <WorkToBuild>4500</WorkToBuild>
      <Flammability>0.3</Flammability>
      <Beauty>2</Beauty>
    </statBases>
    <costList>
      <Steel>120</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
      <Plasteel>10</Plasteel>
    </costList>
    <researchPrerequisites>
      <li>RM_DeepfireRefining</li>
      <li>Hydroponics</li>
    </researchPrerequisites>
    <designationCategory>Production</designationCategory>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <building>
      <sowTag>RM_GlowTank</sowTag>
      <defaultPlantToGrow>RM_CrowncarpetCultured</defaultPlantToGrow>
      <buildingTags>
        <li>Production</li>
      </buildingTags>
    </building>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>180</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>0</fuelConsumptionRate>
        <fuelCapacity>1</fuelCapacity>
        <fuelFilter>
          <thingDefs>
            <li>RM_CrowncarpetFresh</li>
          </thingDefs>
        </fuelFilter>
        <initialFuelPercent>0</initialFuelPercent>
        <showAllowAutoRefuelToggle>false</showAllowAutoRefuelToggle>
        <targetFuelLevelConfigurable>false</targetFuelLevelConfigurable>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <destroyOnNoFuel>false</destroyOnNoFuel>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>2.0</glowRadius>
        <glowColor>(200,220,255,0)</glowColor>
      </li>
    </comps>
  </ThingDef>

</Defs>
