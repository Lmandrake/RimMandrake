<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  RM_SumptuaryThoughts.xml           LuminousPigment · DEEPFIRE_PAINT_STATUS_CUISINE_1
  ============================================================================
  Spec §4.1 — the "purple engine". Worn-goods thoughts (display score from
  CompDeepfire coats on worn apparel / the primary weapon) plus
  RM_DeepfireBedroom (room display score, DEEPFIRE_STATUS_THOUGHTS_1).
  RM_ImpressedByDeepfire is a goodwill change, not a thought: its
  HistoryEventDef is at the bottom of this file and
  Source/MapComponent_DeepfireStatus.cs applies it.
  Situational, workerClass-driven (Source/ThoughtWorkers_Sumptuary.cs).
  moodScale is not applied here; wiring settings is DEEPFIRE_MOD_SETTINGS_1's.
  ============================================================================
-->
<Defs>

  <ThoughtDef>
    <defName>RM_WearingDeepfireTitled</defName>
    <workerClass>RimMandrake.LuminousPigment.ThoughtWorker_DeepfireStatusTitled</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li><label>wearing deepfire</label><description>My status shows, and it should.</description><baseMoodEffect>3</baseMoodEffect></li>
      <li><label>wearing deepfire</label><description>My status shows, and it should.</description><baseMoodEffect>5</baseMoodEffect></li>
      <li><label>wearing deepfire</label><description>My status shows, and it should.</description><baseMoodEffect>8</baseMoodEffect></li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>RM_WearingDeepfireCommon</defName>
    <workerClass>RimMandrake.LuminousPigment.ThoughtWorker_DeepfireStatusCommon</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li><label>wearing deepfire</label><description>It looks good on me.</description><baseMoodEffect>1</baseMoodEffect></li>
      <li><label>wearing deepfire</label><description>It looks good on me.</description><baseMoodEffect>2</baseMoodEffect></li>
      <li><label>wearing deepfire</label><description>It looks good on me.</description><baseMoodEffect>3</baseMoodEffect></li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>RM_WearsAboveStation</defName>
    <thoughtClass>Thought_SituationalSocial</thoughtClass>
    <workerClass>RimMandrake.LuminousPigment.ThoughtWorker_WearsAboveStation</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>wears above their station</label>
        <description>They dress in deepfire as if they were somebody. It is not their place.</description>
        <baseOpinionOffset>-15</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>RM_SawCommonerInDeepfire</defName>
    <workerClass>RimMandrake.LuminousPigment.ThoughtWorker_SawCommonerInDeepfire</workerClass>
    <validWhileDespawned>false</validWhileDespawned>
    <stages>
      <li>
        <label>a commoner in deepfire</label>
        <description>Someone beneath me walks around glowing like a noble. It offends.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Spec §4.1: titled pawn, bedroom/throne room score >= 3: +4; >= 8: +6. -->
  <ThoughtDef>
    <defName>RM_DeepfireBedroom</defName>
    <workerClass>RimMandrake.LuminousPigment.ThoughtWorker_DeepfireBedroom</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li><label>deepfire-lit quarters</label><description>My rooms glow the way a noble's rooms should.</description><baseMoodEffect>4</baseMoodEffect></li>
      <li><label>splendid deepfire quarters</label><description>My rooms blaze with deepfire. Anyone who enters knows who lives here.</description><baseMoodEffect>6</baseMoodEffect></li>
    </stages>
  </ThoughtDef>

  <!-- Spec §4.1: a visiting titled pawn impressed by a deepfire-lit public
       room. Goodwill reason label only (Faction.TryAffectGoodwillWith reason). -->
  <HistoryEventDef>
    <defName>RM_ImpressedByDeepfire</defName>
    <label>impressed by deepfire</label>
  </HistoryEventDef>

</Defs>
