<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  RM_DeepfireLightProxy.xml              LuminousPigment · DEEPFIRE_PAINT_LIVE_VERIFY_1
  ============================================================================
  Spec §10 step 1's answer, recorded on the ledger item: CompGlower.ShouldBeLitNow
  gates on parent.Spawned, so an UNSPAWNED proxy structurally cannot light
  map.glowGrid. This def is the SPAWNED, invisible, unselectable 1x1 Thing
  MapComponent_DeepfireLights.cs spawns one of per registered light (a coated
  wall/furniture/item, or one per 3x3 cluster of coated floor cells / 1x1
  buildings — spec §3.6, DEEPFIRE_FLOOR_PAINT_1).

  🔴 altitudeLayer Item, NOT Building — MEASURED live 2026-09-29: the first
  shape (ParentName="BuildingBase", category Building, altitudeLayer
  Building, fillPercent 0) DESTROYED the wall it was spawned on top of.
  GenSpawn.Spawn's default WipeMode.Vanish calls
  GenSpawn.SpawningWipes(newDef, oldDef) (RimSage-verified, Verse/GenSpawn.cs),
  which wipes on `thingDef2.blocksAltitudes.Contains(thingDef.altitudeLayer)` —
  BuildingBase's own inherited `blocksAltitudes` blocks the Building layer
  regardless of fillPercent, so a fillPercent-0 Building-layer thing spawned
  on an occupied cell still wiped the occupant. On the Item layer a proxy
  spawned on a Steel wall's own cell leaves the wall standing (RE-VERIFIED
  live 2026-09-29).

  🔴 category Ethereal, NOT Item (DEEPFIRE_PROXY_BLOCKS_STORAGE_1). An
  Item-category proxy (a) made GenSpawn.Spawn DeSpawn and re-place an
  existing item when the cell was already at GetMaxItemsAllowedInCell, and
  (b) counted in GridsUtility.GetItemCount, so StoreUtility's
  NoStorageBlockersIn read the cell as full — every coated 3x3 floor block in
  a stockpile lost a storage cell (RimSage Verse/GenSpawn.cs Spawn,
  Verse/GridsUtility.cs, RimWorld/StoreUtility.cs). Changing ONLY the
  category keeps the wall safe: SpawningWipes' only category-sensitive rules
  are the early returns for Attachment/Mote/Filth/Projectile/Plant/
  PsychicEmitter, the Item-vs-Impassable rule (we are Standable), IsEdifice
  (no `building`) and BlocksPlanting (fillPercent 0, no blockPlants). The
  altitude rules — the ones that wiped the wall — see the same Item layer as
  before. Same shape as RM_DeepfireWornLightProxy below.

  glowRadius/glowColor on the XML comp are placeholders only: every spawn
  immediately overrides CompGlower.GlowRadius/GlowColor at runtime
  (MapComponent_DeepfireLights.SetLight) to the coated thing's own colour
  and coat-scaled radius (spec §3.1/§3.2).
  ============================================================================
-->
<Defs>

  <ThingDef>
    <defName>RM_DeepfireLightProxy</defName>
    <label>deepfire light (internal)</label>
    <description>Internal marker thing that carries a Deepfire glow light. If you can see or select this, something is wrong — report it.</description>
    <!-- DEEPFIRE_LIVE_FAILURES_1: a ThingWithComps whose Destroy is a no-op when
         already destroyed (snapshot-destroyers such as GenDebug.ClearArea). -->
    <thingClass>RimMandrake.LuminousPigment.DeepfireLightProxy</thingClass>
    <category>Ethereal</category>
    <drawerType>None</drawerType>
    <altitudeLayer>Item</altitudeLayer>
    <passability>Standable</passability>
    <fillPercent>0</fillPercent>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <selectable>false</selectable>
    <useHitPoints>false</useHitPoints>
    <destroyable>true</destroyable>
    <alwaysHaulable>false</alwaysHaulable>
    <designateHaulable>false</designateHaulable>
    <drawGUIOverlay>false</drawGUIOverlay>
    <tradeability>None</tradeability>
    <neverMultiSelect>true</neverMultiSelect>
    <tickerType>Never</tickerType>
    <!-- DEEPFIRE_FLOOR_PAINT_1, spec §3.6 "Lights are never saved": every
         proxy is rebuilt on load (CompDeepfire.PostSpawnSetup for things,
         MapComponent_DeepfireLights.FinalizeInit for the floor grid). A
         saveable proxy survived the save AND got a fresh twin on load, so
         each save/load cycle doubled the lights (Map.ExposeData only skips
         things whose def.isSaveable is false, RimSage Verse/Map.cs). -->
    <isSaveable>false</isSaveable>
    <statBases>
      <Flammability>0</Flammability>
      <MarketValue>0</MarketValue>
      <Mass>0</Mass>
    </statBases>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>1.5</glowRadius>
        <glowColor>(255,255,255,0)</glowColor>
        <overlightRadius>0</overlightRadius>
      </li>
    </comps>
  </ThingDef>

  <!-- DEEPFIRE_WORN_GLOW_1, spec §3.4: the MOVING per-pawn light
       (MapComponent_DeepfireLights.Worn.cs). category Ethereal, NOT Item:
       it follows a pawn through stockpiles, and an Item-category thing both
       makes GenSpawn.Spawn shove an existing item aside on a full cell and
       counts in GridsUtility.GetItemCount (RimSage Verse/GenSpawn.cs,
       Verse/GridsUtility.cs). Ethereal + Standable + fillPercent 0 + not an
       edifice trips no GenSpawn.SpawningWipes rule, so it wipes nothing it
       spawns on (vanilla's own Ethereal markers, Ethereal_Various.xml, use
       the same category). Moved by Position every 15 ticks, never respawned. -->
  <ThingDef>
    <defName>RM_DeepfireWornLightProxy</defName>
    <label>deepfire worn light (internal)</label>
    <description>Internal marker thing that carries the glow of a pawn's deepfire-lacquered gear. If you can see or select this, something is wrong — report it.</description>
    <!-- DEEPFIRE_LIVE_FAILURES_1: a ThingWithComps whose Destroy is a no-op when
         already destroyed (snapshot-destroyers such as GenDebug.ClearArea). -->
    <thingClass>RimMandrake.LuminousPigment.DeepfireLightProxy</thingClass>
    <category>Ethereal</category>
    <drawerType>None</drawerType>
    <altitudeLayer>Item</altitudeLayer>
    <passability>Standable</passability>
    <fillPercent>0</fillPercent>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <selectable>false</selectable>
    <useHitPoints>false</useHitPoints>
    <destroyable>true</destroyable>
    <alwaysHaulable>false</alwaysHaulable>
    <designateHaulable>false</designateHaulable>
    <drawGUIOverlay>false</drawGUIOverlay>
    <tradeability>None</tradeability>
    <neverMultiSelect>true</neverMultiSelect>
    <tickerType>Never</tickerType>
    <isSaveable>false</isSaveable>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>1.5</glowRadius>
        <glowColor>(255,255,255,0)</glowColor>
        <overlightRadius>0</overlightRadius>
      </li>
    </comps>
  </ThingDef>

</Defs>
