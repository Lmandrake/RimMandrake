<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_DeepfireJobs.xml                    LuminousPigment · DEEPFIRE_PAINT_LIVE_VERIFY_1
  Spec §3.3: fetch cost Deepfire from a stockpile, go to target, 600-tick toil
  x WorkSpeedGlobal, Artistic XP 100, then CompDeepfire.AddCoat.
-->
<Defs>

  <JobDef>
    <defName>RM_ApplyDeepfire</defName>
    <driverClass>RimMandrake.LuminousPigment.JobDriver_ApplyDeepfire</driverClass>
    <reportString>applying deepfire to TargetA.</reportString>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

  <!-- DEEPFIRE_FLOOR_PAINT_1: the floor-cell branch (one coat per cell). -->
  <JobDef>
    <defName>RM_ApplyDeepfireFloor</defName>
    <driverClass>RimMandrake.LuminousPigment.JobDriver_ApplyDeepfireFloor</driverClass>
    <reportString>applying deepfire to the floor.</reportString>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

  <!-- DEEPFIRE_WORN_GLOW_1, spec §3.4: lacquer a WORN/EQUIPPED item at a
       powered deepfire press or an Ideology styling station. -->
  <JobDef>
    <defName>RM_LacquerWornItem</defName>
    <driverClass>RimMandrake.LuminousPigment.JobDriver_LacquerWornItem</driverClass>
    <reportString>lacquering TargetC with deepfire.</reportString>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

</Defs>
