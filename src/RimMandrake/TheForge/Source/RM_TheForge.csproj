<Project Sdk="Microsoft.NET.Sdk">

  <!--
    THEFORGE_RM_MOD_BUILD_1. Same recipe as
    src/RimMandrake/LeaningScrub/Source/RM_LeaningScrub.csproj — copy that
    header if this one goes stale.

    Build (the dotnet is WINDOWS-NATIVE and cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\RimMandrake\src\RimMandrake\TheForge\Source\RM_TheForge.csproj -c Release

    Output lands in ../Assemblies/, which is where RimWorld looks.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrake.TheForge</AssemblyName>
    <RootNamespace>RimMandrake.TheForge</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <!-- Nothing but our own DLL should ever be copied next to the mod —
         Harmony in particular must come from brrainz.harmony at runtime. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HarmonyDll)' == ''">
    <HarmonyDll>C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\2009463077\Current\Assemblies\0Harmony.dll</HarmonyDll>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\_Shared\HarmonyResilience\PatchApplier.cs" Link="Shared\PatchApplier.cs" />
    <Compile Include="RM_TheForgeMod.cs" />
    <Compile Include="RM_BiomeWorker_TheForge.cs" />
    <!-- FORGE_CYCLE_MECHANICS_1 -->
    <Compile Include="RM_ForgeCycleExtension.cs" />
    <Compile Include="RM_GameCondition_ForgeCycle.cs" />
    <Compile Include="RM_CompForgeCycleDormancy.cs" />
    <Compile Include="RM_PawnRenderNodeWorker_DormantBody.cs" />
    <Compile Include="RM_ForgeCycleDebugActions.cs" />
    <!-- FORGE_GPT_ENRICHMENT_1 -->
    <Compile Include="RM_TheForgeDefOf.cs" />
    <Compile Include="RM_ForgeVoices.cs" />
    <Compile Include="RM_ForgeKeelwork.cs" />
    <Compile Include="RM_ForgeSpunstone.cs" />
    <Compile Include="RM_ForgeSpunstoneParts.cs" />
    <!-- FORGE_WHITE_PLUME_FRONTS_1 -->
    <Compile Include="RM_ForgePlumeFronts.cs" />
    <!-- FORGE_SKY_PASTURES_1 -->
    <Compile Include="RM_ForgeSkyPastures.cs" />
    <!-- FORGE_DHOKKUR_WAYS_1 -->
    <Compile Include="RM_ForgeDhokkurWays.cs" />
    <Compile Include="Kernel\RM_CycleKernel.cs" />
    <Compile Include="Kernel\RM_PlumeKernel.cs" />
    <Compile Include="Kernel\RM_DhokkurKernel.cs" />
    <Compile Include="Kernel\RM_DormancyKernel.cs" />
    <Compile Include="Kernel\RM_SkyKernel.cs" />
  </ItemGroup>

  <!-- FORGE_CYCLE_MECHANICS_1: the cycle subclasses the F1 pulse
       (EnvironmentalHazards, a hard modDependency) and spawns FlowWorks water
       releases (FlowWorks is EnvironmentalHazards' own hard dependency, now
       declared here too). Build EnvironmentalHazards first. -->
  <ItemGroup>
    <Reference Include="RimMandrake.EnvironmentalHazards">
      <HintPath>..\..\EnvironmentalHazards\Assemblies\RimMandrake.EnvironmentalHazards.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RimMandrakeFlowWorks">
      <HintPath>..\..\FlowWorks\Assemblies\RimMandrakeFlowWorks.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
