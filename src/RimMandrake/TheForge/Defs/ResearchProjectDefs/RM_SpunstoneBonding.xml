<Defs>
  <ResearchProjectDef>
    <defName>RM_SpunstoneBonding</defName>
    <label>spunstone bonding</label>
    <description>Floatstone is strong the way a woven thing is strong: its glass threads hand strain to one another. Learn to lay it in the grain and it can brace a gravship's frame for almost no weight, hang a door that nobody slows for, and lay an airtight hull.</description>
    <baseCost>800</baseCost>
    <techLevel>Industrial</techLevel>
    <prerequisites>
      <li>BasicGravtech</li>
    </prerequisites>
    <researchViewX>10</researchViewX>
    <researchViewY>6.4</researchViewY>
  </ResearchProjectDef>
</Defs>
