<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_ColossalAerofleet_Twitch.xml: the greater bulloo's twitching feelers, built on the base game's own render tree.
  Owner ruling 2026-10-15, by card on Transient/phase0_p3_questions.md Q1: "Both twitch" (greater bulloo and zhool).
  Design: design/RimMandrake/tentacle_twitch_design_2026-10-15.md.

  MECHANISM (RimSage, 1.6 source): Verse.PawnRenderNodeProperties_Spastic, whose constructor sets
  nodeClass PawnRenderNode_Spastic and workerClass PawnRenderNodeWorker_Spastic. The node picks a new random
  rotation/scale/offset target every nextSpasmTicksRange and lerps to it over durationTicksRange
  (PawnRenderNode_Spastic.CheckAndDoSpasm); it holds still when dead, in portraits and in the render cache.
  Anomaly's Toughspike, Trispike and Fingerspike trees use exactly this. It is base game, not the donor's
  AlphaBehavioursAndEvents.PawnRenderNodeProperties_SpasticScaled, and no C# of ours runs here.

  INERT UNTIL THE ART LANDS. Nothing names this tree yet, and an unnamed tree resolves no texture (textures load at
  render time, PawnRenderNode.GraphicFor; PawnRenderNodeProperties.ConfigErrors checks classes only). The race keeps
  vanilla's Animal tree and its one whole-body picture. Patches/RM_ColossalAerofleet_TwitchWiring.xml switches the race
  to this tree and the body to the feeler-less bell; it sits in src/DEPLOY_HOLD.txt until the owner accepts the split art.

  GEOMETRY (cells from the pawn centre, z up; PROVISIONAL, tune live in Dialog_DebugRenderTree):
    Body: the vanilla Animal body node (1.6), whose mesh is the life stage's drawSize (2.5).
    Feelers: mesh 1x1 (drawSize 1, so Spastic's mesh and scale do not square it). Art contract: the feeler's ROOT is at
    the TOP CENTRE of its canvas and it hangs straight down. pivot (0.5, 0.05) puts the fixed point 0.45 above the mesh
    centre (PawnRenderNodeWorker.PivotFor: pivot = -(p - 0.5)), so the root sits at offset + (0, 0, 0.45) at every
    rotation and every drawData scale: offset.z = attach.z - 0.45.
    Layer: every feeler draws behind the body (-5/-6), so the bell's rim covers the root seam.
    West mirrors east: offsets mirror on their own (DrawData.OffsetForRot); flip and rotation are given explicitly, as
    vanilla's Toughspike does.
  linkedBodyPartsGroup Arms: the feelers vanish once every feeler is lost (PawnRenderNodeWorker.CanDrawNow).
-->
<Defs>

  <PawnRenderTreeDef>
    <defName>RM_ColossalAerofleet_Twitch</defName>
    <root Class="PawnRenderNodeProperties_Parent">
      <debugLabel>Root</debugLabel>
      <tagDef>Root</tagDef>
      <children>
        <li>
          <debugLabel>Body</debugLabel>
          <tagDef>Body</tagDef>
          <nodeClass>PawnRenderNode_AnimalPart_Body</nodeClass>
          <workerClass>PawnRenderNodeWorker_AnimalBody</workerClass>
          <useRottenColor>true</useRottenColor>
          <children>

            <!-- Feeler A: the long curled outer feeler, left and right. -->
            <li Class="PawnRenderNodeProperties_Spastic">
              <debugLabel>FeelerA_L</debugLabel>
              <texPath>Things/Pawn/Animal/RM_ColossalAerofleet/Feelers/RM_ColossalAerofleet_FeelerA</texPath>
              <linkedBodyPartsGroup>Arms</linkedBodyPartsGroup>
              <rotDrawMode>Fresh, Rotting</rotDrawMode>
              <useRottenColor>true</useRottenColor>
              <rotateFacing>false</rotateFacing>
              <rotationRange>-10~10</rotationRange>
              <scaleRange>0.96~1.04</scaleRange>
              <durationTicksRange>40~90</durationTicksRange>
              <nextSpasmTicksRange>20~80</nextSpasmTicksRange>
              <baseLayer>-5</baseLayer>
              <drawData>
                <defaultData><pivot>(0.5, 0.05)</pivot></defaultData>
                <dataSouth><offset>(-0.80, 0, -0.70)</offset><rotationOffset>12</rotationOffset></dataSouth>
                <dataNorth><offset>(0.80, 0, -0.65)</offset><rotationOffset>-12</rotationOffset><flip>true</flip></dataNorth>
                <dataEast><offset>(-0.70, 0, -0.65)</offset><rotationOffset>14</rotationOffset></dataEast>
                <dataWest><rotationOffset>-14</rotationOffset><flip>true</flip></dataWest>
              </drawData>
            </li>
            <li Class="PawnRenderNodeProperties_Spastic">
              <debugLabel>FeelerA_R</debugLabel>
              <texPath>Things/Pawn/Animal/RM_ColossalAerofleet/Feelers/RM_ColossalAerofleet_FeelerA</texPath>
              <linkedBodyPartsGroup>Arms</linkedBodyPartsGroup>
              <rotDrawMode>Fresh, Rotting</rotDrawMode>
              <useRottenColor>true</useRottenColor>
              <rotateFacing>false</rotateFacing>
              <rotationRange>-10~10</rotationRange>
              <scaleRange>0.96~1.04</scaleRange>
              <durationTicksRange>40~90</durationTicksRange>
              <nextSpasmTicksRange>20~80</nextSpasmTicksRange>
              <baseLayer>-5</baseLayer>
              <drawData>
                <defaultData><pivot>(0.5, 0.05)</pivot></defaultData>
                <dataSouth><offset>(0.80, 0, -0.70)</offset><rotationOffset>-12</rotationOffset><flip>true</flip></dataSouth>
                <dataNorth><offset>(-0.80, 0, -0.65)</offset><rotationOffset>12</rotationOffset></dataNorth>
                <dataEast><offset>(-0.50, 0, -0.62)</offset><rotationOffset>10</rotationOffset><layer>-6</layer></dataEast>
                <dataWest><rotationOffset>-10</rotationOffset><layer>-6</layer><flip>true</flip></dataWest>
