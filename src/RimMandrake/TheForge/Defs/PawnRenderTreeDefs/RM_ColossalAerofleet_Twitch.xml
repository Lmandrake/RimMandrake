                <dataEast><offset>(0.05, 0, -0.77)</offset><rotationOffset>8</rotationOffset><layer>-6</layer></dataEast>
                <dataWest><rotationOffset>-8</rotationOffset><layer>-6</layer><flip>true</flip></dataWest>
