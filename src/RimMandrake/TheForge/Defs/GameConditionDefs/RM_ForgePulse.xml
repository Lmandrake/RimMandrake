<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_ForgePulse.xml                      THEFORGE_RM_MOD_BUILD_1

  Moved out of src/RimUtinni/UtinniPatches/Defs/GameConditionDefs/
  RUT_ForgePulse.xml (FORGE_MECHANICS_1 F1), fields byte-identical, defName
  and its two weather references renamed to this mod's own RM_ForgeStill/
  RM_BoilingRain. Referenced directly in RM_TheForge_Biome.xml's own
  <biomeMapConditions> (no PatchOperationAdd wrapper needed - the guarding
  reason the original patch existed was that RUT_ForgePulse only exists when
  mandrake.rm.environmentalhazards is active; that mod is a hard
  modDependency of THIS mod, declared in About.xml, so the cross-reference
  can never dangle).

  scaldDamageDef still points at RUT_Scald
  (src/RimUtinni/UtinniPatches/Defs/DamageDefs/RUT_Scald.xml) - a shared
  cross-biome damage type ALREADY reused this way by RM_Greentide (confirmed
  by THEFORGE_RM_MOD_BUILD_1's own analysis, §6), so this is not a new
  cross-mod dependency pattern, just the existing one. Whether RUT_Scald
  itself should move to a shared RM_ tier is flagged UNCERTAIN in this
  item's own analysis and is not this build's call to resolve unilaterally.
-->
<Defs>

  <GameConditionDef>
    <defName>RM_ForgePulse</defName>
    <!-- FORGE_CYCLE_MECHANICS_1: the pulse class's own subclass, which keeps
         every pulse behaviour (bursts, scald, flash window) and adds the
         six-phase grand cycle around it (Source/RM_GameCondition_ForgeCycle.cs).
         With "Grand cycle" off in Mod Settings it behaves exactly as the bare
         RM_GameCondition_WeatherPulse did. -->
    <conditionClass>RimMandrake.TheForge.RM_GameCondition_ForgeCycle</conditionClass>
    <label>the mountain's breath</label>
    <description>The Forge rains on itself: long still heat, broken by sudden violent bursts of scalding rain that flash back to steam off the hot rock within seconds.</description>
    <canBePermanent>true</canBePermanent>
    <allowUnderground>true</allowUnderground>
    <modExtensions>
      <li Class="RimMandrake.EnvironmentalHazards.WeatherPulseExtension">
        <baseWeather>RM_ForgeStill</baseWeather>
        <burstWeather>RM_BoilingRain</burstWeather>
        <burstMtbHours>10</burstMtbHours>
        <burstDurationMinutesRange>20~40</burstDurationMinutesRange>
        <flashWindowHoursAfterBurstStart>2</flashWindowHoursAfterBurstStart>
        <scaldDamageDef>RUT_Scald</scaldDamageDef>
        <scaldDamageAmount>4</scaldDamageAmount>
        <scaldDamageIntervalTicks>60</scaldDamageIntervalTicks>
        <onlyUnroofed>true</onlyUnroofed>
      </li>
      <!-- The Forge's "Weather-pulse bursts" toggle (RM_TheForgeMod.cs registers
           this key). -->
      <li Class="RimMandrake.EnvironmentalHazards.RM_MechanicGateExtension">
        <gateKey>TheForge.Pulse</gateKey>
      </li>
      <!-- FORGE_CYCLE_MECHANICS_1: every number INVENTED (the item rules the
           order and content of the phases, not their lengths). -->
      <!-- FORGE_CYCLE_MECHANICS_1: every phase length, count, radius, chance and burn below is PROVISIONAL
           (owner ruling 2026-10-03: first-guess numbers ship, tuned live later). -->
      <li Class="RimMandrake.TheForge.RM_ForgeCycleExtension">
        <stillHours>48~72</stillHours>
        <gasWashHours>2~3</gasWashHours>
        <rainHours>6~9</rainHours>
        <freezeHours>10~14</freezeHours>
        <growthHours>54~66</growthHours>
        <cracksHours>6~8</cracksHours>
        <meltHours>1.5~2.5</meltHours>
        <hissLeadHours>1.5</hissLeadHours>
        <gasWashWaves>2~4</gasWashWaves>
        <gasWashRadius>7</gasWashRadius>
        <gasWashCellChance>0.3</gasWashCellChance>
        <gasWashFireSize>0.3~0.7</gasWashFireSize>
        <floodReleases>2~4</floodReleases>
        <floodTilesPerRelease>45</floodTilesPerRelease>
        <!-- LavaDeep is permanent top terrain (Odyssey lava mutators). LavaShallow
             is itself temporary (a lava flow) and is left alone. -->
        <freezableTerrains>
          <li>LavaDeep</li>
        </freezableTerrains>
        <basaltTerrain>RM_BasaltShingle</basaltTerrain>
        <pumiceTerrain>RM_PumiceRubble</pumiceTerrain>
        <pumiceChance>0.3</pumiceChance>
        <maxFrozenCells>6000</maxFrozenCells>
        <freezeWeather>Fog</freezeWeather>
        <gardenDef>RM_FloatstoneGarden</gardenDef>
        <gardenCount>5~10</gardenCount>
        <gardenStartGrowth>0.35</gardenStartGrowth>  <!-- ripens (0.9) inside the growth phase even with night rest -->
        <crackTerrain>RM_GlowingCrackCrust</crackTerrain>
        <meltPawnBurn>18</meltPawnBurn>
        <meltPawnBurnHits>4</meltPawnBurnHits>
      </li>
    </modExtensions>
  </GameConditionDef>

</Defs>
