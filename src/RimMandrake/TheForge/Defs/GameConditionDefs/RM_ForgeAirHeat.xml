<?xml version="1.0" encoding="utf-8"?>
<!--
  DIRECT_SUN_UNIFY_GEOMETRY_ALONE_DECIDES spec 6 (owner card 2026-10-19 on volcanic, steam and hot-fog heat: "Hotter air
  on the thermometer"). The Forge's volcanic air is hotter AIR: every map of the Forge (RM_TheForge) carries this condition permanently
  (Creature Behaviors RM_AirHeatExtension on the BiomeDef, RM_MapComponent_AirHeat). It is a vanilla
  GameCondition_TemperatureOffset: the thermometer shows it, rooms leak toward it, coolers fight it, insulation
  answers it, and plants feel it too. No shade cools it, and it is not Direct Sun. temperatureOffset 15 C is
  PROVISIONAL (it was the old felt offset); the mod's own settings switch it off or retune it.
-->
<Defs>
  <GameConditionDef>
    <defName>RM_ForgeAirHeat</defName>
    <label>volcanic air</label>
    <description>Heat rises off the living rock and the lava under it. The air itself is hotter here, by day and by night: shade does not cool it, a sealed and cooled room does.</description>
    <conditionClass>GameCondition_TemperatureOffset</conditionClass>
    <canBePermanent>true</canBePermanent>
    <natural>true</natural>
    <temperatureOffset>15</temperatureOffset>
  </GameConditionDef>
</Defs>
