<!-- FORGE_SKY_PASTURES_1 stage 5. The sky pasture wander, inserted at vanilla's Animal_PreWander tag (the
     RM_ThinkTree_UmmiskLavaEdge shape). Returns no job for any pawn it does not govern (not wild, no vapour-drifter
     comp and no RM_DhokkurColumnsExtension, a sealed dhokkur, its toggle off, or no column in reach), so every other
     animal falls through to vanilla wander unchanged. Source: Source/RM_ForgeSkyPastures.cs. -->
<Defs>
  <ThinkTreeDef>
    <defName>RM_ThinkTree_ForgeSkyPasture</defName>
    <insertTag>Animal_PreWander</insertTag>
    <thinkRoot Class="ThinkNode_Priority">
      <subNodes>
        <li Class="RimMandrake.TheForge.RM_JobGiver_SkyPastureWander" />
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>
</Defs>
