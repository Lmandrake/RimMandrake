<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    DONOR RETIREMENT (owner, 2026-10-18: "Just put in placeholder art for now or donor copies and retire these
    mods!!! Just get it done."). Everything the Forge still borrowed from Alpha Biomes (sarg.alphabiomes), ported
    as RM_ defs with the donor's own values: the three ground terrains, tinkle grass, the firevine tree, both
    volcanic-ash weathers and their mood thought. Art: StandIn/<donor texPath> marked stand-in copies (art ledger,
    provenance kind=donor standin=true) until regenerated. LavaSnail was never Alpha Biomes' (vanilla Odyssey).
  -->
  <!-- RM_BlackPebbles: port of AB_BlackPebbles (Alpha Biomes, TerrainDefs/Terrain_PyroclasticConflagration.xml), plain XML copy 2026-10-18 for donor retirement; no AlphaBiomes C# in it. -->
  <TerrainDef ParentName="NaturalTerrainBase">
    <defName>RM_BlackPebbles</defName>
    <label>black volcanic sand</label>
    <texturePath>StandIn/Terrain/Surfaces/AB_BlackPebbles</texturePath>
    <edgeType>FadeRough</edgeType>
    <renderPrecedence>350</renderPrecedence>
    <pathCost>12</pathCost>
    <statBases>
      <Beauty>-3</Beauty>
      <BeautyOutdoors>0</BeautyOutdoors>
    </statBases>
    <scatterType>SoftGray</scatterType>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>Diggable</li>
    </affordances>
    <generatedFilth>Filth_Dirt</generatedFilth>
    <fertility>0.05</fertility>
    <takeFootprints>True</takeFootprints>
  </TerrainDef>

  <!-- RM_HardenedGrass: port of AB_HardenedGrass (Alpha Biomes, TerrainDefs/Terrain_PyroclasticConflagration.xml), plain XML copy 2026-10-18 for donor retirement; no AlphaBiomes C# in it. -->
  <TerrainDef ParentName="NaturalTerrainBase">
    <defName>RM_HardenedGrass</defName>
    <label>hardened grass</label>
    <texturePath>StandIn/Terrain/Surfaces/AB_HardenedGrass</texturePath>
    <pollutedTexturePath>StandIn/Terrain/Surfaces/AB_HardenedGrass_Polluted</pollutedTexturePath>
    <pollutionOverlayTexturePath>Terrain/Surfaces/PollutionMud</pollutionOverlayTexturePath>
    <pollutionShaderType MayRequire="Ludeon.RimWorld.Biotech">TerrainFadeRoughSoftLight</pollutionShaderType>
    <pollutionColor>(214, 140, 234, 0.15)</pollutionColor>
    <edgeType>FadeRough</edgeType>
    <renderPrecedence>353</renderPrecedence>
    <pathCost>20</pathCost>
    <statBases>
      <Beauty>-5</Beauty>
      <BeautyOutdoors>0</BeautyOutdoors>
      <Cleanliness>-1</Cleanliness>
    </statBases>
    <scatterType>SoftGray</scatterType>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>Diggable</li>
    </affordances>
    <generatedFilth>Filth_Dirt</generatedFilth>
    <fertility>0.7</fertility>
    <takeFootprints>True</takeFootprints>
  </TerrainDef>

  <!-- RM_HardenedGrassFertile: port of AB_HardenedGrassFertile (Alpha Biomes, TerrainDefs/Terrain_PyroclasticConflagration.xml), plain XML copy 2026-10-18 for donor retirement; no AlphaBiomes C# in it. -->
  <TerrainDef ParentName="NaturalTerrainBase">
    <defName>RM_HardenedGrassFertile</defName>
    <label>fertile volcanic soil</label>
    <color>(160,140,140)</color>
    <texturePath>StandIn/Terrain/Surfaces/AB_HardenedGrass</texturePath>
    <edgeType>FadeRough</edgeType>
    <renderPrecedence>352</renderPrecedence>
    <pathCost>20</pathCost>
    <statBases>
      <Beauty>-5</Beauty>
      <BeautyOutdoors>0</BeautyOutdoors>
      <Cleanliness>-1</Cleanliness>
    </statBases>
    <scatterType>SoftGray</scatterType>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>Diggable</li>
    </affordances>
    <generatedFilth>Filth_Dirt</generatedFilth>
    <fertility>1.5</fertility>
