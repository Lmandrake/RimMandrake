<!--
  RM_TheForgeNatives.xml                 FORGE_RULED_CONTENT_1, new 2026-09-29

  The four natives admitted at FORGE_BEDAZZLE_SITTING_1 turn 4 ("1) admit.").
  Descriptions and frames from design/Jawa/worldbuilding/biomes/
  forge_bedazzle_cast_2026-09-29.md section 3. All four are invented names,
  so they are RM tier and wired inline in RM_TheForge_Biome.xml (Q11a).
  One home each: the Forge.

  Art: Textures/Things/Pawn/Animal/RM_<Name>/ (south/east/north,
  Graphic_Multi), from the FORGE_BEDAZZLE_SITTING_1 artpipe jobs.

  Numbers are design proposals (cast bible section 0); the ruled parts are
  the relationships: the dhokkur is the giant, the julmox is the tamable herd,
  the jossur is the sky apex, the dhuvvox is the swarm.

  FORGE_CYCLE_MECHANICS_1 (tranche 1) built the clock these creatures keep:
    - RM_CompForgeCycleDormancy (Source/RM_CompForgeCycleDormancy.cs) on top
      of stock CompCanBeDormant: the dhokkur wakes only in boiling rain; the
      julmox and the dhuvvox stay sealed until the rain and its flash window.
      Tamed animals never seal. Toggle: "Creatures sleep through the dry
      phases".
    - The sealed look: RM_DormantAnimalBody render tree
      (Defs/PawnRenderTreeDefs/) shows each life stage's
      stationaryGraphicData only while sealed. The dhokkur uses the shipped
      RM_DhokkurDormant sprite, the dhuvvox the RM_DhuvvoxNodule sprite; the
      julmox has no sealed sprite and simply lies still.
  Still owed (later tranche): the dhuvvox eruption "by the hundred" at a
  burst (today the ordinary wild population seals and hatches), and the
  dhokkur's path memory.
-->
<Defs>

  <!-- ============== Dhokkur: the giant on the clock ============== -->
  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Dhokkur</defName>
    <label>dhokkur</label>
    <description>Half the outcrops on the skirts are stone. The other half are waiting for rain. A dormant dhokkur sits out the still heat as a hill of banked obsidian plates, ash drifted into its seams, and the survey crews learn the difference the day the sky opens: the hill stands up. It walks its own path -- the same path, worn a thousand bursts deep -- drinking the scald straight off its back while everything else on the mountain runs for a roof. It is not angry. It has never needed to be. Its hide turns the boiling rain, and the boiling rain is the worst thing this mountain knows how to say.</description>
    <statBases>
      <MoveSpeed>1.6</MoveSpeed>
      <Mass>4000</Mass>
      <Flammability>0</Flammability>
      <MeatAmount>1000</MeatAmount>
      <LeatherAmount>200</LeatherAmount>
      <ArmorRating_Sharp>1.0</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.7</ArmorRating_Blunt>
      <ArmorRating_Heat>2.0</ArmorRating_Heat>
      <ComfyTemperatureMin>0</ComfyTemperatureMin>
      <ComfyTemperatureMax>120</ComfyTemperatureMax>
      <Wildness>0.98</Wildness>
    </statBases>
    <tools>
      <li>
        <label>front left leg</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>28</power>
        <cooldownTime>3.0</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftLeg</linkedBodyPartsGroup>
      </li>
      <li>
        <label>front right leg</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>28</power>
        <cooldownTime>3.0</cooldownTime>
        <linkedBodyPartsGroup>FrontRightLeg</linkedBodyPartsGroup>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>22</power>
        <cooldownTime>3.2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <comps>
      <!-- FORGE_CYCLE_MECHANICS_1: jobDormancy HOLDS it asleep; freezeNeeds
           keeps a long seal from starving it (RM_MuttavaqUttaqar precedent). -->
      <li Class="CompProperties_CanBeDormant">
        <startsDormant>true</startsDormant>
        <jobDormancy>true</jobDormancy>
        <freezeNeeds>
          <li>Food</li>
          <li>Rest</li>
        </freezeNeeds>
      </li>
      <li Class="CompProperties_WakeUpDormant">
        <wakeUpOnDamage>true</wakeUpOnDamage>
      </li>
      <li Class="RimMandrake.TheForge.CompProperties_ForgeCycleDormancy">
        <awakeDuringRain>true</awakeDuringRain>
        <awakeDuringFlashWindow>false</awakeDuringFlashWindow>
        <wakeMessage>The rain is falling and a hill on the skirts has stood up: a {0} is walking.</wakeMessage>
      </li>
    </comps>
    <race>
      <renderTree>RM_DormantAnimalBody</renderTree>
      <body>QuadrupedAnimalWithHooves</body>
      <baseBodySize>6.0</baseBodySize>
      <baseHealthScale>9.0</baseHealthScale>
      <!-- It drinks rain, not food: foodType None means no Food need at all
           (RM_Suush precedent, RaceProperties.EatsFood). -->
      <foodType>None</foodType>
      <predator>false</predator>
      <trainability>None</trainability>
      <lifeExpectancy>120</lifeExpectancy>
      <manhunterOnDamageChance>0.1</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0</manhunterOnTameFailChance>
      <herdAnimal>false</herdAnimal>
      <leatherDef>RM_DhokkurHide</leatherDef>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>2</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>6</minAge>
        </li>
      </lifeStageAges>
    </race>
    <tradeTags>
      <li>AnimalExotic</li>
    </tradeTags>
  </ThingDef>

