  <!-- ============== Jossur: the sky apex ==============
       REAL core-1.6 flight (flyer law): MaxFlightTime/FlightCooldown stats +
       Locust-shape race flags. No flight flip-book frames yet; a frameless
       flyer flies with no wing-beat, which is correct. Frames are a named
       follow-on (cast bible section 7). canLeaveMapFlying false: a resident
       apex, not a migrant. Rides the shipped F3 vapor-column layer through
       CompProperties_VaporDrifter (EnvironmentalHazards, the RM_FleetFlier
       precedent). Never live-test its flight unattended. -->
  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Jossur</defName>
    <label>jossur</label>
    <description>The columns are pasture, and every pasture gets its wolf. The jossur rides the vent updrafts on wings longer than the rest of it put together, hanging in the shimmer where the fleet fliers race and the young fumeriders drift -- and then it stops hanging. Grounded, it is an awkward folded thing, all wing-knuckle and stilt, mantling over its kill in the ash. Airborne, it is the reason the herds keep their young in the middle of the smoke.</description>
    <statBases>
      <MoveSpeed>3.6</MoveSpeed>
      <Mass>45</Mass>
      <Flammability>0.4</Flammability>
      <MeatAmount>60</MeatAmount>
      <LeatherAmount>0</LeatherAmount>
      <ArmorRating_Heat>0.6</ArmorRating_Heat>
      <ComfyTemperatureMin>-10</ComfyTemperatureMin>
      <ComfyTemperatureMax>80</ComfyTemperatureMax>
      <Wildness>0.95</Wildness>
      <MaxFlightTime>20</MaxFlightTime>
      <FlightCooldown>6</FlightCooldown>
    </statBases>
    <tools>
      <li>
        <label>talons</label>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>13</power>
        <cooldownTime>1.8</cooldownTime>
        <linkedBodyPartsGroup>Feet</linkedBodyPartsGroup>
      </li>
      <li>
        <label>hooked beak</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>15</power>
        <cooldownTime>2.2</cooldownTime>
        <linkedBodyPartsGroup>Beak</linkedBodyPartsGroup>
      </li>
    </tools>
    <comps>
      <li Class="RimMandrake.EnvironmentalHazards.CompProperties_VaporDrifter">
        <forageRadiusBeyondColumns>20</forageRadiusBeyondColumns>
        <groundHazardImmune>true</groundHazardImmune>
      </li>
    </comps>
    <race>
      <body>Bird</body>
      <predator>true</predator>
      <maxPreyBodySize>1.3</maxPreyBodySize>
      <baseBodySize>1.6</baseBodySize>
      <baseHungerRate>0.6</baseHungerRate>
      <baseHealthScale>1.4</baseHealthScale>
      <foodType>CarnivoreAnimal</foodType>
      <herdAnimal>false</herdAnimal>
      <trainability>None</trainability>
      <manhunterOnDamageChance>0.4</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0.1</manhunterOnTameFailChance>
      <lifeExpectancy>18</lifeExpectancy>
      <flightStartChanceOnJobStart>0.4</flightStartChanceOnJobStart>
      <flightSpeedFactor>2.5</flightSpeedFactor>
      <canFlyIntoMap>true</canFlyIntoMap>
      <canLeaveMapFlying>false</canLeaveMapFlying>
      <lifeStageAges>
        <li>
          <def>AnimalBabyTiny</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.3</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.8</minAge>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
    </race>
