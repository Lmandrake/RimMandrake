<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
  RM_Metallovore: owned RM_ port of the Alpha Animals Metallovore (sarg.alphaanimals AA_Metallovore, 1.6/Defs/ThingDefs_Races). Phase 0 step P2 (biome_sprint_kickoff_2026-10-15.md 0.5.3), tool src/RimMandrake/Utils/aa_port.py. Free RM_ tier, home mod TheForge.
  Stats, tools, race fields and pawnkind numbers are the donor's own, as the creature the game shows today
  (our rename/tolerance patches on the donor def are folded in). Departures:
    - wildBiomes dropped (the biome roster casts it); AnimalStatExtension (donor stat defs) dropped.
    - VEF.* comps and VEF_ abilities kept, guarded MayRequire OskarPotocki.VanillaFactionsExpanded.Core (a framework we keep, not the donor).
    - texPath is OUR final path; the PNGs are owed through artpipe (no donor art is reused). Until the art is
      installed through the art ledger this def has no picture: ART OWED, never a pass of the art bar.
    - dessicated donor art and alternate random graphics dropped (vanilla fallback).
    - folded 1 op(s) from src/RimUtinni/UtinniPatches/Patches/AnimalBiomeDuplicates_Generated.xml
    - useMeatFrom AA_Helixien -> Megaspider (vanilla; PROVISIONAL)
    - leatherDef Leather_Chitin dropped (decoration item; no art owed)
-->
  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Metallovore</defName>
    <label>metallovore</label>
    <description>Metallovores are repulsive creatures genetically modified to fill a very specific niche: eating metals. The writhing tentacles in the animal's mouth secrete an organic substance that is capable of quickly rusting and dissolving most common metals, turning them into small flakes that serve as sustenance for the metallovore. They prefer small chunks of metal, since they can be more easily digested, but they will resort to digging into rocks in search of new metal if they can find none available.\n\nPresumably, they were created to get rid of scrap metal, but they are mostly found in the wild now.</description>
    <statBases>
      <MoveSpeed>2.00</MoveSpeed>
      <ComfyTemperatureMin>-20</ComfyTemperatureMin>
      <ComfyTemperatureMax>85</ComfyTemperatureMax>
      <Flammability>0</Flammability>
      <MarketValue>150</MarketValue>
      <FilthRate>8</FilthRate>
      <Wildness>0.65</Wildness>
    </statBases>
    <tools>
      <li>
        <label>tentacle</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>15</power>
        <cooldownTime>1.65</cooldownTime>
        <linkedBodyPartsGroup>RM_TentacleAttackTool</linkedBodyPartsGroup>
      </li>
      <li>
        <label>body</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>7</power>
        <cooldownTime>1.65</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>8</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
    </tools>
    <comps>
      <li Class="VEF.AnimalBehaviours.CompProperties_EatWeirdFood" MayRequire="OskarPotocki.VanillaFactionsExpanded.Core">
        <customThingToEat>
          <li>ChunkSlagSteel</li>
          <li>Steel</li>
          <li>Silver</li>
          <li>Gold</li>
          <li>MineableSteel</li>
          <li>MineableSilver</li>
          <li>MineableGold</li>
        </customThingToEat>
        <nutrition>1</nutrition>
        <digThingIfMapEmpty>true</digThingIfMapEmpty>
        <thingToDigIfMapEmpty>ChunkSlagSteel</thingToDigIfMapEmpty>
        <fullyDestroyThing>false</fullyDestroyThing>
        <percentageOfDestruction>0.2</percentageOfDestruction>
        <needsWater>false</needsWater>
      </li>
    </comps>
    <race>
      <thinkTreeMain MayRequire="OskarPotocki.VanillaFactionsExpanded.Core">VEF_AnimalWeirdEater</thinkTreeMain>
      <body>RM_TentacledSlug</body>
      <baseBodySize>2</baseBodySize>
      <baseHealthScale>2</baseHealthScale>
      <baseHungerRate>0.85</baseHungerRate>
      <foodType>VegetarianRoughAnimal</foodType>
      <predator>false</predator>
      <useMeatFrom>Megaspider</useMeatFrom>
      <trainability>None</trainability>
      <manhunterOnTameFailChance>0.02</manhunterOnTameFailChance>
      <manhunterOnDamageChance>0.80</manhunterOnDamageChance>
      <gestationPeriodDays>10</gestationPeriodDays>
      <lifeExpectancy>7</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.2</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.3333</minAge>
          <soundWounded>Pawn_BigInsect_Pain</soundWounded>
          <soundDeath>Pawn_BigInsect_Death</soundDeath>
          <soundCall>Pawn_BigInsect_Call</soundCall>
          <soundAngry>Pawn_BigInsect_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <tradeTags>
      <li>AnimalUncommon</li>
    </tradeTags>
  </ThingDef>
