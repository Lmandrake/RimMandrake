<?xml version="1.0" encoding="utf-8"?>
<!--
  FORGE_GPT_ENRICHMENT_1 §7 — the dhuvvox clock: "they slow in the final
  quarter-hour". Added and removed by RM_CompForgeCycleDormancy (runClock).
  TUNED: Moving -0.4, enough to read as a visible slowdown without stopping them.
-->
<Defs>
  <HediffDef>
    <defName>RM_DhuvvoxRunSlowing</defName>
    <label>run ending</label>
    <description>The wet rock is drying and the run is nearly over. It is slowing, about to curl back into its nodule.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9, 0.6, 0.4)</defaultLabelColor>
    <isBad>false</isBad>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.4</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>
