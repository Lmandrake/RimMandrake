<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Invisible driver thing, same shape as vanilla SeasonalFlood and
       TorrentialRainFlood: an ethereal Thing whose thingClass IS the
       Flood subclass doing the spreading. -->
  <ThingDef ParentName="EtherealThingBase">
    <defName>RM_FluidCanalFlood</defName>
    <category>Ethereal</category>
    <drawerType>None</drawerType>
    <selectable>false</selectable>
    <thingClass>RimMandrake.FluidCanals.Flood_FluidCanal</thingClass>
    <tickerType>Normal</tickerType>
    <useHitPoints>false</useHitPoints>
  </ThingDef>

  <!-- 🔴 DEAD AS A CONCEPT — owner ruling 2026-09-16 (ruling 24, and the
       "a source IS terrain" ruling on FLOWWORKS_BUILD_PROGRAM_1). A source
       is not a building: it is a SUPERDEEP cell at F = D, limitless when
       fed off-map and limited when fed by rain, season and seepage.

       ⚠️ KEPT THIS PASS ON PURPOSE. This building plus CompFluidReservoir
       are the mod's ONLY live-proven path — all three of its modcheck
       components assert against this comp's runtime state. Deleting it
       before RM_MapComponent_Excavation has live proof of its own would
       leave the mod with no proof at all. Deletion rides the migration. -->
  <ThingDef ParentName="BuildingBase">
    <defName>RM_FluidSpring_Test</defName>
    <label>test fluid spring</label>
    <description>A test-only marker, and a leftover. Feeds water into any canal dug beside it. Sources are terrain now — a natural liquid body is itself the source — so this building is on its way out and nothing should be built around it.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>Things/Building/Misc/DropBeacon</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <size>(1,1)</size>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.2</fillPercent>
    <altitudeLayer>Building</altitudeLayer>
    <useHitPoints>true</useHitPoints>
    <!-- Owner ruling 2026-09-04 (canon_reintegration_plan.md sec G8): the
         reservoir now runs two independent recurring releases (drip + periodic
         re-flood) off CompTickRare instead of spending once and going inert;
         needs an actual ticker, which BuildingBase does not set by default. -->
    <tickerType>Rare</tickerType>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>0</Flammability>
      <Beauty>0</Beauty>
    </statBases>
    <selectable>true</selectable>
    <neverMultiSelect>false</neverMultiSelect>
    <comps>
      <li Class="RimMandrake.FluidCanals.CompProperties_FluidReservoir">
        <fluidDef>RM_Fluid_Water</fluidDef>
        <dripVolume>3</dripVolume>
        <dripIntervalTicks>2500</dripIntervalTicks>
        <reFloodVolume>60</reFloodVolume>
        <reFloodIntervalTicks>180000</reFloodIntervalTicks>
      </li>
    </comps>
  </ThingDef>

</Defs>
