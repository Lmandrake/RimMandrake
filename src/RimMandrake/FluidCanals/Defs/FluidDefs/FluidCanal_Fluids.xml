<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- The one fluid this v1 slice ships, chosen to prove genericity: reuses
       vanilla's own ShallowFloodwater terrain verbatim (real swim/extinguish
       behavior, the plant-sparing "Flood" tag, zero new art). Tar and the rest
       of the owner's named roster (ooze, slime, oil, propane) are deliberately
       NOT authored here; they are Utinni-tier content and belong in their own
       client mod once this engine is live-proven, per this item's own scope
       note.

       floodTerrain MUST be temporary=true (see FluidDef.ConfigErrors).
       ShallowFloodwater is the temporary sibling of WaterShallow, and is
       exactly what vanilla's own SeasonalFlood lays down: a release is
       destructive while it stands but recoverable, per the owner's
       2026-09-02 ruling. -->
  <RimMandrake.FluidCanals.FluidDef>
    <defName>RM_Fluid_Water</defName>
    <label>water</label>
    <!-- Ruling 5's three-tier ladder. Tier 1 is vanilla ShallowFloodwater
         verbatim; tiers 2 and 3 are the rungs vanilla has no temporary
         version of. A tier IS a volume, so the stock model quantises for
         free and the edge-aware ramp art comes with it at no cost. -->
    <floodTerrain>ShallowFloodwater</floodTerrain>
    <fillTerrainHalf>RM_Fill_Water_Half</fillTerrainHalf>
    <fillTerrainBrim>RM_Fill_Water_Brim</fillTerrainBrim>
    <fillTerrainSuperdeep>RM_Fill_Water_Superdeep</fillTerrainSuperdeep>
    <volumePerTile>1</volumePerTile>
    <ticksPerTile>60</ticksPerTile>
    <floodedTicks>300000</floodedTicks>
  </RimMandrake.FluidCanals.FluidDef>

</Defs>
