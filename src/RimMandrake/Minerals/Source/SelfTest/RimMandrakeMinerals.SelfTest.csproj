<Project Sdk="Microsoft.NET.Sdk">
  <!-- MINERAL_POLICY_CODE_STARTUP_ZEROING offline selftest. Plain net8.0, zero RimWorld references: ../Kernel/*.cs is the PRODUCTION file; registry, DeepDrill table and def fixture are parsed at run time. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Minerals.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.Minerals.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Kernel\RM_MineralPolicyKernel.cs" />
    <Compile Include="..\Kernel\RM_MineralSurfaceKernel.cs" />
    <Compile Include="..\Kernel\RM_MineralMeteoriteKernel.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
