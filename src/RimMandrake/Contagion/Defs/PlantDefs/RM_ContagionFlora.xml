<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    CONTAGION_NEW_SPECIES_FLORA_1. Three infection-front organisms from the cast bible
    section 5. None is food (ban 4): no Nutrition stat and no ingestible block on any of them.
    Wild-only, so no sowTags.
  -->

  <!-- Meatvine: twitching muscle vine, no yield, an ugly-environment contributor. -->
  <ThingDef ParentName="PlantBase">
    <defName>RM_Meatvine</defName>
    <label>meatvine</label>
    <description>A vine of twitching muscle tissue, anchored at both ends and flexing slowly like something testing a limb it has not finished growing. The goo trying out reach.</description>
    <statBases>
      <MaxHitPoints>40</MaxHitPoints>
      <Flammability>0.6</Flammability>
      <BeautyOutdoors>-4</BeautyOutdoors>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/RM_Meatvine/RM_Meatvine</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <selectable>false</selectable>
    <plant>
      <completelyIgnoreFertility>true</completelyIgnoreFertility>
      <fertilityMin>0</fertilityMin>
      <minGrowthTemperature>0</minGrowthTemperature>
      <minOptimalGrowthTemperature>15</minOptimalGrowthTemperature>
      <maxOptimalGrowthTemperature>45</maxOptimalGrowthTemperature>
      <maxGrowthTemperature>70</maxGrowthTemperature>
      <growMinGlow>0</growMinGlow>
      <growOptimalGlow>0</growOptimalGlow>
      <dieIfNoSunlight>false</dieIfNoSunlight>
      <dieIfLeafless>false</dieIfLeafless>
      <dieFromToxicFallout>false</dieFromToxicFallout>
      <neverBlightable>true</neverBlightable>
      <growDays>8</growDays>
      <lifespanDaysPerGrowDays>6</lifespanDaysPerGrowDays>
      <visualSizeRange>0.6~1.1</visualSizeRange>
      <maxMeshCount>4</maxMeshCount>
      <wildOrder>3</wildOrder>
      <topWindExposure>0</topWindExposure>
      <interferesWithRoof>false</interferesWithRoof>
    </plant>
  </ThingDef>

  <!-- Toothmoss: burn-line carpet of grinding teeth; walking it is slow. -->
  <ThingDef ParentName="PlantBase">
    <defName>RM_Toothmoss</defName>
    <label>toothmoss</label>
    <description>A carpet of small grinding teeth at the scorch margin, wearing themselves down chewing the sterilized matter back into soil the goo can take. Walking it is slow, and it crunches.</description>
    <statBases>
      <MaxHitPoints>25</MaxHitPoints>
      <Flammability>0.2</Flammability>
      <BeautyOutdoors>-2</BeautyOutdoors>
    </statBases>
    <pathCost>30</pathCost>
    <graphicData>
      <texPath>Things/Plant/RM_Toothmoss/RM_Toothmoss</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <selectable>false</selectable>
    <plant>
      <completelyIgnoreFertility>true</completelyIgnoreFertility>
      <fertilityMin>0</fertilityMin>
      <minGrowthTemperature>0</minGrowthTemperature>
      <minOptimalGrowthTemperature>25</minOptimalGrowthTemperature>
      <maxOptimalGrowthTemperature>70</maxOptimalGrowthTemperature>
      <maxGrowthTemperature>90</maxGrowthTemperature>
      <growMinGlow>0</growMinGlow>
      <growOptimalGlow>0</growOptimalGlow>
      <dieIfNoSunlight>false</dieIfNoSunlight>
      <dieIfLeafless>false</dieIfLeafless>
      <dieFromToxicFallout>false</dieFromToxicFallout>
      <neverBlightable>true</neverBlightable>
      <growDays>6</growDays>
      <lifespanDaysPerGrowDays>8</lifespanDaysPerGrowDays>
      <visualSizeRange>0.5~0.9</visualSizeRange>
      <maxMeshCount>9</maxMeshCount>
      <wildOrder>1</wildOrder>
      <topWindExposure>0</topWindExposure>
      <interferesWithRoof>false</interferesWithRoof>
    </plant>
  </ThingDef>

  <!--
    Wombpod: the in-world organ of the genome loop. Harvest yields RM_WombpodSac, which hatches
    (vanilla CompHatcher) into an AA_RedGoo, the amoeba host AmoebaHostUtility.IsEligibleHost
    accepts. The float-menu injection then works on that pawn unchanged; no C# is added here.
  -->
  <ThingDef ParentName="PlantBase">
    <defName>RM_Wombpod</defName>
    <label>wombpod</label>
    <description>Translucent gestation pods the goo grows in sheltered hollows, each with something part-made floating in it. Cutting one open frees a sac that will hatch into a red goo amoeba, the host a genome sample can be injected into. Never food.</description>
    <statBases>
      <MaxHitPoints>35</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <BeautyOutdoors>-3</BeautyOutdoors>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/RM_Wombpod/RM_Wombpod</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <selectable>true</selectable>
    <plant>
      <completelyIgnoreFertility>true</completelyIgnoreFertility>
      <fertilityMin>0</fertilityMin>
      <minGrowthTemperature>0</minGrowthTemperature>
      <minOptimalGrowthTemperature>15</minOptimalGrowthTemperature>
      <maxOptimalGrowthTemperature>45</maxOptimalGrowthTemperature>
      <maxGrowthTemperature>70</maxGrowthTemperature>
      <growMinGlow>0</growMinGlow>
      <growOptimalGlow>0</growOptimalGlow>
      <dieIfNoSunlight>false</dieIfNoSunlight>
      <dieIfLeafless>false</dieIfLeafless>
      <dieFromToxicFallout>false</dieFromToxicFallout>
      <neverBlightable>true</neverBlightable>
      <growDays>10</growDays>
      <lifespanDaysPerGrowDays>5</lifespanDaysPerGrowDays>
      <harvestTag>Standard</harvestTag>
      <harvestedThingDef>RM_WombpodSac</harvestedThingDef>
      <harvestYield>1</harvestYield>
      <harvestWork>150</harvestWork>
      <harvestMinGrowth>0.8</harvestMinGrowth>
      <visualSizeRange>0.5~0.8</visualSizeRange>
      <maxMeshCount>1</maxMeshCount>
      <wildOrder>3</wildOrder>
      <topWindExposure>0</topWindExposure>
      <interferesWithRoof>false</interferesWithRoof>
    </plant>
  </ThingDef>

  <!--
    CONTAGION_FLORA_PORT_1. Cast bible §4's nine flora ports, full RM_ development
    (owner ruling on CONTAGION_BEDAZZLE_SITTING_1: new defs, new names, new art, no
    patches). None edible, none foragable (ban 4) - no Nutrition stat, no
    <ingestible> block on any of them, same shape as Meatvine/Toothmoss/Wombpod above.
    Donor: Alpha Biomes (workshop 1841354677, packageId sarg.alphabiomes),
    1.6/Defs/ThingDefs_Plants/Plants_OcularForest.xml (+ Plants_Ocular_Polluted.xml
    for the blighted variant). Wired into RM_Contagion.xml's <wildPlants> in place of
    the donor AB_* rows, same change.
  -->

  <!-- Eyebark: the canopy - a tree studded with working eyes that track passers-by.
       Tapped by the Sparkleech; the Danglemaw hangs from it. Poor-yield wood harvest,
       long growDays. Art: RM_Eyebark_v2 IMPROVE pass (owner: "hang droopily downward
       like a willow"), validated pass, supersedes the v1 render. -->
  <ThingDef ParentName="PlantBase">
    <defName>RM_Eyebark</defName>
    <label>eyebark</label>
    <description>A gnarled alien tree whose red-brown bark is studded with dozens of working eyes, set in welted sockets up the trunk and along the boughs, all open and tracking. Its canopy hangs in long limp curtains of wet dark-red foliage, boughs bowed under the weight. The peaks' dominant organism -- the Sparkleech taps it, the Danglemaw hangs from it.</description>
    <statBases>
      <MaxHitPoints>220</MaxHitPoints>
      <Flammability>0.7</Flammability>
      <BeautyOutdoors>-6</BeautyOutdoors>
      <Mass>150</Mass>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/RM_Eyebark/RM_Eyebark</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <shadowData>
        <volume>(0.24, 0.3, 0.15)</volume>
        <offset>(0,0,-0.38)</offset>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <selectable>true</selectable>
    <fillPercent>0.35</fillPercent>
    <minifiedDef>MinifiedTree</minifiedDef>
    <passability>PassThroughOnly</passability>
    <pathCost>130</pathCost>
    <rotatable>false</rotatable>
    <blockWind>true</blockWind>
    <plant>
      <fertilityMin>0.05</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      <minGrowthTemperature>0</minGrowthTemperature>
      <minOptimalGrowthTemperature>15</minOptimalGrowthTemperature>
      <maxOptimalGrowthTemperature>45</maxOptimalGrowthTemperature>
      <maxGrowthTemperature>70</maxGrowthTemperature>
      <dieIfNoSunlight>false</dieIfNoSunlight>
      <dieIfLeafless>false</dieIfLeafless>
      <dieFromToxicFallout>false</dieFromToxicFallout>
      <neverBlightable>true</neverBlightable>
      <treeCategory>Full</treeCategory>
      <growDays>16</growDays>
      <lifespanDaysPerGrowDays>10</lifespanDaysPerGrowDays>
      <soundHarvesting>Harvest_Tree</soundHarvesting>
      <soundHarvestFinish>Harvest_Tree_Finish</soundHarvestFinish>
      <harvestWork>320</harvestWork>
      <harvestedThingDef>WoodLog</harvestedThingDef>
      <harvestTag>Wood</harvestTag>
      <harvestYield>6</harvestYield>
      <harvestMinGrowth>0.2</harvestMinGrowth>
      <harvestFailable>false</harvestFailable>
      <visualSizeRange>2.6~3.4</visualSizeRange>
      <maxMeshCount>1</maxMeshCount>
      <wildOrder>4</wildOrder>
      <topWindExposure>0.3</topWindExposure>
      <interferesWithRoof>true</interferesWithRoof>
      <burnedThingDef IsNull="True" />
      <choppedThingDef IsNull="True" />
      <smashedThingDef IsNull="True" />
    </plant>
  </ThingDef>

