<?xml version="1.0" encoding="utf-8"?>
<!--
  CONTAGION_MECHANICS_BUILD_1 Part 2 — the Coalescence (RM_Coalescence).

  One continuous organism: a stationary, faction-less organism-building
  (Building_RM_Coalescence). Formed only by RM_MapComponent_ContagionSky on a
  biome whose RM_ContagionSkyExtension names it (coalescenceDef), after a long
  Bloom (1.5 days since the last Burn), one per map. It pulls wild Unfinished
  within 18 cells to it and absorbs them (mass), gains a unit of mass every
  6000 ticks by itself, swaps through three staged sprites at mass 0 / 6 / 15,
  and emits manhunter Unfinished on a stage-scaled clock (capped by live
  manhunters on the map). It never moves — it cannot leave the storm shadow it
  formed in. ANY Burn (natural or Cloud-Repulsor-forced) collapses it into
  slime and sourceless genome samples (they gestate unmatched organs). All
  numbers are this build's INVENTED tuning.

  Art: artpipe coalescence_stage1, coalescence_stage2_v2, coalescence_stage3_v2
  (512, the owner-ruled "more gelatinous goop, less body" regens for 2 and 3).
  Draw sizes grow with the stage over a fixed 3x3 footprint.
-->
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>RM_Coalescence</defName>
    <label>the Coalescence</label>
    <description>The Contagion somewhere it has been left alone too long: a growing crimson mass of eyes and part-limbs gathering toward something with a middle. It draws the Unfinished into itself and sends the ones it does not eat out mad. It cannot survive the open sky; the next Burn will kill it.</description>
    <thingClass>RimMandrake.Contagion.Building_RM_Coalescence</thingClass>
    <tickerType>Normal</tickerType>
    <drawerType>RealtimeOnly</drawerType>
    <graphicData>
      <texPath>Things/Building/Coalescence/RM_Coalescence_Stage1</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3.5, 3.5)</drawSize>
    </graphicData>
    <size>(3, 3)</size>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>0.8</fillPercent>
    <blockWind>true</blockWind>
    <canOverlapZones>false</canOverlapZones>
    <useHitPoints>true</useHitPoints>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <filthLeaving>Filth_Slime</filthLeaving>
    <soundImpactDefault>BulletImpact_Flesh</soundImpactDefault>
    <statBases>
      <MaxHitPoints>1400</MaxHitPoints>
      <Flammability>0.4</Flammability>
      <Beauty>-40</Beauty>
    </statBases>
    <building>
      <claimable>false</claimable>
      <isInert>true</isInert>
    </building>
    <modExtensions>
      <li Class="RimMandrake.Contagion.RM_CoalescenceExtension">
        <stageGraphics>
          <li>
            <texPath>Things/Building/Coalescence/RM_Coalescence_Stage1</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(3.5, 3.5)</drawSize>
          </li>
          <li>
            <texPath>Things/Building/Coalescence/RM_Coalescence_Stage2</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(4.5, 4.5)</drawSize>
          </li>
          <li>
            <texPath>Things/Building/Coalescence/RM_Coalescence_Stage3</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(5.5, 5.5)</drawSize>
          </li>
        </stageGraphics>
        <stageMass>
          <li>0</li>
          <li>6</li>
          <li>15</li>
        </stageMass>
        <emitIntervalTicks>
          <li>5000</li>
          <li>3000</li>
          <li>1800</li>
        </emitIntervalTicks>
        <maxManhunters>
          <li>2</li>
          <li>4</li>
          <li>6</li>
        </maxManhunters>
        <absorbRadius>18</absorbRadius>
        <passiveGrowthTicks>6000</passiveGrowthTicks>
        <unfinishedKind>RM_TheUnfinished</unfinishedKind>
        <sampleDef>RM_GenomeSample</sampleDef>
        <samplesBase>2</samplesBase>
        <samplesPerStage>2</samplesPerStage>
        <massPerSample>4</massPerSample>
        <samplesMax>14</samplesMax>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
