<?xml version="1.0" encoding="utf-8"?>
<!--
  CONTAGION_MECHANICS_BUILD_1 Part 4 — the Sunbeam (RM_Sunbeam).
  Helix handheld UV projector: "the clear sky made portable". Purchasable +
  quest-given (item §4) — so NO recipe here; trade tables and quest rewards
  are BENCH's to wire (tradeTags/thingSetMakerTags below are the hooks).

  Damage: RM_UVBeam (DamageWorker_RM_UV) at 5 per shot, 3-shot burst — weak
  against people, and every hit is an RM_UVSunburn injury that scars readily
  (becomePermanentChanceFactor 3). Against a Contagion native the worker
  multiplies the hit by the Mod Settings "Sunbeam vs natives" factor (default
  6x → 30 per shot). All numbers are this build's INVENTED tuning.

  NOT BUILT HERE: the ruled ARREST use (a medical use that stops Contagion-
  touched mutation progression). No Contagion-touched progression hediff
  exists in src/ yet, so there is nothing for an arrest to stop.

  Art: artpipe job RM_Sunbeam (validated pass, 2026-09-28), mirrored to face
  right like vanilla weapon textures.
-->
<Defs>

  <DamageDef ParentName="Flame">
    <defName>RM_UVBeam</defName>
    <label>ultraviolet</label>
    <workerClass>RimMandrake.Contagion.DamageWorker_RM_UV</workerClass>
    <deathMessage>{0} has been burned to death by ultraviolet light.</deathMessage>
    <hediff>RM_UVSunburn</hediff>
    <defaultDamage>5</defaultDamage>
    <explosionHeatEnergyPerCell>0</explosionHeatEnergyPerCell>
  </DamageDef>

  <HediffDef ParentName="BurnBase">
    <defName>RM_UVSunburn</defName>
    <label>UV burn</label>
    <labelNoun>a UV burn</labelNoun>
    <description>A deep ultraviolet burn from a Helix sunbeam: blistered, weeping skin that scars badly.</description>
    <comps>
      <li Class="HediffCompProperties_GetsPermanent">
        <permanentLabel>sunburn scar</permanentLabel>
        <becomePermanentChanceFactor>3</becomePermanentChanceFactor>
      </li>
    </comps>
    <injuryProps>
      <destroyedLabel>Burned off</destroyedLabel>
      <destroyedOutLabel>Burned out</destroyedOutLabel>
    </injuryProps>
  </HediffDef>

  <ThingDef ParentName="BaseBullet">
    <defName>RM_Bullet_Sunbeam</defName>
    <label>sunbeam pulse</label>
    <graphicData>
      <texPath>Things/Projectile/Charge_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(0.85,0.8,1)</color>
    </graphicData>
    <projectile>
      <damageDef>RM_UVBeam</damageDef>
      <damageAmountBase>5</damageAmountBase>
      <armorPenetrationBase>0.1</armorPenetrationBase>
      <speed>90</speed>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="BaseGun">
    <defName>RM_Sunbeam</defName>
    <label>sunbeam</label>
    <description>A handheld Helix ultraviolet projector: a flared lens hood over a cell that holds, the Helix say, a piece of clear sky. Against people it is a poor weapon — shallow burns that scar badly. Against anything born under the Contagion's storm it is murderous: the one ranged answer the Bloom respects.</description>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <texPath>Things/Item/Equipment/RM_Sunbeam</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Interact_ChargeRifle</soundInteract>
    <tradeability>All</tradeability>
    <!-- No recipeMaker (purchasable/quest-given only, per this file's own
         header) — but BaseGun sets smeltable=true with no costList of its
         own, and with none inherited here smelting had nothing to give back
         (ThingDef.ConfigErrors "is smeltable but does not give anything for
         smelting"). A costList feeds value/smelt calc without implying a
         craft recipe — same posture vanilla's own Gun_ChargeLance_Unique
         uses (recipeMaker explicitly nulled, costList still inherited). -->
    <costList>
      <Steel>45</Steel>
      <ComponentSpacer>3</ComponentSpacer>
    </costList>
    <statBases>
      <MarketValue>1400</MarketValue>
      <Mass>3.2</Mass>
      <AccuracyTouch>0.7</AccuracyTouch>
      <AccuracyShort>0.7</AccuracyShort>
      <AccuracyMedium>0.55</AccuracyMedium>
      <AccuracyLong>0.35</AccuracyLong>
      <RangedWeapon_Cooldown>1.8</RangedWeapon_Cooldown>
    </statBases>
    <thingSetMakerTags>
      <li>RewardStandardQualitySuper</li>
    </thingSetMakerTags>
    <tradeTags>
      <li>WeaponRanged</li>
    </tradeTags>
    <weaponClasses>
      <li>RangedLight</li>
    </weaponClasses>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>RM_Bullet_Sunbeam</defaultProjectile>
        <warmupTime>1</warmupTime>
        <range>19.9</range>
        <ticksBetweenBurstShots>10</ticksBetweenBurstShots>
        <burstShotCount>3</burstShotCount>
        <soundCast>Shot_ChargeRifle</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>lens hood</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>8</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
  </ThingDef>

</Defs>
