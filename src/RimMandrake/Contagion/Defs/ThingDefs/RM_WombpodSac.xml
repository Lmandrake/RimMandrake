<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    CONTAGION_NEW_SPECIES_FLORA_1. The Wombpod harvest. A vanilla CompHatcher turns it into the
    RM_BloodyMess amoeba host of the genome loop (AmoebaHostUtility.HostDefName), our own
    race, so no mod gate is needed. The icon reuses the Wombpod plant
    texture as a placeholder, so a dedicated item icon is a fair follow-on.
  -->
  <ThingDef ParentName="ResourceBase">
    <defName>RM_WombpodSac</defName>
    <label>wombpod sac</label>
    <description>A translucent sac cut from a wombpod, something part-made turning slowly inside. Left alone it hatches into a bloody mess, the host a genome sample can be injected into.</description>
    <thingClass>ThingWithComps</thingClass>
    <graphicData>
      <texPath>Things/Plant/RM_Wombpod/RM_Wombpod</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.6, 0.6)</drawSize>
    </graphicData>
    <stackLimit>5</stackLimit>
    <statBases>
      <MaxHitPoints>30</MaxHitPoints>
      <Mass>0.4</Mass>
      <Flammability>0.5</Flammability>
      <MarketValue>15</MarketValue>
    </statBases>
    <thingCategories>
      <li>ItemsMisc</li>
    </thingCategories>
    <tradeability>None</tradeability>
    <comps>
      <li Class="CompProperties_Hatcher">
        <hatcherDaystoHatch>3</hatcherDaystoHatch>
        <hatcherPawn>RM_BloodyMess</hatcherPawn>
      </li>
    </comps>
  </ThingDef>

</Defs>
