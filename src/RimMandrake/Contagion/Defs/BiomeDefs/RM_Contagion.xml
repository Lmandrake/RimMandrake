<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    RM_Contagion                        CONTAGION_RM_MOD_BUILD_1, new 2026-09-25

    Copied verbatim from the frozen src/RimUtinni/UtinniPatches/Defs/BiomeDefs/
    RUT_Contagion.xml (156 lines, authored 2026-09-09) per
    design/RimMandrake/biome_mod_architecture.md §5 Phase A step 2. Every field
    below is the twin's own content, unchanged, EXCEPT:

      - workerClass: the donor AlphaBiomes.BiomeWorker_OcularForest becomes this
        mod's own RimMandrake.Contagion.RM_BiomeWorker_Contagion (§5 step 2 — a
        donor type in workerClass is a hard dependency the RimMandrake tier may
        not assume). The new worker's placement ranges are [INVENTED], same
        footing as the sibling Forsaken Crags/Blue Desert mods' own worker
        ranges — no worldgen run has been done for this mod and the campaign
        world is frozen and hand-authored, so one never will be for Ash'karr.
      - RUT_Sytheclaw gains an explicit MayRequire="mandrake.rut.patches": it
        is a RimMandrake-tier creature (not Star Wars) whose ThingDef/
        PawnKindDef still live in the RimUtinni tier
        (RUT_PyrelandsPortedFauna.xml), shared inline across three biomes
        (Pyrelands, Greentide, here). Without the gate this def would carry a
        live cross-tier hard dependency the franchise-free RimMandrake tier
        may not assume — same caution WildAnimals_Greentide.xml already
        records for this same creature. `BIOME_SPECIFIC_FAUNA_LAW_1` lists it
        among 52 unadjudicated multi-homed species; multi-home evictions are
        stopped by owner ruling, so it is not moved or renamed here.

    Everything else — texture, terrain, weather, diseases, all 10 remaining
    wildAnimals rows, all 10 wildPlants rows — is the twin's content unchanged.
    Zero RSW_/SW_/mlie.* rows exist in the twin's wildAnimals (MEASURED,
    CONTAGION_RM_MOD_BUILD_1's own STATE section §3), so nothing moves to a
    Utinni patch from THIS def — unlike most sibling RM_ biome mods, there is
    no WildAnimals_Contagion.xml.

    ⚠️ NOT donor-free: terrain/texture and all 10 wildPlants entries carry no
    MayRequire (inherited from the twin, not this build's scope to fix) — see
    About.xml for the disclosure. RUT_RustPuff keeps its existing
    MayRequire="mandrake.rut.rotsporekit" cross-mod dependency, unchanged.
  -->

  <BiomeDef>
    <defName>RM_Contagion</defName>
    <label>the Contagion</label>
    <description>A red valley on a scalded mountain, roofed by a thunderstorm that has never been known to stop. Under the cloud everything is wet, warm and unfinished: trees half-way to being something else, animals with one design completed and two abandoned. Then the cloud tears -- and the sun comes through like a sterilizing lamp, and everything alive dives for cover, because here the clear sky is the killer.</description>
    <workerClass>RimMandrake.Contagion.RM_BiomeWorker_Contagion</workerClass>
    <lakeBeachTerrain>GU_AlienSandFine</lakeBeachTerrain>
    <mudTerrain>GU_AlienSandFine</mudTerrain>
    <riverbankTerrain>GU_AlienSandFine</riverbankTerrain>
    <allowRoads>true</allowRoads>
    <allowRivers>true</allowRivers>
    <allowFarmingCamps>true</allowFarmingCamps>
    <animalDensity>3.0</animalDensity>
    <plantDensity>0.35</plantDensity>
    <forageability>0.0</forageability>
    <movementDifficulty>1</movementDifficulty>
    <texture>Biomes/AB_OcularForest</texture>
    <diseaseMtbDays>30</diseaseMtbDays>
    <diseases>
      <li MayRequire="sarg.alphabiomes">
        <diseaseInc>AB_Disease_SporesAllergy</diseaseInc>
        <commonality>50</commonality>
      </li>
      <li MayRequire="sarg.alphabiomes">
        <diseaseInc>AB_Disease_AnimalSporesAllergy</diseaseInc>
        <commonality>50</commonality>
      </li>
      <li>
        <diseaseInc>Disease_Malaria</diseaseInc>
        <commonality>160</commonality>
      </li>
      <li>
        <diseaseInc>Disease_SleepingSickness</diseaseInc>
        <commonality>140</commonality>
      </li>
      <li>
        <diseaseInc>Disease_Flu</diseaseInc>
        <commonality>100</commonality>
      </li>
      <li>
        <diseaseInc>Disease_Plague</diseaseInc>
        <commonality>100</commonality>
      </li>
      <li>
        <diseaseInc>Disease_GutWorms</diseaseInc>
        <commonality>80</commonality>
      </li>
      <li>
        <diseaseInc>Disease_MuscleParasites</diseaseInc>
        <commonality>80</commonality>
      </li>
    </diseases>
    <terrainsByFertility>
      <li>
        <terrain>GU_AlienSandFine</terrain>
        <min>-999</min>
        <max>0.2</max>
      </li>
      <li>
        <terrain>GU_AlienSand</terrain>
        <min>0.2</min>
        <max>0.87</max>
      </li>
      <li>
        <terrain>GU_RichAlienSand</terrain>
        <min>0.87</min>
        <max>999</max>
      </li>
    </terrainsByFertility>
    <baseWeatherCommonalities>
      <AB_RedFog MayRequire="sarg.alphabiomes">70</AB_RedFog>
      <Clear>8</Clear>
      <Rain>1</Rain>
      <DryThunderstorm>1</DryThunderstorm>
      <RainyThunderstorm>1</RainyThunderstorm>
      <FoggyRain>1</FoggyRain>
    </baseWeatherCommonalities>
    <wildAnimals>
      <AA_OcularJelly MayRequire="sarg.alphaanimals">2.0</AA_OcularJelly>  <!-- ocular jelly - the-eyes, keep -->
      <AA_RedSpore MayRequire="sarg.alphaanimals">0.85</AA_RedSpore>  <!-- red spore - the-leaker, keep -->
      <AA_RedGoo MayRequire="sarg.alphaanimals">0.75</AA_RedGoo>  <!-- red goo - the-body, keep -->
      <AA_InfectedAerofleet MayRequire="sarg.alphaanimals">0.5</AA_InfectedAerofleet>  <!-- infected aerofleet - the-sower, keep -->
      <AA_BloodShrimp MayRequire="sarg.alphaanimals">0.2</AA_BloodShrimp>  <!-- blood shrimp - the-drinker, adjust-keep -->
      <AA_Drainer MayRequire="sarg.alphaanimals">0.15</AA_Drainer>  <!-- drainer - the-thieves, adjust-keep -->
      <RUT_Sytheclaw MayRequire="mandrake.rut.patches">0.15</RUT_Sytheclaw>  <!-- sytheclaw - the-pickers, adjust-keep; RimMandrake-tier creature whose def still lives in RimUtinni (RUT_PyrelandsPortedFauna.xml) — gated per this file's own header note, not evicted (multi-home evictions are stopped) -->
      <AA_Helixien MayRequire="sarg.alphaanimals">0.1</AA_Helixien>  <!-- helixien - the-undertaker, adjust-keep -->
      <AA_RoughPlatedMonitor MayRequire="sarg.alphaanimals">0.1</AA_RoughPlatedMonitor>  <!-- rough-plated monitor - the-basker, keep -->
      <AA_Swarmling MayRequire="sarg.alphaanimals">0.1</AA_Swarmling>  <!-- swarmling - the-pickers, adjust-keep -->
      <AA_DrainerLarva MayRequire="sarg.alphaanimals">0.05</AA_DrainerLarva>  <!-- drainer larva - the-thieves, keep -->
    </wildAnimals>
    <coastalWildAnimals />
    <wildPlants>
      <AB_AlienGrass>1.0</AB_AlienGrass>  <!-- ocular grass -->
      <AB_AlienTree>1.0</AB_AlienTree>  <!-- ocular tree - tree -->
      <AB_RedLeaves>0.6</AB_RedLeaves>  <!-- ocular plant -->
      <AB_HalfAlienTree>0.5</AB_HalfAlienTree>  <!-- half transformed ocular tree - tree -->
      <AB_RedPlantsTall>0.5</AB_RedPlantsTall>  <!-- ocular plant -->
      <AB_GlobularPlant>0.4</AB_GlobularPlant>  <!-- globular aberration -->
      <AB_TentacularPlant>0.4</AB_TentacularPlant>  <!-- tentacular aberration -->
      <AB_BloodBouquet>0.3</AB_BloodBouquet>  <!-- blood bouquet -->
      <RUT_RustPuff MayRequire="mandrake.rut.rotsporekit">0.3</RUT_RustPuff>  <!-- rust puff -->
      <AB_AlienTree_Polluted>0.15</AB_AlienTree_Polluted>  <!-- mutated ocular tree - tree -->
    </wildPlants>
    <wildPlantRegrowDays>25</wildPlantRegrowDays>
  </BiomeDef>

</Defs>
