<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WEBWORK_RM_MOD_BUILD_1. Same recipe as
    src/RimMandrake/Greentide/Source/RM_Greentide.csproj — copy that header
    if this one goes stale.

    Build (the dotnet is WINDOWS-NATIVE and cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\RimMandrake\src\RimMandrake\Webwork\Source\RM_Webwork.csproj -c Release

    Output lands in ../Assemblies/, which is where RimWorld looks.

    One Harmony patch (WEB_SIEGE_DESIGN_SPIDERS_BRING_SHADE: a siege-wrapped door
    opens for no one, RM_WebworkSiege.cs); everything else is a plain engine
    extension point (BiomeWorker, ModSettings, ThingComp, IncidentWorker, LordJob).
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrake.Webwork</AssemblyName>
    <RootNamespace>RimMandrake.Webwork</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="RM_BiomeWorker_Webwork.cs" />
    <Compile Include="RM_WebworkMod.cs" />
    <Compile Include="..\..\_Shared\SettingsKit\SettingsKitCore.cs" Link="Shared\SettingsKitCore.cs" />
    <Compile Include="..\..\_Shared\SettingsKit\SettingsKitDrawer.cs" Link="Shared\SettingsKitDrawer.cs" />
    <Compile Include="RM_CompEmergentSpawnOnDestroy.cs" />
    <Compile Include="RM_CompHarvestYield.cs" />
    <Compile Include="RM_GenStep_WebworkNest.cs" />
    <Compile Include="RM_CompEggClutchRelay.cs" />
    <Compile Include="RM_WebworkStartupGate.cs" />
    <Compile Include="RM_StockGenerator_ThrixweaveResale.cs" />
    <Compile Include="RM_WebworkProof.cs" />
    <Compile Include="RM_UrravethRemains.cs" />
    <Compile Include="RM_UrravethProof.cs" />
    <Compile Include="RM_GenStep_WebworkWeb.cs" />
    <Compile Include="RM_WebworkArt.cs" />
    <Compile Include="Kernel\RM_WebworkKernel.cs" />
    <Compile Include="Kernel\RM_WebworkSiegeKernel.cs" />
    <Compile Include="RM_WebworkSiege.cs" />
    <Compile Include="RM_WebworkSiegeProof.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- WEB_SIEGE_DESIGN_SPIDERS_BRING_SHADE: the siege reads the sun-scald predicate and the shade grid (hard modDependency
         on mandrake.rm.creaturebehaviors, already declared) and patches Building_Door with Harmony (brrainz.harmony, declared). -->
    <Reference Include="RimMandrake.CreatureBehaviors">
      <HintPath>..\..\CreatureBehaviors\Assemblies\RimMandrake.CreatureBehaviors.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
