<?xml version="1.0" encoding="utf-8"?>
<!--
  GRAVSHIP_ACOUSTIC_SCANNER_1: the acoustic-scanner payload for RM_Webwork.
  Owner decision by question card 2026-10-06: the payload goes on EVERY biome of ours.

  Pure XML, FindMod-guarded on "RimMandrake: Acoustic Scanner", so the extension class
  is only named while its assembly is active. Every def is a defName STRING resolved
  at pulse time (GetNamedSilentFail), so a target naming another mod's def just hears
  nothing when that mod is absent. Each target is drawn from this biome's own content;
  the biome's sitting may re-author it. The reading is always banded by the scanner.
-->
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>RimMandrake: Acoustic Scanner</li>
    </mods>
    <match Class="PatchOperationAddModExtension">
      <xpath>/Defs/BiomeDef[defName="RM_Webwork"]</xpath>
      <value>
        <li Class="RimMandrake.AcousticScanner.RM_AcousticPayloadExtension">
          <quietText>Silk and root and stolen water. The thicket churns, and none of it is hiding.</quietText>
          <targets>
            <li>
              <label>urraveth remains</label>
              <reading>Huge bones wrapped in silk, ringing hollow and muffled at once.</reading>
              <color>(0.95, 0.9, 0.75)</color>
              <weight>2</weight>
              <thingDefs>
                <li>RM_Urraveth_Skull</li>
                <li>RM_Urraveth_NeckRun</li>
                <li>RM_Urraveth_RibSection</li>
                <li>RM_Urraveth_Pelvis</li>
                <li>RM_Urraveth_LimbPile</li>
              </thingDefs>
            </li>
            <li>
              <label>nest</label>
              <reading>A thick, packed echo, and inside it many small leathery ones.</reading>
              <color>(0.85, 0.5, 1)</color>
              <weight>2</weight>
              <thingDefs>
                <li>RM_Webwork_NestWall</li>
                <li>RM_Webwork_EggClutch</li>
              </thingDefs>
            </li>
            <li>
              <label>ollathrix</label>
              <reading>Something with a lot of legs, very still, holding a line taut.</reading>
              <color>(1, 0.4, 0.3)</color>
              <weight>2</weight>
              <pawnRaces>
                <li>RM_Ollathrix</li>
              </pawnRaces>
            </li>
            <li>
              <label>void under the roots</label>
              <reading>The pulse falls into a hollow under the root mat.</reading>
              <color>(0.6, 0.6, 0.9)</color>
              <hiddenCaves>true</hiddenCaves>
              <cellSampleStride>4</cellSampleStride>
            </li>
          </targets>
        </li>
      </value>
    </match>
  </Operation>
</Patch>
