<?xml version="1.0" encoding="utf-8" ?>
<!-- WEBWORK_RM_MOD_BUILD_1 scaffolded this def; WEBWORK_FLORA_ROSTER_1 (this
     build) replaces its interim vanilla-Core wildPlants placeholder with the
     real 16-row invented flora roster
     (design/Jawa/worldbuilding/biomes/webwork_flora_roster_2026-09-23.md,
     defs in Defs/ThingDefs_Plants/RM_WebworkFlora.xml). wildAnimals is
     unaffected by this item and stays the vanilla-Core placeholder pending
     WEBWORK_FAUNA_ROSTER_1.

     Terrain is still vanilla-only by design, same pattern as the sibling
     Greentide/Pyrelands mods: the frozen twin's own terrainsByFertility used
     Alpha Biomes' AB_DenseMud/AB_DenseGrass — none of that may ship in a
     RimMandrake-tier def (§7 Q11). The genuine canon Star Wars
     `Plant_TookeTrap_Wild` rides
     UtinniPatches/Patches/WildPlants_Webwork.xml instead (sitting record §6
     ruling 8, "kept low") — never this def. -->
<Defs>

  <BiomeDef>
    <defName>RM_Webwork</defName>
    <!-- No modExtensions in Phase A: the frozen twin's RM_FrontCreepExtension
         names RUT_Webwork_Anchor/_Web/_Gutter, Utinni-tier structures not
         ported here (WEBWORK_WEB_STRUCTURES_1's scope) — an extension naming
         no front things would do nothing, so it is left off until that item
         builds the structures and can wire it for real. -->
    <label>the Webwork</label>
    <description>The place where the plants grew so dense and thick that they drank their entire river -- soaked it up into a thicket of terrible, nightmare plants ever churning against itself. The map shows a jungle with no water because the water is inside. It is eerily silent -- most of the animals have been eaten, and few will enter. Those who do frequently discover a shadow, seconds before it lands upon them, and know nothing more.</description>
    <workerClass>RimMandrake.Webwork.RM_BiomeWorker_Webwork</workerClass>
    <texture>World/Biomes/TropicalRainforest</texture>
    <foragedFood>RawBerries</foragedFood>
    <allowRoads>true</allowRoads>
    <allowRivers>true</allowRivers>
    <allowFarmingCamps>true</allowFarmingCamps>
    <animalDensity>1.0</animalDensity>
    <plantDensity>0.9</plantDensity>
    <forageability>1.0</forageability>
    <movementDifficulty>2</movementDifficulty>
    <wildPlantRegrowDays>15</wildPlantRegrowDays>
    <diseaseMtbDays>35</diseaseMtbDays>

    <diseases>
      <li>
        <diseaseInc>Disease_Malaria</diseaseInc>
        <commonality>160</commonality>
      </li>
      <li>
        <diseaseInc>Disease_SleepingSickness</diseaseInc>
        <commonality>140</commonality>
      </li>
      <li>
        <diseaseInc>Disease_Flu</diseaseInc>
        <commonality>100</commonality>
      </li>
      <li>
        <diseaseInc>Disease_Plague</diseaseInc>
        <commonality>100</commonality>
      </li>
      <li>
        <diseaseInc>Disease_GutWorms</diseaseInc>
        <commonality>80</commonality>
      </li>
      <li>
        <diseaseInc>Disease_MuscleParasites</diseaseInc>
        <commonality>80</commonality>
      </li>
    </diseases>

    <!-- Vanilla-only, unlike the frozen twin's AB_DenseMud/AB_DenseGrass —
         same fertility breakpoints, Core terrain names. -->
    <terrainsByFertility>
      <li>
        <terrain>Mud</terrain>
        <min>-999</min>
        <max>0.35</max>
      </li>
      <li>
        <terrain>Soil</terrain>
        <min>0.35</min>
        <max>0.87</max>
      </li>
      <li>
        <terrain>SoilRich</terrain>
        <min>0.87</min>
        <max>999</max>
      </li>
    </terrainsByFertility>

    <baseWeatherCommonalities>
      <Clear>50</Clear>
      <Fog>5</Fog>
      <Rain>5</Rain>
      <DryThunderstorm>1</DryThunderstorm>
      <RainyThunderstorm>5</RainyThunderstorm>
      <FoggyRain>3</FoggyRain>
      <SnowGentle>0</SnowGentle>
      <SnowHard>0</SnowHard>
    </baseWeatherCommonalities>

    <!-- Vanilla-core roster only — no third-party or franchise-specific
         fauna, no MayRequire on a third-party bestiary. Megaspider fits the
         Webwork's own "shadow in the canopy" theme without naming anything.
         WEBWORK_FAUNA_ROSTER_1 adds the invented RM-tier cast on top; the
         frozen twin's Star Wars cast rides WildAnimals_Webwork.xml instead of
         this def. -->
    <wildAnimals>
      <Rat>0.8</Rat>
      <Hare>0.5</Hare>
      <Muffalo>0.2</Muffalo>
      <Cobra>0.3</Cobra>
      <Megaspider>0.15</Megaspider>
    </wildAnimals>
    <coastalWildAnimals />
    <!-- WEBWORK_FLORA_ROSTER_1: 16 RM_-tier invented rows, organised in the
         roster doc's four registers (thicket / plumbing / nightmare plants /
         white half+margin). Replaces the vanilla-Core placeholder this def
         shipped at scaffold time. The genuine canon `Plant_TookeTrap_Wild`
         is NOT here — it rides the Utinni patch layer, additive and kept low
         (sitting record §6 ruling 8), never this RM_-tier def (Q11). Every
         commonality below is an engineering default, not an owner-set value. -->
    <wildPlants>
      <RM_Kollavane>1.2</RM_Kollavane>  <!-- the thicket's body, THE canopy tree -->
      <RM_Threllick>1.4</RM_Threllick>  <!-- the root-mat, the biome's ground -->
      <RM_Dulloth>0.9</RM_Dulloth>  <!-- the canopy sealer -->
      <RM_Grennick>0.7</RM_Grennick>  <!-- the advancing front's groundcover -->
      <RM_Vessark>0.6</RM_Vessark>  <!-- the strangler cable -->
      <RM_Varrisk>0.5</RM_Varrisk>  <!-- the irrigated reach -->
      <RM_Pellareth>0.5</RM_Pellareth>  <!-- the pale route-flowers -->
      <RM_Fellome>0.5</RM_Fellome>  <!-- the plantation's gleanings -->
      <RM_Tavrosk>0.4</RM_Tavrosk>  <!-- the still-tree -->
      <RM_Brennoth>0.4</RM_Brennoth>  <!-- the margin's tinder -->
      <RM_Sellith>0.3</RM_Sellith>  <!-- the gutter-weed -->
      <RM_Kessaroth>0.3</RM_Kessaroth>  <!-- the free tier's snap-trap -->
      <RM_Norrveth>0.25</RM_Norrveth>  <!-- the needle-cast -->
      <RM_Sorrivel>0.2</RM_Sorrivel>  <!-- the bait bloom -->
      <RM_Brimlock>0.2</RM_Brimlock>  <!-- the river held in flesh -->
      <RM_Ruddreth>0.15</RM_Ruddreth>  <!-- the nest-bloom -->
    </wildPlants>
  </BiomeDef>

</Defs>
