<?xml version="1.0" encoding="utf-8"?>
<!--
  WEBWORK_NEST_EGG_ECONOMY_1. Wires RM_GenStep_WebworkNest.cs into the
  GenStepDef system. The class self-gates on map.Biome.defName == "RM_Webwork"
  (see its own header), so adding it to the shared base generator via the
  sibling Patches/RM_WebworkNestScatter_MapGenPatch.xml is safe — it no-ops on
  every other biome's maps, the pattern the campaign twin's scatter steps used
  (RUT_WebworkSilkScatter/RUT_WebworkNestScatter, cut with
  mandrake.rut.shokkweaveeconomy 2026-10-22).

  order 324: a "scatter something onto our biome's maps" step that needs
  terrain/elevation already generated but nothing built on top yet (the
  order the cut campaign twin's RUT_WebworkNestScatter used).
-->
<Defs>

  <GenStepDef>
    <defName>RM_WebworkNestScatter</defName>
    <order>324</order>
    <genStep Class="RimMandrake.Webwork.RM_GenStep_WebworkNest" />
  </GenStepDef>

</Defs>
