<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_Webwork_HediffDefs.xml        RM_Webwork · SHOKK_SKIN_SHRINK_1

  S6 ruling 1 (design/Jawa/worldbuilding/biomes/webwork_owner_and_nest_2026-09-23.md
  §6): "the bound hediff, spit, sun-scald and emergent-spawn comp are
  mechanism-not-IP and belong in mandrake.rm.webwork; mandrake.rsw.shokk
  shrinks to the Wyyyschokk skin patch only." This inverts the 2026-09-11
  kit ruling 6 that first put these in the RSW tier.

  Moved verbatim (fields unchanged) from
  src/RimStarWars/Shokk/Defs/HediffDefs/RSW_Shokk_HediffDefs.xml
  (SHOKK_RSW_MOD_1), re-tokened:
    RSW_ShokkBound        -> RM_LoomBound          (mechanism name, not a
                                                     species name — the
                                                     species identity is the
                                                     Utinni skin patch, §1c)
    RSW_Webwork_SunScald  -> RM_Webwork_SunScald   (name unchanged, tier only)

  These now attach directly to RM_Ollathrix's own def (RM_Ollathrix.xml),
  inline — no cross-mod patch needed, because this mod OWNS the race. The
  Utinni-tier skin patch (mandrake.rsw.shokk,
  RSW_Shokk_OllathrixSkin.xml) still overlays label/description/art on the
  same defName when loaded; it does not touch these mechanisms.
-->
<Defs>

  <HediffDef>
    <defName>RM_LoomBound</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>loom-bound</label>
    <labelNoun>a loom-binding</labelNoun>
    <description>Web-silk shot from the ollathrix's mouth-loom has hardened around the joints. It does no damage on its own — it binds. Struggling only draws it tighter; a doctor's tend loosens it fast, but left alone it takes days to work free.</description>
    <defaultLabelColor>(0.85, 0.75, 0.35)</defaultLabelColor>
    <maxSeverity>1.0</maxSeverity>
    <isBad>true</isBad>
    <tendable>true</tendable>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.2</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
      <li Class="HediffCompProperties_TendDuration">
        <severityPerDayTended>-0.9</severityPerDayTended>
      </li>
    </comps>
    <stages>
      <li>
        <label>grazed</label>
        <minSeverity>0</minSeverity>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <postFactor>0.5</postFactor>
          </li>
        </capMods>
      </li>
      <li>
        <label>bound</label>
        <minSeverity>0.5</minSeverity>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <setMax>0.10</setMax>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <setMax>0.10</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>RM_Webwork_SunScald</defName>
    <hediffClass>RimMandrake.CreatureBehaviors.RM_Hediff_SunScald</hediffClass>
    <label>sun-scald</label>
    <labelNoun>sun-scald</labelNoun>
    <description>Direct sunlight sears the ollathrix's hide. In shade or under an overcast sky it fades; unroofed under a bright sky it climbs until moving at all is agony. RULED 2026-09-11: this cripples, it never downs — no light a player can build substitutes for the sun, but the creature always keeps enough Moving capacity to crawl for shade.</description>
    <defaultLabelColor>(0.95, 0.55, 0.15)</defaultLabelColor>
    <maxSeverity>1.0</maxSeverity>
    <isBad>true</isBad>
    <tendable>false</tendable>
    <stages>
      <li>
        <label>scalding</label>
        <minSeverity>0</minSeverity>
      </li>
      <li>
        <label>burning</label>
        <minSeverity>0.35</minSeverity>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <postFactor>0.6</postFactor>
          </li>
        </capMods>
      </li>
      <li>
        <label>crippled</label>
        <minSeverity>0.7</minSeverity>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <postFactor>0.3</postFactor>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
