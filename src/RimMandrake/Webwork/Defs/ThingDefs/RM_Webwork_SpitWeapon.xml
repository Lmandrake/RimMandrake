<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_Webwork_SpitWeapon.xml        RM_Webwork · SHOKK_SKIN_SHRINK_1

  S6 ruling 1. Moved verbatim (fields unchanged) from
  src/RimStarWars/Shokk/Defs/ThingDefs/RSW_Shokk_SpitWeapon.xml
  (SHOKK_RSW_MOD_1), re-tokened:
    RSW_Bullet_ShokkSpit -> RM_Bullet_LoomSpit
    RSW_Gun_ShokkSpit     -> RM_Gun_LoomSpit

  The ollathrix's ranged "spit" (webwork_kit_spec.md §3 mouth-loom). No new
  C# combat code: RM_Gun_LoomSpit is an ordinary ParentName="BaseWeaponTurret"
  weapon (the same base vanilla's mechanoid turret-guns use), attached to
  RM_Ollathrix directly via RimWorld.CompTurretGun on the race's own
  ThingDef (RM_Ollathrix.xml) — no patch needed, this mod owns the race.
-->
<Defs>

  <ThingDef ParentName="BaseBullet">
    <defName>RM_Bullet_LoomSpit</defName>
    <label>web-silk glob</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(0.85, 0.82, 0.7)</color>
    </graphicData>
    <projectile>
      <damageDef>RM_Damage_LoomSpit</damageDef>
      <damageAmountBase>2</damageAmountBase>
      <stoppingPower>0</stoppingPower>
      <speed>45</speed>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="BaseWeaponTurret">
    <defName>RM_Gun_LoomSpit</defName>
    <label>mouth-loom</label>
    <description>Not a weapon in the ordinary sense — the ranged spinneret an ollathrix uses to bind prey from a distance before closing in.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/Autopistol</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <Mass>0</Mass>
      <AccuracyTouch>0.85</AccuracyTouch>
      <AccuracyShort>0.75</AccuracyShort>
      <AccuracyMedium>0.55</AccuracyMedium>
      <AccuracyLong>0.30</AccuracyLong>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <defaultProjectile>RM_Bullet_LoomSpit</defaultProjectile>
        <range>14.9</range>
        <warmupTime>0.6</warmupTime>
        <defaultCooldownTime>4</defaultCooldownTime>
        <muzzleFlashScale>0</muzzleFlashScale>
        <ai_AvoidFriendlyFireRadius>0</ai_AvoidFriendlyFireRadius>
      </li>
    </verbs>
  </ThingDef>

</Defs>
