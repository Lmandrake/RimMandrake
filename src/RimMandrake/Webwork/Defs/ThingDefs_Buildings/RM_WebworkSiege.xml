<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_WebworkSiege.xml          Webwork · WEB_SIEGE_DESIGN_SPIDERS_BRING_SHADE
  What the siege's spiders physically make (design/RimMandrake/webwork_spider_siege_2026-10-22.md §4). Each appears only
  when a spider finishes its job (RM_JobDriver_SpinSiegeWeb / _SiegeWrapDoor / _SiegeCocoon): nothing here is placed by a
  script. Owner's card answers 2026-10-22: the silk stays until cut or burned (no decay); cutting it yields thrixweave,
  capped per siege; a cocooned colonist dies after a day unless cut out.

  RM_Webwork_SiegeWeb       sticky sheet silk on the ground. Non-edifice with fillPercent 0, so trees, plants and items
                            stay in the cell (the RM_Webwork_Cable recipe). Slows (pathCost 14) and slicks (RM_Webwork_Slick,
                            the sheet web's hediff, read by the same adhesive settings; never an ollathrix).
                            Cut with vanilla Deconstruct: RM_CompSiegeSilk drops 2 thrixweave per cut until the siege's
                            siegeSilkYieldCap is spent. NO killedLeavings: silk broken by fire or force yields nothing, so a
                            colonist's cut is the only route and the cap holds. No emergent-spawn comp: the siege is already here.
  RM_Webwork_SiegeDoorWrap  silk round a door's cell; the door opens for no one while it stands (RM_WebworkSiegeDoorPatch).
                            Non-edifice, so spawning it never wipes the door. Cut with Deconstruct (4 s).
  RM_Webwork_SiegeCocoon    a Building_Casket holding a downed colonist; vanilla Open (right-click or the Open designator)
                            cuts them out; destroyed by fire or force it drops them, downed. Non-edifice for the same reason.

  Art: no new picture. The web and wrap use the existing sheet-web picture; the cocoon uses the urraveth's wrapped limb
  pile (both already in this mod). HP, flammability, path cost and work are PROVISIONAL first values.
-->
<Defs>

  <ThingDef ParentName="BuildingNaturalBase">
    <defName>RM_Webwork_SiegeWeb</defName>
    <label>siege silk</label>
    <description>Sheet silk spun fresh across the ground by an ollathrix of the siege, wet and tacky, strung from stem to stone. It slows whoever crosses it and holds them if they linger. It burns well. Cut, it gives up thrixweave, though one siege's silk holds only so much worth gathering.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Natural/RM_Webwork_Web</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
      <drawSize>1.0</drawSize>
    </graphicData>
    <uiIconScale>0.5</uiIconScale>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <rotatable>false</rotatable>
    <fillPercent>0</fillPercent>
    <passability>Standable</passability>
    <pathCost>14</pathCost>
    <tickerType>Normal</tickerType> <!-- RM_CompSiegeSilk slicks on CompTick, every 60 ticks -->
    <statBases>
      <MaxHitPoints>25</MaxHitPoints>
      <WorkToBuild>150</WorkToBuild>  <!-- the cut (vanilla Deconstruct), PROVISIONAL -->
      <Flammability>1.6</Flammability>
    </statBases>
    <building>
      <isEdifice>false</isEdifice>
      <claimable>false</claimable>
      <alwaysDeconstructible>true</alwaysDeconstructible>
    </building>
    <comps>
      <!-- the slick is applied by this comp, not RM_CompAdhesiveSlick, because the spiders must not stick in their own silk -->
      <li Class="RimMandrake.Webwork.RM_CompProperties_SiegeSilk">
        <perCut>2</perCut>
        <slickHediff>RM_Webwork_Slick</slickHediff>
        <severityPerScan>0.034</severityPerScan>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BuildingNaturalBase">
    <defName>RM_Webwork_SiegeDoorWrap</defName>
    <label>silk door wrap</label>
    <description>Silk wound round and round a door by an ollathrix of the siege, until the door is a lump of web set in the wall. It will not open for anyone until the wrap is cut away.</description>
    <thingClass>RimMandrake.Webwork.RM_Building_SiegeDoorWrap</thingClass>
    <graphicData>
      <texPath>Things/Building/Natural/RM_Webwork_Web</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
      <drawSize>1.1</drawSize>
    </graphicData>
    <uiIconScale>0.5</uiIconScale>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <rotatable>false</rotatable>
    <fillPercent>0</fillPercent>
    <passability>Standable</passability>
    <tickerType>Never</tickerType>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <WorkToBuild>240</WorkToBuild>  <!-- 4 s to cut free, PROVISIONAL -->
      <Flammability>1.4</Flammability>
    </statBases>
    <building>
      <isEdifice>false</isEdifice>
      <claimable>false</claimable>
      <alwaysDeconstructible>true</alwaysDeconstructible>
    </building>
  </ThingDef>

  <ThingDef ParentName="BuildingNaturalBase">
    <defName>RM_Webwork_SiegeCocoon</defName>
    <label>silk cocoon</label>
    <description>Someone the ollathrix caught, wrapped tight in silk where they fell. They are alive in there, for now. Cut them out before a day is gone.</description>
    <thingClass>RimMandrake.Webwork.RM_Building_SiegeCocoon</thingClass>
    <graphicData>
      <texPath>Things/Building/Natural/RM_Urraveth/RM_Urraveth_LimbPile_Wrapped</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.3</drawSize>
    </graphicData>
    <uiIconScale>0.6</uiIconScale>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>false</rotatable>
    <fillPercent>0.3</fillPercent>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <tickerType>Normal</tickerType> <!-- the cocoon's own clock (CheckClock every 250 ticks) -->
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <Flammability>1.0</Flammability>
    </statBases>
    <building>
      <isEdifice>false</isEdifice>
      <claimable>false</claimable>
      <deconstructible>false</deconstructible>
    </building>
  </ThingDef>

</Defs>
