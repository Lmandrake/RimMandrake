<!--
  ============================================================================
  RM_WebworkStructures.xml             Webwork - WEBWORK_BASE_PORT_BUILD_1
  ============================================================================
  The Webwork's web network (webwork_kit_spec): anchor line, sheet web and silk
  irrigation gutter. Ported from the campaign tier (RUT_Webwork_*, UtinniPatches,
  WEBWORK_KIT_BUILD_1 / WEBWORK_WEB_STRUCTURES_1) into the free mod; the RUT_
  defs are deleted. Each carries RM_CompProperties_SenseWebNode so it registers
  with RM_MapComponent_SenseWeb; the anchor also carries RM_ChewableExtension
  (the thing anchor-beetles chew); the sheet web carries the commandable
  adhesive (Flickable + RM_CompProperties_AdhesiveSlick -> RM_Webwork_Slick).

  Placement is RM_MapComponent_FrontCreep's job (RM_FrontCreepExtension on the
  RM_Webwork BiomeDef). Destroying a node yields thrixweave (Hyperweave, renamed
  in Patches/RM_Thrixweave_Rename.xml): web-cutting is one of the sole-source
  routes. The emergent-spawn half (RM_CompProperties_EmergentSpawnOnDestroy) is
  not attached: it fires only on DestroyMode.Vanish, and combat destruction
  never produces that; a dedicated harvest job is still owed.

  Art: placeholder flat-fills (art/Structures/gen_webwork_structures_placeholder.py);
  real art is queued in artpipe. HP/fillPercent/pathCost/yields are invented
  first values for the live-balance pass.
  ============================================================================
-->
<Defs>

  <ThingDef ParentName="BuildingNaturalBase">
    <defName>RM_Webwork_Anchor</defName>
    <label>web anchor line</label>
    <description>A thick catenary of shokkweave, spun taut between two fixed points and hardened until it reads as architecture rather than silk. The whole network hangs off lines like this one; cut or chewed through, the web nearby goes slack and blind.</description>
    <!-- BuildingNaturalBase sets no thingClass of its own (unlike RockBase,
         which sets Mineable): every concrete ThingDef using it directly
         (Hive included) must set its own or thingClass resolves null and
         ReadingPolicyDatabase.GenerateStartingPolicies() NREs on
         item.thingClass.SameOrSubclassOf, for EVERY Game construction, not
         just this one. Found live 2026-09-12 (FOUNDRY): missing here on
         all 3 defs in this file plus RM_Webwork_Nest, blocking every
         quicktest and every save load on the whole mod list. -->
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Natural/RM_Webwork_Anchor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
      <drawSize>1.0</drawSize>
    </graphicData>
    <uiIconScale>0.5</uiIconScale>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>false</rotatable>
    <fillPercent>0.05</fillPercent>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <tickerType>Never</tickerType>
    <statBases>
      <MaxHitPoints>40</MaxHitPoints>
      <Flammability>1.4</Flammability>
    </statBases>
    <killedLeavings>
      <Hyperweave>3</Hyperweave>
    </killedLeavings>
    <modExtensions>
      <li Class="RimMandrake.CreatureBehaviors.RM_ChewableExtension" />
    </modExtensions>
    <comps>
      <li Class="RimMandrake.CreatureBehaviors.RM_CompProperties_SenseWebNode" />
    </comps>
  </ThingDef>

  <ThingDef ParentName="BuildingNaturalBase">
    <defName>RM_Webwork_Web</defName>
    <label>sheet web</label>
    <description>A broad plane of silk strung between trunks, thick enough to blot out the canopy above it. Nothing touches it without the whole network knowing.</description>
    <!-- see RM_Webwork_Anchor's comment above: BuildingNaturalBase sets no thingClass -->
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Natural/RM_Webwork_Web</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
      <drawSize>1.2</drawSize>
    </graphicData>
    <uiIconScale>0.5</uiIconScale>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>false</rotatable>
    <fillPercent>0.05</fillPercent>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <tickerType>Never</tickerType>
    <statBases>
      <MaxHitPoints>30</MaxHitPoints>
      <Flammability>1.6</Flammability>
    </statBases>
    <killedLeavings>
      <Hyperweave>2</Hyperweave>
    </killedLeavings>
    <comps>
      <li Class="RimMandrake.CreatureBehaviors.RM_CompProperties_SenseWebNode" />
      <!-- WEBWORK_WEB_STRUCTURES_1 — the deferred "commandable adhesive
           slick/locked" mechanism (kit spec §3), v1: this sheet web is the
           one of the three structures a pawn actually stands IN, so it is
           the one that carries the adhesive. CompProperties_Flickable is
           the whole "commandable" half — the player's own Gizmo toggle,
           zero new C#; see RM_WebworkSlick.xml for the hediff's own
           slick-vs-locked escalation. -->
      <li Class="CompProperties_Flickable" />
      <li Class="RimMandrake.CreatureBehaviors.RM_CompProperties_AdhesiveSlick">
        <slickHediff>RM_Webwork_Slick</slickHediff>
        <radiusCells>0</radiusCells>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BuildingNaturalBase">
    <defName>RM_Webwork_Gutter</defName>
    <label>silk irrigation gutter</label>
    <description>A woven channel of dense silk, carrying the stolen river's water further than roots alone could reach. Plumbing, not habitat — but it is still web, and it still feels.</description>
    <!-- see RM_Webwork_Anchor's comment above: BuildingNaturalBase sets no thingClass -->
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Natural/RM_Webwork_Gutter</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
      <drawSize>1.0</drawSize>
    </graphicData>
    <uiIconScale>0.5</uiIconScale>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>false</rotatable>
    <fillPercent>0.05</fillPercent>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <tickerType>Never</tickerType>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <Flammability>1.2</Flammability>
      <!-- WEBWORK_TRACTION_LANCE_BUILD_1: the work to brace and cut a junction out whole. PROVISIONAL. -->
      <WorkToBuild>1200</WorkToBuild>
    </statBases>
    <killedLeavings>
      <Hyperweave>5</Hyperweave>
    </killedLeavings>
    <!-- WEBWORK_TRACTION_LANCE_BUILD_1 step 4: a colonist may deconstruct a gutter the colony does not own
         (vanilla building.alwaysDeconstructible). Cut out that way it leaves an intact RM_GutterJunction to study;
         broken by damage it leaves only the silk above. The cut trips the sense-web on the cutter. -->
    <building>
      <alwaysDeconstructible>true</alwaysDeconstructible>
    </building>
    <comps>
      <li Class="RimMandrake.CreatureBehaviors.RM_CompProperties_SenseWebNode" />
      <li Class="RimMandrake.CreatureBehaviors.RM_CompProperties_SpecimenOnDeconstruct">
        <specimen>RM_GutterJunction</specimen>
        <tripSenseWeb>true</tripSenseWeb>
      </li>
    </comps>
  </ThingDef>

</Defs>
