<?xml version="1.0" encoding="utf-8"?>
<!--
  WEBWORK_TRACTION_LANCE_BUILD_1 step 2-3: the traction lance. The capstan's sibling on ONE shared pull
  (RimMandrake.CreatureBehaviors.RM_CompTetherPull, which the capstan turret also carries): the capstan is the fixed
  powered turret, the lance the crewed one. Class RimMandrake.CreatureBehaviors.RM_Building_TractionLance.

  Lasso relative: stuffed by fabric, and the stuff IS the tether. RM_TetherStuffExtension sets each fabric's reach,
  strength (mass/body-size caps), reel and snap factors: cloth weak and snappy, devilstrand middling, thrixweave
  (Core Hyperweave, relabelled by RM_Thrixweave_Rename.xml) best. The rigging is a CompRefuelable fed with fabric:
  reeling wears it by the target's body size, a snap consumes all of it, re-rigging is an ordinary refuel. The re-rig
  accepts any of the three fabrics; the building's stuff alone sets the tether's quality.
  All numbers PROVISIONAL (FOUNDRY's first values, tuned in live play). Art: PLACEHOLDER textures (Webwork anchor
  base, vanilla mini-turret top) until RM_TractionLance_Base/_Top are installed through the art ledger.
-->
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>RM_TractionLance</defName>
    <label>traction lance</label>
    <description>A crewed tether emplacement: a braced mount, a hand-cranked ratchet drum, and a launcher that throws a barbed fabric tether at a visible target and reels it in along the ground toward the lance, cell by cell. A downed colonist can be hauled out of danger, a raider dragged out of cover, a canopy-dweller pulled out into the sun. Walls stop the pull. Big targets cost more: the drum draws more power and the tether wears faster. The fabric it is built from is the tether: cloth is weak and snaps easily, devilstrand holds better, thrixweave best of all. A snapped tether must be re-rigged with fabric before the lance fires again.</description>
    <thingClass>RimMandrake.CreatureBehaviors.RM_Building_TractionLance</thingClass>
    <graphicData>
      <texPath>Things/Building/Natural/RM_Webwork_Anchor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <drawerType>MapMeshAndRealTime</drawerType>
    <altitudeLayer>Building</altitudeLayer>
    <size>(1,1)</size>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.4</fillPercent>
    <castEdgeShadows>true</castEdgeShadows>
    <tickerType>Normal</tickerType>
    <rotatable>false</rotatable>
    <stealable>false</stealable>
    <stuffCategories>
      <li>Fabric</li>
    </stuffCategories>
    <costStuffCount>40</costStuffCount>
    <costList>
      <Steel>80</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <statBases>
      <MaxHitPoints>160</MaxHitPoints>
      <WorkToBuild>2500</WorkToBuild>
      <Flammability>0.8</Flammability>
      <Mass>35</Mass>
      <Beauty>-10</Beauty>
    </statBases>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Mannable">
        <manWorkType>Violent</manWorkType>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>80</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Refuelable">
        <fuelLabel>Tether rigging</fuelLabel>
        <fuelGizmoLabel>Tether</fuelGizmoLabel>
        <outOfFuelMessage>Tether snapped: needs re-rigging with fabric</outOfFuelMessage>
        <fuelFilter>
          <thingDefs>
            <li>Cloth</li>
            <li>DevilstrandCloth</li>
            <li>Hyperweave</li>
          </thingDefs>
        </fuelFilter>
        <fuelCapacity>10</fuelCapacity>
        <initialFuelPercent>1</initialFuelPercent>
        <autoRefuelPercent>0.3</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
      </li>
      <!-- THE shared pull. Live numbers come from RM_Building_TractionLance (lance Mod Settings x the tether's
           fabric); only the readable signs are set here. -->
      <li Class="RimMandrake.CreatureBehaviors.RM_CompProperties_TetherPull">
        <snapMessage>The traction lance's tether snapped: {0}.</snapMessage>
        <snapMoteText>Tether snapped!</snapMoteText>
      </li>
    </comps>
    <modExtensions>
      <li Class="RimMandrake.CreatureBehaviors.RM_TetherStuffExtension">
        <wearPerCellPerBodySize>0.25</wearPerCellPerBodySize>
        <powerPerBodySize>1</powerPerBodySize>
        <maxMass>120</maxMass>
        <maxBodySize>2</maxBodySize>
        <snapDamage>10</snapDamage>
        <factors>
          <li>
            <stuff>Cloth</stuff>
            <range>0.75</range>
            <strength>0.6</strength>
            <reel>0.9</reel>
            <snap>2</snap>
          </li>
          <li>
            <stuff>DevilstrandCloth</stuff>
            <range>1</range>
            <strength>1</strength>
            <reel>1</reel>
            <snap>1</snap>
          </li>
          <li>
            <stuff>Hyperweave</stuff>
            <range>1.3</range>
            <strength>1.6</strength>
            <reel>1.25</reel>
            <snap>0.4</snap>
          </li>
        </factors>
      </li>
    </modExtensions>
    <designationCategory>Security</designationCategory>
    <researchPrerequisites>
      <li>RM_Research_TractionLance</li>
    </researchPrerequisites>
    <constructEffect>ConstructMetal</constructEffect>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <building>
      <ai_combatDangerous>true</ai_combatDangerous>
    </building>
  </ThingDef>

</Defs>
