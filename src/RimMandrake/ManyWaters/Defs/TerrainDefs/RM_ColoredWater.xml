  <TerrainDef MayRequire="sarg.alphabiomes" ParentName="WaterShallowBase">
    <defName>RM_Slime_Chalk</defName>
    <label>chalky slime</label>
    <description>Liquid slime clouded pale with mineral sediment — thick, slow-moving, and paler than anything healthy should be.</description>
    <texturePath>Terrain/Surfaces/AB_SlimeRamp</texturePath>
    <pollutedTexturePath>Terrain/Surfaces/AB_SlimeRamp_Polluted</pollutedTexturePath>
    <waterDepthShader>Map/WaterDepth</waterDepthShader>
    <renderPrecedence>394</renderPrecedence>
    <driesTo>AB_SlimeGrass</driesTo>
    <color>(200,196,178)</color>
    <throwFleckChance>0.25</throwFleckChance>
    <fleckData>
      <fleck>RM_Fleck_Steam_Chalk</fleck>
      <velocitySpeedRange>0.01~0.5</velocitySpeedRange>
