<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MOVING_DUNES_BUILD_1. Same recipe as
    src/RimMandrake/Pyrelands/Source/FireEcologyHook.csproj (Harmony) and
    src/RimMandrake/FluidCanals/Source/RimMandrake_FluidCanals.csproj (defs + Things).

    Build (the dotnet is WINDOWS-NATIVE and cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\Rimworld\src\RimMandrake\MovingDunes\Source\RimMandrake_MovingDunes.csproj -c Release

    Output lands in ../Assemblies/, which is where RimWorld looks.

    Note there is NO reference to Odyssey: the sand grid this whole mod rides
    (Map.sandGrid, Verse.SandGrid) is in the BASE Assembly-CSharp — Odyssey gates it
    at runtime with ModLister.CheckOdyssey("sand"), not at the assembly boundary. So
    the mod compiles and loads without the expansion and is simply inert with it
    absent, which is exactly the soft dependency MOVING_DUNES_DESIGN.md §2 rules for.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrakeMovingDunes</AssemblyName>
    <RootNamespace>RimMandrake.MovingDunes</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HarmonyDll)' == ''">
    <HarmonyDll>C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\2009463077\Current\Assemblies\0Harmony.dll</HarmonyDll>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="RM_DuneMaterialDef.cs" />
    <Compile Include="DuneFieldExtension.cs" />
    <Compile Include="DuneFieldRegistry.cs" />
    <Compile Include="MovingDunesMod.cs" />
    <Compile Include="Patch_SandGrid.cs" />
    <Compile Include="SectionLayer_DuneSand.cs" />
    <Compile Include="MapComponent_DuneField.cs" />
    <Compile Include="Thing_BuriedCache.cs" />
    <Compile Include="DuneBurialUtility.cs" />
    <Compile Include="MovingDunesDebugActions.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
