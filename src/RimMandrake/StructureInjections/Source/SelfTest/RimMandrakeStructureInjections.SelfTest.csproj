<Project Sdk="Microsoft.NET.Sdk">

  <!--
    StructureInjections offline fuzz (Approach B). Plain net8.0, zero RimWorld/Unity references: ../Kernel/RM_PlanKernel.cs and ../RimplacePlan.cs are
    the PRODUCTION files the mod compiles, pulled in directly (both are engine-free). A `using Verse;` landing in either breaks this build.
    Run: python3 src/RimMandrake/Utils/selftest_structureinjections_fuzz.py [fuzz knobs]
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RimMandrakeStructureInjections.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.StructureInjections.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Kernel\RM_PlanKernel.cs" />
    <Compile Include="..\RimplacePlan.cs" />
    <Compile Include="StructureInjectionsFuzz.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
