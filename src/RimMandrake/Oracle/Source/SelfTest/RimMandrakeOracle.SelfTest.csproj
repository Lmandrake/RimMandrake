<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Oracle offline fuzz, Approach B. Plain net8.0, zero RimWorld/Unity references: ../Kernel/*.cs are the PRODUCTION
    files the mod compiles, pulled in directly. A `using Verse;` landing in one of them breaks this build - that is the guard rail.
    Run: python3 src/RimMandrake/Utils/selftest_oracle_fuzz.py
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RimMandrakeOracle.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.Oracle.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Kernel\OracleKernel.cs" />
    <Compile Include="..\OracleValidator.cs" />
    <Compile Include="..\OracleRegisterBlocks.cs" />
    <Compile Include="OracleFuzzKit.cs" />
    <Compile Include="OracleFuzz.cs" />
  </ItemGroup>

</Project>
