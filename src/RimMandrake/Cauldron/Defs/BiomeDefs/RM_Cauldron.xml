<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    RM_Cauldron                    POISONFOREST_RM_MOD_BUILD_1, new 2026-09-25

    Copied from the frozen src/RimUtinni/UtinniPatches/Defs/BiomeDefs/
    RUT_Cauldron.xml (authored 2026-09-09, most recently updated by
    COMMISSION_LEDGER_CLEANUP_1 2026-09-24/25) per
    design/RimMandrake/biome_mod_architecture.md §5 Phase A step 2. Every
    field below is the twin's own content, unchanged, EXCEPT:

      - generatesNaturally: the twin sets this false (it is placed only by
        hand on the frozen campaign world, never by vanilla worldgen scoring).
        Dropped here (defaults true) so this mod's own worker can actually
        place the biome on OTHER, generated planets — same as every sibling
        RM_ biome mod.
      - workerClass: the donor BiomesPlus.BiomeWorker_PoisonForest becomes
        this mod's own RimMandrake.Cauldron.RM_BiomeWorker_Cauldron
        (§5 step 2 — a donor type in workerClass is a hard dependency the
        RimMandrake tier may not assume). [INVENTED] placement ranges, same
        footing as every sibling worker's own ranges — see RM_CauldronBiome.cs.
      - terrainsByFertility: the donor terrain names PoisonSoil/PoisonSoilRich
        (BiomesPlus, MEASURED absent from this repo's own src/ tree — an
        undeclared hard dependency in the twin) become this mod's own
        RM_CauldronSoil/RM_CauldronSoilRich (net-new TerrainDefs, this mod's
        Defs/TerrainDefs/RM_Cauldron_Terrains.xml).
      - wildAnimals: the 5 Star Wars/campaign-tier rows (Neebray, Mynock,
        GraniteSlug — mlie.starwarsanimalcollection; RSW_Screecher,
        RSW_VentStalker — mandrake.rsw.swbestiary) are OUT, per §7 Q11
        ("RimMandrake should not name star wars ever"). They ride
        src/RimUtinni/UtinniPatches/Patches/WildAnimals_Cauldron.xml as
        PatchOperationAdd onto this def instead. The other inline rows were
        donor kinds (Genetic Rim, Alpha Animals, Alpha Memes, Horrors) and are
        now our own ports (RM_Garsulix, RM_Rhossak/RM_GalledRhossak, RM_Visceral,
        RM_BedBug, RM_CrystalMit, RM_SikkaSikka, RM_DecayDrake, RM_Bileworm,
        RM_Mullgoth, RM_Radyak); donors retired 2026-10-18/19.
      - wildPlants: RM_TwistingThornwood and RM_DarkCrust are (RM_TreeMartyr cut, owner 2026-10-18)
        this mod's own plants (Defs/ThingDefs_Plants/RM_CauldronFlora.xml) per
        §7 Q13 ("content wired into two biome mods: duplicate, then diverge" —
        the thornwood species is also wired into RM_FloodedCanyon as its own
        copy RM_CrackedThornwood). The 7 Alpha Biomes AB_ rows were RETIRED by
        CAULDRON_RULED_CONTENT_1 (2026-09-29): diverged into owned RM_
        defs (RM_CrystalFlower, RM_BloodBouquet, RM_RavenNettle,
        RM_RedBugloss, RM_GiantAgariTox, RM_KeeningCordax,
        RM_GiantToxicFlower) at the same weights, plus RM_Xithess.
      - wildAnimals (CAULDRON_RULED_CONTENT_1): +3 owned natives (RM_Vexxiss,
        RM_Zisska, RM_Eskith) and the owner-ruled Alpha Animals import Radyak,
        now our port RM_Radyak (Plasmorph and LuciferBug are no longer rows).
        The import overrides the frozen sheet's no-grazer and ban-9 lines on
        purpose. Lylek, Skalder and Silooth (RSW_ ports) ride the Utinni patch.
      - texture: our own World/Biomes/RM_Cauldron (the donor PoisonForest
        texture is gone).

    Terrain (Marsh/Riverbank) and diseases are the twin's content unchanged.
    Every wildPlants and wildAnimals row is an RM_ def; the three MayRequire
    gates left name our own mods (mandrake.rut.patches, mandrake.rm.warscar,
    mandrake.rsw.swbestiary), not donors.
  -->

  <BiomeDef>
    <defName>RM_Cauldron</defName>
    <label>the Cauldron</label>
    <description>A low, wet-black forest standing in permanent dusk over ground that breathes. The light never changes and casts nothing you could call a shadow; trunks weep a grey metallic sweat that hardens into scabs and crystal fans. Nearly everything alive here is either sealed against the vented metal-rich gas or has processed the load and become toxic itself -- and nothing is fast, because a chemosynthetic budget is thin.</description>
    <workerClass>RimMandrake.Cauldron.RM_BiomeWorker_Cauldron</workerClass>
    <lakeBeachTerrain>Marsh</lakeBeachTerrain>
    <mudTerrain>Marsh</mudTerrain>
    <riverbankTerrain>Riverbank</riverbankTerrain>
    <foragedFood>RawBerries</foragedFood>
    <allowRoads>true</allowRoads>
    <allowRivers>true</allowRivers>
    <allowFarmingCamps>true</allowFarmingCamps>
    <animalDensity>0.8</animalDensity>
    <plantDensity>0.5</plantDensity>
    <forageability>1.0</forageability>
    <movementDifficulty>2</movementDifficulty>
    <texture>World/Biomes/RM_Cauldron</texture>
    <diseaseMtbDays>30</diseaseMtbDays>
    <diseases>
      <li>
        <diseaseInc>Disease_Flu</diseaseInc>
        <commonality>100</commonality>
      </li>
      <li>
        <diseaseInc>Disease_Plague</diseaseInc>
        <commonality>100</commonality>
      </li>
      <li>
        <diseaseInc>Disease_Malaria</diseaseInc>
        <commonality>160</commonality>
      </li>
      <li>
        <diseaseInc>Disease_SleepingSickness</diseaseInc>
        <commonality>140</commonality>
      </li>
      <li>
        <diseaseInc>Disease_FibrousMechanites</diseaseInc>
        <commonality>30</commonality>
      </li>
      <li>
        <diseaseInc>Disease_SensoryMechanites</diseaseInc>
        <commonality>30</commonality>
      </li>
      <li>
        <diseaseInc>Disease_GutWorms</diseaseInc>
        <commonality>80</commonality>
      </li>
      <li>
        <diseaseInc>Disease_MuscleParasites</diseaseInc>
        <commonality>80</commonality>
      </li>
    </diseases>
    <terrainsByFertility>
      <li>
        <terrain>RM_CauldronSoil</terrain>
        <min>-999</min>
        <max>0.87</max>
      </li>
      <li>
        <terrain>RM_CauldronSoilRich</terrain>
        <min>0.87</min>
        <max>999</max>
      </li>
    </terrainsByFertility>
    <!-- CAULDRON_MECHANICS_BUILD_1 part 2: the four ruled weathers
         (Defs/WeatherDefs/RM_CauldronWeathers.xml) replace the donor Fog 90
         block. Weights are INVENTED tuning: scatter-dusk is the standing state. -->
    <baseWeatherCommonalities>
      <RM_ScatterDusk>60</RM_ScatterDusk>
      <RM_VapourBank>20</RM_VapourBank>
      <RM_Dewfall>12</RM_Dewfall>
      <RM_VentBloom>8</RM_VentBloom>
      <Fog>0</Fog>
      <Clear>0</Clear>
      <DryThunderstorm>1</DryThunderstorm>
      <Rain>0</Rain>
      <RainyThunderstorm>0</RainyThunderstorm>
      <SnowGentle>0</SnowGentle>
      <SnowHard>0</SnowHard>
    </baseWeatherCommonalities>
    <wildAnimals>
      <RM_Suush>0.2</RM_Suush>  <!-- suush - the Cauldron's own floating drifter, SUUSH_CAULDRON_DRIFTER_1 -->
      <RM_Garsulix>0.7</RM_Garsulix>  <!-- garsulix - our port of VGE's GR_Beetlefleet (Defs/ThingDefs_Races/RM_Garsulix.xml), donor retired 2026-10-18 -->
      <RM_Rhossak>0.4</RM_Rhossak>  <!-- rhossak: our own animal (Defs/ThingDefs_Races/RM_Rhossak.xml), binds to a thornwood; RHOSSAK_MIGRATE_ROOTS_TAKE_HOLD, owner by card 2026-10-19 -->
      <RM_GalledRhossak>0.4</RM_GalledRhossak>  <!-- galled rhossak: same file, binds, carries no seed -->
      <RM_Visceral MayRequire="mandrake.rut.patches">0.35</RM_Visceral>  <!-- visceral (our port, UtinniPatches RM_Visceral.xml) - medium-pred, keep -->
      <RM_BedBug>0.3</RM_BedBug>  <!-- bedbug - small-pred, keep -->
      <RM_CrystalMit>0.15</RM_CrystalMit>  <!-- crystalmit - small, keep -->
      <RM_SikkaSikka>0.15</RM_SikkaSikka>  <!-- giant crowned silkie - medium, keep -->
      <RM_DecayDrake>0.1</RM_DecayDrake>  <!-- fermatalis (decay drake) - medium, keep; our port of AA_DecayDrake, defined in the Miasma member (DONOR_CODE_PLAIN_PORTS_1) -->
      <RM_Bileworm MayRequire="mandrake.rm.warscar">0.1</RM_Bileworm>  <!-- helixien - giant, keep -->
      <RM_Mullgoth>0.05</RM_Mullgoth>  <!-- wildpod - giant, keep -->
      <!-- CAULDRON_RULED_CONTENT_1: three owned natives (one home each). -->
      <RM_Vexxiss>0.02</RM_Vexxiss>  <!-- vexxiss - the armoured living boiler-mound; shear-only vexxith -->
      <RM_Zisska>0.5</RM_Zisska>  <!-- zisska - herd rasper, toxic prized meat, steel on butcher -->
      <RM_Eskith>0.4</RM_Eskith>  <!-- eskith - silent-flock small bird -->
      <!-- CAULDRON_RULED_CONTENT_1: the owner-ruled Alpha Animals import, now our port. Wired and kept on purpose:
           overrides the frozen sheet's no-grazer / ban-9 lines. Do not "fix" it back out. -->
      <RM_Radyak>0.1</RM_Radyak>  <!-- ossrith; our port of AA_Radyak (DONOR_CODE_PLAIN_PORTS_1), art installed 2026-10-10 -->
    </wildAnimals>
    <coastalWildAnimals />
    <wildPlants>
      <RM_TwistingThornwood>0.6</RM_TwistingThornwood>  <!-- twisting thornwood - tree -->
      <RM_CrystalFlower>0.5</RM_CrystalFlower>  <!-- crystal flower -->
      <RM_BloodBouquet>0.4</RM_BloodBouquet>  <!-- blood bouquet -->
      <RM_RavenNettle>0.4</RM_RavenNettle>  <!-- raven nettle -->
      <RM_GiantAgariTox>0.3</RM_GiantAgariTox>  <!-- agaritox - tree -->
      <RM_RedBugloss>0.3</RM_RedBugloss>  <!-- red bugloss -->
      <RM_KeeningCordax>0.2</RM_KeeningCordax>  <!-- keening cordax - tree -->
      <RM_GiantToxicFlower>0.08</RM_GiantToxicFlower>  <!-- giant toxic flower -->
      <RM_Xithess>0.35</RM_Xithess>  <!-- xithess - filter-frond, vent-chemistry yield -->
      <RM_DarkCrust>0.25</RM_DarkCrust>
      <!-- CAULDRON_FLORA_EXPANSION_BUILD_1: removed at startup by RM_CauldronFloraGate when floraExpansionEnabled is off.
           First values, calibrate in play. -->
      <RM_Tsevrix>0.3</RM_Tsevrix>
      <RM_Ixalith>0.12</RM_Ixalith>
      <RM_Fexxil>0.25</RM_Fexxil>
      <RM_Sessarix>0.15</RM_Sessarix>
      <RM_Kissaveth>0.2</RM_Kissaveth>
      <RM_Selvix>0.2</RM_Selvix>  <!-- vein moss - phototroph film -->
    </wildPlants>
    <wildPlantRegrowDays>15</wildPlantRegrowDays>
  </BiomeDef>

</Defs>
