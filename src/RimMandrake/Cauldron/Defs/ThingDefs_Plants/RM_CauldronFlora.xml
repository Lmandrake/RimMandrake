<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    RM_CauldronFlora.xml    RimMandrake: The Cauldron

    POISONFOREST_RM_MOD_BUILD_1: three renamed, duplicated copies of the
    frozen twin's own flora, per biome_mod_architecture.md §7 Q13
    ("content wired into TWO biome mods: DUPLICATE, THEN DIVERGE — each mod
    carries its own copy under its own defName; the second copy is
    regenerated later, art and identity, into a distinct variant").

    - RM_TwistingThornwood: field-for-field copy of RUT_TwistingThornwood
      (src/RimUtinni/UtinniPatches/Defs/ThingDefs_Plants/RUT_PollutedFlora.xml),
      which is ALSO wired into RUT_CrackedLands and stays there, untouched,
      byte-for-byte, serving both the live campaign world and that biome's
      own future standalone build. This is this mod's own copy, not a move.
    - RM_TreeMartyr: field-for-field copy of RUT_TreeMartyr, which the twin
      wires only into PoisonForest — the frozen original stays in place too
      (same file), since RUT_PoisonForest.xml is frozen byte-for-byte and
      must keep resolving its own original defName.
    - RM_DarkCrust: field-for-field copy of RUT_DarkCrust (label "vein
      moss", ruled by owner card 2026-09-24, POISONFOREST_SHIPPING_NAMES_1),
      wired only into PoisonForest. Art: the generated PNG already sitting at
      infrastructure/artpipe/_artsrc/rutdarkcrust_v1/rutdarkcrust_v1.png
      (COMMISSION_LEDGER_CLEANUP_1, done 2026-09-24) — the frozen twin's own
      texPath (Things/Plant/RUT_DarkCrust) has never had an actual texture
      file placed under it in UtinniPatches/Textures; that gap belongs to
      whoever wires the twin, not this item. This mod's copy gets that art
      for real, at its own texPath.

    Art for TwistingThornwood/MartyrTree copied verbatim from
    src/RimUtinni/UtinniPatches/Textures/Things/Plant/{TwistingThornwood,MartyrTree}/
    into this mod's own Textures/Things/Plant/{RM_TwistingThornwood,RM_TreeMartyr}/,
    same "art copied, renamed" precedent as RM_LeaningScrub's RM_SweetlineTree.
  -->

  <!-- ============== Twisting thornwood (tree) — duplicated from RUT_TwistingThornwood ============== -->
  <ThingDef ParentName="TreeBase">
    <defName>RM_TwistingThornwood</defName>
    <label>twisting thornwood</label>
    <description>A tree the Cauldron has wrung into a corkscrew, its trunk armoured in hard grey thorns and weeping the forest's metallic sweat from every split in the bark. The wood inside is dense and slow-grown, and cutting it is a long, ugly job: the thorns fight back, and the sweat dries into the grain like solder.</description>
    <!-- METAL SECOND YIELD (owner-ruled, both trees; CAULDRON_TREE_METAL_YIELD_1):
         steel beside the wood, scaled by growth. See RM_CompMetalYield. -->
    <comps>
      <li Class="RimMandrake.Cauldron.RM_CompProperties_MetalYield">
        <metalDef>Steel</metalDef>
        <countAtMinGrowth>2</countAtMinGrowth>
        <countAtFullGrowth>12</countAtFullGrowth>
      </li>
    </comps>
    <minifiedDef IsNull="True" />
    <statBases>
      <MaxHitPoints>210</MaxHitPoints>
      <Nutrition>2.0</Nutrition>
      <Mass>100</Mass>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/RM_TwistingThornwood</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <shadowData>
        <volume>(0.24, 0.3, 0.15)</volume>
        <offset>(0,0,-0.38)</offset>
      </shadowData>
    </graphicData>
    <fillPercent>0.35</fillPercent>
    <plant>
      <lifespanDaysPerGrowDays>40</lifespanDaysPerGrowDays>
      <fertilityMin>0.05</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      <growDays>15</growDays>
      <!-- CAULDRON_RULED_CONTENT_1: steep on purpose (was 210); thorn-armoured, metal-sweating wood. -->
      <harvestWork>1200</harvestWork>
      <harvestYield>25</harvestYield>
      <harvestedThingDef>WoodLog</harvestedThingDef>
      <harvestMinGrowth>0.2</harvestMinGrowth>
      <topWindExposure>0.08</topWindExposure>
      <visualSizeRange>1.3~3.0</visualSizeRange>
      <wildClusterRadius>-1</wildClusterRadius>
      <treeLoversCareIfChopped>true</treeLoversCareIfChopped>
    </plant>
  </ThingDef>

  <!-- ============== Martyr tree — duplicated from RUT_TreeMartyr ============== -->
  <ThingDef ParentName="TreeBase">
    <defName>RM_TreeMartyr</defName>
    <label>martyr tree</label>
    <description>A large yucca-related plant adapted to poisoned soils. It yields a small amount of fibrous material that can be used like wood.</description>
    <!-- METAL SECOND YIELD (owner-ruled, both trees; CAULDRON_TREE_METAL_YIELD_1):
         steel beside the wood, scaled by growth. See RM_CompMetalYield. -->
    <comps>
      <li Class="RimMandrake.Cauldron.RM_CompProperties_MetalYield">
        <metalDef>Steel</metalDef>
        <countAtMinGrowth>1</countAtMinGrowth>
        <countAtFullGrowth>6</countAtFullGrowth>
      </li>
    </comps>
    <minifiedDef IsNull="True" />
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <Nutrition>2.0</Nutrition>
      <Mass>100</Mass>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/RM_TreeMartyr</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <shadowData>
        <volume>(0.24, 0.3, 0.15)</volume>
        <offset>(0,0,-0.38)</offset>
      </shadowData>
    </graphicData>
    <fillPercent>0.35</fillPercent>
    <plant>
      <lifespanDaysPerGrowDays>40</lifespanDaysPerGrowDays>
      <fertilityMin>0.10</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      <growDays>10</growDays>
      <!-- CAULDRON_RULED_CONTENT_1: steep on purpose (was 210). -->
      <harvestWork>1000</harvestWork>
      <harvestYield>15</harvestYield>
      <harvestedThingDef>WoodLog</harvestedThingDef>
      <harvestMinGrowth>0.2</harvestMinGrowth>
      <topWindExposure>0.08</topWindExposure>
      <visualSizeRange>1.3~3.0</visualSizeRange>
      <wildClusterRadius>-1</wildClusterRadius>
      <treeLoversCareIfChopped>true</treeLoversCareIfChopped>
    </plant>
  </ThingDef>

  <!-- ============== Vein moss (dark crust phototroph) — duplicated from RUT_DarkCrust ============== -->
  <ThingDef ParentName="PlantBase">
    <defName>RM_DarkCrust</defName>
    <label>vein moss</label>
    <description>A thin skin of phototrophic film, patched black, deep purple and blood-red, spread wherever a trunk or a stone faces the star's scattered light. It is not green because green is the wrong pigment for light this weak — it absorbs across the whole dim spectrum instead, and it is losing anyway. This is what grows on the things that actually won.</description>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Flammability>0.3</Flammability>
      <Nutrition>0.15</Nutrition>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/RM_DarkCrust/RM_DarkCrust_a</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.9</drawSize>
    </graphicData>
    <hideAtSnowOrSandDepth>0.5</hideAtSnowOrSandDepth>
    <selectable>false</selectable>
    <plant>
      <growDays>6</growDays>
      <harvestWork>40</harvestWork>
      <maxMeshCount>3</maxMeshCount>
      <visualSizeRange>0.5~0.9</visualSizeRange>
      <topWindExposure>0</topWindExposure>
      <wildOrder>1</wildOrder>
      <fertilityMin>0.05</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
    </plant>
  </ThingDef>

  <!--
    CAULDRON_RULED_CONTENT_1 (2026-09-29): the seven Alpha Biomes AB_ plants
    this biome carried inline are DIVERGED into owned RM_ defs (Q13: duplicate,
    then diverge) and the donor rows are retired from RM_Cauldron. Field
    values are authored here, not copied: the donor defs are not in this repo.
    Each keeps its old wildPlants weight in the biome def.

    ART IS BLOCKED, NOT FAKED. The validated regenerated art for all seven
    (artpipe ids crystalflower_v1, bloodbouquet_v1, ravennettle_v1,
    redbugloss_v1, giantagaritox_v1, keeningcordax_v1, gianttoxicflower_v1)
    exists as artpipe/done manifests only; the PNGs under
    infrastructure/artpipe/_artsrc/ are gitignored and absent from this
    checkout. The texPaths below are wired for the drop-in:
    Textures/Things/Plant/RM_<Name>/RM_<Name>_a.png. Until then these seven
    render with the engine's missing-texture placeholder. No donor art is
    copied and no new art was queued.
  -->

  <ThingDef ParentName="PlantBase">
    <defName>RM_CrystalFlower</defName>
    <label>crystal flower</label>
    <description>A flower whose petals have crystallized into sharp, faceted, translucent shards. The forest's metal-laden sweat wicks up the stem and comes out the other end as glass. It chimes faintly when the fog moves through it, and it will open a hand that grabs it carelessly.</description>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Flammability>0.2</Flammability>
      <Nutrition>0.1</Nutrition>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/RM_CrystalFlower/RM_CrystalFlower_a</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <plant>
      <growDays>8</growDays>
      <fertilityMin>0.05</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      <maxMeshCount>2</maxMeshCount>
      <visualSizeRange>0.9~1.6</visualSizeRange>
      <topWindExposure>0.1</topWindExposure>
      <wildOrder>3</wildOrder>
    </plant>
  </ThingDef>

  <ThingDef ParentName="PlantBase">
    <defName>RM_BloodBouquet</defName>
    <label>blood bouquet</label>
    <description>Dark crimson flower heads bunched on a single stalk like a grim bouquet, heavy and wet-looking even when the air is dry. It gets its colour from the same iron the trees sweat, and nothing that eats it eats twice.</description>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Flammability>0.3</Flammability>
      <Nutrition>0.1</Nutrition>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/RM_BloodBouquet/RM_BloodBouquet_a</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <plant>
      <growDays>8</growDays>
      <fertilityMin>0.05</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      <maxMeshCount>2</maxMeshCount>
      <visualSizeRange>0.9~1.5</visualSizeRange>
      <topWindExposure>0.1</topWindExposure>
      <wildOrder>3</wildOrder>
    </plant>
  </ThingDef>

  <ThingDef ParentName="PlantBase">
    <defName>RM_RavenNettle</defName>
    <label>raven nettle</label>
    <description>A jet-black nettle, its stalks bristling with fine barbed hairs that catch on cloth and skin and let go of neither. It grows in thick clumps and hides the ground under it.</description>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <Nutrition>0.1</Nutrition>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/RM_RavenNettle/RM_RavenNettle_a</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <plant>
      <growDays>6</growDays>
      <fertilityMin>0.05</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      <maxMeshCount>3</maxMeshCount>
      <visualSizeRange>0.7~1.3</visualSizeRange>
      <topWindExposure>0.1</topWindExposure>
      <wildOrder>2</wildOrder>
    </plant>
  </ThingDef>

  <ThingDef ParentName="PlantBase">
    <defName>RM_RedBugloss</defName>
    <label>red bugloss</label>
    <description>A bristly-stemmed wildflower carrying clusters of deep red, funnel-shaped blooms. The bristles are hollow and the blooms are the only cheerful thing in the Cauldron; both facts are why the wildlife learns to leave it alone.</description>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <Nutrition>0.1</Nutrition>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/RM_RedBugloss/RM_RedBugloss_a</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <plant>
      <growDays>6</growDays>
      <fertilityMin>0.05</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      <maxMeshCount>3</maxMeshCount>
      <visualSizeRange>0.7~1.3</visualSizeRange>
      <topWindExposure>0.1</topWindExposure>
      <wildOrder>2</wildOrder>
    </plant>
  </ThingDef>

  <ThingDef ParentName="PlantBase">
    <defName>RM_GiantAgariTox</defName>
    <label>giant agaritox</label>
    <description>A colossal toxic mushroom: a stout ridged stalk beneath a huge mottled purple-green cap that oozes a faint haze of spores at its rim. Nothing about it apologises for being poisonous. It stands where the fog is thickest and the ground is oldest, and it dwarfs the trees beside it.</description>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <Flammability>0.3</Flammability>
      <Nutrition>0.1</Nutrition>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/RM_GiantAgariTox/RM_GiantAgariTox_a</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <fillPercent>0.5</fillPercent>
    <plant>
      <growDays>25</growDays>
      <fertilityMin>0.1</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      <maxMeshCount>1</maxMeshCount>
      <visualSizeRange>3.0~4.5</visualSizeRange>
      <topWindExposure>0</topWindExposure>
      <wildClusterRadius>-1</wildClusterRadius>
      <wildOrder>5</wildOrder>
    </plant>
  </ThingDef>

  <ThingDef ParentName="PlantBase">
    <defName>RM_KeeningCordax</defName>
    <label>keening cordax</label>
    <description>A tall alien reed with a hollow, ribbed stalk and a drooping, throat-like seed pod at the top. When the vents exhale, air draws through the stalk and the whole plant wails -- a thin, mournful note that carries a long way through the fog.</description>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <Nutrition>0.1</Nutrition>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/RM_KeeningCordax/RM_KeeningCordax_a</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <fillPercent>0.3</fillPercent>
    <plant>
      <growDays>14</growDays>
      <fertilityMin>0.05</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      <maxMeshCount>1</maxMeshCount>
      <visualSizeRange>2.0~3.0</visualSizeRange>
      <topWindExposure>0.15</topWindExposure>
      <wildOrder>4</wildOrder>
    </plant>
  </ThingDef>

  <ThingDef ParentName="PlantBase">
    <defName>RM_GiantToxicFlower</defName>
    <label>giant toxic flower</label>
    <description>An oversized flower with lurid toxic-green petals that ooze faint venomous droplets. It grows alone, fed by whatever dies beneath it, and it is exactly as poisonous as it looks.</description>
    <statBases>
      <MaxHitPoints>90</MaxHitPoints>
      <Flammability>0.3</Flammability>
      <Nutrition>0.1</Nutrition>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/RM_GiantToxicFlower/RM_GiantToxicFlower_a</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <plant>
      <growDays>12</growDays>
      <fertilityMin>0.05</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      <maxMeshCount>1</maxMeshCount>
      <visualSizeRange>1.4~2.2</visualSizeRange>
      <topWindExposure>0.1</topWindExposure>
      <wildClusterRadius>-1</wildClusterRadius>
      <wildOrder>4</wildOrder>
    </plant>
  </ThingDef>

  <!--
    RM_Xithess: owner-ruled filter-frond flora (cast bible section 3). Harvest
    yields vent-chemistry stock, not wood: the yield is vanilla Chemfuel as the
    stand-in, because no RM_ vent-chemistry item exists yet. Follow-on: a
    dedicated stock item if the owner wants one (noted in the report).
    "Stirring constantly" is art-only for now (one static sprite showing furled
    and spread fronds); a live animation would need C#.
    Art: Textures/Things/Plant/RM_Xithess/RM_Xithess_a.png (present).
  -->
  <ThingDef ParentName="PlantBase">
    <defName>RM_Xithess</defName>
    <label>xithess</label>
    <description>A pale trunk the height of a person, crowned with a fan of fine fronds that never stop moving -- not in wind, in chemistry, combing the fog for what the vents exhale. Watch a xithess for a minute and you understand the whole forest: nothing here drinks water. It filters. Harvesters take the frond-crowns whole and sell them as they are -- a xithess crown is a fistful of the forest's own refinery.</description>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <Flammability>0.6</Flammability>
      <Nutrition>0.1</Nutrition>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/RM_Xithess/RM_Xithess_a</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <plant>
      <growDays>10</growDays>
      <harvestWork>160</harvestWork>
      <harvestYield>8</harvestYield>
      <harvestedThingDef>Chemfuel</harvestedThingDef>
      <harvestMinGrowth>0.5</harvestMinGrowth>
      <fertilityMin>0.05</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      <maxMeshCount>1</maxMeshCount>
      <visualSizeRange>1.0~1.3</visualSizeRange>
      <topWindExposure>0.1</topWindExposure>
      <wildClusterRadius>4</wildClusterRadius>
      <wildOrder>3</wildOrder>
    </plant>
  </ThingDef>

</Defs>
