    </graphicData>
    <plant>
      <growDays>8</growDays>
      <fertilityMin>0.05</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      <maxMeshCount>4</maxMeshCount>
      <visualSizeRange>0.9~1.5</visualSizeRange>
      <topWindExposure>0.1</topWindExposure>
      <wildOrder>3</wildOrder>
    </plant>
    <!-- CAULDRON_VENT_ENRICHMENT_HOOKS_1: vent-keyed habitat (ChronicLeak). -->
    <modExtensions>
      <!-- CAULDRON_ENRICHMENT_VISUALS_1 V2: dew variant while RM_Dewfall (RM_DewfallSaturation). Spec
           default set (spec V2: owner may trim). Art owed, 256x256 against the base; until it is on disk
           the swap is skipped and the Plant.Graphic patch is not installed. -->
      <li Class="RimMandrake.Cauldron.RM_DewfallGraphicExtension">
