<!-- CAULDRON_FLORA_EXPANSION_BUILD_1: six admitted flora from cauldron_flora_expansion_pitch_2026-10-02.md. No green, no leaves, nothing explodes,
     nothing glows warm. Roster rows and numbers are first values to calibrate in play. Gated by RM_CauldronSettings.floraExpansionEnabled. -->
<Defs>
  <ThingDef ParentName="PlantBase">
    <defName>RM_Tsevrix</defName>
    <label>tsevrix</label>
    <description>A low cluster of fist-sized waxy bladders, sulfur-yellow with cinnabar veining, heaped at the base of stones like a spill of wet lanterns that give no light. The bladders bank vent gas as starch, which is why they are filling and why raw they are poison. Roasting drives the volatiles off.</description>
    <statBases>
      <MaxHitPoints>40</MaxHitPoints>
      <Flammability>0.3</Flammability>
      <Nutrition>0.3</Nutrition>
      <Beauty>1</Beauty>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/RM_Tsevrix/RM_Tsevrix</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <selectable>true</selectable>
    <plant>
      <fertilityMin>0.05</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      <maxMeshCount>1</maxMeshCount>
      <topWindExposure>0.05</topWindExposure>
      <growDays>14</growDays>
      <harvestWork>110</harvestWork>
      <harvestedThingDef>RM_TsevrixPulp</harvestedThingDef>
      <harvestYield>6</harvestYield>
      <visualSizeRange>0.5~0.9</visualSizeRange>
      <wildClusterRadius>3</wildClusterRadius>
      <wildClusterWeight>6</wildClusterWeight>
      <wildOrder>2</wildOrder>
      <purpose>Food</purpose>
    </plant>
  </ThingDef>
  <ThingDef ParentName="PlantBaseNonEdible">
    <defName>RM_Ixalith</defName>
    <label>ixalith</label>
    <description>A stand of thin black wire-stalks with translucent films stretched between them like soap skins, every film banded in oil-slick colour that slides as the fog moves. It is vapour condensing into thin skins, not pigment, and it needs no light to look the way it does. Fragile, and the one thing in the Cauldron worth stopping to look at.</description>
    <statBases>
      <MaxHitPoints>14</MaxHitPoints>
      <Flammability>0.6</Flammability>
      <Nutrition>0</Nutrition>
      <Beauty>12</Beauty>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/RM_Ixalith/RM_Ixalith</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <selectable>true</selectable>
    <plant>
      <fertilityMin>0.05</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      <maxMeshCount>1</maxMeshCount>
      <topWindExposure>0.05</topWindExposure>
      <growDays>12</growDays>
      <harvestYield>0</harvestYield>
      <harvestWork>20</harvestWork>
      <visualSizeRange>0.8~1.3</visualSizeRange>
      <wildClusterRadius>-1</wildClusterRadius>
      <wildOrder>3</wildOrder>
      <purpose>Beauty</purpose>
    </plant>
  </ThingDef>
  <ThingDef ParentName="PlantBaseNonEdible">
    <defName>RM_Fexxil</defName>
    <label>fexxil</label>
    <description>A knee-high thicket of cobalt-blue glass burrs: branching spines tipped with tiny hooked crystals, deep blue at the core going pale ice-blue at the tips, each hook holding a bead of condensate. It reads as broken bottle-glass grown into a shrub, and the scratches it leaves carry a dose of the forest's poison.</description>
    <statBases>
      <MaxHitPoints>90</MaxHitPoints>
      <Flammability>0.1</Flammability>
      <Nutrition>0</Nutrition>
      <Beauty>-3</Beauty>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/RM_Fexxil/RM_Fexxil</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <selectable>true</selectable>
    <pathCost>60</pathCost>
    <plant>
      <fertilityMin>0.05</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      <maxMeshCount>1</maxMeshCount>
      <topWindExposure>0.05</topWindExposure>
      <growDays>10</growDays>
      <harvestWork>400</harvestWork>
      <harvestedThingDef>RM_FexxilShard</harvestedThingDef>
      <harvestYield>1</harvestYield>
      <visualSizeRange>0.8~1.2</visualSizeRange>
      <wildClusterRadius>5</wildClusterRadius>
      <wildClusterWeight>8</wildClusterWeight>
      <wildOrder>2</wildOrder>
      <allowAutoCut>false</allowAutoCut>
      <purpose>Misc</purpose>
    </plant>
    <comps>
      <li Class="RimMandrake.EnvironmentalHazards.CompProperties_ContactVenom">
        <damageDef>RM_FexxilScratch</damageDef>
        <damageAmount>3</damageAmount>
        <armorPenetration>0.05</armorPenetration>
        <contactIntervalTicks>2500</contactIntervalTicks>
        <bodyHeight>Bottom</bodyHeight>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="PlantBaseNonEdible">
    <defName>RM_Sessarix</defName>
    <label>sessarix</label>
    <description>Glossy amber-orange resin boils welling out of cracked stone and slag, a tar-black core showing through the skin. It grows only on bare rock and old ruin, never in soil, and so slowly that a patch is a rare find. Cut one open and the resin burns like chemfuel.</description>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <Flammability>0.9</Flammability>
      <Nutrition>0</Nutrition>
      <Beauty>2</Beauty>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/RM_Sessarix/RM_Sessarix</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <selectable>true</selectable>
    <plant>
      <fertilityMin>0.05</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      <maxMeshCount>1</maxMeshCount>
      <topWindExposure>0.05</topWindExposure>
      <completelyIgnoreFertility>true</completelyIgnoreFertility>
      <growDays>30</growDays>
      <harvestWork>260</harvestWork>
      <harvestedThingDef>Chemfuel</harvestedThingDef>
      <harvestYield>2</harvestYield>
      <harvestAfterGrowth>0.4</harvestAfterGrowth>
      <visualSizeRange>0.6~1.0</visualSizeRange>
      <wildClusterRadius>-1</wildClusterRadius>
      <wildOrder>2</wildOrder>
      <terrainBlacklist>
        <li>RM_CauldronSoil</li>
        <li>RM_CauldronSoilRich</li>
        <li>Soil</li>
        <li>SoilRich</li>
      </terrainBlacklist>
      <purpose>Misc</purpose>
    </plant>
  </ThingDef>
  <ThingDef ParentName="PlantBaseNonEdible">
    <defName>RM_Kissaveth</defName>
    <label>kissaveth</label>
    <description>A clump of pale lavender gas-bladders on short stalks, the skins thin enough to show deep violet fluid sloshing inside. Damage splits one and it leaks toxic gas, and so does cutting it down. It leaks, it does not burst.</description>
    <statBases>
      <MaxHitPoints>30</MaxHitPoints>
      <Flammability>0.4</Flammability>
      <Nutrition>0</Nutrition>
      <Beauty>1</Beauty>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/RM_Kissaveth/RM_Kissaveth</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <selectable>true</selectable>
    <plant>
      <fertilityMin>0.05</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      <maxMeshCount>1</maxMeshCount>
      <topWindExposure>0.05</topWindExposure>
      <growDays>10</growDays>
      <harvestWork>30</harvestWork>
      <harvestYield>0</harvestYield>
      <visualSizeRange>0.7~1.2</visualSizeRange>
      <wildClusterRadius>3</wildClusterRadius>
      <wildClusterWeight>5</wildClusterWeight>
      <wildOrder>2</wildOrder>
      <purpose>Misc</purpose>
    </plant>
    <comps>
      <li Class="CompProperties_GasOnDamage">
        <type>ToxGas</type>
        <damageFactor>6</damageFactor>
      </li>
      <li Class="RimMandrake.Cauldron.RM_CompProperties_GasOnCut">
        <gasAmount>120</gasAmount>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="PlantBaseNonEdible">
    <defName>RM_Selvix</defName>
    <label>selvix</label>
    <description>A flat star-shaped rosette of thick wet fuchsia arms, each rimmed with a frost of white crystal where it meets the air, a wine-red heart at the centre. It rings itself on stained ground. The arms are bitter and clean, and a poultice of them does what herbal medicine does.</description>
    <statBases>
      <MaxHitPoints>35</MaxHitPoints>
      <Flammability>0.3</Flammability>
      <Nutrition>0</Nutrition>
      <Beauty>3</Beauty>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/RM_Selvix/RM_Selvix</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <selectable>true</selectable>
    <plant>
      <fertilityMin>0.05</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      <maxMeshCount>1</maxMeshCount>
      <topWindExposure>0.05</topWindExposure>
      <growDays>12</growDays>
      <harvestWork>150</harvestWork>
      <harvestedThingDef>MedicineHerbal</harvestedThingDef>
      <harvestYield>2</harvestYield>
      <harvestAfterGrowth>0.5</harvestAfterGrowth>
      <visualSizeRange>0.6~1.0</visualSizeRange>
      <wildClusterRadius>3</wildClusterRadius>
      <wildClusterWeight>5</wildClusterWeight>
      <wildOrder>2</wildOrder>
      <purpose>Misc</purpose>
