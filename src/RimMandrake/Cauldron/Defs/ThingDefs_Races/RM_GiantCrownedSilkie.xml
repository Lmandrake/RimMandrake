<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
  RM_GiantCrownedSilkie: owned RM_ port of the Alpha Animals GiantCrownedSilkie (sarg.alphaanimals AA_GiantCrownedSilkie, 1.6/Defs/ThingDefs_Races). Phase 0 step P2 (biome_sprint_kickoff_2026-10-15.md 0.5.3), tool src/RimMandrake/Utils/aa_port.py. Free RM_ tier, home mod Cauldron.
  Stats, tools, race fields and pawnkind numbers are the donor's own, as the creature the game shows today
  (our rename/tolerance patches on the donor def are folded in). Departures:
    - wildBiomes dropped (the biome roster casts it); AnimalStatExtension (donor stat defs) dropped.
    - VEF.* comps and VEF_ abilities kept, guarded MayRequire OskarPotocki.VanillaFactionsExpanded.Core (a framework we keep, not the donor).
    - texPath is OUR final path; the PNGs are owed through artpipe (no donor art is reused). Until the art is
      installed through the art ledger this def has no picture: ART OWED, never a pass of the art bar.
    - dessicated donor art and alternate random graphics dropped (vanilla fallback).
    - folded 2 op(s) from src/RimUtinni/UtinniPatches/Patches/AnimalTolerances_Ashkarr.xml
    - texPath Things/Item/Resource/AA_SilkieSilk -> Things/Item/Resource/RM_GiantCrownedSilkieSilk (ART OWED, RM_GiantCrownedSilkieSilk)
-->
  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_GiantCrownedSilkie</defName>
    <label>Sikka Sikka</label>
    <description>A large flightless bird, genetically modified to produce both edible eggs and a valuable silk-like textile. Sikka Sikka was designed from the ground up as a versatile farm animal, perfectly domesticated and -contrary to other ratites- showing very little aggression.\n\nIt is not uncommon to see flocks of silkies grazing in pastures all along the Rim. They are however not usually found in the wild, and when they are there is often a tale of violence behind their roaming around unprotected.</description>
    <statBases>
      <MoveSpeed>3.0</MoveSpeed>
      <ComfyTemperatureMin>-65</ComfyTemperatureMin>
      <ComfyTemperatureMax>38.5</ComfyTemperatureMax>
      <MarketValue>400</MarketValue>
      <FilthRate>4</FilthRate>
      <Wildness>0.1</Wildness>
    </statBases>
    <race>
      <herdAnimal>true</herdAnimal>
      <predator>false</predator>
      <body>Bird</body>
      <baseBodySize>1.1</baseBodySize>
      <baseHealthScale>1</baseHealthScale>
      <baseHungerRate>0.25</baseHungerRate>
      <useMeatFrom>Cassowary</useMeatFrom>
      <foodType>VegetarianRoughAnimal</foodType>
      <manhunterOnDamageChance>0.05</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0.03</manhunterOnTameFailChance>
      <trainability>None</trainability>
      <leatherDef>Leather_Bird</leatherDef>
      <roamMtbDays>3</roamMtbDays>
      <lifeExpectancy>45</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.25</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.5</minAge>
          <soundAngry>Pawn_Peacock_Angry</soundAngry>
          <soundWounded>Pawn_Peacock_Wounded</soundWounded>
          <soundDeath>Pawn_Peacock_Death</soundDeath>
          <soundCall>Pawn_Peacock_Call</soundCall>
        </li>
      </lifeStageAges>
      <soundCallIntervalRange>
        <min>22000</min>
        <max>30000</max>
      </soundCallIntervalRange>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <tradeTags>
      <li>AnimalUncommon</li>
      <li>AnimalFarm</li>
    </tradeTags>
    <comps>
      <li Class="CompProperties_EggLayer">
        <eggUnfertilizedDef>RM_EggGiantCrownedSilkieUnfertilized</eggUnfertilizedDef>
        <eggFertilizedDef>RM_EggGiantCrownedSilkieFertilized</eggFertilizedDef>
        <eggFertilizationCountMax>1</eggFertilizationCountMax>
        <eggLayIntervalDays>5</eggLayIntervalDays>
      </li>
      <li Class="CompProperties_Shearable">
        <woolDef>RM_GiantCrownedSilkieSilk</woolDef>
        <shearIntervalDays>10</shearIntervalDays>
        <woolAmount>30</woolAmount>
      </li>
    </comps>
    <tools>
      <li>
        <label>claws</label>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>12</power>
        <cooldownTime>1.55</cooldownTime>
        <linkedBodyPartsGroup>Feet</linkedBodyPartsGroup>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>15</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>8</power>
        <cooldownTime>1.85</cooldownTime>
        <linkedBodyPartsGroup>Beak</linkedBodyPartsGroup>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>13</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>3</power>
        <cooldownTime>1.65</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
  </ThingDef>
