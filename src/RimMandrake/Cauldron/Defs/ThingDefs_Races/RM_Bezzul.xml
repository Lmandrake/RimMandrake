      <drawSize>2</drawSize>
    </graphicData>
    <projectile>
      <flyOverhead>false</flyOverhead>
      <damageDef>Flame</damageDef>
      <damageAmountBase>1</damageAmountBase>
      <speed>15</speed>
    </projectile>
  </ThingDef>
