  <BodyPartGroupDef>
    <defName>RM_EyestalkAttackTool</defName>
    <label>eyestalk</label>
  </BodyPartGroupDef>
  <AbilityDef>
    <defName>RM_FireSpit</defName>
    <label>fire spit</label>
    <description>Spit a glob of self-igniting fluid that burns its target.</description>
    <iconPath>UI/Abilities/RM_FireSpit</iconPath>
    <cooldownTicksRange>240</cooldownTicksRange>
    <aiCanUse>true</aiCanUse>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>False</disableGizmoWhileUndrafted>
    <writeCombatLog>True</writeCombatLog>
    <verbProperties>
      <verbClass>Verb_AbilityShoot</verbClass>
      <defaultProjectile>RM_FireSpit</defaultProjectile>
      <accuracyTouch>0.85</accuracyTouch>
      <accuracyShort>0.8</accuracyShort>
      <accuracyMedium>0.8</accuracyMedium>
      <accuracyLong>0.7</accuracyLong>
      <range>15</range>
      <burstShotCount>5</burstShotCount>
      <defaultCooldownTime>4</defaultCooldownTime>
      <muzzleFlashScale>0</muzzleFlashScale>
      <warmupTime>3</warmupTime>
      <soundCast>Shot_IncendiaryLauncher</soundCast>
      <commonality>0.9</commonality>
      <minRange>2</minRange>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
      </targetParams>
      <ai_IsWeapon>false</ai_IsWeapon>
    </verbProperties>
  </AbilityDef>
  <ThingDef ParentName="BaseBullet">
    <defName>RM_FireSpit</defName>
    <label>fire spit</label>
    <graphicData>
      <texPath>Things/Projectile/RM_FireSpit</texPath>
