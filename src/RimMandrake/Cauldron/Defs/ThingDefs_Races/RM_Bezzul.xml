<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
  RM_Bezzul: owned RM_ port of the Alpha Animals Plasmorph (sarg.alphaanimals AA_Plasmorph, 1.6/Defs/ThingDefs_Races). Phase 0 step P2 (biome_sprint_kickoff_2026-10-15.md 0.5.3), tool src/RimMandrake/Utils/aa_port.py. Free RM_ tier, home mod Cauldron.
  Stats, tools, race fields and pawnkind numbers are the donor's own, as the creature the game shows today
  (our rename/tolerance patches on the donor def are folded in). Departures:
    - wildBiomes dropped (the biome roster casts it); AnimalStatExtension (donor stat defs) dropped.
    - VEF.* comps and VEF_ abilities kept, guarded MayRequire OskarPotocki.VanillaFactionsExpanded.Core (a framework we keep, not the donor).
    - texPath is OUR final path; the PNGs are owed through artpipe (no donor art is reused). Until the art is
      installed through the art ledger this def has no picture: ART OWED, never a pass of the art bar.
    - dessicated donor art and alternate random graphics dropped (vanilla fallback).
    - folded 2 op(s) from src/RimUtinni/UtinniPatches/Patches/AnimalTolerances_Ashkarr.xml
    - folded 3 op(s) from src/RimUtinni/UtinniPatches/Patches/Slime_Rename.xml
    - useMeatFrom AA_Helixien -> Megaspider (vanilla; PROVISIONAL)
    - iconPath UI/Abilities/AA_FireSpit -> UI/Abilities/RM_FireSpit (ART OWED, RM_FireSpit)
    - texPath Things/Projectiles/AA_FieryProjectile -> Things/Projectile/RM_FireSpit (ART OWED, RM_FireSpit)
-->
  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Bezzul</defName>
    <label>bezzul</label>
    <description>A strange snail shelled in iron sulphide, carrying organs that build a weak electric spark down its length. The bezzul uses that spark to light its own flammable spit before lobbing a burning gobbet at whatever is threatening it.</description>
    <statBases>
      <MoveSpeed>1.00</MoveSpeed>
      <ComfyTemperatureMin>-22.7</ComfyTemperatureMin>
      <ComfyTemperatureMax>74.3</ComfyTemperatureMax>
      <MarketValue>150</MarketValue>
      <ArmorRating_Blunt>0.5</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.5</ArmorRating_Sharp>
      <LeatherAmount>0</LeatherAmount>
      <FilthRate>4</FilthRate>
      <Wildness>0.7</Wildness>
    </statBases>
    <tools>
      <li>
        <label>eyestalk</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>18</power>
        <cooldownTime>1.65</cooldownTime>
        <linkedBodyPartsGroup>RM_EyestalkAttackTool</linkedBodyPartsGroup>
      </li>
    </tools>
    <comps>
      <li Class="VEF.AnimalBehaviours.CompProperties_InitialAbility" MayRequire="OskarPotocki.VanillaFactionsExpanded.Core">
        <initialAbility>RM_FireSpit</initialAbility>
      </li>
    </comps>
    <race>
      <herdAnimal>false</herdAnimal>
      <predator>true</predator>
      <body>RM_Snail</body>
      <baseBodySize>1.00</baseBodySize>
      <baseHungerRate>0.05</baseHungerRate>
      <baseHealthScale>1.0</baseHealthScale>
      <foodType>OmnivoreAnimal</foodType>
      <useMeatFrom>Megaspider</useMeatFrom>
      <maxPreyBodySize>0.3</maxPreyBodySize>
      <trainability>Intermediate</trainability>
      <gestationPeriodDays>12</gestationPeriodDays>
      <litterSizeCurve>
        <points>
          <li>(0.5, 0)</li>
          <li>(1, 1)</li>
          <li>(3, 1)</li>
          <li>(3.5, 0)</li>
        </points>
      </litterSizeCurve>
      <lifeExpectancy>20</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>.2</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>.4</minAge>
          <soundWounded>Pawn_Thrumbo_Pain</soundWounded>
          <soundDeath>Pawn_Thrumbo_Death</soundDeath>
          <soundAngry>Pawn_Thrumbo_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
    </race>
    <tradeTags>
      <li>AnimalUncommon</li>
    </tradeTags>
  </ThingDef>
  <PawnKindDef ParentName="AnimalKindBase">
