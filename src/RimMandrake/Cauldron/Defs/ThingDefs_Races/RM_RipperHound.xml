<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_RipperHound.xml — the ripper hound. DONOR_CODE_PLAIN_PORTS_1 (owner pick "port" on
  Transient/donor_code_creatures_sheet_2026-10-09; the sheet's recommendation: "Port plain with the base
  game's twitch node").

  Ported from Alpha Animals (sarg.alphaanimals, 1.6/Defs/ThingDefs_Races/Races_RipperHound.xml and
  PawnRenderTreeDefs/PawnRenderTreeDef_RipperHound.xml). Label and description are the donor's (no
  rename ruled); the donor's art credit line is dropped from the description because the art is
  temporary here.

  SWAPPED (donor assembly AlphaBehavioursAndEvents): the render tree's two
  PawnRenderNodeProperties_SpasticScaled claw nodes -> the base game's PawnRenderNodeProperties_Spastic
  with the same rotation, duration and spasm ranges. What is lost: the donor's version scaled the claws
  down on babies; the base node draws them at one size.
  SWAPPED (donor assembly, not on the sheet): the claws' damage AA_ExtraDamageInsectoidsClaws ran
  AlphaBehavioursAndEvents.DamageWorker_ExtraDamageInsectoids (bonus damage to insectoids). The claws
  now Scratch like any animal's; the anti-insect bonus is gone.
  SWAPPED for vanilla (donor defs, no code): body AA_ExtraClawedQuadruped (custom claw parts and an
  echolocation organ) -> QuadrupedAnimalWithPawsAndTail, claws linked to FrontLeftPaw/FrontRightPaw;
  dessicated art -> Warg.  DROPPED (donor StatDefs): the VEF AnimalStatExtension info card.
  NOT ported: donor wildBiomes.

  ART: none of ours exists yet. The body and claw texPaths stay on the donor's paths as a loud temporary
  placeholder (RSW_DesertPortMisc_Races.xml precedent). When art lands: install it under
  Things/Pawn/Animal/RM_RipperHound/ and re-point the texPaths here.

  CAST NOWHERE. The owner's Cauldron sheet cut AA_RipperHound from RM_Cauldron the same morning
  (8eaa2b252, 2026-10-09); the donor-code sheet's "RM_Cauldron 0.08" was measured before that cut
  landed. A cut is scoped to its biome, so this def waits for a roster that wants it.
-->
<Defs>

  <PawnRenderTreeDef>
    <defName>RM_RipperHound</defName>
    <root Class="PawnRenderNodeProperties_Parent">
      <debugLabel>Root</debugLabel>
      <tagDef>Root</tagDef>
      <children>
        <li>
          <debugLabel>Body</debugLabel>
          <tagDef>Body</tagDef>
          <nodeClass>PawnRenderNode_AnimalPart</nodeClass>
          <useRottenColor>true</useRottenColor>
          <children>
            <li Class="PawnRenderNodeProperties_Spastic">
              <debugLabel>Left claw</debugLabel>
              <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
              <texPath>Things/Pawn/Animal/AA_RipperHound/AA_RipperHoundLeftClaw</texPath>
              <rotDrawMode>Fresh, Rotting</rotDrawMode>
              <rotateFacing>false</rotateFacing>
              <rotationRange>-15~15</rotationRange>
              <durationTicksRange>10~35</durationTicksRange>
              <nextSpasmTicksRange>10~50</nextSpasmTicksRange>
              <drawSize>1.4</drawSize>
              <baseLayer>10</baseLayer>
              <useRottenColor>true</useRottenColor>
              <drawData>
                <dataEast>
                  <layer>-5</layer>
                </dataEast>
                <dataWest>
                  <flip>true</flip>
                  <layer>-5</layer>
                </dataWest>
              </drawData>
            </li>
            <li Class="PawnRenderNodeProperties_Spastic">
              <debugLabel>Right claw</debugLabel>
              <linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup>
              <texPath>Things/Pawn/Animal/AA_RipperHound/AA_RipperHoundRightClaw</texPath>
              <rotDrawMode>Fresh, Rotting</rotDrawMode>
              <rotateFacing>false</rotateFacing>
              <rotationRange>-15~15</rotationRange>
              <durationTicksRange>10~35</durationTicksRange>
              <nextSpasmTicksRange>10~50</nextSpasmTicksRange>
              <drawSize>1.4</drawSize>
              <baseLayer>10</baseLayer>
              <useRottenColor>true</useRottenColor>
              <drawData>
                <dataWest>
                  <offset>(0, 0, 0)</offset>
                  <flip>true</flip>
                </dataWest>
              </drawData>
            </li>
            <li>
              <debugLabel>Wounds</debugLabel>
              <nodeClass>PawnRenderNode_AnimalPart</nodeClass>
              <workerClass>PawnRenderNodeWorker_OverlayWounds</workerClass>
              <overlayLayer>Body</overlayLayer>
              <useGraphic>false</useGraphic>
              <baseLayer>3</baseLayer>
            </li>
            <li>
              <debugLabel>Pack</debugLabel>
              <nodeClass>PawnRenderNode_AnimalPack</nodeClass>
              <workerClass>PawnRenderNodeWorker_AnimalPack</workerClass>
              <rotDrawMode>Fresh, Rotting</rotDrawMode>
              <baseLayer>5</baseLayer>
            </li>
            <li>
              <debugLabel>Firefoam</debugLabel>
              <nodeClass>PawnRenderNode_AnimalPart</nodeClass>
              <workerClass>PawnRenderNodeWorker_OverlayFirefoam</workerClass>
              <overlayLayer>Body</overlayLayer>
              <useGraphic>false</useGraphic>
              <baseLayer>10</baseLayer>
            </li>
          </children>
        </li>
        <li Class="PawnRenderNodeProperties_Carried">
          <debugLabel>Carried thing</debugLabel>
          <workerClass>PawnRenderNodeWorker_Carried</workerClass>
        </li>
      </children>
    </root>
  </PawnRenderTreeDef>

  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_RipperHound</defName>
    <label>ripper hound</label>
    <description>Ripper Hounds were created as a purely biological defense against Insectoids, a genetically engineered species bred for hunting and defeating them. These hulking canines sport two viciously sharp claws specially designed to attach to chitinous plates and rip them apart.\n\nDespite their fearsome appearance, Ripper Hounds can be extremely affectionate and loyal, and they love to be pet by those they trust.</description>
    <statBases>
      <MoveSpeed>5.00</MoveSpeed>
      <ComfyTemperatureMin>-20</ComfyTemperatureMin>
      <ComfyTemperatureMax>45</ComfyTemperatureMax>
      <MarketValue>550</MarketValue>
      <ArmorRating_Blunt>0.1</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.3</ArmorRating_Sharp>
      <FilthRate>2</FilthRate>
      <Wildness>0.7</Wildness>
    </statBases>
    <tools>
      <li>
        <label>left claw</label>
        <capacities><li>Scratch</li></capacities>
        <power>16</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
      </li>
      <li>
        <label>right claw</label>
        <capacities><li>Scratch</li></capacities>
        <power>16</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup>
      </li>
      <li>
        <capacities><li>Bite</li></capacities>
        <power>18</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        <chanceFactor>0.4</chanceFactor>
      </li>
      <li>
        <label>head</label>
        <capacities><li>Blunt</li></capacities>
        <power>3</power>
        <cooldownTime>1.65</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <race>
      <renderTree>RM_RipperHound</renderTree>
      <body>QuadrupedAnimalWithPawsAndTail</body>
      <specialTrainables>
        <li MayRequire="Ludeon.RimWorld.Odyssey">Comfort</li>
        <li MayRequire="Ludeon.RimWorld.Odyssey">AttackTarget</li>
      </specialTrainables>
      <predator>true</predator>
      <baseBodySize>1.5</baseBodySize>
      <baseHungerRate>0.1</baseHungerRate>
      <baseHealthScale>2</baseHealthScale>
      <foodType>CarnivoreAnimal, OvivoreAnimal</foodType>
      <leatherDef>Leather_Heavy</leatherDef>
      <maxPreyBodySize>2</maxPreyBodySize>
      <trainability>Advanced</trainability>
      <gestationPeriodDays>12</gestationPeriodDays>
      <nameOnTameChance>1</nameOnTameChance>
      <manhunterOnDamageChance>1</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0.05</manhunterOnTameFailChance>
      <nuzzleMtbHours>30</nuzzleMtbHours>
      <litterSizeCurve>
        <points>
          <li>(0.5, 0)</li>
          <li>(1, 1)</li>
          <li>(2, 1.7)</li>
          <li>(3, 0.7)</li>
          <li>(3.5, 0)</li>
        </points>
      </litterSizeCurve>
      <lifeExpectancy>12</lifeExpectancy>
      <lifeStageAges>
        <li><def>AnimalBaby</def><minAge>0</minAge></li>
        <li><def>AnimalJuvenile</def><minAge>0.25</minAge></li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.5</minAge>
          <soundWounded>Pawn_Warg_Wounded</soundWounded>
          <soundDeath>Pawn_Warg_Death</soundDeath>
          <soundCall>Pawn_Warg_Call</soundCall>
          <soundAngry>Pawn_Warg_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <tradeTags>
      <li>AnimalUncommon</li>
      <li>AnimalFighter</li>
    </tradeTags>
  </ThingDef>

  <PawnKindDef ParentName="AnimalKindBase">
    <defName>RM_RipperHound</defName>
    <label>ripper hound</label>
    <race>RM_RipperHound</race>
    <combatPower>125</combatPower>
    <ecoSystemWeight>0.9</ecoSystemWeight>
    <lifeStages>
      <li>
        <label>ripper hound cub</label>
        <labelPlural>ripper hound puppies</labelPlural>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/AA_RipperHound/AA_RipperHound</texPath>
          <drawSize>1.5</drawSize>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Warg/Dessicated_Warg</texPath>
          <drawSize>1.5</drawSize>
        </dessicatedBodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/AA_RipperHound/AA_RipperHound</texPath>
          <drawSize>2</drawSize>
          <shadowData><volume>(0.25, 0.3, 0.25)</volume><offset>(0,0,-0.15)</offset></shadowData>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Warg/Dessicated_Warg</texPath>
          <drawSize>2</drawSize>
        </dessicatedBodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/AA_RipperHound/AA_RipperHound</texPath>
          <drawSize>2.5</drawSize>
          <shadowData><volume>(0.3, 0.4, 0.3)</volume><offset>(0,0,-0.15)</offset></shadowData>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Warg/Dessicated_Warg</texPath>
          <drawSize>2.5</drawSize>
        </dessicatedBodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>

</Defs>
