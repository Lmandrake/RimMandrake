  <!-- The crystal the ossrith sheds. Placeholder art: vanilla uranium tinted crystal-green
       (no ossrith-crystal render exists yet; art owed with the creature's). -->
  <ThingDef ParentName="ResourceBase">
    <defName>RM_OssrithCrystal</defName>
    <label>ossrith crystal</label>
    <description>Hard green crystal broken off an ossrith's spine ridge: the poison it could not digest, pushed out through its plates. Refined at a biofuel refinery, it yields uranium.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Uranium</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(120,200,110)</color>
    </graphicData>
    <tradeability>Sellable</tradeability>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <stackLimit>75</stackLimit>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <MarketValue>65</MarketValue>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>1.8</Mass>
    </statBases>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <tradeTags>
      <li>Exotic</li>
    </tradeTags>
  </ThingDef>

  <RecipeDef>
    <defName>RM_RefineOssrithCrystal</defName>
    <label>refine ossrith crystal</label>
    <description>Refine an ossrith crystal into uranium.</description>
    <jobString>Refining ossrith crystal.</jobString>
    <effectWorking>Cremate</effectWorking>
    <soundWorking>Recipe_Cremate</soundWorking>
    <workAmount>2000</workAmount>
    <recipeUsers>
      <li>BiofuelRefinery</li>
    </recipeUsers>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>RM_OssrithCrystal</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>RM_OssrithCrystal</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Uranium>15</Uranium>
    </products>
  </RecipeDef>

</Defs>
