      <li>
        <texPath>Things/Pawn/Animal/RM_CrystalMit/RM_CrystalMitV_B</texPath>
      </li>
      <li>
        <texPath>Things/Pawn/Animal/RM_CrystalMit/RM_CrystalMitV_C</texPath>
      </li>
    </alternateGraphics>
    <combatPower>50</combatPower>
    <ecoSystemWeight>0.2</ecoSystemWeight>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/RM_CrystalMit/RM_CrystalMit</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.5</drawSize>
          <shadowData>
            <volume>(0.4, 0.3, 0.3)</volume>
            <offset>(0,0,-0.2)</offset>
          </shadowData>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/RM_CrystalMit/RM_CrystalMit</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.75</drawSize>
          <shadowData>
            <volume>(0.6, 0.45, 0.45)</volume>
            <offset>(0,0,-0.25)</offset>
          </shadowData>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/RM_CrystalMit/RM_CrystalMit</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>2</drawSize>
          <shadowData>
            <volume>(0.8, 0.6, 0.6)</volume>
            <offset>(0,0,-0.3)</offset>
          </shadowData>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>
  <ThingDef ParentName="UnfinishedBase">
    <defName>RM_RandomBricks</defName>
    <label>random bricks</label>
    <description>This should never appear ingame. If it does, it's a bug</description>
    <graphicData>
      <texPath>Things/Item/Resource/StoneBlocks</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
  </ThingDef>
</Defs>
