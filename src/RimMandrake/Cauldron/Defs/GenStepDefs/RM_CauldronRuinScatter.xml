<?xml version="1.0" encoding="utf-8"?>
<!--
  CAULDRON_MECHANICS_BUILD_1 part 4: one corroded filter rig per Cauldron map, through the SHARED set-piece scatterer
  (RM_GenStep_PlacedSetPieces + RM_SetPieceElement_SpawnMarker, Environmental Hazards kit). The rig dresses its own site
  (Source/RM_CauldronRuinKit.cs). RM_ScattererValidator_CauldronRuinSite gates it: the ruinKitEnabled Mod Setting, an
  RM_Cauldron map, and a dry, open, unroofed 7x7. Registered onto Base_Player by Patches/RM_CauldronRuinScatter_Register.xml.
  Order 765: after vanilla ruins (750) and the liquid-works scatters (760). count 1, PROVISIONAL.
-->
<Defs>

  <GenStepDef>
    <defName>RM_CauldronRuinScatter</defName>
    <order>765</order>
    <genStep Class="RimMandrake.EnvironmentalHazards.RM_GenStep_PlacedSetPieces">
      <count>1</count>
      <minEdgeDistPct>0.1</minEdgeDistPct>
      <warnOnFail>false</warnOnFail>
      <validators>
        <li Class="RimMandrake.Cauldron.RM_ScattererValidator_CauldronRuinSite">
          <clearRadius>3</clearRadius>
        </li>
      </validators>
      <elements>
        <li Class="RimMandrake.EnvironmentalHazards.RM_SetPieceElement_SpawnMarker">
          <markerDef>RM_CorrodedFilterRig</markerDef>
        </li>
      </elements>
    </genStep>
  </GenStepDef>

</Defs>
