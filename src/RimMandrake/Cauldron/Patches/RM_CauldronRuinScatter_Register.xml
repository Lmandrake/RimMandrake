<?xml version="1.0" encoding="utf-8"?>
<!--
  CAULDRON_MECHANICS_BUILD_1 part 4: register the corroded-ruin scatter (Defs/GenStepDefs/RM_CauldronRuinScatter.xml) onto
  Base_Player. The scatterer is the Environmental Hazards kit's, which this mod depends on (About.xml), so no FindMod
  guard is needed. The validator keeps it to RM_Cauldron maps.
-->
<Patch>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/MapGeneratorDef[defName="Base_Player"]/genSteps</xpath>
    <value>
      <li>RM_CauldronRuinScatter</li>
    </value>
  </Operation>
</Patch>
