<?xml version="1.0" encoding="utf-8"?>
<!--
  GRAVSHIP_ACOUSTIC_SCANNER_1: the acoustic-scanner payload for RM_Cauldron.
  Owner decision by question card 2026-10-06: the payload goes on EVERY biome of ours.

  Pure XML, FindMod-guarded on "RimMandrake: Acoustic Scanner", so the extension class
  is only named while its assembly is active. Every def is a defName STRING resolved
  at pulse time (GetNamedSilentFail), so a target naming another mod's def just hears
  nothing when that mod is absent. Each target is drawn from this biome's own content;
  the biome's sitting may re-author it. The reading is always banded by the scanner.
-->
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>RimMandrake: Acoustic Scanner</li>
    </mods>
    <match Class="PatchOperationAddModExtension">
      <xpath>/Defs/BiomeDef[defName="RM_Cauldron"]</xpath>
      <value>
        <li Class="RimMandrake.AcousticScanner.RM_AcousticPayloadExtension">
          <quietText>Only the forest's own wet engine noise, rising and falling. Nothing answers it.</quietText>
          <targets>
            <li>
              <label>vent</label>
              <reading>A roar under the ground that rises and falls like breath, too regular for the weather.</reading>
              <color>(1, 0.85, 0.35)</color>
              <weight>2</weight>
              <thingDefs>
                <li>RM_CauldronVent</li>
              </thingDefs>
            </li>
            <li>
              <label>something listening back</label>
              <reading>The ground's own noise stops for a moment, the way a held breath stops. Something heard the pulse.</reading>
              <color>(1, 0.4, 0.3)</color>
              <weight>2</weight>
              <pawnRaces>
                <li>RM_Vexxiss</li>
                <li>RM_Zisska</li>
              </pawnRaces>
            </li>
            <li>
              <label>resin boils</label>
              <reading>Thick, slow, sticky echoes from cracks in the stone: resin welling where nobody can see it.</reading>
              <color>(1, 0.6, 0.25)</color>
              <thingDefs>
                <li>RM_Sessarix</li>
              </thingDefs>
            </li>
            <li>
              <label>void in the rock</label>
              <reading>The echo drops into a hollow under the forest floor.</reading>
              <color>(0.6, 0.6, 0.9)</color>
              <hiddenCaves>true</hiddenCaves>
              <cellSampleStride>4</cellSampleStride>
            </li>
          </targets>
        </li>
      </value>
    </match>
  </Operation>
</Patch>
