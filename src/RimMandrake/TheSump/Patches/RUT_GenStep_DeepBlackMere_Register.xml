<?xml version="1.0" encoding="utf-8"?>
<!--
  RUT_GenStep_DeepBlackMere_Register.xml   RM_TheSump — SUMP_TAR_HYDROLOGY_1

  Registers RUT_GenStep_DeepBlackMere onto Base_Player, the player's home-map
  generator — same PatchOperationConditional/PatchOperationAdd shape as this
  same folder's own precedent, RUT_SumpTarBeastGenStep_Register.xml (read
  directly before writing this).

  No MayRequire on the added <li>: the GenStepDef ships in this same mod, so
  it is always present whenever this patch is. A self-naming
  MayRequire naming mandrake.rm.thesump itself used to sit here; inside the composed
  RimMandrake: Baroque Biomes that packageId is never active, so the guard
  silently dropped the genstep (BAROQUE_BIOMES_COMPOSE_1 sweep 4).
-->
<Patch>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/MapGeneratorDef[defName="Base_Player"]/genSteps</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/MapGeneratorDef[defName="Base_Player"]/genSteps</xpath>
      <value>
        <li>RUT_GenStep_DeepBlackMere</li>
      </value>
    </match>
  </Operation>

</Patch>
