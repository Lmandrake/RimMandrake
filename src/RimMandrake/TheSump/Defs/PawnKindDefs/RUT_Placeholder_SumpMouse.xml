    <label>sump mouse (placeholder)</label>
    <race>RUT_Placeholder_SumpMouseRace</race>
    <combatPower>33</combatPower>
    <ecoSystemWeight>0.2</ecoSystemWeight>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/Squirrel/Squirrel</texPath>
          <drawSize>1</drawSize>
          <color>(25,22,20)</color>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Squirrel/Dessicated_Squirrel</texPath>
          <drawSize>1</drawSize>
        </dessicatedBodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/Squirrel/Squirrel</texPath>
          <drawSize>1.25</drawSize>
          <color>(25,22,20)</color>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Squirrel/Dessicated_Squirrel</texPath>
          <drawSize>1.25</drawSize>
        </dessicatedBodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/Squirrel/Squirrel</texPath>
          <drawSize>1.5</drawSize>
          <color>(25,22,20)</color>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Squirrel/Dessicated_Squirrel</texPath>
          <drawSize>1.5</drawSize>
        </dessicatedBodyGraphicData>
