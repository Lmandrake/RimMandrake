<?xml version="1.0" encoding="utf-8"?>
<!-- SUMP_CAPSTAN_TURRET_BUILD_1 (sump_bedazzle_review_2026-10-01.md §5). Free tier. Base and top art from artpipe
     (RM_CapstanTurret_Base / _Top, 256px, drawsize 2); the top is drawn by RM_CapstanTurret.DrawAt, turned toward the
     roped pawn. The learned recipe: steel, components, cloth. -->
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>RM_CapstanTurret</defName>
    <label>capstan turret</label>
    <description>A powered capstan on a turret ring. It throws a barbed grapple at a visible enemy within range and reels them in along the ground toward itself, cell by cell, through anything they could walk through. With no enemy in sight it ropes a downed colonist in the open and hauls them to safety. A heavy beast, or a fighter who struggles hard enough, parts the line, and the snap strains the turret.</description>
    <thingClass>RimMandrake.TheSump.RM_CapstanTurret</thingClass>
    <graphicData>
      <texPath>Things/Building/CapstanTurret/RM_CapstanTurret_Base</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <drawerType>MapMeshAndRealTime</drawerType>
    <altitudeLayer>Building</altitudeLayer>
    <size>(2,2)</size>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.4</fillPercent>
    <castEdgeShadows>true</castEdgeShadows>
    <tickerType>Normal</tickerType>
    <rotatable>false</rotatable>
    <statBases>
      <MaxHitPoints>220</MaxHitPoints>
      <WorkToBuild>3000</WorkToBuild>
      <Flammability>0.5</Flammability>
      <Mass>60</Mass>
      <Beauty>-10</Beauty>
    </statBases>
    <costList>
      <Steel>120</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
      <Cloth>30</Cloth>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>200</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
    </comps>
    <designationCategory>Security</designationCategory>
    <researchPrerequisites>
      <li>RM_CapstanTurret</li>
    </researchPrerequisites>
    <constructEffect>ConstructMetal</constructEffect>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <building>
      <ai_combatDangerous>true</ai_combatDangerous>
    </building>
  </ThingDef>
</Defs>
