  <RecipeDef ParentName="RM_SealRecipeBase" MayRequire="mandrake.rm.coldstorage">
    <defName>RM_TarSealMeat</defName>
    <label>tar-seal meat</label>
    <description>Tar-seal meat.</description>
    <jobString>Tar-sealing meat.</jobString>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>MeatRaw</li>
          </categories>
          <disallowedCategories>
            <li MayRequire="Ludeon.RimWorld.Odyssey">Fish</li>
            <li>RM_AgedFoods</li>
          </disallowedCategories>
        </filter>
        <count>0.5</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>RM_Bitumen</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>RM_Bitumen</li>
      </thingDefs>
      <categories>
        <li>MeatRaw</li>
      </categories>
      <disallowedCategories>
        <li MayRequire="Ludeon.RimWorld.Odyssey">Fish</li>
        <li>RM_AgedFoods</li>
      </disallowedCategories>
    </fixedIngredientFilter>
    <products>
      <RM_TarSealedMeat>10</RM_TarSealedMeat>
    </products>
    <recipeUsers>
      <li>RM_TarSealingVat</li>
    </recipeUsers>
    <researchPrerequisite>RM_TarRendering</researchPrerequisite>
    <modExtensions>
      <li Class="RimMandrake.ColdStorage.ColdStorageGateExtension">
        <gate>External</gate>
        <settingField>RimMandrake.TheSump.RM_TheSumpSettings:tarSealEnabled</settingField>
      </li>
      <li Class="RimMandrake.ColdStorage.ColdStorageProductHazardExtension">
        <skill>Cooking</skill>
        <belowLevel>8</belowLevel>
        <chance>0.1</chance>
        <ruinedInto>RM_TarRuinedGoods</ruinedInto>
        <chanceSettingField>RimMandrake.TheSump.RM_TheSumpSettings:tarSealRuinChance</chanceSettingField>
      </li>
    </modExtensions>
  </RecipeDef>

