<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_TarRain.xml - SUMP_TAR_LIVING_SYSTEMS_1 part 2. Owner, typed 2026-10-09: "Flowworks supports tar rain but
  campaign does not. The biome itself does except for the campaign. Correct." Ruling 1: "Tar rain is part of mod
  but not this scenario."

  The burst weather of RM_SumpTarRainLock (GameConditionDefs/): the same dusk sky gone darker and browner, with a
  black drizzle that lays RM_Filth_Tar on open ground and on pawns caught under open sky (they become tarred through
  the existing carried-filth hediff). rainRate 0 ON PURPOSE: tar does not douse fire, soak pawns, or fill pits and
  pools with water. The campaign never sees it (UtinniPatches/Patches/Campaign_SumpNoTarRain.xml).

  Every number is PROVISIONAL (owner ruling 2026-10-03: first-guess numbers ship, tuned live later): an event
  every ~250 ticks coating ~6 cells per 250x250 map, 4% per event per exposed pawn. Scaled by the Sump's
  "Tar rain" Mod Settings (gate Sump.tarRain, scale Sump.tarRainIntensity).
-->
<Defs>

  <WeatherDef>
    <defName>RM_TarRain</defName>
    <label>tar rain</label>
    <description>A slow black drizzle out of the dusk. Every drop is tar: it spots the ground, sticks to anyone out in the open, and does nothing at all to a fire.</description>
    <isBad>true</isBad>
    <repeatable>true</repeatable>
    <windSpeedFactor>0.4</windSpeedFactor>
    <rainRate>0</rainRate>
    <snowRate>0</snowRate>
    <favorability>Bad</favorability>
    <perceivePriority>2</perceivePriority>
    <moveSpeedMultiplier>0.9</moveSpeedMultiplier>
    <ambientSounds>
      <li>Ambient_Rain</li>
    </ambientSounds>
    <overlayClasses>
      <li>WeatherOverlay_Rain</li>
    </overlayClasses>
    <eventMakers>
      <li>
        <averageInterval>250</averageInterval>
        <eventClass>RimMandrake.EnvironmentalHazards.RM_WeatherEvent_FilthRain</eventClass>
      </li>
    </eventMakers>
    <skyColorsDay>
      <sky>(0.30,0.22,0.17)</sky>
      <shadow>(0.42,0.36,0.33)</shadow>
      <overlay>(0.36,0.29,0.25)</overlay>
      <saturation>0.7</saturation>
    </skyColorsDay>
    <skyColorsDusk>
      <sky>(0.38,0.25,0.15)</sky>
      <shadow>(0.42,0.35,0.31)</shadow>
      <overlay>(0.40,0.30,0.23)</overlay>
      <saturation>0.8</saturation>
    </skyColorsDusk>
    <skyColorsNightEdge>
      <sky>(0.22,0.15,0.13)</sky>
      <shadow>(0.34,0.30,0.30)</shadow>
      <overlay>(0.27,0.23,0.23)</overlay>
      <saturation>0.7</saturation>
    </skyColorsNightEdge>
    <skyColorsNightMid>
      <sky>(0.15,0.10,0.10)</sky>
      <shadow>(0.26,0.24,0.24)</shadow>
      <overlay>(0.20,0.17,0.19)</overlay>
      <saturation>0.65</saturation>
    </skyColorsNightMid>
    <modExtensions>
      <li Class="RimMandrake.EnvironmentalHazards.RM_FilthRainExtension">
        <filthDef>RM_Filth_Tar</filthDef>
        <cellsPerEvent>6</cellsPerEvent>          <!-- PROVISIONAL -->
        <pawnFilthChance>0.04</pawnFilthChance>   <!-- PROVISIONAL -->
        <intensityKey>Sump.tarRainIntensity</intensityKey>
      </li>
      <li Class="RimMandrake.EnvironmentalHazards.RM_MechanicGateExtension">
        <gateKey>Sump.tarRain</gateKey>
      </li>
    </modExtensions>
  </WeatherDef>

</Defs>
