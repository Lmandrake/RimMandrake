<?xml version="1.0" encoding="utf-8"?>
<!--
  SHADE_LESSONS_BUILD_WATCH_THE_HERD_CROSS: one local shade lesson per hot biome (design §4,
  design/RimMandrake/shadecraft_lessons_design_2026-10-31.md). Each source gets a found-tech study comp for its idea.
  The picks are delegated agent taste, each from the thing's own description; any can be swapped.

  PatchOperationConditional on the def's own xpath, never PatchOperationFindMod: these mods are composed into
  mandrake.rm.biomes, so a member's own packageId never loads (design §5). A def that is absent matches nothing and
  the row is skipped. The comp is added to the def's own <comps>, or a <comps> is made (inheritance merges it with a
  parent's list).

  RUT_ twin rows: added only where the twin's cast holds no source above (measured from the twins' wildPlants,
  2026-11-05). RUT_TheScald and RUT_RustCathedral have no plant cast and get no row; crossings still teach portable
  shade there. frequencyTicks 15000 and knowledgeToReveal 12 are PROVISIONAL, the Stellock/Spunstone scale.
-->
<Patch>

  <!-- Long Shade: RM_Dewfringe teaches keeping dew off -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="RM_Dewfringe"]/comps</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="RM_Dewfringe"]/comps</xpath>
      <value>
            <li Class="RimMandrake.EnvironmentalHazards.CompProperties_FoundTechStudy">
              <project>RM_ShadeIdea_DewOff</project>
              <gateKey>EnvironmentalHazards.ShadeLessons</gateKey>
              <frequencyTicks>15000</frequencyTicks>
              <knowledgeToReveal>12</knowledgeToReveal>
              <letterLabel>Keeping dew off</letterLabel>
              <letterText>{STUDIER} has turned dewfringe fronds over at dawn: the dew beads and runs off their waxed tips instead of soaking in, and the ground under them stays dry.</letterText>
              <inspectLabel>Dew-off study (colony)</inspectLabel>
            </li>
      </value>
    </match>
    <nomatch Class="PatchOperationConditional">
      <xpath>Defs/ThingDef[defName="RM_Dewfringe"]</xpath>
