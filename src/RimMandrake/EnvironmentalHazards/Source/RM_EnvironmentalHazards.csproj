    <!-- VENOMVINE_FORTRESS_PASSABILITY_1. PathRequest.IPathGridCustomizer —
         the engine's own per-request path-cost extension point — is declared
         in terms of NativeArray<ushort>, so the barrier grid cannot be
         written without this. It ships with the game
         (RimWorldWin64_Data\Managed\Unity.Collections.dll) and is loaded
         before any mod assembly, exactly like UnityEngine.CoreModule above. -->
    <Reference Include="Unity.Collections">
      <HintPath>$(RimWorldManaged)\Unity.Collections.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- FEVER_WOOD_MECHANICS_1 F2: RUT_IncidentWorker_MirrorBreak reuses
         RM_MapComponent_SilenceCue.TriggerHush. Same recipe as
         RM_ShipVermin.csproj's own reference to this DLL — real at runtime
         as long as mandrake.rm.creaturebehaviors is active and loadAfter
         (asserted in About.xml). Build CreatureBehaviors FIRST:
           "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\RimMandrake\src\RimMandrake\CreatureBehaviors\Source\RM_CreatureBehaviors.csproj -c Release -->
    <Reference Include="RimMandrake.CreatureBehaviors">
      <HintPath>..\..\CreatureBehaviors\Assemblies\RimMandrake.CreatureBehaviors.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- SUMP_TAR_FIRE_NETWORK_1 part 2: RUT_IncidentWorker_TarPitBelch now
         spawns a real RimMandrake.FlowWorks.Flood_FlowWorks release (RM_Fluid_Tar)
         instead of a filth splash. Same recipe as the CreatureBehaviors
         reference above: mandrake.rm.flowworks becomes a real dependency of
         this mod (see About.xml), and this incident already hard-required
         FlowWorks' own RM_TarDeep/RM_TarShallow terrain (by defName string)
         to ever fire at all, so this only makes an existing dependency
         honest rather than adding a new one. -->
    <Reference Include="RimMandrakeFlowWorks">
      <HintPath>..\..\FlowWorks\Assemblies\RimMandrakeFlowWorks.dll</HintPath>
      <Private>false</Private>
    </Reference>
