<?xml version="1.0" encoding="utf-8"?>
<!--
  PLANT_TIERS_RECONCILE_MOST_ARE_BAROQUE (owner, 2026-10-16): Utinni/Star Wars plant defs that were retired
  into their Baroque Biomes RM_ twin, or moved there under an RM_ name. A save holding the old name (a plant
  on a map, a harvested item) loads it as the RM_ def through RM_DefAliasDef (RM_DefAliases.cs, this mod).
  Not aliased, because they were removed outright on his notes: RUT_TwinkleSpikeTestPlant ("cut this") and
  the ten VCE_Plant_* succulents ("remove terran"), and RUT_TreeMartyr/RM_TreeMartyr (tree tiers sheet
  2026-10-18: "Cut and remove from game") - a saved one is dropped with a load warning.
-->
<Defs>
  <RimMandrake.EnvironmentalHazards.RM_DefAliasDef>
    <defName>RM_PlantTierReconcileAliases</defName>
    <aliases>
      <li><from>RUT_GiantLeaf</from><to>RM_GiantLeaf</to><defType>ThingDef</defType></li>
      <li><from>RUT_RawGiantLeaf</from><to>RM_RawGiantLeaf</to><defType>ThingDef</defType></li>
