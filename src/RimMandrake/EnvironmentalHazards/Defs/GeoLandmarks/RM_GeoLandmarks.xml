      <li Class="RimMandrake.EnvironmentalHazards.RM_GeoStonesExtension">
        <setting>geoColdstoneShieldEnabled</setting>
        <stones>
          <li>Granite</li>
          <li>SolidIce</li>
        </stones>
      </li>
    </modExtensions>
  </TileMutatorDef>
  <LandmarkDef>
    <defName>RM_Geo_ColdstoneShield</defName>
    <label>The Coldstone Shield</label>
