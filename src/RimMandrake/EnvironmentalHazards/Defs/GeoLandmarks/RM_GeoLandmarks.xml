    <defName>RM_Geo_Hullbed</defName>
    <label>exposed wreck stratum</label>
    <description>The Rust Cathedral's buried deck plate surfaces here, far outside the cathedral, bedded in sandstone. The walls of a map here are deck plate and sandstone.</description>
    <categories>
      <li>RM_Geo_Hullbed</li>
    </categories>
    <chanceOnNonLandmarkTile>0</chanceOnNonLandmarkTile>
    <modExtensions>
      <li Class="RimMandrake.EnvironmentalHazards.RM_GeoStonesExtension">
        <setting>geoHullbedEnabled</setting>
        <stones>
          <li>RM_CathedralDeckPlate</li>
          <li>Sandstone</li>
        </stones>
      </li>
    </modExtensions>
  </TileMutatorDef>
  <LandmarkDef>
    <defName>RM_Geo_Hullbed</defName>
    <label>The Hullbed</label>
    <iconTexturePath>World/Landmarks/Plateau</iconTexturePath>
