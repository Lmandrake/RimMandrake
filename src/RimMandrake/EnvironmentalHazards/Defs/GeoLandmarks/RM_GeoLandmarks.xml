  <!-- The Coldstone Shield: frost-shattered granite shield; centre and label tile 13720, 2 rings. -->
  <TileMutatorDef>
    <defName>RM_Geo_ColdstoneShield</defName>
    <label>frost-shattered granite shield</label>
    <description>A night-side granite upland with ice in its joints. The walls of a map here are granite and solid ice.</description>
    <categories>
      <li>RM_Geo_ColdstoneShield</li>
    </categories>
    <chanceOnNonLandmarkTile>0</chanceOnNonLandmarkTile>
