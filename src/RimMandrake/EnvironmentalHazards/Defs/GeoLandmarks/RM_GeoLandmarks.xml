<?xml version="1.0" encoding="utf-8"?>
<!-- GEOSTONE_BUILD_SIX_LABELS_AWAIT_STAMP: the six hand-placed geological landmarks of
     design/RimMandrake/world_remake_2026-10-19/16_geo_landmarks.md (data of record: geo_landmarks.csv; frozen tiles:
     geo_landmarks_tiles.csv). Each is a TileMutatorDef RM_Geo_<Name> carrying RM_GeoStonesExtension (its stones, its
     Mod Settings switch) and a LandmarkDef of the same name whose only mutator is its own, required: AddLandmark rolls
     every chance in that list onto the tile, so any other entry would put random extras on the one planet.
     Hand-placed only: LandmarkDef commonality 0 and TileMutatorDef chanceOnNonLandmarkTile 0, so no world generation
     ever places one (CLAUDE.md: there is no worldgen feature). The stamp is part of the one paint
     (BIOME_PAINT_ONCE_AT_THE_END_1). Each mutator has a category of its own: Tile.AddMutator drops a mutator that shares
     a category with a later one. The stones are stones_now; stones_planned waits on BIOME_STONES_DESIGN_BASALT_JOINS_THE_BAND.
     The C#: Source/RM_GeoStones.cs. PLACEHOLDER ART: the landmark icons are vanilla Odyssey icons. -->
<Defs>

  <!-- The Black Stair: basalt province; centre and label tile 3653, 3 rings. -->
  <TileMutatorDef>
    <defName>RM_Geo_BlackStair</defName>
    <label>basalt province</label>
    <description>Flood basalt steps down off the Forge here, across four neighbouring lands. The walls of a map here are the province's dark stone, not the land's own.</description>
    <categories>
      <li>RM_Geo_BlackStair</li>
    </categories>
    <chanceOnNonLandmarkTile>0</chanceOnNonLandmarkTile>
    <modExtensions>
      <li Class="RimMandrake.EnvironmentalHazards.RM_GeoStonesExtension">
        <setting>geoBlackStairEnabled</setting>
        <stones>
          <li>Slate</li>
          <li>Granite</li>
        </stones>
      </li>
    </modExtensions>
  </TileMutatorDef>
  <LandmarkDef>
    <defName>RM_Geo_BlackStair</defName>
    <label>The Black Stair</label>
    <iconTexturePath>World/Landmarks/Cliffs</iconTexturePath>
    <atlasSize>(2, 2)</atlasSize>
    <commonality>0</commonality>
    <mutatorChances>
      <RM_Geo_BlackStair Required="True" />
    </mutatorChances>
  </LandmarkDef>

  <!-- The Salt Knolls: salt dome field; centre and label tile 9802, 2 rings. -->
  <TileMutatorDef>
    <defName>RM_Geo_SaltKnolls</defName>
    <label>salt dome field</label>
    <description>Low knolls of limestone caprock over buried salt plugs. The walls of a map here are that caprock, not the land's own stone.</description>
    <categories>
      <li>RM_Geo_SaltKnolls</li>
    </categories>
    <chanceOnNonLandmarkTile>0</chanceOnNonLandmarkTile>
    <modExtensions>
      <li Class="RimMandrake.EnvironmentalHazards.RM_GeoStonesExtension">
        <setting>geoSaltKnollsEnabled</setting>
        <stones>
          <li>Limestone</li>
        </stones>
      </li>
    </modExtensions>
  </TileMutatorDef>
  <LandmarkDef>
    <defName>RM_Geo_SaltKnolls</defName>
    <label>The Salt Knolls</label>
    <iconTexturePath>World/Landmarks/Plateau</iconTexturePath>
    <atlasSize>(2, 2)</atlasSize>
    <commonality>0</commonality>
    <mutatorChances>
      <RM_Geo_SaltKnolls Required="True" />
    </mutatorChances>
  </LandmarkDef>

