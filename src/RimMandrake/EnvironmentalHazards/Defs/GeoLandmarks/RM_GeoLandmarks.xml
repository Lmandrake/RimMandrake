    <defName>RM_Geo_ChalkStep</defName>
    <label>exposed stratum</label>
    <description>One white chalk bed cut across four twilight lands. Every wall of a map here is that one stone.</description>
    <categories>
      <li>RM_Geo_ChalkStep</li>
