    <categories>
      <li>RM_Geo_StarfallRim</li>
    </categories>
    <chanceOnNonLandmarkTile>0</chanceOnNonLandmarkTile>
    <modExtensions>
      <li Class="RimMandrake.EnvironmentalHazards.RM_GeoStonesExtension">
        <setting>geoStarfallRimEnabled</setting>
        <stones>
          <li>Granite</li>
          <li>Marble</li>
        </stones>
      </li>
    </modExtensions>
  </TileMutatorDef>
  <LandmarkDef>
    <defName>RM_Geo_StarfallRim</defName>
    <label>Starfall Rim</label>
    <iconTexturePath>World/Landmarks/Cliffs</iconTexturePath>
    <atlasSize>(2, 2)</atlasSize>
    <commonality>0</commonality>
    <mutatorChances>
      <RM_Geo_StarfallRim Required="True" />
    </mutatorChances>
  </LandmarkDef>

