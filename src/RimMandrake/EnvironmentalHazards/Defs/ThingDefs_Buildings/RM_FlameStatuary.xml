<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_FlameStatuary.xml                  EnvironmentalHazards — RETIRED (FLAME_STATUES_MOD_BUILD_1)

  Replaced by mandrake.rm.flamestatues (RM_FlameStatue_Ember/Dancer/Colossus, statue_mods_spec.md §2.1).
  Kept ONLY so saves that hold a placed one still load: 2026-10-10 keeper-save search found placed instances
  in SCALD_REVIEW.rws and rimbridge_save_20260925_130651.rws. Not buildable, not craftable, not a reward
  (designationCategory, recipeMaker, thingSetMakerTags and tradeTags removed). Delete after the world remake.
-->
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>RM_FlameStatuary</defName>
    <label>flame statuary (retired)</label>
    <description>A grand sculpture built to carry fire in its own shape — flame issues from carved vents worked into the stone, dancing along whatever form the artist gave it. A rough piece merely flickers; a masterwork seems to breathe.</description>
    <thingClass>Building_Art</thingClass>
    <castEdgeShadows>true</castEdgeShadows>
    <graphicData>
      <texPath>Things/Building/Art/RM_FlameStatuary/RM_FlameStatuary</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(4,4)</drawSize>
    </graphicData>
    <uiIconScale>0.6666</uiIconScale>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <useHitPoints>true</useHitPoints>
    <!-- BuildingBase never sets tickerType (confirmed against
         Data/Core/Defs/ThingDefs_Buildings/Buildings_Base.xml and
         Buildings_Art.xml — ArtBuildingBase/SculptureBase/SculptureGrand
         none of them set it either), so without this the default
         TickerType.Never means TickManager never calls Tick() and
         RM_Comp_WarblingGlow.CompTick() — the whole "flames issue from the
         statue, quality scales the fire show" mechanism — never runs.
         RM_ConstellationLampBase (TerminalBiomes/RM_TwilightConstellation.xml)
         carries the same RM_CompProperties_WarblingGlow comp and sets
         Normal for exactly this reason; matched here. -->
    <tickerType>Normal</tickerType>
    <rotatable>false</rotatable>
    <noRightClickDraftAttack>true</noRightClickDraftAttack>
    <fillPercent>0.5</fillPercent>
    <size>(2,2)</size>
    <canOverlapZones>false</canOverlapZones>
    <thingCategories>
      <li>BuildingsArt</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <Mass>28</Mass>
      <Beauty>400</Beauty>
      <WorkToMake>105000</WorkToMake>
      <Flammability>1.0</Flammability>
      <MeditationFocusStrength>0.0</MeditationFocusStrength>
      <SellPriceFactor>1.10</SellPriceFactor>
    </statBases>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>400</costStuffCount>
    <minifiedDef>MinifiedThing</minifiedDef>
    <placeWorkers>
      <li>PlaceWorker_MeditationOffsetBuildingsNear</li>
    </placeWorkers>
    <comps>
      <li>
        <compClass>CompQuality</compClass>
      </li>
      <li Class="CompProperties_Styleable" />
      <li Class="CompProperties_Art">
        <nameMaker>NamerArtSculpture</nameMaker>
        <descriptionMaker>ArtDescription_Sculpture</descriptionMaker>
        <canBeEnjoyedAsArt>true</canBeEnjoyedAsArt>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>9</glowRadius>
        <glowColor>(255,120,40,0)</glowColor>
        <colorPickerEnabled>false</colorPickerEnabled>
      </li>
      <li Class="RimMandrake.EnvironmentalHazards.RM_CompProperties_WarblingGlow">
        <hueRangeDegrees>22</hueRangeDegrees>
        <valuePulseFraction>0.18</valuePulseFraction>
        <radiusPulseFraction>0.16</radiusPulseFraction>
        <primaryPeriodTicks>179</primaryPeriodTicks>
        <secondaryPeriodTicks>113</secondaryPeriodTicks>
        <updateIntervalTicks>10</updateIntervalTicks>
        <qualityScalingEnabled>true</qualityScalingEnabled>
      </li>
    </comps>
    <techLevel>Neolithic</techLevel>
  </ThingDef>

</Defs>
