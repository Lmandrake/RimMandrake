<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_ShadeGear.xml                       EnvironmentalHazards - SHADE_GEAR_FAMILY_1

  The owner's words (longshade_shade_ideation_2026-09-29.md, volley turn 4):
  "Parisols, shade tents, simple shields you can stand behind. But again, this
  MUST be applied on other biomes where heat is extreme too... and there shade
  won't help you (in steam) or sideways shade (deep desert)."

  Two cross-biome pieces. The mechanics are NOT here: each carries
  RimMandrake.CreatureBehaviors.RM_CompProperties_ShadeGear, and its shade goes
  into RM_MapComponent_ShadeGrid and from there into Direct Sun through the same
  exposure rule roofs and cast shadows use (RM_ShadeGear.cs,
  RM_SunHeatMath.GearDepth). Each covers the same at every sun elevation and on
  every map (DIRECT_SUN_UNIFY_GEOMETRY_ALONE_DECIDES; owner, 2026-10-19: "Keep
  only Parasols and Tents, and Tents are just a quick structure (any roof
  structure will do the same)"). The sun shield was removed: a wall casts the
  same lee. Hot air (steam, volcanic) is air temperature, which no shade cools.

  Depth = shadeDepth + the stuff's RM_ShadeClothExtension.shadeBonus, clamped
  to 1. Mirrak hide (LongShade, RM_Leather_Mirrak) carries +0.3, the deepest.
  All numbers are INVENTED first values; the selftest
  (Utils/selftest_sun_heat.py) reads them from THIS file.

  Placement follows the sibling scald wrap (TerminalBiomes RM_ScaldGear.xml):
  Neolithic, tailoring benches or a crafting spot for the parasol; the tent
  is built from the Temperature tab. The parasol and the tent
  each need one plain research project (RM_Research_Parasol,
  RM_Research_ShadeTent; SHADE_LESSONS_BUILD_WATCH_THE_HERD_CROSS, file
  ResearchProjectDefs/RM_ShadeLessons_Research.xml), which shade lessons
  discount.

  ART: the pieces wired from the artpipe (LONGSHADE_BEDAZZLE_SITTING_1 jobs):
  RM_Parasol (item), RM_ParasolWorn_{south,east,north} (worn; Belt is a utility
  layer with no wornGraphicData, so it renders as a pack with no body-type
  suffix; RimSage PawnRenderUtility.RenderAsPack), RM_ShadeTent, and
  RM_SunShield_{south,east,north} (Graphic_Multi; landed 2026-10-03; no def
  uses it since the shield was removed 2026-11-26). No donor art.

  Mod Settings: Creature Behaviors entry 40, one toggle per piece.
-->
<Defs>

  <!-- ============================================================
       RM_Parasol — utility-layer apparel. Shades its wearer, and weakly
       the one cell its shadow falls on.
       ============================================================ -->
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>RM_Parasol</defName>
    <label>parasol</label>
    <description>A broad, shallow canopy of stretched cloth or hide on thin ribs and a long pole, carried open overhead. It is a patch of shade that walks with you, under a high sun or a low one, and a little of it falls on whoever keeps close. It cannot cool hot air: against steam or volcanic heat it does nothing.\n\nIt is only as good as its canopy: mirrak hide casts the deepest shade.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/RM_ShadeGear/RM_Parasol</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <techLevel>Neolithic</techLevel>
    <costStuffCount>20</costStuffCount>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <costList>
      <WoodLog>4</WoodLog>
    </costList>
    <tradeability>Sellable</tradeability>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <WorkToMake>1800</WorkToMake>
      <Mass>1.2</Mass>
      <Flammability>1</Flammability>
      <EquipDelay>1</EquipDelay>
      <StuffEffectMultiplierArmor>0</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
    </statBases>
    <thingCategories>
      <li>ApparelUtility</li>
    </thingCategories>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <bodyPartGroups>
        <li>Waist</li>
      </bodyPartGroups>
      <!-- Utility layer, drawn as a pack (no body-type suffix): the worn set
           is s/e/n at wornGraphicPath_<facing>. -->
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/RM_ParasolWorn/RM_ParasolWorn</wornGraphicPath>
      <layers>
        <li>Belt</li>
      </layers>
      <tags>
        <li>Tribal</li>
      </tags>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
    </apparel>
    <recipeMaker>
      <recipeUsers Inherit="False">
        <li>ElectricTailoringBench</li>
        <li>HandTailoringBench</li>
        <li>CraftingSpot</li>
      </recipeUsers>
      <useIngredientsForColor>true</useIngredientsForColor>
      <researchPrerequisite>RM_Research_Parasol</researchPrerequisite>
    </recipeMaker>
    <comps>
      <li Class="RimMandrake.CreatureBehaviors.RM_CompProperties_ShadeGear">
        <mode>wearer</mode>
        <shadeDepth>0.75</shadeDepth>
        <adjacentFactor>0.4</adjacentFactor>
      </li>
    </comps>
  </ThingDef>

  <!-- ============================================================
       RM_ShadeTent — a cheap, minifiable 3x3 awning. Shades its footprint.
       The tool for the Long Carry.
       ============================================================ -->
  <ThingDef ParentName="BuildingBase">
    <defName>RM_ShadeTent</defName>
    <label>shade tent</label>
    <description>A low, open-sided awning of stretched cloth or hide on four slim poles, pegged down with guy-ropes. It shades the ground under it and nothing else, and it can be packed up and carried out to wherever the work is: the dead lying in the open, the salvage in the sun. It is a quick roof: its shade holds under a high sun or a low one. It cannot cool hot air, so it is no help in steam or volcanic heat.\n\nMirrak hide makes the deepest shade.</description>
    <graphicData>
      <texPath>Things/Building/RM_ShadeGear/RM_ShadeTent</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <size>(3,3)</size>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <fillPercent>0.1</fillPercent>
    <canOverlapZones>true</canOverlapZones>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>600</WorkToBuild>
      <Mass>6</Mass>
      <Flammability>1</Flammability>
      <Beauty>0</Beauty>
    </statBases>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <costStuffCount>35</costStuffCount>
    <costList>
      <WoodLog>15</WoodLog>
    </costList>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsTemperature</li>
    </thingCategories>
    <designationCategory>Temperature</designationCategory>
    <techLevel>Neolithic</techLevel>
    <researchPrerequisites>
      <li>RM_Research_ShadeTent</li>
    </researchPrerequisites>
    <!-- constructEffect NOT declared: madeFromStuff (stuffCategories above)
         already picks its own construct animation per stuff (e.g. Fabric's
         own stuffProps.constructEffect), which always overrides a def-level
         one anyway (ThingDef.ConfigErrors "madeFromStuff but has a defined
         constructEffect"). -->
    <building>
      <destroySound>BuildingDestroyed_Soft_Small</destroySound>
    </building>
    <comps>
      <li Class="RimMandrake.CreatureBehaviors.RM_CompProperties_ShadeGear">
        <mode>footprint</mode>
        <shadeDepth>0.85</shadeDepth>
      </li>
    </comps>
  </ThingDef>

</Defs>
