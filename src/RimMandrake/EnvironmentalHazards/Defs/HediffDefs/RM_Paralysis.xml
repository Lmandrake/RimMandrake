<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
  RM_Paralysis: the paralysing-toxin hediff two mods' bites apply. TheRot's RM_Neurotoxin (RM_TheRot_Fauna_Support.xml)
  and Cauldron's RM_ParalysingBite (RM_BedBug.xml) both name it, and neither mod depends on the other, so it lives here,
  in EnvironmentalHazards, which both list in modDependencies (BEDBUG_FIX_PARALYSIS_HEDIFF_IN_THEROT; moved verbatim from
  TheRot, defName unchanged so saves still resolve it).
  -->
  <HediffDef ParentName="DiseaseBase">
    <defName>RM_Paralysis</defName>
    <label>paralysis</label>
    <description>Paralysis-inducing chemicals in the bloodstream. It rapidly renders creatures immobile.</description>
    <isBad>false</isBad>
    <initialSeverity>0.10</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>15000~50000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.8</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>initial</label>
        <becomeVisible>true</becomeVisible>
      </li>
      <li>
        <label>initial</label>
        <minSeverity>0.10</minSeverity>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.10</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>minor</label>
        <minSeverity>0.25</minSeverity>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.25</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>moderate</label>
        <minSeverity>0.50</minSeverity>
        <vomitMtbDays>5</vomitMtbDays>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.50</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>serious</label>
        <minSeverity>0.75</minSeverity>
        <vomitMtbDays>1</vomitMtbDays>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.75</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>extreme</label>
        <minSeverity>0.80</minSeverity>
        <vomitMtbDays>0.5</vomitMtbDays>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <setMax>0.05</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>
