<?xml version="1.0" encoding="utf-8"?>
<!-- ROT_SPORE_ALLERGY_PORT_1: our own spore allergy pair, replacing the Alpha Biomes pair in the free Rot and Contagion.
     Shape from vanilla Flu/Animal_Flu; text is ours. Lives here (shared) so both biome mods load it. -->
<Defs>
  <HediffDef ParentName="InfectionBase">
    <defName>RM_SporeAllergy</defName>
    <label>spore allergy</label>
    <description>The body's overreaction to the Sheen's spores: wheezing, swelling in the throat, weeping eyes. It passes once the body learns the dust, and rest and care shorten it. Untreated, a bad reaction closes the airway.</description>
    <makesSickThought>true</makesSickThought>
    <lethalSeverity>1</lethalSeverity>
    <tendable>true</tendable>
    <comps>
      <li Class="HediffCompProperties_TendDuration">
        <baseTendDurationHours>24</baseTendDurationHours>
        <severityPerDayTended>-0.1</severityPerDayTended>
      </li>
      <li Class="HediffCompProperties_Immunizable">
        <severityPerDayNotImmune>0.22</severityPerDayNotImmune>
        <immunityPerDaySick>0.25</immunityPerDaySick>
        <severityPerDayImmune>-0.5</severityPerDayImmune>
        <immunityPerDayNotSick>-0.06</immunityPerDayNotSick>
      </li>
    </comps>
    <stages>
      <li>
        <label>minor</label>
        <capMods>
          <li><capacity>Breathing</capacity><offset>-0.1</offset></li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.5</minSeverity>
        <label>major</label>
        <vomitMtbDays>3</vomitMtbDays>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.05</offset></li>
          <li><capacity>Breathing</capacity><offset>-0.15</offset></li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.8</minSeverity>
        <label>extreme</label>
        <lifeThreatening>true</lifeThreatening>
        <painOffset>0.05</painOffset>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.15</offset></li>
          <li><capacity>Breathing</capacity><offset>-0.25</offset></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="InfectionBase">
    <defName>RM_AnimalSporeAllergy</defName>
    <label>spore allergy</label>
    <description>A creature's overreaction to the Sheen's spores: laboured breathing, streaming eyes, a refusal to eat. Most recover with rest; a bad reaction can close the airway.</description>
    <debugLabelExtra>animal</debugLabelExtra>
    <makesSickThought>true</makesSickThought>
    <lethalSeverity>1</lethalSeverity>
    <tendable>true</tendable>
    <comps>
      <li Class="HediffCompProperties_TendDuration">
        <baseTendDurationHours>48</baseTendDurationHours>
        <severityPerDayTended>-0.1</severityPerDayTended>
      </li>
      <li Class="HediffCompProperties_Immunizable">
        <severityPerDayNotImmune>0.22</severityPerDayNotImmune>
        <immunityPerDaySick>0.25</immunityPerDaySick>
        <severityPerDayImmune>-0.5</severityPerDayImmune>
        <immunityPerDayNotSick>-0.06</immunityPerDayNotSick>
      </li>
    </comps>
    <stages>
      <li>
        <label>minor</label>
        <capMods>
          <li><capacity>Breathing</capacity><offset>-0.1</offset></li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.5</minSeverity>
        <label>major</label>
        <vomitMtbDays>3</vomitMtbDays>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.05</offset></li>
          <li><capacity>Breathing</capacity><offset>-0.15</offset></li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.8</minSeverity>
        <label>extreme</label>
        <lifeThreatening>true</lifeThreatening>
        <painOffset>0.05</painOffset>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.15</offset></li>
          <li><capacity>Breathing</capacity><offset>-0.25</offset></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>
