{
  "_about": "Family table for running_now.py. Rules are tried in order against the unit name (from a process's cgroup path, or a systemd unit) and, for processes, then against the command line. First hit wins. A claude, python, node or codex process that no rule and no parent explains is shown under NOT RECOGNISED, never hidden. Add a rule here when a new background thing appears.",
  "order": [
    "seats",
    "dispatcher",
    "relentless",
    "helpers",
    "roles",
    "art",
    "monitors",
    "tests",
    "game",
    "other",
    "upkeep"
  ],
  "families": {
    "seats": {
      "title": "Seats (the AI windows)"
    },
    "dispatcher": {
      "title": "Dispatcher"
    },
    "relentless": {
      "title": "Relentless"
    },
    "helpers": {
      "title": "Conductor helpers"
    },
    "roles": {
      "title": "Role runs"
    },
    "art": {
      "title": "Art"
    },
    "monitors": {
      "title": "Monitors"
    },
    "tests": {
      "title": "Tests and Steve lane"
    },
    "game": {
      "title": "The game"
    },
    "other": {
      "title": "Other projects on this machine"
    },
    "upkeep": {
      "title": "Upkeep"
    }
  },
  "units": [
    [
      "rm-relentless-(?P<kind>[a-z]+)-(?P<id>[0-9a-f]{10}-g\\d+(?:-c\\d+)?)",
      "relentless",
      "worker"
    ],
    [
      "rm-relentless\\.(service|timer)",
      "relentless",
      "tick"
    ],
    [
      "rm-role-(?P<id>[A-Za-z]+-\\d+)",
      "roles",
      "role"
    ],
    [
      "rm-detached-(?P<id>.+-\\d{9,})",
      "helpers",
      "helper"
    ],
    [
      "claude-seat-(?P<who>[A-Za-z]+)-(?P<id>\\d+)\\.scope",
      "seats",
      "window"
    ],
    [
      "rm-dispatcher\\.",
      "dispatcher",
      "tick"
    ],
    [
      "rm-restart-(now|reconcile)",
      "dispatcher",
      "seat restart helper"
    ],
    [
      "rm-harness-",
      "tests",
      "selftest"
    ],
    [
      "^(testq|steve)-",
      "tests",
      "Steve lane"
    ],
    [
      "rm-artpip|rm-arteval",
      "art",
      "art"
    ],
    [
      "rm-(ops-watch|deadman|memwatch|pulse|telemetry|scratch|codebase-health|replay-watch|account-usage|objstore)",
      "monitors",
      "monitor"
    ],
    [
      "^hestia",
      "other",
      "Hestia"
    ],
    [
      "^(claude-account|account-plan|lodestar|rm-)",
      "upkeep",
      "upkeep"
    ]
  ],
  "procs": [
    [
      "networkd-dispatcher|unattended-upgrade",
      "upkeep",
      "operating system"
    ],
    [
      "claude_account_page\\.py|claude-accounts",
      "upkeep",
      "account page"
    ],
    [
      "hestia_service\\.py|/Hestia/|/hestia/",
      "other",
      "Hestia"
    ]
  ]
}
