# The Workshop Pipeline's Waiting, Ready and Work stages (rimflow/list_dispatch.py; item
# RIMMANDRAKE_BUILD_LIST_LANE_ON_RED_DISPATCH_GOALS_FIRST; page design/specs/2026-11-23-list-dispatch/boundary.md): one
# detached helper per open list item whose outcome check fails, at most 2 live, at most 2 Work runs per item, the check
# run again before every attempt. It obeys the pipeline's pause, `./pipe off` (all, family:list_dispatch,
# family:detached, item:<ID>, the item's mod), the owner's mod holds, the account gate and the clone pool's admission.
# No model of its own. Runs from the dispatch clone.
# Reading: D:\ClaudeWork\rimmandrake\dispatcher\list_dispatch\reading.json (WSL /mnt/d/ClaudeWork/rimmandrake/dispatcher/list_dispatch/reading.json)
# Install:  cp src/RimMandrake/Utils/systemd/rm-list-dispatch.{service,timer} ~/.config/systemd/user/
#           systemctl --user daemon-reload && systemctl --user enable --now rm-list-dispatch.timer
# Off:      ./pipe off family:list_dispatch --why "..."   (or "enabled": false in rimflow/list_dispatch.json)
[Unit]
Description=RimMandrake Workshop Pipeline: one helper per list item whose outcome check fails, every 10 min

[Service]
Type=oneshot
WorkingDirectory=/home/mandrake/rm/dispatch
Environment=PATH=/home/mandrake/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=RM_ROLE_UNIT=rm-list-dispatch.service
ExecStart=/usr/bin/python3 /home/mandrake/rm/dispatch/src/RimMandrake/rimflow/list_dispatch.py tick --apply
Nice=10
MemoryMax=2G
# Hang guard: a tick is a ledger replay, each item's check (list_effect.CMD_TIMEOUT_S each), and at most 2 launches
# (LAUNCH_TIMEOUT_S each).
# budget: danger=a hung run stops this timer for good (systemd starts no second run); longest=895.7s (user journal, 14 days to 2026-11-24)
TimeoutStartSec=10800
