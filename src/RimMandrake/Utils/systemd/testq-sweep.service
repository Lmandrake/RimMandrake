[Unit]
Description=testq daily full sweep request (design: at most one --full per mod per day, overnight)

[Service]
Type=oneshot
WorkingDirectory=/home/mandrake/rm/dispatch
Environment=GIT_CONFIG_COUNT=2 GIT_CONFIG_KEY_0=gc.autoDetach GIT_CONFIG_VALUE_0=false GIT_CONFIG_KEY_1=maintenance.autoDetach GIT_CONFIG_VALUE_1=false
ExecStartPre=-/usr/bin/git -C /home/mandrake/rm/dispatch pull -q --ff-only origin main
ExecStart=/bin/bash -c 'for m in ${TESTQ_SWEEP_MODS:-FlowWorks}; do /usr/bin/python3 /home/mandrake/rm/dispatch/src/RimMandrake/Utils/testq/testq.py sweep "$m"; done'
# No start timeout (RIMMANDRAKE_UNCAP_TESTQ_SWEEP_KILLED_AT_FIVE_MINUTES): the old 300 s named no danger, and on 11-21
# it killed the sweep mid-run (gaps.settled alone took 134 s), so nothing was queued. A hung sweep only delays the next
# night: the timer starts no second copy while one runs.
TimeoutStartSec=infinity
