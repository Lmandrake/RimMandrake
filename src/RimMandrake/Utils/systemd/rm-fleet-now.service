# FLEET_NOW.html: the browser-tab form of RELENTLESS_NOW.md (fleet_now.py). Promises: design/specs/2026-11-19-standing-status-tabs/boundary.md
# Install:  cp src/RimMandrake/Utils/systemd/rm-fleet-now.{service,timer} ~/.config/systemd/user/
#           systemctl --user daemon-reload && systemctl --user enable --now rm-fleet-now.timer
# Remove:   systemctl --user disable --now rm-fleet-now.timer; rm ~/.config/systemd/user/rm-fleet-now.{service,timer}; systemctl --user daemon-reload
[Unit]
Description=RimMandrake FLEET_NOW.html (RELENTLESS_NOW.md as a self-reloading page), every minute

[Service]
Type=oneshot
WorkingDirectory=/home/mandrake/rm/dispatch
Environment=PATH=/home/mandrake/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /home/mandrake/rm/dispatch/src/RimMandrake/Utils/fleet_now.py
Environment=RM_DATA_ROOT=/mnt/d/ClaudeWork/rimmandrake
Nice=10
MemoryMax=256M
# budget: danger=a hung run stops this timer for good (systemd starts no second run); longest=3.4s (user journal, 14 days to 2026-11-24)
TimeoutStartSec=60
