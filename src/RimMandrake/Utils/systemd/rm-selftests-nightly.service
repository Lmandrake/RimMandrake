# The nightly sweep checks FINISHED mods only (owner by card 2026-11-15: "Nightly tests should check mods with finished
# versions, not mods in production. Code is too fluid otherwise. Wrong phase."): nightly_scope.py run sweeps the tests of
# mods with a passed Design Version, on a clean clone of origin/main (/home/mandrake/rm/nightly) with ~/.local/bin on
# PATH; none passed -> "nothing finished yet", green. Held (stopped) until the first pass; timers_guard starts it again.
# Summary lands in BENCH's Transient/, where known_reds and nightly_catchup read it.
# The exit line is run_selftests' own code (it used to be tail's, so a RED sweep logged "exit 0"); each sweep is
# reported to RimPulse's job history (pulse.py report selftests:nightly): history, never red - nothing waits on it.
# Install:  cp src/RimMandrake/Utils/systemd/rm-selftests-nightly.{service,timer} ~/.config/systemd/user/
#           systemctl --user daemon-reload && systemctl --user enable --now rm-selftests-nightly.timer
[Unit]
Description=RimMandrake nightly sweep of finished mods (clean clone; logs in BENCH)

[Service]
Type=oneshot
WorkingDirectory=/home/mandrake/rm/bench
Nice=15
ExecStart=/bin/sh -c 'mkdir -p Transient && LOG=Transient/selftests_nightly.log; printf "\n=== %%s nightly\n" "$(date -u +%%Y-%%m-%%dT%%H:%%M:%%SZ)" >>"$LOG"; python3 src/RimMandrake/Utils/nightly_scope.py run >Transient/selftests_nightly.last 2>&1; rc=$?; tail -40 Transient/selftests_nightly.last >>"$LOG"; printf "exit %%s\n" "$rc" >>"$LOG"; st=failed; [ "$rc" = 0 ] && st=ok; python3 src/RimMandrake/Utils/pulse/pulse.py report selftests:nightly "$st" --cause "nightly exit $rc: $(grep -m1 ^RESULT Transient/selftests_nightly.last)" --link "$LOG" || true'
