# Full selftest sweep, once a night (owner by card 2026-10-14: "Targeted per commit, full once nightly").
# Commits run only their own tests (run_selftests.py --only ...); this is the one full sweep.
# Runs on BENCH's working tree as it stands; no git operations. Summary lands in Transient/.
# Install:  cp src/RimMandrake/Utils/systemd/rm-selftests-nightly.{service,timer} ~/.config/systemd/user/
#           systemctl --user daemon-reload && systemctl --user enable --now rm-selftests-nightly.timer
[Unit]
Description=RimMandrake nightly full selftest sweep (BENCH clone)

[Service]
Type=oneshot
WorkingDirectory=/home/mandrake/rm/bench
Nice=15
ExecStart=/bin/sh -c 'mkdir -p Transient && LOG=Transient/selftests_nightly.log; printf "\n=== %%s nightly\n" "$(date -u +%%Y-%%m-%%dT%%H:%%M:%%SZ)" >>"$LOG"; python3 src/RimMandrake/Utils/run_selftests.py 2>&1 | tail -40 >>"$LOG"; printf "exit %%s\n" "$?" >>"$LOG"'
