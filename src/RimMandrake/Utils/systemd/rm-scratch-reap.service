[Unit]
Description=RimMandrake scratch expiry: expire stale clones and session dirs, bundling anything unique first
Documentation=file:///home/mandrake/rm/dispatch/design/RimMandrake/buildup_prevention_design_2026-10-18.md

[Service]
Type=oneshot
# The dispatch clone: it fast-forwards itself, and foundry is the arena's to freeze.
WorkingDirectory=/home/mandrake/rm/dispatch
Nice=19
IOSchedulingClass=idle
CPUSchedulingPolicy=batch
TimeoutStartSec=5400
ExecStart=/usr/bin/python3 src/RimMandrake/Utils/scratch_reap.py --apply --max-seconds 1800
