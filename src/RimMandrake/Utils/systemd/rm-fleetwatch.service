# Fleet Watch board refresh with no Claude window (FLEETWATCH_REFRESH_BUILD_OUTLIVES_ITS_WINDOW).
# fleet_refresh.py builds the rows in Python and hands only the ArtifactData batch write (and a one-line headline)
# to one headless `claude -p --model sonnet`; it skips the model when nothing changed, with a 20-minute heartbeat.
# Reading: <agent storage>/rimmandrake/fleetwatch/last_write.json (D:\ClaudeWork\rimmandrake\fleetwatch); runs.jsonl
# there has tokens and cost per run.
# Install:  cp src/RimMandrake/Utils/systemd/rm-fleetwatch.{service,timer} ~/.config/systemd/user/
#           systemctl --user daemon-reload && systemctl --user enable --now rm-fleetwatch.timer
# Remove:   systemctl --user disable --now rm-fleetwatch.timer
#           rm ~/.config/systemd/user/rm-fleetwatch.{service,timer}; systemctl --user daemon-reload
[Unit]
Description=RimMandrake Fleet Watch board refresh (claude.ai artifact)

[Service]
Type=oneshot
WorkingDirectory=/home/mandrake/rm/bench
Environment=PATH=/home/mandrake/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /home/mandrake/rm/bench/src/RimMandrake/Utils/fleet_refresh.py
Nice=10
MemoryMax=1G
# a version resync plus a retried write is three claude -p calls at <=240 s each
TimeoutStartSec=780
