# The Level 1 stream collector (was rm-pulse-streams; RimPulse is retired, the collector is not): one record of every
# measure appended to D:\ClaudeWork\rimmandrake\streams\series.jsonl, which rm-ops-watch's production domain reads, and the
# testing-rig collector runs first (its history.jsonl feeds ops_watch's testing domain). No LLM.
[Unit]
Description=stream collector (Level 1 series + testing metrics)

[Service]
Type=oneshot
Environment=RM_PULSE_DEPLOY=/home/mandrake/rm/pulse-deploy
ExecStart=-/usr/bin/python3 /home/mandrake/rm/pulse-deploy/src/RimMandrake/Utils/ops_core/testing_metrics.py
ExecStart=/usr/bin/python3 /home/mandrake/rm/pulse-deploy/src/RimMandrake/Utils/ops_core/streams.py collect
# budget: danger=a hung run stops this timer for good (systemd starts no second run); longest=288.6s (user journal, 14 days to 2026-11-24)
TimeoutStartSec=3000
Nice=10
