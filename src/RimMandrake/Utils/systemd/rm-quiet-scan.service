# The standing scan of quiet files (rimflow/quiet_scan.py; item RIMMANDRAKE_BUILD_STANDING_SCAN_OF_QUIET_FILES_ON_SONNET;
# page design/specs/2026-11-24-quiet-scan/boundary.md): while no mod step is live, one Sonnet run reads code files that no
# commit changed for 7 days or more, mod content first. It obeys the pipeline's pause, `./pipe off` (all, family:quiet_scan,
# family:detached), the owner's mod holds, the account gate and the clone pool's admission. Runs from the dispatch clone.
# Reading: D:\ClaudeWork\rimmandrake\dispatcher\quiet_scan\reading.json (WSL /mnt/d/ClaudeWork/rimmandrake/dispatcher/quiet_scan/reading.json)
# Install:  cp src/RimMandrake/Utils/systemd/rm-quiet-scan.{service,timer} ~/.config/systemd/user/
#           systemctl --user daemon-reload && systemctl --user enable --now rm-quiet-scan.timer
# Off:      ./pipe off family:quiet_scan --why "..."   (or "enabled": false in rimflow/quiet_scan.json)
[Unit]
Description=RimMandrake standing scan of quiet files (one Sonnet run while no mod step is live), every 10 min

[Service]
Type=oneshot
WorkingDirectory=/home/mandrake/rm/dispatch
Environment=PATH=/home/mandrake/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=RM_ROLE_UNIT=rm-quiet-scan.service
ExecStart=/usr/bin/python3 /home/mandrake/rm/dispatch/src/RimMandrake/rimflow/quiet_scan.py tick --apply
Nice=10
# Danger: a runaway tick starves the game machine. The same bound as rm-list-dispatch.service.
MemoryMax=2G
# Hang guard: a tick is one git log of a week (GIT_TIMEOUT_S) and at most one launch (LAUNCH_TIMEOUT_S).
TimeoutStartSec=40min
