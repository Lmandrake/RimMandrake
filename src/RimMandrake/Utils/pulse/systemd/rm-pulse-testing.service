# Testing-rig efficiency, per machine per owner-day (TESTING_RIG_MONITOR_EFFICIENCY_IN_PULSE): reads testq records,
# the bridge call log, local modcheck sheets and the ledger; appends changed day records to
# /mnt/d/ClaudeWork/rimmandrake/testing_metrics/history.jsonl. No LLM. RimPulse's Testing panel reads that file.
[Unit]
Description=RimPulse testing-rig metrics collector

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 ${RM_PULSE_DEPLOY}/src/RimMandrake/Utils/pulse/testing_metrics.py
TimeoutStartSec=300s
