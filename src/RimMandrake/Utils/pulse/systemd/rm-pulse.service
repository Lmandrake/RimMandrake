# RimFlow pulse spine — AWAY_DASHBOARD_BUILD_1. Collector loop (5 s) + HTTP/SSE on
# 127.0.0.1:8765 for the floating widget (src/RimMandrake/Utils/pulse/widget/lantern.pyw).
# Runs from the DEDICATED origin/main checkout ${RM_PULSE_DEPLOY} (under the agent storage root), never a
# seat clone: a FOUNDRY fix used to wait on a BENCH pull (RIMPULSE_DEPLOY_FIX_RUNS_THE_BENCH_CLONE).
# rm-pulse-update.timer fast-forwards it and restarts this unit on new code.
# Install / re-install: sh src/RimMandrake/Utils/pulse/systemd/install.sh   (writes the RM_PULSE_DEPLOY drop-in)
[Unit]
Description=RimFlow pulse spine (away dashboard collector + server)
After=default.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 ${RM_PULSE_DEPLOY}/src/RimMandrake/Utils/pulse/pulse.py daemon
Restart=always
RestartSec=5
Nice=10
MemoryMax=768M

[Install]
WantedBy=default.target
