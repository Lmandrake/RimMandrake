<?xml version="1.0" encoding="utf-8"?>
<!-- GREENTIDE_BASE_PORT_BUILD_1: registers the living-bole and root-causeway GenSteps on Base_Player
     (Defs/MapGeneration/RM_Greentide_GenSteps.xml). -->
<Patch>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/MapGeneratorDef[defName="Base_Player"]/genSteps</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/MapGeneratorDef[defName="Base_Player"]/genSteps</xpath>
      <value>
        <li>RM_GenStep_LivingBoles</li>
        <li>RM_GenStep_RootCauseways</li>
      </value>
    </match>
  </Operation>

</Patch>
