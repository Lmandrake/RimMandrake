<?xml version="1.0" encoding="utf-8"?>
<!--
  GRAVSHIP_ACOUSTIC_SCANNER_1: the acoustic-scanner payload for RM_Greentide.
  Owner decision by question card 2026-10-06: the payload goes on EVERY biome of ours.

  Pure XML, FindMod-guarded on "RimMandrake: Acoustic Scanner", so the extension class
  is only named while its assembly is active. Every def is a defName STRING resolved
  at pulse time (GetNamedSilentFail), so a target naming another mod's def just hears
  nothing when that mod is absent. Each target is drawn from this biome's own content;
  the biome's sitting may re-author it. The reading is always banded by the scanner.
-->
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>RimMandrake: Acoustic Scanner</li>
    </mods>
    <match Class="PatchOperationAddModExtension">
      <xpath>/Defs/BiomeDef[defName="RM_Greentide"]</xpath>
      <value>
        <li Class="RimMandrake.AcousticScanner.RM_AcousticPayloadExtension">
          <quietText>Steam, roots and running water. The jungle is loud, and none of it is hiding.</quietText>
          <targets>
            <li>
              <label>greatbole heart</label>
              <reading>A slow wet beat deep inside the wood, much slower than any animal's.</reading>
              <color>(0.5, 1, 0.55)</color>
              <weight>2</weight>
              <thingDefs>
                <li>RM_GreatboleCore</li>
              </thingDefs>
            </li>
            <li>
              <label>hollow trunk</label>
              <reading>A huge hollow note: a fallen or dead trunk, empty inside.</reading>
              <color>(0.85, 0.7, 0.45)</color>
              <thingDefs>
                <li>RM_GreatboleTrunkSegment</li>
                <li>RM_GreatboleDeadHusk</li>
              </thingDefs>
            </li>
            <li>
              <label>skerrel galls</label>
              <reading>Papery rattles where the sap runs thickest. The galls are full.</reading>
              <color>(1, 0.85, 0.35)</color>
              <thingDefs>
                <li>RM_SkerrelGall</li>
              </thingDefs>
            </li>
            <li>
              <label>something lying in wait</label>
              <reading>A long, still body in the undergrowth that does not move when the pulse goes by.</reading>
              <color>(1, 0.4, 0.3)</color>
              <weight>2</weight>
              <pawnRaces>
                <li>RM_Sytheclaw</li>
              </pawnRaces>
            </li>
          </targets>
        </li>
      </value>
    </match>
  </Operation>
</Patch>
