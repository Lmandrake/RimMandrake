<Project Sdk="Microsoft.NET.Sdk">

  <!--
    GREENTIDE_STANDALONE_MOD_1. Same recipe as
    src/RimMandrake/CreatureBehaviors/Source/RM_CreatureBehaviors.csproj —
    copy that header if this one goes stale.

    Build (the dotnet is WINDOWS-NATIVE and cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\Rimworld\src\RimMandrake\Greentide\Source\RM_Greentide.csproj -c Release

    Output lands in ../Assemblies/, which is where RimWorld looks.

    No Harmony: every class here is a plain engine extension point (TerrainDef
    modExtension, MapComponent, JobDriver, WorkGiver, BiomeWorker, DefOf).
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrake.Greentide</AssemblyName>
    <RootNamespace>RimMandrake.Greentide</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="RM_DefOf.cs" />
    <Compile Include="RM_MireExtension.cs" />
    <Compile Include="RM_BuriedCache.cs" />
    <Compile Include="RM_MapComponent_TerrainMire.cs" />
    <Compile Include="RM_MapComponent_MudSwallow.cs" />
    <Compile Include="RM_JobDriver_DigOutBuried.cs" />
    <Compile Include="RM_WorkGiver_DigOutBuried.cs" />
    <Compile Include="RM_JobDriver_FreeMired.cs" />
    <Compile Include="RM_WorkGiver_FreeMired.cs" />
    <Compile Include="RM_BiomeWorker_Greentide.cs" />
    <Compile Include="RM_GreentideMod.cs" />
    <Compile Include="RM_MapComponent_CrossBiomeChurnmud.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
