<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Greentide offline fuzz, Approach B (same shape as Wasteland/FeverWood). Plain net8.0, zero RimWorld/Unity
    references: ../Kernel/*.cs are the PRODUCTION files the mod compiles, pulled in directly. A `using Verse;` landing
    in one of them breaks this build - that is the guard rail working.
    Run (builds on Windows via winbuild staging, then runs the exe):
      python3 src/RimMandrake/Utils/selftest_greentide_fuzz.py [fuzz knobs]
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RimMandrakeGreentide.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.Greentide.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Kernel\RM_SwallowKernel.cs" />
    <Compile Include="..\Kernel\RM_MireKernel.cs" />
    <Compile Include="..\Kernel\RM_LadderKernel.cs" />
    <Compile Include="..\Kernel\RM_VurrakKernel.cs" />
    <Compile Include="..\Kernel\RM_RulesKernel.cs" />
    <Compile Include="GreentideFuzz.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
