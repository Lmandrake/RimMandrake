<?xml version="1.0" encoding="utf-8"?>
<!--
  The Greentide's two conditions (GREENTIDE_BASE_PORT_BUILD_1: moved from the campaign tier, RUT_ -> RM_).
  Classes and extensions are all mandrake.rm.environmentalhazards (a declared dependency).

  RM_RoilLock: permanent biomeMapConditions entry on RM_Greentide forcing RM_RoilWeather. Pure weather
  force, no damage fields (spec M4). Mod Settings "The Roil" removes it from the biome for new maps.

  Wet-bulb heat is vanilla heat (WETBULB_FOLD_INTO_HEAT_1, decision taken by question card 2026-10-08):
  the biome's RM_SunHeatExtension (heat kind ambient) raises felt temperature, and vanilla Heatstroke does
  the rest. There is no wet-bulb condition.

  RM_BreaklightCondition: fired only by RM_Breaklight (RM_Greentide_Spine_Incidents.xml), which owns the
  duration. Forces RM_BreaklightClear, +12 C ramped over 2500 ticks (INVENTED), and
  RM_GlowMultiplierOverrideExtension 1.0 undoes a biome glow multiplier for its duration. Surface only.
-->
<Defs>

  <GameConditionDef>
    <defName>RM_RoilLock</defName>
    <conditionClass>RimMandrake.EnvironmentalHazards.GameCondition_EnvironmentalWeather</conditionClass>
    <label>the Roil</label>
    <description>Waist-deep, hot fog standing permanently over the Greentide's floor — the jungle's own breath, and the reason nothing here is ever seen coming until it's close.</description>
    <canBePermanent>true</canBePermanent>
    <allowUnderground>true</allowUnderground>
    <modExtensions>
      <li Class="RimMandrake.EnvironmentalHazards.EnvironmentalWeatherExtension">
        <forcedWeather>RM_RoilWeather</forcedWeather>
      </li>
    </modExtensions>
  </GameConditionDef>

  <GameConditionDef>
    <defName>RM_BreaklightCondition</defName>
    <conditionClass>RimMandrake.EnvironmentalHazards.GameCondition_EnvironmentalWeather</conditionClass>
    <label>Breaklight</label>
    <description>The Roil has lifted. The Greentide stands under a bare, merciless sun, and every degree of the heat it was hiding is suddenly real.</description>
    <startMessage>The standing fog tears open all at once — Breaklight has come, and the sun over the Greentide is bare and full.</startMessage>
    <endMessage>The Roil closes back over the canopy. Breaklight has passed.</endMessage>
    <letterText>The fog blanket has lifted without warning. For the next several hours the Greentide stands under a cloudless, merciless sun — full accuracy, full heat, and every wild thing in sight running for shade.</letterText>
    <allowUnderground>false</allowUnderground>
    <modExtensions>
      <li Class="RimMandrake.EnvironmentalHazards.EnvironmentalWeatherExtension">
        <forcedWeather>RM_BreaklightClear</forcedWeather>
        <tempOffset>12</tempOffset>
        <temperatureTransitionTicks>2500</temperatureTransitionTicks>
      </li>
      <li Class="RimMandrake.EnvironmentalHazards.RM_GlowMultiplierOverrideExtension">
        <glowMultiplier>1.0</glowMultiplier>
      </li>
    </modExtensions>
  </GameConditionDef>

</Defs>
