<?xml version="1.0" encoding="utf-8"?>
<!--
  GREENTIDE_BASE_PORT_BUILD_1: the Greentide's spine moved from the campaign tier (mandrake.rut.patches,
  RUT_ names) into this free mod under RM_ names, and the RUT_ defs were deleted. A save that holds an
  old name (a placed blower or greatbole, a causeway or sealed-floor cell, a pawn's wet-bulb hediff (now
  vanilla heatstroke), the live weather or a running condition) loads it as the new def through RM_DefAliasDef
  (EnvironmentalHazards, RM_DefAliases.cs, which says why it is a Harmony postfix). The strings name
  campaign defs only as save history; nothing here needs the campaign loaded.
-->
<Defs>
  <RimMandrake.EnvironmentalHazards.RM_DefAliasDef>
    <defName>RM_GreentideTierMoveAliases</defName>
    <aliases>
      <li><from>RUT_RoilWeather</from><to>RM_RoilWeather</to></li>
      <li><from>RUT_BreaklightClear</from><to>RM_BreaklightClear</to></li>
      <li><from>RUT_RoilLock</from><to>RM_RoilLock</to></li>
      <li><from>RUT_BreaklightCondition</from><to>RM_BreaklightCondition</to></li>
      <li><from>RUT_Breaklight</from><to>RM_Breaklight</to></li>
      <li><from>RUT_GreatboleFruitfall</from><to>RM_GreatboleFruitfall</to></li>
      <!-- WETBULB_FOLD_INTO_HEAT_1: a saved wet-bulb hediff loads as vanilla heatstroke. -->
      <li><from>RUT_WetBulbOverwhelm</from><to>Heatstroke</to></li>
      <li><from>RM_WetBulbOverwhelm</from><to>Heatstroke</to></li>
      <li><from>RUT_DryAirAversion</from><to>RM_DryAirAversion</to></li>
      <li><from>RUT_DryAirBlower</from><to>RM_DryAirBlower</to></li>
      <li><from>RUT_RootCauseway</from><to>RM_RootCauseway</to></li>
      <li><from>RUT_ToxinSealant</from><to>RM_ToxinSealedFloor</to></li>
      <li><from>RUT_GreatboleHeartwood</from><to>RM_GreatboleHeartwood</to></li>
      <li><from>RUT_GreatboleCore</from><to>RM_GreatboleCore</to></li>
      <li><from>RUT_GreatboleTrunkSegment</from><to>RM_GreatboleTrunkSegment</to></li>
      <li><from>RUT_GreatboleDeadHusk</from><to>RM_GreatboleDeadHusk</to></li>
    </aliases>
  </RimMandrake.EnvironmentalHazards.RM_DefAliasDef>

  <!-- GREENTIDE_ANTS_MIGRATE_NO_ANT_LEFT_BEHIND (Biome card 8, 2026-10-22): the giant ants moved here from
       mandrake.rut.greentideraidant. MEASURED in the four ASHKARR_DEV_*_2026-10-20 saves: the faction's
       <def>RUT_GreentideAntFaction</def> and a faction-list <li>, <animal>RUT_GreentideAntRace</animal>,
       Corpse_RUT_GreentideAntRace in thing filters, and (PARITY_QUIET_R3) a hat with <stuff>RUT_GreentideAntCarapace</stuff>.
       All are Scribe def lookups, so each loads as the new def here; without these a load says "Could not load
       reference to ... named RUT_..." and the ant faction comes back with no def. Typed, so no terrain hash is claimed.
       Kept until the world remake writes saves that hold the RM_ names. -->
  <RimMandrake.EnvironmentalHazards.RM_DefAliasDef>
    <defName>RM_GreentideAntTierMoveAliases</defName>
    <aliases>
      <li><from>RUT_GreentideAntFaction</from><to>RM_GreentideAntFaction</to><defType>FactionDef</defType></li>
      <li><from>RUT_GreentideAnt</from><to>RM_GreentideAnt</to><defType>PawnKindDef</defType></li>
      <li><from>RUT_GreentideAntSoldier</from><to>RM_GreentideAntSoldier</to><defType>PawnKindDef</defType></li>
      <li><from>RUT_GreentideAntRace</from><to>RM_GreentideAntRace</to><defType>ThingDef</defType></li>
      <li><from>Corpse_RUT_GreentideAntRace</from><to>Corpse_RM_GreentideAntRace</to><defType>ThingDef</defType></li>
      <li><from>RUT_GreentideAntCarapace</from><to>RM_GreentideAntCarapace</to><defType>ThingDef</defType></li>
      <li><from>RUT_GreentideAntCarapaceWall</from><to>RM_GreentideAntCarapaceWall</to><defType>ThingDef</defType></li>
      <li><from>Blueprint_RUT_GreentideAntCarapaceWall</from><to>Blueprint_RM_GreentideAntCarapaceWall</to><defType>ThingDef</defType></li>
      <li><from>Frame_RUT_GreentideAntCarapaceWall</from><to>Frame_RM_GreentideAntCarapaceWall</to><defType>ThingDef</defType></li>
    </aliases>
  </RimMandrake.EnvironmentalHazards.RM_DefAliasDef>
</Defs>
