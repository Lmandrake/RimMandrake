<?xml version="1.0" encoding="utf-8"?>
<!-- RM_Gristle: the gristle, the Greentide's burrowing floor-predator. Ported to the RimMandrake tier from
     RSW_Diggerpede (owner, by question card 2026-10-07 22:20 PDT, after his Greentide sheet rename
     "Rename the Gristle, make it realistic"). Numbers, tools and race fields are the port's verbatim; the
     Star Wars-tier dependencies are swapped for vanilla: lifestages AnimalBaby/Juvenile/Adult (were the
     RSW_Digger* stages, near-identical factors), Megascarab voice (was the RSW truffle-mole set), no leather
     (was RSW_MediumChitin; insect flesh). Comfy temperatures are the values AnimalTolerances_Ashkarr.xml
     pinned on RSW_Diggerpede (-25/75.8). Art is a byte copy of the in-game diggerpede art until the
     realistic regen (regen_gt_gristle_v2) is reviewed. RSW_Diggerpede stays only for the frozen
     RUT_Greentide twin. -->
<Defs>
  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Gristle</defName>
    <label>gristle</label>
    <description>A long, flat-plated burrower the length of a man, every segment carrying a pair of short digging legs and the head armoured in a heavy, shovel-edged shield. A gristle travels under the soil faster than most things can run above it, and hunts by feel: it rises under whatever it hears walking, seizes it in hooked mandibles and drags it down. Its body is mostly tough, rubbery muscle over a chitin frame, which is how it got its name. Unlike most many-legged things it bears its young alive.</description>
    <statBases>
      <MoveSpeed>5.2</MoveSpeed>
      <MarketValue>350</MarketValue>
      <ComfyTemperatureMin>-25</ComfyTemperatureMin>
      <ComfyTemperatureMax>75.8</ComfyTemperatureMax>
      <ArmorRating_Blunt>0.25</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.35</ArmorRating_Sharp>
      <Wildness>0.20</Wildness>
    </statBases>
    <tools>
