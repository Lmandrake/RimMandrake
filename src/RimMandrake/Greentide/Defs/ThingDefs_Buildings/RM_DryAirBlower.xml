<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_DryAirBlower (spec M2; sheet §4b, the owner's machine). GREENTIDE_BASE_PORT_BUILD_1: moved from the
  campaign tier, RUT_ -> RM_. Texture moved with it.

  A special room cooler (BLOWER_ROOM_COOLER_1, decision taken by question card 2026-10-08): it cools the
  enclosed room BEHIND it toward its target temperature and never heats any room (no hot exhaust side,
  unlike a vanilla cooler). Its front faces out across the doorway, where CompProperties_DryFieldEmitter
  holds back plant growth and repels wild animals with RM_DryAirAversion. Vanilla power/flick/refuel/
  breakdown comps, vanilla CompProperties_TempControl for the target-temperature gizmo, and
  RimMandrake.EnvironmentalHazards CompProperties_BlowerRoomCooler. Cooling strength and power draw are
  Environmental Hazards Kit Mod Settings (PROVISIONAL 14 heat/s, 250 W; basePowerConsumption below is
  only the draw before the first rare tick). Chemfuel, drained continuously while on and powered ("when
  it runs out of fuel, the green notices within hours"). No research gate.
-->
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>RM_DryAirBlower</defName>
    <label>dry-air blower</label>
    <description>A fueled doorway machine that wrings the wet out of the air. It cools the room behind it like a cooler, but it never dumps its heat into any room; the waste goes up its flue. Out front it blasts a curtain of bone-dry air across its threshold that holds back the creeping green and sends anything wild-skinned looking for another way round. Dryness is the one alien thing the green has no answer for. Starve it of fuel and the doorway notices within hours.</description>
    <graphicData>
      <texPath>Things/Building/Production/RM_DryAirBlower</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <tickerType>Normal</tickerType>
    <disableImpassableShotOverConfigError>true</disableImpassableShotOverConfigError>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>0.4</fillPercent>
    <pathCost>50</pathCost>
    <rotatable>true</rotatable>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>2200</WorkToBuild>
      <Mass>18</Mass>
      <Flammability>0.5</Flammability>
      <Beauty>-2</Beauty>
    </statBases>
    <costList>
      <Steel>60</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <building>
      <isPlayerEjectable>false</isPlayerEjectable>
      <destroySound>BuildingDestroyed_Metal_Small</destroySound>
      <buildingSizeCategory>Small</buildingSizeCategory>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>250</basePowerConsumption>
        <idlePowerDraw>10</idlePowerDraw>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>3.5</fuelConsumptionRate>
        <fuelCapacity>50</fuelCapacity>
        <initialFuelPercent>0</initialFuelPercent>
        <consumeFuelOnlyWhenUsed>false</consumeFuelOnlyWhenUsed>
        <showFuelGizmo>true</showFuelGizmo>
        <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
        <initialConfigurableTargetFuelLevel>50</initialConfigurableTargetFuelLevel>
        <autoRefuelPercent>0.4</autoRefuelPercent>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <drawOutOfFuelOverlay>true</drawOutOfFuelOverlay>
        <fuelLabel>Chemfuel</fuelLabel>
        <fuelGizmoLabel>Chemfuel</fuelGizmoLabel>
        <outOfFuelMessage>Dry-air blower out of chemfuel</outOfFuelMessage>
        <fuelFilter>
          <thingDefs>
            <li>Chemfuel</li>
          </thingDefs>
        </fuelFilter>
      </li>
      <li Class="CompProperties_TempControl">
        <lowPowerConsumptionFactor>0.3</lowPowerConsumptionFactor>
      </li>
      <li Class="RimMandrake.EnvironmentalHazards.CompProperties_BlowerRoomCooler" />
      <li Class="RimMandrake.EnvironmentalHazards.CompProperties_DryFieldEmitter">
        <suppressHoldTicks>15000</suppressHoldTicks>
        <animalRepelRadius>3</animalRepelRadius>
        <animalRepelArcDegrees>90</animalRepelArcDegrees>
        <aversionHediff>RM_DryAirAversion</aversionHediff>
      </li>
    </comps>
    <designationCategory>Production</designationCategory>
    <designationHotKey>Misc6</designationHotKey>
    <techLevel>Industrial</techLevel>
    <uiIconScale>0.9</uiIconScale>
  </ThingDef>

</Defs>
