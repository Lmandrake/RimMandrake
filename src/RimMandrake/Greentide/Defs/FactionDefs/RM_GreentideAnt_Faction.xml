<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- GREENTIDE_ANTS_MOVE_TO_FREE_TIER: the giant ants' hidden, raid-only faction (was RUT_GreentideAntFaction in
       mandrake.rut.greentideraidant; a save naming the old def loads it as this one, Defs/Misc/RM_GreentideTierMove_Aliases.xml).
       Raid switch and strength: RM_GreentideAntRaidApplier (Mod Settings, "Giant ant raids").

       World creation (MEASURED 2026-10-20, the remake found the faction ABSENT after worldgen): in 1.6 a world made
       through Page_CreateWorldParams passes the page's faction list to FactionGenerator.InitializeFactions, which
       creates ONLY that list; requiredCountAtGameStart is read solely on the no-page path. The page list is
       ConfigurableFactions (maxConfigurableAtWorldCreation > 0, default -1) x startingCountAtWorldCreation. So it is
       shaped like Core's hidden Insect/Ancients: configurable 1, start 1, not shown in the selection list. -->
  <FactionDef>
    <defName>RM_GreentideAntFaction</defName>
    <label>giant ant colony</label>
    <pawnSingular>ant</pawnSingular>
    <pawnsPlural>ants</pawnsPlural>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
    <startingCountAtWorldCreation>1</startingCountAtWorldCreation>
    <displayInFactionSelection>false</displayInFactionSelection>
    <configurationListOrderPriority>1100</configurationListOrderPriority>
    <fixedName>They!</fixedName>

    <humanlikeFaction>false</humanlikeFaction>
    <hidden>true</hidden>
    <autoFlee>false</autoFlee>
    <canUseAvoidGrid>false</canUseAvoidGrid>
    <techLevel>Animal</techLevel>
    <permanentEnemy>true</permanentEnemy>

    <factionIconPath>World/WorldObjects/TribalSettlement</factionIconPath>
    <settlementTexturePath>World/WorldObjects/TribalSettlement</settlementTexturePath>

    <allowedArrivalTemperatureRange>-40~60</allowedArrivalTemperatureRange>

    <raidLootValueFromPointsCurve>
      <points>
        <li>(35, 8)</li>
        <li>(100, 60)</li>
        <li>(1000, 250)</li>
        <li>(2000, 400)</li>
        <li>(4000, 500)</li>
      </points>
    </raidLootValueFromPointsCurve>

    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(0,35)</li>
        <li>(70, 50)</li>
        <li>(700, 100)</li>
        <li>(1300, 150)</li>
        <li>(100000, 10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>

    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>100</commonality>
        <options>
          <RM_GreentideAnt>100</RM_GreentideAnt>
        </options>
      </li>
    </pawnGroupMakers>
  </FactionDef>
</Defs>
