<?xml version="1.0" encoding="utf-8" ?>
<!-- GREENTIDE_STANDALONE_MOD_1. Generic sibling of a frozen campaign world's
     own biome instance elsewhere in this repo — same fictional idea (a
     furiously humid, ground-hugging river jungle), rebuilt with zero
     campaign-specific content so it can generate on any player's own world.
     mudTerrain points at RM_GreentideChurnmud (renamed from RM_Churnmud,
     code review 2026-09-17 — that name collided with mandrake.rm.flowworks's
     own unrelated TerrainDef of the same name, see RM_Churnmud_Terrains.xml)
     itself, so ordinary mapgen already lays the hazard wherever vanilla would
     have laid plain Mud — the churnmud kit needs no separate map-gen step. -->
<Defs>

  <BiomeDef>
    <defName>RM_Greentide</defName>
    <label>the Greentide</label>
    <description>A gallery jungle standing in permanent, ground-hugging steam. The rivers here run warmer than the air can comfortably hold, so a low fog never quite lifts, everything grows fast enough to watch, and the mud between the roots is deep enough to swallow a boot, a crate, or a careless step. There is no dry season and no truce — only the green, and what is patient enough to wait in the mud for you.</description>
    <workerClass>RimMandrake.Greentide.RM_BiomeWorker_Greentide</workerClass>
    <texture>World/Biomes/TropicalRainforest</texture>

    <modExtensions>
      <li Class="RimMandrake.Greentide.RM_GreentideBiomeRanges">
        <temperature>28~60</temperature>
        <rainfall>2200~6000</rainfall>
        <elevation>0~1200</elevation>
        <baseScore>30</baseScore>
        <degreeWeight>1.4</degreeWeight>
        <rainfallDivisor>220</rainfallDivisor>
      </li>
      <!-- SOLAR_HEAT_EXPOSURE_1: sun heat kind "ambient" - the Greentide: the_greentide.md "roiling, ground-hugging, HOT fog".
           Ambient: shade and roofs do nothing outdoors; heat insulation or an enclosed room answers it.
           WETBULB_FOLD_INTO_HEAT_1: the saturated air's wet-bulb load is part of this felt offset (was 8, the
           wet-bulb share raised it to 12). PROVISIONAL; the owner-watched sitting tunes it. -->
      <li Class="RimMandrake.CreatureBehaviors.RM_SunHeatExtension" MayRequire="mandrake.rm.biomes">
        <heatKind>ambient</heatKind>
        <heatOffsetC>12</heatOffsetC>
      </li>
      <!-- GREENTIDE_BASE_PORT_BUILD_1: the living greatbole (spec M12) and the root causeways (M9), values
           copied from the campaign twin. Bole counts/radius/spacing and the causeway ranges are kit-spec
           INVENTED numbers; roofDef unset, so the GenStep's default RoofRockThick applies. Toggles: the
           Environmental Hazards Kit's living-bole and causeway switches (worldgen-affecting). -->
      <li Class="RimMandrake.EnvironmentalHazards.RM_LivingBoleBiomeExtension">
        <heartwoodThing>RM_GreatboleHeartwood</heartwoodThing>
        <coreMarkerThing>RM_GreatboleCore</coreMarkerThing>
        <boleCountRange>1~2</boleCountRange>
        <boleRadius>4~6</boleRadius>
        <minSpacing>30</minSpacing>
        <edgeMargin>12</edgeMargin>
      </li>
      <li Class="RimMandrake.EnvironmentalHazards.RM_RootCausewayBiomeExtension">
        <causewayTerrain>RM_RootCauseway</causewayTerrain>
        <basinTerrains>
          <li>RM_GreentideChurnmud</li>
        </basinTerrains>
        <pathsPerAnchorRange>3~6</pathsPerAnchorRange>
        <laneWidthRange>1~2</laneWidthRange>
        <pathLengthRange>20~40</pathLengthRange>
        <fallbackAnchorCountRange>1~3</fallbackAnchorCountRange>
        <fallbackMinAnchorSpacing>25</fallbackMinAnchorSpacing>
        <fallbackEdgeMargin>10</fallbackEdgeMargin>
      </li>
      <!-- BIOME_ARRIVAL_LETTERS_ALL_1 (DESIGN_PASS X-6/FV-5): PLACEHOLDER text drafted by an agent from this biome's
           own description, always-true list and shipped mechanics, flagged for the owner's review
           (Transient/arrival_letters_draft_20261008.md). RM tier: plain reads, no narrator. Heat line follows heatKind. -->
      <li Class="RimMandrake.EnvironmentalHazards.RM_BiomeArrivalLetterExtension" MayRequire="mandrake.rm.biomes">
        <letterLabel>The Greentide</letterLabel>
        <letterText>The steam never lifts and everything grows fast enough to watch: the green will grow into your doors, and the mud is deep enough to swallow a boot, a crate or a careless step. Dark brings roots, light brings leaves, and only dry heat pushes them back. Something patient waits in the mud. The heat is in the wet air itself: shade does nothing, so dress against it, run a dry-air blower, or stay in a closed room.</letterText>
      </li>
    </modExtensions>
    <!-- GREENTIDE_BASE_PORT_BUILD_1: the permanent lock, applied to every newly generated map.
         RM_RoilLock forces RM_RoilWeather (so the table below is inert while it holds); Mod Settings
         "The Roil" takes both the lock and the table row off for new maps. -->
    <biomeMapConditions>
      <li>RM_RoilLock</li>
    </biomeMapConditions>

    <animalDensity>3.2</animalDensity>
    <!-- GREENTIDE_BIOME_DENSITY_1: plantDensity and movementDifficulty tuned
         against vanilla's own closest thematic analog, TropicalSwamp
         ("plant-choked... difficult movement... a nightmare",
         Defs/Core/BiomeDefs/Biomes_Warm.xml) — plantDensity 0.99,
         movementDifficulty 4, MEASURED via RimSage this pass. This is the
         ceiling among all vanilla BiomeDefs found (next highest plantDensity
         0.90 on TropicalRainforest). movementDifficulty is a WORLD-TILE stat
         only (Source/RimWorld/Planet/WorldPathGrid.cs — caravan travel speed
         between planet tiles; consumed nowhere in Verse/AI/PathGrid.cs, the
         in-map pathfinder), so this delivers the item's own acceptance bar
         ("you look at the map when you land and decide to go around")
         directly, and does NOT stack with or duplicate churnmud's in-map
         pathCost — see the item file for the full mechanism writeup. -->
    <plantDensity>0.99</plantDensity>
    <wildPlantRegrowDays>16</wildPlantRegrowDays>
    <movementDifficulty>4</movementDifficulty>
    <forageability>0.8</forageability>
    <!-- GREENTIDE_UNDERSTORY_PLANT_ROSTER_1 (2026-09-26): moved off the
         vanilla RawBerries per the owner's 2026-09-22 ruling — brakkel is
         the biome's own invented forageable staple, and its own
         RM_BrakkelFruit resource is priced/nourished deliberately rather
         than inheriting the stock berry's figures (RM_Greentide_
         UnderstoryRoster_Items.xml). -->
    <foragedFood>RM_BrakkelFruit</foragedFood>
    <diseaseMtbDays>45</diseaseMtbDays>
    <allowRoads>true</allowRoads>
    <allowRivers>true</allowRivers>

    <lakeBeachTerrain>Riverbank</lakeBeachTerrain>
    <riverbankTerrain>Riverbank</riverbankTerrain>
    <mudTerrain>RM_GreentideChurnmud</mudTerrain>

    <!-- GREENTIDE_FRENZY_DISEASE_1 (2026-09-26): Disease_Flu and Disease_Malaria
         removed per the owner's own 2026-09-22 ruling — the two routine,
         easily-tendable illnesses, over the animal-disease pair or the
         wet-tropical pair — and replaced one-for-one by RM_Greentide_FrenzyDisease.
         Everything left is severe: plague, gut worms, the two animal
         diseases, and now the Frenzy. Not stacked on top of seven; still six. -->
    <diseases>
      <li>
        <diseaseInc>Disease_Plague</diseaseInc>
        <commonality>75</commonality>
      </li>
      <li>
        <diseaseInc>Disease_GutWorms</diseaseInc>
        <commonality>50</commonality>
      </li>
      <li>
        <diseaseInc>Disease_AnimalFlu</diseaseInc>
        <commonality>75</commonality>
      </li>
      <li>
        <diseaseInc>Disease_AnimalPlague</diseaseInc>
        <commonality>75</commonality>
      </li>
      <li>
        <diseaseInc>RM_Greentide_FrenzyDisease</diseaseInc>
        <commonality>50</commonality>
      </li>
    </diseases>

    <terrainsByFertility>
      <li>
        <terrain>Soil</terrain>
        <min>-999</min>
        <max>0.5</max>
      </li>
      <li>
        <terrain>SoilRich</terrain>
        <min>0.5</min>
        <max>999</max>
      </li>
    </terrainsByFertility>

    <baseWeatherCommonalities>
      <Clear>6</Clear>
      <Fog>5</Fog>
      <Rain>2</Rain>
      <DryThunderstorm>0.3</DryThunderstorm>
      <RainyThunderstorm>1.7</RainyThunderstorm>
      <FoggyRain>1</FoggyRain>
      <SnowGentle>0</SnowGentle>
      <SnowHard>0</SnowHard>
      <RM_RoilWeather>10</RM_RoilWeather> <!-- INVENTED weight. Inert while RM_RoilLock holds; the Roil toggle removes it with the lock -->
    </baseWeatherCommonalities>

    <soundsAmbient>
      <li>Ambient_NightInsects_Standard</li>
    </soundsAmbient>

    <!-- GREENTIDE_FREE_ROSTER_OWNED_1: the free tier owns its animal list, nothing vanilla-borrowed. Values are
         invented first values from the bedazzle review's bands. The sytheclaw is cut from the Greentide (owner,
         Greentide sheet 2026-10-08: "This should not be in this biome"); it stays in the Pyrelands. RM_Thurrock is 0.08 (GREENTIDE_THURROCK_HERD_BUILD_1, first value: one
         herd on many maps, none on some). The Illisk when GREENTIDE_ILLISK_BUILD_1 builds it. The Vurrak (the false bank) is 0.15 by owner card
         2026-10-03 (GREENTIDE_VURRAK_BUILD_1). The skerrel stays plant-spawned. -->
    <wildAnimals>
      <RM_Krannock>0.3</RM_Krannock>
      <RM_Sulleth>0.8</RM_Sulleth>
      <RM_Dhollock>0.15</RM_Dhollock>
      <RM_Vurrak>0.15</RM_Vurrak>
      <RM_Yammeth>1.0</RM_Yammeth>
      <RM_CanopySwinger>0.3</RM_CanopySwinger>
      <RM_Thurrock>0.08</RM_Thurrock>
      <RM_Gristle>0.4</RM_Gristle>  <!-- ported from RSW_Diggerpede (owner card 2026-10-07); same 0.4 the patch layer gave it -->
    </wildAnimals>
    <!-- GREENTIDE_JUNGLE_TREE_ROSTER_1 (2026-09-26): replaces the two
         rejected temperate-forest trees and the generic bush with the
         biome's own 14 invented jungle trees plus its signature giant —
         design/Jawa/worldbuilding/biomes/greentide_tree_roster_2026-09-22.md
         §3a/3b/3c, §3a0 and §6b. Commonalities are the design doc's own
         proposed relative weights (§6b), flavour rather than a tuned
         balance pass per that section's own framing. The three ground-cover
         rows (Plant_Grass/Plant_TallGrass/Plant_Berry) are kept as generic
         floor filler — the design doc leaves this a build-seat call, not a
         card. RM_Greatbole is deliberately rare and solitary (see its own
         def) rather than a normal canopy weight. -->
    <wildPlants>
      <RM_Veluthar>1.60</RM_Veluthar>
      <RM_Kaddrath>1.00</RM_Kaddrath>
      <RM_Mourvel>0.80</RM_Mourvel>
      <RM_Sarnstilt>0.70</RM_Sarnstilt>
      <RM_Ghemmel>1.50</RM_Ghemmel>
      <RM_Nemmer>1.20</RM_Nemmer>
      <RM_Mirrelbole>0.90</RM_Mirrelbole>
      <RM_Zhorrel>0.50</RM_Zhorrel>
      <RM_Brunnock>0.20</RM_Brunnock>
      <RM_Vurmeloth>0.12</RM_Vurmeloth>
      <RM_Quathis>1.30</RM_Quathis>
      <RM_Cundral>0.50</RM_Cundral>
      <RM_Thalquith>0.45</RM_Thalquith>
      <RM_Gorbeleth>0.30</RM_Gorbeleth>
      <RM_Greatbole>0.03</RM_Greatbole>
      <!-- GREENTIDE_UNDERSTORY_PLANT_ROSTER_1 (2026-09-26): the seven
           invented non-tree understory rows (design doc §3d, rows 15-21).
           Plant_Berry (vanilla) is dropped outright now that brakkel is a
           real invented forageable staple occupying the same niche —
           keeping both was redundant and Plant_Berry is exactly the kind
           of vanilla-Earth-named row the roster's own ban exists to
           replace. Plant_Grass/Plant_TallGrass stay as generic floor
           filler per the tree roster's own build-seat call. -->
      <RM_Brakkel>1.20</RM_Brakkel>
      <RM_Tumbel>0.60</RM_Tumbel>
      <RM_Sarquin>0.70</RM_Sarquin>
      <RM_Phorrik>0.90</RM_Phorrik>
      <RM_Wollick>1.60</RM_Wollick>
      <RM_Maddrick>0.40</RM_Maddrick>
      <RM_Illurin>0.90</RM_Illurin>
      <Plant_Grass>2.0</Plant_Grass>
      <Plant_TallGrass>1.0</Plant_TallGrass>
      <!-- GREENTIDE_FREE_ROSTER_OWNED_1: moved off the campaign patch. -->
      <RM_YearningFruit>1.2</RM_YearningFruit>
    </wildPlants>

    <!-- GREENTIDE_EXOTIC_JUNGLE_FISH_1 — owner, 2026-09-22: "Create exotic new
         jungle fish to catch, not base game fish." Weights/species copied
         verbatim from the campaign's ratified table
         (fish_bestiary_commission_2026-09-10.md §2C,
         src/RimUtinni/UtinniPatches/Defs/BiomeDefs/RUT_Greentide.xml, frozen)
         with the two Star Wars-canon scalefish entries (Faa/Laa) left out —
         they are added by UtinniPatches/Patches/WildAnimals_Greentide.xml
         under MayRequire="mandrake.rsw.swbestiary" so this base file, and
         this mod alone, never names an RSW_ def. All 8 species here are new
         RM_-tier defs (RM_GreentideFish_Items.xml / RM_RareGreentideCatches.xml),
         not references into RimUtinni — this mod carries no dependency on the
         campaign or on RimStarWars. -->
    <maxFishPopulation>720</maxFishPopulation>
    <fishTypes MayRequire="Ludeon.RimWorld.Odyssey">
      <freshwater_Common>
        <RM_Zeev>0.4</RM_Zeev>
        <RM_Uvva>0.3</RM_Uvva>
        <RM_Karrun>0.3</RM_Karrun>
        <RM_Dubbol>0.2</RM_Dubbol>
        <RM_Vashuu>0.3</RM_Vashuu>
      </freshwater_Common>
      <freshwater_Uncommon>
        <RM_Lozh>0.3</RM_Lozh>
        <RM_Saava>0.25</RM_Saava>
        <RM_Tuun>0.15</RM_Tuun>
        <RM_ScaaLumsigh>0.2</RM_ScaaLumsigh>
      </freshwater_Uncommon>
      <rareCatchesSetMaker>RM_RareGreentideCatches</rareCatchesSetMaker>
    </fishTypes>
  </BiomeDef>

</Defs>
