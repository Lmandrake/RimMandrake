<?xml version="1.0" encoding="utf-8"?>
<!-- GREENTIDE_STANDALONE_MOD_1 (M8, mire half). Severity is driven entirely
     by RM_MapComponent_TerrainMire (C#); stages are read-only presentation +
     capMods, same shape as RM_PinnedInPit in src/RimMandrake/FlowWorks. stuckThreshold
     on RM_MireExtension (default 0.85) matches this hediff's own "mired" stage
     floor — keep both in sync if either is retuned. -->
<Defs>

  <HediffDef>
    <defName>RM_Mired</defName>
    <label>mired</label>
    <description>Caught in churnmud, sinking a little more with every failed step. Below the "mired" stage a pawn can still struggle free alone; at or above it, someone else has to pull them out (RM_FreeMired).</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.55, 0.45, 0.2)</defaultLabelColor>
    <maxSeverity>1.0</maxSeverity>
    <isBad>true</isBad>
    <stages>
      <li>
        <label>sinking</label>
        <painOffset>0.02</painOffset>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.25</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.5</minSeverity>
        <label>bogged down</label>
        <painOffset>0.08</painOffset>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.55</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.85</minSeverity>
        <label>mired</label>
        <painOffset>0.15</painOffset>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.97</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <!-- GREENTIDE_WASP_SWARM_1 / REACTION_MECHANISM_GENERALISE_1 step 1. The
       skerrel sting curve: "negligible once, frightening twenty times" is the
       owner's own wording, and the stage floors below are set from it
       directly — a single sting (severityGain 0.05 on RM_SkerrelSting, the
       DamageDef in Defs/DamageDefs/RM_Skerrel_Combat.xml) barely enters the
       first stage, twenty lands the pawn at maxSeverity.

       Accumulates on ONE instance via RM_DamageWorker_StingAccumulate (never
       stacks separate instances — see that class's own header for the
       measured engine reason), and decays via HediffCompProperties_SeverityPerDay
       so a pawn who withdraws recovers instead of carrying the swarm's damage
       forever — GREENTIDE_WASP_SWARM_1's own "survivable by withdrawing"
       requirement, on top of (not instead of) RM_MentalState_ScopedAggression
       giving up the chase. -14/day clears a maxed-out sting load in under two
       in-game hours once nothing is adding to it.

       lethalSeverity at the max stage is deliberate: "multiple stings add up
       quickly and overwhelm" is the owner's own word, and overwhelm reads as
       genuinely lethal if a swarm is never disengaged from at all — the
       decay and the disengage-on-distance mechanism are what make that an
       avoidable failure state rather than an inevitable one. -->
  <HediffDef>
    <defName>RM_SkerrelSting</defName>
    <label>skerrel stings</label>
    <description>The itching, mounting sting-load of a jungle wasp swarm. Any one sting is nothing at all; the count is what matters, and it only goes down once nothing new is landing.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.85, 0.7, 0.15)</defaultLabelColor>
    <maxSeverity>1.0</maxSeverity>
    <lethalSeverity>1.0</lethalSeverity>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-14</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>faint stinging</label>
        <painOffset>0.01</painOffset>
      </li>
      <li>
        <minSeverity>0.2</minSeverity>
        <label>itching</label>
        <painOffset>0.03</painOffset>
        <capMods>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.5</minSeverity>
        <label>swelling</label>
        <painOffset>0.08</painOffset>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.15</offset>
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.8</minSeverity>
        <label>overwhelmed by stings</label>
        <painOffset>0.18</painOffset>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.35</offset>
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.25</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <!-- GREENTIDE_FRENZY_DISEASE_1 — "The Frenzy", owner ruling 2026-09-22 verbatim:
       "'The Frenzy' causes colonist to work feverishly and faster until they
       totally collapse from exhaustion in a multi-day coma. Can purposely
       infect someone with this disease. It will kill you if not treated, but
       you can treat it in the coma stage after benefiting from the rapid
       work." This project's first authored disease.

       Every mechanism below is MEASURED via RimSage against the installed
       1.6 decompile, not guessed, closing the item's six UNMEASURED
       questions:

       1) Staged severity curve — Verse/HediffStage.cs carries a real
          `severityGainFactor` per stage (consumed by
          HediffComp_SeverityPerDay.SeverityChangePerDay, which multiplies its
          base rate by `parent.CurStage.severityGainFactor`). Onset/escalation
          run at the base rate (2.4 severity/day); the collapse stage sets
          severityGainFactor 0.07, stretching the remaining climb to lethal
          across ~2 in-game days — the "multi-day coma" is this slowdown, not
          a separate timer.
       2) Work speed — `WorkSpeedGlobal` StatDef exists (label "global work
          speed") and stages apply it via ordinary `statOffsets`.
       3) The coma — `Verse/Hediff.cs` derives Downed/unconscious behavior
          from the Consciousness capacity; vanilla's own PsychicComa
          ("a form of benign coma") and Anesthetic's "sedated" stage both
          reach it the same way, `<capacity>Consciousness</capacity>
          <setMax>` to a near-zero value. Reused verbatim here, plus a
          matching Moving setMax so the pawn is actually immobile, not just
          unconscious while still able to shuffle.
       4) Tend gating — `HediffDef.tendable` is a single top-level bool
          (Verse/Hediff.cs TendableNow); the engine has NO per-stage tendable
          flag (HediffStage carries no such field). So nothing stops a doctor
          tending during onset/escalation — it just does not matter yet,
          because the disease is not lethal until the collapse stage and
          tending early only cuts the buff short for no benefit. "You can
          treat it in the coma stage" is therefore the natural, not an
          engine-enforced, window: the vanilla Malaria/SleepingSickness
          pattern (HediffCompProperties_TendDuration racing a rising
          untended severity toward lethalSeverity) is reused directly, tuned
          so only sustained tending during collapse pulls it back from 1.0.
       5) The dose — `IngestionOutcomeDoer_GiveHediff` (RimWorld/
          IngestionOutcomeDoer_GiveHediff.cs) is the exact vanilla mechanism
          Luciferium/GoJuice/Yayo use to hand a hediff to whichever pawn eats
          the item; ordering any pawn to ingest a drug (including a chosen
          colonist, not just the actor) is already player-facing vanilla UX,
          so "purposely infect someone" needs no new consent/targeting
          system. See RM_FrenzyDose (RM_Frenzy_Items.xml).
       6) "Work already done is kept" — confirmed needing nothing: completed
          work is Scribed the moment it completes, nothing to add.

       Mod Settings gate (RM_GreentideSettings.frenzyEnabled/
       frenzySeverityMultiplier) lives on the two consumers of this def
       (RM_IncidentWorker_FrenzyDisease, RM_IngestionOutcomeDoer_FrenzyDose)
       rather than on the HediffDef itself — there is no field to disable a
       HediffDef; gating the routes that ever apply it is the correct place. -->
  <HediffDef>
    <defName>RM_Frenzy</defName>
    <label>the Frenzy</label>
    <description>A feverish, self-accelerating burn that starts as focus and ends as collapse. Work comes faster and faster the longer it runs — until the body gives out all at once into a coma that can last days. Untreated, the coma deepens until it kills; tended during the coma, the colonist survives, and every hour of work already done stays done. The jungle hands this out on its own from time to time, and a harvested dose lets a colonist take it on purpose.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9, 0.25, 0.15)</defaultLabelColor>
    <initialSeverity>0.05</initialSeverity>
    <lethalSeverity>1.0</lethalSeverity>
    <isBad>true</isBad>
    <tendable>true</tendable>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>2.4</severityPerDay>
      </li>
      <li Class="HediffCompProperties_TendDuration">
        <baseTendDurationHours>24</baseTendDurationHours>
        <severityPerDayTended>-1.2</severityPerDayTended>
      </li>
    </comps>
    <stages>
      <li>
        <label>onset</label>
        <painFactor>0.85</painFactor>
        <hungerRateFactorOffset>0.4</hungerRateFactorOffset>
        <restFallFactorOffset>0.3</restFallFactorOffset>
        <statOffsets>
          <li>
            <stat>WorkSpeedGlobal</stat>
            <value>0.3</value>
          </li>
        </statOffsets>
      </li>
      <li>
        <minSeverity>0.3</minSeverity>
        <label>escalation</label>
        <painFactor>0.7</painFactor>
        <hungerRateFactorOffset>0.9</hungerRateFactorOffset>
        <restFallFactorOffset>0.7</restFallFactorOffset>
        <statOffsets>
          <li>
            <stat>WorkSpeedGlobal</stat>
            <value>0.65</value>
          </li>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.65</minSeverity>
        <label>collapse</label>
        <lifeThreatening>true</lifeThreatening>
        <blocksMentalBreaks>true</blocksMentalBreaks>
        <painFactor>0</painFactor>
        <severityGainFactor>0.07</severityGainFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.05</setMax>
          </li>
          <li>
            <capacity>Moving</capacity>
            <setMax>0.05</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
