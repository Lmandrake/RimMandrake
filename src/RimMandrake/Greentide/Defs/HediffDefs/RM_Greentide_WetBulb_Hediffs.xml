<?xml version="1.0" encoding="utf-8"?>
<!--
  GREENTIDE_BASE_PORT_BUILD_1: moved from the campaign tier, RUT_ -> RM_.

  RM_WetBulbOverwhelm (spec M1): ramped by RM_GameCondition_WetBulb through RM_GreentideWetBulbLock.
  Stage shape follows vanilla Heatstroke: escalating Consciousness/Moving capMods, a last stage that
  caps Consciousness low enough to collapse the pawn, lethal at 1.

  RM_DryAirAversion (spec M2): applied by RM_CompDryFieldEmitter (on RM_DryAirBlower) to a wild animal
  in the blower's doorway arc, alongside a vanilla PanicFlee. Inert by itself: it is the re-trigger
  cooldown, and its short Disappears lifetime lets the same animal be repelled again later.
-->
<Defs>

  <HediffDef>
    <defName>RM_WetBulbOverwhelm</defName>
    <label>wet-bulb overwhelm</label>
    <description>The air here holds more heat than the body can shed — sweat does nothing when the air itself is already saturated. Shade and a roof do not help; only sealed or wicking gear, or a truly dried room, slow it. Left unchecked, it collapses the victim and, if exposure continues, kills.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.35, 0.55, 0.8)</defaultLabelColor>
    <lethalSeverity>1</lethalSeverity>
    <stages>
      <li>
        <label>sweat-slicked</label>
        <becomeVisible>false</becomeVisible>
      </li>
      <li>
        <label>sweat-slicked</label>
        <minSeverity>0.08</minSeverity>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>overwhelmed</label>
        <minSeverity>0.3</minSeverity>
        <painOffset>0.1</painOffset>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.15</offset>
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.15</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>collapsing</label>
        <minSeverity>0.62</minSeverity>
        <lifeThreatening>true</lifeThreatening>
        <painOffset>0.25</painOffset>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.4</offset>
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
      </li>
    </stages>
    <tendable>true</tendable>
  </HediffDef>

  <HediffDef>
    <defName>RM_DryAirAversion</defName>
    <label>dry-air aversion</label>
    <description>A blast of bone-dry heat off a dry-air blower — uncomfortable enough that a wild animal wants nothing more to do with wherever it came from.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>2500~3500</disappearsAfterTicks>
      </li>
    </comps>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <tendable>false</tendable>
  </HediffDef>

</Defs>
