    </plant>
  </ThingDef>

  <ThingDef ParentName="PlantBase">
    <defName>RM_Maddrick</defName>
    <label>maddrick</label>
    <description>A ring of inward-curling leaf blades standing shoulder-high, waxy and wet, around a throat of standing fluid you cannot see into until you are at its lip. It closes on what steps in. Completely static — it does not move toward anything. Pure hazard, with a use: a patch of maddrick is a free perimeter, something to build around rather than clear.</description>
    <selectable>true</selectable>
    <neverMultiSelect>True</neverMultiSelect>
    <fillPercent>0.6</fillPercent>
    <pathCost>42</pathCost>
    <graphicData>
      <texPath>Things/Plant/RM_Maddrick/RM_Maddrick_a</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <shaderType>CutoutPlant</shaderType>
      <shadowData>
        <volume>(0.32, 0.32, 0.22)</volume>
        <offset>(0,0,-0.22)</offset>
      </shadowData>
    </graphicData>
    <statBases>
      <MaxHitPoints>130</MaxHitPoints>
      <Flammability>0.1</Flammability>
      <Nutrition>0.2</Nutrition>
      <Mass>18</Mass>
      <BeautyOutdoors>-2</BeautyOutdoors>
    </statBases>
    <plant>
      <!-- No harvestedThingDef, deliberately — a pure hazard row with no
           exploitable yield, same posture Plant_Chokevine itself ships
           (no harvestedThingDef either). -->
      <fertilityMin>0.25</fertilityMin>
      <fertilitySensitivity>0.3</fertilitySensitivity>
      <growDays>14</growDays>
      <visualSizeRange>2.0~3.0</visualSizeRange>
      <topWindExposure>0.1</topWindExposure>
      <wildClusterRadius>4</wildClusterRadius>
      <wildClusterWeight>200</wildClusterWeight>
      <wildOrder>1</wildOrder>
    </plant>
  </ThingDef>

  <ThingDef ParentName="PlantBase">
    <defName>RM_Illurin</defName>
    <label>illurin</label>
    <description>A broad fleshy cap held above pawn height on a thick stem, glowing cyan-green from its underside down onto the mud — so it lights the ground beneath it and blocks the view across. The only light under the canopy. Suppresses nothing, reveals everything within its small radius; without it the understory is unreadable.</description>
    <selectable>true</selectable>
    <neverMultiSelect>True</neverMultiSelect>
    <fillPercent>0.55</fillPercent>
    <pathCost>42</pathCost>
    <graphicData>
      <texPath>Things/Plant/RM_Illurin/RM_Illurin_a</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <shaderType>CutoutPlant</shaderType>
      <shadowData>
        <volume>(0.3, 0.35, 0.22)</volume>
        <offset>(0,0,-0.3)</offset>
      </shadowData>
    </graphicData>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>0.1</Flammability>
      <Nutrition>0.25</Nutrition>
      <Mass>16</Mass>
      <BeautyOutdoors>1</BeautyOutdoors>
    </statBases>
    <plant>
      <!-- No harvestedThingDef — its job is light, not yield, per the
           design doc's own framing ("suppresses nothing, reveals
           everything"). -->
      <fertilityMin>0.2</fertilityMin>
      <fertilitySensitivity>0.3</fertilitySensitivity>
      <growDays>16</growDays>
      <visualSizeRange>4.0~7.0</visualSizeRange>
      <topWindExposure>0.08</topWindExposure>
      <wildClusterRadius>4</wildClusterRadius>
      <wildClusterWeight>200</wildClusterWeight>
      <wildOrder>1</wildOrder>
    </plant>
    <!-- CompProperties_Glower on a Plant is a real, working vanilla pattern
         (Glowstool, Defs/Core/ThingDefs_Plants/Plants_Fungus.xml,
         RimSage-verified this pass) — not invented. Radius sized above
         Glowstool's own 5.9 since illurin is explicitly "the only light
         under the canopy" and the biggest glow-plant on the page. -->
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>7</glowRadius>
        <glowColor>(70,190,150,0)</glowColor>
      </li>
    </comps>
  </ThingDef>

</Defs>
