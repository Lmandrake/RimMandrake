<?xml version="1.0" encoding="utf-8"?>
<!--
  The Greentide's two weathers (GREENTIDE_BASE_PORT_BUILD_1: moved from the campaign tier, RUT_ -> RM_).
  Spec: greentide_kit_spec.md M4 (the Roil) and M5 (Breaklight).

  RM_RoilWeather: waist-deep hot ground fog, forced permanently by RM_RoilLock
  (RM_Greentide_Conditions.xml). accuracy 0.7 / move 0.95 are the spec's INVENTED figures. Never
  precipitates. Overlay is RM_WeatherOverlay_GreentideRoil (this mod's Source/).

  RM_BreaklightClear: the clearing, forced for a few hours by RM_BreaklightCondition. Accuracy and
  move left at the WeatherDef defaults (1.0): "accuracy snaps to full" undoes the Roil's penalties,
  no bonus above that. No overlay, same as vanilla Clear.

  Sky colours on both are INVENTED tuning.
-->
<Defs>

  <WeatherDef>
    <defName>RM_RoilWeather</defName>
    <label>the Roil</label>
    <description>Waist-deep, hot fog that hugs the jungle floor while the canopy stands clear above it — the Greentide's permanent breath, thick enough to hide a Lunger and slow an aimed shot, never quite enough to slow a step.</description>
    <repeatable>true</repeatable>
    <windSpeedFactor>0.25</windSpeedFactor>
    <accuracyMultiplier>0.7</accuracyMultiplier>
    <moveSpeedMultiplier>0.95</moveSpeedMultiplier>
    <rainRate>0</rainRate>
    <snowRate>0</snowRate>
    <sandRate>0</sandRate>
    <favorability>Neutral</favorability>
    <perceivePriority>1</perceivePriority>
    <overlayClasses>
      <li>RimMandrake.Greentide.RM_WeatherOverlay_GreentideRoil</li>
    </overlayClasses>
    <skyColorsDay>
      <sky>(0.62,0.68,0.5)</sky>
      <shadow>(0.55,0.6,0.42)</shadow>
      <overlay>(0.42,0.5,0.32)</overlay>
      <saturation>0.9</saturation>
    </skyColorsDay>
    <skyColorsDusk>
      <sky>(0.6,0.58,0.4)</sky>
      <shadow>(0.5,0.5,0.34)</shadow>
      <overlay>(0.4,0.4,0.26)</overlay>
      <saturation>0.9</saturation>
    </skyColorsDusk>
    <skyColorsNightMid>
      <sky>(0.2,0.24,0.18)</sky>
      <shadow>(0.28,0.3,0.22)</shadow>
      <overlay>(0.18,0.22,0.14)</overlay>
      <saturation>0.75</saturation>
    </skyColorsNightMid>
    <skyColorsNightEdge>
      <sky>(0.28,0.3,0.2)</sky>
      <shadow>(0.34,0.35,0.25)</shadow>
      <overlay>(0.24,0.26,0.17)</overlay>
      <saturation>0.75</saturation>
    </skyColorsNightEdge>
  </WeatherDef>

  <WeatherDef>
    <defName>RM_BreaklightClear</defName>
    <label>Breaklight</label>
    <description>The fog blanket lifts without warning and the Greentide stands naked under a merciless, cloudless sun — every shot true, every degree of the heat suddenly real, and every creature in sight running for shade.</description>
    <repeatable>true</repeatable>
    <windSpeedFactor>1.0</windSpeedFactor>
    <rainRate>0</rainRate>
    <snowRate>0</snowRate>
    <sandRate>0</sandRate>
    <favorability>VeryBad</favorability>
    <perceivePriority>2</perceivePriority>
    <skyColorsDay>
      <sky>(0.98,0.97,0.9)</sky>
      <shadow>(0.95,0.94,0.88)</shadow>
      <overlay>(0.9,0.88,0.78)</overlay>
      <saturation>1.05</saturation>
    </skyColorsDay>
    <skyColorsDusk>
      <sky>(0.95,0.8,0.55)</sky>
      <shadow>(0.9,0.78,0.55)</shadow>
      <overlay>(0.85,0.65,0.4)</overlay>
      <saturation>1.05</saturation>
    </skyColorsDusk>
    <skyColorsNightMid>
      <sky>(0.15,0.17,0.22)</sky>
      <shadow>(0.22,0.24,0.3)</shadow>
      <overlay>(0.12,0.14,0.2)</overlay>
      <saturation>0.9</saturation>
    </skyColorsNightMid>
    <skyColorsNightEdge>
      <sky>(0.22,0.24,0.3)</sky>
      <shadow>(0.28,0.3,0.36)</shadow>
      <overlay>(0.18,0.2,0.26)</overlay>
      <saturation>0.9</saturation>
    </skyColorsNightEdge>
  </WeatherDef>

</Defs>
