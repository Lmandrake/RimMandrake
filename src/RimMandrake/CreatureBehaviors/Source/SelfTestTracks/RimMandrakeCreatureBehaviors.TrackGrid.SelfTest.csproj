<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline, no-game selftest for FOOTPRINT_TRACK_GRID_1 (the footprint grid in
    mandrake.rm.creaturebehaviors). Compiles the REAL production file
    RM_TrackPool.cs (deliberately System-only) straight in. No RimWorld
    assembly is referenced at all.

    NOT the mod build (RM_CreatureBehaviors.csproj one directory up lists its
    files explicitly and never mentions this folder). Its own folder, not
    ../SelfTest, because two projects in one folder share obj/.

    Run via src/RimMandrake/Utils/selftest_track_grid.py.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrakeCreatureBehaviors.TrackGrid.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.CreatureBehaviors.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <DebugType>none</DebugType>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\RM_TrackPool.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
