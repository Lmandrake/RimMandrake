<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SHIP_VERMIN_MOD_1. Same recipe as
    src/RimMandrake/EnvironmentalHazards/Source/RM_EnvironmentalHazards.csproj —
    copy that header if this one goes stale.

    Build (the dotnet is WINDOWS-NATIVE and cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\Rimworld\src\RimMandrake\CreatureBehaviors\Source\RM_CreatureBehaviors.csproj -c Release

    Output lands in ../Assemblies/, which is where RimWorld looks.

    No Harmony: every class here is a plain engine extension point (ThingComp,
    MapComponent, ThinkNode_JobGiver, JobDriver, Alert, DefModExtension).
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrake.CreatureBehaviors</AssemblyName>
    <RootNamespace>RimMandrake.CreatureBehaviors</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="RM_CreatureBehaviorsMod.cs" />
    <Compile Include="RM_VerminPressureExtension.cs" />
    <Compile Include="RM_MapComponent_VerminPopulation.cs" />
    <Compile Include="RM_CompProperties_VerminBreeder.cs" />
    <Compile Include="RM_CompVerminBreeder.cs" />
    <Compile Include="RM_SeekTargetExtension.cs" />
    <Compile Include="RM_JobGiver_SeekMarkedTerrain.cs" />
    <Compile Include="RM_SeekShadeExtension.cs" />
    <Compile Include="RM_JobGiver_SeekShade.cs" />
    <Compile Include="RM_SilenceAuraExtension.cs" />
    <Compile Include="RM_MapComponent_SilenceCue.cs" />
    <Compile Include="RM_GnawTargetExtension.cs" />
    <Compile Include="RM_JobDefOf.cs" />
    <Compile Include="RM_JobGiver_GnawTargets.cs" />
    <Compile Include="RM_JobDriver_Gnaw.cs" />
    <Compile Include="RM_EatCleanableExtension.cs" />
    <Compile Include="RM_ThinkNode_EatCleanable.cs" />
    <Compile Include="RM_JobDriver_EatCleanable.cs" />
    <Compile Include="RM_Alert_VerminPopulationBase.cs" />
    <Compile Include="RM_Alert_VerminPopulation_Inert.cs" />
    <Compile Include="RM_Hediff_SunScald.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
