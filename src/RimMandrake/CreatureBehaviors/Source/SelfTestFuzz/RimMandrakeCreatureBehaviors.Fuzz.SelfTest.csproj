<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CreatureBehaviors offline fuzz (Approach B, same shape as Bazaar/Ninefold/RustCathedral). Plain net8.0, zero
    RimWorld/Unity references: the PRODUCTION files below are pulled in directly. If a `using Verse;` ever lands in
    one of them, this build breaks - that is the guard rail working.
      RM_MovingShadeLayer  the moving-shade grid + dirty rectangles (RM_MapComponent_ShadeGrid calls it)
      RM_SandSwimKernel    the sand swimmer's surface/submerge state machine (RM_CompSandSwim calls it)
    Run: python3 src/RimMandrake/Utils/selftest_creaturebehaviors_fuzz.py [fuzz knobs]
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RimMandrakeCreatureBehaviors.Fuzz.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.CreatureBehaviors.FuzzSelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\RM_SunHeatMath.cs" />
    <Compile Include="..\RM_MovingShadeMath.cs" />
    <Compile Include="..\RM_MovingShadeLayer.cs" />
    <Compile Include="..\RM_SandSwimKernel.cs" />
    <Compile Include="CreatureBehaviorsFuzz.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
