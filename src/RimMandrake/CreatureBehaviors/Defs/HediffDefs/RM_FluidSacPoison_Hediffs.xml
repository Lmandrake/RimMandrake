<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_FluidSacPoison_Hediffs.xml          CreatureBehaviors — DEEPS_FAUNA_MECHANICS_1

  Owner's own words (Drinker): "...it becomes poisoned and rapidly dies."
  Applied to the DRINKER ITSELF (never the victim) by RM_CompFluidSacs when
  a drained victim's RaceProps.FleshType is in the comp's own
  poisonousFleshTypes list — see that class's header. Deliberately fast and
  uncurable ("rapidly dies", not "gets sick and might recover" —
  tendable=false, no HediffCompProperties_Immunizable): a big initial
  severity (set by RM_CompFluidSacs, not here) plus a strongly positive
  HediffCompProperties_SeverityPerDay pushes it to lethalSeverity in well
  under an in-game day.
-->
<Defs>

  <HediffDef>
    <defName>RM_FluidSacPoison</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>curdled blood</label>
    <labelNoun>a case of curdled blood</labelNoun>
    <description>Warm, iron-rich blood was never meant for a creature like this. Its own fluid sacs have started to curdle and fail from the inside.</description>
    <defaultLabelColor>(0.35, 0.55, 0.1)</defaultLabelColor>
    <isBad>true</isBad>
    <tendable>false</tendable>
    <scenarioCanAdd>false</scenarioCanAdd>
    <lethalSeverity>1</lethalSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>6</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <painOffset>0.2</painOffset>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.2</offset>
          </li>
          <li>
            <capacity>BloodPumping</capacity>
            <offset>-0.2</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.6</minSeverity>
        <lifeThreatening>true</lifeThreatening>
        <painOffset>0.4</painOffset>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.5</offset>
          </li>
          <li>
            <capacity>BloodPumping</capacity>
            <offset>-0.5</offset>
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.3</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
