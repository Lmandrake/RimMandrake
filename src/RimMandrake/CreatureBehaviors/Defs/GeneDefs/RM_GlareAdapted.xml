<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_GlareAdapted.xml            CreatureBehaviors - STILLSAND_GLARE_BLIND_GOGGLES_1

  Glare-blind immunity is a GENE, never a race or defName list (owner, typed: "the Jawa won't
  need it, but the slaves might"). RM_GlareBlind.cs reads RM_GlareProtectionExtension off any
  active gene. RM tier; the Jawa xenotype gets it from an RSW patch
  (StarWarsRaces/Patches/RSW_Jawa_GlareAdapted.xml).
-->
<Defs>

  <GeneDef>
    <defName>RM_GlareAdapted</defName>
    <label>glare-adapted eyes</label>
    <description>Carriers of this gene have eyes shaded by a dense pigment layer and a reflex that narrows the pupil to a slit. They are never glare-blinded, however bright the sand.</description>
    <iconPath>UI/Icons/Genes/Gene_Darkvision</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <displayOrderInCategory>61</displayOrderInCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <modExtensions>
      <li Class="RimMandrake.CreatureBehaviors.RM_GlareProtectionExtension" />
    </modExtensions>
  </GeneDef>

</Defs>
