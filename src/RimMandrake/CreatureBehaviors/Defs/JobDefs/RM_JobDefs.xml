<?xml version="1.0" encoding="utf-8" ?>
<!-- SHIP_VERMIN_MOD_1 - the one JobDef this shared assembly ships: driven by
     RM_JobDriver_Gnaw, requested by RM_JobGiver_GnawTargets whenever a pawn's
     race carries RM_GnawTargetExtension. -->
<Defs>

  <JobDef>
    <defName>RM_Gnaw</defName>
    <driverClass>RimMandrake.CreatureBehaviors.RM_JobDriver_Gnaw</driverClass>
    <reportString>gnawing TargetA.</reportString>
  </JobDef>

  <!-- RUST_CATHEDRAL_MECHANICS_1 §6 - driven by RM_JobDriver_EatCleanable,
       requested by RM_ThinkNode_EatCleanable whenever a pawn's race carries
       RM_EatCleanableExtension. -->
  <JobDef>
    <defName>RM_EatCleanable</defName>
    <driverClass>RimMandrake.CreatureBehaviors.RM_JobDriver_EatCleanable</driverClass>
    <reportString>cleaning up TargetA.</reportString>
  </JobDef>

  <!-- GREENTIDE_MECHANICS_2 M7 - driven by RM_JobDriver_LungeAttack,
       requested by RM_CompAquaticAmbusher whenever a submerged pawn
       acquires a hostile target within lunge range. -->
  <JobDef>
    <defName>RM_LungeAttack</defName>
    <driverClass>RimMandrake.CreatureBehaviors.RM_JobDriver_LungeAttack</driverClass>
    <reportString>lunging at TargetA.</reportString>
  </JobDef>

  <!-- DESERT_SHADE_WHALE_FILTERFEED_1 - driven by RM_JobDriver_FilterFeedTerrain,
       requested by RM_JobGiver_FilterFeedTerrain whenever a hungry pawn whose
       race carries RM_FilterFeedExtension can reach terrain on its feed list.
       The driver tops up Need_Food directly, which is what makes this route
       independent of FoodTypeFlags (desert.md section 10: a closed enum with no
       terrain member). -->
  <JobDef>
    <defName>RM_FilterFeedTerrain</defName>
    <driverClass>RimMandrake.CreatureBehaviors.RM_JobDriver_FilterFeedTerrain</driverClass>
    <reportString>filter-feeding.</reportString>
  </JobDef>

</Defs>
