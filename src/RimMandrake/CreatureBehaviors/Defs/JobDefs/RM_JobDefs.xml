<?xml version="1.0" encoding="utf-8" ?>
<!-- SHIP_VERMIN_MOD_1 - the one JobDef this shared assembly ships: driven by
     RM_JobDriver_Gnaw, requested by RM_JobGiver_GnawTargets whenever a pawn's
     race carries RM_GnawTargetExtension. -->
<Defs>

  <JobDef>
    <defName>RM_Gnaw</defName>
    <driverClass>RimMandrake.CreatureBehaviors.RM_JobDriver_Gnaw</driverClass>
    <reportString>gnawing TargetA.</reportString>
  </JobDef>

  <!-- RUST_CATHEDRAL_MECHANICS_1 §6 - driven by RM_JobDriver_EatCleanable,
       requested by RM_ThinkNode_EatCleanable whenever a pawn's race carries
       RM_EatCleanableExtension. -->
  <JobDef>
    <defName>RM_EatCleanable</defName>
    <driverClass>RimMandrake.CreatureBehaviors.RM_JobDriver_EatCleanable</driverClass>
    <reportString>cleaning up TargetA.</reportString>
  </JobDef>

</Defs>
