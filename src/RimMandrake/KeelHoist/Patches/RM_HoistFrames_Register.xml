<?xml version="1.0" encoding="utf-8"?>
<!-- HOIST_FIXED_SITE_FRAMES_1: run RM_HoistFrames on the player's home-map generator (shape of
     RUT_FoundryTowerScatter_Register.xml). A no-op on any map with no extension-carrying portal. -->
<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/MapGeneratorDef[defName="Base_Player"]/genSteps</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/MapGeneratorDef[defName="Base_Player"]/genSteps</xpath>
      <value>
        <li>RM_HoistFrames</li>
      </value>
    </match>
  </Operation>
</Patch>
