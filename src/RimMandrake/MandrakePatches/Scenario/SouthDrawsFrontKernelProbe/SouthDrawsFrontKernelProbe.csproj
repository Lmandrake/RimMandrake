<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The SHIPPED SouthDrawsFront kernel (Source/SouthDrawsFront/SouthDrawsFrontKernel.cs), compiled alone into a plain net8.0
    console that answers altitude queries on stdin (Probe.cs). Offline tests ask it what a thing prints at instead of keeping a
    copy of the rule. Users: src/RimMandrake/GimmeSomeSlack/selftest_gss_mast_behind_tall_south_picture.py
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>SouthDrawsFrontKernelProbe</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Source\SouthDrawsFront\SouthDrawsFrontKernel.cs" />
    <Compile Include="Probe.cs" />
  </ItemGroup>

</Project>
