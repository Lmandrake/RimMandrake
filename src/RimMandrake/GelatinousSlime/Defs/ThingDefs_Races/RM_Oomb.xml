<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_Oomb.xml — the oomb and the lesser oomb, the giant trash-eating amoebae. Owner ruling 2026-10-15 (by card):
  PORT ALL of the creatures that exist only on the frozen RUT_ twin rosters. Invented creatures, no Star Wars IP:
  RM_ tier. Ported from Alpha Animals (sarg.alphaanimals, 1.6/Defs/ThingDefs_Races/Races_AcanthamoebaGigantea.xml:
  AA_AcanthamoebaGiganteaLarge, AA_AcanthamoebaGiganteaSmall). Labels and descriptions are ours (Slime_Rename.xml's
  words, corrected where they promised a split this port does not do). Comfy bands are the live values
  AnimalTolerances_Ashkarr.xml pins on the donor defs.

  OOMB (RM_Oomb). CAST on RM_GelatinousSlime at the twin's 0.15: the_slime.md §4 names "the giant trash-eating
    acanthamoeba" a resistant native, and the free def had no creature of ours for that line (Q14, by card
    2026-09-23: "Holes are filled with new creatures of ours").
  LESSER OOMB (RM_LesserOomb). NOT CAST: the twin cast it on RUT_Wasteland, the owner's round-2 move mapping sent it
    to the Scarlands (RM_Warscar), and the Warscar sheet never ruled it. Transient/phase0_twin_only_questions.md Q2.
    It lives in this file beside its grown form so the growth link below needs no cross-mod reference.

  BOTH:
    REPOINTED to ours: the acid death burst -> RimMandrake.EnvironmentalHazards.DeathActionProperties_ScaledExplosion
      (the values RM_AlphaAnimals_DeathBursts.xml patches onto the donor defs).
    KEPT, VEF-guarded (a framework we keep, as P3 did): eating filth, trash and grass off the ground
      (CompProperties_EatWeirdFood; the VEF weird-eater think tree is added by
      Patches/RM_Oomb_VEFThinkTree.xml only when VEF loads, the fermatalis's pattern). The lesser oomb grows into an oomb after 10
      feedings. The oomb's own growth went to the greater oomb (AA_AcanthamoebaGiganteaHuge), which is not ported:
      it stops growing.
    SWAPPED: body AA_GooBody -> RM_AmorphousBody (this mod's own); sounds AA_GreenGoo_* -> vanilla tortoise (as the
      gelatid); pseudopods link to RM_Pseudopods.
    DROPPED: VRecyclingE_Trash from the food list (another mod's item); donor wildBiomes; the VEF
      AnimalStatExtension info-card rows and its donor art panel; the donor dessicated picture (a cell leaves no
      skeleton; RM_Meltgut precedent).
  ART: the oomb's render exists (artpipe slime_oomb, 3 facings) and is not installed in this mod; the lesser oomb has
    none (filed: donorart_lesseroomb_v1). Until the art ledger installs them, both texPaths are the donor path
    (a placeholder, reported ART OWED by donor_plain_ports_check.py) and the roster row stays
    MayRequire="sarg.alphaanimals".
-->
<Defs>

  <!-- ===================== OOMB ===================== -->
  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Oomb</defName>
    <label>oomb</label>
    <description>A great spiked lobe of a cell, genetically built to eat whatever non-metal trash is put in front of it. It rolls over filth, litter and grass alike and leaves the ground clean behind it.\n\nIt bursts when it dies, and what bursts out burns like acid.</description>
    <statBases>
      <MoveSpeed>1.75</MoveSpeed>
      <ComfyTemperatureMin>-16.3</ComfyTemperatureMin>
      <ComfyTemperatureMax>81.9</ComfyTemperatureMax>
      <MarketValue>350</MarketValue>
      <MeatAmount>0</MeatAmount>
      <LeatherAmount>0</LeatherAmount>
      <FilthRate>0</FilthRate>
      <Wildness>0.42</Wildness>
    </statBases>
    <tools>
      <li>
        <label>pseudopods</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>8</power>
        <cooldownTime>1.2</cooldownTime>
        <linkedBodyPartsGroup>RM_Pseudopods</linkedBodyPartsGroup>
      </li>
    </tools>
    <tickerType>Normal</tickerType>
    <comps>
      <li Class="VEF.AnimalBehaviours.CompProperties_EatWeirdFood" MayRequire="OskarPotocki.VanillaFactionsExpanded.Core">
        <customThingToEat>
          <li>Filth_Dirt</li>
          <li>Filth_AnimalFilth</li>
          <li>Filth_Trash</li>
          <li>Filth_Sand</li>
          <li>Filth_Blood</li>
          <li>Plant_Grass</li>
          <li>Plant_TallGrass</li>
        </customThingToEat>
        <nutrition>1</nutrition>
        <digThingIfMapEmpty>false</digThingIfMapEmpty>
        <fullyDestroyThing>true</fullyDestroyThing>
      </li>
    </comps>
    <race>
      <deathAction Class="RimMandrake.EnvironmentalHazards.DeathActionProperties_ScaledExplosion">
        <flatRadius>3.5</flatRadius>
        <damageDef>AcidBurn</damageDef>
        <damageAmount>16</damageAmount>
        <postExplosionFilth>Filth_SpentAcid</postExplosionFilth>
        <postExplosionFilthChance>0.5</postExplosionFilthChance>
      </deathAction>
      <executionRange>6</executionRange>
      <herdAnimal>false</herdAnimal>
      <body>RM_AmorphousBody</body>
      <baseBodySize>0.8</baseBodySize>
      <canBePredatorPrey>false</canBePredatorPrey>
      <baseHealthScale>1.5</baseHealthScale>
      <baseHungerRate>0.5</baseHungerRate>
      <hasGenders>false</hasGenders>
      <foodType>VegetarianRoughAnimal</foodType>
      <trainability>None</trainability>
      <useMeatFrom>Pig</useMeatFrom>
      <lifeExpectancy>3</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalAdult</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_Tortoise_Wounded</soundWounded>
          <soundDeath>Pawn_Tortoise_Death</soundDeath>
          <soundCall>Pawn_Tortoise_Call</soundCall>
          <soundAngry>Pawn_Tortoise_Call</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <tradeTags>
      <li>AnimalExotic</li>
    </tradeTags>
    <modExtensions>
      <!-- a resistant native (the_slime.md §4): the body does not read it -->
      <li Class="RimMandrake.GelatinousSlime.SlimeResistantExtension" />
    </modExtensions>
  </ThingDef>

  <PawnKindDef ParentName="AnimalKindBase">
    <defName>RM_Oomb</defName>
    <label>oomb</label>
    <race>RM_Oomb</race>
    <combatPower>75</combatPower>
    <canArriveManhunter>false</canArriveManhunter>
    <ecoSystemWeight>0.01</ecoSystemWeight>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/AA_AcanthamoebaGigantea/AA_AcanthamoebaGigantea</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>2.25</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>

  <!-- ===================== LESSER OOMB ===================== -->
  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_LesserOomb</defName>
    <label>lesser oomb</label>
    <description>A young oomb, freshly split from its parent and not yet grown into its full spiked bulk. It eats filth, litter and grass off the ground, and after enough meals it swells into a full oomb.\n\nIt bursts when it dies, and what bursts out burns like acid.</description>
    <statBases>
      <MoveSpeed>1.5</MoveSpeed>
      <ComfyTemperatureMin>-10</ComfyTemperatureMin>
      <ComfyTemperatureMax>81.4</ComfyTemperatureMax>
      <MarketValue>150</MarketValue>
      <MeatAmount>0</MeatAmount>
      <LeatherAmount>0</LeatherAmount>
      <FilthRate>0</FilthRate>
      <Wildness>0.42</Wildness>
    </statBases>
    <tools>
      <li>
        <label>pseudopods</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>4</power>
        <cooldownTime>1.2</cooldownTime>
        <linkedBodyPartsGroup>RM_Pseudopods</linkedBodyPartsGroup>
      </li>
    </tools>
    <tickerType>Normal</tickerType>
    <comps>
      <li Class="VEF.AnimalBehaviours.CompProperties_EatWeirdFood" MayRequire="OskarPotocki.VanillaFactionsExpanded.Core">
        <customThingToEat>
          <li>Filth_Dirt</li>
          <li>Filth_AnimalFilth</li>
          <li>Filth_Trash</li>
          <li>Filth_Sand</li>
          <li>Filth_Blood</li>
          <li>Plant_Grass</li>
          <li>Plant_TallGrass</li>
        </customThingToEat>
        <nutrition>1</nutrition>
        <digThingIfMapEmpty>false</digThingIfMapEmpty>
        <fullyDestroyThing>true</fullyDestroyThing>
        <advanceLifeStage>true</advanceLifeStage>
        <advanceAfterXFeedings>10</advanceAfterXFeedings>
        <defToAdvanceTo>RM_Oomb</defToAdvanceTo>
        <needsWater>false</needsWater>
      </li>
    </comps>
    <race>
      <deathAction Class="RimMandrake.EnvironmentalHazards.DeathActionProperties_ScaledExplosion">
        <flatRadius>1.9</flatRadius>
        <damageDef>AcidBurn</damageDef>
        <damageAmount>10</damageAmount>
        <postExplosionFilth>Filth_SpentAcid</postExplosionFilth>
        <postExplosionFilthChance>0.4</postExplosionFilthChance>
      </deathAction>
      <executionRange>4</executionRange>
      <herdAnimal>false</herdAnimal>
      <body>RM_AmorphousBody</body>
      <baseBodySize>0.2</baseBodySize>
      <canBePredatorPrey>false</canBePredatorPrey>
      <baseHealthScale>0.75</baseHealthScale>
      <baseHungerRate>0.5</baseHungerRate>
      <hasGenders>false</hasGenders>
      <foodType>VegetarianRoughAnimal</foodType>
      <trainability>None</trainability>
      <useMeatFrom>Pig</useMeatFrom>
      <lifeExpectancy>3</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalAdult</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_Tortoise_Wounded</soundWounded>
          <soundDeath>Pawn_Tortoise_Death</soundDeath>
          <soundCall>Pawn_Tortoise_Call</soundCall>
          <soundAngry>Pawn_Tortoise_Call</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <tradeTags>
      <li>AnimalExotic</li>
    </tradeTags>
    <modExtensions>
      <li Class="RimMandrake.GelatinousSlime.SlimeResistantExtension" />
    </modExtensions>
  </ThingDef>

  <PawnKindDef ParentName="AnimalKindBase">
    <defName>RM_LesserOomb</defName>
    <label>lesser oomb</label>
    <race>RM_LesserOomb</race>
    <combatPower>50</combatPower>
    <canArriveManhunter>false</canArriveManhunter>
    <ecoSystemWeight>0.01</ecoSystemWeight>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/AA_AcanthamoebaGigantea/AA_AcanthamoebaGigantea</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.5</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>

</Defs>
