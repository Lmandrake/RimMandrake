    <statBases>
      <MoveSpeed>2</MoveSpeed>
      <ComfyTemperatureMin>-16.3</ComfyTemperatureMin>
      <ComfyTemperatureMax>81.2</ComfyTemperatureMax>
      <MarketValue>700</MarketValue>
