  </ThingDef>

  <PawnKindDef ParentName="AnimalKindBase">
    <defName>RM_LesserOomb</defName>
    <label>lesser oomb</label>
    <race>RM_LesserOomb</race>
    <combatPower>50</combatPower>
    <canArriveManhunter>false</canArriveManhunter>
    <ecoSystemWeight>0.01</ecoSystemWeight>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/RM_LesserOomb/RM_LesserOomb</texPath>
