  <!-- Gene_Healing (Source/Verse/Gene_Healing.cs) is the exact vanilla
       mechanism for "periodically heals a permanent wound/scar" — reused
       directly rather than reinvented, matching this build's precedent on
       A3. No forced-condition detour needed here (nothing hunger/rest/
       mood-shaped in this rider's cost). -->
  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>RM_Gene_B8_SeasonalMolt</defName>
    <label>seasonal molt</label>
    <labelShortAdj>molting</labelShortAdj>
    <description>Twice a year the carrier sheds whole, taking old scars with it. Molt week itself is miserable — raw skin underneath, hands that will not cooperate, and no armour fits over any of it until it is done.</description>
    <iconPath>UI/Icons/Genes/Gene_TotalToxicityResistance</iconPath>
    <biostatCpx>2</biostatCpx>
    <biostatMet>1</biostatMet>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <geneClass>Gene_Healing</geneClass>
    <capMods>
      <li>
        <capacity>Manipulation</capacity>
        <offset>-0.05</offset>
      </li>
    </capMods>
  </GeneDef>

  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>RM_Gene_B9_ContentedPurr</defName>
    <label>contented purr</label>
    <labelShortAdj>purring</labelShortAdj>
    <description>An audible purr whenever mood runs high, comforting to whoever shares the room. It gives the carrier away completely whenever it happens — stealth and a straight face both fail while it is running.</description>
    <iconPath>UI/Icons/Genes/Gene_TotalToxicityResistance</iconPath>
    <biostatCpx>1</biostatCpx>
    <biostatMet>1</biostatMet>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <statFactors>
      <HuntingStealth>0.85</HuntingStealth>
    </statFactors>
  </GeneDef>

  <!-- [SIMPLIFIED] True per-eye heterochromia rendering is an engine limit
