<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    SLIME_GENE_ARCHIVE_BUILD_1 — the B-list (riders), from
    design/Jawa/worldbuilding/biomes/the_slime_gene_lists.md, FROZEN
    2026-09-07. 25 entries, B1-B25.

    🔴 HIDDEN BY DESIGN (the sheet's own header: "player never sees this
    list"). Two structural guarantees, neither of them new UI code:
      1. Dialog_GeneArchive (Source/GeneArchive.cs) only ever iterates
         archive.targetGenes when building its rows — riderGenes is a
         separate list the dialog never reads, so these entries cannot
         appear there no matter how the archive def is authored.
      2. Every entry below sets <canGenerateInGeneSet>false</canGenerateInGeneSet>,
         the real vanilla field that keeps a GeneDef out of any randomly
         generated GeneSet (GeneSet.cs: `if (!gene.canGenerateInGeneSet)
         continue;`) — the mechanism that would otherwise let one of these
         leak into a quest-reward or trader genepack and be selectable in
         Dialog_CreateXenotype/Dialog_CreateXenogerm like an ordinary gene.
      A rider still shows, correctly, on the pawn's own Genes tab once
      injected — that is P5 ("visible and felt"), not a leak.

    P5 — every rider below moves a real stat (never flavor-only) and,
    where a cosmetic change is possible without new art (a direct colour
    override), actually changes how the pawn renders. A few entries
    describe something genuinely periodic/conditional (a monthly binge, a
    once-a-season pocketed item, sleepwalking, an interrogation tell) that
    no GeneDef/HediffStage field can express without new per-gene C#; each
    of those is narrowed to the closest always-on real stat rather than
    invented, flagged inline [SIMPLIFIED].

    iconPath is the same placeholder as the A-list — art bill OWED.
  -->

  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>RM_Gene_B1_VividSkin</defName>
    <label>vivid skin</label>
    <labelShortAdj>vivid-skinned</labelShortAdj>
    <description>A permanent, unmistakable Twi'lek-palette hue. Strangers haggle harder against a face like that, and raiders who meet it once remember it.</description>
    <iconPath>UI/Icons/Genes/Gene_TotalToxicityResistance</iconPath>
    <biostatCpx>1</biostatCpx>
    <biostatMet>1</biostatMet>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <skinColorOverride>(0.62, 0.45, 0.75)</skinColorOverride>
    <statOffsets>
      <TradePriceImprovement>-0.1</TradePriceImprovement>
    </statOffsets>
  </GeneDef>

  <!-- [SIMPLIFIED] Actual lekku geometry needs new body-part art (owed,
       same standing as this repo's other "art bill OWED" genes); the
       mechanical bite here is the lost head coverage. -->
  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>RM_Gene_B2_VestigialLekku</defName>
    <label>vestigial lekku</label>
    <labelShortAdj>lekku-tailed</labelShortAdj>
    <description>Two small head-tails that no tight headgear was ever cut for. A Jawa hood sits wrong over them, and no close helmet covers what it should.</description>
    <iconPath>UI/Icons/Genes/Gene_TotalToxicityResistance</iconPath>
    <biostatCpx>1</biostatCpx>
    <biostatMet>1</biostatMet>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <statOffsets>
      <ComfyTemperatureMin>5</ComfyTemperatureMin>
    </statOffsets>
  </GeneDef>

  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>RM_Gene_B3_NictitatingMembrane</defName>
    <label>nictitating membrane</label>
    <labelShortAdj>membrane-eyed</labelShortAdj>
    <description>A visible sideways-blinking membrane shields the eyes in ash and sand storms. It flickers across the eye in bright light, and shooting suffers for it.</description>
    <iconPath>UI/Icons/Genes/Gene_TotalToxicityResistance</iconPath>
    <biostatCpx>1</biostatCpx>
    <biostatMet>1</biostatMet>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <statOffsets>
      <ShootingAccuracyOutdoorsDarkOffset>0.05</ShootingAccuracyOutdoorsDarkOffset>
      <ShootingAccuracyOutdoorsLitOffset>-0.1</ShootingAccuracyOutdoorsLitOffset>
    </statOffsets>
  </GeneDef>

