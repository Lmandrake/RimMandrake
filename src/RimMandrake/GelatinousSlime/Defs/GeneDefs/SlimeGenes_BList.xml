  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>RM_Gene_B17_ColdNose</defName>
    <label>cold nose</label>
    <labelShortAdj>cold-nosed</labelShortAdj>
    <description>A nose that is always cold and always finding someone to touch it to — endearing to whoever it lands on. It is the first thing to frostbite in a cold snap.</description>
    <iconPath>UI/Icons/Genes/Gene_TotalToxicityResistance</iconPath>
    <biostatCpx>1</biostatCpx>
    <biostatMet>1</biostatMet>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <statOffsets>
      <SocialImpact>0.05</SocialImpact>
