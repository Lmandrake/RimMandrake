    <defName>RM_Gene_B4_BanthaSnore</defName>
    <label>bantha snore</label>
    <labelShortAdj>thunder-snoring</labelShortAdj>
    <description>A snore loud enough to carry through a barracks wall. The carrier can never sleep hidden — the snoring gives the position away long before anything else does.</description>
    <iconPath>UI/Icons/Genes/Gene_TotalToxicityResistance</iconPath>
    <biostatCpx>1</biostatCpx>
    <biostatMet>1</biostatMet>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <statFactors>
      <HuntingStealth>0.7</HuntingStealth>
    </statFactors>
  </GeneDef>

  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>RM_Gene_B5_GlowFreckles</defName>
    <label>glow freckles</label>
    <labelShortAdj>freckle-glowing</labelShortAdj>
    <description>Faint bioluminescent freckling, genuinely pretty in low light. It also means the carrier is the first thing any night-time watcher sees.</description>
    <iconPath>UI/Icons/Genes/Gene_TotalToxicityResistance</iconPath>
    <biostatCpx>1</biostatCpx>
    <biostatMet>1</biostatMet>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
