    </statOffsets>
  </GeneDef>

  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>RM_Gene_B18_DullMusk</defName>
    <label>dull musk</label>
    <labelShortAdj>dull-musked</labelShortAdj>
    <description>A musk that reads as uninteresting to predators — genuinely useful in the wild. Animals in general read the carrier the same way: taming, training and a bond both drift.</description>
    <iconPath>UI/Icons/Genes/Gene_TotalToxicityResistance</iconPath>
    <biostatCpx>1</biostatCpx>
    <biostatMet>1</biostatMet>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <aptitudes>
        <Animals>-3</Animals>
    </aptitudes>
  </GeneDef>

  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>RM_Gene_B19_VestigialGills</defName>
    <label>vestigial gills</label>
    <labelShortAdj>gilled</labelShortAdj>
    <description>Neck slits that pass air normally, most of the time. Desert air dries and cracks them, and an infection through the neck is a real risk here that it is not for anyone else.</description>
    <iconPath>UI/Icons/Genes/Gene_TotalToxicityResistance</iconPath>
    <biostatCpx>1</biostatCpx>
    <biostatMet>1</biostatMet>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <capMods>
      <li>
        <capacity>Breathing</capacity>
        <offset>-0.05</offset>
      </li>
    </capMods>
  </GeneDef>

