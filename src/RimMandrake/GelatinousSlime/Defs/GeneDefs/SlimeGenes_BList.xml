        <capacity>Consciousness</capacity>
        <offset>-0.1</offset>
      </li>
    </capMods>
  </GeneDef>

  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>RM_Gene_B23_SomnambulantHoming</defName>
    <label>somnambulant homing</label>
    <labelShortAdj>sleepwalking</labelShortAdj>
    <description>Rarely, this one sleepwalks toward the nearest slime terrain and wakes far from bed, exhausted. Even the nights it does not happen, rest never quite settles right.</description>
    <iconPath>UI/Icons/Genes/Gene_TotalToxicityResistance</iconPath>
    <biostatCpx>1</biostatCpx>
    <biostatMet>1</biostatMet>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
