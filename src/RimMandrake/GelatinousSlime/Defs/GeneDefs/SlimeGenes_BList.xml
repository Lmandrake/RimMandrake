  <!-- B25 — THE REEK, owner-commissioned. Gas visual: Gene_TheReek
       (Source/GeneConditions.cs), reusing vanilla GasType.RotStink exactly
       as CompRottable does for a rotting corpse — see that class's header
       comment for the full precedent chain. P7's own text names this
       gene's exception: it doubles the Slime-marked penalty rather than
       adding the usual one point (CompTargetEffect_InjectSlimeGenes,
       Source/GeneArchive.cs). -->
  <GeneDef MayRequire="Ludeon.RimWorld.Biotech">
    <defName>RM_Gene_B25_TheReek</defName>
    <label>the Reek</label>
    <labelShortAdj>reeking</labelShortAdj>
    <description>This one stinks past the Jawa baseline, offensive even to other Jawas. An animated stink cloud visibly hangs around them at all times, thick enough that animals and Rodians can find them by scent alone from tiles away. It carries one mercy: whatever it is guarding, insects and vermin want no part of it.</description>
    <iconPath>UI/Icons/Genes/Gene_TotalToxicityResistance</iconPath>
    <biostatCpx>2</biostatCpx>
    <biostatMet>2</biostatMet>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <geneClass>RimMandrake.GelatinousSlime.Gene_TheReek</geneClass>
    <statOffsets>
      <TradePriceImprovement>-0.15</TradePriceImprovement>
      <SocialImpact>-0.15</SocialImpact>
    </statOffsets>
    <statFactors>
      <HuntingStealth>0.3</HuntingStealth>
    </statFactors>
  </GeneDef>

</Defs>
