<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    GELATINOUSSLIME_GLURRO_SALVE_1. The salve and its concentrate slow RM_Slimification's GROWTH while
    the RM_GlurroSalved hediff lasts (hook: HediffComp_Slimification via GlurroSalveUtility). They
    never stop it or reverse it; the antidote is the only cure. strength = initial growth reduction
    (0.5 = half speed), decays with the hediff. All numbers // INVENTED. Art: queued, magenta until
    it lands (texPath Things/Item/Drug/RM_GlurroSalve*).
  -->

  <ThingDef ParentName="ResourceBase">
    <defName>RM_GlurroSalve</defName>
    <label>glurro salve</label>
    <description>A small pot of thick rust-amber salve, milked from a glurro. Rubbed over the skin it makes the film read its wearer more slowly, for a day or two. It slows the reading and does not end it.</description>
    <thingCategories>
      <li>Drugs</li>
    </thingCategories>
    <graphicData>
      <texPath>Things/Item/Drug/RM_GlurroSalve</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>40</MaxHitPoints>
      <MarketValue>35</MarketValue>
      <Mass>0.2</Mass>
      <Flammability>0.3</Flammability>
      <DeteriorationRate>1</DeteriorationRate>
    </statBases>
    <stackLimit>25</stackLimit>
    <techLevel>Neolithic</techLevel>
    <tradeTags>
      <li>ExoticMisc</li>
    </tradeTags>
    <modExtensions>
      <li Class="RimMandrake.GelatinousSlime.GlurroSalveExtension">
        <strength>0.5</strength>
      </li>
    </modExtensions>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>Apply {0_label}</useLabel>
        <useDuration>240</useDuration>
        <showUseGizmo>true</showUseGizmo>
      </li>
      <li Class="CompProperties_Targetable">
        <compClass>CompTargetable_SinglePawn</compClass>
      </li>
      <li Class="CompProperties">
        <compClass>RimMandrake.GelatinousSlime.CompTargetEffect_GlurroSalve</compClass>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>RM_GlurroSalveConcentrate</defName>
    <label>glurro salve concentrate</label>
    <description>The salve boiled down out of a glurro's own carcass: darker, rarer, and nearly twice as strong. It still only slows the reading. Only the antidote ends it.</description>
    <thingCategories>
      <li>Drugs</li>
    </thingCategories>
    <graphicData>
      <texPath>Things/Item/Drug/RM_GlurroSalveConcentrate</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>40</MaxHitPoints>
      <MarketValue>110</MarketValue>
      <Mass>0.2</Mass>
      <Flammability>0.3</Flammability>
      <DeteriorationRate>1</DeteriorationRate>
    </statBases>
    <stackLimit>25</stackLimit>
    <techLevel>Neolithic</techLevel>
    <tradeTags>
      <li>ExoticMisc</li>
    </tradeTags>
    <modExtensions>
      <li Class="RimMandrake.GelatinousSlime.GlurroSalveExtension">
        <strength>0.75</strength>
      </li>
    </modExtensions>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>Apply {0_label}</useLabel>
        <useDuration>240</useDuration>
        <showUseGizmo>true</showUseGizmo>
      </li>
      <li Class="CompProperties_Targetable">
        <compClass>CompTargetable_SinglePawn</compClass>
      </li>
      <li Class="CompProperties">
        <compClass>RimMandrake.GelatinousSlime.CompTargetEffect_GlurroSalve</compClass>
      </li>
    </comps>
  </ThingDef>

</Defs>
