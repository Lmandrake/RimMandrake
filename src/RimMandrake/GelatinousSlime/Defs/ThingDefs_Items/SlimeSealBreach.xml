<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- GELATINOUSSLIME_VAULT_SEAL_BREACH_1 (Slime-side slice). Invented names, RM_ tier. -->
  <ThingDef ParentName="OrganicProductBase">
    <defName>RM_TitanoslimeChunk</defName>
    <label>titanoslime chunk</label>
    <description>A fist-sized lump cut from a titanoslime, still hungry and still moving. It reads whatever it touches and eats what the Assailant made. Laid against an Assailant seal it dissolves the seal and drenches the doorway in slime. Nothing else opens one.\n\nThrown, it bursts: everyone near the landing is drenched to a late stage of slimification and the ground turns to slime for a day. No armour stops it; only dry ground and the antidote undo it.\n\nIt keeps only a little while.</description>
    <graphicData>
      <texPath>Things/Item/Resource/MeatFoodRaw/Meat_Big</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(70, 140, 60)</color>
    </graphicData>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <MarketValue>40</MarketValue>
      <Mass>1</Mass>
      <Flammability>0.2</Flammability>
      <DeteriorationRate>6</DeteriorationRate>
    </statBases>
    <thingCategories />
    <stackLimit>1</stackLimit>
    <equipmentType>Primary</equipmentType>
    <weaponTags><li>GrenadeDestructive</li></weaponTags>
    <verbs>
      <li>
        <label>throw titanoslime chunk</label>
        <verbClass>Verb_LaunchProjectile</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <range>12.9</range>
        <forcedMissRadius>1.9</forcedMissRadius>
        <warmupTime>1.5</warmupTime>
        <noiseRadius>4</noiseRadius>
        <soundCast>ThrowGrenade</soundCast>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <defaultProjectile>RM_Proj_TitanoslimeChunk</defaultProjectile>
      </li>
    </verbs>
    <tradeability>None</tradeability>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>Press {0_label} to the seal</useLabel>
        <useDuration>180</useDuration>
        <showUseGizmo>true</showUseGizmo>
      </li>
      <li>
        <compClass>CompEquippable</compClass>
      </li>
      <li Class="RimMandrake.GelatinousSlime.CompProperties_ChunkShelf" />
      <li Class="CompProperties_Targetable">
        <compClass>RimMandrake.GelatinousSlime.CompTargetable_SlimeBreachable</compClass>
      </li>
      <li Class="CompProperties">
        <compClass>RimMandrake.GelatinousSlime.CompTargetEffect_SlimeBreach</compClass>
      </li>
    </comps>
  </ThingDef>

  <!-- GELATINOUSSLIME_TITAN_CHUNK_BOMB_1: the thrown chunk. Burst logic is Projectile_SlimeChunk. -->
  <ThingDef ParentName="BaseGrenadeProjectile">
    <defName>RM_Proj_TitanoslimeChunk</defName>
    <label>titanoslime chunk</label>
    <thingClass>RimMandrake.GelatinousSlime.Projectile_SlimeChunk</thingClass>
    <graphicData>
      <texPath>Things/Projectile/Grenade</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(70, 140, 60)</color>
    </graphicData>
    <projectile>
      <speed>12</speed>
    </projectile>
  </ThingDef>

  <!-- Parent for the vault's seal (VAULT_DUNGEON_BUILD_1 owns the concrete Assailant seal). -->
  <ThingDef Name="RM_SlimeBreachableSealBase" Abstract="True">
    <thingClass>Building</thingClass>
    <category>Building</category>
    <destroyable>false</destroyable>
    <useHitPoints>false</useHitPoints>
    <passability>Impassable</passability>
    <fillPercent>1</fillPercent>
    <blockWind>true</blockWind>
    <blockLight>true</blockLight>
    <altitudeLayer>Building</altitudeLayer>
    <selectable>true</selectable>
    <rotatable>false</rotatable>
    <building>
      <claimable>false</claimable>
      <deconstructible>false</deconstructible>
      <isInert>true</isInert>
    </building>
    <modExtensions>
      <li Class="RimMandrake.GelatinousSlime.RM_SlimeBreachable">
        <drenchRadius>3.9</drenchRadius>
      </li>
    </modExtensions>
  </ThingDef>
</Defs>
