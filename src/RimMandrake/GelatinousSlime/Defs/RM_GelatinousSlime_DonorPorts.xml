<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    DONOR RETIREMENT (owner, 2026-10-18: "Just put in placeholder art for now or donor copies and retire these
    mods!!! Just get it done."). Alpha Biomes (sarg.alphabiomes) defs the frozen campaign twin of the Slime (RUT_Slime)
    (src/RimUtinni/UtinniPatches/Defs/BiomeDefs) still named, ported as RM_ defs with the donor's own values so the
    painted planet keeps its ground and flora. Art: StandIn/<donor texPath> marked stand-in copies (art ledger,
    provenance kind=donor standin=true) until regenerated; texPaths not served by Alpha Biomes are left as they were.
  -->
  <!-- RM_ShadowlessBushBase: port of AB_ShadowlessBushBase (Alpha Biomes 1.6/Defs/ThingDefs_Plants/Plants_GelatinousSuperorganism.xml), plain XML copy 2026-10-18 for donor retirement. -->
  <ThingDef ParentName="PlantBase" Name="RM_ShadowlessBushBase" Abstract="True">
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <Nutrition>0.3</Nutrition>
    </statBases>
    <selectable>true</selectable>
    <fillPercent>0.20</fillPercent>
    <pathCost>30</pathCost>
    <ingestible/>
    <plant>
      <fertilitySensitivity>0.5</fertilitySensitivity>
      <growDays>3</growDays>
      <wildClusterRadius>4</wildClusterRadius>
      <wildClusterWeight>5</wildClusterWeight>
      <visualSizeRange>0.7~1.1</visualSizeRange>
      <topWindExposure>0.20</topWindExposure>
      <wildOrder>2</wildOrder>
    </plant>
  </ThingDef>

  <!-- RM_ShadowlessTreeBase: port of AB_ShadowlessTreeBase (Alpha Biomes 1.6/Defs/ThingDefs_Plants/Plants_GelatinousSuperorganism.xml), plain XML copy 2026-10-18 for donor retirement. -->
  <ThingDef ParentName="PlantBase" Name="RM_ShadowlessTreeBase" Abstract="True">
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <Flammability>0.8</Flammability>
      <Nutrition>1.7</Nutrition>
    </statBases>
    <altitudeLayer>Building</altitudeLayer>
    <selectable>true</selectable>
    <fillPercent>0.25</fillPercent>
    <passability>PassThroughOnly</passability>
    <pathCost>130</pathCost>
    <blockWind>true</blockWind>
    <ingestible>
      <foodType>Tree</foodType>
      <preferability>RawBad</preferability>
    </ingestible>
    <plant>
      <lifespanDaysPerGrowDays>9</lifespanDaysPerGrowDays>
      <fertilitySensitivity>0.5</fertilitySensitivity>
      <soundHarvesting>Harvest_Tree</soundHarvesting>
      <soundHarvestFinish>Harvest_Tree_Finish</soundHarvestFinish>
      <sowWork>4000</sowWork>
      <sowMinSkill>6</sowMinSkill>
      <sowResearchPrerequisites>
        <li>TreeSowing</li>
      </sowResearchPrerequisites>
      <mustBeWildToSow>true</mustBeWildToSow>
      <harvestWork>800</harvestWork>
      <harvestedThingDef>WoodLog</harvestedThingDef>
      <harvestYield>50</harvestYield>
      <harvestTag>Wood</harvestTag>
      <harvestMinGrowth>0.40</harvestMinGrowth>
      <harvestFailable>false</harvestFailable>
      <blockAdjacentSow>true</blockAdjacentSow>
      <sowTags>
        <li>Ground</li>
      </sowTags>
      <visualSizeRange>1.3~2.0</visualSizeRange>
      <topWindExposure>0.25</topWindExposure>
      <wildClusterRadius>8</wildClusterRadius>
      <wildClusterWeight>24</wildClusterWeight>
      <wildOrder>3</wildOrder>
      <interferesWithRoof>true</interferesWithRoof>
    </plant>
  </ThingDef>

  <!-- RM_TallSlimyGrass: port of AB_TallSlimyGrass (Alpha Biomes 1.6/Defs/ThingDefs_Plants/Plants_GelatinousSuperorganism.xml), plain XML copy 2026-10-18 for donor retirement. -->
  <ThingDef ParentName="PlantBase">
    <defName>RM_TallSlimyGrass</defName>
    <label>tall slimy grass</label>
    <description>Wild tall grass. Slows down anyone moving over it.</description>
    <statBases>
      <MaxHitPoints>90</MaxHitPoints>
      <Flammability>1.3</Flammability>
      <Nutrition>0.16</Nutrition>
    </statBases>
    <pathCost>15</pathCost>
    <graphicData>
      <texPath>Things/Plants/AB_SlimeGrass</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <hideAtSnowOrSandDepth>0.5</hideAtSnowOrSandDepth>
    <ingestible/>
    <plant>
      <fertilitySensitivity>0.7</fertilitySensitivity>
      <growDays>3</growDays>
      <harvestWork>60</harvestWork>
      <maxMeshCount>9</maxMeshCount>
      <visualSizeRange>0.7~0.85</visualSizeRange>
      <topWindExposure>0.4</topWindExposure>
      <wildClusterRadius>4</wildClusterRadius>
      <wildClusterWeight>10</wildClusterWeight>
      <wildOrder>1</wildOrder>
    </plant>
  </ThingDef>

  <!-- RM_SlimyFern: port of AB_SlimyFern (Alpha Biomes 1.6/Defs/ThingDefs_Plants/Plants_GelatinousSuperorganism.xml), plain XML copy 2026-10-18 for donor retirement.
       Dropped/replaced: harvest AB raw slime -> our RM_RawSlime. -->
  <ThingDef ParentName="RM_ShadowlessBushBase">
    <defName>RM_SlimyFern</defName>
    <label>slimy fern</label>
    <description>Although at first sight this seems to be an independent plant, its roots are intricately interconnected with the rest of the gelatinous superorganism.</description>
    <graphicData>
      <texPath>Things/Plants/AB_SlimyFern</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <drawSize>2</drawSize>
    </graphicData>
    <plant>
      <topWindExposure>0.25</topWindExposure>
      <wildClusterRadius>4</wildClusterRadius>
      <wildClusterWeight>7.5</wildClusterWeight>
      <harvestYield>10</harvestYield>
      <harvestTag>Standard</harvestTag>
      <harvestedThingDef>RM_RawSlime</harvestedThingDef>
    </plant>
  </ThingDef>

  <!-- RM_SlimyTree: port of AB_SlimyTree (Alpha Biomes 1.6/Defs/ThingDefs_Plants/Plants_GelatinousSuperorganism.xml), plain XML copy 2026-10-18 for donor retirement.
       Dropped/replaced: harvest AB raw slime -> our RM_RawSlime. -->
  <ThingDef ParentName="RM_ShadowlessTreeBase">
    <defName>RM_SlimyTree</defName>
    <label>slimy tree</label>
    <description>This tree doesn't seem to be entirely solid. Upon further examination, it isn't an independent entity, its roots fusing seamlessly with the hardened gelatinous ground.</description>
    <graphicData>
      <texPath>Things/Plants/AB_SlimyTree</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <statBases>
      <Beauty>2</Beauty>
    </statBases>
    <plant>
      <growDays>32.5</growDays>
      <harvestYield>20</harvestYield>
      <harvestTag>Standard</harvestTag>
      <harvestedThingDef>RM_RawSlime</harvestedThingDef>
      <harvestWork>1200</harvestWork>
      <visualSizeRange>2~2.8</visualSizeRange>
    </plant>
  </ThingDef>

  <!-- RM_Slimecasia: port of AB_Slimecasia (Alpha Biomes 1.6/Defs/ThingDefs_Plants/Plants_GelatinousSuperorganism.xml), plain XML copy 2026-10-18 for donor retirement.
