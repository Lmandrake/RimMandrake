<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    SLIME_GENE_ARCHIVE_BUILD_1 — forced standing conditions.

    GeneDef has no native hunger-rate or rest-fall-rate field (those live
    only on HediffStage: hungerRateFactor/Offset, restFallFactor/Offset,
    opinionOfOthersFactor). The genes below that need one of those effects
    carry a <RM_ForcedConditionExtension> modExtension naming one of these
    HediffDefs and use <geneClass>RimMandrake.GelatinousSlime.
    Gene_ForcesHediff</geneClass> (Source/GeneConditions.cs) to add/remove it
    permanently alongside the gene itself — the same shape as vanilla's own
    Gene_ChemicalDependency/Gene_Bloodfeeder/Gene_Clotting.

    Every one of these is a single, non-progressing stage (minSeverity 0):
    the pawn either carries the gene, and so the condition, or does not.
    Never tendable, never scenario-addable, never curable by item — matching
    RM_SlimeMarked's own precedent in Slimification.xml. Where a condition
    also carries a mood cost, its paired ThoughtDef lives in
    Defs/ThoughtDefs/SlimeGeneConditionThoughts.xml under the same name with
    an "Ache"/"Distrust"/etc. suffix -> "Thought".
  -->

  <HediffDef>
    <defName>RM_Cond_A1_MoistSkin</defName>
    <label>must stay moist</label>
    <description>Amphibious lungs keep the skin's surface chemistry running on borrowed water. On dry ground the carrier burns through food keeping it wet.</description>
    <hediffClass>Hediff</hediffClass>
    <isBad>true</isBad>
    <tendable>false</tendable>
    <scenarioCanAdd>false</scenarioCanAdd>
    <everCurableByItem>false</everCurableByItem>
    <initialSeverity>1</initialSeverity>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <hungerRateFactorOffset>0.25</hungerRateFactorOffset>
      </li>
    </stages>
  </HediffDef>

