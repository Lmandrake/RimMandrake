<?xml version="1.0" encoding="utf-8"?>
<!-- Phase 0 twin-only ports (owner 2026-10-15): the lesser oomb, the oomb and the greater oomb eat filth, trash and grass off the
     ground through VEF's weird-eater think tree, as the donor did. Added only when that ThinkTreeDef exists in the
     loaded defs, so a load without the Vanilla Expanded Framework keeps the vanilla animal think tree (and the VEF
     comps on the defs are skipped by their own MayRequire). Same shape as Miasma/Patches/RM_DecayDrake_VEFThinkTree.xml. -->
<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThinkTreeDef[defName="VEF_AnimalWeirdEater"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName="RM_Oomb"]/race</xpath>
          <value>
            <thinkTreeMain>VEF_AnimalWeirdEater</thinkTreeMain>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName="RM_LesserOomb"]/race</xpath>
          <value>
            <thinkTreeMain>VEF_AnimalWeirdEater</thinkTreeMain>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName="RM_GreaterOomb"]/race</xpath>
          <value>
            <thinkTreeMain>VEF_AnimalWeirdEater</thinkTreeMain>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
