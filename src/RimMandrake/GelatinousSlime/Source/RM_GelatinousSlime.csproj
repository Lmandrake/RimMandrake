<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SLIME_MOD_BUILD_1 — the universal Gelatinous Slime mod
    (design/RimMandrake/RM_gelatinous_slime_mod.md).

    🔴 NO HARMONY REFERENCE, DELIBERATELY. Every hook this mod uses is a
    vanilla extension point (BiomeWorker, HediffComp, MapComponent, ThingComp,
    JobDriver, ThoughtWorker, IngestionOutcomeDoer, Alert, DefModExtension).
    Nothing here patches an engine method, so nothing here breaks on a game
    update that renames one. About.xml says the same and carries no
    brrainz.harmony dependency. Adding one is a decision, not a convenience.

    Build (the dotnet is WINDOWS-NATIVE and cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\Rimworld\src\RimMandrake\GelatinousSlime\Source\RM_GelatinousSlime.csproj -c Release

    Output lands in ../Assemblies/, which is where RimWorld looks.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrakeGelatinousSlime</AssemblyName>
    <RootNamespace>RimMandrake.GelatinousSlime</RootNamespace>
    <Version>0.1.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="SlimeMod.cs" />
    <Compile Include="SlimeBiome.cs" />
    <Compile Include="Slimification.cs" />
    <Compile Include="SlimeExposure.cs" />
    <Compile Include="SlimeVisitors.cs" />
    <Compile Include="SlimeIngestion.cs" />
    <Compile Include="GeneArchive.cs" />
    <Compile Include="GeneSeeker.cs" />
    <Compile Include="SlimeAlerts.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
