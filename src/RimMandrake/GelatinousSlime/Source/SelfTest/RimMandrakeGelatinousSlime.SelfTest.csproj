<Project Sdk="Microsoft.NET.Sdk">

  <!--
    GelatinousSlime offline fuzz, Approach B (same shape as Wasteland). Plain net8.0, zero RimWorld/Unity
    references: ../Kernel/*.cs are the PRODUCTION files the mod compiles, pulled in directly. A `using Verse;` landing
    in one of them breaks this build - that is the guard rail working.
    Run (builds on Windows via winbuild staging, then runs the exe):
      python3 src/RimMandrake/Utils/selftest_luminouspigment_fuzz.py [fuzz knobs]
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RimMandrakeGelatinousSlime.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.GelatinousSlime.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Kernel\RM_SlimeLadder.cs" />
    <Compile Include="..\Kernel\RM_TitanKernel.cs" />
    <Compile Include="..\Kernel\RM_SlimeWorld.cs" />
    <Compile Include="GelatinousSlimeFuzz.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
