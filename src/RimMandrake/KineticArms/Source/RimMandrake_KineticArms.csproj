<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Kinetic Arms (design/RimMandrake/kinetic_blast_weapons_design_2026-10-06.md). Same recipe as Explosive Knockback,
    plus a reference to Explosive Knockback's DLL (RM_KnockbackExtension; never copied: Private false).
    EnableDefaultCompileItems is FALSE: a new .cs needs its own Compile line below, or it compiles into nothing.
    Build: python3 src/RimMandrake/Utils/winbuild.py src/RimMandrake/KineticArms/Source/RimMandrake_KineticArms.csproj
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrakeKineticArms</AssemblyName>
    <RootNamespace>RimMandrake.KineticArms</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HarmonyDll)' == ''">
    <HarmonyDll>C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\2009463077\Current\Assemblies\0Harmony.dll</HarmonyDll>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="RM_KineticMath.cs" />
    <Compile Include="RM_KineticArmsMod.cs" />
    <Compile Include="RM_DamageWorker_KineticOnly.cs" />
    <Compile Include="RM_Projectile_KineticBolt.cs" />
    <Compile Include="RM_Building_KickerMine.cs" />
    <Compile Include="RM_Building_PulseCannon.cs" />
    <Compile Include="RM_KineticArmsProof.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RimMandrakeExplosiveKnockback">
      <HintPath>..\..\ExplosiveKnockback\Assemblies\RimMandrakeExplosiveKnockback.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
