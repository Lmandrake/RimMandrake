<Project Sdk="Microsoft.NET.Sdk">

  <!--
    KineticArms offline fuzz (Approach B). Plain net8.0, zero RimWorld/Unity references: ..\..\RM_KineticMath.cs is the PRODUCTION
    file the mod compiles, pulled in directly. A `using Verse;` landing in it breaks this build - the guard rail working.
    The hand-written KA-01..KA-17 examples live next door (../Program.cs, selftest_kineticarms_kernel.py); this is the seeded fuzz.
      python3 src/RimMandrake/Utils/selftest_kineticarms_fuzz.py [fuzz knobs]
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RimMandrakeKineticArms.Fuzz</AssemblyName>
    <RootNamespace>RimMandrake.KineticArms.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\RM_KineticMath.cs" />
    <Compile Include="KineticArmsFuzz.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
