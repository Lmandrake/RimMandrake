<?xml version="1.0" encoding="utf-8"?>
<!-- Kinetic Arms held weapons (design §3, build §10). Not craftable and no research: the owner ruled these are FOUND
     (ancient Rakatan technology in Ancient Danger ruins; placement is a Utinni-layer patch). Each projectile names its own
     per-weapon DamageDef (RM_Concussive_* / RM_Repulse_*), whose RM_KnockbackExtension.force is that weapon's throw.
     RM_Projectile_KineticBolt explodes one cell BEHIND its impact and passes a cone of cells ahead, so Explosive
     Knockback's radial throw becomes a push along the shot (RM_KineticBoltExtension). weaponTags RM_Kinetic* are for
     faction patches (Q7 open: none ship). -->
<Defs>

  <!-- ==================== Thudder grenade ==================== -->

  <ThingDef ParentName="BaseWeapon">
    <defName>RM_Weapon_ThudderGrenade</defName>
    <label>thudder grenades</label>
    <description>Squat, padded concussion grenades of ancient make. A thudder blast barely bruises, but it throws everyone near it several cells away from where it lands: the answer to a crowd bunched in a doorway or standing on a pit's edge.</description>
    <techLevel>Industrial</techLevel>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/KineticArms/RM_ThudderGrenade</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <uiIconScale>1.3</uiIconScale>
    <soundInteract>Interact_Grenade</soundInteract>
    <statBases>
      <MarketValue>110</MarketValue>
      <Mass>1</Mass>
      <RangedWeapon_Cooldown>2.66</RangedWeapon_Cooldown>
    </statBases>
    <weaponClasses>
      <li>Ranged</li>
    </weaponClasses>
    <weaponTags>
      <li>RM_KineticGrenade</li>
    </weaponTags>
    <tradeTags>
      <li>WeaponRanged</li>
    </tradeTags>
    <thingCategories>
      <li>Grenades</li>
    </thingCategories>
    <smeltable>true</smeltable>
    <verbs>
      <li>
        <label>throw thudder grenade</label>
        <verbClass>Verb_LaunchProjectile</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <range>12.9</range>
        <forcedMissRadius>1.9</forcedMissRadius>
        <warmupTime>1.5</warmupTime>
        <noiseRadius>4</noiseRadius>
        <soundCast>ThrowGrenade</soundCast>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <defaultProjectile>RM_Proj_ThudderGrenade</defaultProjectile>
        <rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
      </li>
    </verbs>
  </ThingDef>

  <ThingDef ParentName="BaseGrenadeProjectile">
    <defName>RM_Proj_ThudderGrenade</defName>
    <label>thudder grenade</label>
    <thingClass>Projectile_Explosive</thingClass>
    <graphicData>
      <texPath>Things/Projectile/KineticArms/RM_ThudderGrenade</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <explosionRadius>2.4</explosionRadius>
      <damageDef>RM_Concussive_Thudder</damageDef>
      <damageAmountBase>6</damageAmountBase>
      <explosionDelay>100</explosionDelay>
    </projectile>
  </ThingDef>

  <!-- ==================== Palm thumper ==================== -->

  <ThingDef ParentName="BaseGunWithQuality">
    <defName>RM_Gun_PalmThumper</defName>
    <label>palm thumper</label>
    <description>A stubby, flared-muzzle sidearm. Its bolt bursts into a short cone of pressure that shoves one target straight away from the shooter, wounding nothing. Pure control: push a charging brawler back, or off a ledge.</description>
    <techLevel>Industrial</techLevel>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/KineticArms/RM_PalmThumper</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Interact_Revolver</soundInteract>
    <statBases>
      <MarketValue>260</MarketValue>
      <Mass>1.6</Mass>
      <AccuracyTouch>0.85</AccuracyTouch>
      <AccuracyShort>0.75</AccuracyShort>
      <AccuracyMedium>0.5</AccuracyMedium>
      <AccuracyLong>0.3</AccuracyLong>
      <RangedWeapon_Cooldown>2.2</RangedWeapon_Cooldown>
    </statBases>
    <weaponTags>
      <li>RM_KineticSidearm</li>
    </weaponTags>
    <tradeTags>
      <li>WeaponRanged</li>
    </tradeTags>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>RM_Proj_PalmThump</defaultProjectile>
        <warmupTime>0.6</warmupTime>
        <range>12.9</range>
        <soundCast>ThumpCannon_Fire</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>6</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>grip</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>8</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>RM_Proj_PalmThump</defName>
    <label>palm thump</label>
    <thingClass>RimMandrake.KineticArms.RM_Projectile_KineticBolt</thingClass>
    <graphicData>
      <texPath>Things/Projectile/KineticArms/RM_PalmThump</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>RM_Repulse_Palm</damageDef>
      <damageAmountBase>1</damageAmountBase>
      <explosionRadius>1.5</explosionRadius>
      <speed>45</speed>
      <soundExplode>ThumpCannon_Impact</soundExplode>
    </projectile>
    <modExtensions>
      <li Class="RimMandrake.KineticArms.RM_KineticBoltExtension">
        <coneDegrees>60</coneDegrees>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- ==================== Slam launcher ==================== -->

  <ThingDef ParentName="BaseGunWithQuality">
    <defName>RM_Gun_SlamLauncher</defName>
    <label>slam launcher</label>
    <description>A fat, two-handed single-shot launcher that lobs a padded kinetic charge into the enemy's second rank, throwing everyone around the impact several cells. It bruises; it does not maim.</description>
    <techLevel>Industrial</techLevel>
    <graphicData>
