<?xml version="1.0" encoding="utf-8"?>
<!-- Thump shell (design §3 row 6): a throwing shell for the ordinary vanilla mortar. Found, never crafted. -->
<Defs>
  <ThingDef ParentName="ShellBase">
    <defName>RM_Shell_Thump</defName>
    <label>thump shell</label>
    <description>An ancient mortar shell with a blunt, padded nose. It barely wounds, but its wide concussion throws everything near the impact - people, animals, loose items - several cells outward. Can be fired from mortars. Explodes when damaged.</description>
    <possessionCount>1</possessionCount>
    <graphicData>
      <texPath>Things/Item/Resource/Shell/RM_Shell_Thump</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>45</MarketValue>
    </statBases>
    <comps>
      <li Class="CompProperties_Explosive">
        <explosiveRadius>3.9</explosiveRadius>
        <explosiveDamageType>RM_Concussive_ThumpShell</explosiveDamageType>
        <explosiveExpandPerStackcount>0.4</explosiveExpandPerStackcount>
        <startWickHitPointsPercent>0.7</startWickHitPointsPercent>
        <wickTicks>30~60</wickTicks>
      </li>
    </comps>
    <projectileWhenLoaded>RM_Bullet_Shell_Thump</projectileWhenLoaded>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>RM_Bullet_Shell_Thump</defName>
    <label>thump shell</label>
    <graphicData>
      <texPath>Things/Projectile/KineticArms/RM_Shell_Thump</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
    </graphicData>
    <thingClass>RimMandrake.KineticArms.RM_Projectile_KineticExplosive</thingClass>
    <projectile>
      <damageDef>RM_Concussive_ThumpShell</damageDef>
      <damageAmountBase>10</damageAmountBase>
      <speed>41</speed>
      <explosionRadius>3.9</explosionRadius>
      <flyOverhead>true</flyOverhead>
      <soundHitThickRoof>Artillery_HitThickRoof</soundHitThickRoof>
      <soundExplode>ThumpCannon_Impact</soundExplode>
      <soundImpactAnticipate>MortarRound_PreImpact</soundImpactAnticipate>
      <soundAmbient>MortarRound_Ambient</soundAmbient>
    </projectile>
  </ThingDef>
</Defs>
