<?xml version="1.0" encoding="utf-8"?>
<!-- Design §2.2 / owner Q1: the thump cannon's Thump blast throws (force 2.5), up to its own cap of 8 cells. Explosive Knockback leaves Thump at its
     unpatched default (0). Patching the DamageDef also covers Odyssey's unique thump cannon, which fires Thump too.
     "Thump cannon throws farther" off in Mod Settings sets this force to 0 at runtime.
     refDamage 9 = Bullet_ThumpCannon's damageAmountBase (Thump's own defaultDamage is 5): blast power (2026-11-13) then gives a
     normal-quality shot ratio 1, so the cannon throws what it was tuned to. -->
<Patch>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/DamageDef[defName="Thump"]</xpath>
    <value>
      <li Class="RimMandrake.ExplosiveKnockback.RM_KnockbackExtension"><force>2.5</force><maxThrowCells>8</maxThrowCells><refDamage>9</refDamage></li>
    </value>
  </Operation>
</Patch>
