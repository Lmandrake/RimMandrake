<?xml version="1.0" encoding="utf-8"?>
<!-- Owner, 2026-10-06 (typed): "Mostly ruins only, but rare on raids that stole it from said ruins (pirates/outlaws)".
     Marks the vanilla pirate gang as looters (RM_Patch_LootedKineticWeapons swaps a raider's gun for a kinetic weapon at
     the Mod Settings chance, default 2% per armed pawn). Patched on Pirate AND on each child BY NAME: inheritance from
     PirateBandBase is not safe, because a mod setting Inherit="False" on a child's modExtensions drops the parent's list
     (ReGrowth 2 does exactly that to PirateWaster; live 2026-10-07 PirateWaster had no marker). success=Always: the
     children are Ideology/Biotech defs.
     Campaign outlaw factions get the same extension from the Utinni layer, never here. -->
<Patch>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/FactionDef[defName="Pirate"]</xpath>
    <value>
      <li Class="RimMandrake.KineticArms.RM_KineticLooterExtension" />
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <success>Always</success>
    <xpath>Defs/FactionDef[defName="CannibalPirate"]</xpath>
    <value>
      <li Class="RimMandrake.KineticArms.RM_KineticLooterExtension" />
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <success>Always</success>
    <xpath>Defs/FactionDef[defName="PirateYttakin"]</xpath>
    <value>
      <li Class="RimMandrake.KineticArms.RM_KineticLooterExtension" />
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <success>Always</success>
    <xpath>Defs/FactionDef[defName="PirateWaster"]</xpath>
    <value>
      <li Class="RimMandrake.KineticArms.RM_KineticLooterExtension" />
    </value>
  </Operation>
</Patch>
