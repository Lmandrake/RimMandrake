    <defName>RM_ExplosiveGrowthRoster_Core</defName>

    <plants>
      <!-- TINDER — fire-loop genetics (roster §TINDER). Ring: quickgrass. -->
      <!-- PYRELANDS GRASS (C3, owner 2026-10-16: "grow violently quickly and spread itself super-fast"): no Tinder, many
           sprouts, fresh ash waters it (C5). It BURSTS at the default 1 in 3 (tree_burst_design_2026-10-17.md §5, Q7 by card:
           "Let Pyrelands grass burst too", keeping 6-9 sprouts), reversing the build's reading of C3. -->
      <li><plant>RM_FE_Plant_Quickgrass</plant><top>Churn</top><sproutCount>6~9</sproutCount><fireAdapted>true</fireAdapted></li>
      <li><plant>RM_FE_Plant_EmberGrass</plant><top>Churn</top><sproutCount>6~9</sproutCount><fireAdapted>true</fireAdapted></li>
