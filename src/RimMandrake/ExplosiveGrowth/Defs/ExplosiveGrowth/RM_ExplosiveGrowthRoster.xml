<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    EXPLOSIVE_PLANT_GROWTH_1 — the RM-tier roster: only plants and content this
    tier (or vanilla/DLC, or a gated donor looked up by name) owns. The
    campaign's own rows (RUT_/RSW_/donor flora the frozen world rosters) ship
    in the Utinni patch layer (mandrake.rut.patches, Defs/ExplosiveGrowth/).

    Source of every assignment: design/RimUtinni/explosive_plant_growth_roster.md
    (regenerated 2026-09-21 against ruling 4, water scarcity decides). CHURN is
    the default and is never listed. A row naming a plant that is not loaded is
    skipped silently and counted in the startup log line.

    SCOPE (owner, 2026-10-16): a BIOME scope. Rows only assign TOPS; any plant
    growing on a map whose biome Baroque Biomes ships runs the everyday bands and
    can soak. An unsupported option (off) extends both to every biome.

    ⛔ No biome decides a top. noSoakBiomes is the soak CARVE-OUT only
    (design doc §3) and is empty here: the RM tier names no campaign biome.
  -->
  <RimMandrake.ExplosiveGrowth.RM_ExplosiveGrowthRosterDef>
    <defName>RM_ExplosiveGrowthRoster_Core</defName>

    <plants>
      <!-- TINDER — fire-loop genetics (roster §TINDER). Ring: quickgrass. -->
      <!-- PYRELANDS GRASS (C3, owner 2026-10-16: "Pyrelands grass does not rupture but does grow violently quickly and
           spread itself super-fast"): no Tinder, never a Burst, many sprouts, fresh ash waters it (C5). Ruling over the
           2026-09-21 roster's Tinder row. -->
      <li><plant>RM_FE_Plant_Quickgrass</plant><top>Churn</top><ruptureChance>0</ruptureChance><sproutCount>6~9</sproutCount><fireAdapted>true</fireAdapted></li>
      <li><plant>RM_FE_Plant_EmberGrass</plant><top>Churn</top><ruptureChance>0</ruptureChance><sproutCount>6~9</sproutCount><fireAdapted>true</fireAdapted></li>
      <li><plant>RM_FE_Plant_ScorchFruit</plant><top>Tinder</top><ringPlant>RM_FE_Plant_Quickgrass</ringPlant></li>

      <!-- SLIME — slime-fed genetics (roster §SLIME). Ring terrain: the
           Gelatinous Slime mod's own rich slime ground. -->
      <li><plant>RM_Plant_SlimeGrass</plant><top>Slime</top><slimeTerrain>RM_Slime_Rich</slimeTerrain><adaptedLiquids><li>RM_Fluid_SlimeRed</li><li>RM_Fluid_SlimeGreen</li><li>RM_Fluid_SlimeWhite</li><li>RM_Fluid_SlimeYellow</li></adaptedLiquids></li>
      <li><plant>RM_Plant_Bellows</plant><top>Slime</top><slimeTerrain>RM_Slime_Rich</slimeTerrain><adaptedLiquids><li>RM_Fluid_SlimeRed</li><li>RM_Fluid_SlimeGreen</li><li>RM_Fluid_SlimeWhite</li><li>RM_Fluid_SlimeYellow</li></adaptedLiquids></li>
      <li><plant>RM_Plant_Thumbstalk</plant><top>Slime</top><slimeTerrain>RM_Slime_Rich</slimeTerrain><adaptedLiquids><li>RM_Fluid_SlimeRed</li><li>RM_Fluid_SlimeGreen</li><li>RM_Fluid_SlimeWhite</li><li>RM_Fluid_SlimeYellow</li></adaptedLiquids></li>
      <li><plant>RM_Plant_Readerbloom</plant><top>Slime</top><slimeTerrain>RM_Slime_Rich</slimeTerrain><adaptedLiquids><li>RM_Fluid_SlimeRed</li><li>RM_Fluid_SlimeGreen</li><li>RM_Fluid_SlimeWhite</li><li>RM_Fluid_SlimeYellow</li></adaptedLiquids></li>
      <li><plant>AB_TallSlimyGrass</plant><top>Slime</top><slimeTerrain>RM_Slime_Rich</slimeTerrain><adaptedLiquids><li>RM_Fluid_SlimeRed</li><li>RM_Fluid_SlimeGreen</li><li>RM_Fluid_SlimeWhite</li><li>RM_Fluid_SlimeYellow</li></adaptedLiquids></li>
