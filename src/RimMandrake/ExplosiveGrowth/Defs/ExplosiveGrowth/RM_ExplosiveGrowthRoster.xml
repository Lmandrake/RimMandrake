    <!-- R-G5 (PLANT_GROWTH_SPEC.md) plus the blue-desert trio PlantGrowth
         already exempts for the same reason. -->
    <exemptPlants>
      <li>RM_Palefloss</li>
      <li>RM_Glassfern</li>
      <li>RM_Chimeglobe</li>
    </exemptPlants>

    <!-- RUPTURE's spawn: "red slimes, occular entities". Kinds looked up by name
         exactly as the Contagion mod itself does (AmoebaHostUtility.HostDefName),
         so there is no hard dependency. RM_OcularJelly is our port of the donor
         zhool (Phase 0 P3); RM_BloodyMess is the Contagion's own port of the donor red goo
         (contagion_grotesque_cast_2026-09-27.md), repointed 2026-10-15 (twin-only ports). -->
    <rupturePawnKinds>
      <li>RM_BloodyMess</li>
      <li>RM_OcularJelly</li>
    </rupturePawnKinds>

    <!-- RUPTURE's "extra mutation hediffs": the Contagion mod's own
         unfinished-limb pool (RM_UnfinishedHediffs.xml), whose Hediff_AddedPart
         shape is already proven safe on a leaf part. -->
    <ruptureMutationHediffs>
      <li>RM_UnfinishedClaw</li>
      <li>RM_UnfinishedSpike</li>
      <li>RM_UnfinishedFang</li>
      <li>RM_UnfinishedStump</li>
      <li>RM_UnfinishedVestigialWing</li>
      <li>RM_UnfinishedUselessJaw</li>
    </ruptureMutationHediffs>

    <!-- T2 (owner card 2026-10-16, "Only for adapted plants"): CLEAN water waters every plant; any other liquid (the four
         slimes, red water, jungle fluids, sheen, boiling water) waters only a plant whose row lists it in adaptedLiquids
         (the slime-fed rows above). Declared per biome at its review sheet. -->
    <cleanWaterFluids>
      <li>RM_Fluid_Water</li>
    </cleanWaterFluids>

    <soakWeathers />

    <!-- W2 (owner 2026-10-16, "(1) and the plants continuously grow and writhe there"): natural fresh water and mud keep
         THEIR OWN cell wet, permanently, never used up. Vanilla/Odyssey defNames (RimSage Terrain_Water.xml,
         Terrain_Natural.xml, Odyssey Terrain_Temporary.xml). Ocean water is salt: not listed. -->
    <naturalWaterTerrains>
      <li>WaterShallow</li>
      <li>WaterDeep</li>
      <li>WaterMovingShallow</li>
      <li>WaterMovingChestDeep</li>
      <li>Marsh</li>
      <li>MarshFlood</li>
      <li>Mud</li>
      <!-- POND_DEPTH_BUILD_SHALLOWS_BEFORE_MUD (FlowWorks): a drawn-down pond's stage waters are its own water (W2/W3: fresh
           while it is there); its exposed mud is Mud above. The cracked RM_Lakebed_* is not listed (W2: dry). -->
      <li>RM_WaterChestDeepStill</li>
      <li>RM_WaterThin</li>
    </naturalWaterTerrains>

    <!-- D6 / OQ-9: standing water that is a source (Defs/ThingDefs_Filth/RM_WaterFilth.xml). -->
    <filthLiquids>
      <li><filth>RM_Filth_WaterSpill</filth><liquid>RM_Fluid_Water</liquid></li>
      <li><filth>RM_Filth_RainPuddle</filth><liquid>RM_Fluid_Water</liquid></li>
    </filthLiquids>

    <!-- ARCHETYPE SEEDS (spec §4.3; OQ-1: no biome water label, the plant lists decide). A plant in one of these biomes'
         wildPlants is a WET native (C1 x4 always; fruit prolifically, wither, a few sprouts); WP3 "Answer is (1)" adds
         Webwork and Contagion to the ruled jungles. Every plant still reaches a review-sheet row; the seed is never the
         final word. -->
    <wetNativeBiomes>
      <li>RM_Greentide</li>
      <li>RM_Miasma</li>
      <li>RM_FeverWood</li>
      <li>RM_Webwork</li>
      <li>RM_Contagion</li>
    </wetNativeBiomes>
    <!-- C5 "A burnt cell counts as fresh": the Pyrelands natives are fire-adapted. -->
    <fireAdaptedBiomes>
      <li>RM_Pyrelands</li>
    </fireAdaptedBiomes>
    <!-- BLUE_DESERT_LIFE_AUTHORING_1 (brief §6a): their growDays (6/9/12)
         already assume vanilla rate ("without the polar water molecule,
         transport and chemistry are simply less efficient"); x4 would erase it. -->
    <bandExemptPlants>
      <li>RM_Palefloss</li>
      <li>RM_Glassfern</li>
      <li>RM_Chimeglobe</li>
    </bandExemptPlants>
  </RimMandrake.ExplosiveGrowth.RM_ExplosiveGrowthRosterDef>

</Defs>
