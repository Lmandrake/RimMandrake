<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FLOWWORKS_BUILD_PROGRAM_1 Phase 1. ONE assembly for the whole liquid
    domain: the canal/depth engine (Source/), the pit cover trigger (Source/Pits/,
    what survives of RimMandrake Pits), the water-effects engine
    (Source/ManyWaters/, merged from ManyWaters) and the liquid registry
    (Source/LiquidTypes/, merged from RimMandrake: Liquid Types).

    HARMONY, as of Phase 5 and for exactly one mechanic: ruling 23's shooting
    restriction is a prefix on Verb.CanHitTargetFrom plus a postfix on
    AttackTargetFinder.BestAttackTarget (RM_Patch_SuperdeepShooting.cs).
    Everything else here remains a normal Thing/ThingComp/JobDriver/
    Designator/MapComponent/DefModExtension subclass through vanilla
    extension points. No DLC reference either —
    Flood_FlowWorks owns its own spread walk over Core members
    (FLOWWORKS_BUILD_PROGRAM_1 Phase 3), because RimWorld.Flood is
    Odyssey content.

    Source/SelfTest/ is a SEPARATE net8.0 project and is deliberately
    absent from the Compile list below; EnableDefaultCompileItems is false,
    so nothing there is picked up implicitly.

    Build (the dotnet is WINDOWS-NATIVE and cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\RimMandrake\src\RimMandrake\FlowWorks\Source\RimMandrake_FlowWorks.csproj -c Release

    Output lands in ../Assemblies/, which is where RimWorld looks.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrakeFlowWorks</AssemblyName>
    <RootNamespace>RimMandrake.FlowWorks</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <!-- Reference only; Harmony itself must come from brrainz.harmony at
       runtime, which is why Private is false below. Same path the sibling
       FloodedCanyon csproj uses. -->
  <PropertyGroup Condition="'$(HarmonyDll)' == ''">
    <HarmonyDll>C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\2009463077\Current\Assemblies\0Harmony.dll</HarmonyDll>
  </PropertyGroup>

  <!-- The canal / depth engine. RM_MapComponent_Excavation is the core
       (ruling 18: depth is the primitive). CompFluidReservoir and
       CompProperties_FluidReservoir are GONE, deleted by ruling 24. -->
  <ItemGroup>
    <Compile Include="RimMandrakeFlowWorks_DefOf.cs" />
    <Compile Include="RimMandrakeFlowWorksMod.cs" />
    <Compile Include="FluidDef.cs" />
    <Compile Include="RM_PitRoomMath.cs" />
    <Compile Include="RM_DigDiscovery.cs" />
    <Compile Include="RM_DigDiscoveryMath.cs" />
    <Compile Include="Superdeep\RM_PitRooms.cs" />
    <Compile Include="RM_FireMath.cs" />
    <Compile Include="RM_LiquidFire.cs" />
    <Compile Include="RM_FillEffectMath.cs" />
    <Compile Include="RM_PitFillEffects.cs" />
    <Compile Include="RM_PitExposureMath.cs" />
    <Compile Include="RM_PitExposure.cs" />
    <Compile Include="Swale\RM_Swale.cs" />
    <Compile Include="RM_ExcavationDepth.cs" />
    <Compile Include="RM_MapComponent_Excavation.cs" />
    <!-- The §5 stock arithmetic, Verse-free on purpose so Source/SelfTest/
         can compile the PRODUCTION file in directly. See its header. -->
    <Compile Include="RM_StockMath.cs" />
    <Compile Include="RM_LiquidBody.cs" />
    <Compile Include="RM_FluidIdentity.cs" />
    <Compile Include="RM_PromotionProofs.cs" />
    <Compile Include="RM_NorthstarProofs.cs" />
    <Compile Include="RM_LiquidStock.cs" />
    <Compile Include="Designator_DigCanal.cs" />
    <Compile Include="WorkGiver_DigCanal.cs" />
    <Compile Include="JobDriver_DigCanal.cs" />
    <Compile Include="Designator_FillInCanal.cs" />
    <Compile Include="WorkGiver_FillInCanal.cs" />
    <Compile Include="JobDriver_FillInCanal.cs" />
    <Compile Include="Flood_FlowWorks.cs" />
    <Compile Include="Debug\FlowWorksDebugActions.cs" />
    <!-- PHASE 5: ladders and ruling 23's shooting rule. SUPERDEEP_HOLDER_RETIRE_1:
         the holder Thing is gone; a pit is a D=4 cell and the trap is a grid rule
         (RM_PitTrapMath is Verse-free and also compiled into Source/SelfTest/). -->
    <Compile Include="Superdeep\RM_LadderUtility.cs" />
    <Compile Include="Superdeep\RM_Spikes.cs" />
    <Compile Include="Superdeep\RM_PitDepthDraw.cs" />
    <Compile Include="RM_PitDrawMath.cs" />
    <Compile Include="Superdeep\RM_FlowDoors.cs" />
    <Compile Include="RM_PitTrapMath.cs" />
    <Compile Include="Superdeep\RM_SuperdeepTrap.cs" />
    <Compile Include="RM_Patch_SuperdeepShooting.cs" />
  </ItemGroup>

  <!-- Pits, merged 2026-09-16; the building model RETIRED 2026-10-02
       (PIT_LEGACY_CODE_RETIRE_1): a pit is a D=4 canal cell. What survives is
       the cover's mass trigger, its tiers and the terrain-mimic printer, kept
       for PIT_COVER_FALL_REWIRE_1. Namespace RimMandrake.FlowWorks.Pits. -->
  <ItemGroup>
    <Compile Include="Pits\TerrainMimic\TerrainMimicPrinter.cs" />
    <Compile Include="Pits\Trigger\CompProperties_PitCoverTrigger.cs" />
    <Compile Include="Pits\Trigger\CompPitCoverTrigger.cs" />
    <Compile Include="Pits\Trigger\PitCoverTier.cs" />
    <Compile Include="Pits\Building_PitCover.cs" />
  </ItemGroup>

  <!-- ManyWaters, merged 2026-09-16. Namespace
       RimMandrake.FlowWorks.ManyWaters (was the bare `RiverSteamHook`;
       RimUtinni: UtinniPatches' ManyWaters_RiverSteam_Ashkarr.xml names
       the modExtension by full type name and was updated in the same
       change). -->
  <ItemGroup>
    <Compile Include="ManyWaters\RiverSteamHook.cs" />
    <Compile Include="ManyWaters\RiverSteamSettings.cs" />
    <!-- DEEP_SAND_WALKABLE_TERRAIN_1: the fishable-but-not-swimmable marker
         and its one Harmony guard (JoyGiver_GoSwimming). -->
    <Compile Include="ManyWaters\RM_NoRecreationalSwimExtension.cs" />
    <Compile Include="ManyWaters\RM_Patch_NoRecreationalSandSwim.cs" />
  </ItemGroup>

  <!-- The liquid registry, merged 2026-09-16 (ruling 14). Namespace
       RimMandrake.FlowWorks.LiquidTypes. -->
  <ItemGroup>
    <Compile Include="LiquidTypes\RM_CompLiquidRevert.cs" />
    <Compile Include="LiquidTypes\Building_LiquidPump.cs" />
    <Compile Include="Machinery\RM_LiquidNet.cs" />
    <Compile Include="Machinery\RM_MachinerySettings.cs" />
    <Compile Include="Machinery\RM_ConversionMath.cs" />
    <Compile Include="Machinery\CompLiquidConverter.cs" />
    <Compile Include="Machinery\CompLiquidPipeAdapter.cs" />
    <Compile Include="Machinery\RM_LiquidWorksRuins.cs" />
    <Compile Include="RM_PumpMath.cs" />
    <Compile Include="RM_WallFaceMath.cs" />
    <Compile Include="RM_LiquidSurface.cs" />
    <Compile Include="Superdeep\RM_FaceMaterial.cs" />
    <Compile Include="Superdeep\RM_PitLipOcclusion.cs" />
    <Compile Include="Superdeep\RM_PitScorch.cs" />
    <Compile Include="Superdeep\RM_ExcavationWalls.cs" />
    <Compile Include="LiquidTypes\RM_LiquidProperties.cs" />
    <Compile Include="LiquidTypes\LiquidCorrosion.cs" />
    <Compile Include="LiquidTypes\LiquidIgnition.cs" />
    <!-- LIQUID_REGISTRY_CORE_1: the top-level LiquidDef registry skeleton. -->
    <Compile Include="LiquidTypes\LiquidDef.cs" />
    <Compile Include="LiquidTypes\RM_BottledLiquidExtension.cs" />
    <!-- LIQUID_BOTTLE_LOOP_1: the fill/use/dirty/wash JobDriver/WorkGiver pair. -->
    <Compile Include="LiquidTypes\RM_LiquidBottleUtility.cs" />
    <Compile Include="LiquidTypes\WorkGiver_FillBottle.cs" />
    <Compile Include="LiquidTypes\JobDriver_FillBottle.cs" />
    <Compile Include="LiquidTypes\WorkGiver_WashBottle.cs" />
    <Compile Include="LiquidTypes\JobDriver_WashBottle.cs" />
    <Compile Include="LiquidTypes\IngestionOutcomeDoer_BottleResidue.cs" />
    <!-- LIQUID_BOTTLE_LOOP_1: the tank half, fill/empty at Building_LiquidTank. -->
    <Compile Include="LiquidTypes\Building_LiquidTank.cs" />
    <Compile Include="LiquidTypes\RM_LiquidTankUtility.cs" />
    <Compile Include="LiquidTypes\WorkGiver_EmptyBottleIntoTank.cs" />
    <Compile Include="LiquidTypes\JobDriver_EmptyBottleIntoTank.cs" />
    <Compile Include="LiquidTypes\WorkGiver_FillBottleFromTank.cs" />
    <Compile Include="LiquidTypes\JobDriver_FillBottleFromTank.cs" />
    <!-- WORLDMAP_LIQUID_TAGS_1: the typed-worldmap layer (a body def, the
         per-tile tag component that derives tags from it, and the landing
         GenStep that repaints generated water to the tagged liquid). -->
    <Compile Include="LiquidTypes\RM_LiquidBodyDef.cs" />
    <Compile Include="LiquidTypes\RM_WorldComponent_LiquidTags.cs" />
    <Compile Include="LiquidTypes\RM_GenStep_LiquidShores.cs" />
  </ItemGroup>

  <!-- MANY_WATERS_DRILL_BUILDINGS_1 — the fourth acquisition route: drill/tap
       buildings that raise a liquid from a map's subsurface. Namespace
       RimMandrake.FlowWorks.Drilling. -->
  <ItemGroup>
    <Compile Include="Drilling\RM_SubsurfaceLiquidBiomeExtension.cs" />
    <Compile Include="Drilling\RM_MapComponent_SubsurfaceLiquid.cs" />
    <Compile Include="Drilling\RM_LiquidDrillExtension.cs" />
    <Compile Include="Drilling\Building_LiquidDrill.cs" />
  </ItemGroup>

  <!-- Rivers: River Works (was mandrake.rm.riverworks, SURFACE_RIVER_WEIRS_1 slices 1-2), merged
       2026-10-05 (owner: "I think river works needs to be part of flow works."). Namespace
       RimMandrake.FlowWorks.Rivers. Its settings are a section of RimMandrakeFlowWorksSettings;
       its Harmony patches (Flood.CanFloodSpreadInto for the levee-off switch; PerceptualSource
       ComputeAll/UpdateIncrementally for ferry ropes undrafted colonists use) are in RM_FerryAndLevee.cs.
       TerminalBiomes references this assembly for the weir's arrester and the river seams. -->
  <ItemGroup>
    <Compile Include="Rivers\RM_RiverMath.cs" />
    <Compile Include="Rivers\RM_RiversSettings.cs" />
    <Compile Include="Rivers\RM_RiverWorks.cs" />
    <Compile Include="Rivers\RM_MapComponent_RiverCurrent.cs" />
    <Compile Include="Rivers\RM_WorldComponent_SweptAway.cs" />
    <Compile Include="Rivers\RM_RiverWorksProof.cs" />
    <Compile Include="Rivers\RM_Weir.cs" />
    <Compile Include="Rivers\RM_SiltTrapAndDrift.cs" />
    <Compile Include="Rivers\RM_FerryAndLevee.cs" />
    <Compile Include="Rivers\RM_RiverWorksProofWorks.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
