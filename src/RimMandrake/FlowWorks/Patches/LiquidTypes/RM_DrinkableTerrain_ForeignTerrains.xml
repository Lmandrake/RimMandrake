<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_DrinkableTerrain_ForeignTerrains.xml   HAND-AUTHORED (LIQUID_TERRAINS_FIX_DRUNK_AS_FRESHWATER)
  Water-tagged terrains of TerminalBiomes, Wastes and FeverWood that no LiquidDef lists are read as plain Potable
  FreshWater by RM_ThirstUtility.DrinkLiquidAt. The extension class lives in this mod's assembly (Wastes and FeverWood
  do not depend on FlowWorks), so the extension is added here, per terrain, only where the terrain exists.
  The two RM_Liquid_NotDrinkable rows (bathing margin, black mirror pool) are the safe default: what drinking them
  does is an open design call. A new Water terrain in any mod must name its liquid or selftest_water_terrains_name_liquid fails.
-->
<Patch>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/TerrainDef[defName="RM_BrinePoolDeep"]</xpath>
    <match Class="PatchOperationAddModExtension">
      <xpath>/Defs/TerrainDef[defName="RM_BrinePoolDeep"]</xpath>
      <value>
        <li Class="RimMandrake.FlowWorks.LiquidTypes.RM_DrinkableTerrainExtension">
          <liquid>RM_Liquid_Brine</liquid>
        </li>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/TerrainDef[defName="RM_BrinePoolShallow"]</xpath>
