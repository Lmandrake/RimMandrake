<?xml version="1.0" encoding="utf-8"?>
<!--
  WORLDMAP_LIQUID_TAGS_1, half 2 — registration.

  Adds RM_LiquidShores to the shared base map generator, the same shape
  src/RimUtinni/FungalSoilTrade/Patches/RUT_FungalSoilScatter_MapGenPatch.xml
  uses: MapGenerator reads MapGeneratorDef.genSteps (plus a biome's
  extraGenSteps), so a step that is not named in a generator's list never
  runs at all.

  Adding it globally is safe because RM_GenStep_LiquidShores self-gates in
  its own Generate(): on a tile with no liquid tag it returns immediately
  without touching the terrain grid. "Untyped tiles = vanilla, untouched" is
  the item's own acceptance criterion and this is the shape that makes it
  literally rather than approximately true.

  ⚠️ PatchOperationAdd on an xpath that matches nothing returns FALSE and is
  reported, unlike PatchOperationConditional/FindMod which return true on no
  match. MapCommonBase is Core's own abstract generator and cannot be absent,
  so a failure here means the xpath is wrong, not that a mod is missing.
-->
<Patch>

  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/MapGeneratorDef[@Name="MapCommonBase"]/genSteps</xpath>
    <value>
      <li>RM_LiquidShores</li>
    </value>
  </Operation>

</Patch>
