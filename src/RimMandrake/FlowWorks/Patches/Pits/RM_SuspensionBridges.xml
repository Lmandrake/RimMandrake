<?xml version="1.0" encoding="utf-8"?>
<!-- SUSPENSION_BRIDGE_BUILD_POSTS_AT_BOTH_ENDS: the four suspension bridge build buttons (plus the two grated ones, SUSPENSION_GRATE_BUILD_LET_THE_FIRE_UP, and the two jetties, SUSPENSION_JETTY_BUILD_WALK_THE_PLANK) (drag anchor to anchor) live in the
     Structure tab as special designators; the deck defs set canGenerateDefaultDesignator false. -->
<Patch>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/DesignationCategoryDef[defName="Structure"]/specialDesignatorClasses</xpath>
    <value>
      <li>RimMandrake.FlowWorks.Pits.Designator_SuspensionBridge_Rope</li>
      <li>RimMandrake.FlowWorks.Pits.Designator_SuspensionBridge_Timber</li>
      <li>RimMandrake.FlowWorks.Pits.Designator_SuspensionBridge_Steel</li>
      <li>RimMandrake.FlowWorks.Pits.Designator_SuspensionBridge_Heavy</li>
      <li>RimMandrake.FlowWorks.Pits.Designator_SuspensionBridge_SteelGrated</li>
      <li>RimMandrake.FlowWorks.Pits.Designator_SuspensionBridge_HeavyGrated</li>
      <li>RimMandrake.FlowWorks.Pits.Designator_SuspensionJetty_Steel</li>
      <li>RimMandrake.FlowWorks.Pits.Designator_SuspensionJetty_Heavy</li>
      <li>RimMandrake.FlowWorks.Pits.Designator_Drawbridge_Timber</li>   <!-- DRAWBRIDGE_BUILD_MOAT_WITH_MANNERS phase 6 -->
      <li>RimMandrake.FlowWorks.Pits.Designator_Drawbridge_Steel</li>
      <li>RimMandrake.FlowWorks.Pits.Designator_SuspensionTower</li>   <!-- SUSPENSION_BUTTONS_DIAGNOSE_STILL_SHOWING: hidden with bridges off -->
    </value>
  </Operation>
</Patch>
