<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_SlipperySlimeGround.xml — SLIME_CROSSING_BUILD_SLIPPERY_SLOPE, hand-written (not generated).
  Owner, 2026-10-16: "Natural slime should also be slippery." Marks natural slime ground with
  RM_SlipperyTerrain so RM_SlimeSlip makes walkers slip on it, as in a slime canal (no climb-out rule:
  natural ground has no climb).

  The set was MEASURED from the def dump (every TerrainDef whose defName/label/description says slime,
  2026-10-16 capture), then kept to the WET slime: FlowWorks' four natural slime pools (shallow + deep),
  GelatinousSlime's liquid slime and slimy mud, Alpha Biomes' liquid
  slime. Left out on purpose: hardened/rich slime ground, slime grass and slime stone (RM_Slime_Hardened,
  RM_Slime_Rich, RM_Slime_Grass, AB_Slime, AB_RichSlime, AB_SlimeGrass, AB_SlimeStone_*): set solid.
  Ooze is not slime.

  Each op is guarded on its target existing, so a missing GelatinousSlime or Alpha Biomes prints nothing.
  The extension's type ships in this mod's own assembly, so it cannot discard a def.
-->
<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/TerrainDef[defName="RM_SlimeRedShallow"]</xpath>
    <match Class="PatchOperationAddModExtension">
      <xpath>/Defs/TerrainDef[defName="RM_SlimeRedShallow"]</xpath>
      <value>
        <li Class="RimMandrake.FlowWorks.RM_SlipperyTerrain"><slipperiness>1</slipperiness></li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/TerrainDef[defName="RM_SlimeRedDeep"]</xpath>
