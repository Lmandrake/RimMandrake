<?xml version="1.0" encoding="utf-8"?>
<!-- The rigid universal pipe's four looks (owner 2026-10-11, rulings #1/#8, design/RimMandrake/gss_flowworks_rulings_2026-10-11.md):
     one ThingStyleDef per look, named RM_UniversalPipe_<Look> (PipeStyles.StyleDefName), stored on each pipe by CompStyleable and
     picked on the build button through the shared style picker (Machinery/PipeLook.cs) - the wires' and the hose reel's interface.
     Each graphicData is a Basic-linked atlas so a run joins up in its look; pipes of different looks still join each other (the
     linkFlags are the def's). Owned art per look (9f9f3d7035, art ledger): RimMandrake/FlowWorks/Pipe/<Look>/UniversalPipe_Atlas and _MenuIcon
     (PipeStyles.AtlasPath / IconPath); sources and the seam checker in art_source/pipe/. No StyleCategoryDef lists these, so no
     ideoligion can hand them out. -->
<Defs>

  <ThingStyleDef>
    <defName>RM_UniversalPipe_Scrapper</defName>
    <label>scrapper</label>
    <uiIconPath>RimMandrake/FlowWorks/Pipe/Scrapper/UniversalPipe_MenuIcon</uiIconPath>
    <graphicData>
      <texPath>RimMandrake/FlowWorks/Pipe/Scrapper/UniversalPipe_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <linkType>Basic</linkType>
      <linkFlags>
        <li>Custom3</li>
      </linkFlags>
      <damageData>
        <rect>(0,0.35,1,0.3)</rect>
      </damageData>
    </graphicData>
  </ThingStyleDef>

