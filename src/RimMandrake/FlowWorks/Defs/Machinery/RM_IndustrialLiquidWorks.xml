<?xml version="1.0" encoding="utf-8"?>
<!--
  LIQUID_INDUSTRY_SETPIECES_1 — found industrial liquid works (design §4 "Found industry"): desal plant,
  detox works, tar refinery (this file) and the pumping station (RM_PumpingStation.xml). Owner law: industrial
  scale is FOUND, not built. Each works comes in the WreckedMachines tier grammar:
    Wrecked  — rubble, scattered at map generation beside its liquid (RM_LiquidWorksScatter.xml), with a
               damaged pump and a part-filled tank beside it (CompLiquidWorksRuin; stealable stock for the
               tanker pillar);
    Kludged  — built OVER the wreck (replaceTags + PlaceWorker_RM_OverRuin): half rate;
    Repaired — built over the kludged works: full rate.
  Mod Settings: one switch per works, liquidWorksRuinsEnabled, industrialWorksBuildAnywhere (off = only over a
  ruin; the public wave's switch), converterRateMultiplier.
  Generated by hand from one table (2026-10-05); keep the three works in step.
  PROVISIONAL: every rate (inputUnitsPerDay; kludged 0.5x), power, cost and work number.
  Art: one painted sprite per tier (artpipe fwart_RM_*), drawn 3x3 over the 3x2 footprint. Still on the
  vanilla ruins texture, tinted, until its job finishes: RM_DesalPlant_Repaired.
-->
<Defs>

  <ThingDef Name="RM_LiquidWorksRuinBase" ParentName="BuildingBase" Abstract="True">
    <thingClass>Building</thingClass>
    <size>(3,2)</size>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>0.75</fillPercent>
    <pathCost>50</pathCost>
    <useHitPoints>true</useHitPoints>
    <selectable>true</selectable>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <Flammability>0</Flammability>
      <Beauty>-12</Beauty>
      <WorkToBuild>2000</WorkToBuild>
    </statBases>
    <costList>
      <Steel>60</Steel>
    </costList>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <building>
      <claimable>true</claimable>
      <deconstructible>true</deconstructible>
    </building>
  </ThingDef>

  <ThingDef Name="RM_LiquidWorksBase" ParentName="BuildingBase" Abstract="True">
    <disableImpassableShotOverConfigError>true</disableImpassableShotOverConfigError>
    <thingClass>Building</thingClass>
    <tickerType>Rare</tickerType>
    <size>(3,2)</size>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>0.75</fillPercent>
    <pathCost>50</pathCost>
    <selectable>true</selectable>
    <designationCategory>Production</designationCategory>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <placeWorkers>
      <li>RimMandrake.FlowWorks.Machinery.PlaceWorker_RM_OverRuin</li>
    </placeWorkers>
    <statBases>
      <MaxHitPoints>400</MaxHitPoints>
      <Flammability>0.3</Flammability>
      <Beauty>-10</Beauty>
    </statBases>
    <building>
      <expandHomeArea>true</expandHomeArea>
    </building>
  </ThingDef>

  <!-- desal plant: WRECKED. Rubble; build the kludged works over it. Scattered by RM_LiquidWorksScatter. -->
  <ThingDef ParentName="RM_LiquidWorksRuinBase">
    <defName>RM_DesalPlant_Wrecked</defName>
    <label>wrecked desal plant</label>
    <description>What is left of a desalination plant: banks of membranes and a boiler train that turn sea water and brine into fresh water by the barrel. Split casings, seized valves, nothing running. It can be patched back to work where it stands: build a kludged desal plant over it.</description>
    <graphicData>
      <texPath>Things/Building/FlowWorks/Machinery/RM_DesalPlant_Wrecked</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <replaceTags>
      <li>RM_DesalPlant</li>
    </replaceTags>
    <comps>
      <li Class="RimMandrake.FlowWorks.Machinery.CompProperties_LiquidWorksRuin">
        <pumpDef>RM_LiquidPump</pumpDef>
        <tankDef>RM_LiquidTank</tankDef>
        <stockLiquids>
          <li>RM_Liquid_SaltWater</li>
          <li>RM_Liquid_Brine</li>
        </stockLiquids>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="RM_LiquidWorksBase">
    <defName>RM_DesalPlant_Kludged</defName>
    <label>kludged desal plant</label>
    <description>A desalination plant: banks of membranes and a boiler train that turn sea water and brine into fresh water by the barrel. Patched back to work with mismatched plate and hope; it runs at half its old rate. Needs power, a tank of its input on its line, and another tank to take the product.</description>
    <graphicData>
      <texPath>Things/Building/FlowWorks/Machinery/RM_DesalPlant_Kludged</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <replaceTags>
      <li>RM_DesalPlant</li>
    </replaceTags>
    <statBases>
      <WorkToBuild>4000</WorkToBuild>
    </statBases>
    <costList>
      <Steel>80</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>900</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="RimMandrake.FlowWorks.Machinery.CompProperties_LiquidConverter">
        <tier>Industrial</tier>
        <processes>
          <li>desalinate</li>
          <li>distill</li>
          <li>cool</li>
        </processes>
        <inputUnitsPerDay>600</inputUnitsPerDay>
        <tierRate>0.5</tierRate>
      </li>
    </comps>
    <modExtensions>
      <li Class="RimMandrake.FlowWorks.Machinery.RM_MachineToggleExtension">
        <key>RM_DesalPlant</key>
        <label>Desal plant (found works)</label>
      </li>
      <li Class="RimMandrake.FlowWorks.Machinery.RM_RestoreOverExtension">
        <over>
          <li>RM_DesalPlant_Wrecked</li>
        </over>
      </li>
    </modExtensions>
  </ThingDef>

