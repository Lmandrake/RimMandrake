<?xml version="1.0" encoding="utf-8"?>
<!--
  FLOWWORKS_BUILD_PROGRAM_1 Phase 8, slice 2 (owner 2026-10-05: "Build all flowworks components").
  * RM_UniversalPipe — the RIGID universal pipe (owner 2026-10-11, rulings #1/#8 in
    design/RimMandrake/gss_flowworks_rulings_2026-10-11.md: "we need a rigid universal pipe that can carry any liquid and
    plugs into other pipe networks cleanly ... Support the different art styles as we did for the wires, using the same
    interface. Then there's the flexible pipe ... That's called Hose."). The flexible part is the hose reel's hose and keeps
    the name hose. Built in Phase 8 as the conduit-style "liquid hose" (RM_LiquidHose); old saves keep their pipes through
    the RM_LiquidHose alias (RM_HoseEssentials, a BackCompatibility.BackCompatibleDefName postfix). Four looks
    (RM_UniversalPipeStyles.xml) picked on the build button through the shared style picker (PipeLook); an unstyled pipe
    draws in the default look. Conducts cardinally like a conduit (RM_LiquidNet). Setting: universalPipesEnabled.
    FLOW SEMANTICS and interop with other pipe networks wait for the owner's liquid-network design pass (2026-10-11).
  * RM_UniversalCargoTank — the ONE new storage building (design §4 "Universal tank interop"):
    minifiable, so it travels in a caravan, a shuttle or a gravship hold with its stock inside — the
    tanker pillar's carrying half. Holds one liquid at a time, any liquid.
  PROVISIONAL: every cost, work, hit-point and capacity number below.
  Pipe art: owned atlases per look (RM_UniversalPipeStyles.xml); the def's own graphic is Scrapper's. Cargo tank has its own
  render (fwart_RM_UniversalCargoTank), distinct from the scavenger tank's.
-->
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>RM_UniversalPipe</defName>
    <label>universal pipe</label>  <!-- rigid; the flexible line is the hose reel's "hose" (ruling #1) -->
    <description>A rigid run of pipe on low clamps that carries any liquid at all. Pipes join every liquid tank they touch into one line with the pumps, stills and works on it, so a pump at the shore can fill a tank across the base. Machines and tanks can stand over it. Pick its look on the build button. For a line you can carry out and wind back in, use a hose reel.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>RimMandrake/FlowWorks/Pipe/Scrapper/UniversalPipe_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <linkType>Basic</linkType>
      <linkFlags>
        <li>Custom3</li>
      </linkFlags>
      <damageData>
        <rect>(0,0.35,1,0.3)</rect>
      </damageData>
    </graphicData>
    <uiIconPath>RimMandrake/FlowWorks/Pipe/Scrapper/UniversalPipe_MenuIcon</uiIconPath>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>Standable</passability>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <drawerType>MapMeshOnly</drawerType>
    <useHitPoints>true</useHitPoints>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <neverMultiSelect>false</neverMultiSelect>
    <soundImpactDefault>BulletImpact_Ground</soundImpactDefault>
    <drawStyleCategory>Conduits</drawStyleCategory>
    <clearBuildingArea>false</clearBuildingArea>
    <designationCategory>VCHE_PipeNetworks</designationCategory>   <!-- ruling #4: where pipe mods put pipes (RM_PipeNetworksTab.xml) -->
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>   <!-- PROVISIONAL: a permanent pipe (was 30 as the fragile spool) -->
      <WorkToBuild>60</WorkToBuild>
      <Flammability>0.4</Flammability>
      <Beauty>-1</Beauty>
    </statBases>
    <costList>
      <Steel>2</Steel>
    </costList>
    <building>
      <isEdifice>false</isEdifice>
      <isInert>true</isInert>
      <ai_chillDestination>false</ai_chillDestination>
      <expandHomeArea>false</expandHomeArea>
    </building>
    <comps>
      <!-- per-build look (ruling #1): the engine's style field + the "Choose style" gizmo; see RM_UniversalPipeStyles.xml -->
      <li Class="CompProperties_Styleable" />
      <li Class="RimMandrake.FlowWorks.Machinery.CompProperties_PipeLook" />
    </comps>
    <modExtensions>
      <li Class="RimMandrake.FlowWorks.Machinery.RM_UniversalPipeExtension" />
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>RM_UniversalCargoTank</defName>
    <label>universal cargo tank</label>
    <description>A sealed cargo tank on skids, made to be lifted, carried and set down again with its liquid still inside. Holds a large quantity of one liquid at a time, any liquid at all. Fill it by hand with bottles, buckets and barrels, or from a pump, still or works on its hose line; uninstall it and it travels in a caravan, a shuttle or a ship's hold with its stock intact.</description>
    <thingClass>RimMandrake.FlowWorks.LiquidTypes.Building_LiquidTank</thingClass>
    <graphicData>
      <texPath>Things/Building/FlowWorks/RM_UniversalCargoTank</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <size>(2,2)</size>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>1.0</fillPercent>
    <pathCost>50</pathCost>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <designationCategory>VCHE_PipeNetworks</designationCategory>   <!-- ruling #4: VE pipe mods keep their tanks in the pipe tab -->
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <statBases>
      <WorkToBuild>5200</WorkToBuild>
      <MaxHitPoints>320</MaxHitPoints>
      <Flammability>0.2</Flammability>
      <Beauty>-6</Beauty>
      <Mass>90</Mass>
    </statBases>
    <costList>
      <Steel>220</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <building>
      <expandHomeArea>true</expandHomeArea>
    </building>
    <modExtensions>
      <li Class="RimMandrake.FlowWorks.LiquidTypes.RM_LiquidTankExtension">
        <tall>true</tall>   <!-- POND_VOLUME_UNIFY: 2x2 tall = 160 units (4 squares x 2 notches x 20) -->
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
