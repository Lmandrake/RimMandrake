<?xml version="1.0" encoding="utf-8"?>
<!--
  FLOWWORKS_BUILD_PROGRAM_1 Phase 8, slice 2 (owner 2026-10-05: "Build all flowworks components").
  * RM_UniversalPipe — the permanent universal pipe (owner 2026-10-04: "universal pipes that can carry any liquid of
    any kind"). Built in Phase 8 as the framework's quick "liquid hose" (design §4 RM_HoseSpool); renamed at the hose
    port (2026-10-11, owner Q1 default) because the hose reel is FlowWorks' one hose and does the spool's job, and made
    sturdier as a permanent pipe (PROVISIONAL numbers). Old saves keep their pipes: RM_LiquidHose aliases to this def
    (RM_HoseEssentials, a BackCompatibility.BackCompatibleDefName postfix). Conducts cardinally like a conduit; joins
    every tank touching the run into one liquid net with any pump, still, works or adapter touching it (RM_LiquidNet).
    NOT terrain, NOT a VE pipe. Setting: universalPipesEnabled.
  * RM_UniversalCargoTank — the ONE new storage building (design §4 "Universal tank interop"):
    minifiable, so it travels in a caravan, a shuttle or a gravship hold with its stock inside — the
    tanker pillar's carrying half. Holds one liquid at a time, any liquid.
  PROVISIONAL: every cost, work, hit-point and capacity number below.
  ART OWED: pipe atlas (placeholder: vanilla power-conduit atlas, tinted); cargo tank has its own
  render (fwart_RM_UniversalCargoTank), distinct from the scavenger tank's.
-->
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>RM_UniversalPipe</defName>
    <label>universal pipe</label>
    <description>A run of welded scrap pipe on low clamps that carries any liquid at all. Pipes join every liquid tank they touch into one line with the pumps, stills and works on it, so a pump at the shore can fill a tank across the base. Machines and tanks can stand over it. For a line you can carry out and wind back in, use a hose reel.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>Things/Building/Linked/PowerConduit_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <linkType>Basic</linkType>
      <color>(90,140,190)</color>
      <linkFlags>
        <li>Custom3</li>
      </linkFlags>
      <damageData>
        <rect>(0,0.35,1,0.3)</rect>
      </damageData>
    </graphicData>
    <uiIconPath>Things/Building/Linked/PowerConduit_MenuIcon</uiIconPath>
    <uiIconColor>(90,140,190)</uiIconColor>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>Standable</passability>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <drawerType>MapMeshOnly</drawerType>
    <useHitPoints>true</useHitPoints>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <neverMultiSelect>false</neverMultiSelect>
    <soundImpactDefault>BulletImpact_Ground</soundImpactDefault>
    <drawStyleCategory>Conduits</drawStyleCategory>
    <clearBuildingArea>false</clearBuildingArea>
    <designationCategory>Production</designationCategory>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>   <!-- PROVISIONAL: a permanent pipe (was 30 as the fragile spool) -->
      <WorkToBuild>60</WorkToBuild>
      <Flammability>0.4</Flammability>
      <Beauty>-1</Beauty>
    </statBases>
    <costList>
      <Steel>2</Steel>
    </costList>
    <building>
      <isEdifice>false</isEdifice>
      <isInert>true</isInert>
      <ai_chillDestination>false</ai_chillDestination>
      <expandHomeArea>false</expandHomeArea>
    </building>
    <modExtensions>
      <li Class="RimMandrake.FlowWorks.Machinery.RM_UniversalPipeExtension" />
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>RM_UniversalCargoTank</defName>
    <label>universal cargo tank</label>
    <description>A sealed cargo tank on skids, made to be lifted, carried and set down again with its liquid still inside. Holds a large quantity of one liquid at a time, any liquid at all. Fill it by hand with bottles, buckets and barrels, or from a pump, still or works on its hose line; uninstall it and it travels in a caravan, a shuttle or a ship's hold with its stock intact.</description>
    <thingClass>RimMandrake.FlowWorks.LiquidTypes.Building_LiquidTank</thingClass>
    <graphicData>
      <texPath>Things/Building/FlowWorks/RM_UniversalCargoTank</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <size>(2,2)</size>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>1.0</fillPercent>
    <pathCost>50</pathCost>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <designationCategory>Production</designationCategory>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <statBases>
      <WorkToBuild>5200</WorkToBuild>
      <MaxHitPoints>320</MaxHitPoints>
      <Flammability>0.2</Flammability>
      <Beauty>-6</Beauty>
      <Mass>90</Mass>
    </statBases>
    <costList>
      <Steel>220</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <building>
      <expandHomeArea>true</expandHomeArea>
    </building>
    <modExtensions>
      <li Class="RimMandrake.FlowWorks.LiquidTypes.RM_LiquidTankExtension">
        <baseCapacityUnits>600</baseCapacityUnits>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
