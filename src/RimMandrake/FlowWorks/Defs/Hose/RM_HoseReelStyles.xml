<?xml version="1.0" encoding="utf-8"?>
<!-- Per-build styles of the hose reel (Gimme Some Slack style stage 3, moved to FlowWorks at the hose port) (design/RimMandrake/messyconduit_style_per_build_design.md
     section 5 stage 3, architecture B). One ThingStyleDef per look, named RM_HoseReel_<Look> (HoseStyles.StyleDefName),
     stored on the reel by CompStyleable and carried blueprint -> frame -> building -> minified -> save by the engine.
     graphicClass Graphic_HoseReel: the stored art below while the hose is reeled in, the sibling Reel_Deployed (empty
     drum with its hose inlet) of the SAME folder while it is laid out, so each look swaps within its own pair. The hose
     the reel lays draws in the reel's look (HoseMaterials.For). Geometry matches RM_HoseReel's own graphicData.
     No StyleCategoryDef lists these, so no ideoligion can hand them out. -->
<Defs>

  <ThingStyleDef>
    <defName>RM_HoseReel_Scrapper</defName>
    <label>scrapper</label>
    <graphicData>
      <texPath>RimMandrake/FlowWorks/Hose/Reel_PumpHookup</texPath>
      <graphicClass>RimMandrake.FlowWorks.Hose.Graphic_HoseReel</graphicClass>
      <drawSize>(2.15,2.15)</drawSize>
      <shadowData><volume>(0.65, 0.35, 0.65)</volume></shadowData>
      <damageData><rect>(0.1,0.1,0.8,0.8)</rect></damageData>
    </graphicData>
  </ThingStyleDef>

  <ThingStyleDef>
    <defName>RM_HoseReel_Industrial</defName>
    <label>industrial</label>
    <graphicData>
      <texPath>RimMandrake/FlowWorks/Hose/Styles/Industrial/Reel_PumpHookup</texPath>
      <graphicClass>RimMandrake.FlowWorks.Hose.Graphic_HoseReel</graphicClass>
      <drawSize>(2.15,2.15)</drawSize>
      <shadowData><volume>(0.65, 0.35, 0.65)</volume></shadowData>
      <damageData><rect>(0.1,0.1,0.8,0.8)</rect></damageData>
    </graphicData>
  </ThingStyleDef>

  <ThingStyleDef>
    <defName>RM_HoseReel_Modern</defName>
    <label>modern</label>
    <graphicData>
      <texPath>RimMandrake/FlowWorks/Hose/Styles/Modern/Reel_PumpHookup</texPath>
      <graphicClass>RimMandrake.FlowWorks.Hose.Graphic_HoseReel</graphicClass>
      <drawSize>(2.15,2.15)</drawSize>
      <!-- MODERN_REEL_SHADOW_FIX_BOX_TOO_BIG (live look 2026-10-22): the FA reel is a slim pedestal reel whose drum is ~0.85 x 1.0;
           the shared 1.23 x 1.04 box drew a hard square well past it. Square so the engine's per-rotation swap fits every facing.
           HOSE_REEL_SHADOW_FIX_FULL_TILE_SQUARE: all four looks share that drum footprint (0.85 cell side-on), so all four and
           RM_HoseReel itself now cast this one box (HoseEndLipChecks pins it). -->
      <shadowData><volume>(0.65, 0.35, 0.65)</volume></shadowData>
      <damageData><rect>(0.1,0.1,0.8,0.8)</rect></damageData>
    </graphicData>
  </ThingStyleDef>

  <ThingStyleDef>
    <defName>RM_HoseReel_Futuristic</defName>
    <label>futuristic</label>
    <graphicData>
      <texPath>RimMandrake/FlowWorks/Hose/Styles/Futuristic/Reel_PumpHookup</texPath>
      <graphicClass>RimMandrake.FlowWorks.Hose.Graphic_HoseReel</graphicClass>
      <drawSize>(2.15,2.15)</drawSize>
      <shadowData><volume>(0.65, 0.35, 0.65)</volume></shadowData>
      <damageData><rect>(0.1,0.1,0.8,0.8)</rect></damageData>
    </graphicData>
  </ThingStyleDef>

</Defs>
