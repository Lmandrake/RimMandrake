<?xml version="1.0" encoding="utf-8"?>
<!-- FlowWorks flexible hoses (moved from Gimme Some Slack lane L6 at the hose port, 2026-10-11; design/RimMandrake/hose_port_to_flowworks_design_FINAL_2026-10-10.md).
     The reel is a plain vanilla Building; the hose is data on its comp (a save names only this def). -->
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>RM_HoseReel</defName>
    <label>hose reel</label>
    <description>A reel of thick sack-cloth flexible hose, stitched like a Jawa robe, on a scrap hookup. Build it touching a liquid tank, pump or pipe, then use Deploy hose: a colonist carries the free end out (the reach is in the mod settings) and the hose unrolls behind them. Lay the end on another tank, pump or reel to join them, or leave it lying free as an intake or outflow (the Free end button). Retract hose winds it back in. The hose lies flat and limp when empty and plumps up round and taut while liquid moves through it.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>RimMandrake/FlowWorks/Hose/Reel_PumpHookup</texPath>
      <graphicClass>RimMandrake.FlowWorks.Hose.Graphic_HoseReel</graphicClass>
      <drawSize>(2.15,2.15)</drawSize>
      <shadowData><volume>(0.65, 0.35, 0.65)</volume></shadowData>
      <damageData><rect>(0.1,0.1,0.8,0.8)</rect></damageData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.3</fillPercent>
    <size>(2,2)</size>
    <!-- REEL_OUTLET_DECIDE_ALWAYS_GOES_WEST (owner card 2026-10-22, "Player turns the reel"): the reel turns; its outlet,
         nozzle and picture turn with it (Graphic_HoseReel, HoseReelRect.Rot). West is the picture as drawn and the default;
         east is it mirrored; north/south draw their own pictures (REEL_FACINGS_REDRAW_NORTH_SOUTH_OWED, HoseReelRect.ArtPose). -->
    <rotatable>true</rotatable>
    <defaultPlacingRot>West</defaultPlacingRot>
    <placeWorkers><li>RimMandrake.FlowWorks.Hose.PlaceWorker_HoseReelOutlet</li></placeWorkers>
    <selectable>true</selectable>
    <designationCategory>VCHE_PipeNetworks</designationCategory>   <!-- ruling #4 (2026-10-11): hoses go where pipes go (Defs/Machinery/RM_PipeNetworksTab.xml) -->
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories><li>BuildingsMisc</li></thingCategories>
    <constructEffect>ConstructMetal</constructEffect>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>300</WorkToBuild>
      <Flammability>1</Flammability>
      <Mass>12</Mass>
      <Beauty>-2</Beauty>
    </statBases>
    <costList>
      <Cloth>25</Cloth>
      <Steel>15</Steel>
    </costList>
    <comps>
      <li Class="RimMandrake.FlowWorks.Hose.CompProperties_HoseReel" />
      <!-- per-build style (stage 3): the look picked on the build button, see RM_HoseReelStyles.xml -->
      <li Class="CompProperties_Styleable" />
    </comps>
  </ThingDef>

</Defs>
