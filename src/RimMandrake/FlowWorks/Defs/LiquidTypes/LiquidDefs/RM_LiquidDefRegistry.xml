<Defs>

  <RimMandrake.FlowWorks.LiquidTypes.LiquidDef>
    <defName>RM_Liquid_FreshWater</defName>
    <label>fresh water</label>
    <description>Water, unmodified — the baseline every other row is measured against.</description>
    <viscosityClass>Water</viscosityClass>
    <pH>7</pH>
    <distillable>true</distillable>
    <terrainSuite>
      <shallow>WaterShallow</shallow>
      <deep>WaterDeep</deep>
    </terrainSuite>
    <canalFluid>RM_Fluid_Water</canalFluid>
    <bottled>
      <bottle>RM_Bottle_FreshWater</bottle>
      <unitsPerBottle>1</unitsPerBottle>
    </bottled>
    <thirstQuality>Potable</thirstQuality>
  </RimMandrake.FlowWorks.LiquidTypes.LiquidDef>

  <RimMandrake.FlowWorks.LiquidTypes.LiquidDef>
    <defName>RM_Liquid_SaltWater</defName>
    <label>salt water</label>
    <description>The open sea — undrinkable raw, and the product most conversions start from.</description>
    <viscosityClass>Water</viscosityClass>
    <pH>8</pH>
    <distillable>true</distillable>
    <terrainSuite>
      <shallow>WaterOceanShallow</shallow>
      <deep>WaterOceanDeep</deep>
    </terrainSuite>
    <bottled>
      <bottle>RM_Bottle_SaltWater</bottle>
      <unitsPerBottle>1</unitsPerBottle>
    </bottled>
    <thirstQuality>Fouled</thirstQuality>
  </RimMandrake.FlowWorks.LiquidTypes.LiquidDef>

  <RimMandrake.FlowWorks.LiquidTypes.LiquidDef>
    <defName>RM_Liquid_BoilingWater</defName>
    <label>boiling water</label>
    <description>Kept liquid by heat rather than depth. Steam stands off the surface even in still air.</description>
    <viscosityClass>Water</viscosityClass>
    <pH>7</pH>
    <distillable>true</distillable>
    <terrainSuite>
      <shallow>RM_WaterBoilingShallow</shallow>
      <deep>RM_WaterBoilingDeep</deep>
    </terrainSuite>
    <bottled>
      <bottle>RM_Bottle_BoilingWater</bottle>
      <unitsPerBottle>1</unitsPerBottle>
    </bottled>
    <worldTag>RM_Liquid_BoilingWater</worldTag>
  </RimMandrake.FlowWorks.LiquidTypes.LiquidDef>

  <RimMandrake.FlowWorks.LiquidTypes.LiquidDef>
    <defName>RM_Liquid_IcyWater</defName>
    <label>icy water</label>
    <description>Water cold enough to steal warmth through boots and gloves alike.</description>
    <viscosityClass>Thick</viscosityClass>
    <pH>7</pH>
    <damageOnContact>
      <damageDef>Frostbite</damageDef>
      <amount>1</amount>
    </damageOnContact>
    <damageOnImmersion>
      <damageDef>Frostbite</damageDef>
      <amount>3</amount>
    </damageOnImmersion>
    <corrodesApparel>false</corrodesApparel>
    <distillable>true</distillable>
    <terrainSuite>
      <shallow>RM_WaterFrigidShallow</shallow>
      <deep>RM_WaterFrigidDeep</deep>
    </terrainSuite>
    <bottled>
      <bottle>RM_Bottle_IcyWater</bottle>
      <unitsPerBottle>1</unitsPerBottle>
    </bottled>
  </RimMandrake.FlowWorks.LiquidTypes.LiquidDef>

  <RimMandrake.FlowWorks.LiquidTypes.LiquidDef>
    <defName>RM_Liquid_ToxicWater</defName>
    <label>toxic water</label>
    <description>Water carrying more than it should. Nothing in it is inert.</description>
    <viscosityClass>Water</viscosityClass>
    <pH>7</pH>
    <distillable>true</distillable>
    <terrainSuite>
      <shallow>RM_WaterPoisonedShallow</shallow>
      <deep>RM_WaterPoisonedDeep</deep>
    </terrainSuite>
    <bottled>
      <bottle>RM_Bottle_ToxicWater</bottle>
      <unitsPerBottle>1</unitsPerBottle>
    </bottled>
    <thirstQuality>Toxic</thirstQuality>
  </RimMandrake.FlowWorks.LiquidTypes.LiquidDef>

  <RimMandrake.FlowWorks.LiquidTypes.LiquidDef>
    <defName>RM_Liquid_AcidWater</defName>
    <label>acid water</label>
    <description>Water gone wrong — the color isn't life, it's reaction.</description>
    <viscosityClass>Water</viscosityClass>
    <pH>2</pH>
    <damageOnContact>
      <damageDef>AcidBurn</damageDef>
      <amount>1</amount>
    </damageOnContact>
    <damageOnImmersion>
      <damageDef>AcidBurn</damageDef>
      <amount>3</amount>
    </damageOnImmersion>
    <corrodesApparel>true</corrodesApparel>
    <terrainSuite>
      <shallow>RM_AcidShallow</shallow>
      <deep>RM_AcidDeep</deep>
    </terrainSuite>
    <bottled>
      <bottle>RM_Bottle_AcidWater</bottle>
      <unitsPerBottle>1</unitsPerBottle>
    </bottled>
  </RimMandrake.FlowWorks.LiquidTypes.LiquidDef>

