    <pH>7</pH>
    <terrainSuite>
      <shallow>RM_TarShallow</shallow>
      <deep>RM_TarDeep</deep>
    </terrainSuite>
    <canalFluid>RM_Fluid_Tar</canalFluid>
    <bottled>
      <bottle>RM_Bottle_Tar</bottle>
