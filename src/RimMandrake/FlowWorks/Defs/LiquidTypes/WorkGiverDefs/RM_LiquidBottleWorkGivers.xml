<?xml version="1.0" encoding="utf-8"?>
<!--
  LIQUID_BOTTLE_LOOP_1. Hand-authored, never generated. Both WorkGivers are
  opportunistic — no Designation, no player order — mirroring vanilla's
  own automatic WorkGivers (Refuel, FillFermentingBarrel): a spawned,
  unforbidden empty/dirty container is itself the standing invitation.
  Hauling work type: this is loot management, the same skill and the same
  colonists who already carry bottles around.

  One WorkGiverDef per half of the loop covers all THREE size tiers
  (bottle/bucket/barrel, third slice) — WorkGiver_FillBottle/
  WorkGiver_WashBottle read RM_BottledLiquidExtension generically rather
  than one ThingDef per size, so no RM_FillBucketWorkGiver/
  RM_FillBarrelWorkGiver duplicate is needed.
-->
<Defs>

  <WorkGiverDef>
    <defName>RM_FillBottleWorkGiver</defName>
    <label>fill containers</label>
    <giverClass>RimMandrake.FlowWorks.LiquidTypes.WorkGiver_FillBottle</giverClass>
    <workType>Hauling</workType>
    <verb>fill</verb>
    <gerund>filling a container</gerund>
    <priorityInType>50</priorityInType>
    <scanCells>false</scanCells>
    <scanThings>true</scanThings>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>RM_WashBottleWorkGiver</defName>
    <label>wash containers</label>
    <giverClass>RimMandrake.FlowWorks.LiquidTypes.WorkGiver_WashBottle</giverClass>
    <workType>Hauling</workType>
    <verb>wash</verb>
    <gerund>washing a container</gerund>
    <priorityInType>49</priorityInType>
    <scanCells>false</scanCells>
    <scanThings>true</scanThings>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

</Defs>
