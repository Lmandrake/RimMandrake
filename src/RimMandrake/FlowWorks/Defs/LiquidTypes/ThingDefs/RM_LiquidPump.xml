<?xml version="1.0" encoding="utf-8"?>
<!--
  FLOWWORKS_BUILD_PROGRAM_1 Phase 8 - the universal pump. Draws one level per 250 ticks from
  an adjacent wet cell into a liquid tank on its net (touching it, or on a hose or pipe run to it —
  RM_LiquidNet.TanksFor), or pours from that tank into an adjacent dug channel (gizmo). Building_LiquidPump.
  Minifiable (Phase 8 slice 2): the tanker pillar's portable pump — uninstall it, carry it to a far liquid
  body with a cargo tank and a hose, pump, and fly home; a ruined works' damaged pump can be stolen the same way.
  PROVISIONAL: power 150 W, cost, work. Art: 512x512 top-down square housing, four-fold symmetric, one bolted
  flanged port centred on every side (face 232 px from centre, ~118 px bore = a rigid pipe) with alpha-0 corners
  and edge band so pipes/hoses drawn under it show to the centre; non-rotatable, so one Graphic_Single serves
  every facing (PUMP_ART_RESKIN_LESS_GARDEN_HOSE; source and composer: art_source/Pump/).
-->
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>RM_LiquidPump</defName>
    <label>liquid pump</label>
    <description>A salvaged motor driving a rotary pump in a square steel housing, with a flanged port on every side that takes a pipe or a hose from any direction. It needs power. Join it to a liquid tank (touching it, or by pipe or hose) and set it beside a pond, lake or dug channel. Drawing, it lifts liquid from the water beside it into the tank; pouring, it runs the tank's liquid into a dug channel beside it - the way to fill a channel no spring feeds, or keep a moat topped up with something that burns. It will not mix one liquid into another.</description>
    <thingClass>RimMandrake.FlowWorks.LiquidTypes.Building_LiquidPump</thingClass>
    <graphicData>
      <texPath>Things/Building/FlowWorks/Machinery/RM_LiquidPump</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.4</fillPercent>
    <pathCost>42</pathCost>
    <tickerType>Normal</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <designationCategory>Production</designationCategory>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <statBases>
      <WorkToBuild>1800</WorkToBuild>
      <MaxHitPoints>120</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <Beauty>-4</Beauty>
      <Mass>25</Mass>
    </statBases>
    <costList>
      <Steel>60</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>150</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <!-- per-build look (owner card 2026-10-22, pumps E/F/G): the engine's style field, picked on the build button through
           PipeLook (PipeStyles.PumpDef); styles in RM_LiquidPumpStyles.xml; CompTankLook is the built pump's Choose style gizmo -->
      <li Class="CompProperties_Styleable" />
      <li Class="RimMandrake.FlowWorks.Machinery.CompProperties_TankLook" />
    </comps>
    <building>
      <expandHomeArea>true</expandHomeArea>
    </building>
    <researchPrerequisites>
      <li>MoisturePump</li>
    </researchPrerequisites>
  </ThingDef>

</Defs>
