<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  RM_LiquidBottles_Base.xml         HAND-AUTHORED, never regenerated.
  ============================================================================
  LIQUID_BOTTLE_LOOP_1. The two liquid-agnostic ends of the bottle chain
  (empty / dirty) plus the shared item base and the ThingCategoryDef a future
  patch (the RSW cuisine mod, per the LiquidDef's own cuisineTags slot) can
  target to reach every bottle at once. `RM_Bottle_&lt;Liquid&gt;.xml` — one
  filled bottle per LiquidDef row that carries one — is GENERATED from
  `generate_liquid_suite.py`'s LIQUID_DEF_ROWS table and lives beside this
  file as RM_LiquidBottles.xml; edit that table, never this file, and never
  that file either.

  Chain (spec, design/RimMandrake/liquids_framework_design.md and the item's
  own notes): RM_BottleEmpty -> fill job -> RM_Bottle&lt;Liquid&gt; -> use ->
  RM_BottleDirty -> wash job -> RM_BottleEmpty. Every item in that chain
  ships, including the fill/wash WorkGiver/JobDriver pair
  (Source/LiquidTypes/WorkGiver_FillBottle.cs, JobDriver_FillBottle.cs,
  WorkGiver_WashBottle.cs, JobDriver_WashBottle.cs) and the "use" half
  (Source/LiquidTypes/IngestionOutcomeDoer_BottleResidue.cs, wired onto
  every bottled row with a thirstQuality) — reading RM_BottledLiquidExtension
  and RM_LiquidBottleUtility generically, never a per-liquid branch.

  Filling from a TANK (the design's other named source) now also ships:
  Building_LiquidTank plus WorkGiver_EmptyBottleIntoTank/JobDriver_EmptyBottleIntoTank
  (pour in) and WorkGiver_FillBottleFromTank/JobDriver_FillBottleFromTank (draw out),
  reading RM_LiquidTankUtility rather than RM_LiquidBottleUtility (which stays
  terrain-only, per its own class doc). RM_LiquidTank.xml is the v1 slice named
  in the item's own notes — a single fixed, single-liquid tank. The minifiable
  cargo tank is RM_UniversalCargoTank in Defs/Machinery/RM_LiquidLogistics.xml. A live
  quicktest of the loop (fill/drink/dirty/wash observed in-game) is OWED —
  see LIQUID_BOTTLE_LOOP_1's own notes for why this pass could not run one.

  ART (LIQUID_CONTAINERS_REDRAW_NO_MANA_POTIONS, owner 2026-10-16, sheet approved 100%; by card: material on
  the TRIM only): each size comes in the four looks (Scrapper/Industrial/Modern/Futuristic) as ThingStyleDefs in
  RM_LiquidContainerStyles.xml, art at Textures/Things/Item/Resource/FlowWorks/<Look>/RM_<Size>.png + _m mask.
  CutoutComplex: mask red = the liquid window (the LiquidDef colour, or clear glass empty, grime dirty), green =
  the trim (the material's colour), black = painted. Every liquid shares its size's four sprites.

  Buckets and barrels (the "larger bottle, same chain" siblings the item's
  spec also names): RM_BucketItemBase/RM_BucketEmpty/RM_BucketDirty and
  RM_BarrelItemBase/RM_BarrelEmpty/RM_BarrelDirty ship below, third slice.
  Each carries RM_BottledLiquidExtension.size so the SAME fill/wash
  WorkGiver/JobDriver pair and IngestionOutcomeDoer_BottleResidue handle all
  three sizes generically — no new C# class per size. Filled
  RM_Bucket_&lt;Liquid&gt;/RM_Barrel_&lt;Liquid&gt; siblings are generated
  the same way as RM_Bottle_&lt;Liquid&gt;, in RM_LiquidBottles.xml.
  Barrels carry no &lt;ingestible&gt; block — they are the bulk TRADE good
  (tradeable for free via ResourceBase, "zero patches" per the spec), not a
  food item a pawn drinks from directly. "Fill/empty bills at a tank" (the
  spec's other named barrel behavior) now ships too — RM_LiquidTank.xml,
  same as bottles/buckets, via RM_LiquidTankUtility rather than a per-size
  branch — alongside the pre-existing terrain-edge fill/wash route.
  ============================================================================
-->
<Defs>

  <ThingCategoryDef>
    <defName>RM_LiquidBottleItems</defName>
    <label>liquid containers</label>
    <parent>Manufactured</parent>
  </ThingCategoryDef>

  <!-- Shared stats for every bottle state (empty, filled, dirty). Abstract:
       never spawned itself. -->
  <ThingDef Name="RM_BottleItemBase" ParentName="ResourceBase" Abstract="True">
    <!-- LIQUID_CONTAINERS_REDRAW_NO_MANA_POTIONS: DrawColorTwo = the material, on the mask's green trim -->
    <thingClass>RimMandrake.FlowWorks.LiquidTypes.RM_LiquidContainer</thingClass>
    <tickerType>Never</tickerType>
    <graphicData>
      <!-- LIQUID_CONTAINERS_REDRAW_NO_MANA_POTIONS: an unstyled bottle draws the Industrial look; every styled one draws
           its ThingStyleDef (RM_LiquidContainerStyles.xml). CutoutComplex: mask red = liquid window, green = trim. -->
      <texPath>Things/Item/Resource/FlowWorks/Industrial/RM_Bottle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>0.75</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>40</MaxHitPoints>
      <MarketValue>1</MarketValue>
      <Mass>0.4</Mass>
      <Flammability>0.5</Flammability>
      <Beauty>-2</Beauty>
      <DeteriorationRate>2.0</DeteriorationRate>
    </statBases>
    <stackLimit>25</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <thingCategories>
      <li>RM_LiquidBottleItems</li>
    </thingCategories>
    <!-- FLOWWORKS_CONTAINER_MATERIALS_1 (owner, 2026-10-06: "Player can set
         what kinds of bottles they use (leather, glass(any stone), metal)
         depending on what they have in abundance and what crafting stations
         they have."). Every bottle state is stuffed; the material rides the
         whole chain via RM_LiquidBottleUtility.MakeContainer, and each
         material is its own recipe at its own stations
         (Defs/LiquidTypes/RecipeDefs/RM_ContainerRecipes.xml). No
         costStuffCount on purpose: the price stays the statBases value. -->
    <stuffCategories>
      <li>Leathery</li>
      <li>Stony</li>
      <li>Metallic</li>
    </stuffCategories>
    <!-- FLOWWORKS_CONTAINER_MATERIALS_1 ruling 2 (decision taken by question card
         2026-10-06 23:45): the material changes what this container holds.
         A bottle is 1.5 L (LIQUID_LITRES_MIGRATE_DRUMS_ARE_DRUMS); every factor here is 1.0. In litres any factor now changes it.
         capacityFactor multiplies the liquid's litres per container (rounded to 0.1 L, min 0.1 L);
         holdsHot=false refuses a LiquidDef with hot=true (boiling water);
         holdsAcid=false refuses an acid (corrodes apparel, AcidBurn, or pH 4 and below).
         Acid (owner typed 2026-10-07: "Actually even metal can't do acid."): glass and plasteel hold it
         (plasteel by question card 2026-10-07 00:53); leather, wood and metal refuse.
         Asserted by the FlowWorks selftest (Source/SelfTest/Program.cs). -->
    <modExtensions>
      <li Class="RimMandrake.FlowWorks.LiquidTypes.RM_ContainerMaterialsExtension">
        <materials>
          <li><material>Leather</material><capacityFactor>1.0</capacityFactor><holdsHot>false</holdsHot><holdsAcid>false</holdsAcid></li>
          <li><material>Glass</material><capacityFactor>1.0</capacityFactor><holdsHot>true</holdsHot><holdsAcid>true</holdsAcid></li>
          <li><material>Metal</material><capacityFactor>1.0</capacityFactor><holdsHot>true</holdsHot><holdsAcid>false</holdsAcid></li>
        </materials>
      </li>
    </modExtensions>
    <!-- FLOWWORKS_CONTAINER_MATERIALS_1 rulings 3+4: stone reads "glass"; a filled
         container shows its liquid's colour, an empty one its material's. -->
    <comps>
      <li>
        <compClass>RimMandrake.FlowWorks.LiquidTypes.RM_CompContainerMaterial</compClass>
      </li>
      <!-- LIQUID_CONTAINERS_REDRAW_NO_MANA_POTIONS: CompStyleable stores the look; RM_CompContainerStyle keeps looks
           apart in stacks, carries the look through a split and gives an unstyled one its faction's look -->
      <li Class="CompProperties_Styleable" />
      <li>
        <compClass>RimMandrake.FlowWorks.LiquidTypes.RM_CompContainerStyle</compClass>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="RM_BottleItemBase">
    <defName>RM_BottleEmpty</defName>
    <label>empty bottle</label>
    <description>A bottle, empty and ready to fill: stitched leather, glass melted down from stone, or hammered metal, whichever its maker had to hand. Nests inside itself for hauling, so a stack of these takes up almost no room.</description>
    <stackLimit>75</stackLimit>
    <statBases>
      <MarketValue>0.5</MarketValue>
      <Mass>0.15</Mass>
    </statBases>
    <modExtensions>
      <li Class="RimMandrake.FlowWorks.LiquidTypes.RM_BottledLiquidExtension" />
    </modExtensions>
  </ThingDef>

  <!-- Liquid-agnostic on purpose — whatever was in it, once it's used the
       residue is the same problem: a bottle that needs washing. Never
       generated per-row; one def covers the whole roster. -->
  <ThingDef ParentName="RM_BottleItemBase">
    <defName>RM_BottleDirty</defName>
    <label>dirty bottle</label>
    <description>An emptied bottle, still carrying whatever residue its last contents left behind. Needs washing before it's fit to fill again.</description>
    <modExtensions>
      <li Class="RimMandrake.FlowWorks.LiquidTypes.RM_BottledLiquidExtension">
        <dirty>true</dirty>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- Bucket family: 5-unit sibling, same chain. -->

  <ThingDef Name="RM_BucketItemBase" ParentName="ResourceBase" Abstract="True">
    <!-- LIQUID_CONTAINERS_REDRAW_NO_MANA_POTIONS: DrawColorTwo = the material, on the mask's green trim -->
    <thingClass>RimMandrake.FlowWorks.LiquidTypes.RM_LiquidContainer</thingClass>
    <tickerType>Never</tickerType>
    <graphicData>
      <!-- LIQUID_CONTAINERS_REDRAW_NO_MANA_POTIONS: an unstyled bucket draws the Industrial look; every styled one draws
           its ThingStyleDef (RM_LiquidContainerStyles.xml). CutoutComplex: mask red = liquid window, green = trim. -->
      <texPath>Things/Item/Resource/FlowWorks/Industrial/RM_Bucket</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>1.0</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>55</MaxHitPoints>
      <MarketValue>4</MarketValue>
      <Mass>2.0</Mass>
      <Flammability>0.5</Flammability>
      <Beauty>-3</Beauty>
      <DeteriorationRate>2.0</DeteriorationRate>
    </statBases>
    <stackLimit>10</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <thingCategories>
      <li>RM_LiquidBottleItems</li>
    </thingCategories>
    <!-- FLOWWORKS_CONTAINER_MATERIALS_1, buckets (decision taken by question
         card 2026-10-06 23:45): wood, metal or leather, each its own recipe
         at its own stations. -->
    <stuffCategories>
      <li>Woody</li>
      <li>Metallic</li>
      <li>Leathery</li>
    </stuffCategories>
    <!-- FLOWWORKS_CONTAINER_MATERIALS_1 ruling 2 (decision taken by question card
         2026-10-06 23:45): the material changes what this container holds.
         Bucket base 15 L: wood 15 L, metal 18 L, leather 12 L. Wood refuses acid but holds hot (card 2026-10-07 00:04).
         capacityFactor multiplies the liquid's litres per container (rounded to 0.1 L, min 0.1 L);
         holdsHot=false refuses a LiquidDef with hot=true (boiling water);
         holdsAcid=false refuses an acid (corrodes apparel, AcidBurn, or pH 4 and below).
         Acid (owner typed 2026-10-07: "Actually even metal can't do acid."): glass and plasteel hold it
         (plasteel by question card 2026-10-07 00:53); leather, wood and metal refuse.
         Asserted by the FlowWorks selftest (Source/SelfTest/Program.cs). -->
    <modExtensions>
      <li Class="RimMandrake.FlowWorks.LiquidTypes.RM_ContainerMaterialsExtension">
        <materials>
          <li><material>Wood</material><capacityFactor>1.0</capacityFactor><holdsHot>true</holdsHot><holdsAcid>false</holdsAcid></li>
          <li><material>Metal</material><capacityFactor>1.2</capacityFactor><holdsHot>true</holdsHot><holdsAcid>false</holdsAcid></li>
          <li><material>Leather</material><capacityFactor>0.8</capacityFactor><holdsHot>false</holdsHot><holdsAcid>false</holdsAcid></li>
        </materials>
      </li>
    </modExtensions>
    <!-- FLOWWORKS_CONTAINER_MATERIALS_1 rulings 3+4: stone reads "glass"; a filled
         container shows its liquid's colour, an empty one its material's. -->
    <comps>
      <li>
        <compClass>RimMandrake.FlowWorks.LiquidTypes.RM_CompContainerMaterial</compClass>
      </li>
      <!-- LIQUID_CONTAINERS_REDRAW_NO_MANA_POTIONS: CompStyleable stores the look; RM_CompContainerStyle keeps looks
           apart in stacks, carries the look through a split and gives an unstyled one its faction's look -->
      <li Class="CompProperties_Styleable" />
      <li>
        <compClass>RimMandrake.FlowWorks.LiquidTypes.RM_CompContainerStyle</compClass>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="RM_BucketItemBase">
    <defName>RM_BucketEmpty</defName>
    <label>empty bucket</label>
    <description>A bucket of wood, metal or stitched leather, empty and ready to fill. Five bottles' worth in one haul.</description>
    <stackLimit>25</stackLimit>
    <statBases>
      <MarketValue>2</MarketValue>
      <Mass>0.8</Mass>
    </statBases>
    <modExtensions>
      <li Class="RimMandrake.FlowWorks.LiquidTypes.RM_BottledLiquidExtension">
        <size>Bucket</size>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="RM_BucketItemBase">
    <defName>RM_BucketDirty</defName>
    <label>dirty bucket</label>
    <description>An emptied bucket, still carrying whatever residue its last contents left behind. Needs washing before it's fit to fill again.</description>
    <modExtensions>
      <li Class="RimMandrake.FlowWorks.LiquidTypes.RM_BottledLiquidExtension">
        <dirty>true</dirty>
        <size>Bucket</size>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- Barrel family: ~25-unit bulk/trade sibling, "very scavenger" (owner-
       ruled 2026-09-13). No ingestible block on ANY barrel, generated or
       hand-authored — see this file's own module comment for why.
       Tradeable for free via ResourceBase inheritance. -->

  <ThingDef Name="RM_BarrelItemBase" ParentName="ResourceBase" Abstract="True">
    <!-- LIQUID_CONTAINERS_REDRAW_NO_MANA_POTIONS: DrawColorTwo = the material, on the mask's green trim -->
    <thingClass>RimMandrake.FlowWorks.LiquidTypes.RM_LiquidContainer</thingClass>
    <tickerType>Never</tickerType>
    <graphicData>
      <!-- LIQUID_CONTAINERS_REDRAW_NO_MANA_POTIONS: an unstyled barrel draws the Industrial look; every styled one draws
           its ThingStyleDef (RM_LiquidContainerStyles.xml). CutoutComplex: mask red = liquid window, green = trim. -->
      <texPath>Things/Item/Resource/FlowWorks/Industrial/RM_Barrel</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>1.4</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <MarketValue>15</MarketValue>
      <Mass>8.0</Mass>
      <Flammability>0.5</Flammability>
      <Beauty>-4</Beauty>
      <DeteriorationRate>2.0</DeteriorationRate>
    </statBases>
    <stackLimit>4</stackLimit>
    <healthAffectsPrice>false</healthAffectsPrice>
    <thingCategories>
      <li>RM_LiquidBottleItems</li>
    </thingCategories>
    <!-- FLOWWORKS_CONTAINER_MATERIALS_1 (owner, 2026-10-06: "Barrels are like
         this too: wooden, metal, plasteel"). Plasteel is Metallic stuff; its
         own recipe puts it at the machining/fabrication benches. -->
    <stuffCategories>
      <li>Woody</li>
      <li>Metallic</li>
    </stuffCategories>
    <!-- FLOWWORKS_CONTAINER_MATERIALS_1 ruling 2 (decision taken by question card
         2026-10-06 23:45): the material changes what this container holds.
         Barrel base 208 L (a 55-gallon drum): wood 208 L, metal 250 L, plasteel 333 L. Wood refuses acid but holds hot (card 2026-10-07 00:04).
         capacityFactor multiplies the liquid's litres per container (rounded to 0.1 L, min 0.1 L);
         holdsHot=false refuses a LiquidDef with hot=true (boiling water);
         holdsAcid=false refuses an acid (corrodes apparel, AcidBurn, or pH 4 and below).
         Acid (owner typed 2026-10-07: "Actually even metal can't do acid."): glass and plasteel hold it
         (plasteel by question card 2026-10-07 00:53); leather, wood and metal refuse.
         Asserted by the FlowWorks selftest (Source/SelfTest/Program.cs). -->
    <modExtensions>
      <li Class="RimMandrake.FlowWorks.LiquidTypes.RM_ContainerMaterialsExtension">
        <materials>
          <li><material>Wood</material><capacityFactor>1.0</capacityFactor><holdsHot>true</holdsHot><holdsAcid>false</holdsAcid></li>
          <li><material>Metal</material><capacityFactor>1.2</capacityFactor><holdsHot>true</holdsHot><holdsAcid>false</holdsAcid></li>
          <li><material>Plasteel</material><capacityFactor>1.6</capacityFactor><holdsHot>true</holdsHot><holdsAcid>true</holdsAcid></li>
        </materials>
      </li>
    </modExtensions>
    <!-- FLOWWORKS_CONTAINER_MATERIALS_1 rulings 3+4: stone reads "glass"; a filled
         container shows its liquid's colour, an empty one its material's. -->
    <comps>
      <li>
        <compClass>RimMandrake.FlowWorks.LiquidTypes.RM_CompContainerMaterial</compClass>
      </li>
      <!-- LIQUID_CONTAINERS_REDRAW_NO_MANA_POTIONS: CompStyleable stores the look; RM_CompContainerStyle keeps looks
           apart in stacks, carries the look through a split and gives an unstyled one its faction's look -->
      <li Class="CompProperties_Styleable" />
      <li>
        <compClass>RimMandrake.FlowWorks.LiquidTypes.RM_CompContainerStyle</compClass>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="RM_BarrelItemBase">
    <defName>RM_BarrelEmpty</defName>
    <label>empty barrel</label>
    <description>A barrel of wood, metal or plasteel, empty and ready to fill. Twenty-five bottles' worth, bulk enough to actually trade.</description>
    <stackLimit>10</stackLimit>
    <statBases>
      <MarketValue>6</MarketValue>
      <Mass>3.0</Mass>
    </statBases>
    <modExtensions>
      <li Class="RimMandrake.FlowWorks.LiquidTypes.RM_BottledLiquidExtension">
        <size>Barrel</size>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="RM_BarrelItemBase">
    <defName>RM_BarrelDirty</defName>
    <label>dirty barrel</label>
    <description>An emptied barrel, still carrying whatever residue its last contents left behind. Needs washing before it's fit to fill again.</description>
    <modExtensions>
      <li Class="RimMandrake.FlowWorks.LiquidTypes.RM_BottledLiquidExtension">
        <dirty>true</dirty>
        <size>Barrel</size>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
