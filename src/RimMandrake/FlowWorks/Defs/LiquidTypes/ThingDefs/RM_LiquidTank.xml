<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  RM_LiquidTank.xml
  ============================================================================
  LIQUID_BOTTLE_LOOP_1, the tank half (design §4/§9: "fill/empty bills at a
  tank"). A real player-buildable Building carrying a single stored LiquidDef
  and a unit count (Building_LiquidTank, Source/LiquidTypes/), filled and
  drained by the SAME fill/wash chain bottles/buckets/barrels already use:
  see WorkGiver_EmptyBottleIntoTank/JobDriver_EmptyBottleIntoTank (pour in)
  and WorkGiver_FillBottleFromTank/JobDriver_FillBottleFromTank (draw out).

  Deliberately the v1 slice the item's own notes name: "a real ThingDef
  (building... big fixed liquid store)". This tank holds exactly one liquid
  at a time and is fixed (not minifiable). Pumps, pipe adapters and
  converters fill and drain it over the liquid net (RM_LiquidNet); the
  minifiable cargo tank is RM_UniversalCargoTank (Defs/Machinery/RM_LiquidLogistics.xml).

  Art (TANK_TALL_BUILD_TWICE_THE_DRINK, owner 2026-10-14): four looks per tank,
  the same four as Gimme Some Slack, as ThingStyleDefs in RM_LiquidTankStyles.xml;
  textures Textures/RimMandrake/FlowWorks/Tank/<Look>/<Tank>.png, drawn from the
  measured building camera (design/RimMandrake/building_camera_perspective_2026-10-14.md),
  sources art_source/TankTall/v3/. The base texPath is the Scrapper look, which an
  unstyled tank also draws.
  ============================================================================
-->
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>RM_LiquidTank</defName>
    <label>liquid tank</label>
    <description>A squat liquid tank on a skid frame, its valve cluster on top; pick its look on the build button. Holds a real quantity of one liquid at a time: pour a filled bottle, bucket or barrel in to top it up, or fill an empty one from its stock. It does not care which liquid, as long as it is not already holding a different one. Its Job button decides what it does on its pipes and hoses: Store, Fill (pull from the other tanks), Empty (send to them) or Dump.</description>
    <thingClass>RimMandrake.FlowWorks.LiquidTypes.Building_LiquidTank</thingClass>
    <graphicData>
      <texPath>RimMandrake/FlowWorks/Tank/Scrapper/RM_LiquidTank</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <size>(2,2)</size>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>1.0</fillPercent>
    <pathCost>50</pathCost>
    <useHitPoints>true</useHitPoints>
    <selectable>true</selectable>
    <neverMultiSelect>false</neverMultiSelect>
    <designationCategory>VCHE_PipeNetworks</designationCategory>   <!-- ruling #4: tanks go where the pipe mods' tanks go -->
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <statBases>
      <WorkToBuild>3200</WorkToBuild>
      <MaxHitPoints>220</MaxHitPoints>
      <Flammability>0.3</Flammability>
      <Beauty>-6</Beauty>
      <Mass>60</Mass>
    </statBases>
    <costList>
      <Steel>150</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <building>
      <expandHomeArea>true</expandHomeArea>
    </building>
    <comps>
      <!-- per-build look, the same four as Gimme Some Slack (owner 2026-10-14): the engine's style field, picked on the
           build button through PipeLook (PipeStyles.TankDefs); styles in RM_LiquidTankStyles.xml. CompTankLook is the
           built tank's "Choose style" gizmo (owner 2026-10-16) -->
      <li Class="CompProperties_Styleable" />
      <li Class="RimMandrake.FlowWorks.Machinery.CompProperties_TankLook" />
    </comps>
  </ThingDef>

  <!-- TANK_TALL_BUILD_TWICE_THE_DRINK (owner 2026-10-13: "Make tall tanks too that double the storage"). Same 2x2 footprint,
       tall=true => 32 kL (Building_LiquidTank.Capacity doubles a tall tank). Cost ~1.9x steel / 1.7x components, work 1.8x:
       the hull stands upright at ~1.7x height, so material roughly doubles with a small saving on shared frame. Art: four looks,
       art_source/TankTall/v3, 512x768 for drawSize (2,3). -->
  <ThingDef ParentName="BuildingBase">
    <defName>RM_LiquidTankTall</defName>
    <label>tall liquid tank</label>
    <description>The liquid tank stood upright and built tall: the same footprint, twice the drink. Holds a real quantity of one liquid at a time: pour a filled bottle, bucket or barrel in to top it up, or fill an empty one from its stock. It does not care which liquid, as long as it is not already holding a different one. Its Job button decides what it does on its pipes and hoses: Store, Fill (pull from the other tanks), Empty (send to them) or Dump.</description>
    <thingClass>RimMandrake.FlowWorks.LiquidTypes.Building_LiquidTank</thingClass>
    <graphicData>
      <texPath>RimMandrake/FlowWorks/Tank/Scrapper/RM_LiquidTankTall</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,3)</drawSize>
      <drawOffset>(0,0,0.5)</drawOffset>
    </graphicData>
    <size>(2,2)</size>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>1.0</fillPercent>
    <pathCost>50</pathCost>
    <useHitPoints>true</useHitPoints>
    <selectable>true</selectable>
    <neverMultiSelect>false</neverMultiSelect>
    <designationCategory>VCHE_PipeNetworks</designationCategory>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    <statBases>
      <WorkToBuild>5800</WorkToBuild>
      <MaxHitPoints>320</MaxHitPoints>
      <Flammability>0.3</Flammability>
      <Beauty>-6</Beauty>
      <Mass>110</Mass>
    </statBases>
    <costList>
      <Steel>285</Steel>
      <ComponentIndustrial>5</ComponentIndustrial>
    </costList>
    <building>
      <expandHomeArea>true</expandHomeArea>
    </building>
    <comps>
      <!-- per-build look, the same four as Gimme Some Slack (owner 2026-10-14): the engine's style field, picked on the
           build button through PipeLook (PipeStyles.TankDefs); styles in RM_LiquidTankStyles.xml. CompTankLook is the
           built tank's "Choose style" gizmo (owner 2026-10-16) -->
      <li Class="CompProperties_Styleable" />
      <li Class="RimMandrake.FlowWorks.Machinery.CompProperties_TankLook" />
    </comps>
    <modExtensions>
      <li Class="RimMandrake.FlowWorks.LiquidTypes.RM_LiquidTankExtension">
        <tall>true</tall>   <!-- 2x2 tall = 32 kL -->
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
