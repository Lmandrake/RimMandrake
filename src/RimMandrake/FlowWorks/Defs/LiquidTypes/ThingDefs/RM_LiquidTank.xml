<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  RM_LiquidTank.xml
  ============================================================================
  LIQUID_BOTTLE_LOOP_1, the tank half (design §4/§9: "fill/empty bills at a
  tank"). A real player-buildable Building carrying a single stored LiquidDef
  and a unit count (Building_LiquidTank, Source/LiquidTypes/), filled and
  drained by the SAME fill/wash chain bottles/buckets/barrels already use:
  see WorkGiver_EmptyBottleIntoTank/JobDriver_EmptyBottleIntoTank (pour in)
  and WorkGiver_FillBottleFromTank/JobDriver_FillBottleFromTank (draw out).

  Deliberately the v1 slice the item's own notes name: "a real ThingDef
  (building... big fixed liquid store)". This tank holds exactly one liquid
  at a time and is fixed (not minifiable). Pumps, pipe adapters and
  converters fill and drain it over the liquid net (RM_LiquidNet); the
  minifiable cargo tank is RM_UniversalCargoTank (Defs/Machinery/RM_LiquidLogistics.xml).

  Art: src/RimMandrake/FlowWorks/art_source/UniversalCargoTank/ concept
  (2026-09-18), conformed via conform_sprite.py onto a 256x256 canvas
  (drawSize 2.0 x 128 px/cell, matching the 2x2 footprint) rather than
  regenerated from scratch. Reference for canvas + subject proportion was a
  synthetic centred bbox, not an existing building; there is no prior real
  texture of this thing to match a pose against; the reference only sets
  canvas size and roughly-centred placement, per conform_sprite.py's own
  contract (it registers by mask overlap, not by matching content).
  ============================================================================
-->
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>RM_LiquidTank</defName>
    <label>liquid tank</label>
    <description>A patched-together scavenger tank -- mismatched steel panels hammered into one hull, with a scavenged valve cluster bolted on wherever there was room. Holds a real quantity of one liquid at a time: pour a filled bottle, bucket or barrel in to top it up, or fill an empty one from its stock. It does not care which liquid, as long as it is not already holding a different one.</description>
    <thingClass>RimMandrake.FlowWorks.LiquidTypes.Building_LiquidTank</thingClass>
    <graphicData>
      <texPath>Things/Building/FlowWorks/RM_LiquidTank</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <size>(2,2)</size>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>1.0</fillPercent>
    <pathCost>50</pathCost>
    <useHitPoints>true</useHitPoints>
    <selectable>true</selectable>
    <neverMultiSelect>false</neverMultiSelect>
    <designationCategory>VCHE_PipeNetworks</designationCategory>   <!-- ruling #4: tanks go where the pipe mods' tanks go -->
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <statBases>
      <WorkToBuild>3200</WorkToBuild>
      <MaxHitPoints>220</MaxHitPoints>
      <Flammability>0.3</Flammability>
      <Beauty>-6</Beauty>
      <Mass>60</Mass>
    </statBases>
    <costList>
      <Steel>150</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <building>
      <expandHomeArea>true</expandHomeArea>
    </building>
    <comps>
      <!-- per-build look, the same four as Gimme Some Slack (owner 2026-10-14): the engine's style field; the picker
           (PipeLook, PipeStyles.TankDefs) joins once RM_LiquidTankStyles.xml and the tank art are installed -->
      <li Class="CompProperties_Styleable" />
    </comps>
  </ThingDef>

  <!-- TANK_TALL_BUILD_TWICE_THE_DRINK (owner 2026-10-13: "Make tall tanks too that double the storage"). Same 2x2 footprint,
       tall=true => 160 units (Building_LiquidTank.Capacity doubles a tall tank). Cost ~1.9x steel / 1.7x components, work 1.8x:
       the hull stands upright at ~1.7x height, so material roughly doubles with a small saving on shared frame. Art: painted upright
       hull (codex edit of RM_LiquidTank), master + fit_tall.py in art_source/TankTall, 512x768 for drawSize (2,3). -->
  <ThingDef ParentName="BuildingBase">
    <defName>RM_LiquidTankTall</defName>
    <label>tall liquid tank</label>
    <description>The scavenger tank stood upright and built tall: the same footprint, twice the drink. Holds a real quantity of one liquid at a time: pour a filled bottle, bucket or barrel in to top it up, or fill an empty one from its stock. It does not care which liquid, as long as it is not already holding a different one.</description>
    <thingClass>RimMandrake.FlowWorks.LiquidTypes.Building_LiquidTank</thingClass>
    <graphicData>
      <texPath>Things/Building/FlowWorks/RM_LiquidTankTall</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,3)</drawSize>
      <drawOffset>(0,0,0.5)</drawOffset>
    </graphicData>
    <size>(2,2)</size>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>1.0</fillPercent>
    <pathCost>50</pathCost>
    <useHitPoints>true</useHitPoints>
    <selectable>true</selectable>
    <neverMultiSelect>false</neverMultiSelect>
    <designationCategory>VCHE_PipeNetworks</designationCategory>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    <statBases>
      <WorkToBuild>5800</WorkToBuild>
      <MaxHitPoints>320</MaxHitPoints>
      <Flammability>0.3</Flammability>
      <Beauty>-6</Beauty>
      <Mass>110</Mass>
    </statBases>
    <costList>
      <Steel>285</Steel>
      <ComponentIndustrial>5</ComponentIndustrial>
    </costList>
    <building>
      <expandHomeArea>true</expandHomeArea>
    </building>
    <comps>
      <!-- per-build look, the same four as Gimme Some Slack (owner 2026-10-14): the engine's style field; the picker
           (PipeLook, PipeStyles.TankDefs) joins once RM_LiquidTankStyles.xml and the tank art are installed -->
      <li Class="CompProperties_Styleable" />
    </comps>
    <modExtensions>
      <li Class="RimMandrake.FlowWorks.LiquidTypes.RM_LiquidTankExtension">
        <tall>true</tall>   <!-- 2x2 tall = 160 units -->
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
