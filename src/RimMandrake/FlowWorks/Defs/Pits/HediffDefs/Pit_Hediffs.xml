<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Exposure in an open pit. KEPT by ruling [H] of the unified pit model
       (design/RimMandrake/flowworks_pits_unified_model_2026-10-02.md 3.7):
       REWIRE pending in PIT_TEMPERATURE_SOFTENING_1 - its writer becomes the
       temperature accumulator, its effect lowered resistance. Nothing writes
       it since the pit cell building retired (PIT_LEGACY_CODE_RETIRE_1).
       Placeholder rate/stages. -->
  <HediffDef>
    <defName>RM_PitExposure</defName>
    <label>pit exposure</label>
    <description>Open to the sky in the bottom of a pit, with no shade and no cover. The sun does the rest.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9, 0.6, 0.2)</defaultLabelColor>
    <maxSeverity>1.0</maxSeverity>
    <stages>
      <li>
        <label>exposed</label>
        <painOffset>0.05</painOffset>
      </li>
      <li>
        <minSeverity>0.4</minSeverity>
        <label>heatstruck</label>
        <painOffset>0.15</painOffset>
        <hediffGivers>
          <li Class="HediffGiver_Random">
            <hediff>Heatstroke</hediff>
            <mtbDays>1</mtbDays>
          </li>
        </hediffGivers>
      </li>
    </stages>
  </HediffDef>

  <!-- Drowning clock: "swimming things tread until exhausted; air-breathers
       drown if left." REWIRE pending in PIT_FILL_EFFECTS_1: keyed to fill
       (F > 0) at D=4 instead of the retired Water fitting; nothing writes it
       until then. No vanilla drowning hediff exists to reuse. Severity IS the
       damage/exhaustion signal. -->
  <HediffDef>
    <defName>RM_PitDrowning</defName>
    <label>drowning</label>
    <description>Treading water in a flooded pit with no way out and no air to spare.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.3, 0.5, 0.9)</defaultLabelColor>
    <lethalSeverity>1.0</lethalSeverity>
    <stages>
      <li>
        <label>treading water</label>
        <painOffset>0.1</painOffset>
      </li>
      <li>
        <minSeverity>0.6</minSeverity>
        <label>exhausted</label>
        <painOffset>0.3</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.3</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
