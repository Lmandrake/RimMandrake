<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Exposure in an open pit (PIT_TEMPERATURE_SOFTENING_1). Written by RM_PitExposure.Tick (Source/RM_PitExposure.cs):
       severity rises while a pawn stands on an unroofed, uncovered D=4 cell and ebbs once it is out. Placeholder
       rate/stages. -->
  <HediffDef>
    <defName>RM_PitExposure</defName>
    <label>pit exposure</label>
    <description>Open to the sky in the bottom of a pit, with no shade and no cover. The sun does the rest.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9, 0.6, 0.2)</defaultLabelColor>
    <maxSeverity>1.0</maxSeverity>
    <stages>
      <li>
        <label>exposed</label>
        <painOffset>0.05</painOffset>
      </li>
      <li>
        <minSeverity>0.4</minSeverity>
        <label>heatstruck</label>
        <painOffset>0.15</painOffset>
        <hediffGivers>
          <li Class="HediffGiver_Random">
            <hediff>Heatstroke</hediff>
            <mtbDays>1</mtbDays>
          </li>
        </hediffGivers>
      </li>
    </stages>
  </HediffDef>

  <!-- Drowning clock (PIT_FILL_EFFECTS_1): RM_PitFillEffects raises it while a non-swimmer stands in any
       fluid on a D=4 cell, keyed to fill (about one in-game hour at brim, PROVISIONAL). No vanilla drowning
       hediff exists to reuse. The severityPerDay comp lets it ebb once the pawn is out (PROVISIONAL -4/day). -->
  <HediffDef>
    <defName>RM_PitDrowning</defName>
    <label>drowning</label>
    <description>Treading water in a flooded pit with no way out and no air to spare.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.3, 0.5, 0.9)</defaultLabelColor>
    <lethalSeverity>1.0</lethalSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-4</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>treading water</label>
        <painOffset>0.1</painOffset>
      </li>
      <li>
        <minSeverity>0.6</minSeverity>
        <label>exhausted</label>
        <painOffset>0.3</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.3</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
