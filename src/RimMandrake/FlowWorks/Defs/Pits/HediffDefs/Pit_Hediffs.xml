<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Exposure in an open pit (PIT_TEMPERATURE_SOFTENING_1, redesigned 2026-10-11: "exposed to the elements" on vanilla's
       own temperature path, design/RimMandrake/pit_exposure_to_the_elements_2026-10-11.md). A flat marker, present while
       RM_PitExposure.Tick (Source/RM_PitExposure.cs) finds the pawn on an unroofed, uncovered D=4 cell and removed when
       not. Its one stage narrows the comfortable temperature range: the 8/-8 here are the owner's Q1 default (8 C each
       way) and are overwritten from the Mod Setting pitExposureNarrowing every 250 ticks. Vanilla Heatstroke and
       Hypothermia then start that much sooner; nothing else harms. The marker comp removes it off the map or with the
       setting off. -->
  <HediffDef>
    <defName>RM_PitExposure</defName>
    <label>pit exposure</label>
    <description>Open to the sky in the bottom of a pit, with no shade, no shelter and no windbreak. Heat and cold reach them sooner than anyone free to move about.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9, 0.6, 0.2)</defaultLabelColor>
    <comps>
      <li Class="RimMandrake.FlowWorks.HediffCompProperties_PitExposureMarker" />
    </comps>
    <stages>
      <li>
        <label>exposed</label>
        <statOffsets>
          <ComfyTemperatureMin>8</ComfyTemperatureMin>
          <ComfyTemperatureMax>-8</ComfyTemperatureMax>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- Drowning clock (PIT_FILL_EFFECTS_1): RM_PitFillEffects raises it while a non-swimmer stands in any
       fluid on a D=4 cell, keyed to fill (about one in-game hour at brim, PROVISIONAL). No vanilla drowning
       hediff exists to reuse. The severityPerDay comp lets it ebb once the pawn is out (PROVISIONAL -4/day). -->
  <HediffDef>
    <defName>RM_PitDrowning</defName>
    <label>drowning</label>
    <description>Treading water in a flooded pit with no way out and no air to spare.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.3, 0.5, 0.9)</defaultLabelColor>
    <lethalSeverity>1.0</lethalSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-4</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>treading water</label>
        <painOffset>0.1</painOffset>
      </li>
      <li>
        <minSeverity>0.6</minSeverity>
        <label>exhausted</label>
        <painOffset>0.3</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.3</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
