<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- DRAWBRIDGE_BUILD_MOAT_WITH_MANNERS phase 3 (design/RimMandrake/flowworks_drawbridge_design_2026-10-20.md R2,
       owner follow-ups 2026-10-20): the winch house of one drawbridge leaf, built beside the leaf's hinge anchor on its own
       bank. PLACEHOLDER ART: the anchor's own texture until the commissioned drawbridge art lands (its texPaths will be in the
       design doc's art section); no drawbridge art is generated or queued here. Costs are proposals. -->

  <ThingDef ParentName="BuildingBase">
    <defName>RM_DrawbridgeWinch_Timber</defName>
    <label>timber drawbridge winch house</label>
    <description>The hand winch that raises and lowers one leaf of a timber drawbridge. Build it beside the anchor the leaf is hinged on. A colonist turns it to raise or lower the leaf. If it is destroyed while the leaf is up, the leaf crashes down on anything beneath it.</description>
    <thingClass>RimMandrake.FlowWorks.Pits.Building_DrawbridgeWinch</thingClass>
    <graphicData>
      <texPath>Things/Building/FlowWorks/SuspensionBridge/RM_SuspensionAnchor_Timber</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.5</fillPercent>
    <pathCost>30</pathCost>
    <rotatable>true</rotatable>
    <selectable>true</selectable>
    <hasInteractionCell>false</hasInteractionCell>
    <tickerType>Never</tickerType>
    <drawerType>MapMeshAndRealTime</drawerType>
    <designationCategory>Structure</designationCategory>
    <costList>
      <WoodLog>60</WoodLog>
    </costList>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>1200</WorkToBuild>
      <Flammability>1.0</Flammability>
    </statBases>
    <building>
      <expandHomeArea>false</expandHomeArea>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <modExtensions>
      <li Class="RimMandrake.FlowWorks.Pits.RM_DrawbridgeExtension">
        <tier>Timber</tier>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>RM_DrawbridgeWinch_Steel</defName>
    <label>steel drawbridge winch house</label>
    <description>The powered winch that raises and lowers one leaf of a steel drawbridge. Build it beside the anchor the leaf is hinged on and connect it to power. A colonist throws its lever; the motor does the rest. Without power the leaf stops where it is. If it is destroyed while the leaf is up, the leaf crashes down on anything beneath it.</description>
    <thingClass>RimMandrake.FlowWorks.Pits.Building_DrawbridgeWinch</thingClass>
    <graphicData>
      <texPath>Things/Building/FlowWorks/SuspensionBridge/RM_SuspensionAnchor_Steel</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.5</fillPercent>
    <pathCost>30</pathCost>
    <rotatable>true</rotatable>
    <selectable>true</selectable>
    <hasInteractionCell>false</hasInteractionCell>
    <tickerType>Normal</tickerType>
    <drawerType>MapMeshAndRealTime</drawerType>
    <designationCategory>Structure</designationCategory>
    <costList>
      <Steel>80</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>1800</WorkToBuild>
      <Flammability>0.2</Flammability>
    </statBases>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>150</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
    </comps>
    <building>
      <expandHomeArea>false</expandHomeArea>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <researchPrerequisites>
      <li>Electricity</li>
    </researchPrerequisites>
    <modExtensions>
      <li Class="RimMandrake.FlowWorks.Pits.RM_DrawbridgeExtension">
        <tier>Steel</tier>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- DRAWBRIDGE phase 6 (R7): the gate leaf, built in the wall line beside a leaf's hinge anchor (one per lane). PLACEHOLDER
       ART: the vanilla simple door until RM_DrawbridgeGate_<M>_Closed/_Open pass review (design doc art contract). -->
  <ThingDef ParentName="DoorBase">
    <defName>RM_DrawbridgeGate</defName>
    <label>drawbridge gate</label>
    <description>A heavy gate for the bank end of a drawbridge. In peacetime it opens for your people like a door. While hostiles are free on the map it stays shut unless you hold it open, and it never opens while its drawbridge leaf is raised. Build it beside the anchor the leaf is hinged on.</description>
    <thingClass>RimMandrake.FlowWorks.Pits.Building_DrawbridgeGate</thingClass>
    <graphicData>
      <texPath>Things/Building/Door/DoorSimple_Mover</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <uiIconPath>Things/Building/Door/DoorSimple_MenuIcon</uiIconPath>
    <stuffCategories>
      <li>Woody</li>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>40</costStuffCount>
    <statBases>
      <WorkToBuild>1400</WorkToBuild>
      <MaxHitPoints>260</MaxHitPoints>
    </statBases>
    <designationCategory>Structure</designationCategory>
  </ThingDef>

  <JobDef>
    <defName>RM_WorkDrawbridge</defName>
    <driverClass>RimMandrake.FlowWorks.Pits.JobDriver_WorkDrawbridge</driverClass>
    <reportString>working the drawbridge at TargetA.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

  <!-- Same work type as flicking a switch (BasicWorker): working a drawbridge is an order the player gave. -->
  <WorkGiverDef>
    <defName>RM_WorkDrawbridgeGiver</defName>
    <label>work drawbridges</label>
    <giverClass>RimMandrake.FlowWorks.Pits.WorkGiver_Drawbridge</giverClass>
    <workType>BasicWorker</workType>
    <verb>work</verb>
    <gerund>working a drawbridge</gerund>
    <priorityInType>110</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <!-- DRAWBRIDGE phase 4 (R5): a raider's plank. The carried plank draws its own picture (owner pick, bridge_art_redraw
       sheet 2026-10-21). The LAID plank still draws the timber deck atlas: RM_RaidPlank_Laid/_LaidEnd are installed but need
       a draw change (per-cell rotation, bank ends) before a def can use them. -->
  <ThingDef ParentName="ResourceBase">
    <defName>RM_RaidPlank</defName>
    <label>raid plank</label>
    <description>A long plank raiders carry to lay across a moat.</description>
    <graphicData>
      <texPath>Things/Building/FlowWorks/Drawbridge/RM_RaidPlank</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>1</stackLimit>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <MarketValue>6</MarketValue>
      <Mass>8</Mass>
      <Flammability>1.0</Flammability>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <tradeability>None</tradeability>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>RM_RaidPlank_Laid</defName>
    <label>raid plank</label>
    <description>A plank raiders laid across the moat. It holds one or two people at a time; it burns and breaks like a light bridge.</description>
    <thingClass>RimMandrake.FlowWorks.Pits.Building_SuspensionDeck</thingClass>
    <graphicData>
      <texPath>Things/Building/FlowWorks/SuspensionBridge/RM_SuspensionDeck_Timber_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <linkType>Basic</linkType>
    </graphicData>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>Standable</passability>
    <fillPercent>0</fillPercent>
    <pathCost>8</pathCost>
    <rotatable>true</rotatable>
    <selectable>true</selectable>
    <tickerType>Never</tickerType>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Beauty>-2</Beauty>
    </statBases>
    <building>
      <isEdifice>false</isEdifice>
      <expandHomeArea>false</expandHomeArea>
      <ai_chillDestination>false</ai_chillDestination>
      <claimable>false</claimable>
    </building>
    <modExtensions>
      <li Class="RimMandrake.FlowWorks.Pits.RM_SuspensionExtension">
        <tier>Timber</tier>
      </li>
    </modExtensions>
  </ThingDef>

  <JobDef>
    <defName>RM_LayRaidPlank</defName>
    <driverClass>RimMandrake.FlowWorks.Pits.JobDriver_RM_LayRaidPlank</driverClass>
    <reportString>laying a plank across the moat.</reportString>
  </JobDef>

</Defs>
