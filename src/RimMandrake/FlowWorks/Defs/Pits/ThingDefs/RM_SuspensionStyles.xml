<!-- SUSPENSION_ART_RESKIN_HE_SEES_FIRST: the suspension bridge parts in the four looks (Scrapper, Industrial, Modern, Futuristic;
     design/RimMandrake/liquid_containers_four_styles_2026-10-16.md), one ThingStyleDef per part per look, named <part>_<Look> and
     picked through the shared style picker (Machinery/PipeLook.cs), the RM_BankWeir_* pattern. Registered by
     RM_SuspensionLooks (Pits/Suspension/RM_SuspensionPatches.cs). A tier with its own picture in a look (<part>_<Tier>, owner picks on the bridge_art_redraw sheet 2026-10-21) draws
     it; a tier without one shares the look's art (the tier shows in the inspect line); the rope type keeps its own Scrapper-only art and is not
     styled. Art: Textures/RimMandrake/FlowWorks/SuspensionBridge/<Look>/. Decks are Basic-linked atlases (<name>_Atlas, art_source/SuspensionLooks/build_deck_atlas.py; drawn by RM_SuspensionDeckLink); uiIconPath keeps the single picture. -->
<Defs>

  <ThingStyleDef>
    <defName>RM_SuspensionDeck_Timber_Scrapper</defName>
    <label>scrapper</label>
    <uiIconPath>RimMandrake/FlowWorks/SuspensionBridge/Scrapper/RM_SuspensionDeck</uiIconPath>
    <graphicData>
      <texPath>RimMandrake/FlowWorks/SuspensionBridge/Scrapper/RM_SuspensionDeck_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <linkType>Basic</linkType>
    </graphicData>
    <modExtensions>
      <!-- RIMMANDRAKE_REDRAW_TIMBER_BRIDGE_FROM_HIS_THREE_PHOTOS (his walk 2026-11-25, photos 13-15; "No ropes tied to the ground
           for the wood bridge"): a beam bridge, parts from art_source/TimberBridge/timber_bridge_art.py. deckWidth = 2 x the curb's
           centre line (CURB_LAT 0.3477), where railing posts stand; selftest_flowworks_timber_bridge.py keeps these equal. -->
      <li Class="RimMandrake.FlowWorks.Pits.RM_DeckArtExtension">
        <strip>RimMandrake/FlowWorks/SuspensionBridge/Scrapper/RM_SuspensionDeck_Timber_Strip</strip>
        <abutment>RimMandrake/FlowWorks/SuspensionBridge/Scrapper/RM_SuspensionDeck_Timber_Abutment</abutment>
        <cable>RimMandrake/FlowWorks/SuspensionBridge/Cables/RM_Rail_Timber_Scrapper</cable>
        <laneEdges>true</laneEdges>
        <deckWidth>0.6953</deckWidth>
        <railPitch>1</railPitch>
        <railHeight>0.45</railHeight>
        <railThick>0.07</railThick>
        <braceOut>0.12</braceOut>
      </li>
    </modExtensions>
  </ThingStyleDef>

