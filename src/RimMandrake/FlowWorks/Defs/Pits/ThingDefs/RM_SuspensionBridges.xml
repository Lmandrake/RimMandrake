<!-- SUSPENSION_GRATE_BUILD_LET_THE_FIRE_UP adds the grated steel and heavy decks (extension grated=true; anchors shared with
     their tier). SUSPENSION_BRIDGE_BUILD_POSTS_AT_BOTH_ENDS (design/RimMandrake/suspension_bridge_construction_design_2026-10-18.md;
     design/RimMandrake/flowworks_bridges_design_2026-10-17.md §6): the surface "Suspension bridge" over dug ground, four types.
     Built only through Designator_SuspensionBridge_* (Patches/Pits/RM_SuspensionBridges.xml adds them to Structure), which
     drags anchor to anchor; canGenerateDefaultDesignator is false so no plain per-square button exists. Lengths, loads, costs,
     hit points and path costs are the builder's playtest starting points, not ruled. -->
<Defs>

  <DrawStyleCategoryDef>
    <defName>RM_SuspensionBridge</defName>
    <styles>
      <li>Line</li>
      <li>FilledRectangle</li>
    </styles>
  </DrawStyleCategoryDef>

  <ThingDef ParentName="BuildingBase">
    <defName>RM_SuspensionDeck_Rope</defName>
    <label>rope suspension bridge</label>
    <description>Planks lashed between two ropes. Light and long (up to 8 squares between supports) but it carries only about 150 kg on a span, and nothing can be built on it.\n\nA suspension bridge crosses dug ground: drag it like a wall, 1 to 3 squares wide, from solid ground to solid ground. Posts go on both ends and are built first; the deck is built from the posts inward. The deck between two supports is one span: everything on it is weighed together, it sags and creaks near its rating, and over it the whole span gives way and everyone on it falls. Losing a post swings the span down from that end. A tower on the hole floor is a support in the middle. Use the Railings switch to stop falls off the edges. For now nobody can walk under it: from below it is a wall.</description>
    <thingClass>RimMandrake.FlowWorks.Pits.Building_SuspensionDeck</thingClass>
    <graphicData>
      <texPath>Things/Building/FlowWorks/SuspensionBridge/RM_SuspensionDeck_Rope</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>Standable</passability>
    <fillPercent>0</fillPercent>
    <pathCost>10</pathCost>
    <rotatable>true</rotatable>
    <selectable>true</selectable>
    <tickerType>Never</tickerType>
    <designationCategory>Structure</designationCategory>
    <canGenerateDefaultDesignator>false</canGenerateDefaultDesignator>
    <drawStyleCategory>RM_SuspensionBridge</drawStyleCategory>
    <uiOrder>2210</uiOrder>
    <costList>
      <WoodLog>6</WoodLog>
      <Cloth>4</Cloth>
    </costList>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <WorkToBuild>400</WorkToBuild>
      <Flammability>1.0</Flammability>
      <Beauty>0</Beauty>
    </statBases>
    <building>
      <isEdifice>false</isEdifice>
      <expandHomeArea>false</expandHomeArea>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <placeWorkers>
      <li>RimMandrake.FlowWorks.Pits.PlaceWorker_SuspensionOverHole</li>
    </placeWorkers>
    <modExtensions>
      <li Class="RimMandrake.FlowWorks.Pits.RM_SuspensionExtension">
        <tier>Rope</tier>
      </li>
    </modExtensions>
  </ThingDef>

