<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <JobDef>
    <defName>RM_DigCanalJob</defName>
    <driverClass>RimMandrake.FlowWorks.JobDriver_DigCanal</driverClass>
    <reportString>digging a canal.</reportString>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

  <JobDef>
    <defName>RM_FillInCanalJob</defName>
    <driverClass>RimMandrake.FlowWorks.JobDriver_FillInCanal</driverClass>
    <reportString>filling in a canal.</reportString>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

  <!-- SUPERDEEP_PRISON_ROOM_1: capture a held person from the lip, never by entering the pit. -->
  <JobDef>
    <defName>RM_CaptureDown</defName>
    <driverClass>RimMandrake.FlowWorks.JobDriver_CaptureDown</driverClass>
    <reportString>capturing TargetA from the edge of the pit.</reportString>
    <makeTargetPrisoner>true</makeTargetPrisoner>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

</Defs>
