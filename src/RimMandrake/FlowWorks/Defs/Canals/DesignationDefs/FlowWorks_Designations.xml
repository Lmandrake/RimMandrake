<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <DesignationDef>
    <defName>RM_DigCanal</defName>
    <targetType>Cell</targetType>
    <texturePath>Designations/Mine</texturePath>
  </DesignationDef>

  <!-- Phase 2's other half. Reuses vanilla's own haul designation art: the
       marker means "earth is coming back to this cell", which is exactly what
       it is. No bespoke texture is owed here — the channel art is (§13). -->
  <DesignationDef>
    <defName>RM_FillInCanal</defName>
    <targetType>Cell</targetType>
    <texturePath>Designations/Haul</texturePath>
  </DesignationDef>

  <!-- FLOWWORKS_RAIL_LADDER_BUILD_LOWER_FROM_ABOVE: the player's order to raise or lower a wall ladder (vanilla's flick art:
       a colonist goes and works it, like a switch). -->
  <DesignationDef>
    <defName>RM_OperateLadder</defName>
    <texturePath>Designations/Flick</texturePath>
    <targetType>Thing</targetType>
    <designateCancelable>false</designateCancelable>
  </DesignationDef>

</Defs>
