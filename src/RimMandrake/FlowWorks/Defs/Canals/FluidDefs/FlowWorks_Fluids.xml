<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- The one fluid this v1 slice ships, chosen to prove genericity. Tar and
       the rest of the owner's named roster (ooze, slime, oil, propane) are
       deliberately NOT authored here; they are Utinni-tier content and belong
       in their own client mod once this engine is live-proven, per this
       item's own scope note.

       Every tier terrain MUST be temporary=true (see FluidDef.ConfigErrors),
       and every one of them is OURS: the base game's only temporary water
       terrains (ShallowFloodwater, MarshFlood) ship in Data/Odyssey and
       naming one hard-required the DLC. The temp-terrain engine itself is
       Core, so RM_Fill_Water_Trace clones ShallowFloodwater's properties
       DLC-free and the release stays destructive-while-standing but
       recoverable, per the owner's 2026-09-02 ruling. -->
  <RimMandrake.FlowWorks.FluidDef>
    <defName>RM_Fluid_Water</defName>
    <label>water</label>
    <!-- Ruling 5's three-tier ladder, all three rungs ours and all three
         parented to vanilla WaterShallow. A tier IS a volume, so the stock
         model quantises for free and the edge-aware ramp art comes with it
         at no cost. -->
    <floodTerrain>RM_Fill_Water_Trace</floodTerrain>
    <fillTerrainHalf>RM_Fill_Water_Half</fillTerrainHalf>
    <fillTerrainBrim>RM_Fill_Water_Brim</fillTerrainBrim>
    <fillTerrainSuperdeep>RM_Fill_Water_Superdeep</fillTerrainSuperdeep>
    <volumePerTile>1</volumePerTile>
    <ticksPerTile>60</ticksPerTile>
    <floodedTicks>300000</floodedTicks>
    <!-- Phase 4. The 5:1 budget is the owner's number, stated per SOURCE CELL:
         a five-cell pond supports twenty-five canal cells and no more, however
         much water a five-cell pond "obviously" holds. recededTerrain is what a
         dried lakebed cell shows while the body is down; the ORIGINAL terrain is
         recorded per cell before the write and restored on refill, so recession
         cannot launder the map. -->
    <canalCellsPerSourceCell>5</canalCellsPerSourceCell>
    <groundOozePerSourceCellPerDay>0.13</groundOozePerSourceCellPerDay>
    <rainRefillFactor>3</rainRefillFactor>
    <recededTerrain>Mud</recededTerrain>
  </RimMandrake.FlowWorks.FluidDef>

  <!-- FLOWWORKS_BUILD_PROGRAM_1 Phase 7 — "Tar needs the viscosity most of
       all" (owner ruling, 2026-09-16). Same tier shape as water, own
       temporary terrains (Defs/Canals/TerrainDefs/FlowWorks_Terrain.xml),
       tinted-vanilla by default and Alpha-Biomes-adopted when present
       (Patches/Canals/RM_Fluid_Tar_AlphaBiomesAdoption.xml) — the floodTerrain
       etc. references below are OUR OWN defNames either way, so this row
       resolves whether or not sarg.alphabiomes is active; only the terrain's
       own texture/receded-look changes underneath it. -->
  <RimMandrake.FlowWorks.FluidDef>
    <defName>RM_Fluid_Tar</defName>
    <label>tar</label>
    <floodTerrain>RM_Fill_Tar_Trace</floodTerrain>
    <fillTerrainHalf>RM_Fill_Tar_Half</fillTerrainHalf>
    <fillTerrainBrim>RM_Fill_Tar_Brim</fillTerrainBrim>
    <fillTerrainSuperdeep>RM_Fill_Tar_Superdeep</fillTerrainSuperdeep>
    <volumePerTile>1</volumePerTile>
    <!-- Real viscosity: 6x water's 60 ticksPerTile (one in-game minute per
         tile) — a tar release crawls a tile every six in-game minutes.
         No owner number was ruled for the exact multiplier; this is a
         single tunable field, chosen (not invented as a name) to read as
         "far higher" per FluidDef.ticksPerTile's own doc comment, and it is
         the one number in this row an owner pass can retune without
         touching anything else. -->
    <ticksPerTile>360</ticksPerTile>
    <floodedTicks>300000</floodedTicks>
    <canalCellsPerSourceCell>5</canalCellsPerSourceCell>
    <groundOozePerSourceCellPerDay>0.13</groundOozePerSourceCellPerDay>
    <rainRefillFactor>3</rainRefillFactor>
    <!-- Fallback lakebed reads as ordinary Mud, same as water; Alpha
         Biomes' own AB_TarMud ("tarred mud") is adopted onto this field by
         the same conditional patch when AB is present. -->
    <recededTerrain>Mud</recededTerrain>
    <!-- SUMP_TAR_HYDROLOGY_1 ruling 3, "flood fronts cool to glass". Our own
         def (Defs/LiquidTypes/TerrainDefs/RM_TarGlass.xml), tier-neutral so
         glass cooling works standalone; Patches/RUT_Tar_GlasswalkCooling.xml
         repoints this at the campaign's own bespoke RUT_Glasswalk when
         UtinniPatches is active. -->
    <coolsToGlassEdge>RM_TarGlass</coolsToGlassEdge>
  </RimMandrake.FlowWorks.FluidDef>

  <!-- SLIME_STREAM_ROWS_1 — four canal fluids, one per colour row in
       Tools/generate_liquid_suite.py's LIQUID_ROWS table (slime_red/green/
       white/yellow) and LIQUID_DEF_ROWS' matching LiquidDef entries. Own
       fillTerrain* defNames (Defs/Canals/TerrainDefs/FlowWorks_SlimeTerrain.xml,
       hand-authored the same way RM_Fill_Water_*/RM_Fill_Tar_* are — these
       four tiers are the CANAL fill look, distinct from the natural-body
       terrain the generator writes), so every row resolves regardless of
       any third-party mod. ticksPerTile 480 — slower than tar's 360, per the
       item's own "Heavy viscosityClass... visibly-slower-than-water oozing"
       spec; [INVENTED], the one tunable an owner pass can retune without
       touching anything else, same convention as tar's own multiplier note
       above. Rest of the tuning (volumePerTile, floodedTicks,
       canalCellsPerSourceCell, groundOozePerSourceCellPerDay,
       rainRefillFactor, recededTerrain) matches water/tar's own numbers
       rather than inventing a second mechanic. -->
  <RimMandrake.FlowWorks.FluidDef>
    <defName>RM_Fluid_SlimeRed</defName>
    <label>red slime</label>
    <floodTerrain>RM_Fill_SlimeRed_Trace</floodTerrain>
    <fillTerrainHalf>RM_Fill_SlimeRed_Half</fillTerrainHalf>
    <fillTerrainBrim>RM_Fill_SlimeRed_Brim</fillTerrainBrim>
    <fillTerrainSuperdeep>RM_Fill_SlimeRed_Superdeep</fillTerrainSuperdeep>
    <volumePerTile>1</volumePerTile>
    <ticksPerTile>480</ticksPerTile>
    <floodedTicks>300000</floodedTicks>
    <canalCellsPerSourceCell>5</canalCellsPerSourceCell>
    <groundOozePerSourceCellPerDay>0.13</groundOozePerSourceCellPerDay>
    <rainRefillFactor>3</rainRefillFactor>
    <recededTerrain>Mud</recededTerrain>
  </RimMandrake.FlowWorks.FluidDef>

  <RimMandrake.FlowWorks.FluidDef>
    <defName>RM_Fluid_SlimeGreen</defName>
    <label>green slime</label>
    <floodTerrain>RM_Fill_SlimeGreen_Trace</floodTerrain>
    <fillTerrainHalf>RM_Fill_SlimeGreen_Half</fillTerrainHalf>
    <fillTerrainBrim>RM_Fill_SlimeGreen_Brim</fillTerrainBrim>
    <fillTerrainSuperdeep>RM_Fill_SlimeGreen_Superdeep</fillTerrainSuperdeep>
    <volumePerTile>1</volumePerTile>
    <ticksPerTile>480</ticksPerTile>
    <floodedTicks>300000</floodedTicks>
    <canalCellsPerSourceCell>5</canalCellsPerSourceCell>
    <groundOozePerSourceCellPerDay>0.13</groundOozePerSourceCellPerDay>
    <rainRefillFactor>3</rainRefillFactor>
    <recededTerrain>Mud</recededTerrain>
  </RimMandrake.FlowWorks.FluidDef>

  <RimMandrake.FlowWorks.FluidDef>
    <defName>RM_Fluid_SlimeWhite</defName>
    <label>white slime</label>
    <floodTerrain>RM_Fill_SlimeWhite_Trace</floodTerrain>
    <fillTerrainHalf>RM_Fill_SlimeWhite_Half</fillTerrainHalf>
    <fillTerrainBrim>RM_Fill_SlimeWhite_Brim</fillTerrainBrim>
    <fillTerrainSuperdeep>RM_Fill_SlimeWhite_Superdeep</fillTerrainSuperdeep>
    <volumePerTile>1</volumePerTile>
    <ticksPerTile>480</ticksPerTile>
    <floodedTicks>300000</floodedTicks>
    <canalCellsPerSourceCell>5</canalCellsPerSourceCell>
    <groundOozePerSourceCellPerDay>0.13</groundOozePerSourceCellPerDay>
    <rainRefillFactor>3</rainRefillFactor>
    <recededTerrain>Mud</recededTerrain>
  </RimMandrake.FlowWorks.FluidDef>

  <!-- YELLOW — the item's own "documented example row", canal side. Same
       shape as its three siblings above; nothing about the fluid ladder
       changes because the liquid is harmless — viscosity and flow are
       independent of hazard. -->
  <RimMandrake.FlowWorks.FluidDef>
    <defName>RM_Fluid_SlimeYellow</defName>
    <label>yellow slime</label>
    <floodTerrain>RM_Fill_SlimeYellow_Trace</floodTerrain>
