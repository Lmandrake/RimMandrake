<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- PIT_FILL_EFFECTS_1 (owner ruling 7 of PIT_SUPERDEEP_COLLAPSE_1: "oil and poison ARE FluidDefs").
       What a pit does to its occupant comes from the fluid, never from a pit def. Numbers PROVISIONAL.
       Neither row is yet the canalFluid of a natural LiquidDef, so a pond cannot feed them: they reach a
       cell by a driver/debug fill (RM_FluidIdentityProof.ProofFillWithFluid) or by flowing from such a cell.
       Their surface looks are generated (Tools/generate_liquid_suite.py FLUID_SURFACE_LOOKS ->
       Patches/LiquidTypes/RM_FluidSurfaceLooks.xml). -->
  <RimMandrake.FlowWorks.FluidDef>
    <defName>RM_Fluid_Oil</defName>
    <label>oil</label>
    <!-- Ignitable: a creeping fuse like tar, a little quicker (thinner). PROVISIONAL 90 ticks/cell. -->
    <fireKind>CreepingFuse</fireKind>
    <fireFrontTicksPerCell>90</fireFrontTicksPerCell>
    <floodTerrain>RM_Fill_Oil_Trace</floodTerrain>
    <fillTerrainHalf>RM_Fill_Oil_Half</fillTerrainHalf>
    <fillTerrainBrim>RM_Fill_Oil_Brim</fillTerrainBrim>
    <fillTerrainSuperdeep>RM_Fill_Oil_Superdeep</fillTerrainSuperdeep>
    <volumePerTile>1</volumePerTile>
    <ticksPerTile>180</ticksPerTile>
    <floodedTicks>300000</floodedTicks>
    <groundOozePerSourceCellPerDay>0.13</groundOozePerSourceCellPerDay>
    <rainRefillFactor>3</rainRefillFactor>
    <recededTerrain>Mud</recededTerrain>
  </RimMandrake.FlowWorks.FluidDef>

  <RimMandrake.FlowWorks.FluidDef>
    <defName>RM_Fluid_Poison</defName>
    <label>poison</label>
    <!-- Toxin keyed to fill: 2.4 ToxicBuildup/day standing in a brimming cell (a pawn reaches
         "extreme" in well under a day; PROVISIONAL). Does not burn. -->
    <toxicPerDayAtBrim>2.4</toxicPerDayAtBrim>
    <floodTerrain>RM_Fill_Poison_Trace</floodTerrain>
    <fillTerrainHalf>RM_Fill_Poison_Half</fillTerrainHalf>
    <fillTerrainBrim>RM_Fill_Poison_Brim</fillTerrainBrim>
    <fillTerrainSuperdeep>RM_Fill_Poison_Superdeep</fillTerrainSuperdeep>
    <volumePerTile>1</volumePerTile>
    <ticksPerTile>60</ticksPerTile>
    <floodedTicks>300000</floodedTicks>
    <groundOozePerSourceCellPerDay>0.13</groundOozePerSourceCellPerDay>
    <rainRefillFactor>3</rainRefillFactor>
    <recededTerrain>Mud</recededTerrain>
  </RimMandrake.FlowWorks.FluidDef>

  <!-- FLOWWORKS_REVIEW_LOOKS_ROUND_1 (owner, 2026-10-06: "Need many more of the fluids online here. Blood. Chemfuel.
       Astrofuel."). Canal fluids only — no item is required for any of them (astrofuel's item is Vanilla Gravship
       Expanded's VGE_Astrofuel, adopted separately by Patches/LiquidTypes/RM_LiquidDef_AstrofuelAdoption.xml).
       Fire (CHEMFUEL_MOAT_WIRE_MISSING_CHANNEL, owner by card 2026-10-15): chemfuel is an INFERNO ("a moat of gasoline":
       fast front, big flames, heat, burns down in seconds); astrofuel DETONATES ("an ultimate spatially continuous bomb");
       blood does not burn.
       ticksPerTile PROVISIONAL: blood a little thick (120), the fuels thin (60). Each can be switched off in Mod
       Settings ("Liquids that can fill a cut"). -->
  <RimMandrake.FlowWorks.FluidDef>
    <defName>RM_Fluid_Blood</defName>
    <label>blood</label>
    <floodTerrain>RM_Fill_Blood_Trace</floodTerrain>
    <fillTerrainHalf>RM_Fill_Blood_Half</fillTerrainHalf>
    <fillTerrainBrim>RM_Fill_Blood_Brim</fillTerrainBrim>
    <fillTerrainSuperdeep>RM_Fill_Blood_Superdeep</fillTerrainSuperdeep>
    <volumePerTile>1</volumePerTile>
    <ticksPerTile>120</ticksPerTile>
    <floodedTicks>300000</floodedTicks>
    <groundOozePerSourceCellPerDay>0.13</groundOozePerSourceCellPerDay>
    <rainRefillFactor>3</rainRefillFactor>
    <recededTerrain>Mud</recededTerrain>
  </RimMandrake.FlowWorks.FluidDef>

  <RimMandrake.FlowWorks.FluidDef>
    <defName>RM_Fluid_Chemfuel</defName>
    <label>chemfuel</label>
    <!-- Spilled chemfuel = gasoline (real numbers and sources: Transient/pile_2026-10-22/fuel_spill_research.md): soaks
         in 1.5x water (Darcy: density/viscosity 740/0.5 vs 1000/1.0), dries 6x water (3 cm/day at 20 C: the light ends
         go in hours), burns down 4 mm per game minute (pool-fire regression), so a 2 cm puddle burns ~5 game minutes. -->
    <sheetSoakPercent>150</sheetSoakPercent>
    <sheetEvaporationPercent>600</sheetEvaporationPercent>
    <sheetBurnMmPerMinute>4</sheetBurnMmPerMinute>
    <fireKind>Inferno</fireKind>
    <!-- PROVISIONAL: 2 ticks a cell, a 100-cell moat alight end to end in ~3 s (Mod Settings: chemfuel spread speed). -->
    <fireFrontTicksPerCell>2</fireFrontTicksPerCell>
    <floodTerrain>RM_Fill_Chemfuel_Trace</floodTerrain>
    <fillTerrainHalf>RM_Fill_Chemfuel_Half</fillTerrainHalf>
    <fillTerrainBrim>RM_Fill_Chemfuel_Brim</fillTerrainBrim>
    <fillTerrainSuperdeep>RM_Fill_Chemfuel_Superdeep</fillTerrainSuperdeep>
    <volumePerTile>1</volumePerTile>
    <ticksPerTile>60</ticksPerTile>
    <floodedTicks>300000</floodedTicks>
    <groundOozePerSourceCellPerDay>0.13</groundOozePerSourceCellPerDay>
    <rainRefillFactor>3</rainRefillFactor>
    <recededTerrain>Mud</recededTerrain>
  </RimMandrake.FlowWorks.FluidDef>

  <RimMandrake.FlowWorks.FluidDef>
    <defName>RM_Fluid_Astrofuel</defName>
    <label>astrofuel</label>
    <!-- Spilled astrofuel = jet fuel, Jet A / JP-8 (fuel_spill_research.md): soaks in 0.7x water (800/1.2 vs 1000/1.0),
         dries at half water's rate (kerosene-range, low vapour pressure: a puddle lingers about a week), and when the
         detonation setting is off burns down 3 mm per game minute. The detonation itself is the owner's 2026-10-15 card. -->
    <sheetSoakPercent>70</sheetSoakPercent>
    <sheetEvaporationPercent>50</sheetEvaporationPercent>
    <sheetBurnMmPerMinute>3</sheetBurnMmPerMinute>
    <fireKind>Detonation</fireKind>
    <fireFrontTicksPerCell>10</fireFrontTicksPerCell>
    <floodTerrain>RM_Fill_Astrofuel_Trace</floodTerrain>
    <fillTerrainHalf>RM_Fill_Astrofuel_Half</fillTerrainHalf>
    <fillTerrainBrim>RM_Fill_Astrofuel_Brim</fillTerrainBrim>
    <fillTerrainSuperdeep>RM_Fill_Astrofuel_Superdeep</fillTerrainSuperdeep>
    <volumePerTile>1</volumePerTile>
    <ticksPerTile>60</ticksPerTile>
    <floodedTicks>300000</floodedTicks>
    <groundOozePerSourceCellPerDay>0.13</groundOozePerSourceCellPerDay>
    <rainRefillFactor>3</rainRefillFactor>
    <recededTerrain>Mud</recededTerrain>
  </RimMandrake.FlowWorks.FluidDef>

  <!-- PROPANE_CANAL_WIRE_STILL_NO_FLUID: the canal form of RM_Liquid_Propane (the propane lake's liquid), so a propane
       tank, pump or hose fills a cut instead of spilling. Burns as an INFERNO, like chemfuel: a thin, volatile fuel
       goes up fast and burns away quickly (it shares chemfuel's "burns like gasoline" settings). It never lights
       itself: the propane hard ban (no ignition without a hot source or spark) holds because only a vanilla Fire or a
       blast lights a liquid cell (RM_LiquidFire). No surfaceLook of its own: RM_LiquidSurface gives it the
       RM_Liquid_Propane row's look (the lake's medium-pale grey). PROVISIONAL: fireKind, fireFrontTicksPerCell 2 and ticksPerTile 60
       copied from chemfuel. -->
  <RimMandrake.FlowWorks.FluidDef>
    <defName>RM_Fluid_Propane</defName>
    <label>liquid propane</label>
    <!-- CANAL_OVERFLOW (all liquids, owner 2026-10-22): spilled propane boils off (fuel_spill_research.md). It boils at
         -42 C on heat from the ground, so the air and a roof do not set the rate: 2 cm per game hour above -42 C (a 2 cm
         spill is gone in an hour; ~100x water at 20 C), nothing soaks in (the ground freezes under it), and a lit pool
         burns down 8 mm per game minute (LPG pool fire). -->
    <sheetSoakPercent>0</sheetSoakPercent>
    <sheetEvaporationPercent>0</sheetEvaporationPercent>
    <sheetBoilCmPerHour>2</sheetBoilCmPerHour>
    <sheetBoilPointC>-42</sheetBoilPointC>
    <sheetBurnMmPerMinute>8</sheetBurnMmPerMinute>
    <fireKind>Inferno</fireKind>
    <fireFrontTicksPerCell>2</fireFrontTicksPerCell>
    <floodTerrain>RM_Fill_Propane_Trace</floodTerrain>
    <fillTerrainHalf>RM_Fill_Propane_Half</fillTerrainHalf>
    <fillTerrainBrim>RM_Fill_Propane_Brim</fillTerrainBrim>
    <fillTerrainSuperdeep>RM_Fill_Propane_Superdeep</fillTerrainSuperdeep>
    <volumePerTile>1</volumePerTile>
    <ticksPerTile>60</ticksPerTile>
    <floodedTicks>300000</floodedTicks>
    <groundOozePerSourceCellPerDay>0.13</groundOozePerSourceCellPerDay>
    <rainRefillFactor>3</rainRefillFactor>
    <recededTerrain>Mud</recededTerrain>
  </RimMandrake.FlowWorks.FluidDef>

  <!-- BOILING_ICY_CANAL_FLUIDS_1: hot/cold feed RM_LiquidHeat (FluidDef.hot/cold). ticksPerTile PROVISIONAL (water-thin, 60). -->
  <RimMandrake.FlowWorks.FluidDef>
    <defName>RM_Fluid_BoilingWater</defName>
    <label>boiling water</label>
    <hot>true</hot>
    <floodTerrain>RM_Fill_BoilingWater_Trace</floodTerrain>
    <fillTerrainHalf>RM_Fill_BoilingWater_Half</fillTerrainHalf>
    <fillTerrainBrim>RM_Fill_BoilingWater_Brim</fillTerrainBrim>
    <fillTerrainSuperdeep>RM_Fill_BoilingWater_Superdeep</fillTerrainSuperdeep>
    <volumePerTile>1</volumePerTile>
    <ticksPerTile>60</ticksPerTile>
    <floodedTicks>300000</floodedTicks>
    <groundOozePerSourceCellPerDay>0.13</groundOozePerSourceCellPerDay>
    <rainRefillFactor>3</rainRefillFactor>
    <recededTerrain>Mud</recededTerrain>
  </RimMandrake.FlowWorks.FluidDef>

  <RimMandrake.FlowWorks.FluidDef>
    <defName>RM_Fluid_IcyWater</defName>
    <label>icy water</label>
    <cold>true</cold>
    <floodTerrain>RM_Fill_IcyWater_Trace</floodTerrain>
    <fillTerrainHalf>RM_Fill_IcyWater_Half</fillTerrainHalf>
    <fillTerrainBrim>RM_Fill_IcyWater_Brim</fillTerrainBrim>
    <fillTerrainSuperdeep>RM_Fill_IcyWater_Superdeep</fillTerrainSuperdeep>
    <volumePerTile>1</volumePerTile>
    <ticksPerTile>60</ticksPerTile>
    <floodedTicks>300000</floodedTicks>
    <groundOozePerSourceCellPerDay>0.13</groundOozePerSourceCellPerDay>
    <rainRefillFactor>3</rainRefillFactor>
    <recededTerrain>Mud</recededTerrain>
  </RimMandrake.FlowWorks.FluidDef>

</Defs>
