<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- VEXXITH_USES_1: the canal ladders of the two pH 2 liquids, on the shape of RM_Fill_Poison_*. Before these, a canal
       cut into an acid pool ran fresh water (FormBody falls back to RM_Fluid_Water for a liquid with no canalFluid), so
       no acid could reach a gate. RM_LiquidProperties is the natural pool's own block: LiquidCorrosion reads it. -->

  <TerrainDef ParentName="WaterShallow">
    <defName>RM_Fill_AcidWater_Trace</defName>
    <label>knee-deep acid water (under 0.75 m)</label>
    <description>Acid water standing ankle-to-knee deep. Wading it is easy. It burns skin and eats cloth, more the deeper you stand.</description>
    <texturePath>Terrain/Surfaces/WaterShallowRamp</texturePath>
    <!-- P14: a BASE-layer def (wet dug squares are base writes); its own water-body type, no fish. -->
    <waterBodyType>Other</waterBodyType>
    <dangerous>true</dangerous>
    <driesTo></driesTo>
    <canFreeze>false</canFreeze>
    <takeSplashes>true</takeSplashes>
    <color>(199,245,56)</color>
    <pathCost>100</pathCost>
    <renderPrecedence>394</renderPrecedence>
    <tags>
      <li>Water</li>
      <li>WaterFreshShallow</li>
      <li>WaterFreshShallowStill</li>
      <li>Flood</li>
    </tags>
    <modExtensions>
      <li Class="RimMandrake.FlowWorks.LiquidTypes.RM_LiquidProperties">
        <viscosityClass>Water</viscosityClass>
        <pH>2</pH>
        <damageOnContact>
          <damageDef>AcidBurn</damageDef>
          <amount>1</amount>
        </damageOnContact>
        <damageOnImmersion>
          <damageDef>AcidBurn</damageDef>
          <amount>3</amount>
        </damageOnImmersion>
        <corrodesApparel>true</corrodesApparel>
      </li>
      <li Class="RimMandrake.FlowWorks.LiquidTypes.RM_DrinkableTerrainExtension">
        <liquid>RM_Liquid_AcidWater</liquid>
      </li>
    </modExtensions>
  </TerrainDef>

