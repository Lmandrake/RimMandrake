  <!-- PIT_FILL_EFFECTS_1: the fill ladders for oil and poison, cloned from the tar ladder (same pathCost and
       passability per tier, same vanilla water ramps, only colour and words differ). Each fluid's animated surface look comes from
       Patches/LiquidTypes/RM_FluidSurfaceLooks.xml (applied by RM_LiquidLooks.Apply); the <color> here is the
       fallback under it. -->

  <TerrainDef ParentName="WaterShallow">
    <defName>RM_Fill_Oil_Trace</defName>
    <!-- burnable fill: WaterShallow's extinguishesFire put a burning occupant out at once (ruling 22: one held
         in a burning pit always catches). Live 2026-10-05: oil-pit pirate took heatstroke, never a burn. -->
    <extinguishesFire>false</extinguishesFire>
    <label>knee-deep oil (under 0.75 m)</label>
    <description>Oil standing ankle-to-knee deep. Wading it is easy. It clings, it stinks, and it burns.</description>
    <texturePath>Terrain/Surfaces/WaterShallowRamp</texturePath>
    <!-- P14: a BASE-layer def (wet dug squares are base writes); its own water-body type, no fish. -->
    <waterBodyType>Other</waterBodyType>
    <driesTo></driesTo>
    <canFreeze>false</canFreeze>
    <takeSplashes>false</takeSplashes>
    <color>(70,52,24)</color>
    <pathCost>100</pathCost>
    <renderPrecedence>394</renderPrecedence>
    <tags>
      <li>Water</li>
      <li>WaterFreshShallow</li>
      <li>WaterFreshShallowStill</li>
      <li>Flood</li>
    </tags>
  </TerrainDef>

