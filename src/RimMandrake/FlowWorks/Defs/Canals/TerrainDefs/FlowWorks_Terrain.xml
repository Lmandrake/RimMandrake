    <texturePath>Terrain/Surfaces/Gravel</texturePath>
    <color>(0.78,0.75,0.70)</color>
    <renderPrecedence>326</renderPrecedence>
    <fertility>0</fertility>
    <pathCost>45</pathCost>
    <natural>true</natural>
    <edgeType>FadeRough</edgeType>
    <scatterType>Rocky</scatterType>
    <affordances>
      <li>Walkable</li>
      <li>Light</li>
      <li>Diggable</li>
    </affordances>
    <tags>
      <li>Soil</li>
    </tags>
    <statBases>
      <Beauty>-3</Beauty>
    </statBases>
  </TerrainDef>

  <!-- D = 3, DEEP. -->
  <TerrainDef ParentName="NaturalTerrainBase">
    <defName>RM_Channel_Deep</defName>
