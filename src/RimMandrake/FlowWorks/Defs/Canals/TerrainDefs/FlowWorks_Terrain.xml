  <!-- D = 4, SUPERDEEP — the trapping level (ruling 19).
       🔴 PASSABLE, AND THAT IS THE MECHANIC. A pawn entering this cell is
       CAPTURED (ruling 26: "SUPERDEEP captures as if dry"), held by the
       RM_SuperdeepTrap grid rule (the pawn stays spawned on the pit floor),
       and gets out only by a ladder in the cell that lets it climb
       (RM_LadderRules.LadderLetsOut) or a pit ramp (RM_PitRamp, rulings of 2026-10-12). An Impassable terrain would make the
       pathfinder route around the hole and the capture would never fire —
       Traversability.Impassable makes PathGrid.CalculatedCostAt return its
       10000 sentinel, VERIFIED against the decompiled PathGrid.
       pathCost 300 keeps it a place nobody crosses by choice. -->
  <TerrainDef ParentName="NaturalTerrainBase">
    <defName>RM_Channel_Superdeep</defName>
    <label>very deep pit</label>
    <description>Ground dug four levels below the surface. Anything that walks into it falls in and is held there; without a ladder or a ramp standing in the hole, it is not climbing out.</description>
    <texturePath>Terrain/Surfaces/Gravel</texturePath>
    <color>(0.38,0.36,0.33)</color>
    <renderPrecedence>328</renderPrecedence>
    <fertility>0</fertility>
    <pathCost>300</pathCost>
    <passability>Standable</passability>
    <natural>true</natural>
    <edgeType>FadeRough</edgeType>
    <scatterType>Rocky</scatterType>
    <affordances>
      <li>Light</li>
    </affordances>
    <tags>
      <li>Soil</li>
    </tags>
    <statBases>
      <Beauty>-5</Beauty>
    </statBases>
  </TerrainDef>

  <!-- ══════════════════════════════════════════════════════════════════
       THE DRY POND BED — POND_BED_BUILD_HOLLOW_KEEPS_ITS_SHAPE step 2
       (design/RimMandrake/natural_bodies_as_canals_design_2026-10-11.md §4 B,
       owner rulings 2-3; look (b) picked by card 2026-10-13: a cracked lakebed
       per depth band). Recession lays one of these on a dried pond square at
       the square's bed depth (shallow water → 2, deep water → 4, ruling 3);
       Restore puts the recorded water back last-in-first-out. The depth itself
       lives in RM_MapComponent_Excavation's bed grid, never in the terrain:
       these are NOT in RM_ExcavationDepth.DepthOfDryTerrain, so a legacy
       rehydrate never mistakes a dried pond for a dug channel.
       pathCost and affordances match the dug channel at the same depth
       (RM_Channel_Mid for 2, RM_Channel_Superdeep for 4). Soil-tagged like
       them, so a dried bed can still be dug (owner ruling 6).
       ══════════════════════════════════════════════════════════════════ -->

  <!-- bed depth 2: what shallow water leaves -->
  <TerrainDef ParentName="NaturalTerrainBase">
    <defName>RM_Lakebed_Shallow</defName>
    <label>dry lakebed</label>
    <description>The cracked floor of a pond that has been drained, two levels below the surrounding ground. Climbing in or out is slow work; walking along it is not. Water pumped back fills it again.</description>
    <texturePath>Terrain/FlowWorks/RM_Lakebed_Shallow</texturePath>
    <renderPrecedence>329</renderPrecedence>
    <fertility>0</fertility>
    <pathCost>45</pathCost>
    <natural>true</natural>
    <edgeType>FadeRough</edgeType>
    <affordances>
      <li>Walkable</li>
      <li>Light</li>
      <li>Diggable</li>
    </affordances>
