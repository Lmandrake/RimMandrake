    <defName>RM_Fill_Tar_Superdeep</defName>
    <!-- burnable fill: WaterShallow's extinguishesFire put a burning occupant out at once (ruling 22: one held
         in a burning pit always catches). Live 2026-10-05: oil-pit pirate took heatstroke, never a burn. -->
