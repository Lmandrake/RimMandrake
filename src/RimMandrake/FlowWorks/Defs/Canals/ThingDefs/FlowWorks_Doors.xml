<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- FLOWWORKS_DOOR_FAMILY_1 — the owner's two stuffable canal doors (2026-09-17, he took the
       simpler shape: two defs, stuff decides armour, HP and burning; "the player can just learn
       what happens if you're made of wood"). FLOWWORKS_SLUICE_TWO_DOORS_1 (owner 2026-10-06): the
       sluice is SEALED while shut and passes liquid only open; the grate always passes liquid. Neither
       opens for a pawn held in a superdeep pit. SLUICE_GATE_REBUILD_LIFTS_UP_NOT_SIDEWAYS (owner 2026-10-24): the
       sluice is an OPERATED gate, opened by nobody walking into it: a colonist lifts or lowers it from any
       touching cell (bank or canal), shut it blocks everyone, lifted it passes everyone; god mode adds force
       open/close buttons (Building_RM_FlowDoor / RM_PitTrapMath.FlowDoorOpens). Light affordance and NOT the stuff's,
       so a stone or steel gate can be placed in a DRY dug channel (channels offer Light only).
       A wet cell's RM_Fill_* terrain inherits WaterShallow's affordances, which have no Light; ruling #18
       (owner card, 2026-10-11) lets both doors stand there anyway on a DUG cell (C#
       RM_Patch_FlowDoorOnWetCanal), so they can be placed on a wet canal cell and a blueprint or frame
       survives its cut flooding. A half-built frame seals nothing: liquid runs through it until the door
       is finished. A natural lake or river cell stays refused.
       Both gates LIFT (owner 2026-10-24, "they slide 'up' to allow the water through"; GRATE_DOOR_REBUILD_LIFTS_LIKE_THE_SLUICE):
       Building_RM_FlowDoor.DrawAt draws a fixed <texPath>_Frame layer and a <texPath>_Panel layer raised by
       liftCells x open fraction (RM_PitTrapMath.GateLiftOffset). The layers are cut by Tools/fw_gate_lift.py and
       checked by Tools/selftest_fw_gate_lift.py. FLOWDOOR_EW_PERSPECTIVE (owner 2026-10-18): each layer is
       Graphic_Multi; _south is the front view, _east the side view of a gate spanning North-South. There is no
       _north (falls back to _south) and no _west (a 1x1 door only turns North or East).
       The bare RM_Sluice / RM_SecurityGrateDoor PNGs stay as the menu icons (uiIconPath) and the source the layers are cut from. -->
  <ThingDef ParentName="DoorBase">
    <defName>RM_Sluice</defName>
    <label>sluice gate</label>
    <description>A sealed gate for a canal. Lowered, it holds the liquid back; lift it and the level runs on through. Nobody walks through it: a colonist lifts or lowers it from the bank or the canal beside it. Lowered, it stops everyone; lifted, everyone passes. What it is made of decides how tough it is and whether it burns.</description>
    <thingClass>RimMandrake.FlowWorks.Building_RM_FlowDoor</thingClass>
    <statBases>
      <WorkToBuild>500</WorkToBuild>
      <MaxHitPoints>100</MaxHitPoints>
    </statBases>
    <graphicData>
      <texPath>Things/Building/FlowWorks/Canals/RM_Sluice</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <uiIconPath>Things/Building/FlowWorks/Canals/RM_Sluice</uiIconPath>
    <costStuffCount>15</costStuffCount>
    <useStuffTerrainAffordance>false</useStuffTerrainAffordance>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <blockWind>false</blockWind>
    <blockLight>false</blockLight>
    <uiOrder>2060</uiOrder>
    <modExtensions>
      <li Class="RimMandrake.FlowWorks.RM_FlowDoorExtension">
        <isSluice>true</isSluice>
        <liftCells>0.56</liftCells>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="DoorBase">
    <defName>RM_SecurityGrateDoor</defName>
    <label>security grate</label>
    <description>A barred prisoner door for the end of a canal. Liquid flows through the bars while it is shut, and it holds a prisoner as well as any door. Nobody trapped down in a pit can open it from below. What it is made of decides how tough it is and whether it burns.</description>
    <thingClass>RimMandrake.FlowWorks.Building_RM_FlowDoor</thingClass>
    <statBases>
      <WorkToBuild>1400</WorkToBuild>
      <MaxHitPoints>240</MaxHitPoints>
    </statBases>
    <graphicData>
      <texPath>Things/Building/FlowWorks/Canals/RM_SecurityGrateDoor</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <uiIconPath>Things/Building/FlowWorks/Canals/RM_SecurityGrateDoor</uiIconPath>
    <costStuffCount>40</costStuffCount>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    <useStuffTerrainAffordance>false</useStuffTerrainAffordance>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <blockWind>false</blockWind>
    <blockLight>false</blockLight>
    <uiOrder>2061</uiOrder>
    <modExtensions>
      <li Class="RimMandrake.FlowWorks.RM_FlowDoorExtension">
        <isSluice>false</isSluice>
        <liftCells>0.50</liftCells>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
