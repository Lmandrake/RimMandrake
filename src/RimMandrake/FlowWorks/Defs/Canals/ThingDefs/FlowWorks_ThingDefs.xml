<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Invisible driver thing, same shape as vanilla SeasonalFlood and
       TorrentialRainFlood: an ethereal Thing whose thingClass IS the
       class doing the spreading. Flood_FlowWorks subclasses Verse.Thing
       directly, not Odyssey's RimWorld.Flood — see the class header. -->
  <ThingDef ParentName="EtherealThingBase">
    <defName>RM_FluidCanalFlood</defName>
    <category>Ethereal</category>
    <drawerType>None</drawerType>
    <selectable>false</selectable>
    <thingClass>RimMandrake.FlowWorks.Flood_FlowWorks</thingClass>
    <tickerType>Normal</tickerType>
    <useHitPoints>false</useHitPoints>
  </ThingDef>

  <!-- ==================================================================
       PHASE 5 — THE LADDER. One boolean effect: a dug cell with a ladder
       in it is exitable, and a dug cell without one is not. Removing it
       strands whatever is down there, which is the jailer mechanic. The
       gate is the grid trap rule (RM_SuperdeepTrap.IsHeld: no pawn is held
       on a cell with a ladder in it); there is no holder Thing.

       It deliberately does NOT change pathing, passability, line of sight
       or escape odds. Anything more is an elevation model in disguise.

       PLACEHOLDER ART, and flagged as such: texPath borrows the vanilla
       spike-trap sheet the pit family already ships against, so the mod
       loads with no missing-texture error. Candidate art EXISTS but is
       NOT wired and NOT ruled on by the owner —
       Transient/flowworks_art_2026-09-16/buildings/RUT_Ladder_A.png and
       RUT_Ladder_B.png. Do not copy either into Textures/ before he picks
       one; note also that the candidates carry the RUT_ tier prefix while
       this def is RM_ tier, which is itself a question for him.
       ================================================================== -->
  <ThingDef ParentName="BuildingBase">
    <defName>RM_Ladder</defName>
    <label>ladder</label>
    <description>A rough ladder braced against the wall of an excavation. Lowered, it works like a prison door: your people climb it, trapped enemies cannot, prisoners only in a prison break. Raised, nobody climbs out.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Security/TrapSpikeArmed</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <fillPercent>0</fillPercent>
    <pathCost>0</pathCost>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <designationCategory>Structure</designationCategory>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <WorkToBuild>400</WorkToBuild>
      <Flammability>1.0</Flammability>
      <Beauty>-2</Beauty>
    </statBases>
    <costList>
      <WoodLog>20</WoodLog>
    </costList>
    <building>
      <!-- Not an edifice: an edifice would block the fill-in designator on its cell. -->
      <isEdifice>false</isEdifice>
      <expandHomeArea>false</expandHomeArea>
    </building>
    <comps>
      <!-- LADDER_PRISON_DOOR_1: raised/lowered, prison-door climbing rule. -->
      <li Class="RimMandrake.FlowWorks.RM_CompProperties_Ladder" />
    </comps>
    <placeWorkers>
      <li>RimMandrake.FlowWorks.PlaceWorker_LadderOnExcavation</li>
    </placeWorkers>
  </ThingDef>

  <!-- CANAL_BOTTOM_SPIKES_1 — spikes are per-cell hardware on a superdeep (D = 4) canal floor, the
       ladder's shape: a Thing in the cell + placeworker + RM_SpikeUtility.HasSpikes. Owner Q2
       2026-10-02 (by card): D = 4 only. Fire on descent only (RM_SuperdeepTrap.PitDescent), three
       Sharp hits scaled by body size (numbers PROPOSED in RM_PitTrapMath, owner's word owed).
       Graphic is a PLACEHOLDER (Ideology's skullspike: a spike at the pit's viewing angle; the item
       forbids TrapSpikeArmed); the real floor-of-spikes art is EXCAVATION_WALL_ART_1. -->
  <ThingDef ParentName="BuildingBase">
    <defName>RM_Spikes</defName>
    <label>pit spikes</label>
    <description>Sharpened stakes driven into the floor of a superdeep pit. Whoever falls, is pushed or jumps into this cell lands on them: several deep stab wounds, worse for bigger creatures, armour still counts. Walking up to the edge, or moving along the pit floor, is safe. Can only be built on the floor of the deepest pits.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Misc/Skullspike/Skullspike</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <fillPercent>0</fillPercent>
    <pathCost>0</pathCost>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <designationCategory>Structure</designationCategory>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>600</WorkToBuild>
      <Flammability>1.0</Flammability>
      <Beauty>-4</Beauty>
    </statBases>
    <costList>
      <WoodLog>30</WoodLog>
    </costList>
    <building>
      <!-- Not an edifice, like the ladder: an edifice would block the fill-in designator. -->
      <isEdifice>false</isEdifice>
      <expandHomeArea>false</expandHomeArea>
    </building>
    <placeWorkers>
      <li>RimMandrake.FlowWorks.PlaceWorker_SpikesOnSuperdeep</li>
    </placeWorkers>
  </ThingDef>

</Defs>
