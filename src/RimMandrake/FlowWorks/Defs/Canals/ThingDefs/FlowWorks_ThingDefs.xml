<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Invisible driver thing, same shape as vanilla SeasonalFlood and
       TorrentialRainFlood: an ethereal Thing whose thingClass IS the
       class doing the spreading. Flood_FlowWorks subclasses Verse.Thing
       directly, not Odyssey's RimWorld.Flood — see the class header. -->
  <ThingDef ParentName="EtherealThingBase">
    <defName>RM_FluidCanalFlood</defName>
    <category>Ethereal</category>
    <drawerType>None</drawerType>
    <selectable>false</selectable>
    <thingClass>RimMandrake.FlowWorks.Flood_FlowWorks</thingClass>
    <tickerType>Normal</tickerType>
    <useHitPoints>false</useHitPoints>
  </ThingDef>

  <!-- ==================================================================
       PHASE 5 — THE LADDER. PIT_LADDER_REDRAW_HUNG_ON_THE_WALL (owner 2026-10-16: "installed along a side of the
       pit, like a door to a room"): it stands on the pit square and HANGS ON ONE WALL, its rotation (the shallower
       N/S/E/W neighbour it faces, auto-turned to the biggest drop when the placed rotation faces none:
       RM_LadderWallMath). It joins its square to that wall square only. Slid down (lowered) it is drawn pressed
       against that wall; slid up (raised) it is drawn lying on the rim beyond it (drawOffset per facing).
       PLACEHOLDER ART: the old single pictures, turned per facing, until the per-wall set
       (art_source/Ladder/, RM_LadderHung_* / RM_LadderStowed_*, Graphic_Multi) is ruled on and installed.
       A dug cell is exitable only by a ladder in
       it that lets THIS pawn climb (RM_LadderRules.LadderLetsOut, per
       pawn): raised, it lets nobody out; lowered, it works like a prison
       door (MayClimb: your people and non-hostiles climb, trapped enemies
       stay held, prisoners only in a prison break). Removing or raising it
       strands whatever is down there, which is the jailer mechanic. The
       gate is the grid trap rule (RM_SuperdeepTrap); there is no holder Thing.

       It deliberately does NOT change pathing, passability, line of sight
       or escape odds. Anything more is an elevation model in disguise.

       Art: fwart_RM_Ladder from the 2026-10-06 FlowWorks commission (owner:
       commission versions of ALL FlowWorks art), installed through the art
       ledger and shown on the review map for his look; not yet ruled on.
       ================================================================== -->
  <ThingDef ParentName="BuildingBase">
    <defName>RM_Ladder</defName>
    <label>ladder</label>
    <description>A rough ladder hung on one wall of an excavation, like a door between the pit and the ground above. Slid down, people climb down into the pit and back up by it, and haulers fetch what lies on the floor; it works like a prison door: your people climb it, trapped enemies cannot, prisoners only in a prison break. Slid up onto the rim, nobody climbs it.</description>
    <thingClass>RimMandrake.FlowWorks.RM_Building_Ladder</thingClass>
    <graphicData>
      <!-- PIT_LADDER_RAILS_ON_THE_WALL (owner spec 2026-10-18): rails fixed on the wall, the ladder slides on them.
           Rotation = the wall (north = far wall, whole apparatus face-on; south = near wall, only what stands above the
           near rim; east/west = angled side mounts), as vanilla TorchWallLamp. Both states share drawSize and offsets so
           the rails do not move. Art: art_source/Ladder/v2 (compose.py holds the same offsets). -->
      <texPath>Things/Building/FlowWorks/Canals/RM_Ladder</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1.5,1.5)</drawSize>
      <drawOffsetNorth>(0,0,0.25)</drawOffsetNorth>
      <drawOffsetEast>(0,0,0.25)</drawOffsetEast>
      <drawOffsetSouth>(0,0,-0.25)</drawOffsetSouth>
      <drawOffsetWest>(0,0,0.25)</drawOffsetWest>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <fillPercent>0</fillPercent>
    <pathCost>0</pathCost>
    <rotatable>true</rotatable>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <designationCategory>Structure</designationCategory>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <WorkToBuild>400</WorkToBuild>
      <Flammability>1.0</Flammability>
      <Beauty>-2</Beauty>
    </statBases>
    <costList>
      <WoodLog>20</WoodLog>
    </costList>
    <building>
      <!-- Not an edifice: an edifice would block the fill-in designator on its cell. -->
      <isEdifice>false</isEdifice>
      <expandHomeArea>false</expandHomeArea>
    </building>
    <comps>
      <!-- LADDER_PRISON_DOOR_1 + FLOWWORKS_LADDER_RAISE_LOWER_1: raised/lowered by the player's gizmo,
           prison-door climbing rule. raisedGraphicData is the raised state's own art (ladder slid up the rails,
           empty rails below); the lowered state draws the graphicData above. -->
      <li Class="RimMandrake.FlowWorks.RM_CompProperties_Ladder">
        <raisedGraphicData>
          <texPath>Things/Building/FlowWorks/Canals/RM_LadderRaised</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>(1.5,1.5)</drawSize>
          <drawOffsetNorth>(0,0,0.25)</drawOffsetNorth>
          <drawOffsetEast>(0,0,0.25)</drawOffsetEast>
          <drawOffsetSouth>(0,0,-0.25)</drawOffsetSouth>
          <drawOffsetWest>(0,0,0.25)</drawOffsetWest>
        </raisedGraphicData>
      </li>
    </comps>
    <placeWorkers>
      <li>RimMandrake.FlowWorks.PlaceWorker_LadderOnExcavation</li>
    </placeWorkers>
  </ThingDef>

  <!-- RM_PitRamp — PIT_RAMP_BUILD_STAIRS_BEAT_LADDERS (design/RimMandrake/relative_depth_climb_design_2026-10-12.md §8.4;
       owner 2026-10-12 Q3: "A ramp could take up 1 square but go down up to 3 levels at a time without movement penalty").
       1x1 on a dug square, rotation points UPHILL; joins its square to the one it faces when that is 1..3 levels shallower,
       for everyone, at walking speed (Source/Superdeep/RM_PitRamp.cs). Cost PROVISIONAL (25 wood or stone blocks).
       Art: Graphic_Multi, one picture per facing, each drawn with the high (uphill) end brightest; installed through the
       art ledger 2026-10-15 (owner by card: "Make both today"). Sources: art_source/PitRamp/. -->
  <ThingDef ParentName="BuildingBase">
    <defName>RM_PitRamp</defName>
    <label>pit ramp</label>
    <description>A packed earth-and-timber ramp built in a dug pit, pointing uphill at a neighbouring square up to 1.5 m shallower (a mod setting). Anyone walks it, both ways, at normal walking speed: your people, visitors, enemies and animals alike. A pit with a ramp is a pit people can leave; deconstruct the ramp to seal it again.</description>
    <thingClass>RimMandrake.FlowWorks.RM_Building_PitRamp</thingClass>
    <graphicData>
      <texPath>Things/Building/FlowWorks/Excavation/RM_PitRamp</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
      <!-- The art is already painted earth and timber; the stuff tint would multiply it dark (wood) or grey (stone). -->
      <ignoreThingDrawColor>true</ignoreThingDrawColor>
    </graphicData>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>Standable</passability>
    <fillPercent>0</fillPercent>
    <pathCost>0</pathCost>
    <rotatable>true</rotatable>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <designationCategory>Structure</designationCategory>
    <stuffCategories>
      <li>Woody</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>25</costStuffCount>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>900</WorkToBuild>
      <Flammability>0.5</Flammability>
      <Beauty>-1</Beauty>
    </statBases>
    <building>
      <!-- Not an edifice, as the ladder: an edifice would block the dig and fill-in designators on its square. -->
      <isEdifice>false</isEdifice>
      <expandHomeArea>false</expandHomeArea>
    </building>
    <placeWorkers>
      <li>RimMandrake.FlowWorks.PlaceWorker_PitRamp</li>
    </placeWorkers>
  </ThingDef>

  <!-- RM_Swale — CRACKEDLANDS_MECHANICS_BUILD_1 §1 (owner sitting 2026-09-28). A graded,
       perforated liner laid in a dug channel: while its cell carries water it walks the ground
       within two cells up the fertility ladder below, one rung at a time, capped at the top rung,
       never while dry (Source/Swale/RM_Swale.cs). RM_ tier, a normal buildable; the Utinni
       campaign lock is CRACKEDLANDS_SWALE_CAMPAIGN_LOCK_1 (blocked on the survey loop).
       PROVISIONAL numbers (owner ruling 2026-10-03: first guesses, tuned live): radius 2.9,
       one rung per fed day. Art: fwart_RM_Swale (a perforated liner in a dug channel). -->
  <ThingDef ParentName="BuildingBase">
    <defName>RM_Swale</defName>
    <label>swale</label>
    <description>A graded, perforated liner laid in a dug channel. While water stands in it, it seeps into the ground around it, and over days the sand within a couple of paces turns to soil and the soil to rich soil. It does nothing dry, and it never makes ground richer than rich soil.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/FlowWorks/Canals/RM_Swale</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>Standable</passability>
    <fillPercent>0</fillPercent>
    <pathCost>0</pathCost>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <tickerType>Rare</tickerType>
    <designationCategory>Structure</designationCategory>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>600</WorkToBuild>
      <Flammability>0.5</Flammability>
      <Beauty>0</Beauty>
    </statBases>
    <costList>
      <WoodLog>15</WoodLog>
    </costList>
    <building>
      <!-- Not an edifice, same as the ladder: liquid and the fill-in designator still reach the cell. -->
      <isEdifice>false</isEdifice>
      <expandHomeArea>false</expandHomeArea>
    </building>
    <comps>
      <li Class="RimMandrake.FlowWorks.CompProperties_Swale">
        <ladder>
          <li>Sand</li>
          <li>Soil</li>
          <li>SoilRich</li>
        </ladder>
        <radius>2.9</radius>
        <ticksPerStep>60000</ticksPerStep>
      </li>
    </comps>
    <placeWorkers>
      <li>RimMandrake.FlowWorks.PlaceWorker_SwaleOnExcavation</li>
    </placeWorkers>
  </ThingDef>

  <!-- CANAL_BOTTOM_SPIKES_1 — spikes are per-cell hardware on a superdeep (D = 4) canal floor, the
       ladder's shape: a Thing in the cell + placeworker + RM_SpikeUtility.HasSpikes. Owner Q2
       2026-10-02 (by card): D = 4 only. Fire on descent only (RM_SuperdeepTrap.PitDescent), three
       Sharp hits scaled by body size (numbers PROVISIONAL in RM_PitTrapMath: first guesses, tuned live later, owner ruling 2026-10-03).
       Art: Canals/RM_Spikes/ random pool (spokes_v3a/b/c). -->
  <ThingDef ParentName="BuildingBase">
    <defName>RM_Spikes</defName>
    <label>pit spikes</label>
    <description>Sharpened stakes driven into a pit floor. Whoever falls, is pushed or jumps into this cell lands on them: several deep stab wounds, worse for bigger creatures, armour still counts. Walking up to the edge, or moving along the pit floor, is safe. Can only be built at the foot of a sheer drop of 2 m or more (a mod setting), at any depth.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <!-- PIT_SPIKES_REDRAW_SPOKES_NOT_LOGS (owner 2026-10-21, sheet spikes_ladders_redraw: "Accept B, C, D as random
           pool variants"): a folder of three spoke clusters; Graphic_Random picks per thing by thingIDNumber % 3,
           stable across saves and reloads. -->
      <texPath>Things/Building/FlowWorks/Canals/RM_Spikes</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <fillPercent>0</fillPercent>
    <pathCost>0</pathCost>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <designationCategory>Structure</designationCategory>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>600</WorkToBuild>
      <Flammability>1.0</Flammability>
      <Beauty>-4</Beauty>
    </statBases>
    <costList>
      <WoodLog>30</WoodLog>
    </costList>
    <building>
      <!-- Not an edifice, like the ladder: an edifice would block the fill-in designator. -->
      <isEdifice>false</isEdifice>
      <expandHomeArea>false</expandHomeArea>
    </building>
    <placeWorkers>
      <li>RimMandrake.FlowWorks.PlaceWorker_SpikesOnSuperdeep</li>
    </placeWorkers>
  </ThingDef>

  <!-- RM_PitGuardrail — FALL_GUARDRAILS_BUILD_REAL_OBJECT (owner 2026-10-18: "build guardrails as a real object with real
       need (and support existing fences acting this way too)"). A low railing on the lip of a sheer drop: it stops falls
       over its edges (RM_FallRails; any isFence building does the same), never walking along the lip or climbing out.
       Not a fence (isFence would pen animals) and not an edifice (the dig and fill-in designators stay usable on a ledge).
       Art: vanilla fence art, first pass (a bespoke look is the owner's call: art item GUARDRAIL_ART_RESKIN_BORROWED_FENCE).
       Cost and HP PROVISIONAL. -->
  <ThingDef ParentName="BuildingBase">
    <defName>RM_PitGuardrail</defName>
    <label>pit guardrail</label>
    <description>A low railing of posts and a top bar, built on the lip of a sheer drop. Nobody walks off a railed edge, and a blast that would throw someone over it stops them at the rail. People still walk along the lip and climb up past it, and anyone may still jump in on purpose. It does not stop a pit cover giving way. Any fence standing on a lip works the same way.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Linked/Fence</texPath>
      <graphicClass>Graphic_Appearances</graphicClass>
      <linkType>Asymmetric</linkType>
      <linkFlags>
        <li>Fences</li>
      </linkFlags>
      <asymmetricLink>
        <linkFlags>
          <li>Wall</li>
          <li>Rock</li>
        </linkFlags>
        <linkToDoors>true</linkToDoors>
      </asymmetricLink>
      <shadowData>
        <volume>(0.3, 0.5, 0.3)</volume>
        <offset>(0,0,-0.23)</offset>
      </shadowData>
      <damageData>
        <rect>(0.35,0.1,0.3,0.7)</rect>
      </damageData>
    </graphicData>
    <uiIconPath>Things/Building/Linked/Fence_MenuIcon</uiIconPath>
    <uiIconPathsStuff>
      <li>
        <appearance>Metal</appearance>
        <iconPath>Things/Building/Linked/FenceMetal_MenuIcon</iconPath>
      </li>
    </uiIconPathsStuff>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>20</pathCost>
    <fillPercent>0.2</fillPercent>
    <blockWind>false</blockWind>
    <blockLight>false</blockLight>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <tickerType>Never</tickerType>
    <drawStyleCategory>Defenses</drawStyleCategory>
    <designationCategory>Structure</designationCategory>
    <canOverlapZones>false</canOverlapZones>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>2</costStuffCount>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <WorkToBuild>90</WorkToBuild>
      <Flammability>1.0</Flammability>
    </statBases>
    <building>
      <isEdifice>false</isEdifice>
      <isInert>true</isInert>
      <expandHomeArea>false</expandHomeArea>
      <ai_chillDestination>false</ai_chillDestination>
      <blueprintGraphicData>
        <texPath>Things/Building/Linked/Fence_Blueprint</texPath>
        <graphicClass>Graphic_Appearances</graphicClass>
      </blueprintGraphicData>
    </building>
    <placeWorkers>
      <li>RimMandrake.FlowWorks.PlaceWorker_PitGuardrail</li>
    </placeWorkers>
  </ThingDef>

</Defs>
