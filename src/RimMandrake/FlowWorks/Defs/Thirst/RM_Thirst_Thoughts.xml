<?xml version="1.0" encoding="utf-8"?>
<!-- THIRST_BUILD_OWN_BOTTLES_DUBS_FRIENDLY design §2: need-level moods (the shape of vanilla Hungry), and the one positive
     thought: distilled water. No positive thought for plain water. -->
<Defs>
  <ThoughtDef>
    <defName>RM_Thought_Thirsty</defName>
    <workerClass>RimMandrake.FlowWorks.Thirst.ThoughtWorker_RM_Thirsty</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>thirsty</label>
        <description>My mouth is dry. I need a drink.</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RM_Thought_Parched</defName>
    <workerClass>RimMandrake.FlowWorks.Thirst.ThoughtWorker_RM_Parched</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>parched</label>
        <description>I can't think about anything but water.</description>
        <baseMoodEffect>-10</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RM_Thought_Dehydrated</defName>
    <workerClass>RimMandrake.FlowWorks.Thirst.ThoughtWorker_RM_Dehydrated</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>dehydrated</label>
        <description>There's no water in me. My head pounds and the world swims.</description>
        <baseMoodEffect>-18</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RM_Thought_DrankDistilled</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>0.5</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>drank distilled water</label>
        <description>Clean, clear water. Nothing in it but water.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <!-- THIRST_RULES_BUILD_SALT_OFF_THE_MENU, owner Q1 2026-10-17: "Only where it's awkward and difficult is penalized, like on
       travel or out in the field." Small (PROVISIONAL -3 for six hours). Q3: hardy pawns never mind (nullifyingTraits);
       Q4: wild people, animals and tribal folk are exempted in code (RM_ThirstMath.RoughExempt). -->
  <ThoughtDef>
    <defName>RM_Thought_DrankRough</defName>
    <durationDays>0.25</durationDays>
    <stackLimit>1</stackLimit>
    <nullifyingTraits>
      <li>Ascetic</li>
      <li>Tough</li>
      <li>Undergrounder</li>
    </nullifyingTraits>
    <stages>
      <li>
        <label>drank rough</label>
        <description>No cup, no tap, no proper place to drink. Just a mouthful scooped out of whatever was there.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
</Defs>
