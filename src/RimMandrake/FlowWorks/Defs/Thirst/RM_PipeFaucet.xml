<?xml version="1.0" encoding="utf-8"?>
<!--
  PIPE_FAUCET_BUILD_TAP_NAME_NOW_FREE (owner-filed 2026-10-22): a faucet set ON a universal pipe. It holds nothing: colonists
  drink at it and fill empty containers at it, every litre drawn from the tanks on its pipe network (the store a machine on
  that pipe draws from; Dump tanks never give). Thirst treats it as a tap: free at home, awkward away (owner Q1 2026-10-17).
  Code: Source/Thirst/Building_RM_PipeFaucet.cs. Setting: RM_ThirstSettings.pipeFaucetsEnabled.
  ART (FAUCET_REDRAW_BORROWED_BLEED_WELL): four top-view looks on the pipe, one ThingStyleDef per pipe look (like the sprinkler
  head); a new faucet takes the look of the pipe it is set on (RM_SprinklerLook.MatchPipeUnder). Cost, work and HP PROVISIONAL.
-->
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>RM_PipeFaucet</defName>
    <label>pipe faucet</label>
    <description>A tap set on a universal pipe. Colonists drink at it and fill empty bottles, buckets and barrels at it; every drop comes from the tanks on its pipe network, so it pours whatever those tanks hold and give (a tank set to dump gives nothing). At home, drinking at a tap is as civilized as it gets.</description>
    <thingClass>RimMandrake.FlowWorks.Thirst.Building_RM_PipeFaucet</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>RimMandrake/FlowWorks/Faucet/Scrapper/RM_PipeFaucet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <drawOffset>(0,0,0.016)</drawOffset>
      <damageData>
        <rect>(0.3,0.3,0.4,0.4)</rect>
      </damageData>
    </graphicData>
    <uiIconPath>RimMandrake/FlowWorks/Faucet/Scrapper/RM_PipeFaucet</uiIconPath>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>20</pathCost>
    <fillPercent>0.2</fillPercent>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <tickerType>Never</tickerType>
    <useHitPoints>true</useHitPoints>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <clearBuildingArea>false</clearBuildingArea>
    <designationCategory>VCHE_PipeNetworks</designationCategory>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>      <!-- PROVISIONAL -->
      <WorkToBuild>300</WorkToBuild>       <!-- PROVISIONAL -->
      <Flammability>0.2</Flammability>
      <Beauty>0</Beauty>
      <Mass>3</Mass>
    </statBases>
    <costList>
      <Steel>10</Steel>                    <!-- PROVISIONAL -->
    </costList>
    <placeWorkers>
      <li>RimMandrake.FlowWorks.Sprinklers.PlaceWorker_RM_OnPipe</li>
    </placeWorkers>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
      <expandHomeArea>false</expandHomeArea>
    </building>
    <comps>
      <li Class="CompProperties_Styleable" />
      <li Class="CompProperties_Forbiddable" />
    </comps>
  </ThingDef>

  <ThingStyleDef>
    <defName>RM_PipeFaucet_Scrapper</defName>
    <label>scrapper</label>
    <uiIconPath>RimMandrake/FlowWorks/Faucet/Scrapper/RM_PipeFaucet</uiIconPath>
    <graphicData>
      <texPath>RimMandrake/FlowWorks/Faucet/Scrapper/RM_PipeFaucet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <!-- drawOffset z = (clamp_y - 128)/256: the saddle clamp's centre on the pipe axis, measured on this look's 2026-10-23 art (Scrapper 132, Industrial 139, Modern 140, Futuristic 124 px of 256) -->
      <drawOffset>(0,0,0.016)</drawOffset>
    </graphicData>
  </ThingStyleDef>

  <ThingStyleDef>
    <defName>RM_PipeFaucet_Industrial</defName>
    <label>industrial</label>
    <uiIconPath>RimMandrake/FlowWorks/Faucet/Industrial/RM_PipeFaucet</uiIconPath>
    <graphicData>
      <texPath>RimMandrake/FlowWorks/Faucet/Industrial/RM_PipeFaucet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <!-- drawOffset z = (clamp_y - 128)/256: the saddle clamp's centre on the pipe axis, measured on this look's 2026-10-23 art (Scrapper 132, Industrial 139, Modern 140, Futuristic 124 px of 256) -->
      <drawOffset>(0,0,0.043)</drawOffset>
    </graphicData>
  </ThingStyleDef>

  <ThingStyleDef>
    <defName>RM_PipeFaucet_Modern</defName>
    <label>modern</label>
    <uiIconPath>RimMandrake/FlowWorks/Faucet/Modern/RM_PipeFaucet</uiIconPath>
    <graphicData>
      <texPath>RimMandrake/FlowWorks/Faucet/Modern/RM_PipeFaucet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <!-- drawOffset z = (clamp_y - 128)/256: the saddle clamp's centre on the pipe axis, measured on this look's 2026-10-23 art (Scrapper 132, Industrial 139, Modern 140, Futuristic 124 px of 256) -->
      <drawOffset>(0,0,0.047)</drawOffset>
    </graphicData>
  </ThingStyleDef>

  <ThingStyleDef>
    <defName>RM_PipeFaucet_Futuristic</defName>
    <label>futuristic</label>
    <uiIconPath>RimMandrake/FlowWorks/Faucet/Futuristic/RM_PipeFaucet</uiIconPath>
    <graphicData>
      <texPath>RimMandrake/FlowWorks/Faucet/Futuristic/RM_PipeFaucet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <!-- drawOffset z = (clamp_y - 128)/256: the saddle clamp's centre on the pipe axis, measured on this look's 2026-10-23 art (Scrapper 132, Industrial 139, Modern 140, Futuristic 124 px of 256) -->
      <drawOffset>(0,0,-0.016)</drawOffset>
    </graphicData>
  </ThingStyleDef>

  <JobDef>
    <defName>RM_DrinkFromFaucet</defName>
    <driverClass>RimMandrake.FlowWorks.Thirst.JobDriver_RM_DrinkFromFaucet</driverClass>
    <reportString>drinking at TargetA.</reportString>
    <suspendable>false</suspendable>
  </JobDef>

  <JobDef>
    <defName>RM_FillAtFaucet</defName>
    <driverClass>RimMandrake.FlowWorks.Thirst.JobDriver_RM_FillAtFaucet</driverClass>
    <reportString>filling a container at a faucet.</reportString>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

  <WorkGiverDef>
    <defName>RM_FillAtFaucetWorkGiver</defName>
    <label>fill containers at a faucet</label>
    <giverClass>RimMandrake.FlowWorks.Thirst.WorkGiver_RM_FillAtFaucet</giverClass>
    <workType>Hauling</workType>
    <verb>fill</verb>
    <gerund>filling a container at a faucet</gerund>
    <priorityInType>47</priorityInType>
    <scanCells>false</scanCells>
    <scanThings>true</scanThings>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

</Defs>
