<Project Sdk="Microsoft.NET.Sdk">

  <!--
    GRAVSHIP_ACOUSTIC_SCANNER_1. Same recipe as
    src/RimMandrake/Stillsand/Source/RM_Stillsand.csproj.

    Build (the dotnet is WINDOWS-NATIVE and cannot take a /mnt/d path):
      /mnt/c/Users/Mandrake/.dotnet/dotnet.exe build D:\Luke\dev\Rimworld\src\RimMandrake\AcousticScanner\Source\RM_AcousticScanner.csproj -c Release

    Output lands in ../Assemblies/. No Harmony: the sounder is a Building
    subclass wired by thingClass, the overlay a MapComponent (auto-instantiated
    per map), the payload a DefModExtension on each BiomeDef.
    EnableDefaultCompileItems is false: a new .cs needs a Compile line here.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrake.AcousticScanner</AssemblyName>
    <RootNamespace>RimMandrake.AcousticScanner</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="RM_AcousticScannerMod.cs" />
    <Compile Include="RM_AcousticPayloadExtension.cs" />
    <Compile Include="RM_AcousticBanding.cs" />
    <Compile Include="RM_MapComponent_AcousticReading.cs" />
    <Compile Include="RM_Building_AcousticSounder.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
