<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TheRot offline fuzz (Approach B, same shape as DivingInteraction/Droidworks/Abyss). Plain net8.0, zero RimWorld/Unity
    references: ..\RM_TheRotKernel.cs is the PRODUCTION file the mod compiles, pulled in directly. If a `using Verse;` ever lands
    in it, this build breaks - the guard rail working. NOT the mod build: RM_TheRot.csproj one directory up lists its files
    explicitly and never mentions this folder.
    Run (builds on Windows via winbuild staging, then runs the exe):
      python3 src/RimMandrake/Utils/selftest_therot_fuzz.py [fuzz knobs]
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RimMandrakeTheRot.Fuzz</AssemblyName>
    <RootNamespace>RimMandrake.TheRot.Fuzz</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\RM_TheRotKernel.cs" />
    <Compile Include="TheRotFuzz.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
