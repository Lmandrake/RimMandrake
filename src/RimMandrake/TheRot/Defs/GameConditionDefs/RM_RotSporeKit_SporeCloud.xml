<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Ported from BiomesCaverns_src 1.6/Defs/Incidents/BMT_GameConditions_SporeCloud.xml
    + 1.6/Defs/Incidents/BMT_Incidents.xml's BMT_SporeCloud IncidentDef.

    ROT_SPORECLOUD_PORT_1: conditionClass now points at our own
    RimMandrake.EnvironmentalHazards.GameCondition_EnvironmentalWeather
    (ALPHA_MECHANICS_KIT_1) rather than the donor's compiled
    BiomesCaverns.GameCondition_SporeCloud — the donor dependency
    (FUNGALFOREST_RAID_MERGE_1's owed item) is retired.

    Donor behaviour (GameCondition_SporeCloud.cs, DoPawnToxicDamage):
    unroofed pawns take BMT_SporesBuildup severity 0.023 every 3451 ticks
    (~0.96 in-game hours), scaled by ToxicResistance/ToxicEnvironmentResistance
    and a per-pawn 0.85-1.15 random factor the extension has no field for —
    reproduced here as a flat hediffSeverityPerInterval/damageIntervalTicks
    pair (the extension's config surface, not the donor's per-pawn RNG/stat
    scaling). AnimalDensityFactor 0.2, PlantDensityFactor 1.5 and
    AllowEnjoyableOutsideNow false carry over unchanged — all three are
    virtuals GameCondition_EnvironmentalWeather already exposes as config.
    onlyUnroofed defaults true on the extension, matching the donor's
    protectedByRoof gate. affects=Flesh (PawnTargetKind, HazardTargeting.cs)
    is IsFlesh-only, which already excludes mechanoids while including
    animals — "animals included; exempt mechanoids" per spec, no override
    needed beyond the explicit default for documentation.

    IncidentDef now fires through RUT_IncidentWorker_SporeCloud
    (RimMandrake.EnvironmentalHazards) instead of the bare vanilla
    IncidentWorker_MakeGameCondition — MOD_OPTIONS_RETROFIT_1's incident-weight
    toggle (RM_EnvironmentalHazardsSettings.sporeCloudEnabled), same one-line
    gate RM_IncidentWorker_Breaklight already established for exactly this
    situation (a rare incident-fired event has no other on/off hook).

    disallowedBiomes dropped the donor's own cavern biomes (not ours to gate)
    and instead excludes RM_TheRot itself — the biome already reads as a
    permanent Sheen-fall/spore-event source per its own sheet
    (the_rot.md §4b); a second, unrelated "spore cloud" incident firing
    there would be redundant.
  -->

  <GameConditionDef MayRequire="mandrake.rm.environmentalhazards">
    <defName>RM_SporeCloud</defName>
    <conditionClass>RimMandrake.EnvironmentalHazards.GameCondition_EnvironmentalWeather</conditionClass>
    <label>spore cloud</label>
    <description>A cloud of fungal spores from some distant source is slowly settling over this entire region. Any living thing not under a roof will be suffocating.</description>
    <descriptionFuture>a cloud of fungal spores will blanket the area around [map_definite] for [gameConditionDuration_duration], killing outdoor animal life.</descriptionFuture>
    <endMessage>The worst of the fungal spores has settled.</endMessage>
    <letterText>A distant fungal forest has released a plume of spores over this entire region.\n\nAny person or creature not under a roof will be slowly suffocating by the fungal spores settling out of the atmosphere.\n\nIt will last for anywhere between a few days to over a quadrum.</letterText>
    <letterDef>NegativeEvent</letterDef>
    <canBePermanent>true</canBePermanent>
    <modExtensions>
      <li Class="RimMandrake.EnvironmentalHazards.EnvironmentalWeatherExtension">
        <hediffToApply>RM_SporesBuildup</hediffToApply>
        <hediffSeverityPerInterval>0.023</hediffSeverityPerInterval>
        <damageIntervalTicks>3451</damageIntervalTicks>
        <onlyUnroofed>true</onlyUnroofed>
        <affects>Flesh</affects>
        <animalDensityFactor>0.2</animalDensityFactor>
        <plantDensityFactor>1.5</plantDensityFactor>
        <allowEnjoyableOutside>false</allowEnjoyableOutside>
      </li>
    </modExtensions>
  </GameConditionDef>

  <IncidentDef MayRequire="mandrake.rm.environmentalhazards">
    <defName>RM_SporeCloud</defName>
    <label>spore cloud</label>
    <category>Misc</category>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>RimMandrake.EnvironmentalHazards.RUT_IncidentWorker_SporeCloud</workerClass>
    <gameCondition>RM_SporeCloud</gameCondition>
    <letterLabel>Spore cloud</letterLabel>
    <letterDef>ThreatSmall</letterDef>
    <baseChance>0.06</baseChance>
    <earliestDay>60</earliestDay>
    <minRefireDays>90</minRefireDays>
    <disallowedBiomes>
      <li>RM_TheRot</li>
      <!-- THEROT_RM_MOD_BUILD_1 §7(b)(3): RUT_TheRot still carries the player's
           live world until the terminal paint (BIOME_PAINT_ONCE_AT_THE_END_1) —
           without this second entry the spore-cloud incident would start firing
           on its own home biome the moment this mod loads alongside the frozen
           twin. Drop this line only when Phase B repaints RUT_TheRot away. -->
      <li>RUT_TheRot</li>
    </disallowedBiomes>
    <disabledWhen>
      <extremeWeatherIncidentsDisabled>true</extremeWeatherIncidentsDisabled>
    </disabledWhen>
    <durationDays>2.5~10.5</durationDays>
    <tale>ToxicFallout</tale>
  </IncidentDef>
</Defs>
