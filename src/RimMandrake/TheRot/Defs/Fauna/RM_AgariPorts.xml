<!--
  RM_AgariPorts.xml — the rennok, the gromma and the vorrugath. DONOR_CODE_PLAIN_PORTS_1 (owner pick
  "port" on Transient/donor_code_creatures_sheet_2026-10-09: "Port plain = copy the creature into our
  own defs and drop or swap the donor class (no new C#)").

  Ported from Alpha Animals (sarg.alphaanimals, 1.6/Defs/ThingDefs_Races/Races_Agaripawn.xml,
  Races_Agaripod.xml, Races_MycoidColossus.xml). Folded in from this mod's own patches on the donor
  defs, so the port reads the same as the patched donor did:
    - names, descriptions and ruled adult widths  (Patches/RotSpecies_NamesAndSizes.xml, ROT_FLORA_FAUNA_VERDICTS_1)
    - our art paths RotSpecies/Agaripawn, RotSpecies/MycoidColossus  (same file)
    - wound sharing on rennok and gromma  (Patches/RotSpecies_WoundSharing.xml, ROT_WOUND_SHARING_WIRING_1;
      RM_TheRotMod's Health sharing toggle names these RM_ defs too)
  Those patches still target the AA_ defs and stay: the frozen campaign twin RUT_TheRot casts the donor.

  DROPPED (donor assembly AlphaBehavioursAndEvents): CompProperties_GraphicsRefresher and renderTree
  AA_Alternates — an off-by-default alternate-picture switch; nothing in play.
  DROPPED (donor StatDefs): the VEF AnimalStatExtension info-card rows.  NOT ported: donor wildBiomes.
  DROPPED: VEF_CycleSeverance special trainable; the rennok's VEF drop-on-death of one fungus (butchering
  still yields fungus).
  SWAPPED for vanilla (donor defs, no code):
    AA_ToxicBite -> ToxicBite · AA_AgariluxRawFungus -> RawFungus · AA_Wildpawn_* sounds -> Pawn_Bear_*
    AA_PermanentBurn (HighlyFlammable's hediff) -> Burn · donor dessicated art -> Bear / Elephant / Thrumbo
    body AA_Hexapod (vorrugath) -> QuadrupedAnimalWithHooves (Teeth + HeadAttackTool present)
    spore-clump eggs (AA_*Spores) -> VEF asexual reproduction with produceEggs false: the young appear
    directly instead of as a hatching clump.
  KEPT, guarded on VEF (a framework we keep): asexual reproduction, HighlyFlammable, cap-flesh harvest.
  ART: ours. Rennok and vorrugath use this mod's RotSpecies art; the gromma's is installed through the
  art ledger at Things/Pawn/Animal/RM_Agaripod (the picture AgaripodArtOverride paints over the donor).
-->
<Defs>

  <!-- ============================== rennok (AA_Agaripawn) ============================== -->
  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Agaripawn</defName>
    <label>rennok</label>
    <description>A shambling, waist-high hybrid of animal and fungus, its back and flanks grown over with living caps that feed it and hide it. It is slow, flammable, and never quite alone: hurt one and the others in the grove feel it and come. It breeds by throwing spores, so its young owe it nothing. Hunted or kept, it gives a little edible cap-flesh that keeps longer than most fungus.</description>
    <statBases>
      <MoveSpeed>4</MoveSpeed>
      <ComfyTemperatureMin>-15</ComfyTemperatureMin>
      <MarketValue>200</MarketValue>
      <LeatherAmount>0</LeatherAmount>
      <ArmorRating_Blunt>.75</ArmorRating_Blunt>
      <ArmorRating_Heat>-100</ArmorRating_Heat>
      <ArmorRating_Sharp>.75</ArmorRating_Sharp>
      <FilthRate>8</FilthRate>
      <Wildness>0.75</Wildness>
    </statBases>
    <tools>
      <li>
        <label>left paw</label>
        <capacities><li>Blunt</li></capacities>
        <power>11</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
        <surpriseAttack><extraMeleeDamages><li><def>Stun</def><amount>13</amount></li></extraMeleeDamages></surpriseAttack>
      </li>
      <li>
        <label>right paw</label>
        <capacities><li>Blunt</li></capacities>
        <power>11</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup>
        <surpriseAttack><extraMeleeDamages><li><def>Stun</def><amount>13</amount></li></extraMeleeDamages></surpriseAttack>
      </li>
      <li>
        <capacities><li>ToxicBite</li></capacities>
        <power>6</power>
        <cooldownTime>1.65</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
      </li>
      <li>
        <label>head</label>
        <capacities><li>Blunt</li></capacities>
        <power>3</power>
        <cooldownTime>1.65</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <comps>
      <li Class="VEF.AnimalBehaviours.CompProperties_AsexualReproduction" MayRequire="OskarPotocki.VanillaFactionsExpanded.Core">
        <reproductionIntervalDays>6</reproductionIntervalDays>
        <customString>Dispersing spores in: </customString>
        <produceEggs>false</produceEggs>
      </li>
      <li Class="VEF.AnimalBehaviours.CompProperties_HighlyFlammable" MayRequire="OskarPotocki.VanillaFactionsExpanded.Core">
        <hediffToInflict>Burn</hediffToInflict>
      </li>
      <li Class="VEF.AnimalBehaviours.CompProperties_AnimalProduct" MayRequire="OskarPotocki.VanillaFactionsExpanded.Core">
        <resourceDef>RawFungus</resourceDef>
        <gatheringIntervalDays>10</gatheringIntervalDays>
        <resourceAmount>20</resourceAmount>
      </li>
      <li Class="RimMandrake.CreatureBehaviors.CompProperties_WoundLink" />
      <li Class="RimMandrake.CreatureBehaviors.CompProperties_GrantHediff">
        <inspectLine>Shares wounds with its grove.</inspectLine>
      </li>
    </comps>
    <race>
      <herdAnimal>false</herdAnimal>
      <body>QuadrupedAnimalWithPaws</body>
      <baseBodySize>1.4</baseBodySize>
      <baseHealthScale>1.3</baseHealthScale>
      <baseHungerRate>0.2</baseHungerRate>
      <foodType>VegetarianRoughAnimal</foodType>
      <hasGenders>false</hasGenders>
      <manhunterOnTameFailChance>0.018</manhunterOnTameFailChance>
      <trainability>Intermediate</trainability>
      <lifeExpectancy>35</lifeExpectancy>
      <specificMeatDef>RawFungus</specificMeatDef>
      <lifeStageAges>
        <li><def>AnimalBaby</def><minAge>0</minAge></li>
        <li><def>AnimalJuvenile</def><minAge>0.25</minAge></li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.5</minAge>
          <soundWounded>Pawn_Bear_Injured</soundWounded>
          <soundDeath>Pawn_Bear_Death</soundDeath>
          <soundCall>Pawn_Bear_Call</soundCall>
          <soundAngry>Pawn_Bear_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
    </race>
    <tradeTags>
      <li>AnimalExotic</li>
    </tradeTags>
    <modExtensions>
      <li Class="RimMandrake.CreatureBehaviors.RM_WoundLinkExtension">
        <tag>RotNetwork</tag>
      </li>
    </modExtensions>
  </ThingDef>

