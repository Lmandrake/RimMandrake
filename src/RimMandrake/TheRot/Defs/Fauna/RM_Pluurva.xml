<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
  RM_Pluurva: owned RM_ port of the Alpha Animals AnimaColossus (sarg.alphaanimals AA_AnimaColossus, 1.6/Defs/ThingDefs_Races). Phase 0 step P2 (biome_sprint_kickoff_2026-10-15.md 0.5.3), tool src/RimMandrake/Utils/aa_port.py. Free RM_ tier, home mod TheRot.
  Stats, tools, race fields and pawnkind numbers are the donor's own, as the creature the game shows today
  (our rename/tolerance patches on the donor def are folded in). Departures:
    - wildBiomes dropped (the biome roster casts it); AnimalStatExtension (donor stat defs) dropped.
    - VEF.* comps and VEF_ abilities kept, guarded MayRequire OskarPotocki.VanillaFactionsExpanded.Core (a framework we keep, not the donor).
    - texPath is OUR final path; the PNGs are owed through artpipe (no donor art is reused). Until the art is
      installed through the art ledger this def has no picture: ART OWED, never a pass of the art bar.
    - dessicated donor art and alternate random graphics dropped (vanilla fallback).
    - folded 9 op(s) from src/RimMandrake/TheRot/Patches/RotSpecies_NamesAndSizes.xml
    - folded 2 op(s) from src/RimUtinni/UtinniPatches/Patches/AnimalTolerances_Ashkarr.xml
    - comp VEF.AnimalBehaviours.CompProperties_AttachEffecter dropped (cosmetic effecter; its flecks would owe art)
    - useMeatFrom AA_OvergrownColossus -> Elephant (vanilla; PROVISIONAL)
    - customResourceString AA_Wood -> 'wood' (donor translation key replaced by the words)
-->
  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Pluurva</defName>
    <label>pluur'va</label>
    <description>A walking hill: a cold-blooded, six-legged reptile with two spines twisted around each other and six small eyes, so long that it takes a moment to see where it ends. Trees and tall mushrooms grow rooted along its back and feed it in return for the ride. It moves slowly, eats slowly and is very hard to stop. Tamed, it can be trimmed for wood from the grove on its back, and very rarely it sheds a hardened pearl that grows into an anima tree when planted.</description>
    <statBases>
      <MoveSpeed>2.00</MoveSpeed>
      <ComfyTemperatureMin>-53.8</ComfyTemperatureMin>
      <MarketValue>650</MarketValue>
      <MeatAmount>30</MeatAmount>
      <LeatherAmount>30</LeatherAmount>
      <FilthRate>16</FilthRate>
      <Wildness>0.91</Wildness>
      <ComfyTemperatureMax>40</ComfyTemperatureMax>
    </statBases>
    <tools>
      <li>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>20</power>
        <cooldownTime>1.85</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>15</power>
        <cooldownTime>1.65</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <comps>
      <li Class="VEF.AnimalBehaviours.CompProperties_AnimalProduct" MayRequire="OskarPotocki.VanillaFactionsExpanded.Core">
        <resourceDef>WoodLog</resourceDef>
        <gatheringIntervalDays>15</gatheringIntervalDays>
        <resourceAmount>50</resourceAmount>
        <customResourceString>wood</customResourceString>
      </li>
    </comps>
    <race>
      <body>RM_Hexapod</body>
      <baseBodySize>6</baseBodySize>
      <baseHealthScale>2.7</baseHealthScale>
      <baseHungerRate>0.4</baseHungerRate>
      <foodType>VegetarianRoughAnimal</foodType>
      <trainability>Intermediate</trainability>
      <manhunterOnDamageChance>.75</manhunterOnDamageChance>
      <useMeatFrom>Elephant</useMeatFrom>
      <leatherDef>Leather_Lizard</leatherDef>
      <gestationPeriodDays>15</gestationPeriodDays>
      <lifeExpectancy>620</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.25</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.5</minAge>
          <soundWounded>Pawn_Rhinoceros_Wounded</soundWounded>
          <soundDeath>Pawn_Rhinoceros_Death</soundDeath>
          <soundCall>Pawn_Rhinoceros_Call</soundCall>
          <soundAngry>Pawn_Rhinoceros_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <tradeTags>
      <li>AnimalUncommon</li>
      <li>AnimalFighter</li>
    </tradeTags>
  </ThingDef>
