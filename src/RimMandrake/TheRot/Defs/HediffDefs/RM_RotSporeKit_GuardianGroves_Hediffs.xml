<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    ROT_GUARDIAN_GROVES_1. RM_MatGrip — the "short immobilize hediff" the
    spec's own M6 text calls for, applied by
    RimMandrake.CreatureBehaviors.RM_Plant_FalseFruit.PlantCollected when a
    RM_FalseFruit lure is harvested/cut. HediffCompProperties_Disappears
    times it out on its own; capMods do the immobilizing (near-zero Moving,
    same mechanism vanilla traps/tentacles use). INVENTED: 6-10 seconds
    (360-600 ticks) and a 0.05 Moving cap — long enough to matter against a
    guardian's response, short enough that it is a scare, not a real fight
    disabler.
  -->

  <HediffDef>
    <defName>RM_MatGrip</defName>
    <label>gripped by mat</label>
    <labelNoun>a gripping mat</labelNoun>
    <description>Sticky mycelial threads have closed around an ankle the instant the false fruit was touched. They won't hold forever, but they are not letting go yet.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.55, 0.35, 0.15)</defaultLabelColor>
    <isBad>true</isBad>
    <tendable>false</tendable>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>360~600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <setMax>0.05</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>
