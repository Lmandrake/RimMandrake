<?xml version="1.0" encoding="utf-8"?>
<!--
  ROT_NAVIGATOR_LOG_SITES_1 (Swallowed Navigator part B). Mechanism: Source/RM_NavigatorLog.cs.
  Every N pings (setting navigatorPingsPerEntry, 4) of the swallowed drive core, the next entry of the dead ship's
  flight log is read out as a letter; entries listed in siteEntries also reveal a salvage site
  (RM_NavigatorSalvageSite). campaignSiteTiles: empty = free tier (vanilla tile finder near the colony); the
  campaign patch (UtinniPatches) fills it with authored Ash'karr tiles, used in order.
  lastCampEntry (ROT_WARM_MAT_BUILD_WORKS_FOR_FOOD, owner by card 2026-10-22: the living mat root is a quest reward):
  the last site entry reveals RM_NavigatorLastCamp instead, whose stash also holds a minified RM_LivingMatRoot. Firing
  route: C# only (RM_NavigatorLog.ReadEntry -> TryRevealSite), so validate_quest.py's never-fires warning is expected.
  ENTRY TEXT: DRAFT, written by FOUNDRY 2026-10-03 for the free RM_ tier (no franchise names); BENCH/owner may rewrite.
-->
<Defs>

  <RimMandrake.TheRot.RM_NavigatorLogDef>
    <defName>RM_NavigatorLog</defName>
    <label>the dead ship's log</label>
    <lastCampEntry>8</lastCampEntry>
    <lastCampQuest>RM_NavigatorLastCamp</lastCampQuest>
    <siteEntries>
      <li>2</li>
      <li>4</li>
      <li>6</li>
      <li>8</li>
    </siteEntries>
    <entries>
      <li>Log, day one on the ground. We came down hard in the white country. Hull is whole. The drive coil is whole. The mat under us is warm, like something breathing. Captain says we lift when the fog clears.</li>
      <li>Day four. The fog does not clear; it sticks. We sent the boat out with the spare stores and buried them under a rib of dead fungus a short walk from the ship, marked with a coil housing. If we have to leave in a hurry we leave light.</li>
      <li>Day nine. Something big came through camp in the night. Slow. Pale. It ate the cargo netting, the tarps, the galley. It did not touch us. It left the cutlery in a glossy lump by the ramp, clean as new.</li>
      <li>Day twelve. Pulled the long-range beacon and the med kit off the ship and cached them where the ground goes hard, away from the warm mat. The pale thing only eats what lies in the open. Note for whoever reads this: cover what you keep.</li>
      <li>Day fifteen. Engineer took the drive coil out to clean the spores off it. Left it on the mat for one hour. One hour. It is gone, and the pale thing is lying where it was, and we can hear the coil humming inside it.</li>
      <li>Day sixteen. We did not shoot it. Shoot it and the coil goes with it. We packed the last of the ship's tools into a crate and left them with the beacon cache's twin, further out. We are walking.</li>
      <li>Day twenty. The coil still pings. We can hear it from two hills away when the wind is right. It is following the warm ground, and we are following it. The captain wants it back. I want to go home.</li>
      <li>Last entry. Whoever finds this ship: the coil is good. It will fly. We left everything we could not carry in the last cache, past the third ridge. Cut the beast open gently. It never meant us harm. It just keeps</li>
    </entries>
  </RimMandrake.TheRot.RM_NavigatorLogDef>

  <QuestScriptDef>
    <defName>RM_NavigatorSalvageSite</defName>
    <autoAccept>true</autoAccept>
    <rootSelectionWeight>0</rootSelectionWeight>
    <rootMinPoints>0</rootMinPoints>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->The dead ship's log names a cache its crew left behind, not far from [map_definite]. Salvage worth [itemStashContentsValue]:\n\n[itemStashContents]\n\nIt seems that [allSitePartsDescriptionsExceptFirst]</li>
      </rulesStrings>
    </questDescriptionRules>
    <questNameRules>
      <rulesStrings>
        <li>questName->The [cache] in the log</li>
        <li>cache->Cache</li>
        <li>cache->Crew's Cache</li>
        <li>cache->Ship's Stores</li>
      </rulesStrings>
    </questNameRules>
    <root Class="QuestNode_Sequence">
      <nodes>
        <li Class="QuestNode_SubScript">
          <def>Util_RandomizePointsChallengeRating</def>
          <parms>
            <pointsFactorTwoStar>1.5</pointsFactorTwoStar>
            <pointsFactorThreeStar>2</pointsFactorThreeStar>
          </parms>
        </li>
        <li Class="QuestNode_SubScript">
          <def>Util_GetDefaultRewardValueFromPoints</def>
        </li>
        <li Class="QuestNode_SubScript">
          <def>Util_AdjustPointsForDistantFight</def>
        </li>
        <li Class="QuestNode_GetMap" />
        <li Class="QuestNode_IsSet">
          <name>siteTile</name>
          <elseNode Class="QuestNode_GetSiteTile">
            <storeAs>siteTile</storeAs>
            <preferCloserTiles>true</preferCloserTiles>
          </elseNode>
        </li>
        <!-- Defended always when violent quests are allowed: no free loot from the log. -->
        <li Class="QuestNode_ViolentQuestsAllowed">
          <node Class="QuestNode_Set">
            <name>siteThreatChance</name>
            <value>1</value>
          </node>
          <elseNode Class="QuestNode_Set">
            <name>siteThreatChance</name>
            <value>0</value>
          </elseNode>
        </li>
        <li Class="QuestNode_GetSitePartDefsByTagsAndFaction">
          <storeAs>sitePartDefs</storeAs>
          <storeFactionAs>siteFaction</storeFactionAs>
          <sitePartsTags>
            <li>
              <tag>ItemStash</tag>
            </li>
            <li>
              <tag>ItemStashQuestThreat</tag>
              <chance>$siteThreatChance</chance>
            </li>
          </sitePartsTags>
        </li>
        <li Class="QuestNode_GetDefaultSitePartsParams">
          <tile>$siteTile</tile>
          <faction>$siteFaction</faction>
          <sitePartDefs>$sitePartDefs</sitePartDefs>
          <storeSitePartsParamsAs>sitePartsParams</storeSitePartsParamsAs>
        </li>
        <li Class="QuestNode_SubScript">
          <def>Util_GenerateSite</def>
          <parms>
            <hiddenSitePartsPossible>true</hiddenSitePartsPossible>
          </parms>
        </li>
        <li Class="QuestNode_SpawnWorldObjects">
          <worldObjects>$site</worldObjects>
        </li>
        <li Class="QuestNode_AddItemsReward">
          <items>$generatedItemStashThings</items>
          <inSignalChoiceUsed>site.MapGenerated</inSignalChoiceUsed>
          <generateQuestParts>false</generateQuestParts>
        </li>
        <li Class="QuestNode_NoWorldObject">
          <worldObject>$site</worldObject>
          <node Class="QuestNode_End" />
        </li>
      </nodes>
    </root>
  </QuestScriptDef>

  <!--
    The crew's last camp (ROT_WARM_MAT_BUILD_WORKS_FOR_FOOD). The Rot is generous and hungry and shares everything,
    including you: the crew lay down on the warm mat, it took them in, and where they lay a root of it has knotted.
    Same shape as RM_NavigatorSalvageSite (item stash, defended when violent quests are allowed, no timeout), plus the
    root. Text: DRAFT, FOUNDRY 2026-10-22, free RM_ tier (no franchise names); BENCH/owner may rewrite.
  -->
  <QuestScriptDef>
    <defName>RM_NavigatorLastCamp</defName>
    <autoAccept>true</autoAccept>
    <rootSelectionWeight>0</rootSelectionWeight>
    <rootMinPoints>0</rootMinPoints>
    <everAcceptableInSpace>true</everAcceptableInSpace>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->The dead ship's last entry points past the third ridge from [map_definite]. That is where the crew stopped walking. The warm mat took them in the way it takes everything, gently and completely, and where they lay a root of it has knotted itself, its heart still beating. The Rot shares what it has. Cut the root free and fed, it will warm a room anywhere.\n\nThe crew's last cache lies with it, worth [itemStashContentsValue]:\n\n[itemStashContents]\n\nand a living mat root.\n\nIt seems that [allSitePartsDescriptionsExceptFirst]</li>
      </rulesStrings>
    </questDescriptionRules>
    <questNameRules>
      <rulesStrings>
        <li>questName->[camp] Past the Third Ridge</li>
        <li>camp->The Last Camp</li>
        <li>camp->Where They Lay</li>
        <li>camp->The Warm Bed</li>
      </rulesStrings>
    </questNameRules>
    <root Class="QuestNode_Sequence">
      <nodes>
        <li Class="QuestNode_SubScript">
          <def>Util_RandomizePointsChallengeRating</def>
          <parms>
            <pointsFactorTwoStar>1.5</pointsFactorTwoStar>
            <pointsFactorThreeStar>2</pointsFactorThreeStar>
          </parms>
        </li>
        <li Class="QuestNode_SubScript">
          <def>Util_GetDefaultRewardValueFromPoints</def>
        </li>
        <li Class="QuestNode_SubScript">
          <def>Util_AdjustPointsForDistantFight</def>
        </li>
        <li Class="QuestNode_GetMap" />
        <li Class="QuestNode_IsSet">
          <name>siteTile</name>
          <elseNode Class="QuestNode_GetSiteTile">
            <storeAs>siteTile</storeAs>
            <preferCloserTiles>true</preferCloserTiles>
          </elseNode>
        </li>
        <li Class="QuestNode_ViolentQuestsAllowed">
          <node Class="QuestNode_Set">
            <name>siteThreatChance</name>
            <value>1</value>
          </node>
          <elseNode Class="QuestNode_Set">
            <name>siteThreatChance</name>
            <value>0</value>
          </elseNode>
        </li>
        <li Class="QuestNode_GetSitePartDefsByTagsAndFaction">
          <storeAs>sitePartDefs</storeAs>
          <storeFactionAs>siteFaction</storeFactionAs>
          <sitePartsTags>
            <li>
              <tag>ItemStash</tag>
            </li>
            <li>
              <tag>ItemStashQuestThreat</tag>
              <chance>$siteThreatChance</chance>
            </li>
          </sitePartsTags>
        </li>
        <li Class="QuestNode_GetDefaultSitePartsParams">
          <tile>$siteTile</tile>
          <faction>$siteFaction</faction>
          <sitePartDefs>$sitePartDefs</sitePartDefs>
          <storeSitePartsParamsAs>sitePartsParams</storeSitePartsParamsAs>
        </li>
        <li Class="QuestNode_SubScript">
          <def>Util_GenerateSite</def>
          <parms>
            <hiddenSitePartsPossible>true</hiddenSitePartsPossible>
          </parms>
        </li>
        <li Class="RimMandrake.TheRot.RM_QuestNode_AddMinifiedToStash">
          <thingDef>RM_LivingMatRoot</thingDef>
          <site>$site</site>
        </li>
        <li Class="QuestNode_SpawnWorldObjects">
          <worldObjects>$site</worldObjects>
        </li>
        <li Class="QuestNode_AddItemsReward">
          <items>$generatedItemStashThings</items>
          <inSignalChoiceUsed>site.MapGenerated</inSignalChoiceUsed>
          <generateQuestParts>false</generateQuestParts>
        </li>
        <li Class="QuestNode_NoWorldObject">
          <worldObject>$site</worldObject>
          <node Class="QuestNode_End" />
        </li>
      </nodes>
    </root>
  </QuestScriptDef>

</Defs>
