<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    DONOR RETIREMENT (owner, 2026-10-18: "Just put in placeholder art for now or donor copies and retire these
    mods!!! Just get it done."). The twelve Alpha Biomes (sarg.alphabiomes) mycotic-jungle plants the Rot's roster
    carried, ported as RM_ defs so the donor can leave the mod list. Values are the donor's own; the Rot's campaign
    names and ruled sizes still come from Patches/RotSpecies_NamesAndSizes.xml (retargeted onto these defNames).
    Art: StandIn/<donor texPath> marked stand-in copies (art ledger, provenance kind=donor standin=true) until
    regenerated; RM_Glowstool/RM_GlowingAgarilux/RM_Bryolux are repointed by Patches/RotSpecies_NamesAndSizes.xml to painted art in Textures/RotSpecies/.
    Harvest items the donor defined (coloured raw fungi, psychotropic fungus, poison dart, mushroom stalks) were NOT
    ported: each yields vanilla RawFungus, or our RM_MushroomLog for the stalk-yielders.
  -->
  <ThingDef Name="RM_TheRotPortedCavePlantBase" ParentName="PlantBase" Abstract="True">
    <plant>
      <growMinGlow>0</growMinGlow>
      <growOptimalGlow>0</growOptimalGlow>
      <neverBlightable>true</neverBlightable>
      <wildOrder>1</wildOrder>
      <wildEqualLocalDistribution>false</wildEqualLocalDistribution>
    </plant>
  </ThingDef>

  <!-- RM_Bryolux: port of AB_Bryolux (Alpha Biomes, Plants_MycoticJungle.xml), copied as plain XML 2026-10-18 for donor retirement. -->
  <ThingDef ParentName="RM_TheRotPortedCavePlantBase">
    <defName>RM_Bryolux</defName>
    <label>bryolux</label>
    <description>A blue moss typically found in deep, dark caves. It is sticky, with tangled fibers, which slows anyone walking over it. This bryolux variant has adapted to outside life.</description>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Beauty>1</Beauty>
      <Nutrition>0.15</Nutrition>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/Bryolux</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <selectable>true</selectable>
    <pathCost>35</pathCost>
    <ingestible />
    <plant>
      <fertilityMin>0.95</fertilityMin>
      <fertilitySensitivity>0.15</fertilitySensitivity>
      <growDays>5</growDays>
      <dieIfLeafless>true</dieIfLeafless>
      <maxMeshCount>4</maxMeshCount>
      <neverBlightable>true</neverBlightable>
      <visualSizeRange>0.82~0.95</visualSizeRange>
      <topWindExposure>0.02</topWindExposure>
      <wildClusterRadius>3</wildClusterRadius>
      <wildClusterWeight>5</wildClusterWeight>
    </plant>
  </ThingDef>

