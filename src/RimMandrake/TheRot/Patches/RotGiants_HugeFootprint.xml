<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- HUGE_THINGS_FOOTPRINT_1 — owner ruling 2026-10-07 (option 1, "solid trunk, open canopy"): every Rot
       plant drawn 6+ cells wide gets a solid trunk and a trunk-wide click area from mandrake.rm.hugethings.
       Design + the per-species table: design/RimMandrake/giant_footprint_design_2026-10-07.md. The table is
       pinned by src/RimMandrake/HugeThings/selftest_hugethings_footprint.py; change both together.

       trunkWidth x trunkDepth = cells blocked at full size, from the plant's own cell northward (the
       plant's cell itself stays open so it can be cut and harvested from the south). stemHeight = how far
       north the drawn stem reaches, which is the click area.

       Gated per def by PatchOperationConditional on its own xpath (absent donor = no-op), and the extension
       <li> carries MayRequire="mandrake.rm.hugethings", which the def loader honours on a list element: with
       Huge Things inactive the element is skipped and the plant stays vanilla. (MayRequire on an Operation
       would be inert; it is not used there.) -->

  <!-- AB_AgariluxPrime — grath elder (20 wide): 4x4 trunk, stem 8 -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="AB_AgariluxPrime"]</xpath>
    <match Class="PatchOperationAddModExtension">
      <xpath>/Defs/ThingDef[defName="AB_AgariluxPrime"]</xpath>
      <value>
        <li Class="RimMandrake.HugeThings.RM_HugePlantExtension" MayRequire="mandrake.rm.hugethings">
          <trunkWidth>4</trunkWidth>
          <trunkDepth>4</trunkDepth>
          <stemHeight>8</stemHeight>
        </li>
      </value>
    </match>
  </Operation>

