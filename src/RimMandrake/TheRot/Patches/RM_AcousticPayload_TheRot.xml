<?xml version="1.0" encoding="utf-8"?>
<!--
  GRAVSHIP_ACOUSTIC_SCANNER_1: the acoustic-scanner payload for RM_TheRot.
  Owner decision by question card 2026-10-06: the payload goes on EVERY biome of ours.

  Pure XML, FindMod-guarded on "RimMandrake: Acoustic Scanner", so the extension class
  is only named while its assembly is active. Every def is a defName STRING resolved
  at pulse time (GetNamedSilentFail), so a target naming another mod's def just hears
  nothing when that mod is absent. Each target is drawn from this biome's own content;
  the biome's sitting may re-author it. The reading is always banded by the scanner.
-->
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>RimMandrake: Acoustic Scanner</li>
    </mods>
    <match Class="PatchOperationAddModExtension">
      <xpath>/Defs/BiomeDef[defName="RM_TheRot"]</xpath>
      <value>
        <li Class="RimMandrake.AcousticScanner.RM_AcousticPayloadExtension">
          <quietText>Soft, spongy echoes from the fungal floor. Nothing in it is bigger than the mat itself.</quietText>
          <targets>
            <li>
              <label>something with a full gut</label>
              <reading>A huge, slow gut noise, and inside it a single metal ring.</reading>
              <color>(1, 0.4, 0.35)</color>
              <weight>3</weight>
              <pawnRaces>
                <li>RM_Hwelgrue</li>
              </pawnRaces>
            </li>
            <li>
              <label>thozzik colony</label>
              <reading>A honeycomb of small echoes, all moving, and one larger one at the middle.</reading>
              <color>(0.85, 0.5, 1)</color>
              <weight>2</weight>
              <pawnRaces>
                <li>RM_ThozzikColony</li>
                <li>RM_ThozzikColonyQueen</li>
                <li>RM_ThozzikQueen</li>
              </pawnRaces>
            </li>
            <li>
              <label>digested wreck</label>
              <reading>Metal gone soft at the edges, half eaten by the Rot.</reading>
              <color>(0.8, 0.8, 0.85)</color>
              <thingDefs>
                <li>RM_RotWreckHull</li>
                <li>RM_RotWreckFrame</li>
              </thingDefs>
            </li>
            <li>
              <label>hollow under the mat</label>
              <reading>The pulse falls into a hollow under the fungal mat.</reading>
              <color>(0.6, 0.6, 0.9)</color>
              <hiddenCaves>true</hiddenCaves>
              <cellSampleStride>4</cellSampleStride>
            </li>
          </targets>
        </li>
      </value>
    </match>
  </Operation>
</Patch>
