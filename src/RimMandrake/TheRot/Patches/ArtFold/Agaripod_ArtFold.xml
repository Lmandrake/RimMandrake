<?xml version="1.0" encoding="utf-8"?>
<!--
  Agaripod_ArtFold.xml - ART_OVERRIDE_FOLD_ALL_1 (precedent SILOOTH_ART_FOLD_1)

  Art: this mod's own port already carries, byte for byte, the Agaripod picture the standalone AgaripodArtOverride mod painted over sarg.alphaanimals's art (Textures/Things/Pawn/Animal/RM_Agaripod/RM_Agaripod_*.png). The donor's texPath is pointed at it below, so the donor creature keeps drawing it now the standalone mod is gone.
  The donor's own PawnKindDef texPath is matched by VALUE (any life stage, any graphic slot, and an
  abstract parent if the donor inherits), so every slot the old same-path override reached is
  redirected and nothing else. Conditional: a load without the donor matches nothing and logs nothing.
  Checked offline by src/RimMandrake/Utils/art_fold_check.py (manifest row "Agaripod").
-->
<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/PawnKindDef//texPath[text()="Things/Pawn/Animal/AA_Agaripod/AA_Agaripod"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/PawnKindDef//texPath[text()="Things/Pawn/Animal/AA_Agaripod/AA_Agaripod"]</xpath>
      <value><texPath>Things/Pawn/Animal/RM_Agaripod/RM_Agaripod</texPath></value>
    </match>
  </Operation>
</Patch>
