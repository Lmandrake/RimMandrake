<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline, no-game selftest of the landform geometry in mandrake.rm.tilefeatures
    (VEE_LANDFORMS_BUILD_CRATERS_AND_COMPANY). Compiles the REAL production RM_LandformGeometry.cs, which names no Verse
    or Unity type, so no game assembly is referenced. NOT the mod build (RimMandrake_TileFeatures.csproj one directory up
    lists its own Compile items and does not include this folder).

    Run via src/RimMandrake/Utils/selftest_tilefeatures_landform_geometry.py.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrakeTileFeatures.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.TileFeatures.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <DebugType>none</DebugType>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\RM_LandformGeometry.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
