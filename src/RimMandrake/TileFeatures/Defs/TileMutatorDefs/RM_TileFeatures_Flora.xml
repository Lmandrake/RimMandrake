<?xml version="1.0" encoding="utf-8"?>
<!-- VEE_FLORA_VENTS_BUILD_XML_FIRST (design/RimMandrake/vee_port_plan_2026-10-22.md group F): world-tile features ported
     from Vanilla Exploration Expanded (vanillaexpanded.vexploratione), VEE_<Stem> -> RM_<Stem>. No worldgen: every port has
     chanceOnNonLandmarkTile 0 and no biome lists, so these act only on tiles that already carry them. Categories keep the
     donor's strings so a tile's mutator conflicts stay like-for-like. Numbers live in Mod Settings, not in the text.

     Workers: cacti, red desert cacti and mycelium use the Vanilla Expanded Framework's PlantsWithCommonality (VEF stays);
     overgrown/decimated are vanilla plantDensityFactor; no trees, reduced fertility and marine sanctuary are our workers;
     poisonous flora is a Harmony postfix on Plant.PlantCollected (wild plants only); mechanoid chunks is a vanilla gen step. -->
<Defs>

  <TileMutatorDef>
    <defName>RM_Cactus_Barrel</defName>
    <label>barrel cacti</label>
    <description>This area can grow a large number of wild barrel cacti.</description>
    <chanceOnNonLandmarkTile>0</chanceOnNonLandmarkTile>
    <plantDensityRange>0~4</plantDensityRange>
    <pollutionRange>0~0.25</pollutionRange>
    <workerClass>VEF.Maps.TileMutatorWorker_PlantsWithCommonality</workerClass>
    <modExtensions>
      <li Class="VEF.Maps.TileMutatorExtension">
        <plantDefsWithCommonality>
          <li>
            <plantDef>RM_Plant_BarrelCactus</plantDef>
            <commonality>1</commonality>
          </li>
        </plantDefsWithCommonality>
      </li>
    </modExtensions>
  </TileMutatorDef>

