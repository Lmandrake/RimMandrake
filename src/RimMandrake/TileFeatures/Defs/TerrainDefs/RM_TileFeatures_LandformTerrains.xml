<?xml version="1.0" encoding="utf-8"?>
<!-- VEE_LANDFORMS_BUILD_CRATERS_AND_COMPANY (design/RimMandrake/vee_port_plan_2026-10-22.md group L): the terrains the
     landform tile features lay, ported from Vanilla Exploration Expanded's terrains of the same purpose (VEE_<Stem> ->
     RM_<Stem>; VEE_PebbleDunes -> RM_LoosePebbles and VEE_VolcanicAsh "impact regolith" -> RM_ImpactRegolith so a terrain
     never shares a name with a tile feature). Numbers (path cost, fertility, affordances) follow VEE's defs; Walkable comes from NaturalTerrainBase.
     PLACEHOLDER ART: every texture is vanilla's, tinted with <color> (the colour multiplies the texture, as in
     FlowWorks' RM_ColoredWater.xml and RM_SaltCrustShore). Whether a tint survives vanilla's water-depth overlay is
     unverified offline (the same open question RM_ColoredWater.xml records). New art is delegated to the art judge.
     The quicksand of RM_QuicksandDunes is FlowWorks' RM_DeepSand and the sinkhole pit is FlowWorks' RM_Channel_Superdeep
     (a pit is a superdeep cell), so neither is redefined here. -->
<Defs>

  <TerrainDef ParentName="NaturalTerrainBase">
    <defName>RM_Salt</defName>
    <label>salt</label>
    <description>A hard, glaring crust of salt left where an inland sea dried away. Nothing grows in it, and it is slow, crunching going.</description>
    <texturePath>Terrain/Surfaces/DryLakeBed</texturePath>
    <color>(245,243,236)</color>
    <edgeType>FadeRough</edgeType>
    <renderPrecedence>352</renderPrecedence>
    <pathCost>28</pathCost>
    <fertility>0</fertility>
    <takeFootprints>true</takeFootprints>
    <affordances><li>Light</li><li>Diggable</li></affordances>
  </TerrainDef>

