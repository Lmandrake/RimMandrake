<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline, no-game selftest for STILLSAND_SKELETONS_REMAINDER_1. Compiles the REAL
    production file ..\RM_SkeletonBurialLogic.cs (System.Math only) and drives it
    with synthetic sand-depth series. NOT the mod build: RM_Stillsand.csproj one directory
    up lists its files explicitly and never mentions this folder.

    Run via src/RimMandrake/Utils/selftest_skeleton_burial.py.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrakeStillsand.SkeletonBurial.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.Stillsand.SkeletonSelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <DebugType>none</DebugType>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\RM_SkeletonBurialLogic.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
