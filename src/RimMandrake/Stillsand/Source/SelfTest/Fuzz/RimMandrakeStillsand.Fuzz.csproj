<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Stillsand offline fuzz, Approach B (same shape as TheForge/Scarlands/Bazaar). Plain net8.0, zero RimWorld/Unity
    references: ../../Kernel/*.cs are the PRODUCTION files the mod compiles, pulled in directly. A `using Verse;` landing
    in one of them breaks this build - that is the guard rail working.
    Run (builds on Windows via winbuild staging, then runs the exe):
      python3 src/RimMandrake/Utils/selftest_stillsand_fuzz.py [fuzz knobs]
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RimMandrakeStillsand.Fuzz</AssemblyName>
    <RootNamespace>RimMandrake.Stillsand.Fuzz</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Kernel\RM_LeviathanKernel.cs" />
    <Compile Include="..\..\Kernel\RM_LedgerKernel.cs" />
    <Compile Include="..\..\Kernel\RM_GaleKernel.cs" />
    <Compile Include="..\..\Kernel\RM_SunKernel.cs" />
    <Compile Include="..\..\Kernel\RM_HorizonMath.cs" />
    <Compile Include="StillsandFuzz.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
