  </GenStepDef>

  <TileMutatorDef>
    <defName>RM_GiantFossils</defName>
    <label>giant fossils</label>
    <description>Gigantic skeletons of long-gone beasts litter this land. Considering fossilization hasn't had time to actually occur on the Rim, it's a mystery who put these giant bones here.</description>
    <chanceOnNonLandmarkTile>0.02</chanceOnNonLandmarkTile>
    <biomeWhitelist>
      <li>Desert</li>
      <li>ExtremeDesert</li>
      <li>AridShrubland</li>
      <li>RM_Stillsand</li>
    </biomeWhitelist>
    <extraGenSteps>
      <li>RM_GenStep_GiantFossils_OommokSkeleton</li>
      <li>RM_GenStep_GiantFossils_MuurrokSkeleton</li>
      <li>RM_GenStep_GiantFossils_GuzzkaSkeleton</li>
      <li>RM_GenStep_GiantFossils_VozzikSkeleton</li>
      <li>RM_GenStep_GiantFossils_GiantSkull</li>
    </extraGenSteps>
  </TileMutatorDef>

</Defs>
