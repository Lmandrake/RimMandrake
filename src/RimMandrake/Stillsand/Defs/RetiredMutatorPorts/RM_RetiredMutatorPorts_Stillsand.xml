    </genStep>
  </GenStepDef>

  <GenStepDef>
    <defName>RM_GenStep_GiantFossils_VozzikSkeleton</defName>
    <order>600</order>
    <genStep Class="GenStep_ScatterThings">
      <thingDef>RM_VozzikSkeleton</thingDef>
