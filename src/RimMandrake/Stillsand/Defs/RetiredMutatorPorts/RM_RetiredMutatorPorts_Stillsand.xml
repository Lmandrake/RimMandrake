  <GenStepDef>
    <defName>RM_GenStep_GiantFossils_GiantSkull</defName>
    <order>600</order>
    <genStep Class="GenStep_ScatterThings">
      <thingDef>RM_GiantSkull</thingDef>
      <countPer10kCellsRange>0.13~0.26</countPer10kCellsRange>
