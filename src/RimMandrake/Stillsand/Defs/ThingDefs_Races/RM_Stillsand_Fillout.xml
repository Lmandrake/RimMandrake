  <!-- ============================================================ -->
  <!-- 2. RM_Gaanok — the follower                                    -->
  <!-- ============================================================ -->

  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Gaanok</defName>
    <label>gaanok</label>
    <description>A gaunt, stilt-legged walker the colour of bleached bone, powder-glazed, taller than a wall and thin as famine, and it never attacks. It simply appears on the horizon behind a caravan and walks, at exactly the caravan's pace, for days. It is doing arithmetic: a moving party is a sealed cask of water that will open itself if followed long enough. When something collapses, of heat or thirst or wounds, the gaanok is there within the hour, and it drinks. The horror is that it is patient, visible, and correct.</description>
    <statBases>
      <MoveSpeed>2.6</MoveSpeed>
      <MarketValue>1500</MarketValue>
      <ComfyTemperatureMin>-10</ComfyTemperatureMin>
      <ComfyTemperatureMax>80</ComfyTemperatureMax>
      <FilthRate>2</FilthRate>
      <Wildness>0.95</Wildness>
    </statBases>
    <tools>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>12</power>
        <cooldownTime>2.4</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
      </li>
      <li>
        <label>left foot</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>14</power>
        <cooldownTime>2.2</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftLeg</linkedBodyPartsGroup>
      </li>
      <li>
        <label>right foot</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>14</power>
        <cooldownTime>2.2</cooldownTime>
        <linkedBodyPartsGroup>FrontRightLeg</linkedBodyPartsGroup>
      </li>
      <li>
        <label>drinking mouth</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>16</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        <chanceFactor>0.5</chanceFactor>
      </li>
    </tools>
    <race>
      <body>QuadrupedAnimalWithHooves</body>
      <herdAnimal>false</herdAnimal>
      <!-- v1 ships on vanilla predator AI. The walking pace makes a chase
           structurally impossible, so it takes only the downed and the slow,
           which IS the design. It declines fights: manhunterOnDamageChance 0. -->
      <predator>true</predator>
      <maxPreyBodySize>2.5</maxPreyBodySize>
      <baseBodySize>5.0</baseBodySize>
      <baseHealthScale>4.0</baseHealthScale>
      <baseHungerRate>0.4</baseHungerRate>
      <foodType>CarnivoreAnimal</foodType>
      <leatherDef>Leather_Light</leatherDef>
      <useMeatFrom>Megaspider</useMeatFrom>
      <trainability>None</trainability>
      <manhunterOnDamageChance>0</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0</manhunterOnTameFailChance>
      <roamMtbDays>8</roamMtbDays>
      <lifeExpectancy>45</lifeExpectancy>
      <lifeStageAges>
        <li><def>AnimalBaby</def><minAge>0</minAge></li>
        <li><def>AnimalJuvenile</def><minAge>0.4</minAge></li>
        <li><def>AnimalAdult</def><minAge>1.0</minAge></li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
    </race>
    <tradeTags>
      <li>AnimalExotic</li>
    </tradeTags>
  </ThingDef>

