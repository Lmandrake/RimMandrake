  <!-- ============================================================ -->
  <!-- 4. RM_Duumma — the prey that drums dry                         -->
  <!-- ============================================================ -->

  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Duumma</defName>
    <label>duumma</label>
    <description>The fattest water-cask in the biome, and the ground's other liar. A barrel-bodied burrower, plated in matte dust-glaze, that ferries stored water between buried moisture pockets. Every subsurface hunter can feel a footfall, so when anything heavy moves nearby the duumma goes utterly still and its gait-drum shifts to the dry, hollow signature of a desiccated husk: nothing here worth a strike. A traveller who learns the tell, the sand that went quiet, is standing on more water than a whole clutch of eggs. Prey to the vekka, the drazzik and the krayt; prize to a Jawa.</description>
    <statBases>
      <MoveSpeed>1.2</MoveSpeed>
      <MarketValue>260</MarketValue>
      <ComfyTemperatureMin>-10</ComfyTemperatureMin>
      <ComfyTemperatureMax>90</ComfyTemperatureMax>
      <LeatherAmount>0</LeatherAmount>
      <Wildness>0.8</Wildness>
    </statBases>
    <tools>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>6</power>
        <cooldownTime>2.4</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
      </li>
    </tools>
    <!-- The prize: a fresh duumma butchers into carried drink (RM_DrainedFluids,
         creaturebehaviors), the eggs-as-water economy without an egg. The
         signal falsification itself is description plus stats; no shipped comp
         expresses "drums dry". -->
    <butcherProducts>
      <RM_DrainedFluids>6</RM_DrainedFluids>
    </butcherProducts>
    <race>
      <body>TurtleLike</body>
      <herdAnimal>false</herdAnimal>
      <predator>false</predator>
      <!-- DEPTH ARM (Q7, annotated in place, nothing evicted): mid-band bs 1.8 is
           legal because it is a SUBSURFACE animal, defended by depth, not size. -->
      <baseBodySize>1.8</baseBodySize>
      <baseHealthScale>1.4</baseHealthScale>
      <baseHungerRate>0.12</baseHungerRate>
      <foodType>VegetarianRoughAnimal</foodType>
      <useMeatFrom>SeaTurtle</useMeatFrom>
      <trainability>None</trainability>
      <manhunterOnDamageChance>0</manhunterOnDamageChance>
      <roamMtbDays>6</roamMtbDays>
      <lifeExpectancy>35</lifeExpectancy>
      <lifeStageAges>
        <li><def>AnimalBaby</def><minAge>0</minAge></li>
        <li><def>AnimalJuvenile</def><minAge>0.2</minAge></li>
        <li><def>AnimalAdult</def><minAge>0.5</minAge></li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <tradeTags>
      <li>AnimalUncommon</li>
    </tradeTags>
      <modExtensions>
      <!-- Owner, Stillsand sheet 2026-10-05: "I think it likely needs a corpse-body when killed, just having a swimming form isn't enough. What does it look like when it's attacked for example?"
           The half-buried dome is the SWIMMING slot, drawn on sand by RM_SandBuriedGraphicExtension (CreatureBehaviors, RM_SandBuriedGraphic.cs);
           the BODY slot is the surfaced, out-of-sand barrel body, which is also what the corpse draws. -->
      <li Class="RimMandrake.CreatureBehaviors.RM_SandBuriedGraphicExtension" />
    </modExtensions>
</ThingDef>

  <PawnKindDef ParentName="AnimalKindBase">
    <defName>RM_Duumma</defName>
    <label>duumma</label>
    <race>RM_Duumma</race>
    <combatPower>40</combatPower>
    <ecoSystemWeight>0.3</ecoSystemWeight>
    <canArriveManhunter>false</canArriveManhunter>
    <!-- Body = the surfaced barrel body (also the corpse). Swimming = the half-buried dome shown on sand.
         Both point at the dome art until the surfaced-body render (job stillsand_s2_RM_Duumma_surfaced) is installed;
         then bodyGraphicData's texPath becomes Things/Pawn/Animal/RM_Duumma/RM_Duumma_Surfaced (STILLSAND_SAND_SWIM_REMAINDER_1 note). -->
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/RM_Duumma/RM_Duumma</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>0.8</drawSize>
        </bodyGraphicData>
        <swimmingGraphicData>
          <texPath>Things/Pawn/Animal/RM_Duumma/RM_Duumma</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>0.8</drawSize>
        </swimmingGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/RM_Duumma/RM_Duumma</texPath>
