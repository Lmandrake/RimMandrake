<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_Stillsand_Fillout.xml                RimMandrake — STILLSAND_BEDAZZLE_CONTENT_1

  The six ruled fill-out creatures of design/Jawa/worldbuilding/biomes/
  stillsand_roster_fillout_2026-09-27.md (owner ruled the art sheet 2026-09-27;
  each uses its _b redo render where one exists): soorrak, gaanok, liikka,
  duumma, veessa, loomma. Invented names, franchise-free RM_ tier (Q11a).

  Every def carries its OWN 3-facing render, Textures/Things/Pawn/Animal/RM_<Name>/.
  Each behaviour rides a shipped comp or extension; no new C# is added for them.
  Sizes follow the size law: giants-or-grains on the surface, a subsurface body
  of any size (duumma, the depth arm, annotated in place).

  Wired in RM_Stillsand_Biome.xml's wildAnimals at the doc's commonalities.
-->
<Defs>

  <!-- ============================================================ -->
  <!-- 1. RM_Soorrak — the flier that owns the sky                    -->
  <!-- ============================================================ -->

  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Soorrak</defName>
    <label>soorrak</label>
    <description>A sail-winged giant that nests in the deep dune precisely because nothing alive can afford to walk there. Its sun-face is one sheet of mirror-ceramic, so from below, crossing the white sky, it is nearly invisible except as a moving glare; its shade-face carries the eyes, the vents and the brood pouch. It drinks at the green line or a distant shore and carries the water home in its crop. A soorrak nesting crag is the richest square kilometre of surface in the biome, and its eggs are canteens: a full one is drink in a rigid shell, and a Jawa will cross a horizon for a clutch.</description>
    <statBases>
      <MoveSpeed>4.2</MoveSpeed>
      <MarketValue>1800</MarketValue>
      <ComfyTemperatureMin>-10</ComfyTemperatureMin>
      <ComfyTemperatureMax>70</ComfyTemperatureMax>
      <FilthRate>10</FilthRate>
      <Wildness>0.9</Wildness>
      <MaxFlightTime>30</MaxFlightTime>
      <FlightCooldown>8</FlightCooldown>
    </statBases>
    <tools>
      <li>
        <label>talons</label>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>12</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>Feet</linkedBodyPartsGroup>
      </li>
      <li>
        <label>beak</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>14</power>
        <cooldownTime>2.2</cooldownTime>
        <linkedBodyPartsGroup>Beak</linkedBodyPartsGroup>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>8</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <comps>
      <li Class="CompProperties_EggLayer">
        <eggUnfertilizedDef>RM_SoorrakEggUnfertilized</eggUnfertilizedDef>
        <eggFertilizedDef>RM_SoorrakEggFertilized</eggFertilizedDef>
        <eggFertilizationCountMax>1</eggFertilizationCountMax>
        <eggLayIntervalDays>30</eggLayIntervalDays>
        <eggProgressUnfertilizedMax>0.5</eggProgressUnfertilizedMax>
        <eggCountRange>1~2</eggCountRange>
      </li>
    </comps>
    <race>
      <body>Bird</body>
      <herdAnimal>false</herdAnimal>
      <predator>false</predator>
      <baseBodySize>4.5</baseBodySize>
      <baseHealthScale>3.5</baseHealthScale>
      <baseHungerRate>0.3</baseHungerRate>
      <foodType>OmnivoreAnimal</foodType>
      <leatherDef>Leather_Light</leatherDef>
      <useMeatFrom>Chicken</useMeatFrom>
      <trainability>None</trainability>
      <manhunterOnDamageChance>0.5</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0.1</manhunterOnTameFailChance>
      <roamMtbDays>10</roamMtbDays>
      <lifeExpectancy>40</lifeExpectancy>
      <!-- Real core flight, the Locust/Chicken shape. canLeaveMapFlying is the
           sheet's own mechanism: it drinks hundreds of kilometres away and
           leaves the map to do it. No flying flip-book frames yet, so it flies
           without a wing-beat; frames never block flight. -->
      <flightStartChanceOnJobStart>0.3</flightStartChanceOnJobStart>
      <flightSpeedFactor>2.5</flightSpeedFactor>
      <canFlyIntoMap>true</canFlyIntoMap>
      <canLeaveMapFlying>true</canLeaveMapFlying>
      <lifeStageAges>
        <li><def>AnimalBaby</def><minAge>0</minAge></li>
        <li><def>AnimalJuvenile</def><minAge>0.3</minAge></li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.6</minAge>
          <soundWounded>Pawn_Chicken_Wounded</soundWounded>
          <soundDeath>Pawn_Chicken_Death</soundDeath>
          <soundCall>Pawn_Chicken_Call</soundCall>
          <soundAngry>Pawn_Chicken_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
      <soundEating>Bird_Eat</soundEating>
    </race>
    <tradeTags>
      <li>AnimalExotic</li>
    </tradeTags>
  </ThingDef>

