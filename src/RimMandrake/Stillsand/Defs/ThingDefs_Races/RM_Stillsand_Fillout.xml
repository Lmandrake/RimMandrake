  <!-- The eggs ARE canteens (deep_desert §4.4): heavy, cool, drink in a rigid shell. -->
  <ThingDef ParentName="EggFertBase">
    <defName>RM_SoorrakEggFertilized</defName>
    <label>soorrak egg</label>
    <description>A rigid, mirror-glazed shell the size of a Jawa's torso, cool to the touch and sloshing when it moves: a full clutch is a caravan's worth of drink. Something inside is slowly growing a sail.</description>
    <possessionCount>1</possessionCount>
    <graphicData>
      <texPath>Things/Item/Egg/RM_EggScaled</texPath>
      <color>(214,224,226)</color>
      <drawSize>1.2</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>180.0</MarketValue>
      <Mass>4.5</Mass>
      <Nutrition>1.4</Nutrition>
    </statBases>
    <comps>
      <li Class="CompProperties_Hatcher">
        <hatcherDaystoHatch>14</hatcherDaystoHatch>
        <hatcherPawn>RM_Soorrak</hatcherPawn>
      </li>
      <li Class="CompProperties" MayRequire="Dubwise.DubsBadHygiene.Lite">
        <compClass>DubsBadHygiene.CompContamination</compClass>
      </li>
    </comps>
    <modExtensions>
      <li Class="DubsBadHygiene.WaterExt" MayRequire="Dubwise.DubsBadHygiene.Lite">
        <water>5</water>
        <UseForWashing>true</UseForWashing>
        <SeekForThirst>true</SeekForThirst>
      </li>
    </modExtensions>
  </ThingDef>

