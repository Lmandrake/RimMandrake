  <!-- ============================================================ -->
  <!-- 6. RM_Loomma — the ollim's tenant                              -->
  <!-- ============================================================ -->

  <!-- Death-outside-shade clock: rises in sun, falls in shade, lethal at 1.
       Rides the shipped shade-driven severity comp (RM_MapComponent_ShadeGrid). -->
  <HediffDef>
    <defName>RM_LoommaSunstruck</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>sunstruck</label>
    <description>A shade-bound tenant caught outside any hard shadow. It cannot survive long in the open.</description>
    <isBad>true</isBad>
    <everCurableByItem>false</everCurableByItem>
    <initialSeverity>0.01</initialSeverity>
    <!-- Floor above 0: Hediff.ShouldRemove is Severity <= 0, and nothing re-adds this hediff, so
         without a floor one stretch of shade deleted the clock for good (MEASURED live 2026-10-07). -->
    <minSeverity>0.001</minSeverity>
    <maxSeverity>1.0</maxSeverity>
    <lethalSeverity>1.0</lethalSeverity>
    <stages>
      <li>
        <label>shaded</label>
        <minSeverity>0</minSeverity>
      </li>
      <li>
        <label>scorched</label>
        <minSeverity>0.4</minSeverity>
        <painOffset>0.2</painOffset>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <postFactor>0.6</postFactor>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="RimMandrake.CreatureBehaviors.RM_HediffCompProperties_ShadeDrivenSeverity">
        <severityPerDayInSun>40</severityPerDayInSun>
        <severityPerDayInShade>-20</severityPerDayInShade>
      </li>
    </comps>
  </HediffDef>

  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Loomma</defName>
    <label>loomma</label>
    <description>The rent-payer. A soft-bodied, kettle-sized commensal that lives its whole life inside one ollim's hard-edged permanent shadow; it cannot survive twenty minutes outside it. It forages the shade line at the shadow's rim, and it pays the tree: its dung and its water-rich waste go into the sand at the trunk, concentrating exactly the buried moisture the ollim accretes from. A stand with loomma in it is a working ecosystem; a stand without them is a dying one. A tame one will pay rent to a colony instead, a slow, gentle fertiliser engine, but it dies on any caravan that leaves the shade.</description>
    <statBases>
      <MoveSpeed>1.8</MoveSpeed>
      <MarketValue>90</MarketValue>
      <ComfyTemperatureMin>0</ComfyTemperatureMin>
      <ComfyTemperatureMax>70</ComfyTemperatureMax>
      <FilthRate>6</FilthRate>
      <LeatherAmount>0</LeatherAmount>
      <Wildness>0.5</Wildness>
    </statBases>
    <tools>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>2</power>
        <cooldownTime>2.2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
      </li>
    </tools>
    <modExtensions>
      <!-- Shade-binding: idle wander steers to shaded cells. -->
      <li Class="RimMandrake.CreatureBehaviors.RM_ShadeSeekingWanderExtension">
        <minShadeToPrefer>0.6</minShadeToPrefer>
      </li>
    </modExtensions>
    <comps>
      <!-- The rent: waste that seeds and feeds, gated on shade so a drop in the
           open leaves nothing and only a stop under an ollim fertilises. -->
      <li Class="RimMandrake.CreatureBehaviors.RM_CompProperties_DungSeeder">
        <intervalTicksRange>12000~24000</intervalTicksRange>
        <minShadeToSeed>0.5</minShadeToSeed>
        <dungFilthDef>Filth_Dirt</dungFilthDef>
        <dungFilthCount>2</dungFilthCount>
        <seedRadius>4.9</seedRadius>
        <growthBoost>0.2</growthBoost>
        <maxPlantsBoosted>8</maxPlantsBoosted>
        <seedPlants>
          <li>RM_Glasscrust</li>
        </seedPlants>
        <seedPlantCount>1~2</seedPlantCount>
        <wildlifeSpawnChance>0</wildlifeSpawnChance>
      </li>
    </comps>
    <race>
      <body>TurtleLike</body>
      <herdAnimal>false</herdAnimal>
      <predator>false</predator>
      <baseBodySize>0.25</baseBodySize>
      <baseHealthScale>0.5</baseHealthScale>
      <baseHungerRate>0.1</baseHungerRate>
      <foodType>VegetarianRoughAnimal</foodType>
      <useMeatFrom>SeaTurtle</useMeatFrom>
      <trainability>Intermediate</trainability>
      <manhunterOnDamageChance>0</manhunterOnDamageChance>
      <roamMtbDays>6</roamMtbDays>
      <lifeExpectancy>12</lifeExpectancy>
      <lifeStageAges>
        <li><def>AnimalBaby</def><minAge>0</minAge></li>
        <li><def>AnimalJuvenile</def><minAge>0.2</minAge></li>
        <li><def>AnimalAdult</def><minAge>0.5</minAge></li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <tradeTags>
      <li>AnimalUncommon</li>
    </tradeTags>
