<Defs>

  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Ikee</defName>
    <label>ikee</label>
    <description>A grotesquely enlarged eye that drags itself along on a few fleshy tentacles. Not very useful for much of anything. Something about the dune sea's flat, unmoving light seems to have bred this shape more than once.</description>
    <statBases>
      <MoveSpeed>3.0</MoveSpeed>
      <MarketValue>100</MarketValue>
      <ComfyTemperatureMin>0</ComfyTemperatureMin>
      <ComfyTemperatureMax>60</ComfyTemperatureMax>
      <MeatAmount>0</MeatAmount>
      <Wildness>0.2</Wildness>
    </statBases>
    <tools>
      <li>
        <label>eye</label>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>8</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <race>
      <body>Monkey</body>
      <herdAnimal>false</herdAnimal>
      <predator>false</predator>
      <!-- Q8: SHRUNK back to grain, ~0.15 (was ported at 0.4, tripling the roster's
           approved figure and landing inside R22's banned 0.3-3.0 mid-band). -->
      <baseBodySize>0.15</baseBodySize>
      <baseHealthScale>0.5</baseHealthScale>
      <baseHungerRate>0.1</baseHungerRate>
      <foodType>OmnivoreRoughAnimal</foodType>
      <leatherDef>Leather_Light</leatherDef>
      <useMeatFrom>Pig</useMeatFrom>
      <trainability>Intermediate</trainability>
      <lifeExpectancy>12</lifeExpectancy>
      <herdMigrationAllowed>false</herdMigrationAllowed>
      <lifeStageAges>
        <li><def>AnimalBaby</def><minAge>0</minAge></li>
        <li><def>AnimalJuvenile</def><minAge>0.1</minAge></li>
        <li><def>AnimalAdult</def><minAge>0.2222</minAge></li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <tradeTags>
      <li>AnimalUncommon</li>
    </tradeTags>
  </ThingDef>

  <PawnKindDef ParentName="AnimalKindBase">
    <defName>RM_Ikee</defName>
    <label>ikee</label>
    <race>RM_Ikee</race>
    <combatPower>10</combatPower>
