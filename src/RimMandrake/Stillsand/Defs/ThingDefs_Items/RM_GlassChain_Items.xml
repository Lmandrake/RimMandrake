  <ThingDef ParentName="ResourceBase">
    <defName>RM_PrecisionLens</defName>
    <label>precision lens</label>
    <description>A convex lens ground and polished from lens glass and set in a thin metal rim. It is accurate enough for scopes and sighting optics, and for the condensers of high-performance solar stills.</description>
