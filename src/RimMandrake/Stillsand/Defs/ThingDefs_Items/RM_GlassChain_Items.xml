  <ThingDef ParentName="ResourceBase">
    <defName>RM_PearlLens</defName>
    <label>pearl lens</label>
    <description>A lens ground around a glass pearl from the deep sand, milky at the rim and perfectly clear at the centre. A pearl lens gathers light better than any lens ground from glass. Set in a solar still, it doubles the still's output.</description>
