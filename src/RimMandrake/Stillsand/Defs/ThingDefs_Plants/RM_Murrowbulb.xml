<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_Murrowbulb - PLANT_TIERS_RECONCILE_MOST_ARE_BAROQUE (owner 2026-10-16: "Star Wars will have a very few canon plants, and those can just be reskins of non-canon versions we create in the Baroque Biomes"; by card "Invent 7 new Baroque bases").
  Invented, franchise-free base whose growth, harvest and stats are copied 1:1 from the canon RSW_Plant_Bloddle
  (SWBestiary RSW_DesertPortB_Plants.xml), which is now a pure reskin of this def (ParentName="RM_Murrowbulb").
  Home: RM_Stillsand. TEMP ART: texPaths point at vanilla placeholders until the base art is ruled and installed
  (review sheet under Transient/plant_baroque_bases_2026-10-16/); the owned folder will be Things/Plant/RM_Murrowbulb.
-->
<Defs>

  <ThingDef ParentName="PlantBase" Name="RM_Murrowbulb">
    <defName>RM_Murrowbulb</defName>
    <label>murrowbulb</label>
    <description>A low clump of squat, ash-violet bulbs that sit half-sunk in still sand, wrapped in papery sheaths that peel away in the heat. The bulb is sharp and aromatic raw and turns sweet when cooked; cooks across the dry country use a little of it to wake up everything else in the pot.</description>
    <statBases>
      <MaxHitPoints>85</MaxHitPoints>
      <Nutrition>0.2</Nutrition>
    </statBases>
    <graphicData>
      <!-- TEMP placeholder (vanilla); base art pending owner review -->
      <texPath>Things/Plant/BerryPlant</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <selectable>true</selectable>
    <pathCost>14</pathCost>
    <ingestible />
    <plant>
      <fertilitySensitivity>0.4</fertilitySensitivity>
      <immatureGraphicPath>Things/Plant/BerryPlant</immatureGraphicPath>
      <dieIfLeafless>true</dieIfLeafless>
      <maxMeshCount>16</maxMeshCount>
      <harvestTag>Standard</harvestTag>
      <harvestedThingDef>RM_RawMurrowbulb</harvestedThingDef>
      <harvestYield>5</harvestYield>
      <sowTags>
        <li>Ground</li>
        <li>Hydroponic</li>
      </sowTags>
      <topWindExposure>0.1</topWindExposure>
      <growDays>4</growDays>
      <visualSizeRange>0.3~0.6</visualSizeRange>
      <wildOrder>2</wildOrder>
      <purpose>Food</purpose>
      <humanFoodPlant>true</humanFoodPlant>
    </plant>
  </ThingDef>

  <ThingDef ParentName="PlantFoodRawBase" Name="RM_RawMurrowbulb">
    <defName>RM_RawMurrowbulb</defName>
    <label>murrowbulb</label>
    <description>Raw murrowbulbs. A pungent bulb used in many dishes for its strong flavour.</description>
    <possessionCount>10</possessionCount>
    <graphicData>
      <!-- TEMP placeholder (vanilla) -->
      <texPath>Things/Item/Resource/PlantFoodRaw/Potatoes</texPath>
    </graphicData>
    <statBases>
      <MarketValue>2.0</MarketValue>
    </statBases>
    <ingestible>
      <foodType>VegetableOrFruit</foodType>
      <tasteThought>AteRawFood</tasteThought>
      <specialThoughtAsIngredient>RM_AteMurrowbulb</specialThoughtAsIngredient>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>30</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
  </ThingDef>

  <ThoughtDef>
    <defName>RM_AteMurrowbulb</defName>
    <durationDays>1</durationDays>
    <stages>
      <li>
        <label>ate murrowbulb</label>
        <description>Nothing smells like murrowbulb softening in the pan.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
