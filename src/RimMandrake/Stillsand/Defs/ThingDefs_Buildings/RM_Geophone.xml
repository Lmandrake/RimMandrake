<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_Geophone.xml                          RimMandrake — STILLSAND_GEOPHONE_1
  A biosilica resonator staked in the sand. Reads the sand-swim kit's submerged query and the drum
  lure's drumming; shows a coarse bearing and size class, nothing else (Source/RM_Geophone.cs).
  Mod Settings: RM_GlassChainSettings.geophoneEnabled / geophoneRadius. Art: artpipe RM_Geophone (done).
-->
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>RM_Geophone</defName>
    <label>geophone</label>
    <description>A slim bronze spike driven into the sand, topped with a grown-glass bulb holding a trembling filament. It turns rumbles under the sand into a rough bearing and a size: small, medium or large. It gives no distance and no name, and it cannot tell a lure's drumming from a real swimmer. A sand gale drowns it out. It needs no power.</description>
    <graphicData>
      <texPath>Things/Building/Production/RM_Geophone</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.2</fillPercent>
    <pathCost>30</pathCost>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <useHitPoints>true</useHitPoints>
    <staticSunShadowHeight>0</staticSunShadowHeight>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Flammability>0</Flammability>
      <WorkToBuild>600</WorkToBuild>
      <Mass>3</Mass>
    </statBases>
    <costList>
      <RM_SunGlass>6</RM_SunGlass>
      <Steel>10</Steel>
    </costList>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Production</designationCategory>
    <comps>
      <li Class="RimMandrake.Stillsand.RM_CompProperties_Geophone">
        <readIntervalTicks>60</readIntervalTicks>
      </li>
    </comps>
  </ThingDef>
</Defs>
