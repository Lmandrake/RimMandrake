<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_Thumper.xml                       RimMandrake — STILLSAND_SAND_SWIM_REMAINDER_1 §4
  The thumper (ground-caller): a staked drum. A water charge (RM_StilledWater, via CompRefuelable so
  vanilla refuel jobs do the hauling) is spent each beat; a beat wets a small radius and calls every
  submerged sand swimmer within radius with a Goto (Source/RM_Thumper.cs). Uncharged it is silent.
  Mod Settings: RM_SandSwimRemSettings.thumperEnabled / thumperRadius. Art: artpipe RM_Thumper (done).
-->
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>RM_Thumper</defName>
    <label>thumper</label>
    <description>A heavy drum on a stake, struck by a sprung hammer that is cocked with a flask of water. Each beat wets the sand around it and sends a thud down through the dune, which the things that swim under the sand take for something fat and wounded. Bait one away from your walls, or call one to hunt it. It beats only while charged with stilled water.</description>
    <graphicData>
      <texPath>Things/Building/Production/RM_Thumper</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.5,1.5)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.3</fillPercent>
    <pathCost>30</pathCost>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <useHitPoints>true</useHitPoints>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <WorkToBuild>900</WorkToBuild>
      <Mass>8</Mass>
    </statBases>
    <costList>
      <Steel>40</Steel>
      <RM_SunGlass>4</RM_SunGlass>
    </costList>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Production</designationCategory>
    <comps>
      <li Class="CompProperties_Refuelable">
        <fuelLabel>Water charge</fuelLabel>
        <fuelGizmoLabel>Water</fuelGizmoLabel>
        <fuelFilter>
          <thingDefs>
            <li>RM_StilledWater</li>
          </thingDefs>
        </fuelFilter>
        <fuelCapacity>10</fuelCapacity>
        <initialFuelPercent>0</initialFuelPercent>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <autoRefuelPercent>0.5</autoRefuelPercent>
        <fuelMultiplier>1</fuelMultiplier>
      </li>
      <li Class="RimMandrake.Stillsand.RM_CompProperties_Thumper">
        <beatIntervalTicks>600</beatIntervalTicks>
        <wetCellRadius>2</wetCellRadius>
        <wetTicks>15000</wetTicks>
        <maxCallsPerBeat>4</maxCallsPerBeat>
        <arriveRadius>3</arriveRadius>
      </li>
    </comps>
  </ThingDef>
</Defs>
