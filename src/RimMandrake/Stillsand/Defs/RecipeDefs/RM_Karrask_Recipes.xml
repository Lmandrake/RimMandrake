<!--
  SWB_INVENTED_MIGRATE_TWENTY_LEFT: our own invented livestock (LIVESTOCK_STARTER_TRIO_1), not a Star Wars creature (Q11a); moved to the RM tier with defNames RSW_ -> RM_ (aliases in src/RimMandrake/LeaningScrub/Defs/Misc/RM_SWBRehome_Aliases.xml).
  Owner 2026-10-24: "Yes, it appears that a lot of alpha animal ports got
  classified as Star Wars. We should move all of those."
  Moved here (batch 4) from src/RimStarWars/SWBestiary/Defs/Livestock/RecipeDefs/RecipeDefs_Karrask.xml.
 LIVESTOCK_STARTER_TRIO_1 - curing the raw karrask shed into wearable
     plate. Zero new job types or workerClass: this is a plain vanilla
     RecipeDef/RecipeWorker (the same class every bench-craft recipe in
     this repo already uses, e.g. Absorbed_KotorCore_RecipeDefs_Medpacs.xml)
     run as ordinary Bill work at the existing tailoring benches - "very
     easy to work and shape" per the owner's ruling on this row is
     expressed as a below-1.0 WorkToMake stat factor on the cured plate
     itself (RM_Karrask.xml), not as a cheap recipe; the recipe's
     own workAmount is set to read as "days-long" per the design doc's
     wording, comparable to a mid-tier tailoring job. -->
<Defs>

  <RecipeDef>
    <defName>RM_CureKarraskPlate</defName>
    <label>cure karrask plate</label>
    <description>Cure a raw karrask shed into durable, workable plate.</description>
    <jobString>Curing karrask plate.</jobString>
    <workAmount>1200</workAmount>
    <effectWorking>Tailor</effectWorking>
    <soundWorking>Recipe_Tailor</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>RM_KarraskShedRaw</li>
          </thingDefs>
        </filter>
        <count>40</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>RM_KarraskShedRaw</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <RM_KarraskPlate>30</RM_KarraskPlate>
    </products>
    <workSkill>Crafting</workSkill>
    <skillRequirements>
      <Crafting>3</Crafting>
    </skillRequirements>
    <recipeUsers>
      <li>HandTailoringBench</li>
      <li>ElectricTailoringBench</li>
    </recipeUsers>
  </RecipeDef>

</Defs>
