<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_GlassChain.xml                        RimMandrake — STILLSAND_GLASS_LENS_CHAIN_1

  1. The sun-fed work speed part on vanilla's WorkTableWorkSpeedFactor. Core always has the
     stat and its <parts> list, so this is unguarded: a false return is a real failure.
-->
<Patch>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/StatDef[defName="WorkTableWorkSpeedFactor"]/parts</xpath>
    <value>
      <li Class="RimMandrake.Stillsand.RM_StatPart_SunPowered" />
    </value>
  </Operation>

  <!-- STILLSAND_GLASS_CHAIN_REMAINDER_1: without a WorkGiverDef naming them, no cook ever took a
       solar oven bill. Both ovens are Stillsand's own defs and DoBillsCook is Core, so no guard. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/WorkGiverDef[defName="DoBillsCook"]/fixedBillGiverDefs</xpath>
    <value>
      <li>RM_SolarOven</li>
      <li>RM_SolarOvenCrest</li>
    </value>
  </Operation>

</Patch>
