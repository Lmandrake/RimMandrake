<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_Excretor.xml                        RimMandrake: The Wastes

  The excretor: a three-horned herd grazer of ruined ground that concentrates
  the metals and salts it eats and sheds them as contaminant bezoars
  (design/Jawa/worldbuilding/biomes/wastes.md §4, "The excretors": a kept herd
  is a slow refinery; they extract, they never heal).

  History: first written in SWBestiary as RSW_Excretor (COMMISSION_LEDGER_CLEANUP_1,
  WASTELAND_EXCRETOR_BEZOAR_1), borrowing another animal's pictures. Moved here
  2026-10-24 (SWB_INVENTED_MIGRATE_TWENTY_LEFT) under its RM_ name; old saves load
  through RM_SWBRehomeAliases (src/RimMandrake/LeaningScrub/Defs/Misc/
  RM_SWBRehome_Aliases.xml). Its shear product is now this mod's own
  RM_ContaminantBezoar (the excretor-family bezoar) instead of the campaign
  layer's RUT_MetalSaltBezoar, so this mod needs nothing from RimUtinni.

  Art: its own pictures (Things/Pawn/Animal/RM_Excretor), drawn new and more
  alien on the owner's card of 2026-10-24 (EXCRETOR_PICTURE_ASK_KEPT_OR_OWN), keeping his 2026-10-05 ruling that the three horns
  show in every facing. Rendered as artpipe jobs arteval_RSW_Excretor_r1_*.

  Mechanism: vanilla CompProperties_Shearable as a timed producer (no C#);
  no milk (it sheds pellets, it is not a dairy animal).
-->
<Defs>

  <ThingDef ParentName="AnimalThingBase" ADogSaidBody="LegsTail">
    <defName>RM_Excretor</defName>
    <label>excretor</label>
    <description>A heavy-set, three-horned grazer that browses the ruined ground everything else avoids, its body slowly concentrating the metals and salts it can't excrete any other way. Left to its own rhythm it sheds the concentrate as dense, layered pellets every few weeks — which makes a kept herd less a herd and more a slow, patient refinery that happens to also breathe.</description>
    <statBases>
      <MoveSpeed>4.5</MoveSpeed>
      <MarketValue>260</MarketValue>
      <ComfyTemperatureMin>-10</ComfyTemperatureMin>
      <ComfyTemperatureMax>60</ComfyTemperatureMax>
      <FilthRate>16</FilthRate>
      <Wildness>0.55</Wildness>
    </statBases>
    <tools>
      <li>
        <label>horns</label>
        <capacities>
          <li>Scratch</li>
          <li>Stab</li>
        </capacities>
        <power>10</power>
        <cooldownTime>1.65</cooldownTime>
        <linkedBodyPartsGroup>HornAttackTool</linkedBodyPartsGroup>
      </li>
      <li>
        <label>left hoof</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>10</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftLeg</linkedBodyPartsGroup>
      </li>
      <li>
        <label>right hoof</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>10</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>FrontRightLeg</linkedBodyPartsGroup>
      </li>
      <li>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>10</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        <chanceFactor>0.5</chanceFactor>
      </li>
    </tools>
    <comps>
      <li Class="CompProperties_Shearable">
        <woolDef>RM_ContaminantBezoar</woolDef>
        <shearIntervalDays>22</shearIntervalDays>
        <woolAmount>4</woolAmount>
      </li>
    </comps>
    <race>
      <body>QuadrupedAnimalWithHoovesAndHorn</body>
      <herdAnimal>true</herdAnimal>
      <baseBodySize>1.1</baseBodySize>
      <baseHealthScale>2.0</baseHealthScale>
      <baseHungerRate>0.3</baseHungerRate>
      <foodType>VegetarianRoughAnimal</foodType>
      <leatherDef>Leather_Heavy</leatherDef>
      <trainability>None</trainability>
      <roamMtbDays>1.6</roamMtbDays>
      <manhunterOnDamageChance>0.1</manhunterOnDamageChance>
      <gestationPeriodDays>6</gestationPeriodDays>
      <lifeExpectancy>20</lifeExpectancy>
      <litterSizeCurve>
        <points>
          <li>(0.5, 0)</li>
          <li>(1.5, 1)</li>
          <li>(2.5, 1.7)</li>
          <li>(3.5, 0.7)</li>
          <li>(4, 0)</li>
        </points>
      </litterSizeCurve>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.2</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.3</minAge>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
      <soundEating>Herbivore_Eat</soundEating>
    </race>
    <tradeTags>
      <li>AnimalCommon</li>
    </tradeTags>
  </ThingDef>

  <PawnKindDef ParentName="AnimalKindBase">
    <defName>RM_Excretor</defName>
    <label>excretor</label>
    <labelPlural>excretors</labelPlural>
    <race>RM_Excretor</race>
    <combatPower>95</combatPower>
    <ecoSystemWeight>1.0</ecoSystemWeight>
    <wildGroupSize>2~6</wildGroupSize>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/RM_Excretor/RM_Excretor</texPath>
          <drawSize>1.25</drawSize>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/RM_Excretor/RM_Excretor_Dessicated</texPath>
          <drawSize>1.25</drawSize>
        </dessicatedBodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/RM_Excretor/RM_Excretor</texPath>
          <drawSize>1.75</drawSize>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/RM_Excretor/RM_Excretor_Dessicated</texPath>
          <drawSize>1.75</drawSize>
        </dessicatedBodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/RM_Excretor/RM_Excretor</texPath>
          <drawSize>2.0</drawSize>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/RM_Excretor/RM_Excretor_Dessicated</texPath>
          <drawSize>2.0</drawSize>
        </dessicatedBodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>

</Defs>
