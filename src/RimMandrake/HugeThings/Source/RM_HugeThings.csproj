<Project Sdk="Microsoft.NET.Sdk">

  <!--
    HUGE_THINGS_FOOTPRINT_1 - solid trunks for huge plants, selection hitboxes for huge pawns.
    Engine only; content opts in by modExtension. Design:
    design/RimMandrake/giant_footprint_design_2026-10-07.md.
    Build: python3 src/RimMandrake/Utils/winbuild.py HugeThings  (net472, Harmony from brrainz.harmony
    at runtime, never copied local). Compile items are EXPLICIT (SelfTest/ is its own net8.0 fuzz project):
    a new .cs needs a Compile line here.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RM_HugeThings</AssemblyName>
    <RootNamespace>RimMandrake.HugeThings</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version>1.0.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HarmonyDll)' == ''">
    <HarmonyDll>C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\2009463077\Current\Assemblies\0Harmony.dll</HarmonyDll>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Kernel\RM_HugeFootprintKernel.cs" />
    <Compile Include="Building_TrunkBlocker.cs" />
    <Compile Include="CompHugeFootprint.cs" />
    <Compile Include="Extensions.cs" />
    <Compile Include="FootprintMath.cs" />
    <Compile Include="HugeThingsCore.cs" />
    <Compile Include="MapComponent_HugeFootprints.cs" />
    <Compile Include="RM_HugeThingsSettings.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
