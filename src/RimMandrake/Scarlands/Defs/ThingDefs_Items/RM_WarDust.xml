<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- WARSCAR_SETTLING_WEATHER_1: swept up from the settled film; exists only after calm. Art: RM_WarDust (artpipe).
       Uses: tox-gas shell recipe (RM_MakeToxShellFromWarDust), dye filler (RM_StretchDyeWithWarDust),
       blight cure (RM_DustBlight work giver). -->
  <ThingDef ParentName="ResourceBase">
    <defName>RM_WarDust</defName>
    <label>war dust</label>
    <description>Fine grey powder swept off the settled film: ground-up munitions, slag and the poison of an old war. Toxic to handle without care. Packs into tox-gas shells, kills blight on a dusted crop, and stretches dye as a grey filler.</description>
    <graphicData>
      <texPath>Things/Item/Resource/RM_WarDust</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>75</stackLimit>
    <statBases>
      <MarketValue>4</MarketValue>
      <Mass>0.05</Mass>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <soundInteract>Standard_Drop</soundInteract>
    <soundDrop>Standard_Drop</soundDrop>
  </ThingDef>
</Defs>
