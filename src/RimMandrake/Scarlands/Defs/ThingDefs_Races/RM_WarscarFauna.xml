<!--
  RM_WarscarFauna.xml                    WARSCAR_FREE_TIER_BODY_1

  The free tier's own cast for RM_Warscar. Design: design/Jawa/worldbuilding/
  biomes/warscar_turn3_development_2026-09-30.md section 3 + warscar_bedazzle_cast_2026-09-30.md.

  RM_Chatrak     plated grazer / scaria host; leather RM_ChatrakPlate (RM_WarscarItems.xml)
  RM_Totchak     lives in RM_Totchak.xml (WARSCAR_TOTCHAK_WAKES_1); this item wires its art.
  RM_Tetchik     tiny clicking beetle, inedible; spawns only near glower cells
                 (RM_WarscarPatches.TetchikGlowerGate).
  RM_Pallbearer  was RUT_MortuaryCrawler (retired, 0 occurrences in the canonical save).
                 Corpse-eating is vanilla CarnivoreAnimal behaviour; no extra filth def
                 is shipped (spec allowed "the vanilla dessicated state").
  RM_ScarRoach   was RUT_ScarRoach; RUT_ScarRoach stays as a hidden alias in
                 mandrake.rut.rustcathedralroaches for one release.

  Art: all real (artpipe _artsrc, wired WARSCAR_FREE_TIER_BODY_1).
-->
<Defs>

  <!-- ================= CHATRAK ================= -->
  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Chatrak</defName>
    <label>chatrak</label>
    <description>A low plated grazer whose back plates stack like an earthwork and are pocked by ricochets. It grazes with its head down at the rust-orange lichen on wrecks and ignores gunfire, and its own wounds, with equal calm. Its hide turns bullets. Most wild chatrak carry scaria, and a scaria chatrak is the thing to be elsewhere from.</description>
    <statBases>
      <MoveSpeed>3.2</MoveSpeed>
      <Mass>180</Mass>
      <MarketValue>380</MarketValue>
      <Wildness>0.7</Wildness>
      <ComfyTemperatureMin>-10</ComfyTemperatureMin>
      <ComfyTemperatureMax>60</ComfyTemperatureMax>
      <ArmorRating_Sharp>0.6</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.3</ArmorRating_Blunt>
      <LeatherAmount>45</LeatherAmount>
      <ToxicResistance>0.5</ToxicResistance>
    </statBases>
    <tools>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>14</power>
        <cooldownTime>2.2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
      </li>
      <li>
        <label>front left hoof</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>11</power>
        <cooldownTime>2.2</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftLeg</linkedBodyPartsGroup>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>12</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>front right hoof</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>11</power>
        <cooldownTime>2.2</cooldownTime>
        <linkedBodyPartsGroup>FrontRightLeg</linkedBodyPartsGroup>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>12</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
    </tools>
    <race>
      <body>QuadrupedAnimalWithHooves</body>
      <herdAnimal>true</herdAnimal>
      <predator>false</predator>
      <baseBodySize>3.0</baseBodySize>
      <baseHealthScale>2.2</baseHealthScale>
      <baseHungerRate>0.7</baseHungerRate>
      <foodType>VegetarianRoughAnimal</foodType>
      <leatherDef>RM_ChatrakPlate</leatherDef>
      <gestationPeriodDays>20</gestationPeriodDays>
      <manhunterOnDamageChance>0</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0</manhunterOnTameFailChance>
      <lifeExpectancy>28</lifeExpectancy>
      <trainability>Simple</trainability>
      <roamMtbDays>4</roamMtbDays>
      <litterSizeCurve>
        <points>
          <li>(0.5, 0)</li>
          <li>(1, 1)</li>
          <li>(1.5, 0.4)</li>
          <li>(2, 0)</li>
        </points>
      </litterSizeCurve>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.3</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.8</minAge>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
    </race>
    <tradeTags>
      <li>AnimalExotic</li>
    </tradeTags>
  </ThingDef>

