  <!-- ================= SCAR ROACH (was RUT_ScarRoach) ================= -->
  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_ScarRoach</defName>
    <label>scar-roach</label>
    <description>A small, quick-scuttling insect that works the Warscar's scar-dust in loose colonies, foraging filth and stray waste from the ground. Not aggressive and not much of a fighter: it flees before it fights, but it never stops moving, and it never runs out of ground to clean.</description>
    <statBases>
      <Wildness>0.9</Wildness>
      <MoveSpeed>3.8</MoveSpeed>
      <ArmorRating_Blunt>0.2</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.15</ArmorRating_Sharp>
      <ComfyTemperatureMin>-40</ComfyTemperatureMin>
      <ComfyTemperatureMax>90</ComfyTemperatureMax>
      <MarketValue>28</MarketValue>
      <LeatherAmount>0</LeatherAmount>
      <ToxicResistance>0.6</ToxicResistance>
    </statBases>
    <uiIconScale>0.6</uiIconScale>
    <tools>
