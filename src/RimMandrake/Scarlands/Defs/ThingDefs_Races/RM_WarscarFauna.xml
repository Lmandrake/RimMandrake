  <!-- ================= PALLBEARER (was RUT_MortuaryCrawler) ================= -->
  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Pallbearer</defName>
    <label>pallbearer</label>
    <description>A heavy, armor-plated scavenger that moves at exactly one speed: unhurried. It works a graveyard the way nothing else here can, patiently and methodically, digesting the preserved dead of ground that won't properly rot. Everything else in the Warscar is one wrong step from madness; the pallbearer never seems to notice there was a war at all, which is exactly what makes it the worst thing to watch eat.</description>
