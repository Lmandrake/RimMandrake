<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_Korrum.xml                                 SWB_RM_FAUNA_DECIDE_HOME_LIKE_CHIKKA

  The korrum (our port of Alpha Animals AA_BoulderMit) is not a Star Wars creature.
  Owner 2026-10-24: "Yes, it appears that a lot of alpha animal ports got
  classified as Star Wars. We should move all of those."
  Moved here (batch 2) from src/RimStarWars/SWBestiary/Defs/DesertPort/RSW_DesertPortMisc_Races.xml;
  defNames renamed RSW_Korrum -> RM_Korrum. Saves holding the old names load through
  src/RimMandrake/LeaningScrub/Defs/Misc/RM_SWBRehome_Aliases.xml.
-->
<Defs>

	<ThingDef ParentName="AnimalThingBase">
		<!-- Alpha Animals AA_BoulderMit -> RM_Korrum (was RSW_Bokka until 2026-09-22; see the header). Body already vanilla TurtleLike (matches sibling RSW_Khorrak/RSW_Zhakka/RSW_Vozzik usage of the same body in this batch); tools/capacities (TurtleBeakAttackTool Bite, HeadAttackTool Blunt) already vanilla, no substitution needed. Dropped: VEF.AnimalBehaviours.CompProperties_AnimalProduct (periodic random-stone-chunk harvest, donor framework - matches this batch's standing rule of dropping AnimalProduct comps, e.g. RM_Chikka/RM_Durrok above), VEF.AnimalBehaviours.AnimalStatExtension modExtension (info-card flavor + linked art image, donor framework). butcherProducts (plain vanilla chunk items, not a comp) kept. Donor's own custom SoundDef AA_BouldermitSound (soundWounded/soundAngry) substituted with vanilla Pawn_Megascarab_Wounded/Pawn_Megascarab_Angry, completing the vanilla Megascarab sound family already used donor-side for Death/Call. This closes the batch's own dangling useMeatFrom reference at RSW_Khorrak above (now useMeatFrom>RM_Korrum). -->
		<defName>RM_Korrum</defName>
		<label>korrum</label>
		<description>A massive genetically-engineered crab that carries a boulder for a shell. Korrums are placid to the point of indifference, ignoring nearly anything short of a direct attack, and their armor is thick enough that most predators leave them alone rather than bother. Old spacer stories tell of one grown so large it had a whole mountain for a home.</description>
		<statBases>
			<MoveSpeed>1.00</MoveSpeed>
			<ComfyTemperatureMin>-65</ComfyTemperatureMin>
			<MarketValue>350</MarketValue>
			<ArmorRating_Blunt>0.7</ArmorRating_Blunt>
			<ArmorRating_Sharp>0.7</ArmorRating_Sharp>
			<LeatherAmount>0</LeatherAmount>
			<MeatAmount>10</MeatAmount>
			<FilthRate>12</FilthRate>
			<Wildness>0.7</Wildness>
		</statBases>
		<tools>
			<li>
				<capacities>
					<li>Bite</li>
				</capacities>
				<power>32</power>
				<cooldownTime>2.1</cooldownTime>
				<linkedBodyPartsGroup>TurtleBeakAttackTool</linkedBodyPartsGroup>
			</li>
			<li>
				<label>head</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>12</power>
				<cooldownTime>1.65</cooldownTime>
				<linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
				<chanceFactor>0.2</chanceFactor>
			</li>
		</tools>
		<race>
			<herdAnimal>false</herdAnimal>
			<predator>false</predator>
			<body>TurtleLike</body>
			<baseBodySize>4.00</baseBodySize>
			<baseHungerRate>0.05</baseHungerRate>
			<baseHealthScale>9.0</baseHealthScale>
			<foodType>VegetarianRoughAnimal</foodType>
			<meatLabel>crab meat</meatLabel>
			<manhunterOnDamageChance>0.01</manhunterOnDamageChance>
			<manhunterOnTameFailChance>0.2</manhunterOnTameFailChance>
			<trainability>None</trainability>
			<gestationPeriodDays>30</gestationPeriodDays>
			<litterSizeCurve>
				<points>
					<li>(0.99, 0)</li>
					<li>(1, 1)</li>
					<li>(1.01, 0)</li>
				</points>
			</litterSizeCurve>
			<lifeExpectancy>650</lifeExpectancy>
			<lifeStageAges>
				<li><def>AnimalBaby</def><minAge>0</minAge></li>
				<li><def>AnimalJuvenile</def><minAge>0.25</minAge></li>
				<li><def>AnimalAdult</def><minAge>0.50</minAge>
					<soundWounded>Pawn_Megascarab_Wounded</soundWounded>
					<soundDeath>Pawn_Megascarab_Death</soundDeath>
					<soundCall>Pawn_Megascarab_Call</soundCall>
					<soundAngry>Pawn_Megascarab_Angry</soundAngry>
				</li>
			</lifeStageAges>
			<soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
			<soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
			<soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
		</race>
		<butcherProducts>
			<ChunkSandstone>2</ChunkSandstone>
			<ChunkGranite>2</ChunkGranite>
			<ChunkLimestone>2</ChunkLimestone>
			<ChunkSlate>2</ChunkSlate>
			<ChunkMarble>2</ChunkMarble>
		</butcherProducts>
		<tradeTags>
			<li>AnimalExotic</li>
		</tradeTags>
	</ThingDef>

	<PawnKindDef ParentName="AnimalKindBase">
		<defName>RM_Korrum</defName>
		<label>korrum</label>
		<race>RM_Korrum</race>
		<combatPower>350</combatPower>
		<canArriveManhunter>false</canArriveManhunter>
		<ecoSystemWeight>0.2</ecoSystemWeight>
		<lifeStages>
			<li>
				<bodyGraphicData>
					<!-- KORRUM_ART_REGEN_1: our own artpipe render, landed 2026-09-24 -->
					<texPath>Things/Pawn/Animal/RM_Korrum/RM_Korrum</texPath>
					<drawSize>1.5</drawSize>
				</bodyGraphicData>
			</li>
			<li>
				<bodyGraphicData>
					<!-- KORRUM_ART_REGEN_1: our own artpipe render, landed 2026-09-24 -->
					<texPath>Things/Pawn/Animal/RM_Korrum/RM_Korrum</texPath>
					<drawSize>2.7</drawSize>
				</bodyGraphicData>
			</li>
			<li>
				<bodyGraphicData>
					<!-- KORRUM_ART_REGEN_1: our own artpipe render, landed 2026-09-24 -->
					<texPath>Things/Pawn/Animal/RM_Korrum/RM_Korrum</texPath>
					<drawSize>3.5</drawSize>
				</bodyGraphicData>
			</li>
		</lifeStages>
	</PawnKindDef>

</Defs>
