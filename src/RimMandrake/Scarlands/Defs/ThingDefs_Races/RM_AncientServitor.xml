<?xml version="1.0" encoding="utf-8"?>
<!-- WARSCAR_HOSPICE_DESERTERS_1. A mechanoid with NO CompProperties_OverseerSubject (comps Inherit=False drops the base mech's), so IsColonyMechRequiringMechanitor is false: it needs no mechanitor. Live-unverified: mech energy need and charging without an overseer subject comp. Art: artpipe done/RM_AncientServitor s/e/n. -->
<Defs>
  <ThingDef ParentName="LightMechanoid">
    <defName>RM_AncientServitor</defName>
    <label>ancient servitor</label>
    <description>A machine of the old line that left its post, died slowly, and was woken in a hospice cradle. It answers to no overseer and needs no mechanitor. It hauls, builds, mines and cleans, and it remembers.</description>
    <statBases>
      <MoveSpeed>3.2</MoveSpeed>
      <WorkSpeedGlobal>1</WorkSpeedGlobal>
      <MarketValue>0</MarketValue>
    </statBases>
    <comps Inherit="False">
      <li Class="RimMandrake.Scarlands.CompProperties_DeserterHistory" />
      <li Class="RimMandrake.Scarlands.CompProperties_DeserterWalker" />
    </comps>
    <race>
      <mechEnabledWorkTypes>
        <li>Hauling</li>
        <li>Construction</li>
        <li>Mining</li>
        <li>Cleaning</li>
      </mechEnabledWorkTypes>
      <lifeStageAges Inherit="False">
        <li><def>MechanoidFullyFormed</def><minAge>0</minAge></li>
      </lifeStageAges>
    </race>
  </ThingDef>

  <PawnKindDef ParentName="NonCombatLightMechanoidKind">
    <defName>RM_AncientServitor</defName>
    <label>ancient servitor</label>
    <race>RM_AncientServitor</race>
    <combatPower>20</combatPower>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Mechanoid/RM_AncientServitor</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.25</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>
</Defs>
