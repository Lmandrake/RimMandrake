<?xml version="1.0" encoding="utf-8"?>
<!--
  WARSCAR_SHEET_DONOR_PORT_1. The electric tick: a small, short-lived war-insect that bursts into a discharge when
  it dies. Owned port of the Insectoids 2 Isopoda geneline electrictick (Who.VFEE.IsopodaGeneline SW_Electrictick,
  1.6/Defs/ThingDefs_Races/Electrictick.xml; its parent VFEI2_BaseInsect from VFE Insectoids 2 is inlined).
  Name and description kept (owner's Warscar sheet 2026-10-05 ruled art only; "Electrictick" is written as
  "electric tick"). Free RM_ tier, ONE HOME: the Warscar. Stats, tools, comps, race fields and pawnkind numbers are
  the donor's own, EXCEPT these donor-only references (all PROVISIONAL):
    - tool capacity SW_FlameCut (a cut dealt by DamageWorker_Flame) -> vanilla Cut; the burn-on-hit is dropped.
      The vanilla EMP extra damage (20, always) is kept.
    - death burst explosiveDamageType SW_FalmeWithEMP (Isopoda_Geneline.DamageWoker_FalmeWithEMP, burn + EMP) ->
      vanilla EMP: the burst still stuns machines but no longer sets fire to anything.
    - thinkTreeMain ThinkTree_SW_Electrictick (fight anything in 65 cells, else wander; a summoned munition's
      brain) dropped: the vanilla animal think tree, as a wild animal.
    - Isopoda_Geneline.CompNoCorpse dropped: it leaves a corpse.
    - leatherDef VFEI2_Chitin dropped: no leather (LeatherAmount 0), as vanilla's own insectoids
    - renderTree VFEI2_Unarmored dropped; dessicated graphic, colour tint and CutoutComplex dropped
      (the ruled render carries its own colour).
  ⚠️ KEPT FROM THE DONOR, OWNER QUESTION: the vanilla CompProperties_MechPowerCell (totalPowerTicks 2500,
  killWhenDepleted defaults true) means every tick dies about one in-game hour after it spawns, bursting as it
  goes. That is the donor's design (it is a summoned munition) and is what the Warscar casts today; whether a
  wild electric tick should live a normal life is his call (his 2026-09-10 note: "come in large numbers").
  ART: gapall_SW_Electrictick_v1 (east/south/north, the owner's B pick), installed 2026-10-06 via the art ledger
  (ruling 937f0231e943a91424d6) at the texPath below.
-->
<Defs>

  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_ElectricTick</defName>
    <label>electric tick</label>
    <description>A medium bioengineered insectoid. Designed to destroy the mechanoid. The growth rate is extremely rapid, but as a result, the lifespan is very short. The discharge organ occupies more than half of the body tissue and releases a strong electric current upon death.</description>
    <statBases>
      <MoveSpeed>6.00</MoveSpeed>
      <Flammability>0</Flammability>
      <ComfyTemperatureMin>-20</ComfyTemperatureMin>
      <ComfyTemperatureMax>120</ComfyTemperatureMax>
      <MarketValue>100</MarketValue>
      <ArmorRating_Sharp>0.40</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.25</ArmorRating_Blunt>
      <ArmorRating_Heat>2</ArmorRating_Heat>
      <LeatherAmount>0</LeatherAmount>
      <Wildness>0.4</Wildness>
      <ToxicResistance>1</ToxicResistance>
      <ToxicEnvironmentResistance MayRequire="Ludeon.RimWorld.Biotech">0.8</ToxicEnvironmentResistance>
      <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">1</VacuumResistance>
    </statBases>
    <tools>
      <li>
        <label>claw</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>5</power>
        <cooldownTime>1</cooldownTime>
        <armorPenetration>0.60</armorPenetration>
        <extraMeleeDamages>
          <li>
            <def>EMP</def>
            <amount>20</amount>
            <chance>1</chance>
          </li>
        </extraMeleeDamages>
        <linkedBodyPartsGroup>HeadClaw</linkedBodyPartsGroup>
      </li>
      <li>
        <label>head claw</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>5</power>
        <cooldownTime>1</cooldownTime>
        <armorPenetration>0.60</armorPenetration>
        <extraMeleeDamages>
          <li>
            <def>EMP</def>
            <amount>20</amount>
            <chance>1</chance>
          </li>
        </extraMeleeDamages>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <race>
      <body>BeetleLikeWithClaw</body>
      <fleshType>Insectoid</fleshType>
      <bloodDef>Filth_BloodInsect</bloodDef>
      <meatColor>(160,168,139)</meatColor>
      <meatMarketValue>0.5</meatMarketValue>
      <foodType>OmnivoreAnimal, AnimalProduct</foodType>
      <manhunterOnDamageChance>0.50</manhunterOnDamageChance>
      <soundEating>Insectoid_Eat</soundEating>
      <canBeVacuumBurnt>false</canBeVacuumBurnt>
      <baseHungerRate>0.25</baseHungerRate>
      <baseBodySize>0.25</baseBodySize>
      <baseHealthScale>0.25</baseHealthScale>
      <useMeatFrom>Megaspider</useMeatFrom>
      <lifeExpectancy>10</lifeExpectancy>
      <trainability>Intermediate</trainability>
      <lifeStageAges>
        <li>
          <def>EusocialInsectAdult</def>
          <soundWounded>Pawn_Megascarab_Wounded</soundWounded>
          <soundDeath>Pawn_Megascarab_Death</soundDeath>
          <soundCall>Pawn_Megascarab_Call</soundCall>
          <soundAngry>Pawn_Megascarab_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <comps>
      <li Class="CompProperties_MechPowerCell">
        <totalPowerTicks>2500</totalPowerTicks>
        <labelOverride>Remaining Life</labelOverride>
        <tooltipOverride>This creature has an extremely short lifespan and will soon die.</tooltipOverride>
      </li>
      <li Class="CompProperties_Explosive">
        <explosiveRadius>1.9</explosiveRadius>
        <damageAmountBase>10</damageAmountBase>
        <armorPenetrationBase>1.0</armorPenetrationBase>
        <destroyThingOnExplosionSize>1</destroyThingOnExplosionSize>
        <explosiveDamageType>EMP</explosiveDamageType>
        <explodeOnKilled>true</explodeOnKilled>
        <chanceNeverExplodeFromDamage>1</chanceNeverExplodeFromDamage>
      </li>
    </comps>
    <ingredient>
      <mergeCompatibilityTags>
        <li MayRequire="Ludeon.RimWorld.Ideology">InsectMeat</li>
      </mergeCompatibilityTags>
    </ingredient>
  </ThingDef>

  <PawnKindDef ParentName="AnimalKindBase">
    <defName>RM_ElectricTick</defName>
    <label>electric tick</label>
    <race>RM_ElectricTick</race>
    <combatPower>40</combatPower>
    <canArriveManhunter>false</canArriveManhunter>
    <ecoSystemWeight>0.50</ecoSystemWeight>
    <defaultFactionType>Insect</defaultFactionType>
    <forceNoDeathNotification>true</forceNoDeathNotification>
    <aiAvoidCover>true</aiAvoidCover>
    <defendPointRadius>0</defendPointRadius>
    <forceDeathOnDowned>true</forceDeathOnDowned>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/RM_ElectricTick/RM_ElectricTick</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.5</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>

</Defs>
