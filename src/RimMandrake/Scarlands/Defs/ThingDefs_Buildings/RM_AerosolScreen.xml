<?xml version="1.0" encoding="utf-8"?>
<!-- WARSCAR_AEROSOL_SCREEN_1 part 5: the player-built aerosol screen and its core.
     Comp: RM_CompAerosolScreen (Scarlands/Source/RM_AerosolScreen.cs). Burns dielectric gel; half radius without it.
     Gravship-placeable: an ordinary building, nothing excludes it from a ship area.
     Research gate, rings and ring salvage are built (RM_WarscarProjectors.xml, RM_WarscarRings.cs, RM_WarscarSalvage.cs). Not yet: calibration (part 3), glower shielding (part 9).
     ART OWED: both defs borrow existing art as a placeholder (RM_OldLineTurret_Base, RM_Etchant). -->
<Defs>
  <ThingDef ParentName="ResourceBase">
    <defName>RM_ProjectorCore</defName>
    <label>projector core</label>
    <description>The humming heart of an old-line aerosol projector. Nothing humans make can replace it. Needed to build an aerosol screen.</description>
    <graphicData><texPath>Things/Item/RM_Etchant</texPath><graphicClass>Graphic_StackCount</graphicClass></graphicData>
    <thingCategories><li>Manufactured</li></thingCategories>
    <stackLimit>5</stackLimit>
    <statBases><MarketValue>600</MarketValue><Mass>2</Mass><Flammability>0</Flammability></statBases>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>RM_AerosolScreen</defName>
    <label>aerosol screen</label>
    <description>A projector that holds a dome of still, clean air over everything inside it. Blocks toxic fallout, toxic weather and settling film. It does nothing against bullets, heat or cold. Burns dielectric gel; without it the dome shrinks to half.</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Security/RM_OldLineTurret_Base</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
      <damageData><rect>(0.2,0.2,0.6,0.6)</rect></damageData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <stealable>false</stealable>
    <rotatable>false</rotatable>
    <size>(2,2)</size>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories><li>BuildingsMisc</li></thingCategories>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <Flammability>0.3</Flammability>
      <WorkToBuild>18000</WorkToBuild>
      <Mass>35</Mass>
      <Beauty>-6</Beauty>
    </statBases>
    <tickerType>Normal</tickerType>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>400</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>0.33</fuelConsumptionRate>
        <fuelCapacity>10</fuelCapacity>
        <fuelFilter><thingDefs><li>RM_DielectricGel</li></thingDefs></fuelFilter>
        <consumeFuelOnlyWhenUsed>false</consumeFuelOnlyWhenUsed>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
      </li>
      <li Class="RimMandrake.Scarlands.RM_CompProperties_AerosolScreen">
        <radius>7.9</radius>
      </li>
    </comps>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <hasTooltip>true</hasTooltip>
    <costList>
      <Plasteel>60</Plasteel>
      <ComponentSpacer>2</ComponentSpacer>
      <RM_ProjectorCore>1</RM_ProjectorCore>
    </costList>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Misc</designationCategory>
    <building>
      <ai_combatDangerous>false</ai_combatDangerous>
    </building>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <researchPrerequisites><li>RM_AerosolScreenResearch</li></researchPrerequisites>
  </ThingDef>
</Defs>
