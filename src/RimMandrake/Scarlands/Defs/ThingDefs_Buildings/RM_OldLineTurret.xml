<?xml version="1.0" encoding="utf-8"?>
<!-- WARSCAR_TURRETS_TRACK_1. The refit result of a broken ancient turret: slow, long-ranged, heavy,
     player-owned, powered. Shape re-authored from RUT_AncientShieldedTurret (AssailantSalvage), on RM.
     Cost is advanced components until WARSCAR_RAINBOW_POOLS_1 ships RM_Etchant (then add it to costList
     and drop one component). The long WorkToBuild is the "slower" half of that fallback.
     Art owed: reuses a vanilla turret base until a Warscar sprite exists. -->
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>RM_OldLineTurret</defName>
    <label>old-line turret</label>
    <description>A broken emplacement from the old line, rebuilt around one long barrel. It fires rarely and hits like a falling wall, out to a distance the ancients never needed to explain. Needs power.</description>
    <thingClass>Building_TurretGun</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Security/TurretMini_Base</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
      <damageData><rect>(0.2,0.2,0.6,0.6)</rect></damageData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <stealable>false</stealable>
    <rotatable>false</rotatable>
    <size>(2,2)</size>
    <thingCategories><li>BuildingsSecurity</li></thingCategories>
    <statBases>
      <MaxHitPoints>260</MaxHitPoints>
      <Flammability>0.4</Flammability>
      <WorkToBuild>24000</WorkToBuild>
      <Mass>40</Mass>
      <Beauty>-12</Beauty>
      <ShootingAccuracyTurret>0.98</ShootingAccuracyTurret>
    </statBases>
    <tickerType>Normal</tickerType>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>200</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Stunnable">
        <affectedDamageDefs><li>Stun</li><li>EMP</li></affectedDamageDefs>
      </li>
    </comps>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.6</fillPercent>
    <hasTooltip>true</hasTooltip>
    <costList>
      <Steel>200</Steel>
      <ComponentSpacer>4</ComponentSpacer>
    </costList>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites><li>PrecisionRifling</li></researchPrerequisites>
    <designationCategory>Security</designationCategory>
    <building>
      <combatPower>70</combatPower>
      <ai_combatDangerous>true</ai_combatDangerous>
      <turretGunDef>RM_OldLineTurret_Gun</turretGunDef>
      <turretBurstCooldownTime>14</turretBurstCooldownTime>
    </building>
    <placeWorkers>
      <li>PlaceWorker_TurretTop</li>
      <li>PlaceWorker_ShowTurretRadius</li>
    </placeWorkers>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>RM_OldLineTurret_Bullet</defName>
    <label>old-line slug</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.6,1.6)</drawSize>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>55</damageAmountBase>
      <armorPenetrationBase>1.2</armorPenetrationBase>
      <speed>110</speed>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="BaseWeaponTurret">
    <defName>RM_OldLineTurret_Gun</defName>
    <label>old-line turret</label>
    <description>The long barrel of a refitted old-line turret.</description>
    <graphicData>
      <texPath>Things/Building/Security/TurretMini_Top</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <AccuracyTouch>0.85</AccuracyTouch>
      <AccuracyShort>0.85</AccuracyShort>
      <AccuracyMedium>0.8</AccuracyMedium>
      <AccuracyLong>0.7</AccuracyLong>
      <RangedWeapon_Cooldown>14</RangedWeapon_Cooldown>
      <DeteriorationRate>0</DeteriorationRate>
      <Mass>10</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <defaultProjectile>RM_OldLineTurret_Bullet</defaultProjectile>
        <warmupTime>1.5</warmupTime>
        <range>52.9</range>
        <burstShotCount>1</burstShotCount>
        <soundCast>Shot_Sniper</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>12</muzzleFlashScale>
      </li>
    </verbs>
  </ThingDef>
</Defs>
