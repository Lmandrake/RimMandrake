<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- WARSCAR_SETTLING_WEATHER_1 spec 6: war dust is a recipe input for tox-gas shells, a pigment filler that
       stretches dye (below), and an insecticide (RM_DustBlight work giver, C#). Numbers INVENTED. -->
  <RecipeDef>
    <defName>RM_MakeToxShellFromWarDust</defName>
    <label>make tox shell from war dust</label>
    <description>Pack war dust into a tox-gas shell.</description>
    <jobString>Packing a tox shell.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <workAmount>800</workAmount>
    <ingredients>
      <li>
        <filter><thingDefs><li>RM_WarDust</li></thingDefs></filter>
        <count>12</count>
      </li>
      <li>
        <filter><thingDefs><li>Steel</li></thingDefs></filter>
        <count>8</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs><li>RM_WarDust</li><li>Steel</li></thingDefs>
    </fixedIngredientFilter>
    <products><Shell_Toxic>1</Shell_Toxic></products>
    <skillRequirements><Crafting>4</Crafting></skillRequirements>
    <workSkill>Crafting</workSkill>
    <recipeUsers><li>TableMachining</li></recipeUsers>
  </RecipeDef>
  <RecipeDef>
    <defName>RM_StretchDyeWithWarDust</defName>
    <label>stretch dye with war dust</label>
    <description>Grind war dust into dye as a grey filler. Two parts dye and a handful of dust make three parts dye; the colour is the same once it is on a wall.</description>
    <jobString>Stretching dye with war dust.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <workAmount>400</workAmount>
    <ingredients>
      <li>
        <filter><thingDefs><li>Dye</li></thingDefs></filter>
        <count>2</count>
      </li>
      <li>
        <filter><thingDefs><li>RM_WarDust</li></thingDefs></filter>
        <count>6</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs><li>Dye</li><li>RM_WarDust</li></thingDefs>
    </fixedIngredientFilter>
    <products><Dye>3</Dye></products>
    <workSkill>Crafting</workSkill>
    <recipeUsers><li>CraftingSpot</li></recipeUsers>
  </RecipeDef>
</Defs>
