<?xml version="1.0" encoding="utf-8"?>
<!--
  GRAVSHIP_ACOUSTIC_SCANNER_1: the acoustic-scanner payload for RM_Warscar.
  Owner decision by question card 2026-10-06: the payload goes on EVERY biome of ours.

  Pure XML, FindMod-guarded on "RimMandrake: Acoustic Scanner", so the extension class
  is only named while its assembly is active. Every def is a defName STRING resolved
  at pulse time (GetNamedSilentFail), so a target naming another mod's def just hears
  nothing when that mod is absent. Each target is drawn from this biome's own content;
  the biome's sitting may re-author it. The reading is always banded by the scanner.
-->
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>RimMandrake: Acoustic Scanner</li>
    </mods>
    <match Class="PatchOperationAddModExtension">
      <xpath>/Defs/BiomeDef[defName="RM_Warscar"]</xpath>
      <value>
        <li Class="RimMandrake.AcousticScanner.RM_AcousticPayloadExtension">
          <quietText>Slag and broken floor, picked clean. Nothing down there but the old war's dust.</quietText>
          <targets>
            <li>
              <label>unexploded shell</label>
              <reading>A dense, hard, pointed echo in the slag. Do not dig carelessly.</reading>
              <color>(1, 0.3, 0.25)</color>
              <weight>3</weight>
              <thingDefs>
                <li>RM_BuriedOrdnance</li>
              </thingDefs>
            </li>
            <li>
              <label>kneeling machines</label>
              <reading>Heavy, quiet metal, folded down where it stopped.</reading>
              <color>(0.8, 0.85, 1)</color>
              <thingDefs>
                <li>RM_KneelingChassis_Slagged</li>
                <li>RM_KneelingChassis_Posed</li>
                <li>RM_KneelingChassis_Intact</li>
              </thingDefs>
            </li>
            <li>
              <label>hollow behind a wall</label>
              <reading>A thin hollow ring behind an old wall panel: there is a space back there.</reading>
              <color>(1, 0.85, 0.4)</color>
              <thingDefs>
                <li>RM_LoosenedPanel</li>
                <li>RM_InscribedPanel_Hospice</li>
                <li>RM_InscribedPanel_Projector</li>
                <li>RM_InscribedPanel_Pool</li>
              </thingDefs>
            </li>
            <li>
              <label>stripped wreck</label>
              <reading>The bare ribs of a fallen warship, ringing hollow.</reading>
              <color>(0.8, 0.8, 0.85)</color>
              <thingDefs>
                <li>RM_WarscarWreckHull</li>
                <li>RM_WarscarWreckFrame</li>
              </thingDefs>
            </li>
            <li>
              <label>bunker void</label>
              <reading>The echo drops into a sealed space under the old line.</reading>
              <color>(0.6, 0.6, 0.9)</color>
              <hiddenCaves>true</hiddenCaves>
              <cellSampleStride>4</cellSampleStride>
            </li>
          </targets>
        </li>
      </value>
    </match>
  </Operation>
</Patch>
