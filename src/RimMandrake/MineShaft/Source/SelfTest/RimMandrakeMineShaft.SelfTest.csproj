<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Mine Shaft offline fuzz, Approach B. Plain net8.0, zero RimWorld/Unity references: ../Kernel/RM_MineShaftKernel.cs is the
    PRODUCTION file the mod compiles. Run: python3 src/RimMandrake/Utils/selftest_mineshaft_fuzz.py
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RimMandrakeMineShaft.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.MineShaft.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Kernel\RM_MineShaftKernel.cs" />
    <Compile Include="MineShaftFuzz.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
