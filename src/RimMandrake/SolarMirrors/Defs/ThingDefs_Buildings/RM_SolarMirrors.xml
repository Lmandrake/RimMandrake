<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_SolarMirrors.xml                 RimMandrake: Solar Mirrors — SOLAR_MIRRORS_MOD_DESIGN_1 §3.2, §5 E1

  Every cost, range, reflectivity, work and threshold below is PROVISIONAL (first guesses; tune live).
  Art: PLACEHOLDER textures only (vanilla SolarCollector / ElectricSmelter, Stillsand's RM_SunLance_Base).
  No artpipe job exists for any of these (artpipe_state.py find mirror/heliostat/sunstone/heliograph,
  2026-10-06); the jobs owed are listed in Transient/solar_mirrors_20261006.md.

  A mirror must never cast its own shade: fillPercent below the shade grid's 0.8 caster threshold and
  staticSunShadowHeight 0.
-->
<Defs>

  <ThingDef Name="RM_MirrorBase" ParentName="BuildingBase" Abstract="True">
    <thingClass>Building</thingClass>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>40</pathCost>
    <fillPercent>0.3</fillPercent>
    <staticSunShadowHeight>0</staticSunShadowHeight>
    <castEdgeShadows>false</castEdgeShadows>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <canOverlapZones>false</canOverlapZones>
    <designationCategory>Misc</designationCategory>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories><li>BuildingsMisc</li></thingCategories>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <repairEffect>Repair</repairEffect>
  </ThingDef>

  <ThingDef ParentName="RM_MirrorBase">
    <defName>RM_SignalMirror</defName>
    <label>signal mirror</label>
    <description>A hand-sized mirror on a post. It throws a small patch of sunlight onto the cell it is aimed at. A colonist has to walk over and turn it to aim it. It reflects best back toward the side the sun is on, and does nothing in shadow, at night or under a roof.</description>
    <graphicData>
      <texPath>Things/Building/Security/RM_SunLance_Base</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>40</MaxHitPoints>
      <WorkToBuild>600</WorkToBuild>
      <Mass>4</Mass>
      <Flammability>0.5</Flammability>
      <Beauty>1</Beauty>
    </statBases>
    <costList>
      <WoodLog>10</WoodLog>
      <Silver>5</Silver>
    </costList>
    <comps>
      <li Class="RimMandrake.SolarMirrors.RM_CompProperties_Mirror">
        <reflectivity>0.6</reflectivity>
        <spotSize>1</spotSize>
        <maxRange>30</maxRange>
        <reAimTicks>300</reAimTicks>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="RM_MirrorBase">
    <defName>RM_StaticMirror</defName>
    <label>static mirror</label>
    <description>A framed metal mirror on a fixed stand. It throws a patch of sunlight two cells across onto the cell it is aimed at. A colonist has to walk over and turn it to aim it. It does not follow the sun, so where the sun moves across the sky its patch of light slowly drifts away from the target. Silver and gold reflect best.</description>
    <graphicData>
      <texPath>Things/Building/Power/SolarCollector</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <size>(2,2)</size>
    <stuffCategories><li>Metallic</li></stuffCategories>
    <costStuffCount>40</costStuffCount>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>1800</WorkToBuild>
      <Mass>25</Mass>
      <Flammability>0</Flammability>
      <Beauty>2</Beauty>
    </statBases>
    <researchPrerequisites><li>Smithing</li></researchPrerequisites>
    <comps>
      <li Class="RimMandrake.SolarMirrors.RM_CompProperties_Mirror">
        <reflectivity>0.6</reflectivity>
        <stuffReflectivity>
          <li><stuff>Silver</stuff><value>0.95</value></li>
          <li><stuff>Gold</stuff><value>0.9</value></li>
          <li><stuff>Plasteel</stuff><value>0.85</value></li>
          <li><stuff>Steel</stuff><value>0.7</value></li>
        </stuffReflectivity>
        <spotSize>2</spotSize>
        <maxRange>50</maxRange>
        <reAimTicks>600</reAimTicks>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="RM_MirrorBase">
    <defName>RM_Heliostat</defName>
    <label>heliostat</label>
    <description>A powered mirror on a two-axis mount. It is aimed at once from its controls and turns on its own to hold the target as the sun moves, throwing a patch of sunlight three cells across. Without power it stops where it is and acts like a static mirror until power comes back.</description>
    <graphicData>
      <texPath>Things/Building/Power/SolarCollector</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <size>(3,3)</size>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>4000</WorkToBuild>
      <Mass>60</Mass>
      <Flammability>0</Flammability>
      <Beauty>2</Beauty>
    </statBases>
    <costList>
      <Steel>120</Steel>
      <Silver>30</Silver>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    <researchPrerequisites><li>Electricity</li></researchPrerequisites>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>150</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="RimMandrake.SolarMirrors.RM_CompProperties_Mirror">
        <reflectivity>0.9</reflectivity>
        <spotSize>3</spotSize>
        <maxRange>70</maxRange>
        <tracks>true</tracks>
        <instantAim>true</instantAim>
        <reAimTicks>900</reAimTicks>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="RM_MirrorBase">
    <defName>RM_SunStone</defName>
    <label>sun-stone</label>
    <description>A flat stone plate that shows whether mirror light reaches it. Plain sun does not count: it reads lit only when a mirror's beam falls on it.</description>
    <graphicData>
      <texPath>Things/Building/Power/SolarCollector</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <size>(1,1)</size>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <fillPercent>0.05</fillPercent>
    <stuffCategories><li>Stony</li></stuffCategories>
    <costStuffCount>20</costStuffCount>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>500</WorkToBuild>
      <Mass>10</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <comps>
      <li Class="RimMandrake.SolarMirrors.RM_CompProperties_LightReceiver">
        <litAt>0.5</litAt>
        <unlitBelow>0.35</unlitBelow>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BenchBase">
    <defName>RM_SolarFurnace</defName>
    <label>solar furnace</label>
    <description>A ceramic-lined hearth built to sit in concentrated sunlight. It smelts metal from slag and scrap with no fuel and no power, but only while the light of two or more mirrors is focused on it. In plain sun, at night or under a roof it stands idle.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/ElectricSmelter</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3.5,1.5)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <size>(3,1)</size>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <staticSunShadowHeight>0</staticSunShadowHeight>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <designationCategory>Production</designationCategory>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <WorkToBuild>3000</WorkToBuild>
      <Mass>40</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <costList>
      <Steel>100</Steel>
      <Silver>20</Silver>
    </costList>
    <researchPrerequisites><li>Smithing</li></researchPrerequisites>
    <building>
      <workTableRoomRole>Workshop</workTableRoomRole>
      <workTableNotInRoomRoleFactor>1</workTableNotInRoomRoleFactor>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
    </building>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <surfaceType>Item</surfaceType>
    <recipes>
      <li>ExtractMetalFromSlag</li>
      <li>SmeltOrDestroyThing</li>
      <li>SmeltWeapon</li>
      <li>SmeltApparel</li>
    </recipes>
    <comps>
      <!-- CompProperties_ReportWorkSpeed and PlaceWorker_ReportWorkSpeedPenalties come from BenchBase -->
      <li Class="RimMandrake.SolarMirrors.RM_CompProperties_LightReceiver">
        <!-- above 1: one mirror (0.6-0.95) is not enough; two or more must converge -->
        <litAt>1.3</litAt>
        <unlitBelow>1.1</unlitBelow>
        <gatesBills>true</gatesBills>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
  </ThingDef>

</Defs>
