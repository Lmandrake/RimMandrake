<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_SolarMirrors.xml                 RimMandrake: Solar Mirrors — SOLAR_MIRRORS_MOD_DESIGN_1 §3.2, §5 E1

  Every cost, range, reflectivity, work and threshold below is PROVISIONAL (first guesses; tune live).
  Art: PLACEHOLDER textures only (vanilla SolarCollector / ElectricSmelter / Wall / Column / HorseshoesPin, Stillsand's
  RM_SunLance_Base). artpipe_state.py found no art for any of these defs (2026-10-08); twelve jobs are queued
  (solarmirrors_*_v1, rimflow item SOLAR_MIRRORS_BUILD_1) for Things/Building/RM_SolarMirrors/<defName> (+ _Lit for the
  sun-stone). When they install, repoint each texPath here. The vault wall (a linked atlas) has no job: the pipeline
  cannot make atlases.

  A mirror must never cast its own shade: fillPercent below the shade grid's 0.8 caster threshold and
  staticSunShadowHeight 0.
-->
<Defs>

  <ThingDef Name="RM_MirrorBase" ParentName="BuildingBase" Abstract="True">
    <thingClass>Building</thingClass>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>40</pathCost>
    <fillPercent>0.3</fillPercent>
    <staticSunShadowHeight>0</staticSunShadowHeight>
    <castEdgeShadows>false</castEdgeShadows>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <canOverlapZones>false</canOverlapZones>
    <designationCategory>Misc</designationCategory>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories><li>BuildingsMisc</li></thingCategories>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <repairEffect>Repair</repairEffect>
  </ThingDef>

  <ThingDef ParentName="RM_MirrorBase">
    <defName>RM_SignalMirror</defName>
    <label>signal mirror</label>
    <description>A hand-sized mirror on a post. It throws a small patch of sunlight onto the cell it is aimed at. A colonist has to walk over and turn it to aim it. It reflects best back toward the side the sun is on, and does nothing in shadow, at night or under a roof. By day a colonist can also use it as a heliograph, flashing a friendly settlement within reach to open talks with it.</description>
    <graphicData>
      <texPath>Things/Building/Security/RM_SunLance_Base</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>40</MaxHitPoints>
      <WorkToBuild>600</WorkToBuild>
      <Mass>4</Mass>
      <Flammability>0.5</Flammability>
      <Beauty>1</Beauty>
    </statBases>
    <costList>
      <WoodLog>10</WoodLog>
      <Silver>5</Silver>
    </costList>
    <comps>
      <li Class="RimMandrake.SolarMirrors.RM_CompProperties_Mirror">
        <reflectivity>0.6</reflectivity>
        <spotSize>1</spotSize>
        <maxRange>30</maxRange>
        <reAimTicks>300</reAimTicks>
      </li>
      <!-- §5 E3 (SOLAR_MIRRORS_BUILD_1): flash a friendly settlement by day. flashTicks PROVISIONAL. -->
      <li Class="RimMandrake.SolarMirrors.RM_CompProperties_Heliograph">
        <flashTicks>300</flashTicks>
        <minSource>0.5</minSource>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="RM_MirrorBase">
    <defName>RM_StaticMirror</defName>
    <label>static mirror</label>
    <description>A framed metal mirror on a fixed stand. It throws a patch of sunlight two cells across onto the cell it is aimed at. A colonist has to walk over and turn it to aim it. It does not follow the sun, so where the sun moves across the sky its patch of light slowly drifts away from the target. Silver and gold reflect best.</description>
    <graphicData>
      <texPath>Things/Building/Power/SolarCollector</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <size>(2,2)</size>
    <stuffCategories><li>Metallic</li></stuffCategories>
    <costStuffCount>40</costStuffCount>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>1800</WorkToBuild>
      <Mass>25</Mass>
      <Flammability>0</Flammability>
      <Beauty>2</Beauty>
    </statBases>
    <researchPrerequisites><li>Smithing</li></researchPrerequisites>
    <comps>
      <li Class="RimMandrake.SolarMirrors.RM_CompProperties_Mirror">
        <reflectivity>0.6</reflectivity>
        <stuffReflectivity>
          <li><stuff>Silver</stuff><value>0.95</value></li>
          <li><stuff>Gold</stuff><value>0.9</value></li>
          <li><stuff>Plasteel</stuff><value>0.85</value></li>
          <li><stuff>Steel</stuff><value>0.7</value></li>
        </stuffReflectivity>
        <spotSize>2</spotSize>
        <maxRange>50</maxRange>
        <reAimTicks>600</reAimTicks>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="RM_MirrorBase">
    <defName>RM_Heliostat</defName>
    <label>heliostat</label>
    <description>A powered mirror on a two-axis mount. It is aimed at once from its controls and turns on its own to hold the target as the sun moves, throwing a patch of sunlight three cells across. Without power it stops where it is and acts like a static mirror until power comes back.</description>
    <graphicData>
      <texPath>Things/Building/Power/SolarCollector</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <size>(3,3)</size>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>4000</WorkToBuild>
      <Mass>60</Mass>
      <Flammability>0</Flammability>
      <Beauty>2</Beauty>
    </statBases>
    <costList>
      <Steel>120</Steel>
      <Silver>30</Silver>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    <researchPrerequisites><li>Electricity</li></researchPrerequisites>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>150</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="RimMandrake.SolarMirrors.RM_CompProperties_Mirror">
        <reflectivity>0.9</reflectivity>
        <spotSize>3</spotSize>
        <maxRange>70</maxRange>
        <tracks>true</tracks>
        <instantAim>true</instantAim>
        <reAimTicks>900</reAimTicks>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="RM_MirrorBase">
    <defName>RM_SunStone</defName>
    <label>sun-stone</label>
    <description>A flat stone plate that shows whether mirror light reaches it. Plain sun does not count: it reads lit only when a mirror's beam falls on it.</description>
    <graphicData>
      <texPath>Things/Building/Power/SolarCollector</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <size>(1,1)</size>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <fillPercent>0.05</fillPercent>
    <stuffCategories><li>Stony</li></stuffCategories>
    <costStuffCount>20</costStuffCount>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>500</WorkToBuild>
      <Mass>10</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <comps>
      <li Class="RimMandrake.SolarMirrors.RM_CompProperties_LightReceiver">
        <litAt>0.5</litAt>
        <unlitBelow>0.35</unlitBelow>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BenchBase">
    <defName>RM_SolarFurnace</defName>
    <label>solar furnace</label>
    <description>A ceramic-lined hearth built to sit in concentrated sunlight. It smelts metal from slag and scrap with no fuel and no power, but only while the light of two or more mirrors is focused on it. In plain sun, at night or under a roof it stands idle.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/ElectricSmelter</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3.5,1.5)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <size>(3,1)</size>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <staticSunShadowHeight>0</staticSunShadowHeight>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <designationCategory>Production</designationCategory>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <WorkToBuild>3000</WorkToBuild>
      <Mass>40</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <costList>
      <Steel>100</Steel>
      <Silver>20</Silver>
    </costList>
    <researchPrerequisites><li>Smithing</li></researchPrerequisites>
    <building>
      <workTableRoomRole>Workshop</workTableRoomRole>
      <workTableNotInRoomRoleFactor>1</workTableNotInRoomRoleFactor>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
    </building>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <surfaceType>Item</surfaceType>
    <recipes>
      <li>ExtractMetalFromSlag</li>
      <li>SmeltOrDestroyThing</li>
      <li>SmeltWeapon</li>
      <li>SmeltApparel</li>
    </recipes>
    <comps>
      <!-- CompProperties_ReportWorkSpeed and PlaceWorker_ReportWorkSpeedPenalties come from BenchBase -->
      <li Class="RimMandrake.SolarMirrors.RM_CompProperties_LightReceiver">
        <!-- above 1: one mirror (0.6-0.95) is not enough; two or more must converge -->
        <litAt>1.3</litAt>
        <unlitBelow>1.1</unlitBelow>
        <gatesBills>true</gatesBills>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
  </ThingDef>

  <!-- ═══ SOLAR_MIRRORS_BUILD_1 ═══ All numbers PROVISIONAL; art is placeholder (vanilla textures) until the queued
       artpipe jobs (solarmirrors_*_v1, item SOLAR_MIRRORS_BUILD_1) are installed at Things/Building/RM_SolarMirrors/<defName>. -->

  <!-- §3.4: the ancient field's mirror. Seized until freed (one component + Construction); then it turns, by job,
       only between its three detents, and always throws at the detent's pin. Not buildable, not claimable. -->
  <ThingDef ParentName="RM_MirrorBase">
    <defName>RM_AncientHeliostat</defName>
    <label>ancient heliostat</label>
    <description>A sand-scoured heliostat from a vanished people, its brass pitted and its bearings seized. Freed, it still turns, but only between the old brass pins set in the ground around it, and it throws its light exactly on whichever pin it faces. Selecting it shows where each pin would send its light.</description>
    <graphicData>
      <texPath>Things/Building/Power/SolarCollector</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
      <color>(170,140,95)</color>
    </graphicData>
    <size>(3,3)</size>
    <designationCategory Inherit="False" IsNull="True" />
    <minifiedDef Inherit="False" IsNull="True" />
    <thingCategories Inherit="False" IsNull="True" />
    <statBases>
      <MaxHitPoints>400</MaxHitPoints>
      <Mass>80</Mass>
      <Flammability>0</Flammability>
      <Beauty>3</Beauty>
    </statBases>
    <building>
      <claimable>false</claimable>
    </building>
    <comps>
      <li Class="RimMandrake.SolarMirrors.RM_CompProperties_Mirror">
        <reflectivity>0.75</reflectivity>
        <spotSize>3</spotSize>
        <maxRange>40</maxRange>
        <ancient>true</ancient>
        <reAimTicks>900</reAimTicks>
        <repairTicks>1500</repairTicks>
      </li>
    </comps>
  </ThingDef>

  <!-- §3.4 "detents are visible ground objects": an old brass target pin. Not an edifice, never blocks. -->
  <ThingDef ParentName="BuildingBase">
    <defName>RM_MirrorDetent</defName>
    <label>brass target pin</label>
    <description>An old brass pin set into the ground. An ancient heliostat nearby can be turned to throw its light exactly here.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Joy/HorseshoesPin</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.4,0.4)</drawSize>
      <color>(190,150,70)</color>
    </graphicData>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <fillPercent>0</fillPercent>
    <staticSunShadowHeight>0</staticSunShadowHeight>
    <castEdgeShadows>false</castEdgeShadows>
    <useHitPoints>false</useHitPoints>
    <selectable>true</selectable>
    <rotatable>false</rotatable>
    <clearBuildingArea>false</clearBuildingArea>
    <building>
      <isEdifice>false</isEdifice>
      <claimable>false</claimable>
      <isInert>true</isInert>
    </building>
  </ThingDef>

  <!-- §3.4 the sealed vault: its walls and its seal. The seal opens (is gone, latched) when every sun-stone is lit. -->
  <ThingDef ParentName="BuildingBase">
    <defName>RM_SunVaultWall</defName>
    <label>sun vault wall</label>
    <description>Ancient masonry carved with sun-wheels, built to keep a vault shut until light is brought to its stones.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>Things/Building/Linked/Wall</texPath>
      <graphicClass>Graphic_Appearances</graphicClass>
      <linkType>CornerFiller</linkType>
      <linkFlags>
        <li>Wall</li>
        <li>Rock</li>
      </linkFlags>
    </graphicData>
    <uiIconPath>Things/Building/Linked/WallSmooth_MenuIcon</uiIconPath>
    <stuffCategories>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>5</costStuffCount>
    <statBases>
      <MaxHitPoints>3000</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <blockWind>true</blockWind>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>1</fillPercent>
    <coversFloor>true</coversFloor>
    <holdsRoof>true</holdsRoof>
    <blockLight>true</blockLight>
    <staticSunShadowHeight>0.3</staticSunShadowHeight>
    <rotatable>false</rotatable>
    <neverMultiSelect>true</neverMultiSelect>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <building>
      <isWall>true</isWall>
      <isInert>true</isInert>
      <claimable>false</claimable>
    </building>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>RM_SunVaultSeal</defName>
    <label>sun vault seal</label>
    <description>A stone slab carved with a sun, sealing an ancient vault. It gives way when every sun-stone before it is lit by mirror light. Its inspect pane tells how many are lit, and, the longer the colony works at the mirrors, more about what is missing.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Furniture/Column</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <color>(200,170,110)</color>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>1</fillPercent>
    <holdsRoof>true</holdsRoof>
    <blockLight>true</blockLight>
    <blockWind>true</blockWind>
    <staticSunShadowHeight>0.3</staticSunShadowHeight>
    <rotatable>false</rotatable>
    <statBases>
      <MaxHitPoints>6000</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <building>
      <isInert>true</isInert>
      <claimable>false</claimable>
    </building>
    <comps>
      <li>
        <compClass>RimMandrake.SolarMirrors.RM_CompSunVaultSeal</compClass>
      </li>
    </comps>
  </ThingDef>

  <!-- §5 E2 mirror greenhouse: a glazed wall a beam passes through, and past which a roof no longer stops it, so
       mirror light reaches (glow) and warms (room heat) a roofed room. PROVISIONAL: a glazed wall, not a glass roof. -->
  <ThingDef ParentName="Wall">
    <defName>RM_GlazedAperture</defName>
    <label>glazed aperture</label>
    <description>A wall of thick glass panes in a metal frame. It keeps the weather out like any wall, but mirror light passes straight through it and on into the room behind, under the roof: aim a mirror through it to light and warm a greenhouse.</description>
    <graphicData>
      <color>(200,225,235)</color>
    </graphicData>
    <stuffCategories Inherit="False">
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>10</costStuffCount>
    <costList>
      <Silver>5</Silver>
    </costList>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>600</WorkToBuild>
      <Beauty>1</Beauty>
    </statBases>
    <researchPrerequisites>
      <li>Smithing</li>
    </researchPrerequisites>
    <modExtensions>
      <li Class="RimMandrake.SolarMirrors.RM_MirrorApertureExtension" />
    </modExtensions>
  </ThingDef>

</Defs>
