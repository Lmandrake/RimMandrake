<?xml version="1.0" encoding="utf-8"?>
<!--
  CHILL_FIRE_BAN_1 / CHILLFIREBAN_FIX_MODDED_OVERRIDES_BYPASS. The seabed ban is "no flame works" (no oxygen), and a
  fuelled power plant is banned when it pushes heat (RM_ChillFireBanKernel.UsesFlame). VQE The Generator's four uranium
  Genetrons push heat but burn nothing: their own description is "a reaction that occurs when uranium breaks down inside
  the core". Like RM_DecayCell and RUT_VaultHeart (CHILLFIREBAN_FIX_NONCOMBUSTION_PLANT_BANNED) they keep working down
  there. RM_SelfOxidizingExtension is the ban's one per-def opt-out ("needs no air"), read by RM_ChillFireGate.
  The chemfuel and wood Genetrons are combustion and stay banned. FindMod is load safety only.
-->
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Quests Expanded - The Generator</li>
    </mods>
    <match Class="PatchOperationAddModExtension">
      <xpath>Defs/ThingDef[defName="VQE_Genetron_UraniumPowered" or defName="VQE_Genetron_Nuclear" or defName="VQE_Genetron_Isotopic" or defName="VQE_Genetron_Atomic"]</xpath>
      <value>
        <li Class="RimMandrake.DivingInteraction.RM_SelfOxidizingExtension" />
      </value>
    </match>
  </Operation>
</Patch>
