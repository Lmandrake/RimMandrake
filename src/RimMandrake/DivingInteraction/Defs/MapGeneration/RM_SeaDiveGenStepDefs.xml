<?xml version="1.0" encoding="utf-8"?>
<!--
  SEA_DIVE_MAPS_BUILD_1 — carrier GenStepDefs for the three C# genSteps
  shared by all four RM_SeaDiveGenerator_* defs. Execution order is the
  GLOBAL GenStepDef.order, never XML list position (confirmed against
  RimMandrake.LanternDeeps's own precedent and the live vanilla GenStepDef
  order values read this session: ElevationFertility=10, Terrain=210,
  PlaceCaveExit=400, RockChunks=970, Fog=1500).

  RM_SeaFloorTerrain sits at Terrain's own order (210) since it REPLACES
  that step rather than running alongside it (the vanilla Terrain step is
  never listed in these generators at all). RM_PlaceSeaDiveExit mirrors
  vanilla's own PlaceCaveExit order (400) for the same reason it exists —
  see GenStep_PlaceSeaDiveExit.cs. RM_SeaFloorFauna runs at 900, after the
  floor is painted and before RockChunks(970)/Fog(1500).
-->
<Defs>

  <GenStepDef>
    <defName>RM_SeaFloorTerrain</defName>
    <order>210</order>
    <genStep Class="RimMandrake.DivingInteraction.GenStep_SeaFloorTerrain" />
  </GenStepDef>

  <GenStepDef>
    <defName>RM_PlaceSeaDiveExit</defName>
    <order>400</order>
    <genStep Class="RimMandrake.DivingInteraction.GenStep_PlaceSeaDiveExit" />
  </GenStepDef>

  <GenStepDef>
    <defName>RM_SeaFloorFauna</defName>
    <order>900</order>
    <genStep Class="RimMandrake.DivingInteraction.GenStep_SeaFloorFauna" />
  </GenStepDef>

  <!-- CHILL_RIME_TERRACES_1, 2026-09-28. order 920: after RM_SeaFloorFauna
       (900, so live RM_Krellik pawns exist to seed districts from) and
       before RockChunks(970)/Fog(1500). Listed only on
       RM_SeaDiveGenerator_TheChill and refuses any other map itself — see
       GenStep_ChillRimeTerraces.cs's own header. -->
  <GenStepDef>
    <defName>RM_ChillRimeTerraces</defName>
    <order>920</order>
    <genStep Class="RimMandrake.DivingInteraction.GenStep_ChillRimeTerraces" />
  </GenStepDef>

  <!-- SCALD_FLOOR_VENT_FIELDS_1. order 870: after terrain/exit, before RM_SeaFloorFauna (900)
       and Plants. Listed only on RM_SeaDiveGenerator_TheScald; the step also refuses any map
       that is not a Scald floor. -->
  <GenStepDef>
    <defName>RM_ScaldVentField</defName>
    <order>870</order>
    <genStep Class="RimMandrake.DivingInteraction.GenStep_ScaldVentField" />
  </GenStepDef>

  <!-- SCALD_RETURN_GALLERY_1: the Return Gallery coolant ruin. Scald floor only (the step refuses other maps). -->
  <GenStepDef>
    <defName>RM_ScaldReturnGallery</defName>
    <order>875</order>
    <genStep Class="RimMandrake.DivingInteraction.GenStep_ScaldReturnGallery" />
  </GenStepDef>

  <!-- GREYSEA_FLOOR_FORMATIONS_1 etc., 2026-09-26. The Grey Sea floor's
       terrain dressing: the deepest-pool basin and its jacket ring, the
       Brine Elder that rises from it, a seep apron around every salt
       chimney, and a brine channel running from each chimney downhill into
       the basin. Read GenStep_GreySeaFloorDressing.cs's own header — it
       explains why a Grey-specific step lives in this shared mod, and what
       is deliberately NOT built by it.

       order 880: after the formation scatter (860-876, so the chimneys it
       reads are already placed) and BEFORE the vanilla Plants step (900),
       because the terrain it paints is what gates the chimney vine and the
       glass veil kelp — paint first, and vanilla grows them for free.

       ⛔ Listed only on RM_SeaDiveGenerator_GreySea, and the step refuses
       any map whose biome is not RM_GreySea. The floor terrain tag is
       shared by all four seas, so scope cannot come from the terrain. -->
  <!-- GREYSEA_FLOOR_WALKABLE_CHECK_1 (DI-6): the last pass, after the wreck field (965) and before the fauna, removing
       scatter pieces that wall the Elder or a wreck off from the landing zone. Grey Sea floor only. -->
  <GenStepDef>
    <defName>RM_GreySeaWalkCheck</defName>
    <order>966</order>
    <genStep Class="RimMandrake.DivingInteraction.GenStep_GreySeaWalkCheck" />
  </GenStepDef>

  <GenStepDef>
    <defName>RM_GreySeaFloorDressing</defName>
    <order>880</order>
    <genStep Class="RimMandrake.DivingInteraction.GenStep_GreySeaFloorDressing" />
  </GenStepDef>

  <!-- design/RimMandrake/sea_dive_maps_spec.md §2.2 (MEASURED): a sea's own
       animalDensity (0.1-0.15) is a coastal/GravTide number, far too low
       for a ~50x50 pocket map's ecosystem-weight budget — vanilla's own
       ongoing WildAnimalSpawnerTick (runs on every map, pocket or not)
       would compute a near-zero desired population without this. Boosting
       it here, rather than editing each sea's own animalDensity, keeps the
       surface number untouched (not this mechanism's to change) while
       letting the vanilla Animals GenStep and ongoing tick meaningfully
       repopulate the floor over time, on top of GenStep_SeaFloorFauna's
       guaranteed one-time seed. -->
  <TileMutatorDef>
    <defName>RM_SeaFloorHabitat</defName>
    <label>sea floor habitat</label>
    <animalDensityFactor>30</animalDensityFactor>
  </TileMutatorDef>

</Defs>
