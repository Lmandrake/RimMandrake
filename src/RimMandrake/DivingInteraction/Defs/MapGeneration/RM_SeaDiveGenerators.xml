<?xml version="1.0" encoding="utf-8"?>
<!--
  SEA_DIVE_MAPS_BUILD_1 — one pocket-map generator per terminal sea, each
  naming that sea's own BiomeDef (mandrake.rm.terminalbiomes,
  TERMINALBIOMES_RM_MOD_BUILD_1) so its wildAnimals cast is the cast this
  generator's own map carries — GenStep_SeaFloorFauna reads it straight off
  map.Biome, no per-sea C# needed.

  Pattern: src/RimMandrake/LanternDeeps/Defs/MapGeneration/
  RM_LanternDeepGenerator.xml. RM_SeaFloorTerrain replaces the vanilla
  Terrain step (see GenStep_SeaFloorTerrain.cs); RM_PlaceSeaDiveExit and
  RM_SeaFloorFauna are this item's other two GenSteps
  (RM_SeaDiveGenStepDefs.xml). RockChunks/Fog/ElevationFertility are
  vanilla-shipped and unmodified.

  Temperatures are a placeholder read of each sea's own description (the
  Scald boils, the Propane Lake is "cold here is total") — the real heat/
  cold GEAR GATE (two-axis matrix: no-air x temperature, this item's
  ledger) is follow-on content, not this mechanism.
-->
<Defs>

  <MapGeneratorDef MayRequire="mandrake.rm.terminalbiomes">
    <defName>RM_SeaDiveGenerator_TheScald</defName>
    <label>the Scald floor</label>
    <disableCallAid>true</disableCallAid>
    <isUnderground>true</isUnderground>
    <pocketMapProperties>
      <!-- Defaults to TRUE. Game.cs destroys every pocket map whose sourceMap is an
           abandoned map, and a gravship takeoff from an unanchored tile calls
           GravshipUtility.AbandonMap - so with the default the sea floor is destroyed
           AT TAKEOFF, before the ship lands. MEASURED from the decompiled engine
           2026-09-26 (PocketMapProperties.cs, Game.cs, WorldComponent_GravshipController).
           SEADIVEHATCH_CACHES_FIRST_SEA_FLOOR_1. -->
      <destroyOnParentMapAbandoned>false</destroyOnParentMapAbandoned>
      <biome>RM_TheScald</biome>
      <temperature>55</temperature>
      <canBeCleaned>true</canBeCleaned>
      <tileMutators>
        <li>RM_SeaFloorHabitat</li>
      </tileMutators>
    </pocketMapProperties>
    <genSteps>
      <li>ElevationFertility</li>
      <li>RM_SeaFloorTerrain</li>
      <li>RM_PlaceSeaDiveExit</li>
      <li>RM_SeaFloorFauna</li>
      <li>Animals</li>
      <li>RockChunks</li>
      <li>Fog</li>
    </genSteps>
  </MapGeneratorDef>

  <MapGeneratorDef MayRequire="mandrake.rm.terminalbiomes">
    <defName>RM_SeaDiveGenerator_GreySea</defName>
    <label>the Grey Sea floor</label>
    <disableCallAid>true</disableCallAid>
    <isUnderground>true</isUnderground>
    <pocketMapProperties>
      <!-- Defaults to TRUE. Game.cs destroys every pocket map whose sourceMap is an
           abandoned map, and a gravship takeoff from an unanchored tile calls
           GravshipUtility.AbandonMap - so with the default the sea floor is destroyed
           AT TAKEOFF, before the ship lands. MEASURED from the decompiled engine
           2026-09-26 (PocketMapProperties.cs, Game.cs, WorldComponent_GravshipController).
           SEADIVEHATCH_CACHES_FIRST_SEA_FLOOR_1. -->
      <destroyOnParentMapAbandoned>false</destroyOnParentMapAbandoned>
      <biome>RM_GreySea</biome>
      <temperature>12</temperature>
      <canBeCleaned>true</canBeCleaned>
      <tileMutators>
        <li>RM_SeaFloorHabitat</li>
      </tileMutators>
    </pocketMapProperties>
    <!-- GREYSEA_FLOOR_FORMATIONS_1 / _CRYSTAL_FLORA_1, 2026-09-26.
         🔑 The eight RM_GreySeaScatter* steps and the vanilla Plants step
         are listed HERE and on no other generator ON PURPOSE. The tag
         RM_SeaFloorGround is shared by all four sea floors, so a
         tag-scoped global registration (the shape RUT_ScaldWreckScatter
         uses) would grow salt pillars on the Scald and the Propane Lake.
         The generator list is the only scope that is actually the Grey.
         Steps and their defs: mandrake.rm.terminalbiomes,
         Defs/MapGeneration/RM_GreySeaFloorScatter.xml.
         Execution order is the GLOBAL GenStepDef.order, never this list's
         position: formations 860-876, then Plants 900. -->
    <genSteps>
      <li>ElevationFertility</li>
      <li>RM_SeaFloorTerrain</li>
      <li>RM_PlaceSeaDiveExit</li>
      <li>RM_GreySeaScatterPillars</li>
      <li>RM_GreySeaScatterDomes</li>
      <li>RM_GreySeaScatterChimneys</li>
      <li>RM_GreySeaScatterStatuary</li>
      <li>RM_GreySeaScatterCrystalWhite</li>
      <li>RM_GreySeaScatterCrystalPink</li>
      <li>RM_GreySeaScatterCrystalAmber</li>
      <li>RM_GreySeaScatterCrystalViolet</li>
      <li>RM_GreySeaFloorDressing</li>
      <li>RM_SeaFloorFauna</li>
      <li>Animals</li>
      <li>Plants</li>
      <li>RockChunks</li>
      <li>Fog</li>
    </genSteps>
  </MapGeneratorDef>

