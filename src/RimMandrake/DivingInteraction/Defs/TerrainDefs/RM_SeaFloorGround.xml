<?xml version="1.0" encoding="utf-8"?>
<!--
  SEA_DIVE_MAPS_BUILD_1 — the one Standable seafloor terrain shared by the
  Scald/Grey Sea/Twilight Sea pocket maps (RM-tier, franchise-free, never
  named a biome). The Chill split off onto its own RM_ChillIceBedrock +
  RM_ChillRimeTerrace (CHILL_RIME_TERRACES_1, 2026-09-28,
  RM_ChillFloorTerrainDefs.xml) — see GenStep_SeaFloorTerrain.cs's own
  header for the per-sea branch.

  Why one shared terrain and not four: a vanilla sea BiomeDef's own
  terrainsByFertility paints a single Impassable deep-water terrain across
  the whole map (correct for the SURFACE tile, wrong for a floor a
  weighted-belt diver is meant to walk — see GenStep_SeaFloorTerrain.cs).
  Per-sea floor dressing (Scald chimney-field silt, Chill frozen
  crust, etc.) is follow-on content, not this mechanism.

  PLACEHOLDER ART: reusing vanilla's own Sand texture (Terrain/Surfaces/Sand)
  as sediment — same posture as LanternDeepEmergence reusing CaveEntranceA.
  Real seafloor-silt art is owed alongside the per-sea dressing pass.
-->
<Defs>

  <TerrainDef ParentName="NaturalTerrainBase">
    <defName>RM_SeaFloorGround</defName>
    <label>sea floor sediment</label>
    <description>Fine sediment settled on the bottom, compacted enough under a weighted belt to walk on. Above, the whole weight of the sea.</description>
    <texturePath>Terrain/Surfaces/Sand</texturePath>
    <isPaintable>false</isPaintable>
    <edgeType>FadeRough</edgeType>
    <renderPrecedence>350</renderPrecedence>
    <pathCost>6</pathCost>
    <statBases>
      <Beauty>-2</Beauty>
      <BeautyOutdoors>-2</BeautyOutdoors>
      <Cleanliness>-1</Cleanliness>
    </statBases>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
    </affordances>
    <fertility>0</fertility>
    <takeFootprints>true</takeFootprints>
    <tags>
      <li>RM_SeaFloorGround</li>
    </tags>
  </TerrainDef>

</Defs>
