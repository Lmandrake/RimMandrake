<?xml version="1.0" encoding="utf-8" ?>
<!--
  SEABED_PER_SEA_FLOORS_1. One floor BiomeDef per sea, replacing the generic RM_SeabedFloor for
  tiles under that sea. Mapping is data: the surface biome carries RM_SeabedAccessExtension
  floorBiome (Patches/RM_SeabedFloorBiomeWiring.xml). Densities stay 0 until Phase 3 content
  (plants/fauna on the floor map) is built and the plant guard is proven live. SEABED_FLOOR_AMBIENT_CARRYOVER_1:
  the 0 densities are only the defaults; at startup RM_SeabedFloorLife copies the sea's flora and cast
  onto its floor (animals x animalDensityFactor, 30 like the hatch mutator), and each floor holds its
  sea's hatch temperature as constantOutdoorTemperature (Scald 55, Grey 12, Twilight 8, Chill -110). Fauna does not wait:
  RM_SeaFloorFauna reads the cast off the sea above (SEABED_FLOOR_GENERATORS_1); each floor names its
  generator (RM_SeabedGenerators.xml) through RM_SeabedFloorExtension. Propane Lake is
  a RUT_ Utinni biome and is not wired here (blocked, see item).
-->
<Defs>

  <BiomeDef ParentName="RM_SeabedBiomeBase">
    <defName>RM_SeabedFloor_TheScald</defName>
    <label>the Scald floor</label>
    <description>The floor beneath the Scald: scalding vents and boiling mats under the water. Not yet surveyed in detail.</description>
    <texture>World/Biomes/Ocean</texture>
    <animalDensity>0</animalDensity>
    <plantDensity>0</plantDensity>
    <maxFishPopulation>0</maxFishPopulation>
    <constantOutdoorTemperature>55</constantOutdoorTemperature>
    <modExtensions>
      <li Class="RimMandrake.DivingInteraction.RM_SeabedFloorExtension">
        <generator>RM_SeabedGenerator_TheScald</generator>
      </li>
    </modExtensions>
  </BiomeDef>

  <BiomeDef ParentName="RM_SeabedBiomeBase">
    <defName>RM_SeabedFloor_GreySea</defName>
    <label>Grey Sea floor</label>
    <description>The floor beneath Grey Sea: a salt-white floor of pillars and brine pools. Not yet surveyed in detail.</description>
    <texture>World/Biomes/Ocean</texture>
    <animalDensity>0</animalDensity>
    <plantDensity>0</plantDensity>
    <maxFishPopulation>0</maxFishPopulation>
    <constantOutdoorTemperature>12</constantOutdoorTemperature>
    <modExtensions>
      <li Class="RimMandrake.DivingInteraction.RM_SeabedFloorExtension">
        <generator>RM_SeabedGenerator_GreySea</generator>
      </li>
    </modExtensions>
  </BiomeDef>

  <BiomeDef ParentName="RM_SeabedBiomeBase">
    <defName>RM_SeabedFloor_TwilightSea</defName>
    <label>Twilight Sea floor</label>
    <description>The floor beneath Twilight Sea: a dim floor lit by what lives on it. Not yet surveyed in detail.</description>
    <texture>World/Biomes/Ocean</texture>
    <animalDensity>0</animalDensity>
    <plantDensity>0</plantDensity>
    <maxFishPopulation>0</maxFishPopulation>
    <constantOutdoorTemperature>8</constantOutdoorTemperature>
    <modExtensions>
      <li Class="RimMandrake.DivingInteraction.RM_SeabedFloorExtension">
        <generator>RM_SeabedGenerator_TwilightSea</generator>
      </li>
    </modExtensions>
  </BiomeDef>

  <BiomeDef ParentName="RM_SeabedBiomeBase">
    <defName>RM_SeabedFloor_TheChill</defName>
    <label>Chill floor</label>
    <description>The floor beneath Chill: the cold garden at the bottom of the crater lake. Not yet surveyed in detail.</description>
    <texture>World/Biomes/Ocean</texture>
    <animalDensity>0</animalDensity>
    <plantDensity>0</plantDensity>
    <maxFishPopulation>0</maxFishPopulation>
    <constantOutdoorTemperature>-110</constantOutdoorTemperature>
    <modExtensions>
      <li Class="RimMandrake.DivingInteraction.RM_SeabedFloorExtension">
        <generator>RM_SeabedGenerator_TheChill</generator>
      </li>
    </modExtensions>
  </BiomeDef>

</Defs>
