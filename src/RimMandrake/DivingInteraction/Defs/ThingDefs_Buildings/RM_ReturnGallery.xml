<?xml version="1.0" encoding="utf-8"?>
<!--
  SCALD_RETURN_GALLERY_1 — the Return Gallery: a half-buried Rust Cathedral coolant manifold on the
  Scald floor. Generated by GenStep_ScaldReturnGallery; state and puzzle logic in RM_ReturnGallery.cs.
  PLACEHOLDER ART (vanilla textures, tinted). Nothing here is buildable or claimable.
-->
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>RM_ReturnGalleryHub</defName>
    <label>coolant manifold</label>
    <description>A broken annular manifold, half sunk in the crater floor. Five pipe runs leave it, each ending in a capped service outlet with a gauge port. This is the Rust Cathedral's old return gallery: the place its coolant came back from the Scald. Some runs are dead. At least one still pulls warm water home.</description>
    <size>(3,3)</size>
    <rotatable>false</rotatable>
    <useHitPoints>false</useHitPoints>
    <category>Building</category>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/Misc/CaveEntranceA</texPath>
      <drawSize>(3,3)</drawSize>
      <color>(120,110,100)</color>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>0.5</fillPercent>
    <building>
      <claimable>false</claimable>
      <deconstructible>false</deconstructible>
      <isInert>true</isInert>
    </building>
    <comps>
      <li Class="RimMandrake.DivingInteraction.CompProperties_GalleryHub" />
    </comps>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>RM_GalleryOutlet</defName>
    <label>coolant outlet</label>
    <description>The capped end of a coolant run, with a gauge port. A colonist can hook a gauge to it and read what the run is doing: its pressure along its length, the water's temperature, and which way it flows.</description>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <useHitPoints>false</useHitPoints>
    <category>Building</category>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/Misc/CaveEntranceA</texPath>
      <drawSize>(1,1)</drawSize>
      <color>(150,120,90)</color>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>0.4</fillPercent>
    <building>
      <claimable>false</claimable>
      <deconstructible>false</deconstructible>
      <isInert>true</isInert>
    </building>
    <comps>
      <li Class="RimMandrake.DivingInteraction.CompProperties_GalleryOutlet" />
    </comps>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>RM_GalleryPipe</defName>
    <label>coolant pipe</label>
    <description>A run of corroded coolant pipe lying along the floor, sound enough to follow.</description>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <useHitPoints>false</useHitPoints>
    <selectable>false</selectable>
    <category>Building</category>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/Misc/CaveEntranceA</texPath>
      <drawSize>(1,1)</drawSize>
      <color>(110,100,95)</color>
    </graphicData>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>Standable</passability>
    <fillPercent>0</fillPercent>
    <building>
      <claimable>false</claimable>
      <deconstructible>false</deconstructible>
      <isEdifice>false</isEdifice>
      <isInert>true</isInert>
    </building>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>RM_GalleryBreak</defName>
    <label>burst coolant pipe</label>
    <description>A pipe segment split open along its length. Whatever this run carried stopped here.</description>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <useHitPoints>false</useHitPoints>
    <category>Building</category>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/Misc/CaveEntranceA</texPath>
      <drawSize>(1,1)</drawSize>
      <color>(170,90,60)</color>
    </graphicData>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>Standable</passability>
    <fillPercent>0</fillPercent>
    <building>
      <claimable>false</claimable>
      <deconstructible>false</deconstructible>
      <isEdifice>false</isEdifice>
      <isInert>true</isInert>
    </building>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>RM_ReturnGalleryLocker</defName>
    <label>service locker</label>
    <description>A sealed engineer's locker set into the manifold's housing. Its latch is driven by the return circuit: it will only release once the live return has been identified.</description>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <useHitPoints>false</useHitPoints>
    <category>Building</category>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/Misc/CaveEntranceA</texPath>
      <drawSize>(1,1)</drawSize>
      <color>(90,110,120)</color>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>0.5</fillPercent>
    <building>
      <claimable>false</claimable>
      <deconstructible>false</deconstructible>
      <isInert>true</isInert>
    </building>
  </ThingDef>

</Defs>
