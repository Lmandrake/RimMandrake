<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SEA_DIVE_MAPS_BUILD_1 (was SCALD_DIVING_MOD_1 — the shore "dive to hunt/
    commune" mechanic is retired per the SHIP-ONLY ACCESS ruling, 2026-09-26;
    see RM_DivingSettings.cs and RM_SeaDiveHatch.cs headers). Same recipe as
    src/RimMandrake/CreatureBehaviors/Source/RM_CreatureBehaviors.csproj —
    copy that header if this one goes stale.

    Build (the dotnet is WINDOWS-NATIVE and cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\Rimworld\src\RimMandrake\DivingInteraction\Source\RM_DivingInteraction.csproj -c Release

    Output lands in ../Assemblies/, which is where RimWorld looks.

    CHILL_FIRE_BAN_1 added the first Harmony this assembly has ever needed
    (Patch_ChillFireBan.cs) — every other class here is still a plain
    ModSettings/Mod, a MapPortal/PlaceWorker/GenStep/MapComponent subclass
    wired by defName from XML (thingClass, placeWorkers, genStep Class=)
    or auto-instantiated by the engine, no patch needed. 0Harmony is
    <Private>false</Private>: the game and brrainz.harmony supply it at
    runtime, it must never be copied into ..\Assemblies\. Same
    HarmonyDll condition shape as
    src/RimUtinni/PropaneLakeMechanics/Source/RimMandrake.Utinni.PropaneLakeMechanics.csproj.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrake.DivingInteraction</AssemblyName>
    <RootNamespace>RimMandrake.DivingInteraction</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HarmonyDll)' == ''">
    <HarmonyDll>C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\2009463077\Current\Assemblies\0Harmony.dll</HarmonyDll>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="RM_DivingSettings.cs" />
    <Compile Include="RM_SeaDiveHatch.cs" />
    <Compile Include="PlaceWorker_NeedsGravEngine.cs" />
    <Compile Include="GenStep_SeaFloorTerrain.cs" />
    <Compile Include="RM_SeaFloorBandsExtension.cs" />
    <Compile Include="GenStep_SeaFloorFauna.cs" />
    <Compile Include="GenStep_PlaceSeaDiveExit.cs" />
    <Compile Include="GenStep_GreySeaFloorDressing.cs" />
    <Compile Include="RM_BrineEncasement.cs" />
    <Compile Include="BrineEncasementUtility.cs" />
    <Compile Include="MapComponent_BrineCrystallisation.cs" />
    <Compile Include="RM_SeabedLayer.cs" />
    <Compile Include="Patch_SeabedPlantGrowthGuard.cs" />
    <Compile Include="RM_Building_BrineElder.cs" />
    <Compile Include="RM_GameComponent_BrineElders.cs" />
    <Compile Include="RM_ElderTradeUtility.cs" />
    <Compile Include="Dialog_OfferToElder.cs" />
    <Compile Include="RM_CompPoolSentinelSquirt.cs" />
    <Compile Include="RM_ChillFireGate.cs" />
    <Compile Include="RM_MapComponent_ChillOxygenation.cs" />
    <Compile Include="Patch_ChillFireBan.cs" />
    <Compile Include="RM_MapComponent_ChillBoilShroud.cs" />
    <Compile Include="RM_CompHeatedSuitBattery.cs" />
    <Compile Include="RM_StatPart_HeatedSuitCharge.cs" />
    <Compile Include="RM_MapComponent_ChillGardenDefense.cs" />
    <Compile Include="RM_CompTarnnRoused.cs" />
    <Compile Include="Patch_ChillGardenDefense.cs" />
    <Compile Include="RM_MapComponent_ChillFootprints.cs" />
    <Compile Include="GenStep_ChillRimeTerraces.cs" />
    <Compile Include="RM_MapComponent_ChillDrownedAurora.cs" />
    <Compile Include="Patch_ChillDrownedAurora.cs" />
    <Compile Include="RM_MapComponent_ChillAuroraSurge.cs" />
    <Compile Include="RM_CompPowerPlantAuroraSurge.cs" />
    <Compile Include="Patch_RealFoWStaleHearing.cs" />
    <Compile Include="RM_MapComponent_ScaldImmersionBerth.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- GREYSEA_BRINE_ELDERS_1: Dialog_OfferToElder is the first UI class
         in this assembly (GUI.color, TextAnchor) — the two IMGUI modules
         below were never needed before it. -->
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
