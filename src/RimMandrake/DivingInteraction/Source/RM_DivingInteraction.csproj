<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SCALD_DIVING_MOD_1. Same recipe as
    src/RimMandrake/CreatureBehaviors/Source/RM_CreatureBehaviors.csproj —
    copy that header if this one goes stale.

    Build (the dotnet is WINDOWS-NATIVE and cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\Rimworld\src\RimMandrake\DivingInteraction\Source\RM_DivingInteraction.csproj -c Release

    Output lands in ../Assemblies/, which is where RimWorld looks.

    No Harmony: RM_FloatMenuOptionProvider_Dive is auto-discovered by
    FloatMenuMakerMap.Init() (AllSubclassesNonAbstract reflection, verified
    this session against Source/RimWorld/FloatMenuMakerMap.cs) — every other
    class is a plain JobDriver/MapComponent/ModSettings/Thought_Memory.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrake.DivingInteraction</AssemblyName>
    <RootNamespace>RimMandrake.DivingInteraction</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="RM_DivingSettings.cs" />
    <Compile Include="RM_DiveUtility.cs" />
    <Compile Include="RM_DivingDefOf.cs" />
    <Compile Include="RM_MapComponent_DiveSites.cs" />
    <Compile Include="RM_Thought_CommunedWithDeep.cs" />
    <Compile Include="RM_JobDriver_DiveBase.cs" />
    <Compile Include="RM_JobDriver_DiveHunt.cs" />
    <Compile Include="RM_JobDriver_DiveCommune.cs" />
    <Compile Include="RM_FloatMenuOptionProvider_Dive.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
