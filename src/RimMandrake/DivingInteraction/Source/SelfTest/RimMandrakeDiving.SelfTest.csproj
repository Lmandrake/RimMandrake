<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DivingInteraction offline fuzz (Approach B, same shape as Bazaar/FlowWorks/GimmeSomeSlack). Plain net8.0, zero
    RimWorld/Unity references: ../RM_GardenDefenseKernel.cs and ../RM_ElderEconomyKernel.cs are the PRODUCTION files the
    mod compiles, pulled in directly. If a `using Verse;` ever lands in either, this build breaks - the guard rail working.
    Run (builds on Windows via winbuild staging, then runs the exe):
      python3 src/RimMandrake/Utils/selftest_divinginteraction_fuzz.py [fuzz knobs]
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RimMandrakeDiving.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.DivingInteraction.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\RM_GardenDefenseKernel.cs" />
    <Compile Include="..\RM_ElderEconomyKernel.cs" />
    <Compile Include="DivingFuzz.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
