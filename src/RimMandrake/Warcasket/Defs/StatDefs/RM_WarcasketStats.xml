<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_WarcasketStats.xml                  Warcasket - WARCASKET_SUIT_CLASS_1

  RM_HazardousTerrainProtection: the apparel stat RM_MapComponent_
  HazardousTerrainImmersion sums across a pawn's worn apparel via
  RimMandrake.EnvironmentalHazards.HazardTargeting.SumApparelStat, same
  shape and same reasoning as this repo's own RM_WetBulbProtection.xml
  (EnvironmentalHazards mod) - an "Apparel"-category StatDef has no
  vanilla auto-aggregation onto a pawn stat, so any consumer summing one
  across a worn outfit does it itself. ParentName="ArmorRatingBase" for
  the same reason RM_WetBulbProtection uses it (category Apparel,
  defaultBaseValue 0, minValue 0, hideAtValue 0 inherited unedited);
  maxValue capped to 1 since this is read as a 0..1 protection fraction.
-->
<Defs>

  <StatDef ParentName="ArmorRatingBase">
    <defName>RM_HazardousTerrainProtection</defName>
    <label>hazardous terrain protection</label>
    <labelForFullStatList>Hazardous terrain protection (armor stat)</labelForFullStatList>
    <description>How well this garment protects against standing in deep or hazardous water/brine terrain — sealed, buoyant or pressure-rated gear built for exactly that, not ordinary waterproofing. Ordinary clothing does nothing against it; only apparel carrying this stat helps.

Summed across every garment worn at once, then capped. This is TERRAIN survival only — it never grants access to a sea floor, which stays reachable only through a gravship.</description>
    <maxValue>1</maxValue>
    <parts>
      <li Class="StatPart_Quality">
        <factorAwful>0.6</factorAwful>
        <factorPoor>0.8</factorPoor>
        <factorNormal>1</factorNormal>
        <factorGood>1.15</factorGood>
        <factorExcellent>1.3</factorExcellent>
        <factorMasterwork>1.45</factorMasterwork>
        <factorLegendary>1.8</factorLegendary>
      </li>
    </parts>
  </StatDef>

</Defs>
