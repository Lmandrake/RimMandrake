<?xml version="1.0" encoding="utf-8"?>
<!--
  WARCASKET_CASK_BAY_AND_SARCOPHAGI_1.

  RM_HazardCasks: the cargo class the lead-lined cask bay (RM_CaskBay.xml)
  is built to hold. Any future cask item (the Stenchlands' own waste casks,
  when a biome build authors them) joins by listing this category; the bay's
  storage filter already admits it.

  RM_HalfExtractedCore: wasteland.md §7, verbatim: "a dead Junker in an
  adjusted warcasket is a sealed salvage-within-salvage: suit, tools, and
  the half-extracted core still in its grips." §8: Junkers extract "usable
  nuclear (or worse) fuel in specially adjusted warcaskets". Salvaged only
  by cracking open a sarcophagus (RM_Sarcophagus.cs) - no recipe makes one.
  A loose core doses through vanilla ToxicUtility (dose-layer ruling
  2026-09-28: "mostly pollution mechanism"); in a shielded cask bay it is
  silent (RM_CaskBay.cs).

  ART: none generated (artpipe done/, _artsrc/, registry.jsonl searched
  2026-09-29). texPath below is this mod's own path, BLOCKED until a render
  lands there.
-->
<Defs>

  <ThingCategoryDef>
    <defName>RM_HazardCasks</defName>
    <label>hazard casks</label>
    <parent>Items</parent>
  </ThingCategoryDef>

  <ThingDef ParentName="ResourceBase">
    <defName>RM_HalfExtractedCore</defName>
    <label>half-extracted core</label>
    <description>A reactor fuel core, cut half-free of whatever ruin it powered and never finished. Clamp scars ring its casing where a Junker's extraction rig bit in, and the seals the rig was meant to close are still open. It is valuable fuel to anyone mad enough to run it, and it gives off a slow poison to everyone standing near it until it is locked away in a lead-lined cask bay.</description>
    <graphicData>
      <texPath>Things/Item/Resource/RM_HalfExtractedCore/RM_HalfExtractedCore</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>1</stackLimit>
    <tickerType>Rare</tickerType>
    <useHitPoints>true</useHitPoints>
    <healthAffectsPrice>true</healthAffectsPrice>
    <tradeability>Sellable</tradeability>
    <techLevel>Industrial</techLevel>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <MarketValue>650</MarketValue>
      <Mass>25</Mass>
      <Flammability>0</Flammability>
      <Beauty>-30</Beauty>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>RM_HazardCasks</li>
    </thingCategories>
    <comps>
      <li Class="RimMandrake.Warcasket.RM_CompProperties_CoreDose">
        <radius>4</radius>
        <toxicFactor>1</toxicFactor>
      </li>
    </comps>
  </ThingDef>

</Defs>
