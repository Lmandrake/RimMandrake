<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RaidRedesigner offline fuzz (Approach B). Plain net8.0, zero RimWorld/Unity references: ../Kernel/RM_RosterKernel.cs and
    ../RoleTag.cs are the PRODUCTION files the mod compiles, pulled in directly. A `using Verse;` landing in either breaks this build.
    Run: python3 src/RimMandrake/Utils/selftest_raidredesigner_fuzz.py [fuzz knobs]
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RimMandrakeRaidRedesigner.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.RaidRedesigner.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Kernel\RM_RosterKernel.cs" />
    <Compile Include="..\RoleTag.cs" />
    <Compile Include="RaidRedesignerFuzz.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
