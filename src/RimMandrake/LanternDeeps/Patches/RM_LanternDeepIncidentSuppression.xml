<?xml version="1.0" encoding="utf-8" ?>
<!-- CAVERNS_PARITY_BUILD_1 + owner ruling 2026-09-18 ("Suppress, like the
     donor"): the donor biome carried BiomesCore's DisableIncidentsExtension
     blocking these sky/weather incidents underground. That extension died
     with the donor coupling; this is the vanilla-field equivalent -
     IncidentDef.disallowedBiomes, enforced by IncidentWorker.CanFireNow
     (MEASURED: Source/RimWorld/IncidentWorker.cs:70-73 via RimSage). The
     incident list is the donor's own (BMT_CrystalCaverns.xml:91-103),
     verbatim. None of the nine vanilla defs carries allowedBiomes (checked
     2026-09-18), so the both-lists config error cannot fire; conditional
     blocks keep this composable if another mod adds the list first. -->
<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/IncidentDef[defName="Aurora"]/disallowedBiomes</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/IncidentDef[defName="Aurora"]/disallowedBiomes</xpath>
      <value><li>RM_LanternDeeps</li></value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/IncidentDef[defName="Aurora"]</xpath>
      <value><disallowedBiomes><li>RM_LanternDeeps</li></disallowedBiomes></value>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/IncidentDef[defName="ColdSnap"]/disallowedBiomes</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/IncidentDef[defName="ColdSnap"]/disallowedBiomes</xpath>
      <value><li>RM_LanternDeeps</li></value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/IncidentDef[defName="ColdSnap"]</xpath>
      <value><disallowedBiomes><li>RM_LanternDeeps</li></disallowedBiomes></value>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/IncidentDef[defName="Eclipse"]/disallowedBiomes</xpath>
