<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RimWorld 1.6 runs Unity/Mono against a .NET Framework 4.7.2 profile, so
    the mod DLL must target net472. Same shape as
    src/RimUtinni/RestrainingBolts/Source/RimMandrake.Utinni.RestrainingBolts.csproj,
    copy that file's own header if this one goes stale. GenStep_ScatterCavePortal
    itself is a plain GenStep_ScatterGroup subclass, discovered by RimWorld's own
    GenStepDef the moment the XML names it in genStep Class — no patch or
    registration call needed for it. Harmony IS referenced below, though:
    CAVERNS_PARITY_BUILD_1 added Patch_PocketMapGrowthRate.cs's
    LanternDeepsHarmony/Patch_MapPlantGrowthRateCalculator_BuildFor prefix (see
    that file's own header) to stop pocket-map FinalizeInit crashing on grazable
    flora with no valid parent tile.

    Build (dotnet is WINDOWS-NATIVE, cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\Rimworld\src\RimMandrake\LanternDeeps\Source\RM_LanternDeeps.csproj -c Release

    Output lands in ../Assemblies/, which is where RimWorld looks.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrake.LanternDeeps</AssemblyName>
    <RootNamespace>RimMandrake.LanternDeeps</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HarmonyDll)' == ''">
    <HarmonyDll>C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\2009463077\Current\Assemblies\0Harmony.dll</HarmonyDll>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="GenStep_ScatterCavePortal.cs" />
    <Compile Include="GenStep_ScatterMineshaftPortal.cs" />
    <Compile Include="GenStep_ScatterLanternstone.cs" />
    <Compile Include="GenStep_LanternstoneRock.cs" />
    <Compile Include="Patch_PocketMapGrowthRate.cs" />
    <Compile Include="GenStep_DeepFloraGate.cs" />
    <Compile Include="MapComponent_LanternDeepDarkness.cs" />
    <Compile Include="MapComponent_DeepFloraRegrowth.cs" />
    <Compile Include="DeepFloraPlanter.cs" />
    <Compile Include="LanternDeepsMod.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- DEEP_ENTRANCE_BIOMES_SETTING_1: Widgets.CheckboxLabeled/ButtonText carry
         an optional TextAnchor parameter, which lives in this module. -->
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
