<Project Sdk="Microsoft.NET.Sdk">

  <!--
    LanternDeeps offline fuzz (Approach B, same shape as DivingInteraction/Bazaar). Plain net8.0, zero RimWorld/Unity references:
    ../RM_DeepCollapseKernel.cs and ../RM_SipperLedgerKernel.cs are the PRODUCTION files the mod compiles, pulled in directly.
    If a `using Verse;` ever lands in either, this build breaks - the guard rail working.
    Run: python3 src/RimMandrake/Utils/selftest_lanterndeeps_fuzz.py [fuzz knobs]
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RimMandrakeLanternDeeps.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.LanternDeeps.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\RM_DeepCollapseKernel.cs" />
    <Compile Include="..\RM_SipperLedgerKernel.cs" />
    <Compile Include="LanternDeepsFuzz.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
