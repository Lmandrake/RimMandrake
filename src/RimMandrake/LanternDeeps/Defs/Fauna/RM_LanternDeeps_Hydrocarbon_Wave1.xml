<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_LanternDeeps_Hydrocarbon_Wave1.xml   LanternDeeps · LANTERNDEEPS_HYDROCARBON_WAVE1_BUILD_1
  The XML-first wave of the twelve ruled hydrocarbon animals (owner: "Yes all 7 and ensure
  hydrocarbon"): drifter, candler, galuush, chiller, shoal. Concepts and numbers:
  design/Jawa/worldbuilding/biomes/rosters/lantern_deeps_repopulation_proposals.md §2/§3/§9/§10/§12.
  Every one: RM_HydrocarbonBloodExtension, yellow fuel for blood (Filth_Fuel), no meat and no
  leather (premise 3, not food) - butchering yields fuel-class products. Art: artpipe RM_<Name>
  south/east/north, generated for the parent item, wired here at the art's own drawsize.
  Deviations from the proposals, on purpose: candler milk is the existing RM_ColdWax (the
  Blue Desert's cold wax, same composed mod) rather than a new RUT_ item; the galuush is placed by
  RM_GenStep_Galuush (one per Deep at most, ~half of Deeps), never by the roster. The galuush's
  hot death is a chamber-sized blast and fire, and its roof comes down through the Deep's collapse
  warnings (collapseRoofRadius, LANTERNDEEPS_AURORA_COLLAPSE_BUILD_1).
-->
<Defs>

  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Drifter</defName>
    <label>drifter</label>
    <description>A head-sized bladder of pale blue skin drifting a hand's breadth above the floor, a heavy yellow slosh settled in its lower third and a fringe of threads hanging beneath. It floats on methane and grazes the light off glow-fungi, glowing faintly itself. Killed with a blade it collapses into a harmless sac of fuel; killed by fire, a spark or a hot bullet, it goes up.</description>
    <modExtensions>
      <li Class="RimMandrake.CreatureBehaviors.RM_HydrocarbonBloodExtension" />
    </modExtensions>
    <statBases>
      <MoveSpeed>1.6</MoveSpeed>
      <Wildness>0.6</Wildness>
      <MarketValue>90</MarketValue>
      <MeatAmount>0</MeatAmount>
      <LeatherAmount>0</LeatherAmount>
      <ComfyTemperatureMin>-60</ComfyTemperatureMin>
      <ComfyTemperatureMax>30</ComfyTemperatureMax>
      <FilthRate>0</FilthRate>
    </statBases>
    <tools>
      <li>
        <label>threads</label>
        <capacities><li>Blunt</li></capacities>
        <power>2</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
      </li>
    </tools>
    <race>
      <body>BeetleLike</body>
      <baseBodySize>0.35</baseBodySize>
      <baseHealthScale>0.3</baseHealthScale>
      <foodType>VegetarianRoughAnimal</foodType>
      <bloodDef>Filth_Fuel</bloodDef>
      <canBePredatorPrey>true</canBePredatorPrey>
      <herdAnimal>true</herdAnimal>
      <manhunterOnDamageChance>0</manhunterOnDamageChance>
      <deathAction Class="RimMandrake.LanternDeeps.RM_DeathActionProperties_HotKill">
        <radius>2.9</radius>
        <damageDef>Flame</damageDef>
        <chanceToStartFire>0.5</chanceToStartFire>
          <coldInjuries>
            <li>Cut</li><li>Stab</li><li>Crush</li><li>Bruise</li><li>Bite</li><li>Scratch</li><li>Crack</li>
          </coldInjuries>
      </deathAction>
      <lifeExpectancy>12</lifeExpectancy>
      <lifeStageAges>
        <li><def>AnimalBaby</def><minAge>0</minAge></li>
        <li><def>AnimalJuvenile</def><minAge>0.2</minAge></li>
        <li><def>AnimalAdult</def><minAge>0.5</minAge></li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <butcherProducts>
      <Chemfuel>12</Chemfuel>
    </butcherProducts>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>3</glowRadius>
        <glowColor>(150,190,255,0)</glowColor>
      </li>
      <li Class="RimMandrake.LanternDeeps.RM_CompProperties_MobileGlow" />
    </comps>
  </ThingDef>

