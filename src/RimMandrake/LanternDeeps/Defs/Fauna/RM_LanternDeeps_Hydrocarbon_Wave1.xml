  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Candler</defName>
    <label>candler</label>
    <description>A slow slab of pale blue, legless, moving on a single broad foot, with a swollen dorsal sac of the brightest yellow in the Deep running down its spine. It stores its energy as wax. It can be milked for that cold wax, which burns like chemfuel and needs no refinery - and which will not stay inert anywhere warm.</description>
    <modExtensions>
      <li Class="RimMandrake.CreatureBehaviors.RM_HydrocarbonBloodExtension" />
    </modExtensions>
    <statBases>
      <MoveSpeed>1.5</MoveSpeed>
      <Wildness>0.4</Wildness>
      <MarketValue>260</MarketValue>
      <MeatAmount>0</MeatAmount>
      <LeatherAmount>0</LeatherAmount>
      <ComfyTemperatureMin>-60</ComfyTemperatureMin>
      <ComfyTemperatureMax>30</ComfyTemperatureMax>
      <FilthRate>0</FilthRate>
    </statBases>
    <tools>
      <li>
        <label>foot shove</label>
        <capacities><li>Blunt</li></capacities>
        <power>6</power>
        <cooldownTime>2.4</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
      </li>
    </tools>
    <race>
      <body>BeetleLike</body>
      <baseBodySize>1.2</baseBodySize>
      <baseHealthScale>1.2</baseHealthScale>
      <foodType>VegetarianRoughAnimal</foodType>
      <bloodDef>Filth_Fuel</bloodDef>
      <canBePredatorPrey>true</canBePredatorPrey>
      <herdAnimal>true</herdAnimal>
      <trainability>None</trainability>
      <manhunterOnDamageChance>0.05</manhunterOnDamageChance>
      <lifeExpectancy>12</lifeExpectancy>
      <lifeStageAges>
        <li><def>AnimalBaby</def><minAge>0</minAge></li>
        <li><def>AnimalJuvenile</def><minAge>0.2</minAge></li>
        <li><def>AnimalAdult</def><minAge>0.5</minAge></li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <butcherProducts>
      <RM_ColdWax>15</RM_ColdWax>
    </butcherProducts>
    <comps>
      <li Class="CompProperties_Milkable">
        <milkDef>RM_ColdWax</milkDef>
        <milkIntervalDays>2</milkIntervalDays>
        <milkAmount>12</milkAmount>
        <milkFemaleOnly>false</milkFemaleOnly>
      </li>
    </comps>
  </ThingDef>

