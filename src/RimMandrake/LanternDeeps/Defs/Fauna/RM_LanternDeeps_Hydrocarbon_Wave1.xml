  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Galuush</defName>
    <label>galuush</label>
    <description>A sun hung under the mountain: one vast bladder of skin so thin the yellow inside is the whole picture, a slow-turning core of hydrocarbon fluid brightest at its heart, crowned underneath with soft filaments that stir in no wind. It hangs in its chamber and almost never moves, lighting the whole hall blue-gold, and everything in the Deep that is drawn to light gathers beneath it. Killed cold it is a fortune in fuel. Killed hot, the chamber goes up with it.</description>
    <modExtensions>
      <li Class="RimMandrake.CreatureBehaviors.RM_HydrocarbonBloodExtension" />
    </modExtensions>
    <statBases>
      <MoveSpeed>0.05</MoveSpeed>
      <Wildness>1</Wildness>
      <MarketValue>3000</MarketValue>
      <MeatAmount>0</MeatAmount>
      <LeatherAmount>0</LeatherAmount>
      <ComfyTemperatureMin>-60</ComfyTemperatureMin>
      <ComfyTemperatureMax>30</ComfyTemperatureMax>
      <FilthRate>0</FilthRate>
    </statBases>
    <tools>
      <li>
        <label>filaments</label>
        <capacities><li>Blunt</li></capacities>
        <power>3</power>
        <cooldownTime>4</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
      </li>
    </tools>
    <race>
      <body>BeetleLike</body>
      <baseBodySize>6</baseBodySize>
      <baseHealthScale>6</baseHealthScale>
      <foodType>None</foodType>
      <bloodDef>Filth_Fuel</bloodDef>
      <canBePredatorPrey>false</canBePredatorPrey>
      <needsRest>false</needsRest>
      <disableMating>true</disableMating>
      <manhunterOnDamageChance>0</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0</manhunterOnTameFailChance>
      <trainability>None</trainability>
      <deathAction Class="RimMandrake.LanternDeeps.RM_DeathActionProperties_HotKill">
        <radius>7.9</radius>
        <damageDef>Bomb</damageDef>
        <chanceToStartFire>0.6</chanceToStartFire>
        <ignitionMessageKey>RM_GaluushIgnition</ignitionMessageKey>
        <collapseRoofRadius>4.9</collapseRoofRadius>
          <coldInjuries>
            <li>Cut</li><li>Stab</li><li>Crush</li><li>Bruise</li><li>Bite</li><li>Scratch</li><li>Crack</li>
          </coldInjuries>
      </deathAction>
      <lifeExpectancy>400</lifeExpectancy>
      <lifeStageAges>
        <li><def>AnimalAdult</def><minAge>0</minAge></li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <butcherProducts>
      <Chemfuel>150</Chemfuel>
      <RM_ColdWax>60</RM_ColdWax>
    </butcherProducts>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>14</glowRadius>
        <glowColor>(255,215,140,0)</glowColor>
      </li>
    </comps>
  </ThingDef>

