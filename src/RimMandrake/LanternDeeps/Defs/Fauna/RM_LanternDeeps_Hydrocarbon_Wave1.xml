  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Shoal</defName>
    <label>shoal</label>
    <description>Many bodies sharing one blood: small pale lozenges strung on a single glowing yellow thread, a shoal of eight to fifteen moving as one loose net. Wound one and the fluid moves between them - the hurt is spread across the net, and the net heals itself fast while it stays together. To kill one you must wound the shoal.</description>
    <modExtensions>
      <li Class="RimMandrake.CreatureBehaviors.RM_HydrocarbonBloodExtension" />
      <li Class="RimMandrake.CreatureBehaviors.RM_WoundLinkExtension">
        <tag>LanternShoal</tag>
      </li>
    </modExtensions>
    <statBases>
      <MoveSpeed>2.4</MoveSpeed>
      <Wildness>0.6</Wildness>
      <MarketValue>40</MarketValue>
      <MeatAmount>0</MeatAmount>
      <LeatherAmount>0</LeatherAmount>
      <ComfyTemperatureMin>-60</ComfyTemperatureMin>
      <ComfyTemperatureMax>30</ComfyTemperatureMax>
      <FilthRate>0</FilthRate>
    </statBases>
    <tools>
      <li>
        <label>filament</label>
        <capacities><li>Blunt</li></capacities>
        <power>1.5</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
      </li>
    </tools>
    <race>
      <body>BeetleLike</body>
      <baseBodySize>0.2</baseBodySize>
      <baseHealthScale>0.4</baseHealthScale>
      <foodType>VegetarianRoughAnimal</foodType>
      <bloodDef>Filth_Fuel</bloodDef>
      <canBePredatorPrey>true</canBePredatorPrey>
      <herdAnimal>true</herdAnimal>
      <manhunterOnDamageChance>0</manhunterOnDamageChance>
      <lifeExpectancy>4</lifeExpectancy>
      <lifeStageAges>
        <li><def>AnimalBaby</def><minAge>0</minAge></li>
        <li><def>AnimalJuvenile</def><minAge>0.2</minAge></li>
        <li><def>AnimalAdult</def><minAge>0.5</minAge></li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <butcherProducts>
      <Chemfuel>2</Chemfuel>
    </butcherProducts>
    <comps>
      <li Class="RimMandrake.CreatureBehaviors.CompProperties_WoundLink" />
      <li Class="RimMandrake.CreatureBehaviors.CompProperties_GrantHediff">
        <hediff>RM_ShoalSharedCirculation</hediff>
        <inspectLine>Shares one circulation with its shoal.</inspectLine>
      </li>
    </comps>
  </ThingDef>

