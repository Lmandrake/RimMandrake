<!--
  RM_LanternDeeps_Hydrocarbon_Wave3.xml   LanternDeeps · LANTERNDEEPS_HYDROCARBON_WAVE3_BUILD_1
  Hush, sipper, tapper, pooler: the last four of the twelve ruled hydrocarbon animals. Concepts:
  rosters/lantern_deeps_repopulation_proposals.md §1, §4, §6, §7. Same premises as waves 1-2:
  RM_HydrocarbonBloodExtension, Filth_Fuel for blood, no meat or leather, fuel-class butcher products.
  Mechanics: Source/RM_HydrocarbonWave3.cs. Art: artpipe RM_<Name>_south/east/north at the art's own
  drawsizes (hush 2.0, sipper 0.6, tapper 1.0, pooler 1.0). The hush is placed by RM_DeepHush (1-2 per
  new Deep), never rostered; sipper/tapper/pooler are roster rows in RM_LanternDeeps.
-->
<Defs>

  <!-- The hush's unseen state: vanilla invisibility (the Horaxian/Revenant machinery), undrawn and
       untargetable while present. RM_CompHush adds it on unlit ground and removes it when lit or striking. -->
  <HediffDef>
    <hediffClass>HediffWithComps</hediffClass>
    <defName>RM_HushUnseen</defName>
    <label>unseen in the dark</label>
    <description>On unlit ground this creature is a hole in the floor: nothing that looks for it can find it. Light, a wound or its own strike shows it.</description>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Invisibility">
        <visibleToPlayer>false</visibleToPlayer>
        <fadeDurationTicks>45</fadeDurationTicks>
        <recoverFromDisruptedTicks>120</recoverFromDisruptedTicks>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath" />
    </comps>
  </HediffDef>

  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Hush</defName>
    <label>hush</label>
    <description>The one thing in the Deep that does not glow: a wide flat sheet two cells across and less than a hand thick, matte black, with the faintest blue edge-light where a lamp catches its rim. At rest it lies over the fungal floor like a spill of shadow, and on unlit ground nothing can see it at all. Step within two cells and it peels up from the front edge and folds over you; the underside is a field of small pale-blue hooks. Light it and it is a plain black slab you can shoot from across the room.</description>
    <modExtensions>
      <li Class="RimMandrake.CreatureBehaviors.RM_HydrocarbonBloodExtension" />
    </modExtensions>
    <statBases>
      <MoveSpeed>2.4</MoveSpeed>
      <Wildness>1</Wildness>
      <MarketValue>250</MarketValue>
      <ArmorRating_Blunt>0.2</ArmorRating_Blunt>
      <MeatAmount>0</MeatAmount>
      <LeatherAmount>0</LeatherAmount>
      <ComfyTemperatureMin>-60</ComfyTemperatureMin>
      <ComfyTemperatureMax>30</ComfyTemperatureMax>
      <FilthRate>0</FilthRate>
    </statBases>
    <tools>
      <li>
        <label>hook field</label>
        <capacities><li>Scratch</li></capacities>
        <power>14</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
      </li>
      <li>
        <label>folding edge</label>
        <capacities><li>Blunt</li></capacities>
        <power>10</power>
        <cooldownTime>2.4</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
      </li>
    </tools>
    <race>
      <body>Snake</body>
      <baseBodySize>1.6</baseBodySize>
      <baseHealthScale>1.4</baseHealthScale>
      <foodType>CarnivoreAnimal</foodType>
      <predator>true</predator>
      <maxPreyBodySize>2</maxPreyBodySize>
      <canBePredatorPrey>false</canBePredatorPrey>
      <herdAnimal>false</herdAnimal>
      <trainability>None</trainability>
      <manhunterOnDamageChance>0.5</manhunterOnDamageChance>
      <bloodDef>Filth_Fuel</bloodDef>
      <lifeExpectancy>12</lifeExpectancy>
      <lifeStageAges>
        <li><def>AnimalBaby</def><minAge>0</minAge></li>
        <li><def>AnimalJuvenile</def><minAge>0.2</minAge></li>
        <li><def>AnimalAdult</def><minAge>0.5</minAge></li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <butcherProducts>
      <Chemfuel>25</Chemfuel>
    </butcherProducts>
    <comps>
      <li Class="RimMandrake.LanternDeeps.RM_CompProperties_Hush">
        <unseenHediff>RM_HushUnseen</unseenHediff>
        <litThreshold>0.3</litThreshold>
        <lungeRange>2</lungeRange>
      </li>
    </comps>
  </ThingDef>

