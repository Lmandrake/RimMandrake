  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Sipper</defName>
    <label>sipper</label>
    <description>A swarm vermin the size of a thumbnail: a clear bead of liquid in a pale-blue skin so thin the yellow droplet inside shows as a point of colour, on three hair-fine legs. Alone it is invisible; a swarm is a scatter of sparks. Sippers hop toward the brightest light near them and sit on it, drinking photons into pentane, and every one of them on a lamp makes it a little dimmer. They do not fight. They just come back.</description>
    <modExtensions>
      <li Class="RimMandrake.CreatureBehaviors.RM_HydrocarbonBloodExtension" />
      <li Class="RimMandrake.CreatureBehaviors.RM_VerminPressureExtension">
        <populationSoftCap>20</populationSoftCap>
        <populationHardCap>40</populationHardCap>
      </li>
    </modExtensions>
    <statBases>
      <MoveSpeed>2.6</MoveSpeed>
      <Wildness>0.9</Wildness>
      <MarketValue>3</MarketValue>
      <MeatAmount>0</MeatAmount>
      <LeatherAmount>0</LeatherAmount>
      <ComfyTemperatureMin>-60</ComfyTemperatureMin>
      <ComfyTemperatureMax>30</ComfyTemperatureMax>
      <FilthRate>0</FilthRate>
    </statBases>
    <tools>
      <li>
        <label>bead</label>
        <capacities><li>Blunt</li></capacities>
        <power>1</power>
        <cooldownTime>2.5</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
      </li>
    </tools>
    <race>
      <body>BeetleLike</body>
      <baseBodySize>0.08</baseBodySize>
      <baseHealthScale>0.15</baseHealthScale>
      <foodType>VegetarianRoughAnimal</foodType>
      <canBePredatorPrey>true</canBePredatorPrey>
      <herdAnimal>true</herdAnimal>
      <trainability>None</trainability>
      <manhunterOnDamageChance>0</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0</manhunterOnTameFailChance>
      <bloodDef>Filth_Fuel</bloodDef>
      <lifeExpectancy>12</lifeExpectancy>
      <lifeStageAges>
        <li><def>AnimalBaby</def><minAge>0</minAge></li>
        <li><def>AnimalJuvenile</def><minAge>0.2</minAge></li>
        <li><def>AnimalAdult</def><minAge>0.5</minAge></li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
