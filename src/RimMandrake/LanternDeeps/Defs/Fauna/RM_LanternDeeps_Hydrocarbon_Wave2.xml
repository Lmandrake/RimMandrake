  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Knocker</defName>
    <label>knocker</label>
    <description>A blind tripod: three long pale-blue stilt legs bending backward under a fist-sized body, and a long neck ending in a heavy translucent hammer-head of horn with the yellow fluid pooled inside it like a plumb-bob. It sees by tapping the rock, and it hears rock before it fails: at a roof about to fall it drums a fast alarm and runs. A tame one names the danger and gives you longer to prop it.</description>
    <modExtensions>
      <li Class="RimMandrake.CreatureBehaviors.RM_HydrocarbonBloodExtension" />
    </modExtensions>
    <statBases>
      <MoveSpeed>2.8</MoveSpeed>
      <Wildness>0.45</Wildness>
      <MarketValue>160</MarketValue>
      <MeatAmount>0</MeatAmount>
      <LeatherAmount>0</LeatherAmount>
      <ComfyTemperatureMin>-60</ComfyTemperatureMin>
      <ComfyTemperatureMax>30</ComfyTemperatureMax>
      <FilthRate>0</FilthRate>
    </statBases>
    <tools>
      <li>
        <label>hammer-head</label>
        <capacities><li>Blunt</li></capacities>
        <power>6</power>
        <cooldownTime>2.2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
      </li>
    </tools>
    <race>
      <body>BeetleLike</body>
      <baseBodySize>0.6</baseBodySize>
      <baseHealthScale>0.7</baseHealthScale>
      <foodType>VegetarianRoughAnimal</foodType>
      <bloodDef>Filth_Fuel</bloodDef>
      <canBePredatorPrey>true</canBePredatorPrey>
      <herdAnimal>false</herdAnimal>
      <trainability>None</trainability>
      <manhunterOnDamageChance>0.05</manhunterOnDamageChance>
      <lifeExpectancy>12</lifeExpectancy>
      <lifeStageAges>
        <li><def>AnimalBaby</def><minAge>0</minAge></li>
        <li><def>AnimalJuvenile</def><minAge>0.2</minAge></li>
        <li><def>AnimalAdult</def><minAge>0.5</minAge></li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <butcherProducts>
      <Chemfuel>8</Chemfuel>
    </butcherProducts>
    <comps>
      <li Class="RimMandrake.LanternDeeps.RM_CompProperties_Knocker">
        <hearRadius>15</hearRadius>
        <drum>Pawn_Melee_Punch_HitBuilding_Stone</drum>
      </li>
    </comps>
  </ThingDef>

