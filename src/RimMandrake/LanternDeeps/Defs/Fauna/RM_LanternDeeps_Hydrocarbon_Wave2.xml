  <ThingDef>
    <defName>RM_BlinkerFlare</defName>
    <label>blinker flash</label>
    <description>The light of a blinker's flash, gone in a breath.</description>
    <thingClass>ThingWithComps</thingClass>
    <category>Ethereal</category>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <drawerType>None</drawerType>
    <tickerType>Normal</tickerType>
    <useHitPoints>false</useHitPoints>
    <selectable>false</selectable>
    <rotatable>false</rotatable>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>20</glowRadius>
        <glowColor>(235,245,255,0)</glowColor>
      </li>
      <li Class="CompProperties_Lifespan">
        <lifespanTicks>90</lifespanTicks>
      </li>
    </comps>
  </ThingDef>

  <HediffDef>
    <defName>RM_BlinkerDazzled</defName>
    <label>dazzled</label>
    <description>Looked straight into a blinker's flash: half-blind for a few seconds.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>300</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li><capacity>Sight</capacity><offset>-0.6</offset></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

