  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Blinker</defName>
    <label>blinker</label>
    <description>A soft upright teardrop of pale translucent blue, about a metre tall, walking on two thin trailing arms like crutches. Where a face would be is a single large lens-window with the yellow interior showing through it, and a third shorter arm held over it like a hand over a torch. Hurt or cornered it flings the arm wide and flashes: everything that can see it is dazzled, and for a breath the whole chamber is lit.</description>
    <modExtensions>
      <li Class="RimMandrake.CreatureBehaviors.RM_HydrocarbonBloodExtension" />
    </modExtensions>
    <statBases>
      <MoveSpeed>3.6</MoveSpeed>
      <Wildness>0.4</Wildness>
      <MarketValue>80</MarketValue>
      <MeatAmount>0</MeatAmount>
      <LeatherAmount>0</LeatherAmount>
      <ComfyTemperatureMin>-60</ComfyTemperatureMin>
      <ComfyTemperatureMax>30</ComfyTemperatureMax>
      <FilthRate>0</FilthRate>
    </statBases>
    <tools>
      <li>
        <label>crutch arm</label>
        <capacities><li>Blunt</li></capacities>
        <power>3</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
      </li>
    </tools>
    <race>
      <body>BeetleLike</body>
      <baseBodySize>0.45</baseBodySize>
      <baseHealthScale>0.6</baseHealthScale>
      <foodType>VegetarianRoughAnimal</foodType>
      <bloodDef>Filth_Fuel</bloodDef>
      <canBePredatorPrey>true</canBePredatorPrey>
      <herdAnimal>true</herdAnimal>
      <trainability>None</trainability>
      <manhunterOnDamageChance>0</manhunterOnDamageChance>
      <lifeExpectancy>12</lifeExpectancy>
      <lifeStageAges>
        <li><def>AnimalBaby</def><minAge>0</minAge></li>
        <li><def>AnimalJuvenile</def><minAge>0.2</minAge></li>
        <li><def>AnimalAdult</def><minAge>0.5</minAge></li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <butcherProducts>
      <Chemfuel>6</Chemfuel>
    </butcherProducts>
    <comps>
      <li Class="RimMandrake.LanternDeeps.RM_CompProperties_FlashOnHurt">
        <flare>RM_BlinkerFlare</flare>
        <dazzle>RM_BlinkerDazzled</dazzle>
        <dazzleRadius>8</dazzleRadius>
        <cooldownTicks>600</cooldownTicks>
      </li>
    </comps>
  </ThingDef>

