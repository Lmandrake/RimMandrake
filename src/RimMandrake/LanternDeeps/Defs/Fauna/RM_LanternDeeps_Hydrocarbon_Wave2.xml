<!--
  RM_LanternDeeps_Hydrocarbon_Wave2.xml   LanternDeeps · LANTERNDEEPS_HYDROCARBON_WAVE2_BUILD_1
  Slick, blinker, knocker: three more of the twelve ruled hydrocarbon animals (owner: "Yes all 7
  and ensure hydrocarbon"). Concepts: rosters/lantern_deeps_repopulation_proposals.md §5, §8, §11.
  Same premises as wave 1: RM_HydrocarbonBloodExtension, Filth_Fuel for blood, no meat or leather,
  fuel-class butcher products. Mechanics: Source/RM_HydrocarbonWave2.cs. Art: artpipe
  RM_<Name>_south/east/north at the art's own drawsizes (slick 1.6, blinker 1.0, knocker 1.1).
-->
<Defs>

  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Slick</defName>
    <label>slick</label>
    <description>A long low string of glossy pale-blue bead-segments, each with a yellow drop inside, joined by clear necks, a ring of short feelers on the front bead. It has no legs; it pumps itself along in sequence and is always wet. It sweats pentane: every cell it crosses is left with a slick of fuel that does not evaporate in the cold, and that slick burns like a fuse.</description>
    <modExtensions>
      <li Class="RimMandrake.CreatureBehaviors.RM_HydrocarbonBloodExtension" />
    </modExtensions>
    <statBases>
      <MoveSpeed>2.0</MoveSpeed>
      <Wildness>0.75</Wildness>
      <MarketValue>70</MarketValue>
      <MeatAmount>0</MeatAmount>
      <LeatherAmount>0</LeatherAmount>
      <ComfyTemperatureMin>-60</ComfyTemperatureMin>
      <ComfyTemperatureMax>30</ComfyTemperatureMax>
      <FilthRate>0</FilthRate>
    </statBases>
    <tools>
      <li>
        <label>front bead</label>
        <capacities><li>Blunt</li></capacities>
        <power>3</power>
        <cooldownTime>2.2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
      </li>
    </tools>
    <race>
      <body>Snake</body>
      <baseBodySize>0.7</baseBodySize>
      <baseHealthScale>0.7</baseHealthScale>
      <foodType>VegetarianRoughAnimal</foodType>
      <bloodDef>Filth_Fuel</bloodDef>
      <canBePredatorPrey>true</canBePredatorPrey>
      <herdAnimal>false</herdAnimal>
      <trainability>None</trainability>
      <manhunterOnDamageChance>0</manhunterOnDamageChance>
      <lifeExpectancy>12</lifeExpectancy>
      <lifeStageAges>
        <li><def>AnimalBaby</def><minAge>0</minAge></li>
        <li><def>AnimalJuvenile</def><minAge>0.2</minAge></li>
        <li><def>AnimalAdult</def><minAge>0.5</minAge></li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <butcherProducts>
      <Chemfuel>10</Chemfuel>
    </butcherProducts>
    <comps>
      <li Class="RimMandrake.LanternDeeps.RM_CompProperties_TrailFilth">
        <filth>Filth_Fuel</filth>
        <chance>1</chance>
      </li>
    </comps>
  </ThingDef>

