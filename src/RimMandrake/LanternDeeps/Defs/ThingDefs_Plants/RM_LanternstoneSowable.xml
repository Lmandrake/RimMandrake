<?xml version="1.0" encoding="utf-8"?>
<!--
  CAVERNS_PARITY_BUILD_1 — the sowable lanternstone, replacing the borrowed
  BMT_Crystal_BlueSowable. It is a Plant, not a Building: the donor modelled the
  farmable crystal line as a plant so it grows, and the sheet keeps "the blue
  crystals as growing things" (the_lantern_deeps.md §0, donor inventory).

  It is the only lanternstone that does NOT explode — that is the trade the donor
  designed and the reason it is worth farming.
-->
<Defs>

  <ThingDef ParentName="PlantBaseNonEdible" Name="RM_LanternstonePlantBase" Abstract="True">
    <label>lanternstone</label>
    <description>A blue crystal from the depths of a Lantern Deep.</description>
    <thingClass>Plant</thingClass>
    <graphicData>
      <graphicClass>Graphic_Random</graphicClass>
      <shaderType>CutoutPlant</shaderType>
      <shadowData>
        <volume>(0.12, 0.08, 0.1)</volume>
        <offset>(0,0,-0.25)</offset>
      </shadowData>
    </graphicData>
    <category>Plant</category>
    <useHitPoints>True</useHitPoints>
    <tickerType>Long</tickerType>
    <neverMultiSelect>false</neverMultiSelect>
    <drawerType>MapMeshOnly</drawerType>
    <pathCostIgnoreRepeat>true</pathCostIgnoreRepeat>
    <minifiedDef IsNull="True"/>
    <altitudeLayer>Building</altitudeLayer>
    <selectable>true</selectable>
    <fillPercent>0.25</fillPercent>
    <rotatable>false</rotatable>
    <pathCost>1</pathCost>
    <blockWind>true</blockWind>
    <statBases>
      <Nutrition>0.0</Nutrition>
      <Beauty>5</Beauty>
      <BeautyOutdoors>5</BeautyOutdoors>
      <Flammability>0</Flammability>
      <MaxHitPoints>250</MaxHitPoints>
    </statBases>
    <ingestible>
      <foodType>Plant</foodType>
      <preferability>NeverForNutrition</preferability>
    </ingestible>
    <plant>
      <growDays>60</growDays>
      <dieIfNoSunlight>False</dieIfNoSunlight>
      <dieFromToxicFallout>False</dieFromToxicFallout>
      <lifespanDaysPerGrowDays>0</lifespanDaysPerGrowDays>
      <fertilityMin>0.0</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      <allowAutoCut>true</allowAutoCut>
      <warnIfMarkedForCut>false</warnIfMarkedForCut>
      <mustBeWildToSow>false</mustBeWildToSow>
      <blockAdjacentSow>false</blockAdjacentSow>
      <treeLoversCareIfChopped>false</treeLoversCareIfChopped>
      <dieIfLeafless>false</dieIfLeafless>
      <visualSizeRange>0.5~1.0</visualSizeRange>
      <topWindExposure>0.0</topWindExposure>
      <wildClusterRadius>4</wildClusterRadius>
      <wildClusterWeight>1900</wildClusterWeight>
      <wildOrder>3</wildOrder>
      <interferesWithRoof>false</interferesWithRoof>
      <pollution>Any</pollution>
      <neverBlightable>true</neverBlightable>
      <growMinGlow>0</growMinGlow>
      <growOptimalGlow>0</growOptimalGlow>
      <cavePlant>false</cavePlant>
    </plant>
  </ThingDef>

  <ThingDef ParentName="RM_LanternstonePlantBase">
    <defName>RM_Lanternstone_Sowable</defName>
    <label>fast growing lanternstone</label>
    <description>Unlike its volatile cousins this strain grows fast and does not shatter when damaged — but it will only take root in fertile ground. Cave dwellers farm it for light and for trade.</description>
    <graphicData>
      <texPath>RM_LanternDeeps/Things/Crystals/LanternstoneMedium</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <shaderType>CutoutPlant</shaderType>
    </graphicData>
    <tickerType>Long</tickerType>
    <pathCost>1</pathCost>
    <statBases>
      <MaxHitPoints>20</MaxHitPoints>
    </statBases>
    <plant>
      <immatureGraphicPath>RM_LanternDeeps/Things/Crystals/LanternstoneSowableImmature</immatureGraphicPath>
      <visualSizeRange>0.4~0.8</visualSizeRange>
      <harvestedThingDef>RM_Lanternstone</harvestedThingDef>
      <harvestYield>6</harvestYield>
      <growDays>33.3</growDays>
      <harvestTag>Standard</harvestTag>
      <fertilityMin>0.1</fertilityMin>
      <sowMinSkill>7</sowMinSkill>
    </plant>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>1.75</glowRadius>
        <glowColor>(119,189,239,0)</glowColor>
      </li>
    </comps>
  </ThingDef>

</Defs>
