<?xml version="1.0" encoding="utf-8"?>
<!--
  CAVERNS_PARITY_BUILD_1 — the four lanternstone formation sizes, replacing the
  borrowed BMT_Crystal_Blue{Small,Medium,Large,Huge} that BMT_CrystalsGenerator
  scattered. Stats, sizes, path costs, glow radii, explosive radii and refund
  costs are the donor's, so a Deep plays identically.

  The sheet keeps the donor's "surprisingly volatile" (the_lantern_deeps.md §3,
  "the shatter: death is volatile — donor lore kept"), so CompProperties_Explosive
  stays on the three smaller sizes exactly as shipped.

  🔴 The huge formation's description is load-bearing lore, not flavour: "large
  enough that a smaller crystal could break off" is the sheet's cleaving-is-birth
  reading (§3, Accretion). Do not trim it.
-->
<Defs>

  <ThingDef ParentName="BuildingBase" Name="RM_LanternstoneFormationBase" Abstract="True">
    <category>Building</category>
    <thingClass>Building</thingClass>
    <graphicData>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <thingCategories Inherit="False"/>
    <rotatable>false</rotatable>
    <fillPercent>0.35</fillPercent>
    <altitudeLayer>Building</altitudeLayer>
    <pathCostIgnoreRepeat>true</pathCostIgnoreRepeat>
    <statBases>
      <MarketValue>0</MarketValue>
      <Beauty>5</Beauty>
      <BeautyOutdoors>5</BeautyOutdoors>
      <Flammability>0</Flammability>
    </statBases>
    <building>
      <alwaysDeconstructible>true</alwaysDeconstructible>
      <deconstructible>true</deconstructible>
      <claimable>false</claimable>
      <artificialForMeditationPurposes>false</artificialForMeditationPurposes>
      <ai_neverTrashThis>true</ai_neverTrashThis>
      <ai_chillDestination>false</ai_chillDestination>
      <destroySound>BuildingDestroyed_Stone_Small</destroySound>
    </building>
    <damageMultipliers>
      <li>
        <damageDef>Bomb</damageDef>
        <multiplier>2</multiplier>
      </li>
      <li>
        <damageDef>Thump</damageDef>
        <multiplier>3</multiplier>
      </li>
    </damageMultipliers>
  </ThingDef>

  <!-- ====================================================== -->

  <ThingDef ParentName="RM_LanternstoneFormationBase">
    <defName>RM_Lanternstone_Small</defName>
    <label>small lanternstone</label>
    <description>A small blue crystal grown out of the floor of a Lantern Deep. It glows steadily, and it is surprisingly volatile.</description>
    <graphicData>
      <texPath>RM_LanternDeeps/Things/Crystals/LanternstoneSmall</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <drawSize>(1.0,1.0)</drawSize>
    </graphicData>
    <passability>PassThroughOnly</passability>
    <blockLight>false</blockLight>
    <pathCost>1</pathCost>
    <tickerType>Normal</tickerType>
    <statBases>
      <WorkToBuild>400</WorkToBuild>
      <Beauty>6</Beauty>
      <MaxHitPoints>20</MaxHitPoints>
    </statBases>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>2</glowRadius>
        <glowColor>(119,189,239,0)</glowColor>
      </li>
      <li Class="CompProperties_Explosive">
        <wickTicks>240</wickTicks>
        <explosiveRadius>1.5</explosiveRadius>
        <explosiveDamageType>Bomb</explosiveDamageType>
        <chanceNeverExplodeFromDamage>0.5</chanceNeverExplodeFromDamage>
      </li>
    </comps>
    <costList>
      <RM_Lanternstone>21</RM_Lanternstone>
    </costList>
  </ThingDef>

  <ThingDef ParentName="RM_LanternstoneFormationBase">
    <defName>RM_Lanternstone_Medium</defName>
    <label>medium lanternstone</label>
    <description>A blue crystal grown out of the floor of a Lantern Deep, tall enough to shed real light. It is surprisingly volatile.</description>
    <graphicData>
      <texPath>RM_LanternDeeps/Things/Crystals/LanternstoneMedium</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <drawSize>(3.0,3.0)</drawSize>
    </graphicData>
    <size>(2,2)</size>
    <passability>PassThroughOnly</passability>
    <blockLight>false</blockLight>
    <pathCost>5</pathCost>
    <tickerType>Normal</tickerType>
    <statBases>
      <WorkToBuild>600</WorkToBuild>
      <Beauty>9</Beauty>
      <MaxHitPoints>50</MaxHitPoints>
    </statBases>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>3</glowRadius>
        <glowColor>(119,189,239,0)</glowColor>
      </li>
      <li Class="CompProperties_Explosive">
        <wickTicks>240</wickTicks>
        <explosiveRadius>2</explosiveRadius>
        <explosiveDamageType>Bomb</explosiveDamageType>
        <chanceNeverExplodeFromDamage>0.5</chanceNeverExplodeFromDamage>
      </li>
    </comps>
    <costList>
      <RM_Lanternstone>42</RM_Lanternstone>
    </costList>
  </ThingDef>

  <ThingDef ParentName="RM_LanternstoneFormationBase">
    <defName>RM_Lanternstone_Large</defName>
    <label>large lanternstone</label>
    <description>A tall blue crystal grown out of the floor of a Lantern Deep. It lights a whole chamber, and it is surprisingly volatile.</description>
    <graphicData>
      <texPath>RM_LanternDeeps/Things/Crystals/LanternstoneLarge</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <drawSize>(5.0,5.0)</drawSize>
    </graphicData>
    <size>(3,3)</size>
    <passability>PassThroughOnly</passability>
    <blockLight>false</blockLight>
    <pathCost>22</pathCost>
    <tickerType>Normal</tickerType>
    <statBases>
      <WorkToBuild>800</WorkToBuild>
      <Beauty>12</Beauty>
      <MaxHitPoints>90</MaxHitPoints>
    </statBases>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>4</glowRadius>
        <glowColor>(119,189,239,0)</glowColor>
      </li>
      <li Class="CompProperties_Explosive">
        <wickTicks>240</wickTicks>
        <explosiveRadius>3</explosiveRadius>
        <explosiveDamageType>Bomb</explosiveDamageType>
        <chanceNeverExplodeFromDamage>0.5</chanceNeverExplodeFromDamage>
      </li>
    </comps>
    <costList>
      <RM_Lanternstone>74</RM_Lanternstone>
    </costList>
  </ThingDef>

  <ThingDef ParentName="RM_LanternstoneFormationBase">
    <defName>RM_Lanternstone_Huge</defName>
    <label>huge lanternstone</label>
    <description>A blue crystal the size of a building, grown out of the floor of a Lantern Deep. This one is large enough that a smaller crystal could break off from it. It is surprisingly volatile.</description>
    <graphicData>
      <texPath>RM_LanternDeeps/Things/Crystals/LanternstoneHuge</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <drawSize>(7.0,7.0)</drawSize>
    </graphicData>
    <size>(5,5)</size>
    <passability>Impassable</passability>
    <blockLight>false</blockLight>
    <pathCost>42</pathCost>
    <tickerType>Normal</tickerType>
    <statBases>
      <WorkToBuild>1000</WorkToBuild>
      <Beauty>15</Beauty>
      <MaxHitPoints>120</MaxHitPoints>
    </statBases>
    <building>
      <deconstructible>true</deconstructible>
      <claimable>false</claimable>
    </building>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>4</glowRadius>
        <glowColor>(119,189,239,0)</glowColor>
      </li>
      <li Class="CompProperties_Explosive">
        <wickTicks>240</wickTicks>
        <explosiveRadius>3.9</explosiveRadius>
        <explosiveDamageType>Bomb</explosiveDamageType>
        <chanceNeverExplodeFromDamage>0.5</chanceNeverExplodeFromDamage>
      </li>
    </comps>
    <costList>
      <RM_Lanternstone>340</RM_Lanternstone>
    </costList>
  </ThingDef>

</Defs>
