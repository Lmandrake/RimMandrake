<?xml version="1.0" encoding="utf-8"?>
<!--
  CAVERNS_PARITY_BUILD_1 — our own replacement for the borrowed
  BMT_CrystalsGenerator, which RM_LanternDeepGenerator.genSteps used to list.

  order=320 is the donor's own number, kept deliberately: the Deeps-only pyrinth
  (330) and kyber (335) scatters were both placed relative to it, and genStep
  execution order is the global GenStepDef.order, never XML list position (see
  RM_LanternDeepPyrinthScatter.xml's header for the full mechanism). Changing
  320 here silently reorders those two.

  The four groups, their weights, cluster radii and coverage are the donor's
  numbers unchanged, so a Deep's crystal field looks and paths the same.

  The validator is what keeps the big formations on the lanternstone shelves:
  ScattererValidator_Buildable with our RM_Lanternstone affordance, which only
  RM_LanternstoneFloor grants.
-->
<Defs>

  <GenStepDef>
    <defName>RM_LanternstoneFormations</defName>
    <order>320</order>
    <genStep Class="RimMandrake.LanternDeeps.GenStep_ScatterLanternstone">
      <allowInWaterBiome>false</allowInWaterBiome>
      <minSpacing>1</minSpacing>
      <countPer10kCellsRange>15.0~30.0</countPer10kCellsRange>
      <spotMustBeStandable>true</spotMustBeStandable>
      <allowRoofed>true</allowRoofed>
      <validators>
        <li Class="ScattererValidator_Buildable">
          <radius>1</radius>
          <affordance>RM_Lanternstone</affordance>
        </li>
      </validators>
      <groups>
        <li>
          <things>
            <RM_Lanternstone_Small>0.05</RM_Lanternstone_Small>
            <RM_Lanternstone_Large>0.0333</RM_Lanternstone_Large>
            <RM_Lanternstone_Huge>0.0233</RM_Lanternstone_Huge>
          </things>
          <indoorRuin>false</indoorRuin>
          <coveredCellsPer10Cells>1.5~3.5</coveredCellsPer10Cells>
          <clusterRectRadius>3~5</clusterRectRadius>
        </li>
        <li>
          <things>
            <RM_Lanternstone_Small>0.05</RM_Lanternstone_Small>
            <RM_Lanternstone_Large>0.0233</RM_Lanternstone_Large>
            <RM_Lanternstone_Huge>0.00433</RM_Lanternstone_Huge>
          </things>
          <indoorRuin>false</indoorRuin>
          <coveredCellsPer10Cells>1.5~3.5</coveredCellsPer10Cells>
          <clusterRectRadius>3~5</clusterRectRadius>
        </li>
        <li>
          <things>
            <RM_Lanternstone_Medium>0.05</RM_Lanternstone_Medium>
            <RM_Lanternstone_Large>0.0433</RM_Lanternstone_Large>
            <RM_Lanternstone_Huge>0.045</RM_Lanternstone_Huge>
          </things>
          <indoorRuin>false</indoorRuin>
          <coveredCellsPer10Cells>1.5~3.5</coveredCellsPer10Cells>
          <clusterRectRadius>4~5</clusterRectRadius>
        </li>
        <li>
          <things>
            <RM_Lanternstone_Medium>0.05</RM_Lanternstone_Medium>
            <RM_Lanternstone_Large>0.0433</RM_Lanternstone_Large>
            <RM_Lanternstone_Huge>0.025</RM_Lanternstone_Huge>
          </things>
          <indoorRuin>false</indoorRuin>
          <coveredCellsPer10Cells>1.5~3.5</coveredCellsPer10Cells>
          <clusterRectRadius>4~5</clusterRectRadius>
        </li>
      </groups>
    </genStep>
  </GenStepDef>

</Defs>
