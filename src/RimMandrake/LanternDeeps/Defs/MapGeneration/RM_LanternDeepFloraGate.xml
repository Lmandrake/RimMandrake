<?xml version="1.0" encoding="utf-8"?>
<!--
  CAVERNS_PARITY_BUILD_1 — carrier def for the "cave flora" Mod Settings toggle.

  order=950: after the vanilla Plants GenStep (MEASURED order 900, RimSage
  GenStepDef Plants) and before Fog. With the toggle ON — the shipped default —
  this step returns immediately and changes nothing.

  Gated by genStep-list membership like the pyrinth and kyber scatters: only
  RM_LanternDeepGenerator lists it, and the class re-checks the owned-def set
  before destroying anything.
-->
<Defs>

  <GenStepDef>
    <defName>RM_LanternDeepFloraGate</defName>
    <order>950</order>
    <genStep Class="RimMandrake.LanternDeeps.GenStep_DeepFloraGate" />
  </GenStepDef>

</Defs>
