<?xml version="1.0" encoding="utf-8"?>
<!--
  CRYSTAL_INGEST_EXECUTION_1 item 1: pyrinth's replacement Deeps-only scatter. This
  GenStepDef always exists (it is ours), but the `things` entry it scatters carries
  MayRequireAnyOf mandrake.rm.pyrinth (our absorbed copy, Wave 1) or det.epochspyrinth (the donor) === if neither is active the group resolves
  empty and this genstep is a harmless no-op, so RM_LanternDeepGenerator.genSteps can
  reference it unconditionally.

  Gated to the Deeps purely by WHERE it is referenced: this defName appears in no other
  MapGeneratorDef's genSteps list (see RM_LanternDeepGenerator.xml), so it can only ever
  fire while generating a Lantern Deep pocket map === the same "gate by list membership"
  trick RM_LanternDeepEmergence_Scatter uses, no custom biome-check C# needed here.

  order=330, not 210 (DIRTY_CODE_REVIEW_STANDING_LOOP_1 fix): MapGenerator.
  GenerateContentsIntoMap sorts ALL genSteps globally by GenStepDef.order (ties broken
  by def.index) === the XML list POSITION in RM_LanternDeepGenerator.genSteps (after
  BMT_CrystalsGenerator, before PlaceCaveExit) has no effect on execution order. The
  original order=210 tied this scatter with vanilla Terrain (also order 210) and put it
  BEFORE MutatorPostTerrain(220) and BMT_CrystalsGenerator(320) === buildings placed
  before terrain mutation finishes, and before the crystal generator this scatter is
  meant to sit alongside. 330 puts it where the list position always implied: right
  after BMT_CrystalsGenerator(320), well before PlaceCaveExit(400), matching both this
  mod's own sibling (RM_LanternDeepEmergence_Scatter, order 320) and vanilla's own
  GenStep_ScatterGroup convention (Anomaly's Fleshbulbs, order 550, on an analogous
  underground map).
-->
<Defs>

  <GenStepDef>
    <defName>RM_LanternDeepPyrinthScatter</defName>
    <order>330</order>
    <genStep Class="GenStep_ScatterGroup">
      <minSpacing>15</minSpacing>
      <!-- GenStep_Scatterer: no count/countPer10kCellsRange = zero scatters, silently. Placeholder density,
           kept modest. The Deeps pocket map is 66x66 (4356 cells): CountFromPer10kCells rounds 1~2 to
           0-1 clusters (0 below 1.15); 2~3 is exactly 1 cluster per pocket map. -->
      <countPer10kCellsRange>2~3</countPer10kCellsRange>
      <groups>
        <li>
          <things>
            <DV_MineablePyrinth MayRequireAnyOf="mandrake.rm.pyrinth,det.epochspyrinth">1</DV_MineablePyrinth>
          </things>
          <!-- SCATTER_AUDIT_DENSITY_TRUNCATES_ZERO: a cluster covers (int)(validCells/10 * this) cells.
               0~0.6 gave 0 at r2 (25 cells) for any draw under 0.4. 0.5~0.9 = 1-2 cells at r2,
               2-4 at r3. Placeholder, kept modest; selftest_genstep_scatter_count guards it. -->
          <coveredCellsPer10Cells>0.5~0.9</coveredCellsPer10Cells>
          <clusterRectRadius>2~3</clusterRectRadius>
        </li>
      </groups>
      <validators>
        <li Class="ScattererValidator_Buildable">
          <affordance>Heavy</affordance>
        </li>
      </validators>
    </genStep>
  </GenStepDef>

</Defs>
