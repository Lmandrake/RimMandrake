<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <MapGeneratorDef>
    <defName>RM_LanternDeepGenerator</defName>
    <label>lantern deeps</label>
    <isUnderground>true</isUnderground>
    <forceCaves>true</forceCaves>
    <ignoreAreaRevealedLetter>true</ignoreAreaRevealedLetter>
    <disableCallAid>true</disableCallAid>
    <!-- CAVERNS_PARITY_BUILD_1: was BMT_CrystalCaverns, borrowed from Biomes!
         Caverns. Now our own RM_LanternDeeps (Defs/Biomes/RM_LanternDeeps.xml),
         which carries no worldgen route at all — the sheet's hard ban 1 made
         structural rather than patched. -->
    <pocketMapProperties>
      <biome>RM_LanternDeeps</biome>
      <temperature>17</temperature>
      <!-- CAVERNS_PARITY_BUILD_1, MEASURED on the first live quicktest 2026-09-18:
           without this the Deep generated as SOLID rock (4,288 of 4,356 cells).
           TileMutatorWorker_UndergroundCave is what digs the tunnels (>=2000
           cells); vanilla's Undercave generator carries the same line. -->
      <tileMutators>
        <li>UndergroundCave</li>
      </tileMutators>
    </pocketMapProperties>
    <!-- LANTERN_DEEPS_INJECTION_1 spec item 6, the darkness mechanic: only Lantern
         Deep pocket maps get this component (CustomMapComponent subclasses are
         never auto-added, see the .cs header). -->
    <customMapComponents>
      <li>RimMandrake.LanternDeeps.MapComponent_LanternDeepDarkness</li>
      <!-- CAVERNS_PARITY_BUILD_1: regrows the biome's own wildPlants during play.
           Vanilla's WildPlantSpawner never consults them under a natural roof
           (only the planet-wide cavePlant set) — see the .cs header. -->
      <li>RimMandrake.LanternDeeps.MapComponent_DeepFloraRegrowth</li>
    </customMapComponents>
    <genSteps>
      <li>ElevationFertility</li>
      <li>MutatorPostElevationFertility</li>
      <!-- CAVERNS_PARITY_BUILD_1: order 190, adds lanternstone to the rock noise
           list before RocksFromGrid reads it — extraRockTypes is dead on a pocket
           map (World.RockAllowedInBiome returns false for an invalid tile). -->
      <li>RM_LanternstoneRock</li>
      <li>Underground_RocksFromGrid</li>
      <li>Terrain</li>
      <li>MutatorPostTerrain</li>
      <li>RockChunks</li>
      <!-- CAVERNS_PARITY_BUILD_1: was BMT_CrystalsGenerator (order 320, donor
           C# class). RM_LanternstoneFormations keeps order 320 so the pyrinth
           (330) and kyber (335) scatters still run after it. -->
      <li>RM_LanternstoneFormations</li>
      <!-- CRYSTAL_INGEST_EXECUTION_1: Deeps-only mineable scatters, gated by list
           membership (this MapGeneratorDef only ever produces a Lantern Deep pocket
           map) rather than a biome check === see each GenStepDef's own header. -->
      <li>RM_LanternDeepPyrinthScatter</li>
      <!-- LANTERNDEEPS_RM_MOD_BUILD_1: RUT_LanternDeepKyberScatter moved to
           src/RimUtinni/UtinniPatches/ with the kyber carve-out; it is added
           back onto this list from there (RUT_LanternDeepGateKyber.xml). -->
      <li>PlaceCaveExit</li>
      <li>Plants</li>
      <!-- CAVERNS_PARITY_BUILD_1: order 950, runs right after Plants(900); a
           no-op unless the owner turns cave flora off in Mod Settings. -->
      <li>RM_LanternDeepFloraGate</li>
      <li>MutatorFinal</li>
      <li>Fog</li>
    </genSteps>
  </MapGeneratorDef>

</Defs>
