<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <GenStepDef>
    <defName>RM_LanternDeepMineshaft_Scatter</defName>
    <order>321</order>
    <genStep Class="RimMandrake.LanternDeeps.GenStep_ScatterMineshaftPortal">
      <minSpacing>60</minSpacing>
      <!-- One portal per map that passes the C# gates (toggle, biome, chancePerMap roll).
           GenStep_Scatterer's count defaults to -1 with countPer10kCellsRange 0, which
           scatters ZERO times; and a <things> list with coveredCellsPer10Cells 0~0.02 on a
           7x7 rect rounds to zero placements. spawnAtCenter places exactly one, centred. -->
      <count>1</count>
      <groups>
        <li>
          <spawnAtCenter>RM_LanternDeepMineshaft</spawnAtCenter>
          <clusterRectRadius>3~3</clusterRectRadius>
        </li>
      </groups>
      <validators>
        <li Class="ScattererValidator_Buildable">
          <affordance>Heavy</affordance>
        </li>
        <li Class="ScattererValidator_NoNonNaturalEdifices" />
      </validators>
    </genStep>
  </GenStepDef>

</Defs>
