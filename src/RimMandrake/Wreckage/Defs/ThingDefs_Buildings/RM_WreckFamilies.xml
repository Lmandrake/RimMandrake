<?xml version="1.0" encoding="utf-8"?>
<!--
  SALVAGE_WRECKAGE_EVERYWHERE_1, design §3a: the wreck FAMILIES, abstract only.
  A family is what the wreck WAS; a biome's concrete child adds what the biome DID to it
  (label, description, texPath, its art's own shadow box, and one RM_WreckWeathering
  extension naming a weathering row from Defs/RM_WreckWeatheringDefs/). Worked example:
  src/RimMandrake/TerminalBiomes/Defs/ThingDefs_Buildings/RUT_ScaldWrecks.xml.

  What the family carries, so no child restates it:
  - ShipChunkBase's shape (static, non-claimable, always deconstructible, no rot or spawner);
  - terrainAffordanceNeeded Walkable on the base, so every family sits on shallows
    (inherited Light fails on water; the Scald trap, solved once);
  - resourcesFractionWhenDeconstructed 1.0: the costList is the UNweathered yield and the
    weathering's yieldFactor becomes the fraction at resolve time (RM_WreckWeathering.cs);
  - the base costList and killedLeavings (Inherit="False": ShipChunkBase's own 11 components
    and its component in killedLeavings are a fresh mech chunk's, not ours);
  - the RM_CompSalvageLoot loot tier. A weathering's lootTierShift moves it.

  ALL NUMBERS PROVISIONAL. Hull, Tank and Frame costs/leavings are the Scald's shipped values
  (so the Scald is unchanged by reparenting). Speeder, Carapace and Tread are INVENTED and have
  no child, no art and no measured shadow yet; their footprints are guesses to be fixed by the
  first biome sitting that casts them. Speeder and Tread roll the Hull table: no Speeder or
  Tread loot tier exists (design §3c lists five tiers).
  - the building tag RM_WreckSurface (design §3b's "wreck surface" marker): anything that grows or
    nests ON wrecks keys on it, never on defNames. First reader: the Warscar's
    MapComponent_WreckLichen (Scarlands). A building tag, not a ThingCategoryDef, so wrecks never
    show up in storage filters.
-->
<Defs>

  <ThingDef Name="RM_WreckFamilyBase" ParentName="ShipChunkBase" Abstract="True">
    <graphicData>
      <graphicClass>Graphic_Random</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <terrainAffordanceNeeded>Walkable</terrainAffordanceNeeded>
    <resourcesFractionWhenDeconstructed>1.0</resourcesFractionWhenDeconstructed>
    <building>
      <buildingTags>
        <li>RM_WreckSurface</li>
      </buildingTags>
    </building>
  </ThingDef>

  <ThingDef Name="RM_WreckFamily_Hull" ParentName="RM_WreckFamilyBase" Abstract="True">
    <costList Inherit="False">
      <Steel>30</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <killedLeavings Inherit="False">
      <ChunkSlagSteel>2</ChunkSlagSteel>
    </killedLeavings>
    <comps>
      <li Class="RimMandrake.Wreckage.RM_CompProperties_SalvageLoot">
        <lootTier>Hull</lootTier>
        <rareChance>0.05</rareChance>
      </li>
    </comps>
  </ThingDef>

  <ThingDef Name="RM_WreckFamily_Tank" ParentName="RM_WreckFamilyBase" Abstract="True">
    <costList Inherit="False">
      <Steel>20</Steel>
      <GravlitePanel>5</GravlitePanel>
    </costList>
    <killedLeavings Inherit="False">
      <ChunkSlagSteel>1</ChunkSlagSteel>
    </killedLeavings>
    <comps>
      <li Class="RimMandrake.Wreckage.RM_CompProperties_SalvageLoot">
        <lootTier>Tank</lootTier>
        <rareChance>0.05</rareChance>
      </li>
    </comps>
  </ThingDef>

  <ThingDef Name="RM_WreckFamily_Frame" ParentName="RM_WreckFamilyBase" Abstract="True">
    <costList Inherit="False">
      <Steel>15</Steel>
    </costList>
    <killedLeavings Inherit="False">
      <ChunkSlagSteel>1</ChunkSlagSteel>
    </killedLeavings>
    <comps>
      <li Class="RimMandrake.Wreckage.RM_CompProperties_SalvageLoot">
        <lootTier>Scrap</lootTier>
        <rareChance>0</rareChance>
      </li>
    </comps>
  </ThingDef>

  <!-- INVENTED: a small craft's shell (Long Shade, Deep Desert, Fall Line). -->
  <ThingDef Name="RM_WreckFamily_Speeder" ParentName="RM_WreckFamilyBase" Abstract="True">
    <costList Inherit="False">
      <Steel>40</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <killedLeavings Inherit="False">
      <ChunkSlagSteel>2</ChunkSlagSteel>
    </killedLeavings>
    <comps>
      <li Class="RimMandrake.Wreckage.RM_CompProperties_SalvageLoot">
        <lootTier>Hull</lootTier>
        <rareChance>0.05</rareChance>
      </li>
    </comps>
  </ThingDef>

  <!-- INVENTED: a droid shell, 1x1. Component-heavy; the restraining-bolt risk is a Phase 3 idea, not built. -->
  <ThingDef Name="RM_WreckFamily_Carapace" ParentName="RM_WreckFamilyBase" Abstract="True">
    <size>(1,1)</size>
    <graphicData>
      <drawSize>(1,1)</drawSize>
      <shadowData>
        <volume>(0.7,0.4,0.6)</volume>
      </shadowData>
    </graphicData>
    <costList Inherit="False">
      <Steel>10</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <killedLeavings Inherit="False">
      <ChunkSlagSteel>1</ChunkSlagSteel>
    </killedLeavings>
    <comps>
      <li Class="RimMandrake.Wreckage.RM_CompProperties_SalvageLoot">
        <lootTier>Carapace</lootTier>
        <rareChance>0.05</rareChance>
      </li>
    </comps>
  </ThingDef>

  <!-- INVENTED: a crawler tread section, 3x3, steel-heavy. -->
  <ThingDef Name="RM_WreckFamily_Tread" ParentName="RM_WreckFamilyBase" Abstract="True">
    <size>(3,3)</size>
    <graphicData>
      <drawSize>(3,3)</drawSize>
      <shadowData>
        <volume>(2.1,0.6,1.9)</volume>
      </shadowData>
    </graphicData>
    <costList Inherit="False">
      <Steel>80</Steel>
    </costList>
    <killedLeavings Inherit="False">
      <ChunkSlagSteel>3</ChunkSlagSteel>
    </killedLeavings>
    <comps>
      <li Class="RimMandrake.Wreckage.RM_CompProperties_SalvageLoot">
        <lootTier>Hull</lootTier>
        <rareChance>0.03</rareChance>
      </li>
    </comps>
  </ThingDef>

</Defs>
