<?xml version="1.0" encoding="utf-8"?>
<!--
  SALVAGE_WRECKAGE_EVERYWHERE_1, design §3c: one loot table per tier.
  RM_CompSalvageLoot rolls RM_SalvageLoot_<tier> on every careful deconstruct, and
  RM_SalvageLoot_<tier>_Rare at the comp's rareChance scaled by the salvager's skill.
  Each option of a ThingSetMaker_Sum rolls independently at its own chance.
  ALL NUMBERS ARE PROVISIONAL (invented for tuning, design §3c table).
  The rare rows are VANILLA STAND-INS (ComponentSpacer, a pair of components) for the
  design's "usable ship part / working valve / intact droid part": the RUT_/RSW_ layer
  patches Star Wars parts into these defs (Q11a); the RM_ tier stays franchise-free.
  Scrap has no rare table on purpose (design §3c: "rare roll: none").
-->
<Defs>

  <ThingSetMakerDef>
    <defName>RM_SalvageLoot_Scrap</defName>
    <root Class="ThingSetMaker_Sum">
      <options>
        <li>
          <chance>0.4</chance>
          <thingSetMaker Class="ThingSetMaker_StackCount">
            <fixedParams>
              <filter>
                <thingDefs>
                  <li>ComponentIndustrial</li>
                </thingDefs>
              </filter>
              <countRange>1</countRange>
            </fixedParams>
          </thingSetMaker>
        </li>
        <li>
          <chance>0.7</chance>
          <thingSetMaker Class="ThingSetMaker_StackCount">
            <fixedParams>
              <filter>
                <thingDefs>
                  <li>Steel</li>
                </thingDefs>
              </filter>
              <countRange>3~8</countRange>
            </fixedParams>
          </thingSetMaker>
        </li>
      </options>
    </root>
  </ThingSetMakerDef>

