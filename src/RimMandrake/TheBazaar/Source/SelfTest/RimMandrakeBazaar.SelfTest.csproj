<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Bazaar price-engine offline fuzz (Approach B, same shape as FlowWorks/GimmeSomeSlack). Plain net8.0, zero
    RimWorld/Unity references: ../Economy/RM_BazaarKernel.cs is the PRODUCTION file the mod compiles, pulled in
    directly. If a `using Verse;` ever lands in it, this build breaks - that is the guard rail working.
    Run (builds on Windows via winbuild staging, then runs the exe):
      python3 src/RimMandrake/Utils/selftest_bazaar_fuzz.py [fuzz knobs]
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RimMandrakeBazaar.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.Bazaar.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Economy\RM_BazaarKernel.cs" />
    <Compile Include="BazaarFuzz.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
