<?xml version="1.0" encoding="utf-8"?>
<!--
  GRAVSHIP_ACOUSTIC_SCANNER_1: the acoustic-scanner payload for RM_LeaningScrub.
  Owner decision by question card 2026-10-06: the payload goes on EVERY biome of ours.

  Pure XML, FindMod-guarded on "RimMandrake: Acoustic Scanner", so the extension class
  is only named while its assembly is active. Every def is a defName STRING resolved
  at pulse time (GetNamedSilentFail), so a target naming another mod's def just hears
  nothing when that mod is absent. Each target is drawn from this biome's own content;
  the biome's sitting may re-author it. The reading is always banded by the scanner.
-->
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>RimMandrake: Acoustic Scanner</li>
    </mods>
    <match Class="PatchOperationAddModExtension">
      <xpath>/Defs/BiomeDef[defName="RM_LeaningScrub"]</xpath>
      <value>
        <li Class="RimMandrake.AcousticScanner.RM_AcousticPayloadExtension">
          <quietText>Wind and fuzz and root-bound crust, the same in every direction.</quietText>
          <targets>
            <li>
              <label>something under the root crust</label>
              <reading>A dull thud under the fuzz, then another one further on. It is moving.</reading>
              <color>(1, 0.45, 0.35)</color>
              <weight>2</weight>
              <pawnRaces>
                <li>RM_Surrik</li>
                <li>RM_TruffleMole</li>
                <li>Terrorworm</li>
              </pawnRaces>
            </li>
            <li>
              <label>sweetline tree</label>
              <reading>Deep, wet roots, much deeper than anything else here: one old tree drinking.</reading>
              <color>(0.45, 0.9, 0.85)</color>
              <weight>2</weight>
              <thingDefs>
                <li>RM_SweetlineTree</li>
              </thingDefs>
            </li>
            <li>
              <label>hollow venomvine</label>
              <reading>A stand of empty cane tubes, ringing like pipes.</reading>
              <color>(0.9, 0.6, 0.4)</color>
              <thingDefs>
                <li>RM_HollowVenomvine</li>
              </thingDefs>
            </li>
            <li>
              <label>void in the rock</label>
              <reading>The echo drops into a hollow under the crust.</reading>
              <color>(0.6, 0.6, 0.9)</color>
              <hiddenCaves>true</hiddenCaves>
              <cellSampleStride>4</cellSampleStride>
            </li>
          </targets>
        </li>
      </value>
    </match>
  </Operation>
</Patch>
