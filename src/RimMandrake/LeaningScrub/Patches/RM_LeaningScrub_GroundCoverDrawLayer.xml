<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_LeaningScrub_GroundCoverDrawLayer.xml   authored 2026-10-14
  Owner ruling 2026-10-14 (typed): "Lower all such plants in all biomes. Small ground cover on the
  appropriate layer."  Item: ROT_MOSS_VERIFY_UNDER_THE_MUSHROOMS.

  Ground cover spawned by RM_LeaningScrub / RUT_AridShrubland (our RSW desert-port twins, defined in
  src/RimStarWars/SWBestiary/Defs/DesertPort/RSW_DesertPortMisc_Plants.xml), moved from LowPlant (11)
  to FloorEmplacement (7). Plant.Print lifts a plant's top edge 0.1 in altitude and layers sit
  0.366 apart (Altitudes.LayerSpacing), so any lower layer is enough to keep cover under LowPlant plants;
  inside one layer the order is hash-random (the "moss sometimes in front" report). Draw order only:
  size, food, fertility and growth are untouched. The change is global to the def (all biomes).
  Census and criteria: design/RimMandrake/plant_draw_layers_2026-10-14.md
  (src/RimMandrake/Utils/plant_draw_layers.py). Each def inherits altitudeLayer from PlantBase,
  so the op ADDS the field to the def; the Replace branch covers a future own declaration. The def
  is tested first: with RimStarWars absent the patch is a silent no-op.
-->
<Patch>
  <!-- arid grass (RSW desert port) -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="RSW_JekkaGrass"]/altitudeLayer</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/ThingDef[defName="RSW_JekkaGrass"]/altitudeLayer</xpath>
      <value><altitudeLayer>FloorEmplacement</altitudeLayer></value>
    </match>
    <nomatch Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="RSW_JekkaGrass"]</xpath>
      <match Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="RSW_JekkaGrass"]</xpath>
        <value><altitudeLayer>FloorEmplacement</altitudeLayer></value>
      </match>
    </nomatch>
  </Operation>
  <!-- crimson cushion (RSW desert port) -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="RSW_RuzzoCarpet"]/altitudeLayer</xpath>
    <match Class="PatchOperationReplace">
      <xpath>/Defs/ThingDef[defName="RSW_RuzzoCarpet"]/altitudeLayer</xpath>
      <value><altitudeLayer>FloorEmplacement</altitudeLayer></value>
    </match>
    <nomatch Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="RSW_RuzzoCarpet"]</xpath>
      <match Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="RSW_RuzzoCarpet"]</xpath>
        <value><altitudeLayer>FloorEmplacement</altitudeLayer></value>
      </match>
    </nomatch>
  </Operation>
</Patch>
