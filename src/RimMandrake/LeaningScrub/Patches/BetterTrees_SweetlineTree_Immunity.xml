<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- TREE_GRAPHICS_OWNERSHIP_1 — defensive, not corrective. Retargeted from
       src/RimUtinni/AshkarrFlora/Patches/BetterTrees_SweetlineTree_Immunity.xml
       onto the renamed RM_SweetlineTree, per §7 Q8. See that file's own
       header for the full account: the three subscribed "better trees" mods
       key rescale/retexture lookups by exact defName, RM_SweetlineTree is
       absent from every template they currently ship (already immune by
       construction), and this patch is insurance against a future update
       adding an entry for it — matches nothing today and therefore logs
       nothing today (CLAUDE.md: "a patch that matches nothing logs
       nothing" is expected here). The original file in
       mandrake.rut.ashkarrflora was deleted with that mod (PLANT_TIERS_RECONCILE_MOST_ARE_BAROQUE,
       2026-10-16). -->

  <Operation Class="PatchOperationFindMod">
    <mods><li>Better Trees</li></mods>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/BetterTrees.TreeScaleTemplateDef/treeScales/li[defName="RM_SweetlineTree"]</xpath>
      <match Class="PatchOperationRemove">
        <xpath>/Defs/BetterTrees.TreeScaleTemplateDef/treeScales/li[defName="RM_SweetlineTree"]</xpath>
      </match>
    </match>
  </Operation>

  <Operation Class="PatchOperationFindMod">
    <mods><li>Better Trees</li></mods>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/BetterTrees.TreeTextureTemplateDef/treeTextures/li[key="RM_SweetlineTree"]</xpath>
      <match Class="PatchOperationRemove">
        <xpath>/Defs/BetterTrees.TreeTextureTemplateDef/treeTextures/li[key="RM_SweetlineTree"]</xpath>
      </match>
    </match>
  </Operation>

</Patch>
