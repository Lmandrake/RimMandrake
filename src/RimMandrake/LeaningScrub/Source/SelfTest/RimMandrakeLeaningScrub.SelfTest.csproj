<Project Sdk="Microsoft.NET.Sdk">

  <!--
    LeaningScrub offline fuzz, Approach B (same shape as Wasteland/FeverWood). Plain net8.0, zero RimWorld/Unity
    references: ../Kernel/*.cs are the PRODUCTION files the mod compiles, pulled in directly. A `using Verse;` landing
    in one of them breaks this build - that is the guard rail working.
    Run (builds on Windows via winbuild staging, then runs the exe):
      python3 src/RimMandrake/Utils/selftest_leaningscrub_fuzz.py [fuzz knobs]
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RimMandrakeLeaningScrub.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.LeaningScrub.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Kernel\RM_LeanKernel.cs" />
    <Compile Include="..\Kernel\RM_SmotherKernel.cs" />
    <Compile Include="..\Kernel\RM_BlazeKernel.cs" />
    <Compile Include="..\Kernel\RM_GuardianKernel.cs" />
    <Compile Include="..\Kernel\RM_FormsKernel.cs" />
    <Compile Include="..\Kernel\RM_CoatKernel.cs" />
    <Compile Include="LeaningScrubFuzz.cs" />
    <Compile Include="LeaningScrubFuzz2.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
