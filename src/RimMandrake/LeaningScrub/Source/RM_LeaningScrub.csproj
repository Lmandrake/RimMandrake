<Project Sdk="Microsoft.NET.Sdk">

  <!--
    LEANINGSCRUB_RM_MOD_BUILD_1. Same recipe as
    src/RimMandrake/FloodedCanyon/Source/RM_FloodedCanyon.csproj — copy that
    header if this one goes stale.

    Build (the dotnet is WINDOWS-NATIVE and cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\Rimworld\src\RimMandrake\LeaningScrub\Source\RM_LeaningScrub.csproj -c Release

    Output lands in ../Assemblies/, which is where RimWorld looks.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrake.LeaningScrub</AssemblyName>
    <RootNamespace>RimMandrake.LeaningScrub</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <!-- Nothing but our own DLL should ever be copied next to the mod —
         Harmony in particular must come from brrainz.harmony at runtime. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HarmonyDll)' == ''">
    <HarmonyDll>C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\2009463077\Current\Assemblies\0Harmony.dll</HarmonyDll>
  </PropertyGroup>

  <!-- This mod's own Mod Settings register a gate with the shared
       EnvironmentalHazards assembly's RM_MechanicGates registry, so it
       compiles against that assembly and declares
       mandrake.rm.environmentalhazards in About.xml. Build EnvironmentalHazards
       first; the DLL is tracked in the repo, so a clean checkout already has one. -->
  <PropertyGroup Condition="'$(EnvironmentalHazardsDll)' == ''">
    <EnvironmentalHazardsDll>$(MSBuildThisFileDirectory)..\..\EnvironmentalHazards\Assemblies\RimMandrake.EnvironmentalHazards.dll</EnvironmentalHazardsDll>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="RM_LeaningScrubMod.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RimMandrake.EnvironmentalHazards">
      <HintPath>$(EnvironmentalHazardsDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
