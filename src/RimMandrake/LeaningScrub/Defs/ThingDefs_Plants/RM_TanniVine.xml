<Defs>

  <ThingDef ParentName="PlantBase">
    <defName>RM_TanniVine</defName>
    <label>tanni vine</label>
    <description>Wild ivy with star-shaped leaves. Takes a long time to grow, but is very frost-resistant.</description>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <Flammability>0.6</Flammability>
      <Nutrition>0.15</Nutrition>
    </statBases>
    <!-- TEMP PLACEHOLDER (borrowed, not owned): Alpha Biomes' AB_Aaklac, carried over from RSW_TanniVine. -->
    <graphicData>
      <texPath>Things/Plants/AB_Aaklac</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <hideAtSnowOrSandDepth>0.5</hideAtSnowOrSandDepth>
    <ingestible/>
    <plant>
      <fertilityMin>0.05</fertilityMin>
      <fertilitySensitivity>0.2</fertilitySensitivity>
      <growDays>15</growDays>
      <harvestWork>75</harvestWork>
      <maxMeshCount>4</maxMeshCount>
      <wildClusterRadius>4</wildClusterRadius>
      <wildClusterWeight>8</wildClusterWeight>
      <visualSizeRange>0.8~1.3</visualSizeRange>
      <topWindExposure>0.25</topWindExposure>
      <wildOrder>1</wildOrder>
    </plant>
  </ThingDef>

</Defs>
