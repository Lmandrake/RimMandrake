    </graphicData>
    <selectable>true</selectable>
    <pathCost>90</pathCost>
    <plant>
      <fertilityMin>0.5</fertilityMin>
      <fertilitySensitivity>0.3</fertilitySensitivity>
      <growDays>12</growDays>
      <lifespanDaysPerGrowDays>0</lifespanDaysPerGrowDays>
      <dieIfLeafless>false</dieIfLeafless>
      <wildClusterRadius>6</wildClusterRadius>
      <wildClusterWeight>12</wildClusterWeight>
      <wildOrder>2</wildOrder>
      <maxMeshCount>1</maxMeshCount>
      <visualSizeRange>0.9~1.3</visualSizeRange>
      <topWindExposure>0.1</topWindExposure>
      <harvestWork>1400</harvestWork>
      <allowAutoCut>false</allowAutoCut>
      <purpose>Misc</purpose>
    </plant>
    <comps>
      <li Class="RimMandrake.EnvironmentalHazards.CompProperties_ContactVenom">
        <damageDef>RM_VenomvineScratch</damageDef>
        <damageAmount>3</damageAmount>
        <armorPenetration>0.05</armorPenetration>
        <contactIntervalTicks>2500</contactIntervalTicks>
        <bodyHeight>Bottom</bodyHeight>
      </li>
      <li Class="RimMandrake.EnvironmentalHazards.RM_CompProperties_BodySizeBarrier">
        <passFreelyBodySize>0.8</passFreelyBodySize>
        <blockBodySize>1.5</blockBodySize>
        <threadMoveCost>300</threadMoveCost>
        <trappedMoveCost>450</trappedMoveCost>
      </li>
      <!-- PROVISIONAL: a pool in radius 2 on 10% of half-minute ticks; at most 12 poisoned cells per stand. -->
      <li Class="RimMandrake.LeaningScrub.RM_CompProperties_Weeper">
        <minGrowth>0.5</minGrowth>
        <poolChancePerLongTick>0.1</poolChancePerLongTick>
        <radius>2</radius>
        <maxPollutedCells>12</maxPollutedCells>
        <poolDef>RM_VenomPool</poolDef>
      </li>
      <li Class="RimMandrake.LeaningScrub.RM_CompProperties_Smotherable">
        <yieldCount>40</yieldCount>
      </li>
    </comps>
    <modExtensions>
      <li Class="RimMandrake.EnvironmentalHazards.RM_MechanicGateExtension">
        <gateKey>leaningscrub.venomvinePassability</gateKey>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="PlantBaseNonEdible">
    <defName>RM_SleeperVenomvine</defName>
    <label>dead venomvine</label>
    <description>A snarl of grey, dry, dead-looking venomvine, canes brittle and bleached. It looks like what a fire or a smothering leaves behind. It is not. Anything with weight that steps beside it wakes it, and it is alive and black and angry before the foot comes down.</description>
    <statBases>
      <MaxHitPoints>550</MaxHitPoints>
      <Flammability>0.1</Flammability>
      <Nutrition>0</Nutrition>
      <Beauty>-4</Beauty>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/RM_SleeperVenomvine</texPath>
      <color>(0.62, 0.58, 0.50)</color>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <selectable>true</selectable>
    <pathCost>90</pathCost>
    <plant>
      <fertilityMin>0.5</fertilityMin>
      <fertilitySensitivity>0.3</fertilitySensitivity>
      <growDays>12</growDays>
      <lifespanDaysPerGrowDays>0</lifespanDaysPerGrowDays>
      <dieIfLeafless>false</dieIfLeafless>
      <wildClusterRadius>6</wildClusterRadius>
      <wildClusterWeight>12</wildClusterWeight>
      <wildOrder>2</wildOrder>
      <maxMeshCount>1</maxMeshCount>
      <visualSizeRange>0.9~1.3</visualSizeRange>
      <topWindExposure>0.1</topWindExposure>
      <harvestWork>300</harvestWork>
      <allowAutoCut>false</allowAutoCut>
      <purpose>Misc</purpose>
    </plant>
    <comps>
      <!-- PROVISIONAL: wakes for a grounded body of size 0.5 or more within 1.5 cells; lashes whoever is beside it for 6. -->
      <li Class="RimMandrake.LeaningScrub.RM_CompProperties_Sleeper">
        <minBodySize>0.5</minBodySize>
        <wakeRadius>1.5</wakeRadius>
        <wakeDamage>6</wakeDamage>
        <awakeDef>RM_SleeperVenomvineAwake</awakeDef>
      </li>
      <li Class="RimMandrake.LeaningScrub.RM_CompProperties_Smotherable">
        <yieldCount>40</yieldCount>
      </li>
    </comps>
  </ThingDef>

