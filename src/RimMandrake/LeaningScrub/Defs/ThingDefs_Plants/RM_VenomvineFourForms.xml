<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_VenomvineFourForms.xml          LEANINGSCRUB_STRANGLER_VINE_1 / _WEEPER_VINE_1 / _SLEEPER_VINE_1 / _LURE_VINE_1

  The four further venomvine forms admitted by the owner's card 2026-10-08
  (LEANINGSCRUB_VENOMVINE_FORMS_PITCH_1). Strangler wraps a wall or tree and is trimmed; Weeper leaves venom pools
  that poison the soil; Sleeper looks like dead vine until disturbed; Lure's sweet fruit draws animals to the thicket.
  Siblings of the six in RM_VenomvineSixForms.xml (same hit points, barrier, venom, smotherable, gate key); mechanics
  in Source/RM_VenomvineFourForms.cs, one Mod Setting each. Numbers PROVISIONAL.
  The sleeper is the exception: asleep it carries no venom and no barrier (it is a dead-looking harmless snarl) and
  wakes into RM_SleeperVenomvineAwake, a plain live stand.
  Art: each form has its own Graphic_Random folder; each holds the thicket render as an INTERIM picture
  (the sleeper tints it grey). Bespoke renders owed: see the four items.
-->
<Defs>

  <ThingDef ParentName="PlantBaseNonEdible">
    <defName>RM_StranglerVenomvine</defName>
    <label>strangler venomvine</label>
    <description>Canes thin as cord and long as a rope, no thicker than a wrist anywhere, laid round whatever stands beside them in tight turns. A strangler does not strike. It holds. Along a wall it climbs and tightens, a little more each day, until the mortar gives; round a tree it does not let go until the tree is down. Whoever keeps a wall keeps a pair of cutters for it.</description>
    <statBases>
      <MaxHitPoints>550</MaxHitPoints>
      <Flammability>0.1</Flammability>
      <Nutrition>0</Nutrition>
      <Beauty>-4</Beauty>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/RM_StranglerVenomvine</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <selectable>true</selectable>
    <pathCost>90</pathCost>
    <plant>
      <fertilityMin>0.5</fertilityMin>
      <fertilitySensitivity>0.3</fertilitySensitivity>
      <growDays>12</growDays>
      <lifespanDaysPerGrowDays>0</lifespanDaysPerGrowDays>
      <dieIfLeafless>false</dieIfLeafless>
      <wildClusterRadius>6</wildClusterRadius>
      <wildClusterWeight>12</wildClusterWeight>
      <wildOrder>2</wildOrder>
      <maxMeshCount>1</maxMeshCount>
      <visualSizeRange>0.9~1.3</visualSizeRange>
      <topWindExposure>0.1</topWindExposure>
      <harvestWork>1400</harvestWork>
      <allowAutoCut>false</allowAutoCut>
      <purpose>Misc</purpose>
    </plant>
    <comps>
      <li Class="RimMandrake.EnvironmentalHazards.CompProperties_ContactVenom">
        <damageDef>RM_VenomvineScratch</damageDef>
        <damageAmount>3</damageAmount>
        <armorPenetration>0.05</armorPenetration>
        <contactIntervalTicks>2500</contactIntervalTicks>
        <bodyHeight>Bottom</bodyHeight>
      </li>
      <li Class="RimMandrake.EnvironmentalHazards.RM_CompProperties_BodySizeBarrier">
        <passFreelyBodySize>0.8</passFreelyBodySize>
        <blockBodySize>1.5</blockBodySize>
        <threadMoveCost>300</threadMoveCost>
        <trappedMoveCost>450</trappedMoveCost>
      </li>
      <!-- PROVISIONAL: wraps the wall or tree beside it, 10% tighter per half-minute, 6 blunt damage at full wrap. -->
      <li Class="RimMandrake.LeaningScrub.RM_CompProperties_Strangler">
        <minGrowth>0.5</minGrowth>
        <wrapStep>0.1</wrapStep>
        <fullDamage>6</fullDamage>
      </li>
      <li Class="RimMandrake.LeaningScrub.RM_CompProperties_Smotherable">
        <yieldCount>40</yieldCount>
      </li>
    </comps>
    <modExtensions>
      <li Class="RimMandrake.EnvironmentalHazards.RM_MechanicGateExtension">
        <gateKey>leaningscrub.venomvinePassability</gateKey>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="PlantBaseNonEdible">
    <defName>RM_WeeperVenomvine</defName>
    <label>weeper venomvine</label>
    <description>Every cane ends in a slow bead of venom the colour of old tea, and the ground beneath is wet with it. A weeper never stops. Where it has stood a season there is a dark ring of pools, and nothing green grows in the ring. It is not dangerous to pass; it is dangerous to farm beside.</description>
    <statBases>
      <MaxHitPoints>550</MaxHitPoints>
      <Flammability>0.1</Flammability>
      <Nutrition>0</Nutrition>
      <Beauty>-4</Beauty>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/RM_WeeperVenomvine</texPath>
