<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_SweetlineTree.xml                       LEANINGSCRUB_RM_MOD_BUILD_1

  Renamed from src/RimUtinni/AshkarrFlora/Defs/ThingDefs_Plants/
  RUT_AshkarrFlora_Plants.xml's RUT_SweetlineTree def per
  biome_mod_architecture.md §7 Q8 ("mandrake.rut.ashkarrflora: DISSOLVE IT.
  Each plant moves into the RimMandrake mod of the biome whose wildPlants
  lists it, renamed RM_"). Byte-identical content (defName, texPath and
  harvestedThingDef aside) — see that file's own header for the full design
  account (TREE_GRAPHICS_OWNERSHIP_1, SWEETLINE_WOOL_HARVEST_1,
  design/Jawa/worldbuilding/biomes/arid_shrubland.md §4 "The sweetline
  trees").

  🔑 The ORIGINAL RUT_SweetlineTree def is left standing in
  mandrake.rut.ashkarrflora, untouched — mandrake.rut.ashkarrflora is frozen
  alongside RUT_AridShrubland.xml (see RM_LeaningScrub_Biome.xml's own
  header), and real deletion waits for Phase B.

  ⚠️ NOT added to RM_LeaningScrub_Biome.xml's wildPlants — same as the
  original, which never wired it into spawning either. See the biome def's
  own comment for why.

  Art: the 14-variant art (RUT_SweetlineTreeA.png..N.png) is copied and
  renamed to RM_SweetlineTree*.png in this mod's own Textures folder —
  Graphic_Random groups by filename prefix before the first "_", so the
  bare-letter-suffix convention is preserved.
-->
<Defs>

  <ThingDef ParentName="TreeBase">
    <defName>RM_SweetlineTree</defName>
    <label>sweetline tree</label>
    <!-- SHRUBLAND_TREE_GUARDIAN_1: the harvest seam for the bark-warden roost. -->
    <thingClass>RimMandrake.LeaningScrub.RM_Plant_Guarded</thingClass>
    <description>A single ancient giant, centuries old, growing only where the moisture-light trade balances exactly. Its bark is rough enough that every coated beast of the plain comes to scratch on it, and the trunk is worn smooth in patches where they have rubbed for longer than any settlement nearby has stood. Their coats pile at its foot, and what the bark keeps it mats with its resin into sweetline felt. Every sweetline tree has a name, and the roads of the shrubland are laid tree to tree along the line they mark.\n\nBark-wardens roost asleep against the trunk. They watch whoever passes, and drop on whoever strips the wool or wounds the bark.</description>
    <graphicData>
      <texPath>Things/Plant/RM_SweetlineTree</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <shadowData>
        <volume>(0.45, 0.6, 0.32)</volume>
        <offset>(0,0,-0.46)</offset>
      </shadowData>
    </graphicData>
    <statBases>
      <MaxHitPoints>650</MaxHitPoints>
      <Flammability>0.1</Flammability>
      <Mass>900</Mass>
      <BeautyOutdoors>10</BeautyOutdoors>
    </statBases>
    <plant>
      <visualSizeRange>7.7~10.0</visualSizeRange>
      <growDays>240</growDays>
      <harvestWork>4200</harvestWork>
      <harvestedThingDef>RM_SweetlineWool</harvestedThingDef>
      <harvestYield>20</harvestYield>
      <harvestTag>Standard</harvestTag>
      <harvestAfterGrowth>0.05</harvestAfterGrowth>
      <forceIsTree>true</forceIsTree>
      <wildClusterRadius>0</wildClusterRadius>
      <wildClusterWeight>0.05</wildClusterWeight>
      <wildOrder>4</wildOrder>
    </plant>
    <comps>
      <!-- LEANINGSCRUB_GPT_ENRICHMENT_1: name, history panel, shed timer
           (Source/RM_SweetlineStation.cs). 5 felt every 5 days once mature: the
           generous free path, which keeps going after a harvest (owner R11).
           SWEETLINE_SCRATCHING_TREE_BUILD_1: animals rub their coats off here and
           a share felts into the bark (feltPerCoatUnit, feltCap), paid out at harvest. -->
      <li Class="RimMandrake.LeaningScrub.RM_CompProperties_SweetlineStation">
        <namer>RM_NamerSweetlineTree</namer>
        <woolThing>RM_SweetlineWool</woolThing>
        <woolCount>5</woolCount>
        <woolIntervalDays>5</woolIntervalDays>
        <maxHistory>12</maxHistory>
        <!-- LEANINGSCRUB_SWEETLINE_VISITORS_1: abstract road-folk visits; pilgrims leave this. -->
        <tokenThing>RM_SweetlineToken</tokenThing>
        <pilgrimChance>0.6</pilgrimChance>
        <maxTokensNear>3</maxTokensNear>
        <feltPerCoatUnit>0.25</feltPerCoatUnit>
        <feltCap>120</feltCap>
      </li>
      <!-- SHRUBLAND_TREE_GUARDIAN_1 (Source/RM_SweetlineGuardians.cs): 2-3 roosting
           bark-wardens, a disturbance meter that harvest work and wounds fill, warning
           stages at 30%/60%, the drop at 100%. Refill 30-60 days (builder's reconcile
           against the 84-day wool regrow, activation doc §6). -->
      <li Class="RimMandrake.LeaningScrub.RM_CompProperties_GuardianRoost">
        <guardianKind>RM_Barkwarden</guardianKind>
        <rageState>RM_RoostDefence</rageState>
        <count>2~3</count>
        <respawnDays>30~60</respawnDays>
        <spawnRadius>3</spawnRadius>
        <disengageRadius>18</disengageRadius>
        <rageDurationTicks>2500</rageDurationTicks>
        <rageCooldownTicks>600</rageCooldownTicks>
        <workDisturbance>0.10</workDisturbance>
        <harvestDisturbance>0.25</harvestDisturbance>
        <damageDisturbancePerPoint>0.05</damageDisturbancePerPoint>
        <watchRadius>9</watchRadius>
        <rehomeRadius>60</rehomeRadius>
      </li>
    </comps>
  </ThingDef>

</Defs>
