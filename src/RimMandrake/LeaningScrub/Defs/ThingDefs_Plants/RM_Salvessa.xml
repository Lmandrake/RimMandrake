<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_Salvessa - PLANT_TIERS_RECONCILE_MOST_ARE_BAROQUE (owner 2026-10-16: "Star Wars will have a very few canon plants, and those can just be reskins of non-canon versions we create in the Baroque Biomes"; by card "Invent 7 new Baroque bases").
  Invented, franchise-free base whose growth, harvest and stats are copied 1:1 from the canon RSW_Plant_Nysyllin_Wild
  (SWBestiary RSW_DesertPortB_Plants.xml), which is now a pure reskin of this def (ParentName="RM_Salvessa").
  Home: RM_LeaningScrub. Not RM_WildHealroot: that plant grows and harvests differently (owner chose a new base).
  ART: own folder Things/RM_Salvessa (holds RM_Salvessa.png; immatureGraphicPath names the png itself) (raw item keeps a vanilla placeholder).
-->
<Defs>

  <ThingDef ParentName="PlantBase" Name="RM_Salvessa">
    <defName>RM_Salvessa</defName>
    <label>wild salvessa</label>
    <description>A scrubland herb of wiry, silver-blue stems bearing fat, segmented pods. When ripe the pods split to show a milky pith that, dried and pounded, makes a serviceable primitive medicine. Fussy about its soil, and only someone who knows plants can coax it to grow.</description>
    <statBases>
      <MaxHitPoints>85</MaxHitPoints>
      <Nutrition>0.2</Nutrition>
    </statBases>
    <graphicData>
      <!-- own texPath; folder empty until the owner rules the base-art sheet (pink until then) -->
      <texPath>Things/RM_Salvessa</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <selectable>true</selectable>
    <pathCost>14</pathCost>
    <ingestible />
    <plant>
      <wildClusterRadius>5</wildClusterRadius>
      <wildClusterWeight>250</wildClusterWeight>
      <sowTags Inherit="False" />
      <fertilityMin>0.8</fertilityMin>
      <fertilitySensitivity>0.8</fertilitySensitivity>
      <maxMeshCount>9</maxMeshCount>
      <immatureGraphicPath>Things/RM_Salvessa</immatureGraphicPath>
      <growDays>10</growDays>
      <dieIfLeafless>true</dieIfLeafless>
      <harvestTag>Standard</harvestTag>
      <drugForHarvestPurposes>True</drugForHarvestPurposes>
      <harvestedThingDef>RM_RawSalvessa</harvestedThingDef>
      <harvestYield>10</harvestYield>
      <sowMinSkill>6</sowMinSkill>
      <sowTags>
        <li>Ground</li>
      </sowTags>
      <topWindExposure>0.1</topWindExposure>
      <visualSizeRange>0.7~1.3</visualSizeRange>
      <wildOrder>2</wildOrder>
      <maxGrowthTemperature>75</maxGrowthTemperature>
    </plant>
  </ThingDef>

  <ThingDef ParentName="RoughPlantBase" Name="RM_RawSalvessa">
    <defName>RM_RawSalvessa</defName>
    <label>salvessa pods</label>
    <description>Raw salvessa pods. Can be refined into large quantities of primitive medicine.</description>
    <possessionCount>10</possessionCount>
    <graphicData>
      <!-- TEMP placeholder (vanilla) -->
      <texPath>Things/Item/Resource/PlantFoodRaw/Hay</texPath>
    <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>10</MarketValue>
      <Flammability>1.3</Flammability>
    </statBases>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>45</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <thingCategories>
      <li>PlantMatter</li>
    </thingCategories>
    <ingestible>
      <preferability>DesperateOnly</preferability>
      <canAutoSelectAsFoodForCaravan>false</canAutoSelectAsFoodForCaravan>
    </ingestible>
  </ThingDef>

</Defs>
