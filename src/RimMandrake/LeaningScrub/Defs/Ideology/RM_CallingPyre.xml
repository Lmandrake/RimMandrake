<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  RM_CallingPyre.xml          LEANINGSCRUB_MECHANICS_BUILD_1 part 5, second half
  ============================================================================
  The calling-pyre: a ritual that torches the colony's own fields to bring the
  fire-stamping giants down on everyone who remains. C#: Source/RM_CallingPyre.cs.

  Rulings:
    Q7 (card 2026-10-15)  "Calling-pyre size -> Ritual plus all three beliefs":
                          forbidden, last rite, venerated.
    N3 (card, asked twice, the second answer FINAL) "Which belief systems offer
                          the calling-pyre precept -> Only fire- and ritual-themed
                          ones". requiredMemes is ANY-OF (IdeoFoundation.
                          HasRequiredMemes, RimSage-read): vanilla Ritualist, and
                          VME_FireWorship when Vanilla Ideology Expanded - Memes is
                          loaded (vanilla has no fire meme). No Scrub-only rule.

  Shapes copied from vanilla Ideology: the issue/precept trio from
  Precepts_Mining.xml, the ritual precept from GladiatorDuel (Precepts_Ritual.xml),
  the behaviour from BurnCircle (Ritual_Behaviors.xml), the outcome tiers from
  CelebratedDate (Ritual_Outcomes.xml).

  Icons: vanilla Ideology's own BurnCircle ritual icon, interim; the calling-pyre
  art is a sheet round in the sprint (kickoff §1.3 "Art set").
  Mood numbers PROVISIONAL (owner ruling 2026-10-03).
  ============================================================================
-->
<Defs>

  <HistoryEventDef>
    <defName>RM_CalledTheHerds</defName>
    <label>called the herds with fire</label>
  </HistoryEventDef>

  <IssueDef>
    <defName>RM_CallingPyre</defName>
    <label>calling-pyre</label>
    <iconPath>UI/Icons/Rituals/BurnCircle</iconPath>
  </IssueDef>

  <PreceptDef Name="RM_CallingPyreBeliefBase" Abstract="True">
    <issue>RM_CallingPyre</issue>
    <impact>Medium</impact>
    <requiredMemes>
      <li>Ritualist</li>
      <li MayRequire="VanillaExpanded.VMemesE">VME_FireWorship</li>
    </requiredMemes>
  </PreceptDef>

  <PreceptDef ParentName="RM_CallingPyreBeliefBase">
    <defName>RM_CallingPyre_Forbidden</defName>
    <label>forbidden</label>
    <description>Setting your own fields alight to call the giants down is folly and sacrilege. The calling-pyre may never be held, and believers are shaken when anyone holds it.</description>
    <displayOrderInIssue>30</displayOrderInIssue>
    <comps>
      <li Class="PreceptComp_KnowsMemoryThought">
        <eventDef>RM_CalledTheHerds</eventDef>
        <thought>RM_CalledTheHerds_Know_Forbidden</thought>
      </li>
    </comps>
  </PreceptDef>

  <PreceptDef ParentName="RM_CallingPyreBeliefBase">
    <defName>RM_CallingPyre_LastRite</defName>
    <label>last rite</label>
    <description>The calling-pyre is a last rite, spoken of the way sailors speak of running aground on purpose. It may only be held with enemies on the map, and the herds fall on everyone who remains.</description>
    <displayOrderInIssue>20</displayOrderInIssue>
  </PreceptDef>

  <PreceptDef ParentName="RM_CallingPyreBeliefBase">
    <defName>RM_CallingPyre_Venerated</defName>
    <label>venerated</label>
    <description>To burn your own fields and call the giants is the plain's one true prayer. The calling-pyre may be held at any time, and believers are uplifted whenever it is.</description>
    <displayOrderInIssue>10</displayOrderInIssue>
    <comps>
      <li Class="PreceptComp_KnowsMemoryThought">
        <eventDef>RM_CalledTheHerds</eventDef>
        <thought>RM_CalledTheHerds_Know_Venerated</thought>
      </li>
    </comps>
  </PreceptDef>

  <ThoughtDef>
    <defName>RM_CalledTheHerds_Know_Forbidden</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>the herds were called with fire</label>
        <description>Someone burned the fields to call the giants down. It is folly, and it is sacrilege.</description>
        <baseMoodEffect>-6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>RM_CalledTheHerds_Know_Venerated</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>the herds were called</label>
        <description>The fields burned and the giants came. The plain heard us.</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- The ritual itself. Offered only to the same memes as the belief; the belief decides when it may start. -->
  <PreceptDef>
    <defName>RM_Ritual_CallingPyre</defName>
    <label>calling-pyre</label>
    <description>The colony sets its own fields alight to bring the fire-stamping giants down on everyone who remains, attacker and defender alike. Whether and when it may be held is the calling-pyre belief's to say; without one, it is a last rite.</description>
    <issue>Ritual</issue>
    <impact>Medium</impact>
    <preceptClass>Precept_Ritual</preceptClass>
    <ritualPatternBase>RM_CallingPyre</ritualPatternBase>
    <iconPath>UI/Icons/Rituals/BurnCircle</iconPath>
    <visible>true</visible>
    <countsTowardsPreceptLimit>false</countsTowardsPreceptLimit>
    <selectionWeight>1.0</selectionWeight>
    <requiredMemes>
      <li>Ritualist</li>
      <li MayRequire="VanillaExpanded.VMemesE">VME_FireWorship</li>
    </requiredMemes>
  </PreceptDef>

  <RitualPatternDef>
    <defName>RM_CallingPyre</defName>
    <shortDescOverride>calling-pyre</shortDescOverride>
    <descOverride>Participants gather at a ritual spot and set the colony's own fields alight around it. Every fire-stamping giant on the map comes for the blaze, and a herd walks in from the edge of the map; the worse the rite goes, the more of them come raging at everyone in their path.</descOverride>
    <iconPathOverride>UI/Icons/Rituals/BurnCircle</iconPathOverride>
    <canStartAnytime>true</canStartAnytime>
    <alwaysStartAnytime>true</alwaysStartAnytime>
    <ritualObligationTargetFilter>AnyRitualSpot</ritualObligationTargetFilter>
    <ritualBehavior>RM_CallingPyre</ritualBehavior>
    <ritualOutcomeEffect>RM_CallingPyre</ritualOutcomeEffect>
    <ritualOnlyForIdeoMembers>true</ritualOnlyForIdeoMembers>
    <playsIdeoMusic>false</playsIdeoMusic>
  </RitualPatternDef>

  <RitualBehaviorDef ParentName="DateRitualBehavior">
    <defName>RM_CallingPyre</defName>
    <workerClass>RimMandrake.LeaningScrub.RM_RitualBehaviorWorker_CallingPyre</workerClass>
    <durationTicks>2500</durationTicks>
    <roles Inherit="False"/>
    <spectatorsLabel>Participants</spectatorsLabel>
    <spectatorGerund>participate</spectatorGerund>
    <stages Inherit="False">
      <li>
        <defaultDuty>SpectateSocial</defaultDuty>
        <endTriggers>
          <li Class="StageEndTrigger_DurationPercentage">
            <percentage>1</percentage>
          </li>
        </endTriggers>
      </li>
    </stages>
  </RitualBehaviorDef>

  <RitualOutcomeEffectDef>
    <defName>RM_CallingPyre</defName>
    <description>Depending on ritual quality, participants will get between {MINMOOD} and {MAXMOOD} mood for {MOODDAYS} days. The fields around the ritual spot are set alight and fire-stamping giants come; the worse the outcome, the more of them come raging.</description>
    <workerClass>RimMandrake.LeaningScrub.RM_RitualOutcomeEffectWorker_CallingPyre</workerClass>
    <!-- PROVISIONAL. Without a base the participant count alone caps quality near 0.35, and positive tiers scale with
         quality (RitualOutcomeEffectWorker_FromQuality.ChanceWithQuality): most rites would rage. 0.4 base plus up to
         0.35 from participants lets a well-attended pyre come out Good most of the time. -->
    <startingQuality>0.4</startingQuality>
    <comps>
      <li Class="RitualOutcomeComp_ParticipantCount">
        <label>participant count</label>
        <curve>
          <points>
            <li>(1,  0.0)</li>
            <li>(4,  0.2)</li>
            <li>(8, 0.35)</li>
          </points>
        </curve>
      </li>
    </comps>
    <outcomeChances>
      <li>
        <label>Terrible</label>
        <chance>0.1</chance>
        <memory>RM_CallingPyre_Terrible</memory>
        <description>The {0} went wrong. The whole herd came in raging, and it does not care whose fields these were.</description>
        <positivityIndex>-2</positivityIndex>
      </li>
      <li>
        <label>Poor</label>
        <chance>0.2</chance>
        <memory>RM_CallingPyre_Poor</memory>
        <description>The {0} was ragged. The fire caught thinly and half the herd came in angry.</description>
        <positivityIndex>-1</positivityIndex>
      </li>
      <li>
        <label>Good</label>
        <chance>0.5</chance>
        <memory>RM_CallingPyre_Good</memory>
        <description>The {0} burned true. The herd came for the fire, and few of them came angry.</description>
        <positivityIndex>1</positivityIndex>
      </li>
      <li>
        <label>Great</label>
        <chance>0.2</chance>
        <memory>RM_CallingPyre_Great</memory>
        <description>The {0} roared across the plain. A great herd came, most of them for the fire alone.</description>
        <positivityIndex>2</positivityIndex>
      </li>
    </outcomeChances>
  </RitualOutcomeEffectDef>

  <ThoughtDef Name="RM_CallingPyreMemoryBase" Abstract="True">
    <thoughtClass>Thought_AttendedRitual</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>3</stackLimit>
  </ThoughtDef>

  <ThoughtDef ParentName="RM_CallingPyreMemoryBase">
    <defName>RM_CallingPyre_Terrible</defName>
    <stages>
      <li>
        <label>terrible calling-pyre</label>
        <description>We called the herds and they fell on us. What were we thinking?</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="RM_CallingPyreMemoryBase">
    <defName>RM_CallingPyre_Poor</defName>
    <stages>
      <li>
        <label>poor calling-pyre</label>
        <description>The fire was thin and the giants were angry. It could have gone better.</description>
        <baseMoodEffect>-1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="RM_CallingPyreMemoryBase">
    <defName>RM_CallingPyre_Good</defName>
    <stages>
      <li>
        <label>good calling-pyre</label>
        <description>We lit the fields and the giants answered. The plain listened.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="RM_CallingPyreMemoryBase">
    <defName>RM_CallingPyre_Great</defName>
    <stages>
      <li>
        <label>great calling-pyre</label>
        <description>The whole plain burned and the ground shook with giants. I have never felt so small, or so heard.</description>
        <baseMoodEffect>8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
