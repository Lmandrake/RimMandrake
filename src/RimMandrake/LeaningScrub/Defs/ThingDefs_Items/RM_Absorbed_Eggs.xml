<?xml version="1.0" encoding="utf-8"?>
<!--
  SWB_RM_FAUNA_DECIDE_HOME_LIKE_CHIKKA: the eight Jurassic-donor ports' eggs, moved with their layers; defNames RSW_ -> RM_.
  Owner 2026-10-24: "Yes, it appears that a lot of alpha animal ports got
  classified as Star Wars. We should move all of those."
  Moved here (batch 3) from src/RimStarWars/SWBestiary/Defs/ThingDefs_Items/RSW_Absorbed_Eggs.xml.

  JURASSIC_RETIREMENT_ABSORPTION, 2026-09-05 - ABSORBED CONTENT, DO NOT DELETE.

  Source mod: Jurassic Rimworld - Dinosaurs Only (Continued),
  `Mlie.JurassicRimworldDinosaursOnly`, workshop 3541510004,
  1.6/Defs/ThingDef_Items/Items_Resource_DinosaurEggs.xml.

  These exist because the eight creatures absorbed alongside them are EGG LAYERS.
  Dropping CompProperties_EggLayer would have been the smaller edit and would have
  silently turned every one of them into a live-bearer; absorbing the sixteen egg
  items instead keeps them breeding exactly as they did.

  Changed from the donor: defName prefixed RSW_ and hatcherPawn repointed to the
  RSW_ PawnKindDefs (Defs/ThingDefs_Races/RSW_Absorbed_*.xml). ParentName
  EggFertBase / EggUnfertBase is VANILLA. The three egg textures were pulled from
  the donor's AssetBundle (extract_bundle_textures.py) into this mod's
  Textures/swresource/AbsorbedEggs/. Nothing else was altered - market values,
  hatch days and the vanilla comps are the donor's.
-->
<Defs>
  <ThingDef ParentName="EggUnfertBase">
    <defName>RM_BaseopsisEggUnFertilized</defName>
    <label>Baseopsis egg (unfert.)</label>
    <description>An unfertilized egg. Behind a veil of light the vague shape of a young baseopsis lies curled safely within.</description>
    <graphicData>
      <texPath>Things/Item/Egg/RM_AbsorbedEggs/RM_InsectEgg</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(245,245,245)</color>
    </graphicData>
    <statBases>
      <MarketValue>3.5</MarketValue>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="EggFertBase">
    <defName>RM_BaseopsisEggFertilized</defName>
    <label>Baseopsis egg (fert.)</label>
    <description>A fertilized egg. With enough care and patience, this egg will hatch into a baseopsis.</description>
    <graphicData>
      <texPath>Things/Item/Egg/RM_AbsorbedEggs/RM_InsectEgg</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(245,245,245)</color>
    </graphicData>
    <statBases>
      <MarketValue>7.0</MarketValue>
    </statBases>
    <comps>
      <li Class="CompProperties_Hatcher">
        <hatcherDaystoHatch>3</hatcherDaystoHatch>
        <hatcherPawn>RM_Baseopsis</hatcherPawn>
      </li>
    </comps>
  </ThingDef>

