<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_SmotherCraft.xml             LEANINGSCRUB_MECHANICS_BUILD_1 part 4 (the smother-craft)

  "Locals kill a thicket by throwing blankets over it - starving it of light -
  then burn it after it desiccates for years. The blanket-weave is a trade good;
  a blanketed thicket is a banked claim; and dead venomvine is the finest fuel in
  the region." (arid_shrubland.md, frozen sheet)

    RM_FuzzFiber         harvest of RM_Fuzz (RM_Fuzz.xml now names it).
    RM_SmotherBlanket    woven at a tailor bench from fuzz fiber + sweetline felt
                         (RM_SweetlineWool, the sweetline-snag harvest).
    RM_DeadVenomvine     what a smothered stand leaves when its claim matures.
                         Burns wherever wood burns (Patches/RM_DeadVenomvine_Fuel.xml).
    RM_SmotherVenomvine  the job: carry a blanket to a stand and throw it over.
                         Ordered by right-click (RM_FloatMenuOptionProvider_Smother).

  The claim itself (timer, inspect-string countdown, maturation) is C#:
  Source/RM_SmotherCraft.cs. Every venomvine form carries RM_CompProperties_Smotherable.

  Art: no renders exist for these three items. Each borrows a vanilla stack
  texture tinted to its material (Cloth / WoodLog) so nothing shows the
  missing-texture placeholder; bespoke art is a follow-on.
-->
<Defs>

  <ThingDef ParentName="ResourceBase">
    <defName>RM_FuzzFiber</defName>
    <label>fuzz fiber</label>
    <description>Fine silver-green fronds combed from the fuzz and twisted into loose hanks. Too short and slick to spin into good cloth on its own, but felted with something coarser it makes a dense, light-proof weave.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Cloth</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(150,168,140)</color>
    </graphicData>
    <statBases>
      <MarketValue>0.6</MarketValue>
      <Mass>0.02</Mass>
      <Flammability>1</Flammability>
      <DeteriorationRate>2</DeteriorationRate>
    </statBases>
    <stackLimit>150</stackLimit>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>RM_SmotherBlanket</defName>
    <label>smother-blanket</label>
    <description>A heavy cloth of fuzz fiber and sweetline felt, woven so tight no light passes. Thrown over a venomvine stand it starves the plant of light for seasons, until what is left is dead wood. A trade good all across the plain.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Cloth</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(70,72,64)</color>
    </graphicData>
    <statBases>
      <MarketValue>90</MarketValue>
      <Mass>3</Mass>
      <Flammability>0.6</Flammability>
      <DeteriorationRate>1</DeteriorationRate>
    </statBases>
    <stackLimit>10</stackLimit>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <tradeTags>
      <li>ExoticMisc</li>
    </tradeTags>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>RM_DeadVenomvine</defName>
    <label>dead venomvine</label>
    <description>Cane from a venomvine stand smothered until it died - wood that spent its life refusing to burn and, dry at last, burns long and hot. The finest fuel on the plain, and years in the making.</description>
    <graphicData>
      <texPath>Things/Item/Resource/WoodLog</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(60,52,48)</color>
    </graphicData>
    <soundInteract>Wood_Drop</soundInteract>
    <soundDrop>Wood_Drop</soundDrop>
    <statBases>
      <MarketValue>3.5</MarketValue>
      <Mass>0.3</Mass>
      <Flammability>1</Flammability>
      <DeteriorationRate>0.3</DeteriorationRate>
    </statBases>
    <stackLimit>75</stackLimit>
    <burnableByRecipe>true</burnableByRecipe>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
  </ThingDef>

  <RecipeDef>
    <defName>RM_Make_SmotherBlanket</defName>
    <label>weave smother-blanket</label>
    <description>Felt fuzz fiber and sweetline felt into a light-proof smother-blanket.</description>
    <jobString>Weaving a smother-blanket.</jobString>
    <workAmount>2400</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>Tailor</effectWorking>
    <soundWorking>Recipe_Tailor</soundWorking>
    <recipeUsers>
      <li>HandTailoringBench</li>
      <li>ElectricTailoringBench</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>RM_FuzzFiber</li>
          </thingDefs>
        </filter>
        <count>40</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>RM_SweetlineWool</li>
          </thingDefs>
        </filter>
        <count>15</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>RM_FuzzFiber</li>
        <li>RM_SweetlineWool</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <RM_SmotherBlanket>1</RM_SmotherBlanket>
    </products>
  </RecipeDef>

  <JobDef>
    <defName>RM_SmotherVenomvine</defName>
    <driverClass>RimMandrake.LeaningScrub.RM_JobDriver_SmotherVenomvine</driverClass>
    <reportString>smothering TargetA.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

</Defs>
