<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_SweetlineTree_Items.xml                 LEANINGSCRUB_RM_MOD_BUILD_1

  Renamed from src/RimUtinni/AshkarrFlora/Defs/ThingDefs_Items/
  RUT_SweetlineTree_Items.xml per §7 Q8, riding with RM_SweetlineTree.
  Byte-identical content (defName and texPath aside) — see that file's own
  header for the full account (SWEETLINE_WOOL_HARVEST_1).

  🔑 The ORIGINAL RUT_SweetlineWool def is left standing in
  mandrake.rut.ashkarrflora, untouched, for the same reason as the rest of
  this mod's moved content — see RM_LeaningScrub_Biome.xml's own header.

  Art: the felt is artpipe rut_sweetlinewool_v2 (wired 2026-10-03); the
  pilgrim's token still has no render.
-->
<Defs>

  <ThingDef ParentName="WoolBase">
    <defName>RM_SweetlineWool</defName>
    <label>sweetline felt</label>
    <description>The coats of every woolly beast that scratches against a sweetline tree, matted and cured in the bark's resin into a dense, soft, silver-grey felt. Warmer than fleece and softer against the skin than anything sheared. A grown tree lets a little go on its own; the rest comes out only when someone strips the bark, under the bark-wardens.</description>
    <graphicData>
      <texPath>Things/Item/Resource/RM_SweetlineWool</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>5.5</MarketValue>
      <StuffPower_Armor_Sharp>0.42</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Heat>1.3</StuffPower_Armor_Heat>
      <StuffPower_Insulation_Cold>36</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>14</StuffPower_Insulation_Heat>
    </statBases>
    <stuffProps>
      <color>(196,193,186)</color>
      <commonality>0.04</commonality>
    </stuffProps>
    <!-- SWEETLINE_FELT_COMFORT_BUILD_1: +0.10 Comfort on furniture of it, +2 mood worn (spec §5). -->
    <modExtensions>
      <li Class="RimMandrake.LeaningScrub.RM_StuffComfortExtension">
        <comfortOffset>0.10</comfortOffset>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- LEANINGSCRUB_SWEETLINE_VISITORS_1: what pilgrims leave at a sweetline tree.
       Art: none exists (artpipe searched 2026-10-03); placeholder until generated. -->
  <ThingDef ParentName="ResourceBase">
    <defName>RM_SweetlineToken</defName>
    <label>pilgrim's token</label>
    <description>A knot of braided silver-grey wool with a bead or a pebble tied in, left at the foot of a sweetline tree by someone walking the tree-roads. It means nothing to the tree. It means a good deal to whoever left it, and a little to whoever finds it.</description>
    <graphicData>
      <texPath>Things/Item/Resource/RM_SweetlineToken</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>3</MarketValue>
      <Mass>0.02</Mass>
      <Flammability>1.0</Flammability>
    </statBases>
    <stackLimit>20</stackLimit>
  </ThingDef>

</Defs>
