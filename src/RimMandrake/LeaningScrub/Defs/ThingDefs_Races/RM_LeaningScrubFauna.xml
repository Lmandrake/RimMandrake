  <!-- Real flight via MaxFlightTime/FlightCooldown (Locust shape). No flight frames (never blocked on frames). Stall-keyed hunting is LEANINGSCRUB_MECHANICS_BUILD_1. -->
  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Zellik</defName>
    <label>zellik</label>
    <description>A hunched aerial predator whose folded membranes resemble a battered umbrella. It roosts on sweetline branches and turbine heads, unable to distinguish movement beneath the wind-tossed fuzz. During a Stall, it hunts the ripples that footsteps make in the still canopy and drops onto prey below.</description>
    <statBases>
      <MoveSpeed>4.0</MoveSpeed>
      <Mass>8</Mass>
      <Flammability>0.4</Flammability>
      <MeatAmount>20</MeatAmount>
      <LeatherAmount>0</LeatherAmount>
      <ComfyTemperatureMin>-25</ComfyTemperatureMin>
      <ComfyTemperatureMax>48</ComfyTemperatureMax>
      <Wildness>0.8</Wildness>
      <MaxFlightTime>10</MaxFlightTime>
      <FlightCooldown>5</FlightCooldown>
    </statBases>
    <tools>
      <li>
        <label>talons</label>
        <capacities><li>Scratch</li></capacities>
        <power>7</power>
        <cooldownTime>1.8</cooldownTime>
        <linkedBodyPartsGroup>Feet</linkedBodyPartsGroup>
      </li>
      <li>
        <label>beak</label>
        <capacities><li>Bite</li></capacities>
        <power>8</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>Beak</linkedBodyPartsGroup>
      </li>
    </tools>
    <race>
      <body>Bird</body>
      <bloodDef>Filth_Blood</bloodDef>
      <bloodSmearDef>Filth_BloodSmear</bloodSmearDef>
      <hediffGiverSets><li>OrganicStandard</li></hediffGiverSets>
      <baseBodySize>0.9</baseBodySize>
      <baseHealthScale>0.6</baseHealthScale>
      <baseHungerRate>0.35</baseHungerRate>
      <foodType>CarnivoreAnimal</foodType>
      <predator>true</predator>
      <trainability>Intermediate</trainability>
      <lifeExpectancy>15</lifeExpectancy>
      <manhunterOnDamageChance>0.05</manhunterOnDamageChance>
      <flightStartChanceOnJobStart>0.1</flightStartChanceOnJobStart>
      <flightSpeedFactor>2.5</flightSpeedFactor>
      <canFlyIntoMap>true</canFlyIntoMap>
      <canLeaveMapFlying>true</canLeaveMapFlying>
      <lifeStageAges>
        <li><def>AnimalBaby</def><minAge>0</minAge></li>
        <li><def>AnimalJuvenile</def><minAge>0.2</minAge></li>
        <li><def>AnimalAdult</def><minAge>0.4</minAge></li>
      </lifeStageAges>
    </race>
    <tradeTags>
      <li>AnimalUncommon</li>
    </tradeTags>
