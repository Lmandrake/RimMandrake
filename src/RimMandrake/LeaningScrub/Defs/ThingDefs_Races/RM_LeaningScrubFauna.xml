<!--
  RM_LeaningScrubFauna.xml                   LEANINGSCRUB_RULED_CONTENT_1

  The Leaning Scrub's ruled cast: 4 fills (fuzzrunner, thornhold, shokka,
  zellik) + 9 menagerie (fuzzviper, surrik, ribbonwhip, vissler, dustflutter,
  shirrel, crustweevil, rollbug, tikkit). Descriptions are the cast bible's
  (design/Jawa/worldbuilding/biomes/leaningscrub_bedazzle_cast_2026-09-29.md),
  ecological voice, no warning-instrument framing (owner trim law).

  Numbers are design proposals; FOUNDRY calibrates. No C# is added here:
  bespoke behaviour (wind, ambush, lure, glide, denning) is
  LEANINGSCRUB_MECHANICS_BUILD_1's and is marked STUB per def below.

  Art: every animal's east/north/south renders are wired under
  Textures/Things/Pawn/Animal/RM_<Name>/ (LEANINGSCRUB_ART_WIRING_1). Zellik
  and Dustflutter have no flying flip-book frames yet; they fly with the
  grounded sprite.

  One home each (owner law 2026-09-21): every species here is wired into
  RM_LeaningScrub and nowhere else.
-->
<Defs>

  <!-- Herd prey base of the biome; tameable herbivore. No bespoke behaviour owed. -->
  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Fuzzrunner</defName>
    <label>fuzzrunner</label>
    <description>Nothing on the plain is more common and nothing is harder to see. A fuzzrunner is born, fed, bred and dead without once standing in open light - its whole nation lives in the worn runs under the canopy, navigated by smell and whisker, walls of stems polished by ten thousand shoulders before it. It is round with fog-fat against the lean days, and when the wind falters it stops mid-stride and becomes a stone until the canopy moves again. Dig where the runs cross and you can live here. The locals do.</description>
    <statBases>
      <MoveSpeed>5.2</MoveSpeed>
      <Mass>2.0</Mass>
      <Flammability>0.4</Flammability>
      <MeatAmount>12</MeatAmount>
      <LeatherAmount>0</LeatherAmount>
      <ComfyTemperatureMin>-25</ComfyTemperatureMin>
      <ComfyTemperatureMax>45</ComfyTemperatureMax>
      <Wildness>0.6</Wildness>
    </statBases>
    <tools>
      <li>
        <label>teeth</label>
        <capacities><li>Bite</li></capacities>
        <power>2</power>
        <cooldownTime>1.6</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
      </li>
      <li>
        <label>head</label>
        <capacities><li>Blunt</li></capacities>
        <power>1.5</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
      </li>
    </tools>
    <race>
      <body>QuadrupedAnimalWithPaws</body>
      <bloodDef>Filth_Blood</bloodDef>
      <bloodSmearDef>Filth_BloodSmear</bloodSmearDef>
      <hediffGiverSets><li>OrganicStandard</li></hediffGiverSets>
      <baseBodySize>0.2</baseBodySize>
      <baseHealthScale>0.35</baseHealthScale>
      <baseHungerRate>0.2</baseHungerRate>
      <foodType>VegetarianRoughAnimal</foodType>
      <predator>false</predator>
      <trainability>Intermediate</trainability>
      <lifeExpectancy>7</lifeExpectancy>
      <manhunterOnDamageChance>0.05</manhunterOnDamageChance>
      <lifeStageAges>
        <li><def>AnimalBaby</def><minAge>0</minAge></li>
        <li><def>AnimalJuvenile</def><minAge>0.2</minAge></li>
        <li><def>AnimalAdult</def><minAge>0.4</minAge></li>
      </lifeStageAges>
    </race>
    <tradeTags>
      <li>AnimalCommon</li>
    </tradeTags>
    <modExtensions>
      <!-- LEANINGSCRUB_GPT_ENRICHMENT_1 runway bloom (Source/RM_RunwayBloom.cs). TUNED: half a second later the stem-tunnel floor bolts, further. -->
      <li Class="RimMandrake.LeaningScrub.RM_RunwayBloomExtension">
        <response>Bolt</response>
        <delayTicks>30</delayTicks>
        <fleeDistance>20</fleeDistance>
      </li>
    </modExtensions>
  </ThingDef>

