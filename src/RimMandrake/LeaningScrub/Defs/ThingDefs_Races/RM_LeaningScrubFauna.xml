  <!-- Real flight via MaxFlightTime/FlightCooldown (Locust shape). No flight frames (never blocked on frames). Stall-keyed hunting is LEANINGSCRUB_MECHANICS_BUILD_1. -->
  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Zellik</defName>
    <label>zellik</label>
    <description>On an ordinary day the zellik sits hunched on a sweetline bough or a turbine head and looks like a folded umbrella nobody wants. The wind that feeds everything else starves it: a shivering canopy tells it nothing. Then a cyclone far over the horizon swallows the Hadley flow, the wind dies, the plain goes still - and the zellik goes up. Over a stalled canopy every footfall underneath is a ring on a pond, and it drops through the roof onto things that believed, until that hour, that the roof was theirs.</description>
    <statBases>
      <MoveSpeed>4.0</MoveSpeed>
      <Mass>8</Mass>
      <Flammability>0.4</Flammability>
      <MeatAmount>20</MeatAmount>
      <LeatherAmount>0</LeatherAmount>
      <ComfyTemperatureMin>-25</ComfyTemperatureMin>
      <ComfyTemperatureMax>48</ComfyTemperatureMax>
      <Wildness>0.8</Wildness>
      <MaxFlightTime>10</MaxFlightTime>
      <FlightCooldown>5</FlightCooldown>
    </statBases>
    <tools>
      <li>
        <label>talons</label>
        <capacities><li>Scratch</li></capacities>
        <power>7</power>
        <cooldownTime>1.8</cooldownTime>
        <linkedBodyPartsGroup>Feet</linkedBodyPartsGroup>
      </li>
      <li>
        <label>beak</label>
        <capacities><li>Bite</li></capacities>
        <power>8</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>Beak</linkedBodyPartsGroup>
      </li>
    </tools>
    <race>
