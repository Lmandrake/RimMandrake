<?xml version="1.0" encoding="utf-8"?>
<!--
  WASTELAND_RM_MOD_BUILD_1. Generic sibling of a frozen campaign world's own
  biome instance (RUT_Wasteland, src/RimUtinni) — same fictional idea (a
  bone-dry, radiologically-live wasteland where nothing recycles), rebuilt
  with zero campaign-specific content so it can generate on any player's own
  world. Content copied from RUT_Wasteland.xml's own values (188-line def,
  measured 2026-09-23) with three changes:
    1. workerClass is this mod's own RM_BiomeWorker_Wasteland, never the
       donor's BiomesPlus.BiomeWorker_Wasteland.
    2. Every RSW_/SW_/mlie-prefixed row (Q12) and VAEWaste_Megatardi (whose
       ThingDef only ships inside src/RimUtinni's own "Absorbed" folder, so
       it would dangle a cross-reference on a standalone load despite
       carrying no RSW_/SW_/RUT_ prefix) is OUT of wildAnimals here and rides
       src/RimUtinni/UtinniPatches/Patches/WildAnimals_Wasteland.xml instead.
    3. Three fauna rows the owner's round-2 eviction mapping already moved
       elsewhere (AA_Eyeling, SW_Electrictick, AA_AcanthamoebaGiganteaSmall —
       all "move:*" in the roster, never executed in the defs) are dropped
       here rather than carried forward stale.

  terrainsByFertility uses this mod's own RM_WastelandAshySoil / RM_WastelandBrokenAsphalt
  (Defs/TerrainDefs/RM_Wasteland_GroundTerrains.xml), which replaced Advanced Biomes'
  VolcanoSoil / WastelandAsphalt on 2026-10-19 so the biome generates with that mod absent.

  ⭐ WASTELAND_RULED_CONTENT_1 (2026-09-29) superseded the wildAnimals/
  wildPlants rosters described above: every donor row named in points 1-3
  is now an owned RM_ port (see the wildAnimals/wildPlants blocks' own
  comments below for the current, live roster and its provenance).
-->
<Defs>

  <BiomeDef>
    <defName>RM_Wasteland</defName>
    <generatesNaturally>false</generatesNaturally>
    <label>the Wastes</label>
    <description>Where rivers die, everything they carried is concentrated into salt and brine; where the sky's exhaust falls, nothing ever washes it away. Nothing here recycles -- water doesn't leave, fallout doesn't wash, history doesn't decay. The wildlife is wretched and mutated as the rule, extremophile-odd as the exception; the danger is the ground, the air and the water, never the creatures. They merely adapt, struggle, and mostly fail.</description>
    <workerClass>RimMandrake.Wasteland.RM_BiomeWorker_Wasteland</workerClass>
    <texture>World/Biomes/RM_Wasteland</texture>
    <lakeBeachTerrain>Gravel</lakeBeachTerrain>
    <mudTerrain>MarshyTerrain</mudTerrain>
    <riverbankTerrain>MarshyTerrain</riverbankTerrain>
    <waterShallowTerrain MayRequire="Ludeon.RimWorld.Odyssey">RM_WastelandBrineShallow</waterShallowTerrain>
    <waterDeepTerrain MayRequire="Ludeon.RimWorld.Odyssey">RM_WastelandBrineDeep</waterDeepTerrain>
    <waterMovingShallowTerrain MayRequire="Ludeon.RimWorld.Odyssey">RM_WastelandBrineMovingShallow</waterMovingShallowTerrain>
    <waterMovingChestDeepTerrain MayRequire="Ludeon.RimWorld.Odyssey">RM_WastelandBrineMovingChestDeep</waterMovingChestDeepTerrain>
    <foragedFood>RawBerries</foragedFood>
    <allowRoads>true</allowRoads>
    <allowRivers>true</allowRivers>
    <allowFarmingCamps>true</allowFarmingCamps>
    <animalDensity>0.1</animalDensity>
    <plantDensity>0.12</plantDensity>
    <forageability>1.0</forageability>
    <movementDifficulty>2</movementDifficulty>
    <diseaseMtbDays>90</diseaseMtbDays>

    <modExtensions>
      <li Class="RimMandrake.Wasteland.RM_WastelandBiomeRanges">
        <temperature>-35~30</temperature>
        <rainfall>0~500</rainfall>
        <elevation>0~600</elevation>
        <baseScore>28</baseScore>
        <degreeWeight>1.0</degreeWeight>
        <rainfallDivisor>150</rainfallDivisor>
      </li>
      <!-- WASTELAND_MECHANICS_BUILD_1: opts this biome's maps into the storm
           layer (RM_MapComponent_WastelandStorms returns at once on any map
           whose biome lacks this). -->
      <li Class="RimMandrake.Wasteland.RM_WastelandStormBiomeExtension" />
    </modExtensions>

    <diseases>
      <li>
        <diseaseInc>Disease_Flu</diseaseInc>
        <commonality>100</commonality>
      </li>
      <li>
        <diseaseInc>Disease_Plague</diseaseInc>
        <commonality>80</commonality>
      </li>
      <li>
        <diseaseInc>Disease_FibrousMechanites</diseaseInc>
        <commonality>30</commonality>
      </li>
      <li>
        <diseaseInc>Disease_SensoryMechanites</diseaseInc>
        <commonality>30</commonality>
      </li>
      <li>
        <diseaseInc>Disease_GutWorms</diseaseInc>
        <commonality>40</commonality>
      </li>
      <li>
        <diseaseInc>Disease_MuscleParasites</diseaseInc>
        <commonality>40</commonality>
      </li>
    </diseases>

    <terrainsByFertility>
      <li>
        <terrain>RM_WastelandAshySoil</terrain>
        <min>-999</min>
        <max>0.5</max>
      </li>
      <li>
        <terrain>RM_WastelandBrokenAsphalt</terrain>
        <min>0.5</min>
        <max>999</max>
      </li>
    </terrainsByFertility>

    <baseWeatherCommonalities>
      <Clear>30</Clear>
      <DryThunderstorm>1</DryThunderstorm>
      <SnowGentle>0</SnowGentle>  <!-- owner 2026-10-16: "Sump, Wasteland, and Flooded Canyon should NOT be snowing! No precipitation" -->
      <SnowHard>0</SnowHard>  <!-- owner 2026-10-16: "Sump, Wasteland, and Flooded Canyon should NOT be snowing! No precipitation" -->
      <GrayPall MayRequire="Ludeon.RimWorld.Anomaly">1</GrayPall>
      <ToxRain MayRequire="Ludeon.RimWorld.Biotech">0</ToxRain>  <!-- owner 2026-09-30 by question card: no rain of any kind here, toxic included -->
      <Rain>0</Rain>
      <RainyThunderstorm>0</RainyThunderstorm>
      <!-- WASTELAND_MECHANICS_BUILD_1 §4 (wasteland.md §4b): ash storms and
           deadlight halos (RM_WastelandRadiationHalo) everywhere in the biome.
           RM_WastelandPlasmaStorm (the cinderwire storm) is
           deliberately NOT listed — terminator families only (§6 ban 7), and
           that gate is still an owed design call. -->
      <RM_WastelandAshStorm>3</RM_WastelandAshStorm>
      <RM_WastelandRadiationHalo>2</RM_WastelandRadiationHalo>
    </baseWeatherCommonalities>

    <!-- WASTELAND_RULED_CONTENT_1 — full RM_ donor replacement (cast bible
         wasteland_survivor_cast_2026-09-28.md §7). Every donor row above is
         REPLACED outright by an owned RM_ port at the same commonality;
         Toxalope (vanilla Biotech) is dropped in favor of RM_Boilhide
         without touching the vanilla def itself. Names follow the owner's
         2026-09-29 art-sheet renames: RM_Scumrat -> RM_Scumslider,
         RM_Middenbeetle -> RM_Gripper (Transient/bedazzle_art_sheets_2026-
         09-28/wasteland/sheet.decisions.json). Zero donor MayRequire
         references remain in this roster. Shorthand element form only
         (BiomeAnimalRecord's custom loader reads node NAME as the def and
         node TEXT as commonality — a `<li>` here silently discards the def).
         The RUT_ twin's own patch-added campaign roster
         (UtinniPatches/Patches/WildAnimals_Wasteland.xml) is untouched;
         not this pass's scope. -->
    <!-- SALVAGE_WRECKAGE_EVERYWHERE_1: the wreck field (Wreckage engine). -->
    <extraGenSteps>
      <li>RM_WreckField_Wasteland</li>
    </extraGenSteps>
    <wildAnimals>
      <RM_Scumslider>0.7</RM_Scumslider>  <!-- port of GR_ParagonRat, renamed from Scumrat -->
      <RM_Gripper>0.7</RM_Gripper>  <!-- port of GR_Beetlefleet, renamed from Middenbeetle -->
      <RM_Gristleswarm>0.6</RM_Gristleswarm>  <!-- port of VFEI2_Swarmling -->
      <RM_SootGristleswarm>0.6</RM_SootGristleswarm>  <!-- port of VFEI2_BlackSwarmling -->
      <RM_Boilhide>0.4</RM_Boilhide>  <!-- port of vanilla Toxalope -->
      <RM_Slagmole>0.4</RM_Slagmole>  <!-- port of GR_Molebear -->
      <RM_Scabspinner>0.4</RM_Scabspinner>  <!-- port of GR_Spidercat -->
      <RM_Sloghog>0.3</RM_Sloghog>  <!-- new: ranchable excretor -->
      <RM_Sootgrazer>0.25</RM_Sootgrazer>  <!-- new: ash-eating processor -->
      <RM_Gravelgut>0.2</RM_Gravelgut>  <!-- port of AA_Terramorph -->
      <RM_Grimewing>0.15</RM_Grimewing>  <!-- new: flyer niche, ruled in 2026-09-28 -->
      <RM_Smolderback>0.05</RM_Smolderback>  <!-- new: radiothermal solitary, rare -->
      <!-- Wasteland sheet 2026-10-09 (owner): RSW_FleeceSpider "Redo Name and Description. RimMandrake tier, NOt star wars at all." and RSW_Maligoat "RimMandrake tier, NOT Star Wars. Never was." Ported to RM_Frethik / RM_Kroffa (Defs/ThingDefs_Races/), weights carried over from UtinniPatches' WildAnimals_Wasteland.xml. -->
      <RM_Frethik>0.7</RM_Frethik>  <!-- frethik - wretched-small; salt-haired mite, pet -->
      <RM_Kroffa>0.4</RM_Kroffa>  <!-- kroffa - wretched-herd; plated milk-grazer -->
    </wildAnimals>
    <coastalWildAnimals />

    <wildPlants>
      <RM_Scumgrass>1.2</RM_Scumgrass>  <!-- port of RG_Plant_ToxiGrass -->
      <RM_TallScumgrass>0.8</RM_TallScumgrass>  <!-- port of RG_Plant_TallToxiGrass -->
      <!-- Plant_GrayGrass / Plant_Toxipotato / Plant_TreePolux CUT from this roster: owner 2026-10-19 by card ("Cut them as the card said": the eight vanilla/DLC rows), item REGEN_GAPS_DECIDE_STRAYS_AND_FLYERS. -->
      <RM_WastelandScorchedStars>0.3</RM_WastelandScorchedStars>  <!-- scorched stars — this mod's own duplicate of RUT_ScorchedStars, per §7 Q13 (DUPLICATE, THEN DIVERGE); see RM_WastelandFlora.xml -->
      <RM_Pusberry>0.2</RM_Pusberry>  <!-- port of AB_WeepingToxberry -->
      <RM_DosimeterLawn>0.15</RM_DosimeterLawn>  <!-- dosimeter lawn - radiotroph flora, unchanged -->
      <RM_Boilbulb>0.1</RM_Boilbulb>  <!-- port of AB_ToxiBulb -->
      <RM_VaultRoot>0.08</RM_VaultRoot>  <!-- vault-root tree - sequestration tree, unchanged -->
      <RM_Wartshrub>0.08</RM_Wartshrub>  <!-- port of VRE_PoluxBush -->
      <RM_Cinderfelt>0.02</RM_Cinderfelt>  <!-- new: fresh-ash-fall marker mat; mainly germinated by the ash storm (RM_MapComponent_WastelandStorms, WASTELAND_MECHANICS_BUILD_1); this token row stays so it also shows when storm germination is toggled off, per cast bible §6 -->
    </wildPlants>
    <wildPlantRegrowDays>15</wildPlantRegrowDays>
  </BiomeDef>

</Defs>
