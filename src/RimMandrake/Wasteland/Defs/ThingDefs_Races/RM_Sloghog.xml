<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_Sloghog.xml                          RimMandrake: Wasteland

  WASTELAND_RULED_CONTENT_1 — new species, the ranchable excretor
  (commonality 0.3). Art-sheet ruling (2026-09-29, "improve"): "Too terran.
  Make it more alien." Shipped art is the v2 regen answering that
  (infrastructure/artpipe/_artsrc/RM_Sloghog_v2_*).

  Authority: cast bible §3. Behavior/mechanic (CompHasGatherableBodyResource
  subclass gated on polluted terrain, producing RM_ContaminantBezoar) is
  WASTELAND_MECHANICS_BUILD_1's scope; that item wired the comp below. Item
  RM_ContaminantBezoar itself IS this item's scope (§4) and ships alongside.
-->
<Defs>

  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Sloghog</defName>
    <label>sloghog</label>
    <description>A warty, barrel-bodied hog that grazes poisoned ground with total contentment and periodically coughs up the poison as a stone worth selling. Wart fields down both flanks, tusks capped in mineral crust, content half-shut eyes. A kept herd is a slow refinery — the closest thing this ground has to livestock.</description>
    <statBases>
      <MoveSpeed>3.4</MoveSpeed>
      <Mass>90</Mass>
      <MeatAmount>0</MeatAmount>
      <LeatherAmount>0</LeatherAmount>
      <ToxicEnvironmentResistance>1</ToxicEnvironmentResistance>
      <ComfyTemperatureMin>-20</ComfyTemperatureMin>
      <ComfyTemperatureMax>45</ComfyTemperatureMax>
      <Wildness>0.35</Wildness>
    </statBases>
    <tools>
      <li>
        <label>tusk</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>6</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
      </li>
    </tools>
    <race>
      <body>QuadrupedAnimalWithHoovesAndTusks</body>
      <bloodDef>Filth_Blood</bloodDef>
      <bloodSmearDef>Filth_BloodSmear</bloodSmearDef>
      <baseBodySize>1.2</baseBodySize>
      <baseHealthScale>0.9</baseHealthScale>
      <baseHungerRate>0.4</baseHungerRate>
      <foodType>VegetarianRoughAnimal</foodType>
      <predator>false</predator>
      <herdAnimal>true</herdAnimal>
      <trainability>Advanced</trainability>
      <lifeExpectancy>10</lifeExpectancy>
      <manhunterOnDamageChance>0.05</manhunterOnDamageChance>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.2</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.4</minAge>
        </li>
      </lifeStageAges>
    </race>
    <tradeTags>
      <li>AnimalFarm</li>
    </tradeTags>
    <!-- WASTELAND_MECHANICS_BUILD_1 §2: the processor comp (a CompMilkable
         subclass, collected by the vanilla milking job). Full rate on
         polluted/toxic ground, 35% off it; occasionally un-pollutes the cell
         it stands on. Toggles in Mod Settings. -->
    <comps>
      <li Class="RimMandrake.Wasteland.RM_CompProperties_ProcessorGatherable">
        <milkDef>RM_ContaminantBezoar</milkDef>
        <milkIntervalDays>5</milkIntervalDays>
        <milkAmount>1</milkAmount>
        <milkFemaleOnly>false</milkFemaleOnly>
        <offFeedRateFactor>0.35</offFeedRateFactor>
        <feedsOnPollution>true</feedsOnPollution>
        <unpolluteChancePerDay>0.25</unpolluteChancePerDay>
        <fullnessLabel>Bezoar growth</fullnessLabel>
      </li>
    </comps>
  </ThingDef>
  <PawnKindDef ParentName="AnimalKindBase">
    <defName>RM_Sloghog</defName>
    <label>sloghog</label>
    <race>RM_Sloghog</race>
    <combatPower>18</combatPower>
    <wildGroupSize>2~5</wildGroupSize>
    <ecoSystemWeight>0.7</ecoSystemWeight>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/RM_Sloghog/RM_Sloghog</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>0.7</drawSize>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/RM_Sloghog/RM_Sloghog</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>0.85</drawSize>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/RM_Sloghog/RM_Sloghog</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.0</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>

</Defs>
