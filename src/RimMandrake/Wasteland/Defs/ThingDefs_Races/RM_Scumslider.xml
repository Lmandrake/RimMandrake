<!--
  RM_Scumslider.xml                       RimMandrake: Wasteland

  WASTELAND_RULED_CONTENT_1 — full RM_ port of the donor GR_ParagonRat row
  (commonality 0.7), redesigned per the owner's 2026-09-29 art-sheet ruling
  (Transient/bedazzle_art_sheets_2026-09-28/wasteland/sheet.decisions.json,
  RM_Scumrat entry): "Too terran. Make it more alien. How about a Scumslider?
  An oozing beast like a slug with two tails that it uses to lurch forward.
  Three eyes on stalks watching in all directions with eyes that are a cross
  between silly googly eyes and a horror-film's stare." Ships under the new
  name outright — RM_Scumrat never shipped, so there is nothing to rename in
  the roster, only to replace the donor row with.

  Authority: design/Jawa/worldbuilding/biomes/wasteland_survivor_cast_2026-09-28.md
  §2 (stats sketch, register). Register: survivor, not sufferer — this is the
  rat that made the dump its estate and is doing fine.

  Body/race shape: ordinary custom-wildlife idiom already used across this
  repo (RM_ContagionFauna.xml, RM_BlueDesertFauna.xml) — ParentName
  AnimalThingBase, vanilla BodyDef reused for melee/health-part attachment
  only, no anatomical claim beyond that (QuadrupedAnimalWithPawsAndTail
  stands in for the two-tailed slug-lurch body; the art alone carries the
  actual silhouette).

  Art: REAL, not placeholder — infrastructure/artpipe/_artsrc/RM_Scumslider_*
  already held finished, validated 3-facing 256x256 art under the FINAL
  renamed defName (generated post-rename, per the sheet review), copied into
  this mod's own Textures/Things/Pawn/Animal/RM_Scumslider/ this pass.
-->
<Defs>

  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Scumslider</defName>
    <label>scumslider</label>
    <description>An oozing slug-bodied thing that lurches forward on two stout tails, three eyes on independent stalks watching every direction at once. It is fat on what nothing else will touch — wart-clustered, salt-stained, mineral-streaked down the flanks — and doing fine on ground that kills cleaner things.</description>
    <statBases>
      <MoveSpeed>4.4</MoveSpeed>
      <Mass>12</Mass>
      <MeatAmount>0</MeatAmount>
      <LeatherAmount>0</LeatherAmount>
      <ComfyTemperatureMin>-20</ComfyTemperatureMin>
      <ComfyTemperatureMax>45</ComfyTemperatureMax>
      <Wildness>0.5</Wildness>
    </statBases>
    <tools>
      <li>
        <label>bite</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>4</power>
        <cooldownTime>1.8</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
      </li>
    </tools>
    <race>
      <body>QuadrupedAnimalWithPawsAndTail</body>
      <bloodDef>Filth_Slime</bloodDef>
      <baseBodySize>0.35</baseBodySize>
      <baseHealthScale>0.4</baseHealthScale>
      <baseHungerRate>0.3</baseHungerRate>
      <foodType>OmnivoreRoughAnimal</foodType>
      <predator>false</predator>
      <trainability>None</trainability>
      <lifeExpectancy>3</lifeExpectancy>
      <manhunterOnDamageChance>0.05</manhunterOnDamageChance>
      <litterSizeCurve>
        <points>
          <li>(3, 0)</li>
          <li>(4, 1)</li>
          <li>(6, 1)</li>
          <li>(7, 0)</li>
        </points>
      </litterSizeCurve>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.2</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.4</minAge>
        </li>
      </lifeStageAges>
    </race>
    <tradeTags>
      <li>AnimalUncommon</li>
    </tradeTags>
  </ThingDef>
  <PawnKindDef ParentName="AnimalKindBase">
    <defName>RM_Scumslider</defName>
    <label>scumslider</label>
    <race>RM_Scumslider</race>
    <combatPower>12</combatPower>
    <wildGroupSize>1~3</wildGroupSize>
    <ecoSystemWeight>1.4</ecoSystemWeight>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/RM_Scumslider/RM_Scumslider</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>0.45</drawSize>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/RM_Scumslider/RM_Scumslider</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>0.55</drawSize>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/RM_Scumslider/RM_Scumslider</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>0.65</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>

</Defs>
