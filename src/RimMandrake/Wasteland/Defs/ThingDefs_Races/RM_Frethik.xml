  <ThingDef ParentName="EggUnfertBase">
    <defName>RM_EggFrethikUnfertilized</defName>
    <label>frethik egg (unfert.)</label>
    <description>An unfertilized frethik egg, its shell dusted with salt. It can be eaten raw, but it's much, much better cooked.</description>
    <graphicData>
      <texPath>Things/Item/RM_FrethikEgg</texPath>
      <drawSize>0.8</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>5.0</MarketValue>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="EggFertBase">
    <defName>RM_EggFrethikFertilized</defName>
    <label>frethik egg (fert.)</label>
    <description>A fertilized frethik egg, its shell dusted with salt. If all goes well, it should hatch into a baby frethik. It can be eaten raw, but it's much better cooked.</description>
    <graphicData>
      <texPath>Things/Item/RM_FrethikEgg</texPath>
      <drawSize>0.8</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>10.0</MarketValue>
    </statBases>
    <comps>
      <li Class="CompProperties_Hatcher">
        <hatcherDaystoHatch>6</hatcherDaystoHatch>
        <hatcherPawn>RM_Frethik</hatcherPawn>
      </li>
    </comps>
  </ThingDef>
</Defs>
