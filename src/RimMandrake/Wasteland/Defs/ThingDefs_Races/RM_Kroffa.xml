<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- RM_Kroffa — the Wastes' plated milk-grazer, RimMandrake tier.

       Owner, Wasteland art sheet 2026-10-09 (row RSW_Maligoat, art pick A kept): "RimMandrake
       tier, NOT Star Wars. Never was." Ported from SWBestiary's RSW_Maligoat (BiomesTeam port,
       already ruled label "kroffa") on the Miasma sheet's RM_Liliana pattern: def copied whole
       into the biome's own mod under an RM_ defName, stats verbatim, its milk and milk thought
       ported alongside, in-game art copied byte-for-byte through the art ledger under
       Textures/Things/Pawn/Animal/RM_Kroffa/. The SW-tier abstract parent
       RSW_PollutedLands_AnimalThingBase is inlined (its ToxicResistance 0.4; its
       BMT_PollutedLands_AllAnimals / RSW_PollutedAnimalCommon trade tags dropped). RSW_Maligoat
       stays in SWBestiary only because the frozen RUT_Wasteland twin still names it;
       RM_Wasteland casts RM_Kroffa. -->
  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Kroffa</defName>
    <label>kroffa</label>
    <description>A squat, heavy grazer armoured in overlapping plates of hide, each one thick enough to turn a knife. Its blunt face ends in a pair of hooked mouthparts that strip the tough, bitter scrub of the Wastes, and two thick horns curl back over its neck. Kroffa can eat what poisons other grazers and stand where the fallout settles, and they keep their milk clean through all of it. That milk is rich and sweet and good to drink raw, so they are the one animal in the Wastes that settlers seek out. They are slow and do not frighten easily. A herd can be driven, but it cannot be hurried.</description>
    <statBases>
      <MoveSpeed>3.9</MoveSpeed>
      <ComfyTemperatureMin>-20</ComfyTemperatureMin>
      <MarketValue>220</MarketValue>
      <FilthRate>8</FilthRate>
      <ToxicResistance>0.4</ToxicResistance>
      <ToxicEnvironmentResistance MayRequire="Ludeon.RimWorld.Biotech">1.0</ToxicEnvironmentResistance>
      <Wildness>0.75</Wildness>
    </statBases>
    <uiIconScale>1.2</uiIconScale>
    <comps>
      <li Class="CompProperties_Milkable">
        <milkDef>RM_KroffaMilk</milkDef>
        <milkIntervalDays>3</milkIntervalDays>
        <milkAmount>12</milkAmount>
      </li>
    </comps>
    <race>
      <body>QuadrupedAnimalWithHooves</body>
      <baseBodySize>1</baseBodySize>
      <baseHealthScale>0.7</baseHealthScale>
      <baseHungerRate>0.225</baseHungerRate>
      <foodType>VegetarianRoughAnimal</foodType>
      <leatherDef>Leather_Light</leatherDef>
      <roamMtbDays>8</roamMtbDays>
      <trainability>None</trainability>
      <gestationPeriodDays>5.61</gestationPeriodDays>
      <lifeExpectancy>12</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.1</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.266</minAge>
          <soundWounded>Pawn_Goat_Wounded</soundWounded>
          <soundDeath>Pawn_Goat_Death</soundDeath>
          <soundCall>Pawn_Goat_Call</soundCall>
          <soundAngry>Pawn_Goat_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
      <soundEating>Herbivore_Eat</soundEating>
      <headPosPerRotation>
        <li>(0.0, 0, 0.25)</li>
        <li>(0.26, 0, 0.04)</li>
        <li>(0, 0, 0)</li>
        <li>(-0.26, 0, 0.04)</li>
      </headPosPerRotation>
    </race>
    <tradeTags>
      <li>AnimalCommon</li>
      <li>AnimalFarm</li>
    </tradeTags>
    <tools>
      <li>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>7.3</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        <chanceFactor>0.7</chanceFactor>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>6</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
  </ThingDef>

