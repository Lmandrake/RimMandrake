<?xml version="1.0" encoding="utf-8"?>
<!--
  GRAVSHIP_ACOUSTIC_SCANNER_1: the acoustic-scanner payload for RM_Wasteland.
  Owner decision by question card 2026-10-06: the payload goes on EVERY biome of ours.

  Pure XML, FindMod-guarded on "RimMandrake: Acoustic Scanner", so the extension class
  is only named while its assembly is active. Every def is a defName STRING resolved
  at pulse time (GetNamedSilentFail), so a target naming another mod's def just hears
  nothing when that mod is absent. Each target is drawn from this biome's own content;
  the biome's sitting may re-author it. The reading is always banded by the scanner.
-->
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>RimMandrake: Acoustic Scanner</li>
    </mods>
    <match Class="PatchOperationAddModExtension">
      <xpath>/Defs/BiomeDef[defName="RM_Wasteland"]</xpath>
      <value>
        <li Class="RimMandrake.AcousticScanner.RM_AcousticPayloadExtension">
          <quietText>Salt, ash and fallout, all of it lying where it fell. Nothing moves under it.</quietText>
          <targets>
            <li>
              <label>middenshell</label>
              <reading>A colossal, slow grinding echo, and heat with it. Something the size of a hill is moving.</reading>
              <color>(1, 0.4, 0.3)</color>
              <weight>3</weight>
              <thingDefs>
                <li>RM_Middenshell</li>
              </thingDefs>
            </li>
            <li>
              <label>brine beds</label>
              <reading>Crisp mineral crackles under the pool floor, and small things moving in them.</reading>
              <color>(0.85, 0.95, 1)</color>
              <thingDefs>
                <li>RM_BrineDeposit_Tekk</li>
                <li>RM_BrineDeposit_Drazz</li>
                <li>RM_BrineDeposit_BrinePlate</li>
              </thingDefs>
            </li>
            <li>
              <label>irradiated wreck</label>
              <reading>Hollow metal lying in the ash, still warm.</reading>
              <color>(0.8, 0.8, 0.85)</color>
              <thingDefs>
                <li>RM_WastelandWreckHull</li>
                <li>RM_WastelandWreckTank</li>
              </thingDefs>
            </li>
            <li>
              <label>void in the rock</label>
              <reading>The pulse falls into a hollow under the waste.</reading>
              <color>(0.6, 0.6, 0.9)</color>
              <hiddenCaves>true</hiddenCaves>
              <cellSampleStride>4</cellSampleStride>
            </li>
          </targets>
        </li>
      </value>
    </match>
  </Operation>
</Patch>
