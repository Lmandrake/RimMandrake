<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TitanicCreatures offline fuzz (same shape as KeelHoist / ExplosiveGrowth). Plain net8.0, zero RimWorld/Unity references:
    ../Kernel/*.cs are the PRODUCTION files the mod compiles, pulled in directly. A `using Verse;` landing in one of them
    breaks this build - that is the guard rail working.
    Run: python3 src/RimMandrake/Utils/selftest_titaniccreatures_fuzz.py [fuzz knobs]
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RimMandrakeTitanicCreatures.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.TitanicCreatures.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Kernel\RM_TitanicKernel.cs" />
    <Compile Include="TitanicFuzz.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
