<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_CanyonBeats.xml   CRACKEDLANDS_GPT_ENRICHMENT_1 §2 — five beats before water

  "Wind threads the slots; sleeper pans start ticking; tarruq calls stop; chime
  lines toll from the far canyon to the near; the flood becomes a continuous
  roar." Played by RM_MapComponent_CanyonFlood (beats 1, 2, 4, 5; beat 3 is a
  silence — RM_TarruqHushPatch).

  🔴 PLACEHOLDER AUDIO. Every clip below is a VANILLA clip retinted by pitch and
  distance (the mechanics item's own "vanilla SFX reuse/retint first"), clip
  paths read from the vanilla SoundDefs in RimSage 2026-10-01: Ambient_Wind_Storm,
  Tick_Low, TinyBell, WaterMill_Ambience. The bespoke SoundDefs the spec asks for
  are owed audio: CRACKEDLANDS_FIVE_BEATS_AUDIO_1. Replace the grains here; the
  defNames are what the code binds to.

  TUNED, every number: pitches drop with distance (far chime lowest), distRanges
  wide enough that a far chime is faint-but-present across a 250 map, roar pitched
  down from the watermill loop to read as a river, not a machine.
-->
<Defs>

  <!-- Beat 1: wind threading the slots. On camera: it is the whole canyon. -->
  <SoundDef>
    <defName>RM_CanyonBeat_SlotWind</defName>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <onCamera>True</onCamera>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>Ambience/Wind/Amb_Wind_Stormy_Loop</clipPath>
          </li>
        </grains>
        <volumeRange>10~12</volumeRange>
        <pitchRange>0.65~0.75</pitchRange>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Beat 2: a sleeper pan ticking, played at each dormant animal (capped). -->
  <SoundDef>
    <defName>RM_CanyonBeat_PanTick</defName>
    <context>MapOnly</context>
    <maxSimultaneous>4</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>UI/TickLow</clipPath>
          </li>
        </grains>
        <volumeRange>12~16</volumeRange>
        <pitchRange>0.45~0.6</pitchRange>
        <distRange>10~80</distRange>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Beat 4: chime lines, far to near. Lower = farther up the canyon. -->
  <SoundDef>
    <defName>RM_CanyonChime_Far</defName>
    <context>MapOnly</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>UI/TinyBell</clipPath>
          </li>
        </grains>
        <volumeRange>14~14</volumeRange>
        <pitchRange>0.55~0.6</pitchRange>
        <distRange>30~260</distRange>
      </li>
    </subSounds>
  </SoundDef>

  <SoundDef>
    <defName>RM_CanyonChime_Mid</defName>
    <context>MapOnly</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>UI/TinyBell</clipPath>
          </li>
        </grains>
        <volumeRange>14~14</volumeRange>
        <pitchRange>0.75~0.8</pitchRange>
        <distRange>30~260</distRange>
      </li>
    </subSounds>
  </SoundDef>

  <SoundDef>
    <defName>RM_CanyonChime_Near</defName>
    <context>MapOnly</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>UI/TinyBell</clipPath>
          </li>
        </grains>
        <volumeRange>14~14</volumeRange>
        <pitchRange>0.95~1.05</pitchRange>
        <distRange>30~260</distRange>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Beat 5: the flood, a continuous roar at the water's entry point. -->
  <SoundDef>
    <defName>RM_CanyonFlood_Roar</defName>
    <context>MapOnly</context>
    <priorityMode>PrioritizeNearest</priorityMode>
    <subSounds>
      <li>
        <muteWhenPaused>True</muteWhenPaused>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>Electricity/Watermill_Loop_01a</clipPath>
          </li>
        </grains>
        <volumeRange>24</volumeRange>
        <pitchRange>0.45~0.5</pitchRange>
        <distRange>20~140</distRange>
      </li>
    </subSounds>
    <sustain>True</sustain>
  </SoundDef>

</Defs>
