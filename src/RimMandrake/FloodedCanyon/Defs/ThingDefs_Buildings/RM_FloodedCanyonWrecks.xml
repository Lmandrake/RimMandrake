<!--
  SALVAGE_WRECKAGE_EVERYWHERE_1 step 6 (design/RimMandrake/salvage_wreckage_everywhere_design_2026-10-02.md
  §3d-i, §4): Flooded Canyon wreck children, Low class, FloodBuried weathering.
  Source: the_cracked_lands.md:318 (a flood is a salvage strike). The first Speeder-family child. The recede aftermath reading a wreck list is a separate follow-up.
  Family parents, weathering and loot: src/RimMandrake/Wreckage (composed into mandrake.rm.biomes).
  Names and families are design §4's proposals; the biome's own sitting may move them.
  Art: own artpipe renders (wreck_*) installed via art install, texPath + measured shadow per child.
  ALL NUMBERS PROVISIONAL (family + weathering rows).
-->
<Defs>

  <ThingDef ParentName="RM_WreckFamily_Hull">
    <defName>RM_CanyonWreckHull</defName>
    <label>flood-buried hull</label>
    <description>A hull section half buried in dried flood mud, uncovered by the last flood. Deconstruct it before the next one takes it back.</description>
    <graphicData>
      <texPath>Things/Building/Wrecks/RM_CanyonWreckHull</texPath>
      <!-- MEASURED 2 variant(s): mean alpha bbox 92.1% x 84.5% -> 0.70*0.921*2, 0.63*0.845*2 (Scald ratio) -->
      <shadowData>
        <volume>(1.29,0.5,1.06)</volume>
      </shadowData>
    </graphicData>
    <modExtensions>
      <li Class="RimMandrake.Wreckage.RM_WreckWeathering">
        <weathering>RM_WreckWeathering_FloodBuried</weathering>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="RM_WreckFamily_Speeder">
    <defName>RM_CanyonWreckSpeeder</defName>
    <label>flood-buried speeder</label>
    <description>The shell of a small repulsor craft, nose down in the mud where a flood rolled it. Deconstruct it for valuable resources.</description>
    <graphicData>
      <texPath>Things/Building/Wrecks/RM_CanyonWreckSpeeder</texPath>
      <!-- MEASURED 1 variant(s): mean alpha bbox 89.6% x 89.6% -> 0.70*0.896*2, 0.63*0.896*2 (Scald ratio) -->
      <shadowData>
        <volume>(1.26,0.5,1.13)</volume>
      </shadowData>
    </graphicData>
    <modExtensions>
      <li Class="RimMandrake.Wreckage.RM_WreckWeathering">
        <weathering>RM_WreckWeathering_FloodBuried</weathering>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
