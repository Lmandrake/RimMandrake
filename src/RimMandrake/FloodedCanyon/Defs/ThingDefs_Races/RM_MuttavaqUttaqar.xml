           donor's DA_BipedalAnimalWithClaws (donor/EmergingAnimals-adjacent
           BodyDef) — see header. -->
      <body>QuadrupedAnimalWithClawsTailAndJowl</body>
      <predator>true</predator>
      <maxPreyBodySize>8.5</maxPreyBodySize>
      <baseBodySize>4.5</baseBodySize>
      <baseHealthScale>10</baseHealthScale>
      <baseHungerRate>0.2</baseHungerRate>
      <trainability>Intermediate</trainability>
      <foodType>OmnivoreAnimal, OvivoreAnimal</foodType>
      <manhunterOnTameFailChance>0.7</manhunterOnTameFailChance>
      <manhunterOnDamageChance>1</manhunterOnDamageChance>
      <packAnimal>false</packAnimal>
      <!-- Substituted vanilla Leather_Heavy for the donor's
