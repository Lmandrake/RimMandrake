      <leatherDef>Leather_Heavy</leatherDef>
      <specialTrainables>
        <li MayRequire="Ludeon.RimWorld.Odyssey">AttackTarget</li>
        <li MayRequire="Ludeon.RimWorld.Odyssey">Dig</li>
      </specialTrainables>
      <hediffGiverSets>
        <li>RM_UttaqarPetrificationGivers</li>
      </hediffGiverSets>
      <gestationPeriodDays>40</gestationPeriodDays>
      <litterSizeCurve>
        <points>
          <li>(0.5, 0)</li>
          <li>(1, 1)</li>
          <li>(1.5, 1)</li>
          <li>(2.0, 0)</li>
        </points>
      </litterSizeCurve>
      <lifeExpectancy>750</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.10</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.20</minAge>
          <!-- Substituted vanilla Rhinoceros voice set for the donor's
