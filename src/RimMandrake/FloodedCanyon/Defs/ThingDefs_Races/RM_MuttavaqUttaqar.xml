  <!-- ======================= RM_Muttavaq — the pan giant ======================= -->

  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Muttavaq</defName>
    <label>muttavaq</label>
    <description>A canyon-floor giant that sleeps for years under a clay pan the eye reads as ordinary terrain — a low mounded polygon field a touch too regular, cracks radiating from a center dried clay never makes on its own. Walk the famous cracked-pan flats and you walk on sleeping animals; walk THIS pan and you walk on one animal. It never hunts, never raids and never manhunters, awake or asleep — the flood wakes it wherever the water reaches, and it spends the flood-weeks wading the wet floor as a walking weir, straining mud and carrion through its jaw-plates. At the dry it digs in wherever it stands and becomes terrain again, somewhere new. Its burrow-lining is the planet's largest single crack-wax deposit; killing one asleep is easy, shameful, and a fortune.</description>
    <receivesSignals>true</receivesSignals>
    <statBases>
      <MoveSpeed>2.0</MoveSpeed>
      <MarketValue>4200</MarketValue>
      <ComfyTemperatureMin>-40</ComfyTemperatureMin>
      <ComfyTemperatureMax>90</ComfyTemperatureMax>
      <ArmorRating_Sharp>0.4</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.5</ArmorRating_Blunt>
      <Flammability>0</Flammability>
      <Wildness>1.0</Wildness>
      <FilthRate>20</FilthRate>
    </statBases>
    <tools>
      <li>
        <label>jaw-plates</label>
        <capacities>
          <li>Blunt</li>
          <li>Bite</li>
        </capacities>
        <power>18</power>
        <cooldownTime>3</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
      </li>
      <li>
        <label>foreleg</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>22</power>
        <cooldownTime>3</cooldownTime>
        <!-- QuadrupedAnimalWithClawsTailAndJowl has no FrontLeftLeg/
             FrontRightLeg groups (checked against the body's own def) —
             uses the claws groups it actually has, relabelled. -->
        <linkedBodyPartsGroup>FrontLeftClaws</linkedBodyPartsGroup>
      </li>
      <li>
        <label>foreleg</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>22</power>
        <cooldownTime>3</cooldownTime>
        <linkedBodyPartsGroup>FrontRightClaws</linkedBodyPartsGroup>
      </li>
    </tools>
    <comps>
      <li Class="CompProperties_CanBeDormant">
        <startsDormant>true</startsDormant>
      </li>
      <li Class="CompProperties_WakeUpDormant">
        <!-- INTERIM trigger only, see header: the bible's real wake
             mechanism (CompWaterWakeTrigger scaled to a giant, terrain
             writes on its feeding trail) is CRACKEDLANDS_MECHANICS_BUILD_1's
             C#, not built here. wakeUpOnDamage lets a quicktest wake one
             without that comp landing first; keep alongside it, don't
             replace, once it exists. -->
        <wakeUpOnDamage>true</wakeUpOnDamage>
      </li>
    </comps>
    <race>
      <body>QuadrupedAnimalWithClawsTailAndJowl</body>
      <predator>false</predator>
      <baseBodySize>5.0</baseBodySize>
      <baseHealthScale>12</baseHealthScale>
      <baseHungerRate>0.15</baseHungerRate>
      <foodType>OmnivoreAnimal</foodType>
      <leatherDef>Leather_Heavy</leatherDef>
      <herdAnimal>false</herdAnimal>
      <roamMtbDays>60</roamMtbDays>
      <trainability>None</trainability>
      <manhunterOnDamageChance>0</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0</manhunterOnTameFailChance>
      <!-- lifeExpectancy in centuries per the bible; concrete number picked
           for this pass. -->
      <lifeExpectancy>320</lifeExpectancy>
      <gestationPeriodDays>120</gestationPeriodDays>
      <litterSizeCurve>
        <points>
          <li>(0.5, 0)</li>
          <li>(1, 1)</li>
          <li>(1.5, 0.3)</li>
          <li>(2, 0)</li>
        </points>
      </litterSizeCurve>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.05</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.15</minAge>
          <soundWounded>Pawn_Thrumbo_Pain</soundWounded>
          <soundDeath>Pawn_Thrumbo_Death</soundDeath>
          <soundCall>Pawn_Thrumbo_Call</soundCall>
          <soundAngry>Pawn_Thrumbo_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
      <soundEating>Herbivore_Eat</soundEating>
    </race>
    <butcherProducts>
      <!-- Mirrors RUT_SealedSleeper.xml's own butcherProducts mechanism,
