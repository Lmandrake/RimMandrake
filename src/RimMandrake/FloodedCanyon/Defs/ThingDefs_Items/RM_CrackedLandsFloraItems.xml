<!-- CRACKEDLANDS_FLORA_EXPANSION_BUILD_1. Icons are retinted vanilla placeholders; item art is owed (queued in artpipe). -->
<Defs>
  <ThingDef ParentName="PlantFoodRawBase">
    <defName>RM_NabbuqBladder</defName>
    <label>nabbuq bladder</label>
    <description>A water-heavy indigo bladder, sweet and crisp. Eaten raw it is a perfectly good vegetable.</description>
    <possessionCount>10</possessionCount>
    <graphicData>
      <texPath>Things/Item/Resource/PlantFoodRaw/Potatoes</texPath>
      <color>(92, 66, 150)</color>
    </graphicData>
    <statBases>
      <MarketValue>1.3</MarketValue>
      <Mass>0.1</Mass>
      <Nutrition>0.18</Nutrition>
    </statBases>
    <ingestible>
      <foodType>VegetableOrFruit</foodType>
      <preferability>RawTasty</preferability>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>12</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>RM_RuqqalFibre</defName>
    <label>ruqqal cloth</label>
    <description>A coarse coral-coloured cloth spun from ruqqal stalks. Rough on the skin and warm for its weight.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Cloth</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(222, 124, 104)</color>
    </graphicData>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <MarketValue>2.4</MarketValue>
      <Mass>0.03</Mass>
      <Flammability>1.1</Flammability>
      <DeteriorationRate>4</DeteriorationRate>
      <StuffPower_Armor_Sharp>0.40</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Blunt>0.10</StuffPower_Armor_Blunt>
      <StuffPower_Armor_Heat>0.20</StuffPower_Armor_Heat>
      <StuffPower_Insulation_Cold>14</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>10</StuffPower_Insulation_Heat>
    </statBases>
    <burnableByRecipe>true</burnableByRecipe>
    <healthAffectsPrice>false</healthAffectsPrice>
    <stuffProps>
      <categories>
        <li>Fabric</li>
      </categories>
      <commonality>0.35</commonality>
      <color>(222, 124, 104)</color>
      <statFactors>
        <MaxHitPoints>0.7</MaxHitPoints>
        <Beauty>0.9</Beauty>
      </statFactors>
    </stuffProps>
    <thingCategories>
      <li>Textiles</li>
    </thingCategories>
    <comps>
      <li>
        <compClass>CompColorable</compClass>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>RM_ZennaqFilament</defName>
    <label>zennaq filament</label>
    <description>A bundle of springy verdigris-copper wires pulled from a zennaq. They conduct well enough to bind a coil and are brittle enough to snap at the second bend.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Silver</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(110, 170, 150)</color>
    </graphicData>
    <stackLimit>75</stackLimit>
    <statBases>
      <MarketValue>1.1</MarketValue>
      <Mass>0.02</Mass>
      <Flammability>0.2</Flammability>
    </statBases>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
  </ThingDef>
