<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FloodedCanyon offline fuzz, Approach B (same shape as Wasteland/FeverWood). Plain net8.0, zero RimWorld/Unity
    references: ../Kernel/*.cs are the PRODUCTION files the mod compiles, pulled in directly. A `using Verse;` landing
    in one of them breaks this build - that is the guard rail working.
    Run (builds on Windows via winbuild staging, then runs the exe):
      python3 src/RimMandrake/Utils/selftest_floodedcanyon_fuzz.py [fuzz knobs]
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RimMandrakeFloodedCanyon.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.FloodedCanyon.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Kernel\RM_FloodKernel.cs" />
    <Compile Include="..\Kernel\RM_RefugeKernel.cs" />
    <Compile Include="..\Kernel\RM_PanKernel.cs" />
    <Compile Include="..\Kernel\RM_DustKernel.cs" />
    <Compile Include="..\Kernel\RM_CanyonRulesKernel.cs" />
    <Compile Include="FloodedCanyonFuzz.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
