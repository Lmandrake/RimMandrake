<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Messy Conduit offline SelfTest (debug_process.md offline tier). Plain net8.0, zero
    RimWorld/Unity references: ../Core/*.cs are the PRODUCTION files the mod compiles, pulled in
    directly, so the graph reduction, planner and slack laying are tested for real. If a
    `using Verse;` ever lands in Core/, this build breaks - that is the guard rail working.

    Oracle: oracle_scenes.json, written by
      python3 src/RimMandrake/Utils/mockups/messy_conduit/export_oracle.py
    Run (builds on Windows via winbuild staging, then runs the exe):
      python3 src/RimMandrake/Utils/selftest_messyconduit.py [ [dash][dash]probe ]
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RimMandrakeMessyConduit.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.MessyConduit.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Core\CordMath.cs" />
    <Compile Include="..\Core\CordWorld.cs" />
    <Compile Include="..\Core\CordGraph.cs" />
    <Compile Include="..\Core\CordPlanner.cs" />
    <Compile Include="..\Core\CordLayer.cs" />
    <Compile Include="..\Core\CordBuilder.cs" />
    <Compile Include="..\Core\CordAudit.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="oracle_scenes.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
