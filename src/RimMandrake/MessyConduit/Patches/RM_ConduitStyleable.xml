<?xml version="1.0" encoding="utf-8"?>
<!-- Messy Conduit per-build styles, stage 2: give vanilla conduit and the power switch the engine's own style field
     (CompStyleable), so each cell / switch can store its run's style (Defs/Aerial/RM_ConduitStyles.xml).
     Guarded: added only when no other mod already listed CompProperties_Styleable on that def. WaterproofConduit inherits
     PowerConduit's comps, so patching it as well would list the comp twice. With this mod removed the patch is gone and a
     saved style field is simply never read: vanilla conduit keeps working. ConduitStylePicker logs at startup whether each
     def ended up stylable. -->
<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="PowerConduit"]/comps/li[@Class="CompProperties_Styleable"]</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="PowerConduit"]/comps</xpath>
      <value>
        <li Class="CompProperties_Styleable" />
      </value>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="PowerSwitch"]/comps/li[@Class="CompProperties_Styleable"]</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="PowerSwitch"]/comps</xpath>
      <value>
        <li Class="CompProperties_Styleable" />
      </value>
    </nomatch>
  </Operation>
  <!-- StandingLamp: vanilla already lists CompProperties_Styleable (Ideology lamp styles), so this normally adds nothing;
       kept so a mod that stripped it does not leave the lamp's picked look unsaved. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="StandingLamp"]/comps/li[@Class="CompProperties_Styleable"]</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="StandingLamp"]/comps</xpath>
      <value>
        <li Class="CompProperties_Styleable" />
      </value>
    </nomatch>
  </Operation>
</Patch>
