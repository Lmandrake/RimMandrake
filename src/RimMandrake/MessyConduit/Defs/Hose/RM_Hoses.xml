<?xml version="1.0" encoding="utf-8"?>
<!-- Messy Conduit flexible hoses, lane L6 (design/RimMandrake/messy_conduit_phase2_design_2026-10-02.md section 3).
     The reel is a plain vanilla Building; the hose is data on its comp (a save names only this def). -->
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>RM_HoseReel</defName>
    <label>hose reel</label>
    <description>A scrap pump hookup with a reel of thick sack-cloth flexible hose, stitched like a Jawa robe. Lay the hose out to any cell within reach in one go and reel it back just as fast. The hose lies flat and limp when empty and plumps up round and taut while liquid moves through it.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>RimMandrake/MessyConduit/Hose/Reel_PumpHookup</texPath>
      <graphicClass>RimMandrake.MessyConduit.Hose.Graphic_HoseReel</graphicClass>
      <drawSize>(2.8,2.8)</drawSize>
      <shadowData><volume>(1.6, 0.35, 1.35)</volume></shadowData>
      <damageData><rect>(0.1,0.1,0.8,0.8)</rect></damageData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.3</fillPercent>
    <size>(2,2)</size>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <designationCategory>Misc</designationCategory>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories><li>BuildingsMisc</li></thingCategories>
    <constructEffect>ConstructMetal</constructEffect>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>300</WorkToBuild>
      <Flammability>1</Flammability>
      <Mass>12</Mass>
      <Beauty>-2</Beauty>
    </statBases>
    <costList>
      <Cloth>25</Cloth>
      <Steel>15</Steel>
    </costList>
    <comps>
      <li Class="RimMandrake.MessyConduit.Hose.CompProperties_HoseReel" />
      <!-- per-build style (stage 3): the look picked on the build button, see RM_HoseReelStyles.xml -->
      <li Class="CompProperties_Styleable" />
    </comps>
  </ThingDef>

</Defs>
