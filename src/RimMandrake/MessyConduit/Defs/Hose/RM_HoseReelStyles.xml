<?xml version="1.0" encoding="utf-8"?>
<!-- Messy Conduit per-build styles, stage 3: the hose reel (design/RimMandrake/messyconduit_style_per_build_design.md
     section 5 stage 3, architecture B). One ThingStyleDef per look, named RM_HoseReel_<Look> (HoseStyles.StyleDefName),
     stored on the reel by CompStyleable and carried blueprint -> frame -> building -> minified -> save by the engine.
     graphicClass Graphic_HoseReel: the stored art below while the hose is reeled in, the sibling Reel_Deployed (empty
     drum with its hose inlet) of the SAME folder while it is laid out, so each look swaps within its own pair. The hose
     the reel lays draws in the reel's look (HoseMaterials.For). Geometry matches RM_HoseReel's own graphicData.
     No StyleCategoryDef lists these, so no ideoligion can hand them out. -->
<Defs>

  <ThingStyleDef>
    <defName>RM_HoseReel_Scrapper</defName>
    <label>scrapper</label>
    <graphicData>
      <texPath>RimMandrake/MessyConduit/Hose/Reel_PumpHookup</texPath>
      <graphicClass>RimMandrake.MessyConduit.Hose.Graphic_HoseReel</graphicClass>
      <drawSize>(2.8,2.8)</drawSize>
      <shadowData><volume>(1.6, 0.35, 1.35)</volume></shadowData>
      <damageData><rect>(0.1,0.1,0.8,0.8)</rect></damageData>
    </graphicData>
  </ThingStyleDef>

