    <defName>WaterproofConduit_Industrial</defName>
    <label>industrial</label>
  </ThingStyleDef>
  <ThingStyleDef>
    <defName>WaterproofConduit_Modern</defName>
    <label>modern</label>
  </ThingStyleDef>
  <ThingStyleDef>
    <defName>WaterproofConduit_Modern_Orange</defName>
    <label>modern, orange</label>
  </ThingStyleDef>
  <ThingStyleDef>
    <defName>WaterproofConduit_Modern_Green</defName>
    <label>modern, green</label>
  </ThingStyleDef>
  <ThingStyleDef>
    <defName>WaterproofConduit_Modern_Brown</defName>
    <label>modern, brown</label>
  </ThingStyleDef>
  <ThingStyleDef>
    <defName>WaterproofConduit_Modern_Yellow</defName>
    <label>modern, yellow</label>
  </ThingStyleDef>
  <ThingStyleDef>
    <defName>WaterproofConduit_Modern_Blue</defName>
    <label>modern, blue</label>
  </ThingStyleDef>
  <ThingStyleDef>
    <defName>WaterproofConduit_Modern_Mix</defName>
    <label>modern, mixed colours</label>
  </ThingStyleDef>
  <ThingStyleDef>
    <defName>WaterproofConduit_Futuristic</defName>
    <label>futuristic</label>
  </ThingStyleDef>

  <!-- PowerSwitch -->
  <ThingStyleDef>
    <defName>PowerSwitch_Scrapper</defName>
    <label>scrapper</label>
    <graphicData>
      <texPath>RimMandrake/MessyConduit/PowerSwitch</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <damageData><rect>(0.2,0.2,0.6,0.6)</rect></damageData>
    </graphicData>
  </ThingStyleDef>
  <ThingStyleDef>
    <defName>PowerSwitch_Industrial</defName>
    <label>industrial</label>
    <graphicData>
      <texPath>RimMandrake/MessyConduit/Styles/Industrial/PowerSwitch</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <damageData><rect>(0.2,0.2,0.6,0.6)</rect></damageData>
    </graphicData>
  </ThingStyleDef>
  <ThingStyleDef>
