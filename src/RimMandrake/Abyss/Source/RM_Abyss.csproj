<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FORSAKENCRAGS_RM_MOD_BUILD_1. Same recipe as
    src/RimMandrake/GelatinousSlime/Source/RM_GelatinousSlime.csproj — copy
    that header if this one goes stale.

    ONE HARMONY PATCH (ABYSS_DARK_MUFFLE_ALL_SOUNDS_1): RM_AbyssSoundHook.cs, a
    postfix on Sample.Update. 0Harmony is Private=false (game supplies it).
    Everything else is a vanilla extension point.

    Build (the dotnet is WINDOWS-NATIVE and cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\RimMandrake\src\RimMandrake\Abyss\Source\RM_Abyss.csproj -c Release

    Output lands in ../Assemblies/, which is where RimWorld looks.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrake.Abyss</AssemblyName>
    <RootNamespace>RimMandrake.Abyss</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <!-- LIGHT_LEDGER_ONE_1: the shared light ledger, compiled into this assembly (design/RimMandrake/light_ledger_design.md) -->
    <Compile Include="..\..\_Shared\LightLedger\LightLedger.cs" Link="Shared\LightLedger.cs" />
    <Compile Include="..\..\_Shared\HarmonyResilience\PatchApplier.cs" Link="Shared\PatchApplier.cs" />
    <Compile Include="..\..\_Shared\LightLedger\LightLedgerKernel.cs" Link="Shared\LightLedgerKernel.cs" />
    <Compile Include="RM_AbyssMod.cs" />
    <Compile Include="..\..\_Shared\SettingsKit\SettingsKitCore.cs" Link="Shared\SettingsKitCore.cs" />
    <Compile Include="..\..\_Shared\SettingsKit\SettingsKitDrawer.cs" Link="Shared\SettingsKitDrawer.cs" />
    <Compile Include="RM_AbyssBiome.cs" />
    <Compile Include="RM_GustController.cs" />
    <Compile Include="RM_CompGharrek.cs" />
    <Compile Include="RM_CompDurrgak.cs" />
    <Compile Include="RM_GenStep_DurrgakSigns.cs" />
    <Compile Include="RM_CompSummHide.cs" />
    <Compile Include="RM_CompQuillHackle.cs" />
    <Compile Include="RM_CompKrizzak.cs" />
    <Compile Include="RM_CompLightAversion.cs" />
    <Compile Include="RM_MapComponentEtchfall.cs" />
    <Compile Include="RM_MapComponentDark.cs" />
    <Compile Include="RM_MapComponentShipCover.cs" />
    <Compile Include="RM_AbyssLight.cs" />
    <Compile Include="RM_AbyssSoundscape.cs" />
    <Compile Include="RM_AbyssSoundHook.cs" />
    <Compile Include="RM_AbyssCryptid.cs" />
    <Compile Include="RM_BroodWakeLogic.cs" />
    <Compile Include="RM_AbyssKernel.cs" />
    <Compile Include="RM_AbyssStateKernel.cs" />
    <Compile Include="RM_BroodLair.cs" />
    <Compile Include="RM_BroodEgg.cs" />
    <Compile Include="RM_ShipWreck.cs" />
  </ItemGroup>

  <PropertyGroup Condition="'$(HarmonyDll)' == ''">
    <HarmonyDll>C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\2009463077\Current\Assemblies\0Harmony.dll</HarmonyDll>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
