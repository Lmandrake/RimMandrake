<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline, no-game selftest for ABYSS_LIGHTFALL_BROOD_WRECK_1. Compiles the REAL production file
    ..\RM_BroodWakeLogic.cs (System only) and drives it. NOT the mod build: RM_Abyss.csproj one directory up
    lists its files explicitly and never mentions this folder.

    Run via src/RimMandrake/Utils/selftest_abyss_brood.py.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrakeAbyss.Brood.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.Abyss.BroodSelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <DebugType>none</DebugType>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\RM_BroodWakeLogic.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
