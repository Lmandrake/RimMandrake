<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Abyss offline fuzz (Approach B, same shape as DivingInteraction/Droidworks/Bazaar). Plain net8.0, zero RimWorld/Unity
    references: ..\RM_AbyssKernel.cs and ..\RM_AbyssStateKernel.cs are the PRODUCTION files the mod compiles, pulled in
    directly. If a `using Verse;` ever lands in either, this build breaks - the guard rail working. NOT the mod build and NOT
    the BroodSelfTest (which drives RM_BroodWakeLogic.cs); RM_Abyss.csproj one directory up never mentions this folder.
    Run (builds on Windows via winbuild staging, then runs the exe):
      python3 src/RimMandrake/Utils/selftest_abyss_fuzz.py [fuzz knobs]
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RimMandrakeAbyss.Fuzz</AssemblyName>
    <RootNamespace>RimMandrake.Abyss.Fuzz</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\RM_AbyssKernel.cs" />
    <Compile Include="..\RM_AbyssStateKernel.cs" />
    <Compile Include="AbyssFuzz.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
