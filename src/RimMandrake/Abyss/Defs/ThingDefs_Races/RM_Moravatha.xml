<?xml version="1.0" encoding="utf-8"?>
<!--
  ABYSS_SHEET_DONOR_PORT_1. The moravatha: one of the Abyss's black, many-eyed kin, a huge yoked grazer under a
  domed carapace. Owned port of the Alpha Animals crepuscular beetle (sarg.alphaanimals AA_CrepuscularBeetle,
  1.6/Defs/ThingDefs_Races/Races_CrepuscularBeetle.xml); name and description are the owner's sheet ruling
  2026-10-05. Free RM_ tier, ONE HOME: the Abyss. Stats, tools, race fields and pawnkind numbers are the donor's
  own, EXCEPT these donor-only references:
    - leatherDef Leather_Chitin (an Alpha Animals item) dropped: no leather, as vanilla's own insectoids
      (PROVISIONAL; a carapace product is owed if wanted)
    - sounds Pawn_Terramorph_* (Alpha Animals) -> vanilla Pawn_BigInsect_*
    - CompProperties_EggLayer (donor egg items) dropped: it bears live young; gestationPeriodDays 10 is
      PROVISIONAL (set to the donor's eggLayIntervalDays), litterSizeCurve the donor's own
    - VEF CompProperties_InitialHediff AA_LowRest ("hardly sleeps") and the VEF stat extension dropped; the
      low-rest trait is OWED as our own mechanic (not built here).
  ART: abyss_moravatha_v3 (east/south/north, 512 px, finished in the artpipe), installed 2026-10-06 via the art ledger at the texPath below.
-->
<Defs>

  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Moravatha</defName>
    <label>moravatha</label>
    <description>A huge, slow, many-legged grazer under a domed carapace of overlapping blood-dark plates as long as a cart, with four glowing yellow eyes set in its blunt head. It wakes when the Dark thickens and hardly sleeps. The crags' old masters broke it to the yoke, and a moravatha will still haul all night without complaint, as if it remembered whose it was.</description>
    <statBases>
      <MoveSpeed>4.0</MoveSpeed>
      <ComfyTemperatureMin>-10</ComfyTemperatureMin>
      <MarketValue>600</MarketValue>
      <ArmorRating_Blunt>0.4</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.4</ArmorRating_Sharp>
      <FilthRate>16</FilthRate>
      <Wildness>0.75</Wildness>
    </statBases>
    <tools>
      <li>
        <label>head claw</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>18</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadClaw</linkedBodyPartsGroup>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>6</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <race>
      <herdAnimal>true</herdAnimal>
      <body>BeetleLikeWithClaw</body>
      <baseBodySize>3</baseBodySize>
      <baseHealthScale>1.2</baseHealthScale>
      <baseHungerRate>0.3</baseHungerRate>
      <fleshType>Insectoid</fleshType>
      <bloodDef>Filth_BloodInsect</bloodDef>
      <useMeatFrom>Megaspider</useMeatFrom>
      <foodType>OmnivoreRoughAnimal</foodType>
      <packAnimal>true</packAnimal>
      <trainability>None</trainability>
      <roamMtbDays>3</roamMtbDays>
      <gestationPeriodDays>10</gestationPeriodDays>
      <litterSizeCurve>
        <points>
          <li>(0.99, 0)</li>
          <li>(1, 1)</li>
          <li>(1.01, 0)</li>
        </points>
      </litterSizeCurve>
      <lifeExpectancy>37</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.2</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.3333</minAge>
          <soundWounded>Pawn_BigInsect_Pain</soundWounded>
          <soundDeath>Pawn_BigInsect_Death</soundDeath>
          <soundCall>Pawn_BigInsect_Call</soundCall>
          <soundAngry>Pawn_BigInsect_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
    </race>
    <tradeTags>
      <li>AnimalUncommon</li>
      <li>AnimalFighter</li>
      <li>AnimalFarm</li>
    </tradeTags>
  </ThingDef>

  <PawnKindDef ParentName="AnimalKindBase">
    <defName>RM_Moravatha</defName>
    <label>moravatha</label>
    <race>RM_Moravatha</race>
    <combatPower>200</combatPower>
    <ecoSystemWeight>0.2</ecoSystemWeight>
    <wildGroupSize>
      <min>1</min>
      <max>3</max>
    </wildGroupSize>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>RM_Abyss/Things/Pawn/Animal/RM_Moravatha/RM_Moravatha</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.8</drawSize>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>RM_Abyss/Things/Pawn/Animal/RM_Moravatha/RM_Moravatha</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>3.2</drawSize>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>RM_Abyss/Things/Pawn/Animal/RM_Moravatha/RM_Moravatha</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>4.1</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>

</Defs>
