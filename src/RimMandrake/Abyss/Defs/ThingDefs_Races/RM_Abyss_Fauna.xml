  <ThingDef ParentName="BuildingBase">
    <defName>RM_DurrgakCairn</defName>
    <label>stone cairn</label>
    <description>A knee-high stack of obsidian shards, set down with care. It stands in a ring or a row with others like it. Nothing about it says who made it.</description>
    <graphicData>
      <texPath>Things/Item/Chunk/ChunkSlag</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <color>(40,38,46)</color>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.15</fillPercent>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <building>
      <claimable>false</claimable>
      <deconstructible>false</deconstructible>
