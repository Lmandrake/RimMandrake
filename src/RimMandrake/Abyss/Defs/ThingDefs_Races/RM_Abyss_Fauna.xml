    </lifeStages>
  </PawnKindDef>

  <HediffDef>
    <defName>RM_GharrekDormant</defName>
    <label>dormant</label>
    <description>Plates shut, cold and still, waiting for the wind.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <tendable>false</tendable>
    <stages>
      <li>
        <statFactors>
          <MoveSpeed>0.05</MoveSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <ThingDef ParentName="ResourceBase">
    <defName>RM_GillAsh</defName>
    <label>gill-ash</label>
    <description>A grey, faintly oily ash shed by penned gharreks. It is the crags' feedstock for chemfuel.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Chemfuel</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(110,104,118)</color>
    </graphicData>
    <stackLimit>75</stackLimit>
    <statBases>
      <MarketValue>1.6</MarketValue>
      <Mass>0.4</Mass>
      <Flammability>1.5</Flammability>
    </statBases>
    <thingCategories><li>ResourcesRaw</li></thingCategories>
    <comps>
      <li Class="CompProperties_Flammable" />
    </comps>
  </ThingDef>

  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Durrgak</defName>
    <label>durrgak</label>
    <description>A slow, long-fingered digger that arranges things. It drags obsidian shards into rings and rows, caches what it finds in neat piles, and lines its den with dropped steel. It is shy. The Jawa say it learned it from someone. Tamed, it tidies, hauling small things at a crawl.</description>
    <statBases>
      <MoveSpeed>2.0</MoveSpeed>
      <Mass>28</Mass>
      <MarketValue>180</MarketValue>
      <ComfyTemperatureMin>-40</ComfyTemperatureMin>
      <ComfyTemperatureMax>40</ComfyTemperatureMax>
      <Wildness>0.6</Wildness>
    </statBases>
    <tools>
      <li>
        <label>fingers</label>
        <capacities><li>Scratch</li></capacities>
        <power>4</power>
        <cooldownTime>2.2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
      </li>
    </tools>
    <comps>
      <li Class="RimMandrake.Abyss.CompProperties_RM_Durrgak" />
    </comps>
    <race>
      <body>QuadrupedAnimalWithPaws</body>
      <bloodDef>Filth_Blood</bloodDef>
      <bloodSmearDef>Filth_BloodSmear</bloodSmearDef>
      <hediffGiverSets><li>OrganicStandard</li></hediffGiverSets>
      <baseBodySize>0.7</baseBodySize>
      <baseHealthScale>0.8</baseHealthScale>
      <baseHungerRate>0.3</baseHungerRate>
      <foodType>OmnivoreAnimal</foodType>
      <predator>false</predator>
      <trainability>Advanced</trainability>
      <manhunterOnDamageChance>0.05</manhunterOnDamageChance>
      <lifeExpectancy>22</lifeExpectancy>
      <lifeStageAges>
        <li><def>AnimalBaby</def><minAge>0</minAge></li>
        <li><def>AnimalJuvenile</def><minAge>0.3</minAge></li>
        <li><def>AnimalAdult</def><minAge>0.8</minAge></li>
      </lifeStageAges>
    </race>
    <tradeTags><li>AnimalUncommon</li></tradeTags>
  </ThingDef>

