<?xml version="1.0" encoding="utf-8"?>
<!--
  ABYSS_GHARREK_BUILD_1 + ABYSS_DURRGAK_BUILD_1. Spec: design/Jawa/worldbuilding/biomes/
  blackcrags_bedazzle_review_2026-09-30.md section 4 rows 1 and 2. RM_ tier, invented, one home (the Abyss).

  ART IS A PLACEHOLDER: vanilla Iguana (gharrek) and Squirrel (durrgak) sprites tinted to the
  Abyss palette. Bespoke art is owed (3 facings each).

  gharrek: dormant in the still (RM_GharrekDormant hediff), opens and feeds on every gust
  (CompRM_Gharrek reading RM_MapComponent_Gust). Penned, it gives gill-ash (RM_GillAsh) like a
  boomalope gives chemfuel; it only fattens in gusts because that is the only time it eats.
  durrgak: wild ones lay out rings of RM_DurrgakCairn (CompRM_Durrgak); tamed ones tidy through
  vanilla's Haul training (trainability Advanced, body size >= 0.4). The description never says who.
-->
<Defs>

  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Gharrek</defName>
    <label>gharrek</label>
    <description>A flat, many-gilled crawler that clings in the lee of the crags. In the still it lies shut and cold, nearly invisible on the black stone. When a gust hits, every gharrek on the map opens at once and feeds on the stirred air: a sudden carpet of fluttering gill-fans and a faint chemical glow. Then they shut again. Harmless. Penned ones give a little gill-ash, and fatten only in the wind.</description>
    <statBases>
      <MoveSpeed>1.6</MoveSpeed>
      <Mass>6</Mass>
      <MarketValue>90</MarketValue>
      <ComfyTemperatureMin>-40</ComfyTemperatureMin>
      <ComfyTemperatureMax>40</ComfyTemperatureMax>
      <Wildness>0.4</Wildness>
      <ArmorRating_Sharp>0.2</ArmorRating_Sharp>
    </statBases>
    <tools>
      <li>
        <label>gill-rasp</label>
        <capacities><li>Scratch</li></capacities>
        <power>2</power>
        <cooldownTime>2.6</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
      </li>
    </tools>
    <comps>
      <li Class="CompProperties_Milkable">
        <milkDef>RM_GillAsh</milkDef>
        <milkIntervalDays>6</milkIntervalDays>
        <milkAmount>4</milkAmount>
        <milkFemaleOnly>false</milkFemaleOnly>
      </li>
      <li Class="RimMandrake.Abyss.CompProperties_RM_Gharrek" />
    </comps>
    <race>
      <body>QuadrupedAnimalWithPaws</body>
      <bloodDef>Filth_Blood</bloodDef>
      <bloodSmearDef>Filth_BloodSmear</bloodSmearDef>
      <hediffGiverSets><li>OrganicStandard</li></hediffGiverSets>
      <baseBodySize>0.35</baseBodySize>
      <baseHealthScale>0.5</baseHealthScale>
      <baseHungerRate>0.25</baseHungerRate>
      <foodType>VegetarianRoughAnimal</foodType>
      <predator>false</predator>
      <trainability>Simple</trainability>
      <manhunterOnDamageChance>0</manhunterOnDamageChance>
      <herdAnimal>true</herdAnimal>
      <lifeExpectancy>12</lifeExpectancy>
      <lifeStageAges>
        <li><def>AnimalBaby</def><minAge>0</minAge></li>
        <li><def>AnimalJuvenile</def><minAge>0.2</minAge></li>
        <li><def>AnimalAdult</def><minAge>0.5</minAge></li>
      </lifeStageAges>
    </race>
    <tradeTags><li>AnimalCommon</li></tradeTags>
  </ThingDef>

