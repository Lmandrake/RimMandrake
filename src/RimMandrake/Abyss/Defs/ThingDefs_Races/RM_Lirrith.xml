<!--
  ABYSS_SHEET_DONOR_PORT_1. The lirrith: one of the Abyss's black, many-eyed kin, a small pack scavenger. Owned
  port of the Alpha Animals murkling (sarg.alphaanimals AA_Murkling, 1.6/Defs/ThingDefs_Races/Races_Murkling.xml);
  name and description are the owner's sheet ruling 2026-10-05. Free RM_ tier, ONE HOME: the Abyss. Stats, tools,
  race fields and pawnkind numbers are the donor's own, EXCEPT these donor-only references:
    - body AA_FourEyedQuadruped -> vanilla QuadrupedAnimalWithPawsAndTail (same tool groups)
    - leatherDef Leather_Night -> Leather_Wolf (PROVISIONAL substitute)
    - the donor's "plague carrier" bite (capacity FO_PlaguedBite, chance 0.7) has no vanilla equivalent and is
      dropped; its weight folds into the vanilla ToxicBite "festering bite" (chance 0.2 + 0.7 = 0.9,
      PROVISIONAL). "Its bite festers" is carried by ToxicBite; a disease-on-bite mechanic is NOT built here.
    - VEF CompProperties_CorpseDecayer (dissolving corpses) and the VEF trainable/stat extension dropped.
  ART: abyss_lirrith_v3 (east/south/north, finished in the artpipe), installed 2026-10-06 via the art ledger at the texPath below.
-->
<Defs>

  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Lirrith</defName>
    <label>lirrith</label>
    <description>A small, quick, thin-legged scavenger with dark skin drawn tight over its ribs and a long hooked tail carried curled over its back. A fluted crest of pale green ridges runs up its snout, and below it four eyes glow yellow. It hums to its kin through that crest, too low for human ears, and a pack can strip a carcass or a careless camp's stores in the time it takes to light a lamp. Its bite festers, and the crag-tellers say that is no accident of nature.</description>
    <statBases>
      <MoveSpeed>5.1</MoveSpeed>
      <MarketValue>35</MarketValue>
      <ComfyTemperatureMin>-35</ComfyTemperatureMin>
      <FilthRate>2</FilthRate>
      <ToxicEnvironmentResistance MayRequire="Ludeon.RimWorld.Biotech">1</ToxicEnvironmentResistance>
      <Wildness>0.6</Wildness>
    </statBases>
    <tools>
      <li>
        <label>left claw</label>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>4</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
      </li>
      <li>
        <label>right claw</label>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>4</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup>
      </li>
      <li>
        <label>festering bite</label>
        <capacities>
          <li>ToxicBite</li>
        </capacities>
        <power>5</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        <chanceFactor>0.9</chanceFactor>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>2</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.1</chanceFactor>
      </li>
    </tools>
    <race>
      <body>QuadrupedAnimalWithPawsAndTail</body>
      <baseBodySize>0.35</baseBodySize>
      <baseHealthScale>0.40</baseHealthScale>
      <baseHungerRate>0.20</baseHungerRate>
      <foodType>VegetarianRoughAnimal</foodType>
      <leatherDef>Leather_Wolf</leatherDef>
      <gestationPeriodDays>5.661</gestationPeriodDays>
      <useMeatFrom>Rat</useMeatFrom>
      <manhunterOnDamageChance>0.25</manhunterOnDamageChance>
      <trainability>None</trainability>
      <packAnimal>false</packAnimal>
      <lifeExpectancy>6</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.1</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.2222</minAge>
          <soundWounded>Pawn_Rodent_Wounded</soundWounded>
          <soundDeath>Pawn_Rodent_Death</soundDeath>
          <soundCall>Pawn_Rodent_Call</soundCall>
          <soundAngry>Pawn_Rodent_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <tradeTags>
      <li>AnimalCommon</li>
    </tradeTags>
