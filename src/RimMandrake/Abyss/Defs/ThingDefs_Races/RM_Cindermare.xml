<?xml version="1.0" encoding="utf-8"?>
<!--
  ABYSS_INVENTED_CREATURES_TO_RM_1. Cindermare. Invented name (Wookieepedia search: 0 hits), so it lives in the
  franchise-free RM_ tier (Q11a), not SWBestiary. ONE HOME: the Abyss (RM_Abyss inline, plus the RUT_Abyss twin).
  Ported unchanged from the former Star Wars-tier def (FORSAKEN_CRAGS_PREDATORS_BUILD_1); wildness 1.0 makes it untameable.
  Its grip tool deals RM_ColdDrainDamage; the wound is the RM_ColdDrain hediff (the art has no mouth, so the wound stands in for a bite).
-->
<Defs>
  <ThingDef ParentName="ThingBaseWolf">
    <defName>RM_Cindermare</defName>
    <label>saevitha</label>
    <description>A mouthless nightside predator, fourteen eyes, seven to a side, clustered above a damp black hide. It has no bite - it kills by grip, draining the warmth from whatever it holds until the cold itself is the wound. Solitary and untameable; its mane and hide are only ever taken from a kill, never sheared. Of all the black, many-eyed kin it is the one the old tales most often set at a dark master's heel.</description>
    <race>
      <thinkTreeMain>Animal</thinkTreeMain>
      <thinkTreeConstant>AnimalConstant</thinkTreeConstant>
      <trainability>None</trainability>
      <body>QuadrupedAnimalWithPawsAndTail</body>
      <predator>true</predator>
      <maxPreyBodySize>3.0</maxPreyBodySize>
      <petness>0</petness>
      <baseBodySize>1.3</baseBodySize>
      <baseHungerRate>0.22</baseHungerRate>
      <baseHealthScale>1.15</baseHealthScale>
      <foodType>CarnivoreAnimal</foodType>
      <leatherDef>Leather_Wolf</leatherDef>
      <meatLabel>cindermare meat</meatLabel>
      <nameOnTameChance>0</nameOnTameChance>
      <manhunterOnTameFailChance>0.5</manhunterOnTameFailChance>
      <manhunterOnDamageChance>0.9</manhunterOnDamageChance>
      <gestationPeriodDays>16</gestationPeriodDays>
      <lifeExpectancy>18</lifeExpectancy>
      <lifeStageAges Inherit="False">
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.25</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.6</minAge>
          <soundWounded>Pawn_Dog_Injured</soundWounded>
          <soundDeath>Pawn_Dog_Death</soundDeath>
          <soundCall>Pawn_Dog_Call</soundCall>
          <soundAngry>Pawn_Dog_Angry</soundAngry>
        </li>
      </lifeStageAges>
    </race>
    <statBases>
      <Mass>110</Mass>
      <Flammability>0.6</Flammability>
      <LeatherAmount>65</LeatherAmount>
      <ToxicResistance>0.6</ToxicResistance>
      <MoveSpeed>4.6</MoveSpeed>
      <MarketValue>520</MarketValue>
      <ComfyTemperatureMin>-70</ComfyTemperatureMin>
      <FilthRate>1.5</FilthRate>
      <Wildness>1.0</Wildness>
    </statBases>
    <tools>
      <li>
        <label>left claw</label>
        <labelNoLocation>claw</labelNoLocation>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2.2</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
        <chanceFactor>0.4</chanceFactor>
      </li>
      <li>
        <label>right claw</label>
        <labelNoLocation>claw</labelNoLocation>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2.2</cooldownTime>
        <linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup>
        <chanceFactor>0.4</chanceFactor>
      </li>
      <li>
        <label>cold-drain grip</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>14</power>
        <cooldownTime>2.6</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>1.2</chanceFactor>
        <extraMeleeDamages>
          <li>
            <def>RM_ColdDrainDamage</def>
            <amount>6</amount>
          </li>
        </extraMeleeDamages>
      </li>
    </tools>
    <tradeTags>
      <li>AnimalFighter</li>
    </tradeTags>
    <comps>
      <li>
        <compClass>CompAttachBase</compClass>
      </li>
    </comps>
    <graphicData>
      <texPath>RM_Abyss/Things/Pawn/Animal/RM_Cindermare/RM_Cindermare</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>2.6</drawSize>
    </graphicData>
    <useHitPoints>false</useHitPoints>
  </ThingDef>

  <PawnKindDef ParentName="AnimalKindBaseWolf">
    <defName>RM_Cindermare</defName>
    <label>saevitha</label>
    <labelPlural>cindermares</labelPlural>
    <race>RM_Cindermare</race>
    <combatPower>140</combatPower>
    <ecoSystemWeight>0.35</ecoSystemWeight>
    <lifeStages>
      <li>
        <label>saevitha foal</label>
        <labelPlural>cindermare foals</labelPlural>
        <bodyGraphicData>
          <texPath>RM_Abyss/Things/Pawn/Animal/RM_Cindermare/RM_Cindermare</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.3</drawSize>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>RM_Abyss/Things/Pawn/Animal/RM_Cindermare/RM_Cindermare</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>2.0</drawSize>
          <shadowData>
            <volume>(0.4, 0.4, 0.3)</volume>
            <offset>(0,0,-0.15)</offset>
          </shadowData>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>RM_Abyss/Things/Pawn/Animal/RM_Cindermare/RM_Cindermare</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>2.6</drawSize>
          <shadowData>
            <volume>(0.5, 0.5, 0.35)</volume>
            <offset>(0,0,-0.15)</offset>
          </shadowData>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>

  <DamageDef>
    <defName>RM_ColdDrainDamage</defName>
    <label>cold drain</label>
    <workerClass>DamageWorker_AddInjury</workerClass>
    <externalViolence>true</externalViolence>
    <deathMessage>{0} has been drained of warmth to death.</deathMessage>
    <hediff>RM_ColdDrain</hediff>
    <harmAllLayersUntilOutside>false</harmAllLayersUntilOutside>
    <impactSoundType>Blunt</impactSoundType>
    <armorCategory>Blunt</armorCategory>
    <makesBlood>false</makesBlood>
    <overkillPctToDestroyPart>0~0.5</overkillPctToDestroyPart>
    <isRanged>false</isRanged>
    <makesAnimalsFlee>true</makesAnimalsFlee>
    <defaultArmorPenetration>0</defaultArmorPenetration>
    <defaultDamage>1</defaultDamage>
  </DamageDef>

  <HediffDef ParentName="InjuryBase">
    <defName>RM_ColdDrain</defName>
    <label>cold-drain wound</label>
    <description>Flesh drained of warmth by a saevitha's grip. Aches like frostbite and is slow to heal.</description>
    <hediffClass>Hediff_Injury</hediffClass>
    <comps>
      <li Class="HediffCompProperties_TendDuration">
        <labelTendedWell>warmed</labelTendedWell>
        <labelTendedWellInner>tended</labelTendedWellInner>
        <labelSolidTendedWell>scarred over</labelSolidTendedWell>
      </li>
    </comps>
    <injuryProps>
      <painPerSeverity>0.018</painPerSeverity>
      <averagePainPerSeverityPermanent>0.009</averagePainPerSeverityPermanent>
      <canMerge>false</canMerge>
      <destroyedLabel>Destroyed by cold</destroyedLabel>
    </injuryProps>
    <labelNoun>a cold-drain wound</labelNoun>
    <labelNounPretty>{0} in the {1}</labelNounPretty>
    <displayWound>true</displayWound>
    <tendable>true</tendable>
  </HediffDef>
</Defs>
