    <defName>RM_SummElder</defName>
    <label>elder</label>
    <visible>true</visible>
    <reproductive>true</reproductive>
    <bodySizeFactor>1.35</bodySizeFactor>
    <healthScaleFactor>1.3</healthScaleFactor>
    <hungerRateFactor>1.35</hungerRateFactor>
    <foodMaxFactor>1.3</foodMaxFactor>
    <meleeDamageFactor>1.2</meleeDamageFactor>
    <marketValueFactor>1.2</marketValueFactor>
  </LifeStageDef>

