  <HediffDef>
    <defName>RM_SummSunburn</defName>
    <label>daylight burn</label>
    <description>Its hide is made for perpetual night. Under an open daylit sky it blisters and smokes; in shade or darkness the burn fades.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9, 0.55, 0.3)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1</maxSeverity>
    <stages>
