  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Summ</defName>
    <label>summ</label>
    <description>A vast, low, many-legged grazer of the deep crags whose voice is the thunder. Its long armoured body is slung on six thick limbs; great resonating throat-sacs down its neck and chest glow a faint storm-violet when it is charged. It grazes on the Dark itself, gathering the charge the Dark carries until it must call it out, and in a Witchfire storm the roll heard a few seconds before a flash with no lightning is a summ calling. It regenerates its wounds, sees by the glow of its own throat, and burns in daylight. It never stops growing.</description>
    <statBases>
      <MoveSpeed>3.6</MoveSpeed>
      <MarketValue>2600</MarketValue>
      <ComfyTemperatureMin>-50</ComfyTemperatureMin>
      <ComfyTemperatureMax>40</ComfyTemperatureMax>
      <Wildness>0.97</Wildness>
      <ArmorRating_Sharp>0.6</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.4</ArmorRating_Blunt>
      <ArmorRating_Heat>0.3</ArmorRating_Heat>
      <ToxicResistance>0.6</ToxicResistance>
      <FilthRate>4</FilthRate>
    </statBases>
    <tools>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>38</power>
        <cooldownTime>2.6</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
      </li>
      <li>
        <label>left foreleg</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>30</power>
        <cooldownTime>2.2</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftLeg</linkedBodyPartsGroup>
      </li>
      <li>
        <label>right foreleg</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>30</power>
        <cooldownTime>2.2</cooldownTime>
        <linkedBodyPartsGroup>FrontRightLeg</linkedBodyPartsGroup>
      </li>
      <li>
        <label>teeth</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>34</power>
        <cooldownTime>2.4</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        <chanceFactor>0.6</chanceFactor>
      </li>
    </tools>
    <race>
      <body>QuadrupedAnimalWithHooves</body>
      <baseBodySize>8</baseBodySize>
      <baseHealthScale>9</baseHealthScale>
      <baseHungerRate>2.2</baseHungerRate>
      <foodType>OmnivoreAnimal</foodType>
      <predator>false</predator>
