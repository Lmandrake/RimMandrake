<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    ABYSS_LAMP_CROPS_BUILD_1 (owner card, turn 2: "lamps as crops only"). The Abyss's own glowing tree,
    invented and donor-free. It is a vanilla TreeBase tree, so it is TRANSPLANTED the vanilla way:
    Extract tree -> carry the minified tree -> Replant anywhere on the planet. It is sown only where it grows
    wild (TreeBase mustBeWildToSow + Tree sowing research).

    The light is the point. Its CompGlower carries an overlightRadius: GlowGrid.GroundGlowAt returns 1.0
    (full crop light) inside it and caps every other glow at 0.5, under every crop's growMinGlow 0.51
    (MEASURED from the decompiled 1.6 GlowGrid). So a ring of wickwoods lights a farm against the Dark.
    The Dark's lamp-swallowing (RM_MapComponent_Dark.LampPass) touches only BuildingArtificial glowers, so
    a wickwood's light is never shrunk by the Dark: it is the light that holds. A krizzak may still sip it.

    Mod Setting lampCropsEnabled (RM_AbyssLampCrops, read at startup): off = no overlight (it lights, it
    does not farm) and it is struck from the Abyss's wild plants. Takes effect after a restart.

    ART: RM_Wickwood from the artpipe (landed 2026-10-03, 256 px, own colours, no tint).
  -->
  <ThingDef ParentName="TreeBase">
    <defName>RM_Wickwood</defName>
    <label>wickwood tree</label>
    <description>A slim, black-barked tree of the Abyss whose sap carries a cold-burning light. The crown glows a steady blue-white bright enough to grow crops beneath it, and the Dark, which swallows every lamp men build, does not touch it.\n\nWickwoods can be extracted and replanted anywhere. A ring of them is a farm's sun.</description>
    <graphicData>
      <texPath>RM_Abyss/Things/Plant/RM_Wickwood</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shadowData>
        <volume>(0.4, 0.7, 0.24)</volume>
        <offset>(0,0,-0.76)</offset>
      </shadowData>
    </graphicData>
    <statBases>
      <Beauty>4</Beauty>
      <BeautyOutdoors>4</BeautyOutdoors>
      <MaxHitPoints>180</MaxHitPoints>
    </statBases>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>8</glowRadius>
        <overlightRadius>4.5</overlightRadius>
        <glowColor>(170,200,255,0)</glowColor>
      </li>
    </comps>
    <plant>
      <growMinGlow>0</growMinGlow>
      <growOptimalGlow>0</growOptimalGlow>
      <dieIfNoSunlight>false</dieIfNoSunlight>
      <fertilityMin>0.3</fertilityMin>
      <fertilitySensitivity>0.3</fertilitySensitivity>
      <growDays>14</growDays>
      <harvestYield>18</harvestYield>
      <wildClusterRadius>5</wildClusterRadius>
      <wildClusterWeight>8</wildClusterWeight>
      <minSpacingBetweenSamePlant>3.9</minSpacingBetweenSamePlant>
      <visualSizeRange>2.6~3.6</visualSizeRange>  <!-- owner, Abyss sheet 2026-10-05: "Twice as big." (was 1.3~1.8) -->
    </plant>
  </ThingDef>
</Defs>
