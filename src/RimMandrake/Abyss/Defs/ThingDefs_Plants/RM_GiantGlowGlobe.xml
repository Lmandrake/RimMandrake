<?xml version="1.0" encoding="utf-8"?>
<!--
  ABYSS_SHEET_DONOR_PORT_1. The giant glow globe: owned port of Alpha Biomes' giant gamma (sarg.alphabiomes
  AB_GiantGamma, 1.6/Defs/ThingDefs_Plants/Plants_ForsakenCrags.xml); plain name and description are the owner's
  (sheet 2026-10-05: "a BRIGHT natural sunlamp"). Every plant/stat/comp field is the donor's own EXCEPT:
    - placeWorker AlphaBiomes.PlaceWorker_ShowGammaRadius (donor C#) dropped; the overlight radius still works.
  Its CompGlower overlightRadius 7 is the sunlamp (GlowGrid.GroundGlowAt reads 1.0 inside it; see RM_Wickwood).
  ART (owner's "wire as picked"): abyss_greatbulgra_v1 (_a), abyss_giantglowglobe_b_v2 (_b),
  abyss_giantglowglobe_c_v2 (_c), all finished in the artpipe, awaiting install as
  RM_Abyss/Things/Plant/RM_GiantGlowGlobe/RM_GiantGlowGlobe_{a,b,c}.png.
-->
<Defs>
  <ThingDef ParentName="BushBase">
    <defName>RM_GiantGlowGlobe</defName>
    <label>giant glow globe</label>
    <description>The wild giant of the glow globe: a thick, twisted trunk lifting one huge glowing globe higher than a man, so bright it lights a farm-plot around it like a sunlamp. Light-shy plants and fungus should be kept well away from it.</description>
    <pathCost>10</pathCost>
    <graphicData>
      <texPath>RM_Abyss/Things/Plant/RM_GiantGlowGlobe</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <shadowData>
        <volume>(0.55, 0.17, 0.15)</volume>
        <offset>(0,0,-0.2)</offset>
      </shadowData>
    </graphicData>
    <plant>
      <growMinGlow>0</growMinGlow>
      <wildClusterRadius>10</wildClusterRadius>
      <wildClusterWeight>7.5</wildClusterWeight>
      <visualSizeRange>1.5~2</visualSizeRange>
      <sowResearchPrerequisites>
        <li>TreeSowing</li>
      </sowResearchPrerequisites>
      <blockAdjacentSow>true</blockAdjacentSow>
      <mustBeWildToSow>true</mustBeWildToSow>
      <sowTags>
        <li>Ground</li>
      </sowTags>
    </plant>
    <comps>
      <li Class="CompProperties_Glower">
        <overlightRadius>7</overlightRadius>
        <glowRadius>10</glowRadius>
        <glowColor>(242,221,37,0)</glowColor>
      </li>
    </comps>
  </ThingDef>
</Defs>
