<Defs>

  <ThingDef ParentName="RM_WreckFamily_Frame">
    <defName>RM_AbyssWindVane</defName>
    <label>storm-torn wind vane</label>
    <description>The snapped vane and hub of a wind-farm turbine, torn off by the chasm winds. Deconstruct it for valuable resources.</description>
    <modExtensions>
      <li Class="RimMandrake.Wreckage.RM_WreckWeathering">
        <weathering>RM_WreckWeathering_StormTorn</weathering>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="RM_WreckFamily_Tank">
    <defName>RM_AbyssWindPylon</defName>
    <label>storm-torn turbine housing</label>
    <description>A turbine's nacelle ripped open by the wind, its gravlite bearings still inside. Deconstruct it for valuable resources.</description>
    <modExtensions>
      <li Class="RimMandrake.Wreckage.RM_WreckWeathering">
        <weathering>RM_WreckWeathering_StormTorn</weathering>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
