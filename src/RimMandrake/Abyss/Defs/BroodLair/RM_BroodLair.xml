<?xml version="1.0" encoding="utf-8"?>
<!--
  ABYSS_LIGHTFALL_BROOD_WRECK_1 - the brood lair (Source/RM_BroodLair.cs, RM_BroodEgg.cs, RM_ShipWreck.cs,
  rules in RM_BroodWakeLogic.cs). Free RM_ tier: invented content, no campaign names. The campaign places it
  at Lightfall through UtinniPatches (RUT_Lightfall gets RM_BroodLairExtension).

  NOT FANTASY DRAGONS (owner, typed 2026-10-01): no fire breath, no hoard, no "dragon" in any defName, label
  or description. Alien megafauna in the krayt / zillo register.

  ART: every texture here is a PLACEHOLDER (own art reused from Stillsand/Miasma, vanilla eggs, ship chunks
  and resources). The brood-mother building draws the RM_Summ sprite scaled up. Owed: a coiled sleeping
  brood-mother, a summ egg, a great bone, the rescue-ship wreck, seven ship fittings.
  Numbers are PROVISIONAL.
-->
<Defs>

  <!-- ══ where a lair appears ══════════════════════════════════════════════ -->

  <!-- A generated planet's route: a rare mutator on Abyss tiles. No extraGenSteps: the genstep is global
       (Patches/RM_BroodLair_MapGen.xml) and reads this mutator or the landmark extension. -->
  <TileMutatorDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>RM_BroodLair</defName>
    <label>brood lair</label>
    <description>Something enormous nests at the bottom of this country, coiled round its eggs among the bones of its kind. A wrecked ship lies driven into the rock beside it.</description>
    <chanceOnNonLandmarkTile>0.003</chanceOnNonLandmarkTile>
    <biomeWhitelist>
      <li>RM_Abyss</li>
    </biomeWhitelist>
  </TileMutatorDef>

  <GenStepDef>
    <defName>RM_BroodLair</defName>
    <order>925</order>
    <genStep Class="RimMandrake.Abyss.RM_GenStep_BroodLair">
      <motherDef>RM_SummBroodMotherSleeping</motherDef>
      <eggDef>RM_SummEgg</eggDef>
      <greatBoneDef>RM_SummGreatBone</greatBoneDef>
      <boneDef>RM_SummBone</boneDef>
      <wreckDef>RM_RescueShipWreck</wreckDef>
      <eggCount>2~3</eggCount>
      <greatBones>4~6</greatBones>
      <boneHeaps>5~9</boneHeaps>
      <boneHeapSize>15~40</boneHeapSize>
    </genStep>
  </GenStepDef>

  <!-- ══ the brood-mother ═════════════════════════════════════════════════ -->

  <ThingDef ParentName="BuildingNaturalBase">
    <defName>RM_SummBroodMotherSleeping</defName>
    <label>sleeping brood-mother</label>
    <description>A summ so old and so large that she is part of the land: a ridge of armoured hide coiled round her clutch, her throat-sacs pulsing a faint storm-violet with each slow breath. She grazes on the Dark in her sleep. Light, the noise of cutting and the loss of an egg reach her; she stirs before she wakes. Awake, nothing you carry will bring her down.</description>
    <thingClass>RimMandrake.Abyss.Building_RM_BroodMother</thingClass>
    <graphicData>
      <texPath>RM_Abyss/Things/Pawn/Animal/RM_Summ/RM_Summ</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(15,15)</drawSize>
      <color>(0.82,0.78,0.9)</color>
    </graphicData>
    <size>(7,7)</size>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>1</fillPercent>
    <blockLight>true</blockLight>
    <blockWind>true</blockWind>
    <rotatable>false</rotatable>
    <useHitPoints>true</useHitPoints>
    <selectable>true</selectable>
    <statBases>
      <MaxHitPoints>100000</MaxHitPoints>
      <Flammability>0</Flammability>
      <Beauty>-10</Beauty>
    </statBases>
    <building>
      <claimable>false</claimable>
      <isInert>true</isInert>
    </building>
  </ThingDef>

  <PawnKindDef ParentName="AnimalKindBase">
    <defName>RM_SummAllRender</defName>
    <label>All-Render</label>
    <race>RM_Summ</race>
    <combatPower>5000</combatPower>
    <ecoSystemWeight>0</ecoSystemWeight>
    <wildGroupSize>1</wildGroupSize>
    <minGenerationAge>120</minGenerationAge>
    <lifeStages>
      <li><bodyGraphicData><texPath>RM_Abyss/Things/Pawn/Animal/RM_Summ/RM_Summ</texPath><graphicClass>Graphic_Multi</graphicClass><drawSize>15</drawSize></bodyGraphicData></li>
      <li><bodyGraphicData><texPath>RM_Abyss/Things/Pawn/Animal/RM_Summ/RM_Summ</texPath><graphicClass>Graphic_Multi</graphicClass><drawSize>15</drawSize></bodyGraphicData></li>
      <li><bodyGraphicData><texPath>RM_Abyss/Things/Pawn/Animal/RM_Summ/RM_Summ</texPath><graphicClass>Graphic_Multi</graphicClass><drawSize>15</drawSize></bodyGraphicData></li>
      <li><bodyGraphicData><texPath>RM_Abyss/Things/Pawn/Animal/RM_Summ/RM_Summ</texPath><graphicClass>Graphic_Multi</graphicClass><drawSize>15</drawSize></bodyGraphicData></li>
      <li><bodyGraphicData><texPath>RM_Abyss/Things/Pawn/Animal/RM_Summ/RM_Summ</texPath><graphicClass>Graphic_Multi</graphicClass><drawSize>15</drawSize></bodyGraphicData></li>
    </lifeStages>
  </PawnKindDef>

  <!-- Awake she is "essentially unkillable" (owner): almost nothing gets through, and no pain stops her. -->
  <HediffDef>
    <defName>RM_BroodMotherAwake</defName>
    <label>woken brood-mother</label>
    <description>She is awake and she is the size of the land. Almost nothing you can do reaches her. Run.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.75,0.55,0.95)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <stages>
      <li>
        <painFactor>0</painFactor>
        <statFactors>
          <IncomingDamageFactor>0.03</IncomingDamageFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <!-- ══ the clutch ═══════════════════════════════════════════════════════ -->

  <ThingDef>
    <defName>RM_SummEgg</defName>
    <label>summ egg</label>
    <description>A leathery egg the size of a crate, warm, faintly lit storm-violet from inside. Taken from a summ brood-mother's clutch. Kept away from her, it calls Witchfire storms and a summ comes looking. It will hatch a summing. A summing imprints only where a great bone of its kind stands aboard the ship; otherwise it hatches wild.</description>
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <drawerType>MapMeshOnly</drawerType>
    <altitudeLayer>Item</altitudeLayer>
    <alwaysHaulable>true</alwaysHaulable>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <rotatable>false</rotatable>
    <tickerType>Normal</tickerType>
    <stackLimit>1</stackLimit>
    <pathCost>14</pathCost>
    <graphicData>
      <texPath>Things/Item/Resource/AnimalProductRaw/EggOval</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>1.8</drawSize>
      <color>(150,120,190)</color>
    </graphicData>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <Mass>14</Mass>
      <MarketValue>2400</MarketValue>
      <Flammability>0.2</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>EggsFertilized</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="RimMandrake.Abyss.CompProperties_RM_SummEgg">
        <hatchDays>20</hatchDays>
        <hatchKind>RM_Summing</hatchKind>
        <greatBoneDef>RM_SummGreatBone</greatBoneDef>
        <bondedHungerHediff>RM_SummRuinousHunger</bondedHungerHediff>
        <stormIntervalDays>5~9</stormIntervalDays>
        <summComesAfterTicks>6000</summComesAfterTicks>
        <returnRadius>9</returnRadius>
      </li>
    </comps>
  </ThingDef>

  <!-- the bonded summing's appetite, driven by the hunger slider (severity = slider, 1 = shipped) -->
  <HediffDef>
    <defName>RM_SummRuinousHunger</defName>
    <label>ruinous hunger</label>
    <description>It eats as if it were already the size it will become. It never stops growing, and its appetite grows ahead of it.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>3</maxSeverity>
    <stages>
      <li><minSeverity>0</minSeverity><label>hungry</label><hungerRateFactor>1.25</hungerRateFactor></li>
      <li><minSeverity>0.9</minSeverity><label>ruinous</label><hungerRateFactor>1.6</hungerRateFactor></li>
      <li><minSeverity>1.5</minSeverity><label>voracious</label><hungerRateFactor>2.1</hungerRateFactor></li>
      <li><minSeverity>2.2</minSeverity><label>bottomless</label><hungerRateFactor>2.8</hungerRateFactor></li>
    </stages>
  </HediffDef>

  <!-- ══ the bone field ═══════════════════════════════════════════════════ -->

  <ThingDef ParentName="ResourceBase">
    <defName>RM_SummBone</defName>
    <label>summ bone</label>
    <description>Bone from the summ brood's dead: huge, honeycombed and surprisingly light, harder than it has any right to be. It works like timber and holds like stone.</description>
    <graphicData>
      <texPath>RM_Abyss/Things/Item/SummBone</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>75</stackLimit>
    <statBases>
      <MarketValue>3.2</MarketValue>
      <Mass>0.25</Mass>
      <MaxHitPoints>120</MaxHitPoints>
      <Flammability>0.2</Flammability>
      <DeteriorationRate>0.5</DeteriorationRate>
      <StuffPower_Armor_Sharp>0.75</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Blunt>0.3</StuffPower_Armor_Blunt>
      <StuffPower_Armor_Heat>0.25</StuffPower_Armor_Heat>
      <StuffPower_Insulation_Cold>4</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>4</StuffPower_Insulation_Heat>
      <SharpDamageMultiplier>0.9</SharpDamageMultiplier>
      <BluntDamageMultiplier>1.1</BluntDamageMultiplier>
    </statBases>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <stuffProps>
      <categories>
        <li>Woody</li>
      </categories>
      <color>(214,206,188)</color>
      <commonality>0</commonality>
      <constructEffect>ConstructWood</constructEffect>
      <soundImpactBullet>BulletImpact_Wood</soundImpactBullet>
      <soundMeleeHitSharp>MeleeHit_Wood</soundMeleeHitSharp>
      <soundMeleeHitBlunt>MeleeHit_Wood</soundMeleeHitBlunt>
      <statFactors>
        <MaxHitPoints>1.6</MaxHitPoints>
        <Beauty>1.3</Beauty>
        <WorkToMake>1.3</WorkToMake>
        <WorkToBuild>1.3</WorkToBuild>
        <Flammability>0.3</Flammability>
        <MeleeWeapon_CooldownMultiplier>0.95</MeleeWeapon_CooldownMultiplier>
      </statFactors>
    </stuffProps>
    <allowedArchonexusCount>40</allowedArchonexusCount>
  </ThingDef>

  <!-- One great bone must be installed ABOARD the gravship (on substructure) for an egg to imprint. -->
  <ThingDef ParentName="BuildingBase">
    <defName>RM_SummGreatBone</defName>
    <label>great summ bone</label>
    <description>A single bone from a brood-mother long dead, as long as a room and light enough for four to carry. Summ young are drawn to the bones of their kind: set one aboard your gravship and an egg hatched there will imprint on you. Uninstall it to move it.</description>
    <graphicData>
      <texPath>RM_Abyss/Things/Building/SummGreatBone</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(6,3)</drawSize>
    </graphicData>
    <size>(4,2)</size>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>40</pathCost>
    <fillPercent>0.4</fillPercent>
    <rotatable>true</rotatable>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsSpecial</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>600</MaxHitPoints>
      <Mass>40</Mass>
      <Beauty>12</Beauty>
      <MarketValue>900</MarketValue>
      <Flammability>0.2</Flammability>
      <WorkToBuild>2000</WorkToBuild>
    </statBases>
    <costList>
      <RM_SummBone>60</RM_SummBone>
    </costList>
    <building>
      <claimable>true</claimable>
      <alwaysDeconstructible>true</alwaysDeconstructible>
    </building>
    <placeWorkers>
      <li>PlaceWorker_OnSubstructure</li>
    </placeWorkers>
    <tradeability>Sellable</tradeability>
  </ThingDef>

</Defs>
