<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    RM_Abyss                    FORSAKENCRAGS_RM_MOD_BUILD_1, new 2026-09-25

    Copied verbatim from the frozen src/RimUtinni/UtinniPatches/Defs/BiomeDefs/
    RUT_Abyss.xml (150 lines, authored 2026-09-09) per
    design/RimMandrake/biome_mod_architecture.md §5 Phase A step 2. Every field
    below is the twin's own content, unchanged, EXCEPT:

      - workerClass: the donor AlphaBiomes.BiomeWorker_RockyCrags becomes this
        mod's own RM_BiomeWorker_Abyss (§5 step 2 — a donor type in
        workerClass is a hard dependency the RimMandrake tier may not assume).
        The new worker's placement ranges are [INVENTED], same footing as the
        sibling Gelatinous Slime/Flooded Canyon mods' own worker ranges.

    Everything else — texture, terrain, weather, diseases — is the twin's content unchanged.
    wildAnimals/wildPlants: ABYSS_SHEET_DONOR_PORT_1 (owner's Abyss sheet 2026-10-05) replaced the 8 Alpha
    Animals and 7 Alpha Biomes/Alpha Genes rows with owned RM_ ports at the same commonality, and AB_GlowingGrass with
    RM_GlowingGrass (2026-10-06); no donor row remains in either list. Zero RSW_/SW_/RUT_ rows exist in the
    twin's wildAnimals, so nothing moves to a Utinni patch from THIS def; the
    Cindermare and Skarnix are invented, not canon, so they ship inline here as RM_Cindermare/RM_Skarnix
    (ABYSS_INVENTED_CREATURES_TO_RM_1); no Star Wars patch wires them any more.

    ⚠️ NOT donor-free: terrain/texture still name Alpha Biomes defs with no guard
    (inherited from the twin) — see About.xml for the disclosure.
  -->

  <BiomeDef>
    <defName>RM_Abyss</defName>
    <label>the Abyss</label>
    <description>A country of obsidian-black stone twisted into shapes no wind carved, drowned in a darkness that behaves like a substance: it fills the air, it pools, it parts without warning into pockets of impossibly clear air, and it closes again. Light is eaten in transit here, not merely absent. The only reliable illumination is biological -- glowing grass, blue darklight gammas, yellow giant flora -- a land lit like a harbor at night, by its own lamps.</description>
    <workerClass>RimMandrake.Abyss.RM_BiomeWorker_Abyss</workerClass>
    <foragedFood>RawAgave</foragedFood>
    <allowRoads>true</allowRoads>
    <allowRivers>true</allowRivers>
    <allowFarmingCamps>true</allowFarmingCamps>
    <animalDensity>1.8</animalDensity>
    <plantDensity>0.5</plantDensity>
    <forageability>0.5</forageability>
    <movementDifficulty>1</movementDifficulty>
    <texture>Biomes/AB_RockyCrags</texture>
    <diseaseMtbDays>65</diseaseMtbDays>
    <diseases>
      <li>
        <diseaseInc>Disease_Flu</diseaseInc>
        <commonality>100</commonality>
      </li>
      <li>
        <diseaseInc>Disease_Plague</diseaseInc>
        <commonality>100</commonality>
      </li>
      <li>
        <diseaseInc>Disease_GutWorms</diseaseInc>
        <commonality>60</commonality>
      </li>
      <li>
        <diseaseInc>Disease_MuscleParasites</diseaseInc>
        <commonality>60</commonality>
      </li>
      <li>
        <diseaseInc>Disease_FibrousMechanites</diseaseInc>
        <commonality>30</commonality>
      </li>
      <li>
        <diseaseInc>Disease_SensoryMechanites</diseaseInc>
        <commonality>30</commonality>
      </li>
      <li>
        <diseaseInc>Disease_AnimalFlu</diseaseInc>
        <commonality>100</commonality>
      </li>
      <li>
        <diseaseInc>Disease_AnimalPlague</diseaseInc>
        <commonality>100</commonality>
      </li>
    </diseases>
    <terrainsByFertility>
      <li>
        <terrain>AB_FineForsakenSand</terrain>
        <min>-999</min>
        <max>0.5</max>
      </li>
      <li>
        <terrain>AB_ForsakenSand</terrain>
        <min>0.5</min>
        <max>999</max>
      </li>
    </terrainsByFertility>
    <baseWeatherCommonalities>
      <Clear>0</Clear>
      <RM_AbyssDark>70</RM_AbyssDark>  <!-- ABYSS_DARK_BUILD_1: the permanent state -->
      <RM_AbyssUnveiling>0.5</RM_AbyssUnveiling>  <!-- rare, brief lift -->
      <RM_AbyssWitchfire>4</RM_AbyssWitchfire>  <!-- storms; thunder is sometimes the Summ calling -->
    </baseWeatherCommonalities>
    <wildAnimals>
      <RM_Durrgak>0.4</RM_Durrgak>  <!-- ABYSS_DURRGAK_BUILD_1: the placer; this biome only -->
      <RM_Gharrek>0.6</RM_Gharrek>  <!-- ABYSS_GHARREK_BUILD_1: gust-feeder, base of the web; this biome only -->
      <RM_Krizzak>0.3</RM_Krizzak>  <!-- ABYSS_KRIZZAK_BUILD_1: light-thief flier; this biome only -->
      <RM_Drokattak>0.12</RM_Drokattak>  <!-- ABYSS_DONOR_BEASTS_FREED_1: quill ambusher, replaces the donor zhurrakor; this biome only -->
      <RM_Summ>0.01</RM_Summ>  <!-- ABYSS_DONOR_BEASTS_FREED_1: storm giant, a rare passing terror (also comes down in Witchfire storms); this biome only -->
      <RM_Cindermare>0.04</RM_Cindermare>  <!-- ABYSS_INVENTED_CREATURES_TO_RM_1: grip-drain solitary predator; rarer than the skarnix; this biome only -->
      <RM_Skarnix>0.09</RM_Skarnix>  <!-- ABYSS_INVENTED_CREATURES_TO_RM_1: firelight-averse ambush stalker; this biome only -->
      <RM_Lirrith>1.0</RM_Lirrith>  <!-- ABYSS_SHEET_DONOR_PORT_1: lirrith, port of AA_Murkling (small; boosted from 0.5 for the ecosystem pyramid law); this biome only -->
      <RM_Aveluthia>0.5</RM_Aveluthia>  <!-- ABYSS_SHEET_DONOR_PORT_1: aveluthia, port of AA_NightMule (large); this biome only -->
      <RM_Moravatha>0.35</RM_Moravatha>  <!-- ABYSS_SHEET_DONOR_PORT_1: moravatha, port of AA_CrepuscularBeetle (large); this biome only -->
      <RM_Ysvaltha>0.2</RM_Ysvaltha>  <!-- ABYSS_SHEET_DONOR_PORT_1: ysvaltha, port of AA_DuskProwler (medium predator); this biome only -->
      <RM_Sesserith>0.2</RM_Sesserith>  <!-- ABYSS_SHEET_DONOR_PORT_1: sesserith, port of AA_Nightling (medium apex); this biome only -->
      <RM_Ossumatha>0.15</RM_Ossumatha>  <!-- ABYSS_SHEET_DONOR_PORT_1: ossumatha, port of AA_DarkVandal (medium); this biome only -->
      <RM_Olumetha>0.09</RM_Olumetha>  <!-- ABYSS_SHEET_DONOR_PORT_1: olumetha, port of AA_NightRam (large); this biome only -->
      <RM_Nevarithia>0.005</RM_Nevarithia>  <!-- ABYSS_SHEET_DONOR_PORT_1: nevarithia, port of AA_Darkbeast (medium); this biome only -->
    </wildAnimals>
    <coastalWildAnimals />
    <wildPlants>
      <RM_GlowingGrass>1.0</RM_GlowingGrass>  <!-- ABYSS_SHEET_DONOR_PORT_1: port of AB_GlowingGrass -->
      <RM_SicklyGlowMushroom>0.6</RM_SicklyGlowMushroom>  <!-- ABYSS_SHEET_DONOR_PORT_1: port of AB_ToxicGamma (polluted ground only, as the donor) -->
      <RM_GiantGlowGlobe>0.5</RM_GiantGlowGlobe>  <!-- ABYSS_SHEET_DONOR_PORT_1: port of AB_GiantGamma -->
      <RM_GlowberryBush>0.5</RM_GlowberryBush>  <!-- ABYSS_SHEET_DONOR_PORT_1: port of AB_WildRadagast -->
      <RM_GlowGlobe>0.5</RM_GlowGlobe>  <!-- ABYSS_SHEET_DONOR_PORT_1: port of AG_Gamma (x2 size) -->
      <RM_TreeMushroom>0.3</RM_TreeMushroom>  <!-- ABYSS_SHEET_DONOR_PORT_1: port of AB_GiantStikehr (x4 size) -->
      <RM_PaddleVine>0.25</RM_PaddleVine>  <!-- ABYSS_SHEET_DONOR_PORT_1: port of AG_Septimum -->
      <RM_GiantFibreStalk>0.2</RM_GiantFibreStalk>  <!-- ABYSS_SHEET_DONOR_PORT_1: port of AB_GiantSeptimum (x2 size) -->
      <RM_Etchcap>0.15</RM_Etchcap>  <!-- ABYSS_ETCHCAP_BUILD_1: grows only on RM_EtchHollow -->
      <RM_Wickwood>0.2</RM_Wickwood>  <!-- ABYSS_LAMP_CROPS_BUILD_1: the lamp-crop tree; struck at startup when lampCropsEnabled is off -->
    </wildPlants>
    <wildPlantRegrowDays>27</wildPlantRegrowDays>
    <!-- ABYSS_DURRGAK_BUILD_1: the durrgak's den, shard rings and salvage cache on each new map (Mod Setting). -->
    <extraGenSteps>
      <li>RM_DurrgakSigns</li>
      <li>RM_AbyssRumorSites</li>
      <li>RM_WreckField_Abyss</li>  <!-- SALVAGE_WRECKAGE_EVERYWHERE_1 -->
    </extraGenSteps>
    <modExtensions>
      <!-- ABYSS_HIDDEN_SHIP_PROBES_1: scouts that test a hidden gravship. Empty list = a vanilla light mech. The campaign layer patches its probe droids in here. -->
      <li Class="RimMandrake.Abyss.RM_AbyssProbeExtension">
        <probeKinds />
      </li>
    </modExtensions>
  </BiomeDef>

</Defs>
