<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    DONOR RETIREMENT (owner, 2026-10-18: "Just put in placeholder art for now or donor copies and retire these
    mods!!! Just get it done."). Alpha Biomes (sarg.alphabiomes) defs the frozen campaign twin of the Abyss (RUT_Abyss)
    (src/RimUtinni/UtinniPatches/Defs/BiomeDefs) still named, ported as RM_ defs with the donor's own values so the
    painted planet keeps its ground and flora. Art: StandIn/<donor texPath> marked stand-in copies (art ledger,
    provenance kind=donor standin=true) until regenerated; texPaths not served by Alpha Biomes are left as they were.
  -->
  <!-- RM_ForsakenNight: port of AB_ForsakenNight (Alpha Biomes 1.6/Defs/WeatherDefs/Weathers.xml), plain XML copy 2026-10-18 for donor retirement. -->
  <WeatherDef>
    <defName>RM_ForsakenNight</defName>
    <label>forsaken fog</label>
    <description>A preternatural darkness that seeps into your very soul. Even during the "day" brightness will be very low, so lighting is going to be absolutely essential. Nights are going to be REALLY dark.</description>
    <accuracyMultiplier>0.6</accuracyMultiplier>
    <repeatable>true</repeatable>
    <favorability>Good</favorability>
    <perceivePriority>0</perceivePriority>
    <weatherThought>RM_ForsakenNight</weatherThought>
    <ambientSounds>
      <li>Ambient_Wind_Fog</li>
    </ambientSounds>
    <!-- Colors are Super Dark -->
    <skyColorsDay>
      <sky>(0.45,0.50,0.55)</sky>
      <shadow>(0.92,0.92,0.92)</shadow>
      <overlay>(0.5,0.5,0.5)</overlay>
      <saturation>0.9</saturation>
    </skyColorsDay>
    <skyColorsDusk>
      <sky>(0.35,0.40,0.45)</sky>
      <shadow>(0.92,0.92,0.92)</shadow>
      <overlay>(0.5,0.5,0.5)</overlay>
      <saturation>0.9</saturation>
    </skyColorsDusk>
    <skyColorsNightEdge>
      <sky>(0.1,0.1,0.1)</sky>
      <shadow>(0.92,0.92,0.92)</shadow>
      <overlay>(0.5,0.5,0.5)</overlay>
      <saturation>0.6</saturation>
    </skyColorsNightEdge>
    <skyColorsNightMid>
      <sky>(0.01,0.01,0.01)</sky>
      <shadow>(0.92,0.92,0.92)</shadow>
      <overlay>(0.5,0.5,0.5)</overlay>
      <saturation>0.6</saturation>
    </skyColorsNightMid>
  </WeatherDef>

  <!-- RM_ForsakenThunderstorm: port of AB_ForsakenThunderstorm (Alpha Biomes 1.6/Defs/WeatherDefs/Weathers.xml), plain XML copy 2026-10-18 for donor retirement. -->
  <WeatherDef>
    <defName>RM_ForsakenThunderstorm</defName>
    <label>forsaken thunderstorm</label>
    <description>A preternatural darkness that seeps into your very soul. Now with a dry thunderstorm! Isn't it great?</description>
    <accuracyMultiplier>0.3</accuracyMultiplier>
    <repeatable>true</repeatable>
    <favorability>VeryBad</favorability>
    <perceivePriority>2</perceivePriority>
    <weatherThought>RM_ForsakenThunderstorm</weatherThought>
    <windSpeedFactor>1.5</windSpeedFactor>
    <ambientSounds>
      <li>Ambient_Wind_Storm</li>
    </ambientSounds>
    <durationRange>
      <min>15000</min>
      <max>40000</max>
    </durationRange>
    <eventMakers>
      <li>
        <averageInterval>1200</averageInterval>
        <eventClass>WeatherEvent_LightningFlash</eventClass>
      </li>
      <li>
        <averageInterval>1200</averageInterval>
        <eventClass>WeatherEvent_LightningStrike</eventClass>
      </li>
    </eventMakers>
    <!-- Colors are Super Dark -->
    <skyColorsDay>
      <sky>(0.35,0.40,0.45)</sky>
      <shadow>(0.92,0.92,0.92)</shadow>
      <overlay>(0.5,0.5,0.5)</overlay>
      <saturation>0.9</saturation>
    </skyColorsDay>
    <skyColorsDusk>
      <sky>(0.35,0.40,0.45)</sky>
      <shadow>(0.92,0.92,0.92)</shadow>
      <overlay>(0.5,0.5,0.5)</overlay>
      <saturation>0.9</saturation>
    </skyColorsDusk>
    <skyColorsNightEdge>
      <sky>(0.1,0.1,0.1)</sky>
      <shadow>(0.92,0.92,0.92)</shadow>
      <overlay>(0.5,0.5,0.5)</overlay>
      <saturation>0.6</saturation>
    </skyColorsNightEdge>
    <skyColorsNightMid>
      <sky>(0.01,0.01,0.01)</sky>
      <shadow>(0.92,0.92,0.92)</shadow>
      <overlay>(0.5,0.5,0.5)</overlay>
      <saturation>0.6</saturation>
    </skyColorsNightMid>
  </WeatherDef>

  <!-- RM_ForsakenRainyNight: port of AB_ForsakenRainyNight (Alpha Biomes 1.6/Defs/WeatherDefs/Weathers.xml), plain XML copy 2026-10-18 for donor retirement. -->
  <WeatherDef>
    <defName>RM_ForsakenRainyNight</defName>
    <label>forsaken rain</label>
    <temperatureRange>
      <min>-15</min>
      <max>100</max>
    </temperatureRange>
    <description>A preternatural darkness that seeps into your very soul. A freezing rain of supercooled water has started to drop from the darkened sky.</description>
    <accuracyMultiplier>0.6</accuracyMultiplier>
    <windSpeedFactor>1.5</windSpeedFactor>
    <favorability>Neutral</favorability>
    <perceivePriority>1</perceivePriority>
    <weatherThought>RM_ForsakenRain</weatherThought>
    <moveSpeedMultiplier>0.9</moveSpeedMultiplier>
    <rainRate>1</rainRate>
    <ambientSounds>
      <li>Ambient_Rain</li>
    </ambientSounds>
    <overlayClasses>
      <li>WeatherOverlay_Rain</li>
    </overlayClasses>
    <commonalityRainfallFactor>
      <points>
        <li>(0, 0)</li>
        <li>(1300, 1)</li>
        <li>(4000, 3.0)</li>
      </points>
    </commonalityRainfallFactor>
    <!-- Colors are Super Dark -->
    <skyColorsDay>
      <sky>(0.45,0.50,0.55)</sky>
      <shadow>(0.92,0.92,0.92)</shadow>
      <overlay>(0.5,0.5,0.5)</overlay>
      <saturation>0.9</saturation>
    </skyColorsDay>
    <skyColorsDusk>
      <sky>(0.35,0.40,0.45)</sky>
      <shadow>(0.92,0.92,0.92)</shadow>
      <overlay>(0.5,0.5,0.5)</overlay>
      <saturation>0.9</saturation>
    </skyColorsDusk>
    <skyColorsNightEdge>
      <sky>(0.1,0.1,0.1)</sky>
      <shadow>(0.92,0.92,0.92)</shadow>
      <overlay>(0.5,0.5,0.5)</overlay>
      <saturation>0.6</saturation>
    </skyColorsNightEdge>
    <skyColorsNightMid>
      <sky>(0.01,0.01,0.01)</sky>
      <shadow>(0.92,0.92,0.92)</shadow>
      <overlay>(0.5,0.5,0.5)</overlay>
      <saturation>0.6</saturation>
    </skyColorsNightMid>
  </WeatherDef>

  <!-- RM_ForsakenNight: port of AB_ForsakenNight (Alpha Biomes 1.6/Defs/ThoughtDefs/Thoughts_Weather.xml), plain XML copy 2026-10-18 for donor retirement. -->
  <ThoughtDef>
    <defName>RM_ForsakenNight</defName>
    <durationDays>0.1</durationDays>
    <stackLimit>1</stackLimit>
    <nullifyingTraits>
      <li>Psychopath</li>
      <li>NightOwl</li>
    </nullifyingTraits>
    <nullifyingPrecepts>
      <li MayRequire="Ludeon.RimWorld.Ideology">Darklight_Preferred</li>
    </nullifyingPrecepts>
    <stages>
      <li>
        <label>preternatural darkness</label>
        <description>It is as if the sun itself was being drowned in despair. I hate it.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
    </stages>
    <nullifyingGenes>
    </nullifyingGenes>
  </ThoughtDef>

