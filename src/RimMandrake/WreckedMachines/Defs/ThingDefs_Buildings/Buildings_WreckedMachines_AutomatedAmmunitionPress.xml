<?xml version="1.0" encoding="utf-8"?>
<!--
  WreckedMachines - the automated ammunition press line (key ammopress, line number 14): three level defs. The Original is the factory mod's own VFEFactory_AutomatedAmmunitionPress.
  Stamped by Source/onboard.py from the row beside it and the donor def; do not edit by hand: change the row, or the tool, and stamp again.
  DONOR: 1.6/Defs/ThingDefs_Buildings/Buildings_Factories.xml, ThingDef VFEFactory_AutomatedAmmunitionPress (line 926 of that file), factory mod folder as read at stamp time.
-->
<Defs>
  <!--WRECKED. Dead. Occupies its tiles and nothing else. Can be carried.-->
  <ThingDef ParentName="BuildingBase">
    <defName>RM_WM_AutomatedAmmunitionPress_Wrecked</defName>
    <label>wrecked automated ammunition press</label>
    <description>What is left of an automated ammunition press. It has no power in it and nothing to give.\n\nA researcher can study it where it stands, and what they learn opens the research to patch it back into service. It can be carried. The repair itself is ordered on the machine, once the research is done.</description>
    <drawerType>MapMeshOnly</drawerType>
    <graphicData>
      <texPath>WreckedMachines/Factories/AutomatedAmmunitionPress/Wrecked/AutomatedAmmunitionPress</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(4,5)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <thingCategories>
      <li>VFEFactory_FactoryCategory</li>
    </thingCategories>
    <costList>
      <Steel>25</Steel>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>true</rotatable>
    <neverMultiSelect>true</neverMultiSelect>
    <uiIconScale>0.8</uiIconScale>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>True</useHitPoints>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <statBases>
      <Mass>60</Mass>
      <Beauty>-42</Beauty>
      <WorkToBuild>800</WorkToBuild>
      <MaxHitPoints>400</MaxHitPoints>
      <Flammability>0.5</Flammability>
    </statBases>
    <tickerType>Never</tickerType>
    <size>(3,4)</size>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <minifiedDef>MinifiedThing</minifiedDef>
    <building>
      <deconstructible>true</deconstructible>
      <isInert>true</isInert>
      <buildingTags>
        <li>Production</li>
        <li>RM_RuinDrawsConduit</li>
        <!-- draw only: it joins no net -->
      </buildingTags>
    </building>
    <comps>
      <li Class="CompProperties_CompAnalyzableUnlockResearch">
        <compClass>RimMandrake.WreckedMachines.CompMachineStudy</compClass>
        <analysisID>77120141</analysisID>
        <requiresMechanitor>false</requiresMechanitor>
        <canStudyInPlace>true</canStudyInPlace>
        <analysisRequiredRange>3~3</analysisRequiredRange>
        <analysisDurationHours>4</analysisDurationHours>
        <cooldownTicks>20000</cooldownTicks>
        <destroyedOnAnalyzed>false</destroyedOnAnalyzed>
        <activateTexPath>UI/Icons/Study</activateTexPath>
        <jobString>study the wrecked automated ammunition press</jobString>
        <inspectString>A researcher can study how this automated ammunition press was put together.</inspectString>
        <completedLetterLabel>Wrecked automated ammunition press studied: {RESEARCH} unlocked</completedLetterLabel>
        <completedLetter>By studying the wrecked automated ammunition press, {PAWN_labelShort} has worked out how it can be patched back into service.\n\nThe research project {RESEARCH} can now be done at a research bench. Once it is done, order the repair on the automated ammunition press itself.</completedLetter>
        <completedLetterDef>PositiveEvent</completedLetterDef>
        <targetingParameters>
          <canTargetBuildings>false</canTargetBuildings>
          <canTargetAnimals>false</canTargetAnimals>
          <canTargetMechs>false</canTargetMechs>
          <onlyTargetControlledPawns>true</onlyTargetControlledPawns>
        </targetingParameters>
      </li>
      <li Class="RimMandrake.WreckedMachines.CompProperties_WreckedMachine"/>
    </comps>
    <modExtensions>
      <li Class="RimMandrake.WreckedMachines.WreckedMachineGrade">
        <grade>Wrecked</grade>
        <line>ammopress</line>
      </li>
    </modExtensions>
  </ThingDef>
  <!--KLUDGED. Runs, badly, on part of the original's work.-->
  <ThingDef ParentName="BuildingBase">
    <defName>RM_WM_AutomatedAmmunitionPress_Kludged</defName>
    <label>kludged automated ammunition press</label>
    <description>An automated ammunition press dragged back into service by people who did not build it. The worst of the damage is plated over and the wiring is spliced by hand.\n\nIt can only do part of what the original did: make high-explosive shells; make incendiary shells. The rest of the original's work is beyond it. It draws more power, runs hotter than it should, breaks down often and cannot be overclocked. The splicing holds it in place, so it cannot be carried.\n\nA researcher can study it further, and what they learn opens the research to refurbish it properly. The refurbishment is ordered on the machine and needs an ancient component.\n\nFactory buildings need factory hoppers for input and output. Needs factory floor.</description>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>WreckedMachines/Factories/AutomatedAmmunitionPress/Kludged/AutomatedAmmunitionPress</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(4,5)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <costList>
      <Steel>100</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <terrainAffordanceNeeded>FactoryFloor</terrainAffordanceNeeded>
    <rotatable>true</rotatable>
    <neverMultiSelect>true</neverMultiSelect>
    <uiIconScale>0.8</uiIconScale>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>True</useHitPoints>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <statBases>
      <Mass>60</Mass>
      <Beauty>-28</Beauty>
      <WorkToBuild>2500</WorkToBuild>
      <MaxHitPoints>270</MaxHitPoints>
      <Flammability>1</Flammability>
      <VEF_BuildingMaxOverclockFactor>1</VEF_BuildingMaxOverclockFactor>
      <VEF_BuildingBreakdownFactor>2</VEF_BuildingBreakdownFactor>
    </statBases>
    <tickerType>Rare</tickerType>
    <size>(3,4)</size>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-2)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <building>
      <deconstructible>true</deconstructible>
      <relatedBuildCommands>
        <li>VFEFactory_FactoryHopper</li>
      </relatedBuildCommands>
      <buildingTags>
        <li>Production</li>
      </buildingTags>
      <workTableRoomRole>VFEFactory_FactoryRoom</workTableRoomRole>
      <workTableNotInRoomRoleFactor>0.5</workTableNotInRoomRoleFactor>
    </building>
    <inspectorTabs>
      <li>PipeSystem.ITab_Processor</li>
    </inspectorTabs>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>480</basePowerConsumption>
      </li>
      <li>
        <compClass>PipeSystem.CompPowerTrader_Overclocked</compClass>
      </li>
      <li Class="CompProperties_HeatPusher">
        <compClass>PipeSystem.CompHeatPusherPowered_Overclocked</compClass>
        <heatPerSecond>8</heatPerSecond>
        <heatPushMaxTemperature>66</heatPushMaxTemperature>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="PipeSystem.CompProperties_AdvancedResourceProcessor">
        <notWorkingKey>VFEFactory_FactoryNotWorking</notWorkingKey>
        <canOverclock>false</canOverclock>
        <alwaysShowProgressBar>true</alwaysShowProgressBar>
        <!-- Part of the donor's list: the row's kludgedProcesses. -->
        <processes>
          <li>VFEFactory_MakeHighExplosiveShells</li>
          <li>VFEFactory_MakeIncendiaryShells</li>
        </processes>
        <hideSettings>true</hideSettings>
      </li>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>VFEFactory_Booster</li>
          <li>VFEFactory_Heatsink</li>
        </linkableFacilities>
      </li>
      <li MayRequire="VanillaExpanded.VChemfuelE" Class="PipeSystem.CompProperties_Resource">
        <pipeNet>VCHE_ChemfuelNet</pipeNet>
      </li>
      <li Class="CompProperties_CompAnalyzableUnlockResearch">
        <compClass>RimMandrake.WreckedMachines.CompMachineStudy</compClass>
        <analysisID>77120142</analysisID>
        <requiresMechanitor>false</requiresMechanitor>
        <canStudyInPlace>true</canStudyInPlace>
        <analysisRequiredRange>3~3</analysisRequiredRange>
        <analysisDurationHours>4</analysisDurationHours>
        <cooldownTicks>20000</cooldownTicks>
        <destroyedOnAnalyzed>false</destroyedOnAnalyzed>
        <activateTexPath>UI/Icons/Study</activateTexPath>
        <jobString>study the kludged automated ammunition press</jobString>
        <inspectString>A researcher can study how to refurbish this automated ammunition press.</inspectString>
        <completedLetterLabel>Kludged automated ammunition press studied: {RESEARCH} unlocked</completedLetterLabel>
        <completedLetter>By studying the kludged automated ammunition press, {PAWN_labelShort} has found which of its splices can stay and which must be redone to bring the machine close to what it was.\n\nThe research project {RESEARCH} can now be done at a research bench. Once it is done, order the refurbishment on the automated ammunition press itself. It needs an ancient component.</completedLetter>
        <completedLetterDef>PositiveEvent</completedLetterDef>
        <targetingParameters>
          <canTargetBuildings>false</canTargetBuildings>
          <canTargetAnimals>false</canTargetAnimals>
          <canTargetMechs>false</canTargetMechs>
          <onlyTargetControlledPawns>true</onlyTargetControlledPawns>
        </targetingParameters>
      </li>
      <li Class="RimMandrake.WreckedMachines.CompProperties_WreckedMachine"/>
    </comps>
    <modExtensions>
      <li Class="RimMandrake.WreckedMachines.WreckedMachineGrade">
        <grade>Kludged</grade>
        <line>ammopress</line>
      </li>
    </modExtensions>
  </ThingDef>
  <!--REFURBISHED. All the original's work; no overclock; a little less reliable. Draws the donor's own picture.-->
  <ThingDef ParentName="BuildingBase">
    <defName>RM_WM_AutomatedAmmunitionPress_Refurbished</defName>
    <label>refurbished automated ammunition press</label>
    <description>An automated ammunition press refurbished from salvage by people who learned it from the wreck. The breaches are sealed, the wiring is mostly original again, and an ancient component holds the worst of it together.\n\nIt does everything the original did. It draws a little more power, runs a little hotter, breaks down more often and cannot be overclocked. It can be carried.\n\nFactory buildings need factory hoppers for input and output. Needs factory floor.</description>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Factories/AutomatedAmmunitionPress/AutomatedAmmunitionPress</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(4,5)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <thingCategories>
      <li>VFEFactory_FactoryCategory</li>
    </thingCategories>
    <costList>
      <Steel>170</Steel>
      <ComponentIndustrial>6</ComponentIndustrial>
      <RM_WM_AncientComponent>1</RM_WM_AncientComponent>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <terrainAffordanceNeeded>FactoryFloor</terrainAffordanceNeeded>
    <rotatable>true</rotatable>
    <neverMultiSelect>true</neverMultiSelect>
    <uiIconScale>0.8</uiIconScale>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>True</useHitPoints>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <statBases>
      <Mass>60</Mass>
      <Beauty>-21</Beauty>
      <WorkToBuild>3400</WorkToBuild>
      <MaxHitPoints>360</MaxHitPoints>
      <Flammability>1</Flammability>
      <VEF_BuildingMaxOverclockFactor>1</VEF_BuildingMaxOverclockFactor>
      <VEF_BuildingBreakdownFactor>1.5</VEF_BuildingBreakdownFactor>
    </statBases>
    <tickerType>Rare</tickerType>
    <size>(3,4)</size>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-2)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <building>
      <relatedBuildCommands>
        <li>VFEFactory_FactoryHopper</li>
      </relatedBuildCommands>
      <buildingTags>
        <li>Production</li>
      </buildingTags>
      <workTableRoomRole>VFEFactory_FactoryRoom</workTableRoomRole>
      <workTableNotInRoomRoleFactor>0.5</workTableNotInRoomRoleFactor>
    </building>
    <inspectorTabs>
      <li>PipeSystem.ITab_Processor</li>
    </inspectorTabs>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>440</basePowerConsumption>
      </li>
      <li>
        <compClass>PipeSystem.CompPowerTrader_Overclocked</compClass>
      </li>
      <li Class="CompProperties_HeatPusher">
        <compClass>PipeSystem.CompHeatPusherPowered_Overclocked</compClass>
        <heatPerSecond>7</heatPerSecond>
        <heatPushMaxTemperature>66</heatPushMaxTemperature>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="PipeSystem.CompProperties_AdvancedResourceProcessor">
        <notWorkingKey>VFEFactory_FactoryNotWorking</notWorkingKey>
        <canOverclock>false</canOverclock>
        <alwaysShowProgressBar>true</alwaysShowProgressBar>
        <processes>
          <li>VFEFactory_MakeHighExplosiveShells</li>
          <li>VFEFactory_MakeIncendiaryShells</li>
          <li>VFEFactory_MakeEMPShells</li>
          <li>VFEFactory_MakeFirefoamShells</li>
          <li>VFEFactory_MakeSmokeShells</li>
          <li MayRequire="Ludeon.RimWorld.Biotech">VFEFactory_MakeToxShells</li>
          <li MayRequire="sarg.alphabiomes">VFEFactory_MakeTarShells</li>
          <li MayRequire="OskarPotocki.VFE.Deserters">VFEFactory_MakeShrapnelShells</li>
          <li MayRequire="OskarPotocki.VFE.Deserters">VFEFactory_MakeArmorPiercingShells</li>
          <li MayRequire="OskarPotocki.VFE.Deserters">VFEFactory_MakeClusterShells</li>
          <li MayRequire="Ludeon.RimWorld.Anomaly">VFEFactory_MakeDeadlifeShells</li>
        </processes>
        <hideSettings>true</hideSettings>
      </li>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>VFEFactory_Booster</li>
          <li>VFEFactory_Heatsink</li>
        </linkableFacilities>
      </li>
      <li MayRequire="VanillaExpanded.VChemfuelE" Class="PipeSystem.CompProperties_Resource">
        <pipeNet>VCHE_ChemfuelNet</pipeNet>
      </li>
      <li Class="RimMandrake.WreckedMachines.CompProperties_WreckedMachine"/>
    </comps>
    <minifiedDef>MinifiedThing</minifiedDef>
    <modExtensions>
      <li Class="RimMandrake.WreckedMachines.WreckedMachineGrade">
        <grade>Refurbished</grade>
        <line>ammopress</line>
      </li>
    </modExtensions>
  </ThingDef>
</Defs>
