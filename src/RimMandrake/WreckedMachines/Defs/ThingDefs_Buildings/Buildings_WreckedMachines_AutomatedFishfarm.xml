<?xml version="1.0" encoding="utf-8"?>
<!--
  WreckedMachines - the automated fishfarm line (key fishfarm, line number 19): three level defs. The Original is the factory mod's own VFEFactory_AutomatedFishfarm.
  Stamped by Source/onboard.py from the row beside it and the donor def; do not edit by hand: change the row, or the tool, and stamp again.
  DONOR: 1.6/Mods/Odyssey/Defs/ThingDefs_Buildings/Buildings_Factories_Odyssey.xml, ThingDef VFEFactory_AutomatedFishfarm (line 4 of that file), factory mod folder as read at stamp time.
-->
<Defs>
  <!--WRECKED. Dead. Occupies its tiles and nothing else. Can be carried.-->
  <ThingDef ParentName="BuildingBase">
    <defName>RM_WM_AutomatedFishfarm_Wrecked</defName>
    <label>wrecked automated fishfarm</label>
    <description>What is left of an automated fishfarm. It has no power in it and nothing to give.\n\nA researcher can study it where it stands, and what they learn opens the research to patch it back into service. It can be carried. The repair itself is ordered on the machine, once the research is done.</description>
    <drawerType>MapMeshOnly</drawerType>
    <graphicData>
      <texPath>WreckedMachines/Factories/AutomatedFishfarm/Wrecked/AutomatedFishfarm</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(4,4)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <thingCategories>
      <li>VFEFactory_FactoryCategory</li>
    </thingCategories>
    <costList>
      <Steel>15</Steel>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>true</rotatable>
    <neverMultiSelect>true</neverMultiSelect>
    <uiIconScale>0.8</uiIconScale>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>True</useHitPoints>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <statBases>
      <Mass>35</Mass>
      <Beauty>-18</Beauty>
      <WorkToBuild>600</WorkToBuild>
      <MaxHitPoints>300</MaxHitPoints>
      <Flammability>0.5</Flammability>
    </statBases>
    <tickerType>Never</tickerType>
    <size>(3,3)</size>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <minifiedDef>MinifiedThing</minifiedDef>
    <building>
      <deconstructible>true</deconstructible>
      <isInert>true</isInert>
      <buildingTags>
        <li>Production</li>
        <li>RM_RuinDrawsConduit</li>
        <!-- draw only: it joins no net -->
      </buildingTags>
    </building>
    <comps>
      <li Class="CompProperties_CompAnalyzableUnlockResearch">
        <compClass>RimMandrake.WreckedMachines.CompMachineStudy</compClass>
        <analysisID>77120191</analysisID>
        <requiresMechanitor>false</requiresMechanitor>
        <canStudyInPlace>true</canStudyInPlace>
        <analysisRequiredRange>3~3</analysisRequiredRange>
        <analysisDurationHours>4</analysisDurationHours>
        <cooldownTicks>20000</cooldownTicks>
        <destroyedOnAnalyzed>false</destroyedOnAnalyzed>
        <activateTexPath>UI/Icons/Study</activateTexPath>
        <jobString>study the wrecked automated fishfarm</jobString>
        <inspectString>A researcher can study how this automated fishfarm was put together.</inspectString>
        <completedLetterLabel>Wrecked automated fishfarm studied: {RESEARCH} unlocked</completedLetterLabel>
        <completedLetter>By studying the wrecked automated fishfarm, {PAWN_labelShort} has worked out how it can be patched back into service.\n\nThe research project {RESEARCH} can now be done at a research bench. Once it is done, order the repair on the automated fishfarm itself.</completedLetter>
        <completedLetterDef>PositiveEvent</completedLetterDef>
        <targetingParameters>
          <canTargetBuildings>false</canTargetBuildings>
          <canTargetAnimals>false</canTargetAnimals>
          <canTargetMechs>false</canTargetMechs>
          <onlyTargetControlledPawns>true</onlyTargetControlledPawns>
        </targetingParameters>
      </li>
      <li Class="RimMandrake.WreckedMachines.CompProperties_WreckedMachine"/>
    </comps>
    <modExtensions>
      <li Class="RimMandrake.WreckedMachines.WreckedMachineGrade">
        <grade>Wrecked</grade>
        <line>fishfarm</line>
      </li>
    </modExtensions>
  </ThingDef>
  <!--KLUDGED. Runs, badly, on part of the original's work.-->
  <ThingDef ParentName="BuildingBase">
    <defName>RM_WM_AutomatedFishfarm_Kludged</defName>
    <label>kludged automated fishfarm</label>
    <description>An automated fishfarm dragged back into service by people who did not build it. The worst of the damage is plated over and the wiring is spliced by hand.\n\nIt can only do part of what the original did. It draws more power and breaks down often. The splicing holds it in place, so it cannot be carried.\n\nA researcher can study it further, and what they learn opens the research to refurbish it properly. The refurbishment is ordered on the machine and needs an ancient component.\n\nFactory buildings need factory hoppers for input and output.</description>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>WreckedMachines/Factories/AutomatedFishfarm/Kludged/AutomatedFishfarm</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(4,4)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <costList>
      <Steel>50</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>true</rotatable>
    <neverMultiSelect>true</neverMultiSelect>
    <uiIconScale>0.8</uiIconScale>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>True</useHitPoints>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <statBases>
      <Mass>35</Mass>
      <Beauty>-12</Beauty>
      <WorkToBuild>1400</WorkToBuild>
      <MaxHitPoints>200</MaxHitPoints>
      <Flammability>1</Flammability>
      <VEF_BuildingBreakdownFactor>2</VEF_BuildingBreakdownFactor>
      <VEF_BuildingMaxOverclockFactor>1</VEF_BuildingMaxOverclockFactor>
    </statBases>
    <tickerType>Rare</tickerType>
    <size>(3,3)</size>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-2)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <building>
      <deconstructible>true</deconstructible>
      <relatedBuildCommands>
        <li>VFEFactory_FactoryHopper</li>
      </relatedBuildCommands>
      <buildingTags>
        <li>Production</li>
      </buildingTags>
    </building>
    <inspectorTabs>
      <li>PipeSystem.ITab_Processor</li>
    </inspectorTabs>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>false</shortCircuitInRain>
        <basePowerConsumption>420</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="PipeSystem.CompProperties_AdvancedResourceProcessor">
        <notWorkingKey>VFEFactory_FactoryNotWorking</notWorkingKey>
        <alwaysShowProgressBar>true</alwaysShowProgressBar>
        <!-- The donor's XML lists no processes; the C# fills the Kludged list at startup (the row's kludgedProcessCount). -->
        <processes/>
        <hideSettings>true</hideSettings>
        <canOverclock>false</canOverclock>
      </li>
      <li Class="CompProperties_CompAnalyzableUnlockResearch">
        <compClass>RimMandrake.WreckedMachines.CompMachineStudy</compClass>
        <analysisID>77120192</analysisID>
        <requiresMechanitor>false</requiresMechanitor>
        <canStudyInPlace>true</canStudyInPlace>
        <analysisRequiredRange>3~3</analysisRequiredRange>
        <analysisDurationHours>4</analysisDurationHours>
        <cooldownTicks>20000</cooldownTicks>
        <destroyedOnAnalyzed>false</destroyedOnAnalyzed>
        <activateTexPath>UI/Icons/Study</activateTexPath>
        <jobString>study the kludged automated fishfarm</jobString>
        <inspectString>A researcher can study how to refurbish this automated fishfarm.</inspectString>
        <completedLetterLabel>Kludged automated fishfarm studied: {RESEARCH} unlocked</completedLetterLabel>
        <completedLetter>By studying the kludged automated fishfarm, {PAWN_labelShort} has found which of its splices can stay and which must be redone to bring the machine close to what it was.\n\nThe research project {RESEARCH} can now be done at a research bench. Once it is done, order the refurbishment on the automated fishfarm itself. It needs an ancient component.</completedLetter>
        <completedLetterDef>PositiveEvent</completedLetterDef>
        <targetingParameters>
          <canTargetBuildings>false</canTargetBuildings>
          <canTargetAnimals>false</canTargetAnimals>
          <canTargetMechs>false</canTargetMechs>
          <onlyTargetControlledPawns>true</onlyTargetControlledPawns>
        </targetingParameters>
      </li>
      <li Class="RimMandrake.WreckedMachines.CompProperties_WreckedMachine"/>
    </comps>
    <terrainAffordanceNeeded/>
    <placeWorkers>
      <li>VanillaFurnitureExpandedFactory.PlaceWorker_Fishfarm</li>
    </placeWorkers>
    <modExtensions>
      <li Class="RimMandrake.WreckedMachines.WreckedMachineGrade">
        <grade>Kludged</grade>
        <line>fishfarm</line>
      </li>
    </modExtensions>
  </ThingDef>
  <!--REFURBISHED. All the original's work; no overclock; a little less reliable. Draws the donor's own picture.-->
  <ThingDef ParentName="BuildingBase">
    <defName>RM_WM_AutomatedFishfarm_Refurbished</defName>
    <label>refurbished automated fishfarm</label>
    <description>An automated fishfarm refurbished from salvage by people who learned it from the wreck. The breaches are sealed, the wiring is mostly original again, and an ancient component holds the worst of it together.\n\nIt does everything the original did. It draws a little more power and breaks down more often. It can be carried.\n\nFactory buildings need factory hoppers for input and output.</description>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Factories/AutomatedFishfarm/AutomatedFishfarm</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(4,4)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <thingCategories>
      <li>VFEFactory_FactoryCategory</li>
    </thingCategories>
    <costList>
      <Steel>90</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
      <RM_WM_AncientComponent>1</RM_WM_AncientComponent>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>true</rotatable>
    <neverMultiSelect>true</neverMultiSelect>
    <uiIconScale>0.8</uiIconScale>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>True</useHitPoints>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <statBases>
      <Mass>35</Mass>
      <Beauty>-9</Beauty>
      <WorkToBuild>1800</WorkToBuild>
      <MaxHitPoints>270</MaxHitPoints>
      <Flammability>1</Flammability>
      <VEF_BuildingBreakdownFactor>1.5</VEF_BuildingBreakdownFactor>
      <VEF_BuildingMaxOverclockFactor>1</VEF_BuildingMaxOverclockFactor>
    </statBases>
    <tickerType>Rare</tickerType>
    <size>(3,3)</size>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-2)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <building>
      <relatedBuildCommands>
        <li>VFEFactory_FactoryHopper</li>
      </relatedBuildCommands>
      <buildingTags>
        <li>Production</li>
      </buildingTags>
    </building>
    <inspectorTabs>
      <li>PipeSystem.ITab_Processor</li>
    </inspectorTabs>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>false</shortCircuitInRain>
        <basePowerConsumption>385</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="PipeSystem.CompProperties_AdvancedResourceProcessor">
        <notWorkingKey>VFEFactory_FactoryNotWorking</notWorkingKey>
        <alwaysShowProgressBar>true</alwaysShowProgressBar>
        <processes>
				</processes>
        <hideSettings>true</hideSettings>
        <canOverclock>false</canOverclock>
      </li>
      <li Class="RimMandrake.WreckedMachines.CompProperties_WreckedMachine"/>
    </comps>
    <terrainAffordanceNeeded/>
    <placeWorkers>
      <li>VanillaFurnitureExpandedFactory.PlaceWorker_Fishfarm</li>
    </placeWorkers>
    <minifiedDef>MinifiedThing</minifiedDef>
    <modExtensions>
      <li Class="RimMandrake.WreckedMachines.WreckedMachineGrade">
        <grade>Refurbished</grade>
        <line>fishfarm</line>
      </li>
    </modExtensions>
  </ThingDef>
</Defs>
