<?xml version="1.0" encoding="utf-8"?>
<!--
  WreckedMachines - MOBILE machines: the vanometric power cell line and the psychic emanator line. Three level defs each
  (Wrecked, Kludged, Refurbished); the Original is the base game's own VanometricPowerCell / PsychicEmanator. The rows are in
  Defs/MachineLines/MachineLines_WreckedMachines.xml. (Owner rulings 2026-09-15 and 2026-09-20: "other mobile structures
  should also be included"; the named set is open-ended.)

  Nobody builds a level here: no level def carries a designationCategory, a research prerequisite or a place worker.
  A machine is repaired where it stands, by an order on the machine, after study and research (DESIGN.md "The repair on the machine").

  DONOR, read 2026-11-27 (quoted, not remembered):
    /mnt/c/Program Files (x86)/Steam/steamapps/common/RimWorld/Data/Core/Defs/ThingDefs_Buildings/Buildings_Special.xml
    VanometricPowerCell: thingCategories BuildingsSpecial, Mass 15.   PsychicEmanator: thingCategories BuildingsSpecial, Mass 15.
  Every level here is minifiable, so a found wreck can be carried home; reinstalling is free.

  Power: LadderPatcher recomputes the Kludged and Refurbished output from the base game's def at startup and whenever settings close,
  so the watts written here are only the defaults. The wreck has no power comp (a dead machine; owner ruling 2026-08-12); its
  small indicator glow stays, because it is light, not power.

  PICTURES: the Wrecked and the Kludged level of both machines draw pictures of their own (Textures/WreckedMachines/Mobile/<Short>,
  at twice the base game's pixel size, kept by the art judge: design/concepts/WreckedMachines/version/evidence/art; MACHINES.md
  "How a picture is made"). The Refurbished level draws the base game's picture (rule R_whole_picture).
  Where wrecks are found is not wired: nothing spawns them yet. Dev-spawn only.
-->
<Defs>

  <!-- ================= VANOMETRIC POWER CELL LINE ================= -->

  <ThingDef Name="RM_WM_PowerCellBase" ParentName="BuildingBase" Abstract="True">
    <graphicData>
      <texPath>Things/Building/Special/VanometricPowerCell</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2, 3)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <drawerType>MapMeshAndRealTime</drawerType>
    <pathCost>42</pathCost>
    <fillPercent>0.4</fillPercent>
    <passability>PassThroughOnly</passability>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <canOverlapZones>false</canOverlapZones>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.5</staticSunShadowHeight>
    <size>(1, 2)</size>
    <tradeability>Sellable</tradeability>
  </ThingDef>

  <ThingDef ParentName="RM_WM_PowerCellBase">
    <defName>RM_WM_PowerCell_Wrecked</defName>
    <label>wrecked vanometric power cell</label>
    <description>A vanometric power cell, ancient and broken. The housing is cracked and the field lattice is dark. Only a faint glow still shows at an indicator. It is not producing any power.\n\nA researcher can study it where it stands, and what they learn opens the research to coax it back into a trickle of power. It can be carried. The repair itself is ordered on the machine, once the research is done.</description>
    <graphicData>
      <texPath>WreckedMachines/Mobile/VanometricPowerCell/Wrecked/VanometricPowerCell</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
    </graphicData>
    <thingCategories>
      <li>BuildingsSpecial</li>
    </thingCategories>
    <statBases>
      <MarketValue>250</MarketValue>
      <MaxHitPoints>200</MaxHitPoints>
      <Flammability>0</Flammability>
      <Mass>15</Mass>
      <Beauty>-5</Beauty>
    </statBases>
    <tickerType>Never</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <building>
      <buildingTags>
        <li>RM_RuinDrawsConduit</li>   <!-- WRECKED_LINKS_FIX_RUINS_SNUB_THEIR_PIPES: draw only; it joins no net -->
      </buildingTags>
    </building>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>1</glowRadius>
        <glowColor>(227,233,168,0)</glowColor>
      </li>
      <li Class="CompProperties_CompAnalyzableUnlockResearch">
        <compClass>RimMandrake.WreckedMachines.CompMachineStudy</compClass>
        <analysisID>77120021</analysisID>
        <requiresMechanitor>false</requiresMechanitor>
        <canStudyInPlace>true</canStudyInPlace>
        <analysisRequiredRange>3~3</analysisRequiredRange>
        <analysisDurationHours>4</analysisDurationHours>
        <cooldownTicks>20000</cooldownTicks>
        <destroyedOnAnalyzed>false</destroyedOnAnalyzed>
        <activateTexPath>UI/Icons/Study</activateTexPath>
        <jobString>study the wrecked vanometric power cell</jobString>
        <inspectString>A researcher can study how this power cell was put together.</inspectString>
        <completedLetterLabel>Wrecked power cell studied: {RESEARCH} unlocked</completedLetterLabel>
        <completedLetter>By studying the wrecked vanometric power cell, {PAWN_labelShort} has worked out how its dark field lattice can be coaxed back into a trickle of power.\n\nThe research project {RESEARCH} can now be done at a research bench. Once it is done, order the repair on the power cell itself.</completedLetter>
        <completedLetterDef>PositiveEvent</completedLetterDef>
        <targetingParameters>
          <canTargetBuildings>false</canTargetBuildings>
          <canTargetAnimals>false</canTargetAnimals>
          <canTargetMechs>false</canTargetMechs>
          <onlyTargetControlledPawns>true</onlyTargetControlledPawns>
        </targetingParameters>
      </li>
      <li Class="RimMandrake.WreckedMachines.CompProperties_WreckedMachine" />
    </comps>
    <modExtensions>
      <li Class="RimMandrake.WreckedMachines.WreckedMachineGrade">
        <grade>Wrecked</grade>
        <line>powercell</line>
        <original>VanometricPowerCell</original>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="RM_WM_PowerCellBase">
    <defName>RM_WM_PowerCell_Kludged</defName>
    <label>kludged vanometric power cell</label>
    <description>A wrecked vanometric power cell coaxed back into a fraction of its old output. The cracked housing is strapped shut, the dead lattice segments are bypassed with ordinary cable, and it hums unevenly. It makes a fifth of what an intact cell would: free power, forever, just not much of it.\n\nA researcher can study it further, and what they learn opens the research to refurbish it properly. The refurbishment is ordered on the machine and needs an ancient component. It can be carried.</description>
    <graphicData>
      <texPath>WreckedMachines/Mobile/VanometricPowerCell/Kludged/VanometricPowerCell</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
    </graphicData>
    <thingCategories>
      <li>BuildingsSpecial</li>
    </thingCategories>
    <statBases>
      <MarketValue>450</MarketValue>
      <MaxHitPoints>150</MaxHitPoints>
      <Flammability>0</Flammability>
      <Mass>15</Mass>
      <WorkToBuild>2500</WorkToBuild>
      <Beauty>-3</Beauty>
    </statBases>
    <costList>
      <Steel>60</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <tickerType>Normal</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerPlant</compClass>
        <basePowerConsumption>-200</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>2</glowRadius>
        <glowColor>(227,233,168,0)</glowColor>
      </li>
      <li Class="CompProperties_CompAnalyzableUnlockResearch">
        <compClass>RimMandrake.WreckedMachines.CompMachineStudy</compClass>
        <analysisID>77120022</analysisID>
        <requiresMechanitor>false</requiresMechanitor>
        <canStudyInPlace>true</canStudyInPlace>
        <analysisRequiredRange>3~3</analysisRequiredRange>
        <analysisDurationHours>4</analysisDurationHours>
        <cooldownTicks>20000</cooldownTicks>
        <destroyedOnAnalyzed>false</destroyedOnAnalyzed>
        <activateTexPath>UI/Icons/Study</activateTexPath>
        <jobString>study the kludged vanometric power cell</jobString>
        <inspectString>A researcher can study how to refurbish this power cell.</inspectString>
        <completedLetterLabel>Kludged power cell studied: {RESEARCH} unlocked</completedLetterLabel>
        <completedLetter>By studying the kludged vanometric power cell, {PAWN_labelShort} has found which of its bypasses can stay and which must be redone to bring the field lattice close to what it was.\n\nThe research project {RESEARCH} can now be done at a research bench. Once it is done, order the refurbishment on the power cell itself. It needs an ancient component.</completedLetter>
        <completedLetterDef>PositiveEvent</completedLetterDef>
        <targetingParameters>
          <canTargetBuildings>false</canTargetBuildings>
          <canTargetAnimals>false</canTargetAnimals>
          <canTargetMechs>false</canTargetMechs>
          <onlyTargetControlledPawns>true</onlyTargetControlledPawns>
        </targetingParameters>
      </li>
      <li Class="RimMandrake.WreckedMachines.CompProperties_WreckedMachine" />
    </comps>
    <modExtensions>
      <li Class="RimMandrake.WreckedMachines.WreckedMachineGrade">
        <grade>Kludged</grade>
        <line>powercell</line>
        <original>VanometricPowerCell</original>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="RM_WM_PowerCellBase">
    <defName>RM_WM_PowerCell_Refurbished</defName>
    <label>refurbished vanometric power cell</label>
    <description>A vanometric power cell refurbished from a wreck. Most of the field lattice glows again, held in place by an ancient component nobody could have made, and it gives three-quarters of what an intact cell would. The seams still show; it is a kludge that happens to work very well.\n\nIt can be carried.</description>
    <thingCategories>
      <li>BuildingsSpecial</li>
    </thingCategories>
    <statBases>
      <MarketValue>900</MarketValue>
      <MaxHitPoints>180</MaxHitPoints>
      <Flammability>0</Flammability>
      <Mass>15</Mass>
      <WorkToBuild>4000</WorkToBuild>
    </statBases>
    <costList>
      <Steel>80</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
      <RM_WM_AncientComponent>1</RM_WM_AncientComponent>
    </costList>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <tickerType>Normal</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerPlant</compClass>
        <basePowerConsumption>-750</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>3</glowRadius>
        <glowColor>(227,233,168,0)</glowColor>
      </li>
      <li Class="RimMandrake.WreckedMachines.CompProperties_WreckedMachine" />
    </comps>
    <modExtensions>
      <li Class="RimMandrake.WreckedMachines.WreckedMachineGrade">
        <grade>Refurbished</grade>
        <line>powercell</line>
        <original>VanometricPowerCell</original>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- ================= PSYCHIC EMANATOR LINE ================= -->

  <ThingDef Name="RM_WM_EmanatorBase" ParentName="BuildingBase" Abstract="True">
    <graphicData>
      <texPath>Things/Building/Special/PsychicEmanator</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2, 2)</drawSize>
      <shadowData>
        <volume>(0.3, 0.6, 0.3)</volume>
        <offset>(0.0, 0.0, -0.1)</offset>
      </shadowData>
      <damageData>
        <rect>(0,0.75,1.0,0.5)</rect>
      </damageData>
    </graphicData>
    <uiIconScale>0.85</uiIconScale>
    <altitudeLayer>Building</altitudeLayer>
    <building>
      <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
    </building>
    <fillPercent>0.2</fillPercent>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <pathCost>30</pathCost>
    <passability>PassThroughOnly</passability>
    <rotatable>false</rotatable>
    <canOverlapZones>false</canOverlapZones>
    <tradeability>Sellable</tradeability>
  </ThingDef>

  <ThingDef ParentName="RM_WM_EmanatorBase">
    <defName>RM_WM_PsychicEmanator_Wrecked</defName>
    <building>
      <buildingTags>
        <li>RM_RuinDrawsConduit</li>   <!-- WRECKED_LINKS_FIX_RUINS_SNUB_THEIR_PIPES: draw only; it joins no net -->
      </buildingTags>
    </building>
    <label>wrecked psychic emanator</label>
    <description>An ancient psychic emanator, long dead. The field coil is fused and the casing is pitted through. Whatever it once did to the minds around it, it does nothing now.\n\nA researcher can study it where it stands, and what they learn opens the research to patch it back into a weak field. It can be carried. The repair itself is ordered on the machine, once the research is done.</description>
    <graphicData>
      <texPath>WreckedMachines/Mobile/PsychicEmanator/Wrecked/PsychicEmanator</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <thingCategories>
      <li>BuildingsSpecial</li>
    </thingCategories>
    <statBases>
      <MarketValue>250</MarketValue>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>0</Flammability>
      <Beauty>-5</Beauty>
      <Mass>15</Mass>
    </statBases>
    <tickerType>Never</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <comps>
      <li Class="CompProperties_CompAnalyzableUnlockResearch">
        <compClass>RimMandrake.WreckedMachines.CompMachineStudy</compClass>
        <analysisID>77120031</analysisID>
        <requiresMechanitor>false</requiresMechanitor>
        <canStudyInPlace>true</canStudyInPlace>
        <analysisRequiredRange>3~3</analysisRequiredRange>
        <analysisDurationHours>4</analysisDurationHours>
        <cooldownTicks>20000</cooldownTicks>
        <destroyedOnAnalyzed>false</destroyedOnAnalyzed>
        <activateTexPath>UI/Icons/Study</activateTexPath>
        <jobString>study the wrecked psychic emanator</jobString>
        <inspectString>A researcher can study how this emanator was put together.</inspectString>
        <completedLetterLabel>Wrecked emanator studied: {RESEARCH} unlocked</completedLetterLabel>
        <completedLetter>By studying the wrecked psychic emanator, {PAWN_labelShort} has worked out how its fused field coil can be patched into a weak, uneven field.\n\nThe research project {RESEARCH} can now be done at a research bench. Once it is done, order the repair on the emanator itself.</completedLetter>
        <completedLetterDef>PositiveEvent</completedLetterDef>
        <targetingParameters>
          <canTargetBuildings>false</canTargetBuildings>
          <canTargetAnimals>false</canTargetAnimals>
          <canTargetMechs>false</canTargetMechs>
          <onlyTargetControlledPawns>true</onlyTargetControlledPawns>
        </targetingParameters>
      </li>
      <li Class="RimMandrake.WreckedMachines.CompProperties_WreckedMachine" />
    </comps>
    <modExtensions>
      <li Class="RimMandrake.WreckedMachines.WreckedMachineGrade">
        <grade>Wrecked</grade>
        <line>emanator</line>
        <original>PsychicEmanator</original>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="RM_WM_EmanatorBase">
    <defName>RM_WM_PsychicEmanator_Kludged</defName>
    <label>kludged psychic emanator</label>
    <description>A wrecked psychic emanator patched back into a weak, uneven field. It soothes the people around it a little, draws more power than it should, and breaks down often.\n\nA researcher can study it further, and what they learn opens the research to refurbish it properly. The refurbishment is ordered on the machine and needs an ancient component. It can be carried.</description>
    <graphicData>
      <texPath>WreckedMachines/Mobile/PsychicEmanator/Kludged/PsychicEmanator</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <thingCategories>
      <li>BuildingsSpecial</li>
    </thingCategories>
    <statBases>
      <MarketValue>450</MarketValue>
      <MaxHitPoints>80</MaxHitPoints>
      <Flammability>0</Flammability>
      <Beauty>-3</Beauty>
      <Mass>15</Mass>
      <WorkToBuild>2000</WorkToBuild>
    </statBases>
    <costList>
      <Steel>40</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <specialDisplayRadius>14.9</specialDisplayRadius>
    <tickerType>Normal</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>260</basePowerConsumption>
      </li>
      <li Class="CompProperties_MoteEmitter">
        <mote>Mote_PsychicEmanatorEffect</mote>
        <emissionInterval>900</emissionInterval>
      </li>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_CompAnalyzableUnlockResearch">
        <compClass>RimMandrake.WreckedMachines.CompMachineStudy</compClass>
        <analysisID>77120032</analysisID>
        <requiresMechanitor>false</requiresMechanitor>
        <canStudyInPlace>true</canStudyInPlace>
        <analysisRequiredRange>3~3</analysisRequiredRange>
        <analysisDurationHours>4</analysisDurationHours>
        <cooldownTicks>20000</cooldownTicks>
        <destroyedOnAnalyzed>false</destroyedOnAnalyzed>
        <activateTexPath>UI/Icons/Study</activateTexPath>
        <jobString>study the kludged psychic emanator</jobString>
        <inspectString>A researcher can study how to refurbish this emanator.</inspectString>
        <completedLetterLabel>Kludged emanator studied: {RESEARCH} unlocked</completedLetterLabel>
        <completedLetter>By studying the kludged psychic emanator, {PAWN_labelShort} has found which of its patches can stay and which must be redone to steady the field.\n\nThe research project {RESEARCH} can now be done at a research bench. Once it is done, order the refurbishment on the emanator itself. It needs an ancient component.</completedLetter>
        <completedLetterDef>PositiveEvent</completedLetterDef>
        <targetingParameters>
          <canTargetBuildings>false</canTargetBuildings>
          <canTargetAnimals>false</canTargetAnimals>
          <canTargetMechs>false</canTargetMechs>
          <onlyTargetControlledPawns>true</onlyTargetControlledPawns>
        </targetingParameters>
      </li>
      <li Class="RimMandrake.WreckedMachines.CompProperties_WreckedMachine" />
    </comps>
    <modExtensions>
      <li Class="RimMandrake.WreckedMachines.WreckedMachineGrade">
        <grade>Kludged</grade>
        <line>emanator</line>
        <original>PsychicEmanator</original>
        <emanates>true</emanates>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="RM_WM_EmanatorBase">
    <defName>RM_WM_PsychicEmanator_Refurbished</defName>
    <label>refurbished psychic emanator</label>
    <description>A psychic emanator refurbished from a wreck around an ancient component. Its field is steady again, if not as strong as an intact one: the people around it feel strange, and mostly relaxed.\n\nIt can be carried.</description>
    <thingCategories>
      <li>BuildingsSpecial</li>
    </thingCategories>
    <statBases>
      <MarketValue>900</MarketValue>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>0</Flammability>
      <Mass>15</Mass>
      <WorkToBuild>3500</WorkToBuild>
    </statBases>
    <costList>
      <Steel>50</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
      <RM_WM_AncientComponent>1</RM_WM_AncientComponent>
    </costList>
    <specialDisplayRadius>14.9</specialDisplayRadius>
    <tickerType>Normal</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>220</basePowerConsumption>
      </li>
      <li Class="CompProperties_MoteEmitter">
        <mote>Mote_PsychicEmanatorEffect</mote>
        <emissionInterval>450</emissionInterval>
      </li>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Flickable"/>
      <li Class="RimMandrake.WreckedMachines.CompProperties_WreckedMachine" />
    </comps>
    <modExtensions>
      <li Class="RimMandrake.WreckedMachines.WreckedMachineGrade">
        <grade>Refurbished</grade>
        <line>emanator</line>
        <original>PsychicEmanator</original>
        <emanates>true</emanates>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
