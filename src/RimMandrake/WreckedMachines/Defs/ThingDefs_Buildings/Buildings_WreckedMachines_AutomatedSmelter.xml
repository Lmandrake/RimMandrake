<?xml version="1.0" encoding="utf-8"?>
<!--
  WreckedMachines - the automated smelter line: three level defs (Wrecked, Kludged, Refurbished). The fourth level, the Original,
  is the factory mod's own VFEFactory_AutomatedSmelter. The line's row is Defs/MachineLines/MachineLines_WreckedMachines.xml.
  Nobody builds a level: a level def has no designationCategory, no research prerequisite and no place worker. A machine is
  repaired where it stands, by an order on the machine (DESIGN.md "The repair on the machine"), after study and research.

  DONOR, read 2026-11-27 (quoted, not remembered):
    /mnt/c/Program Files (x86)/Steam/steamapps/workshop/content/294100/3686924415/1.6/Defs/ThingDefs_Buildings/Buildings_Factories.xml
    defName VFEFactory_AutomatedSmelter, lines 184-289: size (3,4), drawSize (4,5), Graphic_Multi, Mass 60, thingCategories
    VFEFactory_FactoryCategory, terrainAffordanceNeeded FactoryFloor, 300 W, heatPerSecond 14, six processes in this order:
    SmeltMetalFromSlag, SmeltMetalFromMechSlag, SmeltWeapon, SmeltApparel, SmeltMetalFromChunk, SmeltMechanoid.

  The wrecked level takes no CompProperties_Explosive and no power comp (owner ruling 2026-08-12, "power density explodes, not the
  fact it's a machine"). Its draw-in tag RM_RuinDrawsConduit lets a neighbouring power line reach it for drawing only.
  The cost lists of the Wrecked def are its salvage; the costs and work of the two repairs are in the table row.
  The Kludged and Refurbished defs' processes, speed and breakdowns are re-derived by the C# at startup from the donor and the row.
-->
<Defs>

  <!-- ==================================================================
       WRECKED. Dead. Occupies its tiles and nothing else. Can be carried.
       ================================================================== -->
  <ThingDef ParentName="BuildingBase">
    <defName>RM_WM_AutomatedSmelter_Wrecked</defName>
    <label>wrecked automated smelter</label>
    <description>What is left of an automated smelter. The casing is split, the electromagnets are gone, and the feed throat is choked with its own cooled slag. It has no power in it and nothing to give.\n\nA researcher can study it where it stands, and what they learn opens the research to patch it back into service. It can be carried to a factory floor. The repair itself is ordered on the machine, once the research is done.</description>
    <drawerType>MapMeshOnly</drawerType>
    <graphicData>
      <texPath>WreckedMachines/Factories/AutomatedSmelter/Wrecked/AutomatedSmelter</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(4,5)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <thingCategories>
      <li>VFEFactory_FactoryCategory</li>
    </thingCategories>
    <costList>
      <Steel>30</Steel>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>true</rotatable>
    <neverMultiSelect>true</neverMultiSelect>
    <uiIconScale>0.8</uiIconScale>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>True</useHitPoints>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <statBases>
      <Mass>60</Mass>
      <Beauty>-30</Beauty>
      <WorkToBuild>800</WorkToBuild>
      <MaxHitPoints>450</MaxHitPoints>
      <Flammability>0.5</Flammability>
    </statBases>
    <tickerType>Never</tickerType>
    <size>(3,4)</size>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <minifiedDef>MinifiedThing</minifiedDef>
    <building>
      <deconstructible>true</deconstructible>
      <isInert>true</isInert>
      <buildingTags>
        <li>Production</li>
        <li>RM_RuinDrawsConduit</li>   <!-- WRECKED_LINKS_FIX_RUINS_SNUB_THEIR_PIPES: draw only; it joins no net -->
      </buildingTags>
    </building>
    <comps>
      <li Class="CompProperties_CompAnalyzableUnlockResearch">
        <compClass>RimMandrake.WreckedMachines.CompMachineStudy</compClass>
        <analysisID>77120011</analysisID>
        <requiresMechanitor>false</requiresMechanitor>
        <canStudyInPlace>true</canStudyInPlace>
        <analysisRequiredRange>3~3</analysisRequiredRange>
        <analysisDurationHours>4</analysisDurationHours>
        <cooldownTicks>20000</cooldownTicks>
        <destroyedOnAnalyzed>false</destroyedOnAnalyzed>
        <activateTexPath>UI/Icons/Study</activateTexPath>
        <jobString>study the wrecked automated smelter</jobString>
        <inspectString>A researcher can study how this smelter was put together.</inspectString>
        <completedLetterLabel>Wrecked smelter studied: {RESEARCH} unlocked</completedLetterLabel>
        <completedLetter>By studying the wrecked automated smelter, {PAWN_labelShort} has worked out how its split casing and dead magnets can be patched back into service.\n\nThe research project {RESEARCH} can now be done at a research bench. Once it is done, order the repair on the smelter itself.</completedLetter>
        <completedLetterDef>PositiveEvent</completedLetterDef>
        <targetingParameters>
          <canTargetBuildings>false</canTargetBuildings>
          <canTargetAnimals>false</canTargetAnimals>
          <canTargetMechs>false</canTargetMechs>
          <onlyTargetControlledPawns>true</onlyTargetControlledPawns>
        </targetingParameters>
      </li>
      <li Class="RimMandrake.WreckedMachines.CompProperties_WreckedMachine" />
    </comps>
    <modExtensions>
      <li Class="RimMandrake.WreckedMachines.WreckedMachineGrade">
        <grade>Wrecked</grade>
        <line>smelter</line>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- ==================================================================
       KLUDGED. Runs, badly, on the crudest recipes only. Bolted down.
       ================================================================== -->
  <ThingDef ParentName="BuildingBase">
    <defName>RM_WM_AutomatedSmelter_Kludged</defName>
    <label>kludged automated smelter</label>
    <description>An automated smelter dragged back into service by people who did not build it. Mismatched plating covers the worst of the breach, the coil loom is spliced by hand, and something that was never meant to be a thermal regulator is bolted across the intake.\n\nIt melts anything already mostly metal. Ask it for precision and it will give you slag and a temperature alarm. It runs hotter than it should, breaks down often, and cannot be overclocked. The splicing holds it to the floor, so it cannot be carried.\n\nA researcher can study it further, and what they learn opens the research to refurbish it properly. The refurbishment is ordered on the machine and needs an ancient component.\n\nFactory buildings need factory hoppers for input and output. Needs factory floor.</description>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>WreckedMachines/Factories/AutomatedSmelter/Kludged/AutomatedSmelter</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(4,5)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <costList>
      <Steel>120</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>true</rotatable>
    <neverMultiSelect>true</neverMultiSelect>
    <terrainAffordanceNeeded>FactoryFloor</terrainAffordanceNeeded>
    <uiIconScale>0.8</uiIconScale>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>True</useHitPoints>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <statBases>
      <Mass>60</Mass>
      <Beauty>-20</Beauty>
      <WorkToBuild>3000</WorkToBuild>
      <MaxHitPoints>300</MaxHitPoints>
      <Flammability>1</Flammability>
      <!-- Twice the donor's breakdown rate (donor 3). Overclocking is blocked by canOverclock=false in the processor comp below,
           not by zeroing this stat: 0 is a value the donor never uses. -->
      <VEF_BuildingBreakdownFactor>6</VEF_BuildingBreakdownFactor>
      <VEF_BuildingMaxOverclockFactor>1</VEF_BuildingMaxOverclockFactor>
    </statBases>
    <tickerType>Rare</tickerType>
    <size>(3,4)</size>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-2)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <building>
      <deconstructible>true</deconstructible>
      <relatedBuildCommands>
        <li>VFEFactory_FactoryHopper</li>
      </relatedBuildCommands>
      <buildingTags>
        <li>Production</li>
      </buildingTags>
      <workTableRoomRole>VFEFactory_FactoryRoom</workTableRoomRole>
      <workTableNotInRoomRoleFactor>0.5</workTableNotInRoomRoleFactor>
    </building>
    <inspectorTabs>
      <li>PipeSystem.ITab_Processor</li>
    </inspectorTabs>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <!-- A bodge is not efficient. Donor draws 300 W. -->
        <basePowerConsumption>360</basePowerConsumption>
      </li>
      <li>
        <compClass>PipeSystem.CompPowerTrader_Overclocked</compClass>
      </li>
      <li Class="CompProperties_HeatPusher">
        <compClass>PipeSystem.CompHeatPusherPowered_Overclocked</compClass>
        <!-- Donor pushes 14. Nothing here regulates heat properly. -->
        <heatPerSecond>20</heatPerSecond>
        <heatPushMaxTemperature>120</heatPushMaxTemperature>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="PipeSystem.CompProperties_AdvancedResourceProcessor">
        <notWorkingKey>VFEFactory_FactoryNotWorking</notWorkingKey>
        <canOverclock>false</canOverclock>
        <alwaysShowProgressBar>true</alwaysShowProgressBar>
        <!-- The subset is chosen by fiction: if it is already mostly metal, the bodge can melt it. Left out of the donor's six:
             SmeltApparel (soft goods ignite), SmeltMetalFromChunk (needs a working thermal stage) and SmeltMechanoid (needs an
             intact feed). The same list is the row's kludgedProcesses. -->
        <processes>
          <li>VFEFactory_SmeltMetalFromSlag</li>
          <li>VFEFactory_SmeltMetalFromMechSlag</li>
          <li>VFEFactory_SmeltWeapon</li>
        </processes>
        <hideSettings>true</hideSettings>
      </li>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>VFEFactory_Booster</li>
          <li>VFEFactory_Heatsink</li>
        </linkableFacilities>
      </li>
      <li Class="CompProperties_CompAnalyzableUnlockResearch">
        <compClass>RimMandrake.WreckedMachines.CompMachineStudy</compClass>
        <analysisID>77120012</analysisID>
        <requiresMechanitor>false</requiresMechanitor>
        <canStudyInPlace>true</canStudyInPlace>
        <analysisRequiredRange>3~3</analysisRequiredRange>
        <analysisDurationHours>4</analysisDurationHours>
        <cooldownTicks>20000</cooldownTicks>
        <destroyedOnAnalyzed>false</destroyedOnAnalyzed>
        <activateTexPath>UI/Icons/Study</activateTexPath>
        <jobString>study the kludged automated smelter</jobString>
        <inspectString>A researcher can study how to refurbish this smelter.</inspectString>
        <completedLetterLabel>Kludged smelter studied: {RESEARCH} unlocked</completedLetterLabel>
        <completedLetter>By studying the kludged automated smelter, {PAWN_labelShort} has found which of its splices can stay and which must be redone to bring the machine close to what it was.\n\nThe research project {RESEARCH} can now be done at a research bench. Once it is done, order the refurbishment on the smelter itself. It needs an ancient component.</completedLetter>
        <completedLetterDef>PositiveEvent</completedLetterDef>
        <targetingParameters>
          <canTargetBuildings>false</canTargetBuildings>
          <canTargetAnimals>false</canTargetAnimals>
          <canTargetMechs>false</canTargetMechs>
          <onlyTargetControlledPawns>true</onlyTargetControlledPawns>
        </targetingParameters>
      </li>
      <li Class="RimMandrake.WreckedMachines.CompProperties_WreckedMachine" />
    </comps>
    <modExtensions>
      <li Class="RimMandrake.WreckedMachines.WreckedMachineGrade">
        <grade>Kludged</grade>
        <line>smelter</line>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- ==================================================================
       REFURBISHED. Everything the donor's smelter melts, in the donor's order; no overclock; a little slower and less reliable.
       Draws the picture it drew before the table (the donor-style picture under Factories/AutomatedSmelter/Repaired).
       ================================================================== -->
  <ThingDef ParentName="BuildingBase">
    <defName>RM_WM_AutomatedSmelter_Refurbished</defName>
    <label>refurbished automated smelter</label>
    <description>An automated smelter refurbished from salvage by people who learned it from the wreck. The breaches are sealed, the coil loom is mostly original again, and a scavenged ancient component holds the thermal stage together.\n\nIt melts everything the original did, a whole mechanoid included, but it runs a little slower, breaks down more often, and cannot be overclocked. It can be carried.\n\nFactory buildings need factory hoppers for input and output. Needs factory floor.</description>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>WreckedMachines/Factories/AutomatedSmelter/Repaired/AutomatedSmelter</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(4,5)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <thingCategories>
      <li>VFEFactory_FactoryCategory</li>
    </thingCategories>
    <costList>
      <Steel>200</Steel>
      <ComponentIndustrial>5</ComponentIndustrial>
      <RM_WM_AncientComponent>1</RM_WM_AncientComponent>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>true</rotatable>
    <neverMultiSelect>true</neverMultiSelect>
    <terrainAffordanceNeeded>FactoryFloor</terrainAffordanceNeeded>
    <uiIconScale>0.8</uiIconScale>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>True</useHitPoints>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <statBases>
      <Mass>60</Mass>
      <Beauty>-15</Beauty>
      <WorkToBuild>4000</WorkToBuild>
      <MaxHitPoints>400</MaxHitPoints>
      <Flammability>1</Flammability>
      <VEF_BuildingBreakdownFactor>4.5</VEF_BuildingBreakdownFactor>
      <VEF_BuildingMaxOverclockFactor>1</VEF_BuildingMaxOverclockFactor>
    </statBases>
    <tickerType>Rare</tickerType>
    <size>(3,4)</size>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-2)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <building>
      <relatedBuildCommands>
        <li>VFEFactory_FactoryHopper</li>
      </relatedBuildCommands>
      <buildingTags>
        <li>Production</li>
      </buildingTags>
      <workTableRoomRole>VFEFactory_FactoryRoom</workTableRoomRole>
      <workTableNotInRoomRoleFactor>0.5</workTableNotInRoomRoleFactor>
    </building>
    <inspectorTabs>
      <li>PipeSystem.ITab_Processor</li>
    </inspectorTabs>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>330</basePowerConsumption>
      </li>
      <li>
        <compClass>PipeSystem.CompPowerTrader_Overclocked</compClass>
      </li>
      <li Class="CompProperties_HeatPusher">
        <compClass>PipeSystem.CompHeatPusherPowered_Overclocked</compClass>
        <heatPerSecond>16</heatPerSecond>
        <heatPushMaxTemperature>120</heatPushMaxTemperature>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="PipeSystem.CompProperties_AdvancedResourceProcessor">
        <notWorkingKey>VFEFactory_FactoryNotWorking</notWorkingKey>
        <canOverclock>false</canOverclock>
        <alwaysShowProgressBar>true</alwaysShowProgressBar>
        <!-- The donor's six processes, in the donor's order. -->
        <processes>
          <li>VFEFactory_SmeltMetalFromSlag</li>
          <li>VFEFactory_SmeltMetalFromMechSlag</li>
          <li>VFEFactory_SmeltWeapon</li>
          <li>VFEFactory_SmeltApparel</li>
          <li>VFEFactory_SmeltMetalFromChunk</li>
          <li>VFEFactory_SmeltMechanoid</li>
        </processes>
        <hideSettings>true</hideSettings>
      </li>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>VFEFactory_Booster</li>
          <li>VFEFactory_Heatsink</li>
        </linkableFacilities>
      </li>
      <li Class="RimMandrake.WreckedMachines.CompProperties_WreckedMachine" />
    </comps>
    <minifiedDef>MinifiedThing</minifiedDef>
    <modExtensions>
      <li Class="RimMandrake.WreckedMachines.WreckedMachineGrade">
        <grade>Refurbished</grade>
        <line>smelter</line>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
