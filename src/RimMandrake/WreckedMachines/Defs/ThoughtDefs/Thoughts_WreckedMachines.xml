<?xml version="1.0" encoding="utf-8"?>
<!--
  Salvaged emanator soothe. Vanilla's PsychicEmanatorSoothe worker reads only
  ThingDefOf.PsychicEmanator (RimSage, ThoughtWorker_PsychicEmanatorSoothe), so
  our grades need their own thought. Stage 0 = Kludged, stage 1 = Refurbished.
  The baseMoodEffect values below are defaults only: LadderPatcher rewrites
  them at startup as vanilla's own soothe (5) x the grade ratio from Mod
  Settings (0.2 -> 1, 0.75 -> 3.75).
-->
<Defs>

  <ThoughtDef>
    <defName>RM_WM_SalvagedEmanatorSoothe</defName>
    <workerClass>RimMandrake.WreckedMachines.ThoughtWorker_SalvagedEmanatorSoothe</workerClass>
    <effectMultiplyingStat>PsychicSensitivity</effectMultiplyingStat>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>kludged emanator soothe</label>
        <description>The patched-up psychic emanator buzzes at the edge of my mind. It's faintly calming.</description>
        <baseMoodEffect>1</baseMoodEffect>
      </li>
      <li>
        <label>refurbished emanator soothe</label>
        <description>The refurbished psychic emanator makes me feel strange, but relaxed.</description>
        <baseMoodEffect>3.75</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
