    <firstProject>RM_WM_PowerCellKludging</firstProject>
    <secondProject>RM_WM_PowerCellRestoration</secondProject>
    <kludgeCost>
      <Steel>60</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </kludgeCost>
    <kludgeWork>2500</kludgeWork>
    <refurbishCost>
      <Steel>80</Steel>
