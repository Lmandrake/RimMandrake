<Project Sdk="Microsoft.NET.Sdk">
  <!-- Built in a scratch dir by selftest_salvage_rule.py, beside the real rule, its mutants and the generated Variants.cs. Zero RimWorld references. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>SalvageExec</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0162;CS0219;CS0168;CS0642;CS1717</NoWarn>
  </PropertyGroup>
</Project>
