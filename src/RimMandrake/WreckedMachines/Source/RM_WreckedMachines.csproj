<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WRECKEDMACHINES_MOD_SETTINGS_1 — first assembly this mod ever ships.

    Harmony is here for one postfix (WreckedMachinesSalvage.cs): a PipeSystem process pays one
    ThingDef per result, and the salvage rule can return several. Every other edit stays a
    plain def change from a [StaticConstructorOnStartup] class. Add no further patch without
    the same reason: the seam has to be missing, not merely less convenient.

    Build from a clone (never the read-only D:\Luke\dev\RimMandrake mirror):
      python3 src/RimMandrake/Utils/winbuild.py src/RimMandrake/WreckedMachines/Source/RM_WreckedMachines.csproj   (from a clone; stages on D:\ClaudeWork\rimmandrake\build)

    Output lands in ../Assemblies/, which is where RimWorld looks.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrakeWreckedMachines</AssemblyName>
    <RootNamespace>RimMandrake.WreckedMachines</RootNamespace>
    <Version>0.1.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="WreckedMachinesMod.cs" />
    <Compile Include="..\..\_Shared\SettingsKit\SettingsKitCore.cs" Link="Shared\SettingsKitCore.cs" />
    <Compile Include="..\..\_Shared\SettingsKit\SettingsKitDrawer.cs" Link="Shared\SettingsKitDrawer.cs" />
    <Compile Include="WreckedMachinesLadder.cs" />
    <Compile Include="Kernel\RM_WreckedMachinesKernel.cs" />
    <Compile Include="WreckedMachinesSalvage.cs" />
    <Compile Include="..\..\_Shared\SalvageRule\RM_SalvageRule.cs" Link="Shared\RM_SalvageRule.cs" />
    <Compile Include="..\..\_Shared\SalvageRule\RM_SalvageRuleKernel.cs" Link="Shared\RM_SalvageRuleKernel.cs" />
    <Compile Include="..\..\_Shared\HarmonyResilience\PatchApplier.cs" Link="Shared\PatchApplier.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <WorkshopRoot Condition="'$(WorkshopRoot)' == ''">C:\Program Files (x86)\Steam\steamapps\workshop\content\294100</WorkshopRoot>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PipeSystem">
      <HintPath>$(WorkshopRoot)\2023507013\1.6\Assemblies\PipeSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VanillaFurnitureExpandedFactory">
      <HintPath>$(WorkshopRoot)\3686924415\1.6\Assemblies\VanillaFurnitureExpandedFactory.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
