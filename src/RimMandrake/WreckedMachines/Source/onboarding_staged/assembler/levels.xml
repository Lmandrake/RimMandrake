<?xml version="1.0" encoding="utf-8"?>
<!--
  WreckedMachines - the automated assembler line (key assembler, line number 12): three level defs. The Original is the factory mod's own VFEFactory_AutomatedAssembler.
  Stamped by Source/onboard.py from the row beside it and the donor def; do not edit by hand: change the row, or the tool, and stamp again.
  DONOR: 1.6/Defs/ThingDefs_Buildings/Buildings_Factories.xml, ThingDef VFEFactory_AutomatedAssembler (line 716 of that file), factory mod folder as read at stamp time.
-->
<Defs>
  <!--WRECKED. Dead. Occupies its tiles and nothing else. Can be carried.-->
  <ThingDef ParentName="BuildingBase">
    <defName>RM_WM_AutomatedAssembler_Wrecked</defName>
    <label>wrecked automated assembler</label>
    <description>What is left of an automated assembler. It has no power in it and nothing to give.\n\nA researcher can study it where it stands, and what they learn opens the research to patch it back into service. It can be carried. The repair itself is ordered on the machine, once the research is done.</description>
    <drawerType>MapMeshOnly</drawerType>
    <graphicData>
      <texPath>WreckedMachines/Factories/AutomatedAssembler/Wrecked/AutomatedAssembler</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(6,6)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <thingCategories>
      <li>VFEFactory_FactoryCategory</li>
    </thingCategories>
    <costList>
      <Steel>45</Steel>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>true</rotatable>
    <neverMultiSelect>true</neverMultiSelect>
    <uiIconScale>0.8</uiIconScale>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>True</useHitPoints>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <statBases>
      <Mass>100</Mass>
      <Beauty>-48</Beauty>
      <WorkToBuild>800</WorkToBuild>
      <MaxHitPoints>800</MaxHitPoints>
      <Flammability>0.5</Flammability>
    </statBases>
    <tickerType>Never</tickerType>
    <size>(5,5)</size>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <minifiedDef>MinifiedThing</minifiedDef>
    <building>
      <deconstructible>true</deconstructible>
      <isInert>true</isInert>
      <buildingTags>
        <li>Production</li>
        <li>RM_RuinDrawsConduit</li>
        <!-- draw only: it joins no net -->
      </buildingTags>
    </building>
    <comps>
      <li Class="CompProperties_CompAnalyzableUnlockResearch">
        <compClass>RimMandrake.WreckedMachines.CompMachineStudy</compClass>
        <analysisID>77120121</analysisID>
        <requiresMechanitor>false</requiresMechanitor>
        <canStudyInPlace>true</canStudyInPlace>
        <analysisRequiredRange>3~3</analysisRequiredRange>
        <analysisDurationHours>4</analysisDurationHours>
        <cooldownTicks>20000</cooldownTicks>
        <destroyedOnAnalyzed>false</destroyedOnAnalyzed>
        <activateTexPath>UI/Icons/Study</activateTexPath>
        <jobString>study the wrecked automated assembler</jobString>
        <inspectString>A researcher can study how this automated assembler was put together.</inspectString>
        <completedLetterLabel>Wrecked automated assembler studied: {RESEARCH} unlocked</completedLetterLabel>
        <completedLetter>By studying the wrecked automated assembler, {PAWN_labelShort} has worked out how it can be patched back into service.\n\nThe research project {RESEARCH} can now be done at a research bench. Once it is done, order the repair on the automated assembler itself.</completedLetter>
        <completedLetterDef>PositiveEvent</completedLetterDef>
        <targetingParameters>
          <canTargetBuildings>false</canTargetBuildings>
          <canTargetAnimals>false</canTargetAnimals>
          <canTargetMechs>false</canTargetMechs>
          <onlyTargetControlledPawns>true</onlyTargetControlledPawns>
        </targetingParameters>
      </li>
      <li Class="RimMandrake.WreckedMachines.CompProperties_WreckedMachine"/>
    </comps>
    <modExtensions>
      <li Class="RimMandrake.WreckedMachines.WreckedMachineGrade">
        <grade>Wrecked</grade>
        <line>assembler</line>
      </li>
    </modExtensions>
  </ThingDef>
  <!--KLUDGED. Runs, badly, on part of the original's work.-->
  <ThingDef ParentName="BuildingBase">
    <defName>RM_WM_AutomatedAssembler_Kludged</defName>
    <label>kludged automated assembler</label>
    <description>An automated assembler dragged back into service by people who did not build it. The worst of the damage is plated over and the wiring is spliced by hand.\n\nIt can only do part of what the original did: make a component. The rest of the original's work is beyond it. It draws more power, runs hotter than it should, breaks down often and cannot be overclocked. The splicing holds it in place, so it cannot be carried.\n\nA researcher can study it further, and what they learn opens the research to refurbish it properly. The refurbishment is ordered on the machine and needs an ancient component.\n\nFactory buildings need factory hoppers for input and output. Needs factory floor.</description>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>WreckedMachines/Factories/AutomatedAssembler/Kludged/AutomatedAssembler</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(6,6)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <costList>
      <Steel>180</Steel>
      <ComponentIndustrial>8</ComponentIndustrial>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <terrainAffordanceNeeded>FactoryFloor</terrainAffordanceNeeded>
    <rotatable>true</rotatable>
    <neverMultiSelect>true</neverMultiSelect>
    <uiIconScale>0.8</uiIconScale>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>True</useHitPoints>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <statBases>
      <Mass>100</Mass>
      <Beauty>-32</Beauty>
      <WorkToBuild>4600</WorkToBuild>
      <MaxHitPoints>530</MaxHitPoints>
      <Flammability>1</Flammability>
      <VEF_BuildingMaxOverclockFactor>1</VEF_BuildingMaxOverclockFactor>
      <VEF_BuildingBreakdownFactor>2</VEF_BuildingBreakdownFactor>
    </statBases>
    <tickerType>Rare</tickerType>
    <size>(5,5)</size>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-3)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <building>
      <deconstructible>true</deconstructible>
      <relatedBuildCommands>
        <li>VFEFactory_FactoryHopper</li>
      </relatedBuildCommands>
      <buildingTags>
        <li>Production</li>
      </buildingTags>
      <workTableRoomRole>VFEFactory_FactoryRoom</workTableRoomRole>
      <workTableNotInRoomRoleFactor>0.5</workTableNotInRoomRoleFactor>
    </building>
    <inspectorTabs>
      <li>PipeSystem.ITab_Processor</li>
    </inspectorTabs>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>540</basePowerConsumption>
      </li>
      <li>
        <compClass>PipeSystem.CompPowerTrader_Overclocked</compClass>
      </li>
      <li Class="CompProperties_HeatPusher">
        <compClass>PipeSystem.CompHeatPusherPowered_Overclocked</compClass>
        <heatPerSecond>14</heatPerSecond>
        <heatPushMaxTemperature>120</heatPushMaxTemperature>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="PipeSystem.CompProperties_AdvancedResourceProcessor">
        <notWorkingKey>VFEFactory_FactoryNotWorking</notWorkingKey>
        <canOverclock>false</canOverclock>
        <alwaysShowProgressBar>true</alwaysShowProgressBar>
        <!-- Part of the donor's list: the row's kludgedProcesses. -->
        <processes>
          <li>VFEFactory_AssembleComponent</li>
        </processes>
        <hideSettings>true</hideSettings>
      </li>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>VFEFactory_Booster</li>
          <li>VFEFactory_Heatsink</li>
        </linkableFacilities>
      </li>
      <li Class="CompProperties_CompAnalyzableUnlockResearch">
        <compClass>RimMandrake.WreckedMachines.CompMachineStudy</compClass>
        <analysisID>77120122</analysisID>
        <requiresMechanitor>false</requiresMechanitor>
        <canStudyInPlace>true</canStudyInPlace>
        <analysisRequiredRange>3~3</analysisRequiredRange>
        <analysisDurationHours>4</analysisDurationHours>
        <cooldownTicks>20000</cooldownTicks>
        <destroyedOnAnalyzed>false</destroyedOnAnalyzed>
        <activateTexPath>UI/Icons/Study</activateTexPath>
        <jobString>study the kludged automated assembler</jobString>
        <inspectString>A researcher can study how to refurbish this automated assembler.</inspectString>
        <completedLetterLabel>Kludged automated assembler studied: {RESEARCH} unlocked</completedLetterLabel>
        <completedLetter>By studying the kludged automated assembler, {PAWN_labelShort} has found which of its splices can stay and which must be redone to bring the machine close to what it was.\n\nThe research project {RESEARCH} can now be done at a research bench. Once it is done, order the refurbishment on the automated assembler itself. It needs an ancient component.</completedLetter>
        <completedLetterDef>PositiveEvent</completedLetterDef>
        <targetingParameters>
          <canTargetBuildings>false</canTargetBuildings>
          <canTargetAnimals>false</canTargetAnimals>
          <canTargetMechs>false</canTargetMechs>
          <onlyTargetControlledPawns>true</onlyTargetControlledPawns>
        </targetingParameters>
      </li>
      <li Class="RimMandrake.WreckedMachines.CompProperties_WreckedMachine"/>
    </comps>
    <modExtensions>
      <li Class="RimMandrake.WreckedMachines.WreckedMachineGrade">
        <grade>Kludged</grade>
        <line>assembler</line>
      </li>
    </modExtensions>
  </ThingDef>
  <!--REFURBISHED. All the original's work; no overclock; a little less reliable. Draws the donor's own picture.-->
  <ThingDef ParentName="BuildingBase">
    <defName>RM_WM_AutomatedAssembler_Refurbished</defName>
    <label>refurbished automated assembler</label>
    <description>An automated assembler refurbished from salvage by people who learned it from the wreck. The breaches are sealed, the wiring is mostly original again, and an ancient component holds the worst of it together.\n\nIt does everything the original did. It draws a little more power, runs a little hotter, breaks down more often and cannot be overclocked. It can be carried.\n\nFactory buildings need factory hoppers for input and output. Needs factory floor.</description>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Factories/AutomatedAssembler/AutomatedAssembler</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(6,6)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <thingCategories>
      <li>VFEFactory_FactoryCategory</li>
    </thingCategories>
    <costList>
      <Steel>300</Steel>
      <ComponentIndustrial>14</ComponentIndustrial>
      <ComponentSpacer>3</ComponentSpacer>
      <RM_WM_AncientComponent>1</RM_WM_AncientComponent>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <terrainAffordanceNeeded>FactoryFloor</terrainAffordanceNeeded>
    <rotatable>true</rotatable>
    <neverMultiSelect>true</neverMultiSelect>
    <uiIconScale>0.8</uiIconScale>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>True</useHitPoints>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <statBases>
      <Mass>100</Mass>
      <Beauty>-24</Beauty>
      <WorkToBuild>6200</WorkToBuild>
      <MaxHitPoints>710</MaxHitPoints>
      <Flammability>1</Flammability>
      <VEF_BuildingMaxOverclockFactor>1</VEF_BuildingMaxOverclockFactor>
      <VEF_BuildingBreakdownFactor>1.5</VEF_BuildingBreakdownFactor>
    </statBases>
    <tickerType>Rare</tickerType>
    <size>(5,5)</size>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-3)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <building>
      <relatedBuildCommands>
        <li>VFEFactory_FactoryHopper</li>
      </relatedBuildCommands>
      <buildingTags>
        <li>Production</li>
      </buildingTags>
      <workTableRoomRole>VFEFactory_FactoryRoom</workTableRoomRole>
      <workTableNotInRoomRoleFactor>0.5</workTableNotInRoomRoleFactor>
    </building>
    <inspectorTabs>
      <li>PipeSystem.ITab_Processor</li>
    </inspectorTabs>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>495</basePowerConsumption>
      </li>
      <li>
        <compClass>PipeSystem.CompPowerTrader_Overclocked</compClass>
      </li>
      <li Class="CompProperties_HeatPusher">
        <compClass>PipeSystem.CompHeatPusherPowered_Overclocked</compClass>
        <heatPerSecond>12</heatPerSecond>
        <heatPushMaxTemperature>120</heatPushMaxTemperature>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="PipeSystem.CompProperties_AdvancedResourceProcessor">
        <notWorkingKey>VFEFactory_FactoryNotWorking</notWorkingKey>
        <canOverclock>false</canOverclock>
        <alwaysShowProgressBar>true</alwaysShowProgressBar>
        <processes>
          <li>VFEFactory_AssembleComponent</li>
          <li>VFEFactory_AssembleAdvancedComponent</li>
          <li MayRequire="sarg.alphaanimals">VFEFactory_RefineUraniumCrystals</li>
          <li MayRequire="sarg.alphaanimals">VFEFactory_BlueGel_To_Hexagel</li>
          <li MayRequire="sarg.alphaanimals">VFEFactory_Make_HexagelCore</li>
        </processes>
        <hideSettings>true</hideSettings>
      </li>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>VFEFactory_Booster</li>
          <li>VFEFactory_Heatsink</li>
        </linkableFacilities>
      </li>
      <li Class="RimMandrake.WreckedMachines.CompProperties_WreckedMachine"/>
    </comps>
    <minifiedDef>MinifiedThing</minifiedDef>
    <modExtensions>
      <li Class="RimMandrake.WreckedMachines.WreckedMachineGrade">
        <grade>Refurbished</grade>
        <line>assembler</line>
      </li>
    </modExtensions>
  </ThingDef>
</Defs>
