<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline, no-game selftest for mandrake.rm.atmosphericbase (ATMOSPHERIC_BASE_BUILD_PROGRAM_1 Phase 1).
    Compiles the REAL production kernel and glow-access files against the REAL Assembly-CSharp, so the private
    CompGlower members the take-over restores are resolved against the shipped game, not a copy of it.
    NOT the mod build (RM_AtmosphericBase.csproj, one directory up, lists no file in this folder).
    Run: python3 src/RimMandrake/AtmosphericBase/selftest_atmosphericbase_kernel.py
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrakeAtmosphericBase.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.AtmosphericBase.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <DebugType>none</DebugType>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Kernel\RM_AtmosphericKernel.cs" />
    <Compile Include="..\Kernel\RM_SchemeKernel.cs" />
    <Compile Include="..\RM_GlowAccess.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
