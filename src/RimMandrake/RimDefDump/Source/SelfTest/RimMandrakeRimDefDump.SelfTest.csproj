<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RimDefDump offline fuzz (Approach B). Plain net8.0, zero RimWorld/Unity references: ../Kernel/RM_DumpKernel.cs and ../JsonWriter.cs are
    the PRODUCTION files the mod compiles, pulled in directly (both engine-free). A `using Verse;` landing in either breaks this build.
    Run: python3 src/RimMandrake/Utils/selftest_rimdefdump_fuzz.py [fuzz knobs]
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RimMandrakeRimDefDump.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.RimDefDump.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Kernel\RM_DumpKernel.cs" />
    <Compile Include="..\JsonWriter.cs" />
    <Compile Include="RimDefDumpFuzz.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
