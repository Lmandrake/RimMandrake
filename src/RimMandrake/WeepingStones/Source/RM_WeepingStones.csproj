<Project Sdk="Microsoft.NET.Sdk">

  <!--
    STOCKED_POOL_BUILD_1. Same recipe as
    src/RimMandrake/DivingInteraction/Source/RM_DivingInteraction.csproj —
    copy that header if this one goes stale.

    Build (the dotnet is WINDOWS-NATIVE and cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\Rimworld\src\RimMandrake\WeepingStones\Source\RM_WeepingStones.csproj -c Release

    Output lands in ../Assemblies/, which is where RimWorld looks.

    Wave 1 shipped Mod Settings only. Wave 2 adds the pen-zone designator and
    RM_MapComponent_PoolStock's per-pool bookkeeping (STOCKED_POOL_BUILD_1) —
    jobs (STOCK/FEED/HARVEST/CULL/RECAPTURE), handler injuries and the vizhik
    escape event are still owed and land in a following wave.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrake.WeepingStones</AssemblyName>
    <RootNamespace>RimMandrake.WeepingStones</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="RM_WeepingStonesSettings.cs" />
    <Compile Include="RM_BiomeWorker_WeepingStones.cs" />
    <Compile Include="RM_PoolBody.cs" />
    <Compile Include="RM_Zone_PoolPen.cs" />
    <Compile Include="RM_Designator_ZoneAdd_PoolPen.cs" />
    <Compile Include="RM_MapComponent_PoolStock.cs" />
    <Compile Include="RM_PoolStockDefOf.cs" />
    <Compile Include="RM_PoolBreederUtility.cs" />
    <Compile Include="RM_WorkGiver_NetPoolBreeder.cs" />
    <Compile Include="RM_JobDriver_NetPoolBreeder.cs" />
    <Compile Include="RM_WorkGiver_StockPoolPen.cs" />
    <Compile Include="RM_JobDriver_StockPoolPen.cs" />
    <Compile Include="RM_WorkGiver_FeedPoolPen.cs" />
    <Compile Include="RM_JobDriver_FeedPoolPen.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
