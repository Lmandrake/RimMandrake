<?xml version="1.0" encoding="utf-8"?>
<!--
  STOCKED_POOL_BUILD_1, wave 3 — the husbandry loop's job vocabulary (spec
  §3): STOCK is two jobs back to back (NET a wild breeder into a carried
  item, then carry that item into a pen and release it); FEED delivers feed
  to a pen that's due. Driver classes: RM_JobDriver_NetPoolBreeder/
  RM_JobDriver_StockPoolPen/RM_JobDriver_FeedPoolPen, same folder tree.
-->
<Defs>

  <JobDef>
    <defName>RM_NetPoolBreeder</defName>
    <driverClass>RimMandrake.WeepingStones.RM_JobDriver_NetPoolBreeder</driverClass>
    <reportString>netting breeding stock from TargetA.</reportString>
    <suspendable>false</suspendable>
  </JobDef>

  <JobDef>
    <defName>RM_StockPoolPen</defName>
    <driverClass>RimMandrake.WeepingStones.RM_JobDriver_StockPoolPen</driverClass>
    <reportString>carrying TargetA to a stocked pool.</reportString>
  </JobDef>

  <JobDef>
    <defName>RM_FeedPoolPen</defName>
    <driverClass>RimMandrake.WeepingStones.RM_JobDriver_FeedPoolPen</driverClass>
    <reportString>feeding a stocked pool.</reportString>
  </JobDef>

  <!-- Wave 4: HARVEST (sustainable per-species catch, spec §3) and CULL
       (the two-handler vhorrin set-piece, simplified to one handler for v1
       — see RM_JobDriver_CullVhorrin's own doc comment). RECAPTURE has no
       JobDef of its own: an escaped vizhik (RM_MapComponent_PoolStock.Pulse)
       lands outside its pen, which is exactly what RM_NetPoolBreeder already
       nets — the spec's own catch-method table calls this "picked off wet
       stone, gloved", the same handling action as netting any other wild
       stockable pawn. -->

  <JobDef>
    <defName>RM_HarvestPoolPen</defName>
    <driverClass>RimMandrake.WeepingStones.RM_JobDriver_HarvestPoolPen</driverClass>
    <reportString>harvesting TargetA from a stocked pool.</reportString>
  </JobDef>

  <JobDef>
    <defName>RM_CullVhorrin</defName>
    <driverClass>RimMandrake.WeepingStones.RM_JobDriver_CullVhorrin</driverClass>
    <reportString>culling the vhorrin in TargetA.</reportString>
    <suspendable>false</suspendable>
  </JobDef>

</Defs>
