<?xml version="1.0" encoding="utf-8"?>
<!--
  STOCKED_POOL_BUILD_1, wave 3 — the STOCK verb's carried item (spec §3:
  "Net breeders at a wild oasis, carry them home in a wet skin"). Seven
  rows, one per stockable species (RM_Vhorrin excluded by design — see
  RM_PoolBreederUtility's header). defName is the species PawnKindDef's
  defName plus the fixed "BreedingStock" suffix
  (RM_PoolBreederUtility.BreedingStockDefNameFor); RM_JobDriver_StockPoolPen
  reads that suffix back off to know which PawnKindDef to spawn on release
  — convention, not a DefModExtension, so there is nothing to keep in sync
  between this file and RM_StockedPoolFauna.xml.

  Shape verified against this mod's own working precedent for a small
  organic haulable, RM_StockedPoolMeats.xml (ParentName="OrganicProductBase")
  — a live breeder in a wet skin is exactly that: an organic, rottable,
  stack-of-one carry item, not a resource stack. Placeholder art: vanilla
  meat-stack icon tinted per species, same convention as the catch items
  (RM_StockedPoolCatchItems.xml).
-->
<Defs>

  <ThingDef ParentName="OrganicProductBase">
    <defName>RM_MurrinBreedingStock</defName>
    <label>murrin breeding stock</label>
    <description>A handful of live murrin, netted at a wild oasis and carried home in a wet skin. Release into a stocked pool pen to found or reinforce a stock.</description>
    <graphicData>
      <texPath>Things/Item/Resource/MeatFoodRaw/Meat_Small</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(150, 140, 110)</color>
    </graphicData>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <stackLimit>1</stackLimit>
    <statBases>
      <MaxHitPoints>40</MaxHitPoints>
      <MarketValue>14</MarketValue>
      <Mass>0.4</Mass>
      <Flammability>0.3</Flammability>
      <DeteriorationRate>4</DeteriorationRate>
    </statBases>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>1.5</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
  </ThingDef>

