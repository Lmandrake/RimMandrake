<?xml version="1.0" encoding="utf-8"?>
<!--
  STOCKED_POOL_BUILD_1 — the eight `specificMeatDef` targets named by
  RM_StockedPoolFauna.xml's race blocks. Shape verified against this
  mod family's own working precedent, RM_RawSlime
  (src/RimMandrake/GelatinousSlime/Defs/ThingDefs_Items/SlimeItems.xml):
  ParentName="OrganicProductBase", explicit ingestible/comps/thingCategories
  rather than a "MeatBase" parent (Core ships none we can safely inherit —
  animal meat defs are normally engine-autogenerated from `meatLabel`, which
  this mod bypasses by naming `specificMeatDef` explicitly per the two-def
  law's own "never invent past what the engine gives you" spirit).

  Doubt-free rows (murrin/skarrin/karrek/vizhik/vhorrin) carry no special
  thought — §2's own table says so explicitly for four of them and calls
  vizhik's doubt "mild" (not machined this wave) and vhorrin's "arithmetic,
  not flavor" (carried by RM_AteCullFeast on the FEAST meal, not the raw
  meat). Doubt-meat rows (loomu/huldu/ivvol) carry specialThoughtDirect/
  specialThoughtAsIngredient per RM_StockedPoolThoughts.xml, same folder.

  Placeholder art: vanilla meat stack textures retinted per species,
  distinct within this table (no shared texPath), same convention as the
  race file's placeholder pawn art.
-->
<Defs>

  <ThingDef ParentName="OrganicProductBase">
    <defName>RM_MurrinMeat</defName>
    <label>murrin meat</label>
    <description>Raw meat from a murrin, the stocked pool's gentle baseline. Good ordinary fish-flesh.</description>
    <graphicData>
      <texPath>Things/Item/Resource/MeatFoodRaw/Meat_Small</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <color>(150, 140, 110)</color>
    </graphicData>
    <thingCategories>
      <li>MeatRaw</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <MarketValue>2.4</MarketValue>
      <Mass>0.02</Mass>
      <Flammability>0.5</Flammability>
      <DeteriorationRate>6</DeteriorationRate>
      <Nutrition>0.05</Nutrition>
      <FoodPoisonChanceFixedHuman>0.02</FoodPoisonChanceFixedHuman>
    </statBases>
    <socialPropernessMatters>true</socialPropernessMatters>
    <ingestible>
      <foodType>Meat</foodType>
      <preferability>RawBad</preferability>
      <ingestEffect>EatMeat</ingestEffect>
      <ingestSound>RawMeat_Eat</ingestSound>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>2</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <tickerType>Rare</tickerType>
  </ThingDef>

