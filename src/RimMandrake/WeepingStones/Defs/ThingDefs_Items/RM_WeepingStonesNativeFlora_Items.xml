<?xml version="1.0" encoding="utf-8"?>
<!--
  WEEPINGSTONES_RM_MOD_BUILD_1, wave 2 — the three harvested items the new
  flora roster owes (RM_Salvecomb harvests straight to vanilla
  MedicineHerbal and needs no item of its own; RM_Rockfinger harvests to
  vanilla WoodLog).

  Placeholder art (pending, same convention as RUT_VorrelFruit): texPaths
  point at where each art job lands
  (infrastructure/artpipe/pending/weepingstones2_<item>.json).
-->
<Defs>

  <!-- ══════════════════════ RM_BladderFruit — bladderquill's harvest ══════════════════════ -->
  <ThingDef ParentName="PlantFoodRawBase">
    <defName>RM_BladderFruit</defName>
    <label>bladder-fruit</label>
    <description>A fat translucent pod cut from a bladderquill, sloshing with stored water and a little starchy pulp. Food and drink in one object -- where bladderquill stands, nobody dies thirsty.</description>
    <possessionCount>10</possessionCount>
    <graphicData>
      <texPath>Things/Item/Plant/RM_BladderFruit</texPath>
    </graphicData>
    <statBases>
      <MarketValue>1.8</MarketValue>
      <Mass>0.03</Mass>
      <Nutrition>0.06</Nutrition>
    </statBases>
    <ingestible>
      <foodType>VegetableOrFruit</foodType>
      <preferability>RawTasty</preferability>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>14</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
  </ThingDef>

  <!-- ══════════════════════ RM_DewgourdFruit — the farmed crop's harvest ══════════════════════ -->
  <ThingDef ParentName="PlantFoodRawBase">
    <defName>RM_DewgourdFruit</defName>
    <label>dewgourd</label>
    <description>A single melon-sized gourd, rind pale and waxy as the stone it grew in the shade of. Slow to grow, but a colony that has one crop under cultivation eats well for a long season -- the waxy rind keeps it edible long after most produce would have spoiled.</description>
    <possessionCount>5</possessionCount>
    <graphicData>
      <texPath>Things/Item/Plant/RM_DewgourdFruit</texPath>
    </graphicData>
    <statBases>
      <MarketValue>3.4</MarketValue>
      <Mass>0.6</Mass>
      <Nutrition>0.5</Nutrition>
    </statBases>
    <ingestible>
      <foodType>VegetableOrFruit</foodType>
      <preferability>RawTasty</preferability>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>60</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
  </ThingDef>


  <!-- ══════════════════════ RM_Korrim — the steamfrond's spice ══════════════════════
       Owner, Weeping Stones art sheet 2026-10-10, on RM_Steamfrond: "Creates a unique Star Wars cuisine
       spice." Invented name (RM tier, Q11a; no Wookieepedia hit for "korrim"). The oasis kitchens' one
       spice: the murrin broth (RM_StockedPoolRecipes.xml) is cooked with it. -->
  <ThingDef ParentName="ResourceBase">
    <defName>RM_Korrim</defName>
    <label>korrim</label>
    <description>A coarse, ash-pale spice scraped from the frond rims of a steamfrond and dried in the sun. It tastes of smoke and iron with a bright, sour edge, and a pinch of it changes a pot of anything. Nothing else grows it: every grain on the planet comes from a working seep oasis, and the oasis kitchens are known for it from one end of the desert roads to the other.</description>
    <graphicData>
      <texPath>Things/Item/Resource/RM_Korrim</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>4</MarketValue>
      <Mass>0.02</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <stackLimit>150</stackLimit>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
  </ThingDef>

</Defs>
