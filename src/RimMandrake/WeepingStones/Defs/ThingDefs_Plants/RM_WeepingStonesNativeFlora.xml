  <!-- ══════════════════════ RM_Steamfrond — the seep-oasis signature ══════════════════════ -->
  <ThingDef ParentName="PlantBase">
    <defName>RM_Steamfrond</defName>
    <label>steamfrond</label>
    <description>A rosette of mineral-pale fronds spiralled around a breathing vent, rims crusted with white salt bloom. Grows only at the seep oases -- the green eye in open nothing is a steamfrond ring before it is anything else. Its harvest scrapes seep-salt, a preservative and spice with the underworld's taste, and the only source of it.</description>
    <graphicData>
      <texPath>Things/Plant/RM_Steamfrond</texPath>
      <graphicClass>Graphic_Random</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <Nutrition>0.05</Nutrition>
      <Flammability>0.05</Flammability>
    </statBases>
    <plant>
      <fertilityMin>0.02</fertilityMin>
      <fertilitySensitivity>0.05</fertilitySensitivity>
      <growDays>12</growDays>
      <dieIfLeafless>false</dieIfLeafless>
      <visualSizeRange>0.4~0.8</visualSizeRange>
      <topWindExposure>0</topWindExposure>
      <harvestTag>Standard</harvestTag>
