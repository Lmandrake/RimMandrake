<?xml version="1.0" encoding="utf-8"?>
<!--
  FALLEN_WIRE_SHOCK_1 (GS-2): a live fallen aerial wire knocks out whoever touches it (RM_FallenWireShock.cs).
  Owner ruling, typed on the card 2026-10-08: "doesn't have to be instantly lethal. Death should be rare,
  instead it knocks people out and throws them back a little (more realistic). Only people with weak heart
  conditions or existing heart damage get taken out."
  This hediff is the knock-out: Consciousness capped at 0.1 downs the pawn (vanilla downing), then a dazed
  tail, gone after about two in-game hours. The lethal case is NOT this hediff; it is vanilla HeartAttack
  at its lethal severity, so the death reads as a heart attack. Numbers PROVISIONAL.
-->
<Defs>
  <HediffDef>
    <defName>RM_FallenWireShock</defName>
    <label>electric shock</label>
    <description>A jolt from a live wire lying on the ground. It threw the victim back and knocked them senseless; they will come round on their own.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.95, 0.85, 0.3)</defaultLabelColor>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <isBad>true</isBad>
    <stages>
      <li>
        <label>dazed</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.15</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>knocked out</label>
        <minSeverity>0.3</minSeverity>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-12</severityPerDay>
      </li>
    </comps>
  </HediffDef>
</Defs>
