  <!-- PowerSwitch -->
  <ThingStyleDef>
    <defName>PowerSwitch_Scrapper</defName>
    <label>scrapper</label>
    <graphicData>
      <texPath>RimMandrake/GimmeSomeSlack/PowerSwitch</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <damageData><rect>(0.2,0.2,0.6,0.6)</rect></damageData>
    </graphicData>
  </ThingStyleDef>
  <ThingStyleDef>
    <defName>PowerSwitch_Industrial</defName>
    <label>industrial</label>
