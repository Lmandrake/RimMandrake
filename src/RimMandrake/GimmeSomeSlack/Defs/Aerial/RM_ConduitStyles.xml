      <texPath>RimMandrake/GimmeSomeSlack/Styles/Industrial/WallLamp</texPath>
      <graphicClass>RimMandrake.GimmeSomeSlack.Aerial.Graphic_WallLampLook</graphicClass>
      <damageData>
        <rect>(0.2,0.2,0.6,0.6)</rect>
        <enabled>false</enabled>
      </damageData>
      <drawOffsetNorth>(0,0,0.2)</drawOffsetNorth>
      <drawOffsetSouth>(0,0,-0.196)</drawOffsetSouth>
      <drawOffsetWest>(-0.04,0,0)</drawOffsetWest>
      <drawOffsetEast>(0.04,0,0)</drawOffsetEast>
