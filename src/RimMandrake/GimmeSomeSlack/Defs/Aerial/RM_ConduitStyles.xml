    </graphicData>
  </ThingStyleDef>
  <!-- WallLamp (vanilla wall lamp; 0.2.0, bar wall_lamp_takes_looks): styled by the same picker as the standing lamp, NOT a run
       member. North, east and south pictures; west is east mirrored. The pictures are named for the way the lamp points, a wall
       attachment's facing is the side its wall is on: Graphic_WallLampLook draws the opposite facing's picture (Core/WallLampFacing).
       The offsets set each lamp's base on its wall's face and its head out over the floor; vanilla's own 0.9 hung them inside the wall. -->
  <ThingStyleDef>
    <defName>WallLamp_Scrapper</defName>
    <label>scrapper</label>
    <graphicData>
      <texPath>RimMandrake/GimmeSomeSlack/Styles/Scrapper/WallLamp</texPath>
      <graphicClass>RimMandrake.GimmeSomeSlack.Aerial.Graphic_WallLampLook</graphicClass>
      <damageData>
        <rect>(0.2,0.2,0.6,0.6)</rect>
        <enabled>false</enabled>
      </damageData>
      <drawOffsetNorth>(0,0,0.2)</drawOffsetNorth>
      <drawOffsetSouth>(0,0,-0.196)</drawOffsetSouth>
      <drawOffsetWest>(-0.04,0,0)</drawOffsetWest>
      <drawOffsetEast>(0.04,0,0)</drawOffsetEast>
    </graphicData>
  </ThingStyleDef>
  <ThingStyleDef>
    <defName>WallLamp_Industrial</defName>
    <label>industrial</label>
