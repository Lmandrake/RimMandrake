{
  "_doc": "RO4, OP3, OP4 in design/RimMandrake/operating_requirements_2026-11-01.md. Operations owns this table. routes: first match wins, by fnmatch on an ops_watch metric or alarm key, or a Dispatcher alarm kind. route program = the program contained it, the journal holds it, no incident; role = an incident for `reader`, rising the chain; owner = an incident that starts at him. cause: readings sharing it are one incident. class: for an alarm with no ranges class. readers: who may be filed for, and what wakes them. breaker_emergency is program because its own told row (relentless.breaker_same_cause) is the signal; dry:* because a dry tick writes nothing and its operator reads the alarm. selftest_incident.py fails on a kind this table misses (alarm_census.py reads them from the source) and `rimflow file --for` refuses a reader not here.",
  "policy": {
    "_doc": "chain[0] is the route's reader. ladder: minutes from told_at to chain[2] and chain[3]; chain[1] comes at the reading's ack_within_min. OP4: emergency reaches him at 60 unacked, distressed after 4 h. min_step_min: at least this long on a rung, which is what spaces the rungs after an expired recover_by. event_quiet_min covers a Dispatcher alarm, a reading with no sane value: 7 h clears the 6 h alarm_every_s rate limit, so a repeat is seen. runs_per_hour: the Conductor and fresh Operations runs incidents may ask for, shared by all incidents; the reader's own alarm run is held by the role's alarm_run_gap_s and daily limits.",
    "ack_within_min": 30,
    "recover_min": 60,
    "sustain_min": 60,
    "event_quiet_min": 420,
    "relapse_h": 6,
    "min_step_min": 15,
    "status_max_age_min": 45,
    "runs_per_hour": 2,
    "chain": ["Conductor", "Operations:fresh", "owner"],
    "ladder": {"emergency": [45, 60], "distressed": [60, 240]}
  },
  "readers": {
    "FOUNDRY": {"by": "doorbell", "seat": "FOUNDRY"},
    "BENCH": {"by": "Conductor quick checks and its sittings"},
    "OWNER": {"by": "the Conductor's sitting; never rung by a program"},
    "Operations": {"by": "alarm run"},
    "Conductor": {"by": "quick run"}
  },
  "routes": [
    {"match": "roles.*.acted_share", "route": "program", "_why": "RO1: report-only and coarse, nothing rings; the Conductor reads it in role_use"},
    {"match": "help_raised", "route": "role", "reader": "Operations", "cause": "work_belt", "_why": "relentless asked for help on an item and the ask itself failed"},
    {"match": "relentless.*", "route": "role", "reader": "Operations", "cause": "work_belt"},
    {"match": "seats.*", "route": "role", "reader": "Operations", "cause": "work_belt"},
    {"match": "plan.*", "route": "role", "reader": "Operations", "cause": "plan"},
    {"match": "disk.pool_breach", "route": "role", "reader": "Operations", "cause": "work_belt"},
    {"match": "disk.*", "route": "role", "reader": "Operations", "cause": "disk"},
    {"match": "scratch:sanity:*", "route": "role", "reader": "Operations", "cause": "disk"},
    {"match": "accounts.*", "route": "role", "reader": "Operations", "cause": "accounts"},
    {"match": "codex.*", "route": "role", "reader": "Operations", "cause": "accounts"},
    {"match": "account:switch:*", "route": "program"},
    {"match": "account:*", "route": "role", "reader": "Operations", "cause": "accounts"},
    {"match": "login:switch", "route": "program"},
    {"match": "login:back:*", "route": "program"},
    {"match": "login:*", "route": "role", "reader": "Operations", "cause": "accounts", "class": "emergency"},
    {"match": "evidence.*", "route": "role", "reader": "Operations", "cause": "evidence", "class": "emergency"},
    {"match": "steve.*", "route": "role", "reader": "Operations", "cause": "steve"},
    {"match": "companion.*", "route": "role", "reader": "Operations", "cause": "companion"},
    {"match": "arena.*", "route": "role", "reader": "FOUNDRY", "cause": "arena"},
    {"match": "flow.*", "route": "role", "reader": "Operations", "cause": "flow"},
    {"match": "testing.*", "route": "role", "reader": "Operations", "cause": "testing"},
    {"match": "timers.*", "route": "role", "reader": "Operations", "cause": "timers"},
    {"match": "timer:*", "route": "role", "reader": "Operations", "cause": "timers"},
    {"match": "signal:*", "route": "role", "reader": "Operations", "cause": "timers"},
    {"match": "ops_watch.*", "route": "role", "reader": "Operations", "cause": "ops_watch", "class": "emergency"},
    {"match": "ops:*", "route": "role", "reader": "Operations", "cause": "ops_watch"},
    {"match": "tick:*", "route": "role", "reader": "Operations", "cause": "dispatcher", "class": "emergency"},
    {"match": "incident:*", "route": "program", "_why": "the ledger itself failed: the Conductor log carries it, the deadman reads incidents.json"},
    {"match": "cap:recover:*", "route": "role", "reader": "Operations", "cause": "seats"},
    {"match": "cap:*", "route": "program"},
    {"match": "dead:*", "route": "role", "reader": "Operations", "cause": "seats"},
    {"match": "recover:*", "route": "role", "reader": "Operations", "cause": "seats"},
    {"match": "unwakeable:*", "route": "role", "reader": "Operations", "cause": "seats"},
    {"match": "undelivered:*", "route": "role", "reader": "Operations", "cause": "seats"},
    {"match": "peek:*", "route": "role", "reader": "Operations", "cause": "seats"},
    {"match": "withdraw_failed:*", "route": "role", "reader": "Operations", "cause": "seats"},
    {"match": "seat_declined:*", "route": "role", "reader": "Operations", "cause": "seats"},
    {"match": "idle_full_queue:*", "route": "role", "reader": "Operations", "cause": "seats"},
    {"match": "idle_bringback:*", "route": "role", "reader": "Operations", "cause": "seats", "_why": "DI1, CK4: the one restart was spent and the fresh window took nothing"},
    {"match": "decide:*", "route": "role", "reader": "Operations", "cause": "dispatcher"},
    {"match": "restart:*:held", "route": "program"},
    {"match": "restart:*", "route": "role", "reader": "Operations", "cause": "seats"},
    {"match": "long_helper:*", "route": "role", "reader": "Operations", "cause": "helpers"},
    {"match": "helper_lost:*", "route": "role", "reader": "Operations", "cause": "helpers"},
    {"match": "role:*:overbudget*", "route": "program"},
    {"match": "role:*:cap", "route": "program"},
    {"match": "role:*:cutoff", "route": "program"},
    {"match": "role:*", "route": "role", "reader": "Operations", "cause": "roles"},
    {"match": "jam", "route": "role", "reader": "Operations", "cause": "work_belt"},
    {"match": "understaffed", "route": "role", "reader": "Operations", "cause": "work_belt"},
    {"match": "books_stale", "route": "role", "reader": "Operations", "cause": "work_belt"},
    {"match": "step_raised", "route": "role", "reader": "Operations", "cause": "work_belt"},
    {"match": "lease_raised", "route": "role", "reader": "Operations", "cause": "work_belt"},
    {"match": "quarantine", "route": "role", "reader": "Operations", "cause": "work_belt"},
    {"match": "bundle_failed", "route": "role", "reader": "Operations", "cause": "work_belt"},
    {"match": "remove_failed", "route": "role", "reader": "Operations", "cause": "work_belt"},
    {"match": "breaker_emergency", "route": "program"},
    {"match": "publish:*", "route": "role", "reader": "Operations", "cause": "publish"},
    {"match": "budget:*", "route": "role", "reader": "Operations", "cause": "helpers"},
    {"match": "dry:*", "route": "program"},
    {"match": "blind:*", "route": "role", "reader": "Operations", "cause": "replay"},
    {"match": "paged:*", "route": "role", "reader": "Operations", "cause": "replay"},
    {"match": "selftest_false_hit", "route": "role", "reader": "Operations", "cause": "selftest_ledger"},
    {"match": "stalled:*", "route": "role", "reader": "Operations", "cause": "replay"},
    {"match": "twice_dead:*", "route": "role", "reader": "Operations", "cause": "replay"}
  ]
}
