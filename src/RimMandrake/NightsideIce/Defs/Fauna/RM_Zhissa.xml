<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
  RM_Zhissa: owned RM_ port of the Alpha Animals ShockGoat (sarg.alphaanimals AA_ShockGoat, 1.6/Defs/ThingDefs_Races). Phase 0 step P2 (biome_sprint_kickoff_2026-10-15.md 0.5.3), tool src/RimMandrake/Utils/aa_port.py. Free RM_ tier, home mod NightsideIce.
  Stats, tools, race fields and pawnkind numbers are the donor's own, as the creature the game shows today
  (our rename/tolerance patches on the donor def are folded in). Departures:
    - wildBiomes dropped (the biome roster casts it); AnimalStatExtension (donor stat defs) dropped.
    - VEF.* comps and VEF_ abilities kept, guarded MayRequire OskarPotocki.VanillaFactionsExpanded.Core (a framework we keep, not the donor).
    - texPath is OUR final path; the PNGs are owed through artpipe (no donor art is reused). Until the art is
      installed through the art ledger this def has no picture: ART OWED, never a pass of the art bar.
    - dessicated donor art and alternate random graphics dropped (vanilla fallback).
    - folded 3 op(s) from src/RimMandrake/NightsideIce/Patches/AA_ShockGoat_NightsideIce.xml
    - folded 4 op(s) from src/RimUtinni/UtinniPatches/Patches/NightsideIce_Rename.xml
-->
  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Zhissa</defName>
    <label>zhissa</label>
    <description>A pale-eyed grazer of the ice sheets, its body running with static it can discharge in a crackling pale-blue burst when threatened. Six eyes see nothing on the nightside — the zhissa reads the world entirely by heat instead. Farmed where it can be kept, for the milk it still gives.</description>
    <statBases>
      <MoveSpeed>3.5</MoveSpeed>
      <ComfyTemperatureMin>-5</ComfyTemperatureMin>
      <MarketValue>350</MarketValue>
      <FilthRate>8</FilthRate>
      <Wildness>0.3</Wildness>
    </statBases>
    <tools>
      <li>
        <label>left hoof</label>
        <capacities>
          <li>RM_Electric</li>
          <li>Poke</li>
        </capacities>
        <power>7</power>
        <cooldownTime>1.65</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftLeg</linkedBodyPartsGroup>
      </li>
      <li>
        <label>right hoof</label>
        <capacities>
          <li>RM_Electric</li>
          <li>Poke</li>
        </capacities>
        <power>7</power>
        <cooldownTime>1.65</cooldownTime>
        <linkedBodyPartsGroup>FrontRightLeg</linkedBodyPartsGroup>
      </li>
      <li>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>3</power>
        <cooldownTime>1.85</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
      </li>
      <li>
        <label>horns</label>
        <capacities>
          <li>RM_Electric</li>
        </capacities>
        <power>3</power>
        <cooldownTime>1.65</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
      </li>
    </tools>
    <comps>
      <li Class="CompProperties_Milkable">
        <milkDef>Milk</milkDef>
        <milkIntervalDays>2</milkIntervalDays>
        <milkAmount>12</milkAmount>
      </li>
    </comps>
    <race>
      <herdAnimal>true</herdAnimal>
      <predator>false</predator>
      <body>RM_SixEyedGoat</body>
      <baseBodySize>0.65</baseBodySize>
      <baseHungerRate>0.225</baseHungerRate>
      <baseHealthScale>1.0</baseHealthScale>
      <foodType>VegetarianRoughAnimal</foodType>
      <leatherDef>Leather_Plain</leatherDef>
      <useMeatFrom>Goat</useMeatFrom>
      <manhunterOnDamageChance>0.2</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0.05</manhunterOnTameFailChance>
      <trainability>Intermediate</trainability>
      <gestationPeriodDays>5.61</gestationPeriodDays>
      <litterSizeCurve>
        <points>
          <li>(0.5, 0)</li>
          <li>(1, 1)</li>
          <li>(3, 1)</li>
          <li>(3.5, 0)</li>
        </points>
      </litterSizeCurve>
      <lifeExpectancy>12</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.1</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.266</minAge>
          <soundWounded>Pawn_Goat_Wounded</soundWounded>
          <soundDeath>Pawn_Goat_Death</soundDeath>
          <soundAngry>Pawn_Goat_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
    </race>
    <tradeTags>
      <li>AnimalCommon</li>
      <li>AnimalFarm</li>
    </tradeTags>
