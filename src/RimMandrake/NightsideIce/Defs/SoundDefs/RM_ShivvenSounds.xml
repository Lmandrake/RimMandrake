<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_ShivvenSounds.xml        NightsideIce · NIGHTSIDEICE_SHIVVEN_BUILD_1
  The shivven's own voice, not the Stillsand's (the item's rule): a low groan through the ice while
  they travel under it (the tell), and a sharp crack when they break out. PLACEHOLDER GRAIN: vanilla
  clips already allowlisted in Utils/selftest_sound_paths.py, pitched to the role; real recordings
  are owed with the art.
-->
<Defs>
  <SoundDef>
    <defName>RM_ShivvenRumble</defName>
    <context>MapOnly</context>
    <sustain>True</sustain>
    <maxVoices>3</maxVoices>
    <priorityMode>PrioritizeNearest</priorityMode>
    <subSounds>
      <li>
        <muteWhenPaused>True</muteWhenPaused>
        <grains><li Class="AudioGrain_Clip"><clipPath>Ambience/Undercave/Undercave_Ambience_Loop_A</clipPath></li></grains>
        <volumeRange>18</volumeRange>
        <pitchRange>0.55~0.65</pitchRange>
        <distRange>8~40</distRange>
        <sustainLoop>True</sustainLoop>
      </li>
    </subSounds>
  </SoundDef>

  <SoundDef>
    <defName>RM_ShivvenBreach</defName>
    <context>MapOnly</context>
    <maxVoices>3</maxVoices>
    <priorityMode>PrioritizeNearest</priorityMode>
    <subSounds>
      <li>
        <muteWhenPaused>True</muteWhenPaused>
        <grains><li Class="AudioGrain_Clip"><clipPath>Misc/RockCollapse</clipPath></li></grains>
        <volumeRange>20</volumeRange>
        <pitchRange>1.5~1.7</pitchRange>
        <distRange>10~50</distRange>
      </li>
    </subSounds>
  </SoundDef>
</Defs>
