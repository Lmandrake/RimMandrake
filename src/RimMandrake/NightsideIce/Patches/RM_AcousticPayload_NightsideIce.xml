<?xml version="1.0" encoding="utf-8"?>
<!--
  GRAVSHIP_ACOUSTIC_SCANNER_1: the acoustic-scanner payload for RM_NightsideIce.
  Owner decision by question card 2026-10-06: the payload goes on EVERY biome of ours.

  Pure XML, FindMod-guarded on "RimMandrake: Acoustic Scanner", so the extension class
  is only named while its assembly is active. Every def is a defName STRING resolved
  at pulse time (GetNamedSilentFail), so a target naming another mod's def just hears
  nothing when that mod is absent. Each target is drawn from this biome's own content;
  the biome's sitting may re-author it. The reading is always banded by the scanner.
-->
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>RimMandrake: Acoustic Scanner</li>
    </mods>
    <match Class="PatchOperationAddModExtension">
      <xpath>/Defs/BiomeDef[defName="RM_NightsideIce"]</xpath>
      <value>
        <li Class="RimMandrake.AcousticScanner.RM_AcousticPayloadExtension">
          <quietText>Dirty ice, slowly flowing, and nothing in it but what it already swallowed long ago.</quietText>
          <targets>
            <li>
              <label>something breaking through</label>
              <reading>A fresh crack note with a push under it: something is coming up through the ice.</reading>
              <color>(1, 0.4, 0.3)</color>
              <weight>3</weight>
              <thingDefs>
                <li>RM_BreachCrack</li>
              </thingDefs>
            </li>
            <li>
              <label>frost-locked wreck</label>
              <reading>Hollow metal locked hard in the ice, exactly as it came down.</reading>
              <color>(0.8, 0.8, 0.85)</color>
              <thingDefs>
                <li>RM_NightsideWreckHull</li>
                <li>RM_NightsideWreckTank</li>
                <li>RM_NightsideExpeditionRig</li>
              </thingDefs>
            </li>
            <li>
              <label>void in the ice</label>
              <reading>The echo falls into a pocket the ice has closed over.</reading>
              <color>(0.6, 0.6, 0.9)</color>
              <hiddenCaves>true</hiddenCaves>
              <cellSampleStride>4</cellSampleStride>
            </li>
          </targets>
        </li>
      </value>
    </match>
  </Operation>
</Patch>
