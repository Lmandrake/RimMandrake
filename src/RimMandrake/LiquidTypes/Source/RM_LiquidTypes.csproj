<Project Sdk="Microsoft.NET.Sdk">

  <!--
    LIQUID_TYPES_SPIKES_1, Spike B. Same recipe as
    src/RimMandrake/EnvironmentalHazards/Source/RM_EnvironmentalHazards.csproj
    (copy its header if this one goes stale).

    Build (the dotnet is WINDOWS-NATIVE and cannot take a /mnt/d path):
      "C:\Users\Mandrake\.dotnet\dotnet.exe" build D:\Luke\dev\Rimworld\src\RimMandrake\LiquidTypes\Source\RM_LiquidTypes.csproj -c Release

    Output lands in ../Assemblies/, which is where RimWorld looks. No
    Harmony reference: both classes here are a DefModExtension and a
    MapComponent, both native XML/reflection extension points (verified via
    rimsage against Verse.Def.modExtensions and Verse.Map.FillComponents'
    AllSubclassesNonAbstract() scan) — no patch needed for either.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrake.LiquidTypes</AssemblyName>
    <RootNamespace>RimMandrake.LiquidTypes</RootNamespace>
    <Version>0.1.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="RM_LiquidProperties.cs" />
    <Compile Include="LiquidCorrosion.cs" />
    <Compile Include="LiquidIgnition.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
