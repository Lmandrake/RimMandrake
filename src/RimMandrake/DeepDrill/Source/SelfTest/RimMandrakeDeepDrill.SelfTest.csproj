<Project Sdk="Microsoft.NET.Sdk">
  <!-- DEEP_DRILL_HOME_BIOME_1 offline selftest. Plain net8.0, zero RimWorld references: ../Kernel/*.cs are the PRODUCTION files; the table is parsed from the shipped Defs XML. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>DeepDrill.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.DeepDrill.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Kernel\RM_DeepDrillKernel.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
