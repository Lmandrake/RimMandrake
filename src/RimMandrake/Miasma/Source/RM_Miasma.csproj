<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MIASMA_RM_MOD_BUILD_1. Same recipe as
    src/RimMandrake/Cauldron/Source/RM_Cauldron.csproj — copy that
    header if this one goes stale.

    Harmony IS referenced, for ONE patch only:
    RM_Patch_WardenYoungTrainableGate.cs (WARDEN_MOTHER_TRAINABLE_GATE_1),
    postfixes on Pawn_TrainingTracker.CanAssignToTrain/HasLearned — there is
    no XML lever for per-pawn TrainableDef exclusion. Everything else here is a
    plain extension point. (The six real mechanics this biome ships all live in the SHARED
    mandrake.rm.environmentalhazards assembly, which brings its own Harmony
    dependency separately — this mod only needs loadAfter on it, not a
    second Harmony reference.)

    Build (the dotnet is WINDOWS-NATIVE and cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\RimMandrake\src\RimMandrake\Miasma\Source\RM_Miasma.csproj -c Release

    Output lands in ../Assemblies/, which is where RimWorld looks.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrake.Miasma</AssemblyName>
    <RootNamespace>RimMandrake.Miasma</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="RM_MiasmaMod.cs" />
    <Compile Include="..\..\_Shared\SettingsKit\SettingsKitCore.cs" Link="Shared\SettingsKitCore.cs" />
    <Compile Include="..\..\_Shared\SettingsKit\SettingsKitDrawer.cs" Link="Shared\SettingsKitDrawer.cs" />
    <Compile Include="RM_MiasmaBiome.cs" />
    <Compile Include="RM_WardenMotherSuccession.cs" />
    <Compile Include="RM_MothersPrice.cs" />
    <Compile Include="RM_Patch_WardenYoungTrainableGate.cs" />
    <Compile Include="RM_CompProperties_PlantPredator.cs" />
    <Compile Include="RM_CompPlantPredator.cs" />
    <Compile Include="RM_AmbushFrogHunting.cs" />
    <Compile Include="RM_Attar.cs" />
    <Compile Include="RM_MapComponent_FlotsamYard.cs" />
    <Compile Include="RM_MapComponent_YoungCall.cs" />
    <Compile Include="RM_DecayCells.cs" />
    <Compile Include="RM_RottingBed.cs" />
    <Compile Include="RM_MiasmaProof.cs" />
    <Compile Include="RM_MiasmaKernel.cs" />
  </ItemGroup>

  <PropertyGroup Condition="'$(HarmonyDll)' == ''">
    <HarmonyDll>C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\2009463077\Current\Assemblies\0Harmony.dll</HarmonyDll>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
