<?xml version="1.0" encoding="utf-8"?>
<!-- MIASMA_DECAY_CELLS_1 part A. RM_DecayCell: power from rot (RM_CompPowerPlantDecay: output = 600 W x power setting x
     lerp(0.3, 1, feed fullness), zero when empty); fed raw food (what rots; meals left out so cooks are not robbed, and the refill target is configurable); after 600 units digested
     it becomes RM_RottingBed. Cost uses delta loam, delta silt and delta salt: the design's "silt ceramic" has no def
     (MEASURED: no ceramic item in src/), so raw delta silt stands in. Numbers // INVENTED. ART: the cell is artpipe
     RM_DecayCell; the rotting bed is still the vanilla wood-fired generator, tinted; the rotting bed's yield (Star Wars Cuisine) is MIASMA_ROTTING_BED_CUISINE_1 and its
     corpse disposal (MIASMA_ROTTING_BED_CORPSES_1) is RM_Building_RottingBed, Source/RM_RottingBed.cs. -->
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>RM_DecayCell</defName>
    <label>decay cell</label>
    <description>A sunken bed of delta loam with plates of silt and salt buried in it, wired to a terminal. Feed it rotting food and it makes power, more when the bed is full and less as the feed runs down. A cell that has digested enough rot gives out and goes over to a rotting bed for good.</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/RM_DecayCell</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.5</fillPercent>
    <pathCost>50</pathCost>
    <rotatable>false</rotatable>
    <size>(2,2)</size>
    <tickerType>Normal</tickerType>
    <canOverlapZones>false</canOverlapZones>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>2200</WorkToBuild>
      <Flammability>0.4</Flammability>
      <Beauty>-12</Beauty>
    </statBases>
    <costList>
      <RM_DeltaLoam>40</RM_DeltaLoam>
      <RM_DeltaSilt>20</RM_DeltaSilt>
      <RM_DeltaSalt>10</RM_DeltaSalt>
      <Steel>30</Steel>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>RimMandrake.Miasma.RM_CompPowerPlantDecay</compClass>
        <basePowerConsumption>-600</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Refuelable">
        <fuelLabel>rot</fuelLabel>
        <fuelGizmoLabel>Rot</fuelGizmoLabel>
        <fuelConsumptionRate>15.0</fuelConsumptionRate>
        <fuelCapacity>75.0</fuelCapacity>
        <fuelFilter>
          <categories>
            <li>FoodRaw</li>
          </categories>
        </fuelFilter>
        <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
        <initialConfigurableTargetFuelLevel>40</initialConfigurableTargetFuelLevel>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <canEjectFuel>false</canEjectFuel>
      </li>
    </comps>
    <modExtensions>
      <li Class="RimMandrake.Miasma.RM_DecayCellExtension">
        <lifetimeFeed>600</lifetimeFeed>
        <minOutputFraction>0.3</minOutputFraction>
        <spentDef>RM_RottingBed</spentDef>
      </li>
    </modExtensions>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Power</designationCategory>
    <researchPrerequisites>
      <li>RM_DecayCells</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>RM_RottingBed</defName>
    <label>rotting bed</label>
    <description>A spent decay cell gone over to rot: the plates are eaten through and the loam is a warm, stinking mat. It makes no power any more. Something could be grown in it, and a corpse laid in it rots down in a few days to bones and, if it was a person, a skull.</description>
    <thingClass>RimMandrake.Miasma.RM_Building_RottingBed</thingClass>
    <tickerType>Rare</tickerType>
    <graphicData>
      <texPath>Things/Building/Power/WoodFiredGenerator</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
      <color>(85,70,50)</color>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.3</fillPercent>
    <pathCost>40</pathCost>
    <rotatable>false</rotatable>
    <size>(2,2)</size>
    <canOverlapZones>false</canOverlapZones>
    <surfaceType>Item</surfaceType>
    <inspectorTabs>
      <li>ITab_Storage</li>
    </inspectorTabs>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <Flammability>0.3</Flammability>
      <Beauty>-20</Beauty>
    </statBases>
    <building>
      <claimable>true</claimable>
      <maxItemsInCell>1</maxItemsInCell>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <fixedStorageSettings>
        <filter>
          <categories>
            <li>Corpses</li>
          </categories>
          <disallowedCategories>
            <li>CorpsesMechanoid</li>
          </disallowedCategories>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Important</priority>
        <filter>
          <categories>
            <li>Corpses</li>
          </categories>
          <disallowedCategories>
            <li>CorpsesMechanoid</li>
          </disallowedCategories>
        </filter>
      </defaultStorageSettings>
    </building>
    <modExtensions>
      <li Class="RimMandrake.Miasma.RM_RottingBedExtension">
        <bonesPerBodySize>8</bonesPerBodySize>
        <bonesDef>RM_Bones</bonesDef>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- MIASMA_ROTTING_BED_CORPSES_1: no bone item exists in 1.6 + DLCs (MEASURED 2026-10-03, RimSage). ART: own
       (artpipe RM_Bones). -->
  <ThingDef ParentName="ResourceBase">
    <defName>RM_Bones</defName>
    <label>bones</label>
    <description>Clean bones left when a rotting bed has finished with a body. Light, dry and slightly greasy.</description>
    <graphicData>
      <texPath>Things/Item/Resource/RM_Bones</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>(0.7,0.7)</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>0.4</MarketValue>
      <MaxHitPoints>60</MaxHitPoints>
      <Mass>0.2</Mass>
      <Flammability>0.2</Flammability>
      <DeteriorationRate>0.5</DeteriorationRate>
      <Beauty>-3</Beauty>
    </statBases>
    <stackLimit>75</stackLimit>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
  </ThingDef>
</Defs>
