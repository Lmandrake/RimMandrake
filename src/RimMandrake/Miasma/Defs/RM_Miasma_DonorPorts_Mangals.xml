<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    DONOR RETIREMENT (owner, 2026-10-18: "Just put in placeholder art for now or donor copies and retire these
    mods!!! Just get it done."). Alpha Biomes (sarg.alphabiomes) defs the frozen campaign twin of the Miasma (RUT_Miasma)
    (src/RimUtinni/UtinniPatches/Defs/BiomeDefs) still named, ported as RM_ defs with the donor's own values so the
    painted planet keeps its ground and flora. Art: StandIn/<donor texPath> marked stand-in copies (art ledger,
    provenance kind=donor standin=true) until regenerated; texPaths not served by Alpha Biomes are left as they were.
  -->
  <!-- RM_MangroveTree: port of AB_MangroveTree (Alpha Biomes 1.6/Defs/ThingDefs_Plants/Plants_MiasmicMangrove.xml), plain XML copy 2026-10-18 for donor retirement.
       Dropped/replaced: AlphaBiomes.PlantPropertiesExtension dropped (no vanilla equivalent). -->
  <ThingDef ParentName="TreeBase">
    <defName>RM_MangroveTree</defName>
    <label>mangrove tree</label>
    <description>A tree that grows in saline or brackish water. They contain a complex salt filtration system and a complex root system to cope with saltwater immersion, and they are adapted to the low-oxygen conditions of waterlogged mud.\n\nPlant details: Mangrove trees are a cultivated plant that also appears in the wild, and it needs minimum terrain fertility of 1. Can be harvested for wood.</description>
    <descriptionHyperlinks>
      <ThingDef>WoodLog</ThingDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>StandIn/Things/Plants/AB_MangroveTree</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <shadowData>
        <volume>(0.18, 0.3, 0.15)</volume>
      </shadowData>
    </graphicData>
        <altitudeLayer>BuildingOnTop</altitudeLayer>
    <statBases>
      <Beauty>2</Beauty>
      <BeautyOutdoors>2</BeautyOutdoors>
      <Nutrition>1.2</Nutrition>
    </statBases>
    <plant>
      <mustBeWildToSow>true</mustBeWildToSow>
      <fertilityMin>0.7</fertilityMin>
      <leaflessGraphicPath>StandIn/Things/Plants/AB_MangroveTreeLeafless</leaflessGraphicPath>
      <growDays>14</growDays>
      <harvestWork>1200</harvestWork>
      <harvestYield>50</harvestYield>
      <wildClusterRadius>10</wildClusterRadius>
      <wildClusterWeight>11</wildClusterWeight>
      <visualSizeRange>2.8~3.8</visualSizeRange>
    </plant>
    <ingestible/>
    </ThingDef>

  <!-- RM_ParasiticMangrove: port of AB_ParasiticMangrove (Alpha Biomes 1.6/Defs/ThingDefs_Plants/Plants_MiasmicMangrove.xml), plain XML copy 2026-10-18 for donor retirement.
       Dropped/replaced: AlphaBiomes.PlantPropertiesExtension dropped (no vanilla equivalent). -->
  <ThingDef ParentName="BushBase">
      <defName>RM_ParasiticMangrove</defName>
    <label>parasitic mangrove</label>
    <description>A weird, colourful plant adapted to extract nutrients from mangrove trees. Its own roots are covered in barbs capable of puncturing and integrating into the root systems of mangrove trees, acting as a parasitic organism. Its sap is slightly poisonous to many animals, but primates seem to be unaffected by it, and it can be used in fact as a crude herbal medicine.\n\nPlant details: Parasitic mangrove is a wild plant that cannot be cultivated, and it needs minimum terrain fertility of 1. Can be harvested for herbal medicine.\n\nBased on art by Tyson Roberts, https://www.artstation.com/tyson</description>
    <graphicData>
      <texPath>StandIn/Things/Plants/AB_ParasiticMangrove</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <shadowData>
        <volume>(0.18, 0.3, 0.15)</volume>
      </shadowData>
    </graphicData>
    <statBases>
      <Beauty>-1</Beauty>
      <Nutrition>0.7</Nutrition>
    </statBases>
    <ingestible>
      <preferability>NeverForNutrition</preferability>
    </ingestible>
    <plant>
      <fertilityMin>0.7</fertilityMin>
      <wildClusterRadius>3</wildClusterRadius>
      <wildClusterWeight>4</wildClusterWeight>
      <visualSizeRange>1~2</visualSizeRange>
      <harvestYield>1</harvestYield>
      <harvestWork>1250</harvestWork>
      <harvestTag>Standard</harvestTag>
      <harvestAfterGrowth>0.30</harvestAfterGrowth>
      <harvestedThingDef>MedicineHerbal</harvestedThingDef>
    </plant>
    </ThingDef>

  <!-- RM_MangrovePalm: port of AB_MangrovePalm (Alpha Biomes 1.6/Defs/ThingDefs_Plants/Plants_MiasmicMangrove.xml), plain XML copy 2026-10-18 for donor retirement.
       Dropped/replaced: AlphaBiomes.PlantPropertiesExtension dropped (no vanilla equivalent). -->
  <ThingDef ParentName="TreeBase">
    <defName>RM_MangrovePalm</defName>
    <label>mangrove palm</label>
    <description>A palm tree adapted to the mangrove conditions.\n\nBased on art by Tyson Roberts, https://www.artstation.com/tyson</description>
    <graphicData>
      <texPath>StandIn/Things/Plants/AB_MangrovePalm</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <shadowData>
        <volume>(0.18, 0.3, 0.15)</volume>
      </shadowData>
    </graphicData>
        <altitudeLayer>BuildingOnTop</altitudeLayer>
    <statBases>
      <Beauty>2</Beauty>
      <Nutrition>1.2</Nutrition>
    </statBases>
    <plant>
    <leaflessGraphicPath>StandIn/Things/Plants/AB_MangrovePalmLeafless</leaflessGraphicPath>
      <fertilityMin>0.7</fertilityMin>
      <growDays>14</growDays>
      <harvestWork>550</harvestWork>
      <harvestYield>18</harvestYield>
      <wildClusterRadius>10</wildClusterRadius>
      <wildClusterWeight>11</wildClusterWeight>
      <visualSizeRange>1.8~2.5</visualSizeRange>
    </plant>
    <ingestible/>
    </ThingDef>
</Defs>
