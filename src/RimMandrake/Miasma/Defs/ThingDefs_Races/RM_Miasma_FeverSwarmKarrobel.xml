<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_Miasma_FeverSwarmKarrobel.xml   Miasma - MIASMA_SWARM_COMPOSTER_PORT_1
  RM_FeverSwarm (vector and the mangals' only pollinator) and RM_Karrobel (delta-loam composter), ported from the RUT_ originals. Invented, franchise-free, RM tier (Q11a). Names are working names (MIASMA_SHIPPING_NAMES_1).
-->
<Defs>

  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_FeverSwarm</defName>
    <label>fever swarm</label>
    <description>Individually a fingernail-length, wet-winged thing, gold-dusted and easy to miss. The fever swarm is never seen alone — only as a slow-drifting haze of them, thickest over flowering mangals at the heat of the day. That haze is the green-gold breath the Miasma is named for, seen up close: the same swarm that carries the biome's fevers from pawn to pawn is the only thing that carries pollen between its flowers. You cannot have the trees without the fever.</description>
    <statBases>
      <MoveSpeed>2.2</MoveSpeed>
      <Mass>0.02</Mass>
      <MarketValue>8</MarketValue>
      <Wildness>0.15</Wildness>
      <ComfyTemperatureMin>20</ComfyTemperatureMin>
      <ComfyTemperatureMax>60</ComfyTemperatureMax>
      <MaxFlightTime>10</MaxFlightTime>
      <FlightCooldown>5</FlightCooldown>
    </statBases>
    <uiIconScale>0.8</uiIconScale>
    <tools>
      <li>
        <label>mandibles</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>1</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <race>
      <body>BeetleLike</body>
      <predator>false</predator>
      <baseBodySize>0.05</baseBodySize>
      <baseHealthScale>0.2</baseHealthScale>
      <baseHungerRate>0.1</baseHungerRate>
      <foodType>OmnivoreAnimal, AnimalProduct</foodType>
      <fleshType>Insectoid</fleshType>
      <bloodDef>Filth_BloodInsect</bloodDef>
      <bloodSmearDef>Filth_BloodSmear</bloodSmearDef>
      <meatColor>(160,168,139)</meatColor>
      <meatMarketValue>0.1</meatMarketValue>
      <useMeatFrom>Megaspider</useMeatFrom>
      <herdAnimal>false</herdAnimal>
      <roamMtbDays>2</roamMtbDays>
      <trainability>None</trainability>
      <manhunterOnDamageChance>0</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0</manhunterOnTameFailChance>
      <lifeExpectancy>2</lifeExpectancy>
      <gestationPeriodDays>2</gestationPeriodDays>
      <litterSizeCurve>
        <points>
          <li>(0.5, 0)</li>
          <li>(1, 1)</li>
          <li>(3, 1.8)</li>
          <li>(3.5, 0)</li>
        </points>
      </litterSizeCurve>
      <lifeStageAges>
        <li>
          <def>EusocialInsectLarva</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>EusocialInsectJuvenile</def>
          <minAge>0.02</minAge>
        </li>
        <li>
          <def>EusocialInsectAdult</def>
          <minAge>0.15</minAge>
        </li>
      </lifeStageAges>
      <flightStartChanceOnJobStart>0.3</flightStartChanceOnJobStart>
      <flightSpeedFactor>2.5</flightSpeedFactor>
      <canFlyIntoMap>true</canFlyIntoMap>
      <canLeaveMapFlying>true</canLeaveMapFlying>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
      <soundEating>Insectoid_Eat</soundEating>
    </race>
    <tradeTags>
      <li>AnimalInsect</li>
    </tradeTags>
  </ThingDef>

