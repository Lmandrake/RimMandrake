    <ecoSystemWeight>0.15</ecoSystemWeight>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/RM_FeverSwarm/RM_FeverSwarm</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>0.3</drawSize>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/RM_FeverSwarm/RM_FeverSwarm</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>0.35</drawSize>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/RM_FeverSwarm/RM_FeverSwarm</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>0.4</drawSize>
        </bodyGraphicData>
