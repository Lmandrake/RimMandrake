    </lifeStages>
  </PawnKindDef>



  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Karrobel</defName>
    <label>karrobel</label>
    <description>A thick, wedge-bodied scuttler, tapering to a hardened blade of a head it drives into the muck. Rarely seen whole — mostly it is a churned ring of castings and a pair of banded, mud-caked plates breaking the surface. Where it has worked, the ground turns rich: clean delta loam, cast up from whatever the Miasma's sin-soup was before.</description>
    <statBases>
      <MoveSpeed>1.6</MoveSpeed>
      <Mass>6</Mass>
      <MarketValue>45</MarketValue>
      <Wildness>0.25</Wildness>
      <ComfyTemperatureMin>15</ComfyTemperatureMin>
      <ComfyTemperatureMax>55</ComfyTemperatureMax>
      <ArmorRating_Sharp>0.2</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.1</ArmorRating_Blunt>
    </statBases>
    <tools>
      <li>
        <label>wedge head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>5</power>
        <cooldownTime>2.2</cooldownTime>
        <linkedBodyPartsGroup>HeadClaw</linkedBodyPartsGroup>
        <chanceFactor>0.6</chanceFactor>
      </li>
      <li>
        <label>mandibles</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>4</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
      </li>
    </tools>
    <race>
      <body>BeetleLikeWithClaw</body>
      <predator>false</predator>
      <baseBodySize>0.5</baseBodySize>
      <baseHealthScale>0.8</baseHealthScale>
      <baseHungerRate>0.5</baseHungerRate>
      <foodType>OmnivoreRoughAnimal</foodType>
      <fleshType>Insectoid</fleshType>
      <bloodDef>Filth_BloodInsect</bloodDef>
      <bloodSmearDef>Filth_BloodSmear</bloodSmearDef>
      <meatColor>(150,140,120)</meatColor>
      <meatMarketValue>0.3</meatMarketValue>
      <herdAnimal>false</herdAnimal>
      <roamMtbDays>4</roamMtbDays>
      <trainability>None</trainability>
      <manhunterOnDamageChance>0.02</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0.02</manhunterOnTameFailChance>
      <lifeExpectancy>8</lifeExpectancy>
      <gestationPeriodDays>6</gestationPeriodDays>
      <litterSizeCurve>
        <points>
          <li>(0.5, 0)</li>
          <li>(1, 1)</li>
          <li>(2, 1.2)</li>
          <li>(2.5, 0)</li>
        </points>
      </litterSizeCurve>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.15</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.4</minAge>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
      <soundEating>Insectoid_Eat</soundEating>
    </race>
    <comps>
      <li Class="RimMandrake.EnvironmentalHazards.CompProperties_GatherableGas" MayRequire="mandrake.rm.environmentalhazards">
        <gatherIntervalDays>3</gatherIntervalDays>
        <gatherAmount>8</gatherAmount>
        <gatherDef>RM_DeltaLoam</gatherDef>
        <fullnessLabelKey>RM_DeltaLoamCastings</fullnessLabelKey>
      </li>
      <li Class="RimMandrake.CreatureBehaviors.RM_CompProperties_VerminBreeder">
        <pawnSpawnIntervalDays>1.5~3</pawnSpawnIntervalDays>
        <pawnSpawnRadius>3</pawnSpawnRadius>
      </li>
    </comps>
    <modExtensions>
      <li Class="RimMandrake.CreatureBehaviors.RM_VerminPressureExtension">
        <populationSoftCap>40</populationSoftCap>
        <populationHardCap>100</populationHardCap>
        <populationGroupTag>RM_MiasmaScuttlers</populationGroupTag>
      </li>
    </modExtensions>
    <tradeTags>
      <li>AnimalExotic</li>
    </tradeTags>
  </ThingDef>

