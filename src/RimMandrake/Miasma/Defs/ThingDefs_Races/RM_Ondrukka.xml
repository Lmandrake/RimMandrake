<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
  RM_Ondrukka: owned RM_ port of the black swarmling (VFEI2_BlackSwarmling, shipped by sarg.alphaanimals in its
  1.6/Mods/VFEInsectoids2 folder). Free RM_ tier, home mod Miasma, one biome (the Miasma, 0.5, vermin).
  Owner rulings: Miasma sheet 2026-10-08, "Picture good, rewrite the description please and rename." (name invented:
  ondrukka); Phase 0 P3 Q4 by card 2026-10-15, "Keep the ondrukka as our own creature without the cocoon."
  Stats, tools and race numbers are the donor's own, as the creature the game shows today (the Ashkarr tolerance
  pin -50.1..60 is folded in). Departures, all to make it plain XML with no VFE Insectoids reference:
    - the cocoon comp (AlphaBehavioursAndEvents.CompProperties_BlackSwarmlingToCocoon) is GONE: an ondrukka is a grub
      for life and never becomes anything else; the description no longer calls it "the young of something larger".
    - VEF MakeOtherPawnsFlee comp dropped, so the description no longer promises other animals avoid a heap.
    - VFEI2 render tree, VFEI2_Swarmling body, VanishInsect death action, eusocial life stages and the Insect
      faction dropped: vanilla BeetleLike body, Filth_BloodInsect blood, AnimalBaby/Juvenile/Adult life stages.
    - wildBiomes absent (the Miasma roster casts it).
    - grub-sized fixes: trainability None (donor Intermediate), small-scratch melee sounds (donor big-bash), and a
      wild group of 3~8 so the swarm the description promises spawns as one (donor: single).
    - texPath is OUR path; the picture is the one the owner picked on the Miasma sheet (set B, the 2026-10-05
      artpipe redraw), installed through the art ledger.
  -->
  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Ondrukka</defName>
    <label>ondrukka</label>
    <description>Glossy black grubs no longer than a hand, crawling in loose, chittering heaps through the Miasma's leaf-rot. An ondrukka is born a grub, eats the rot it was born in, and dies a grub a season or two later: there is nothing larger waiting inside it. Slow, soft and easy to crush, one alone is nothing at all. What matters is how many there are, and they are seldom few.</description>
    <statBases>
      <MoveSpeed>1.24</MoveSpeed>
      <Flammability>0.7</Flammability>
      <ComfyTemperatureMin>-50.1</ComfyTemperatureMin>
      <ComfyTemperatureMax>60</ComfyTemperatureMax>
      <MarketValue>50</MarketValue>
      <ArmorRating_Blunt>0</ArmorRating_Blunt>
      <ArmorRating_Sharp>0</ArmorRating_Sharp>
      <LeatherAmount>0</LeatherAmount>
      <MeatAmount>0</MeatAmount>
      <Wildness>0.2</Wildness>
    </statBases>
    <tools>
      <li>
        <label>mouth</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>1</power>
        <armorPenetration>0.07</armorPenetration>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
      </li>
    </tools>
    <race>
      <body>BeetleLike</body>
      <bloodDef>Filth_BloodInsect</bloodDef>
      <baseHungerRate>0.05</baseHungerRate>
      <baseBodySize>0.2</baseBodySize>
      <baseHealthScale>0.2</baseHealthScale>
      <foodType>OmnivoreRoughAnimal</foodType>
      <useMeatFrom>Megaspider</useMeatFrom>
      <trainability>None</trainability>
      <lifeExpectancy>2</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.03</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.2</minAge>
          <soundWounded>Pawn_BigInsect_Pain</soundWounded>
          <soundDeath>Pawn_BigInsect_Death</soundDeath>
          <soundCall>Pawn_BigInsect_Call</soundCall>
          <soundAngry>Pawn_BigInsect_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
  </ThingDef>
  <PawnKindDef ParentName="AnimalKindBase">
    <defName>RM_Ondrukka</defName>
    <label>ondrukka</label>
    <race>RM_Ondrukka</race>
    <combatPower>10</combatPower>
    <canArriveManhunter>false</canArriveManhunter>
    <ecoSystemWeight>0.50</ecoSystemWeight>
    <wildGroupSize>3~8</wildGroupSize>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/RM_Ondrukka/RM_Ondrukka</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.5</drawSize>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/RM_Ondrukka/RM_Ondrukka</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.5</drawSize>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/RM_Ondrukka/RM_Ondrukka</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.5</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>
</Defs>
