      <height>Middle</height>
      <depth>Outside</depth>
      <parts>
        <li>
          <def>Stomach</def>
          <coverage>0.08</coverage>
          <depth>Inside</depth>
        </li>
        <li>
          <def>Heart</def>
          <coverage>0.02</coverage>
          <depth>Inside</depth>
        </li>
        <li>
          <def>RM_LastvinePhloem</def>
          <coverage>0.5</coverage>
          <depth>Inside</depth>
        </li>
        <li>
