      <damageAmountBase>15</damageAmountBase>
      <armorPenetrationBase>0.35</armorPenetrationBase>
      <stoppingPower>1.1</stoppingPower>
      <speed>40</speed>
    </projectile>
  </ThingDef>

  <!-- Body: Alpha Animals' AA_FlyTrap re-declared as ours, same hit points, coverage and tags. -->
