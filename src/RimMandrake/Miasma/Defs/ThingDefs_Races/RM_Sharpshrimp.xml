<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
  RM_Sharpshrimp: owned RM_ port of the Alpha Animals RaptorShrimp (sarg.alphaanimals AA_RaptorShrimp, 1.6/Defs/ThingDefs_Races). Phase 0 step P2 (biome_sprint_kickoff_2026-10-15.md 0.5.3), tool src/RimMandrake/Utils/aa_port.py. Free RM_ tier, home mod Miasma.
  Stats, tools, race fields and pawnkind numbers are the donor's own, as the creature the game shows today
  (our rename/tolerance patches on the donor def are folded in). Departures:
    - wildBiomes dropped (the biome roster casts it); AnimalStatExtension (donor stat defs) dropped.
    - VEF.* comps and VEF_ abilities kept, guarded MayRequire OskarPotocki.VanillaFactionsExpanded.Core (a framework we keep, not the donor).
    - texPath is OUR final path; the PNGs are owed through artpipe (no donor art is reused). Until the art is
      installed through the art ledger this def has no picture: ART OWED, never a pass of the art bar.
    - dessicated donor art and alternate random graphics dropped (vanilla fallback).
    - folded 2 op(s) from src/RimUtinni/UtinniPatches/Patches/AnimalTolerances_Ashkarr.xml
    - folded 4 op(s) from src/RimUtinni/UtinniPatches/Patches/Miasma_Rename.xml
    - texPath Things/Item/Resource/AA_Chitin -> Things/Item/Resource/RM_Leather_RaptorPlatesMiasma (ART OWED, RM_Leather_RaptorPlatesMiasma)
-->
  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Sharpshrimp</defName>
    <label>sharpshrimp</label>
    <description>A crustacean as tall as a man, stalking the reed-beds on jointed legs, its forelimbs ending in two long serrated blades. The sharpshrimp hunts from cover, motionless among the stems for hours with only its stalked eyes turning, then lunges faster than the eye can follow. Its shell turns bullets, and its flesh knits back almost as fast as it is cut — a sharpshrimp is not dead until it has stopped moving for a long while. People who lose companions in the Miasma's reeds rarely see what took them.</description>
    <statBases>
      <MoveSpeed>4.70</MoveSpeed>
      <ComfyTemperatureMin>10</ComfyTemperatureMin>
      <MarketValue>750</MarketValue>
      <ArmorRating_Sharp>0.7</ArmorRating_Sharp>
      <FilthRate>4</FilthRate>
      <Wildness>0.9</Wildness>
      <ComfyTemperatureMax>74.2</ComfyTemperatureMax>
    </statBases>
    <tools>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>6</power>
        <cooldownTime>1.65</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <chanceFactor>0.1</chanceFactor>
      </li>
      <li>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>25</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>RM_MouthMiasma</linkedBodyPartsGroup>
      </li>
      <li>
        <label>left blade</label>
        <capacities>
          <li>RM_Pierce</li>
        </capacities>
        <power>17</power>
        <cooldownTime>1.55</cooldownTime>
        <linkedBodyPartsGroup>RM_BladeAttackToolMiasma</linkedBodyPartsGroup>
        <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>20</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>right blade</label>
        <capacities>
          <li>RM_Pierce</li>
        </capacities>
        <power>17</power>
        <cooldownTime>1.55</cooldownTime>
        <linkedBodyPartsGroup>RM_BladeAttackToolMiasma</linkedBodyPartsGroup>
        <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>20</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
    </tools>
    <comps>
      <li Class="VEF.AnimalBehaviours.CompProperties_Regeneration" MayRequire="OskarPotocki.VanillaFactionsExpanded.Core">
        <rateInTicks>20</rateInTicks>
      </li>
    </comps>
    <race>
      <herdAnimal>false</herdAnimal>
      <predator>true</predator>
      <body>RM_SnakeWithTwoLimbsMiasma</body>
      <baseBodySize>1.40</baseBodySize>
      <baseHungerRate>0.4</baseHungerRate>
      <baseHealthScale>3</baseHealthScale>
      <foodType>CarnivoreAnimal, OvivoreAnimal</foodType>
      <leatherDef>RM_Leather_RaptorPlatesMiasma</leatherDef>
      <meatLabel>sharpshrimp flesh</meatLabel>
      <trainability>Intermediate</trainability>
      <manhunterOnTameFailChance>0.1</manhunterOnTameFailChance>
      <manhunterOnDamageChance>.8</manhunterOnDamageChance>
      <gestationPeriodDays>12</gestationPeriodDays>
      <litterSizeCurve>
