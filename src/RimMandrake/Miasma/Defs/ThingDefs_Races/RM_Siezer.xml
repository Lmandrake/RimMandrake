<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
  RM_Siezer: owned RM_ port of the Alpha Animals Lockjaw (sarg.alphaanimals AA_Lockjaw, 1.6/Defs/ThingDefs_Races). Phase 0 step P2 (biome_sprint_kickoff_2026-10-15.md 0.5.3), tool src/RimMandrake/Utils/aa_port.py. Free RM_ tier, home mod Miasma.
  Stats, tools, race fields and pawnkind numbers are the donor's own, as the creature the game shows today
  (our rename/tolerance patches on the donor def are folded in). Departures:
    - wildBiomes dropped (the biome roster casts it); AnimalStatExtension (donor stat defs) dropped.
    - VEF.* comps and VEF_ abilities kept, guarded MayRequire OskarPotocki.VanillaFactionsExpanded.Core (a framework we keep, not the donor).
    - texPath is OUR final path; the PNGs are owed through artpipe (no donor art is reused). Until the art is
      installed through the art ledger this def has no picture: ART OWED, never a pass of the art bar.
    - dessicated donor art and alternate random graphics dropped (vanilla fallback).
    - folded 2 op(s) from src/RimUtinni/UtinniPatches/Patches/AnimalTolerances_Ashkarr.xml
    - folded 3 op(s) from src/RimUtinni/UtinniPatches/Patches/Miasma_Rename.xml
    - useMeatFrom AA_RoughPlatedMonitor -> Iguana (vanilla; PROVISIONAL)
-->
  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Siezer</defName>
    <label>siezer</label>
    <description>A mud-whale of the Miasma's channels: a short, tapering body driven by four broad flippers, carrying a head fully half its own size. Most of that head is jaw — ranks of overlapping teeth on a hinge so heavy that once it closes, it does not open again until the siezer decides. It hauls itself through the silt half-submerged, a long grey ridge with two small eyes, slow and unhurried in everything but the bite. It prefers the channels' own wildlife to people, but nothing it has seized has ever been pulled free.</description>
    <statBases>
      <MoveSpeed>3.00</MoveSpeed>
      <ComfyTemperatureMin>-10</ComfyTemperatureMin>
      <MarketValue>550</MarketValue>
      <FilthRate>16</FilthRate>
      <Wildness>0.8</Wildness>
      <ComfyTemperatureMax>74.2</ComfyTemperatureMax>
    </statBases>
    <tools>
      <li>
        <capacities>
          <li>RM_LockJawDamage</li>
        </capacities>
        <power>13</power>
        <cooldownTime>1.85</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>10</power>
        <cooldownTime>1.65</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <race>
      <body>RM_Crocodile</body>
      <baseBodySize>2.5</baseBodySize>
      <baseHealthScale>2.7</baseHealthScale>
      <baseHungerRate>0.5</baseHungerRate>
      <foodType>CarnivoreAnimal</foodType>
      <predator>true</predator>
      <maxPreyBodySize>0.95</maxPreyBodySize>
      <useMeatFrom>Iguana</useMeatFrom>
      <trainability>Intermediate</trainability>
      <manhunterOnTameFailChance>0.2</manhunterOnTameFailChance>
      <manhunterOnDamageChance>0.5</manhunterOnDamageChance>
      <leatherDef>Leather_Lizard</leatherDef>
      <gestationPeriodDays>10</gestationPeriodDays>
      <lifeExpectancy>45</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.25</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.5</minAge>
          <soundWounded>Pawn_Rhinoceros_Wounded</soundWounded>
          <soundDeath>Pawn_Rhinoceros_Death</soundDeath>
          <soundCall>Pawn_Rhinoceros_Call</soundCall>
          <soundAngry>Pawn_Rhinoceros_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <tradeTags>
      <li>AnimalUncommon</li>
      <li>AnimalFighter</li>
    </tradeTags>
  </ThingDef>
