      <lifeExpectancy>2</lifeExpectancy>
      <gestationPeriodDays>2.5</gestationPeriodDays>
      <litterSizeCurve>
        <points>
          <li>(0.5, 0)</li>
          <li>(1, 1.6)</li>
          <li>(3, 2.2)</li>
          <li>(3.5, 0)</li>
        </points>
      </litterSizeCurve>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.08</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.25</minAge>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
      <soundEating>Insectoid_Eat</soundEating>
    </race>
    <comps>
      <li Class="RimMandrake.CreatureBehaviors.RM_CompProperties_VerminBreeder" MayRequire="mandrake.rm.creaturebehaviors">
        <pawnSpawnIntervalDays>1~2</pawnSpawnIntervalDays>
        <pawnSpawnRadius>4</pawnSpawnRadius>
      </li>
    </comps>
    <modExtensions>
      <li Class="RimMandrake.CreatureBehaviors.RM_VerminPressureExtension" MayRequire="mandrake.rm.creaturebehaviors">
        <populationSoftCap>40</populationSoftCap>
        <populationHardCap>100</populationHardCap>
        <populationGroupTag>RM_MiasmaScuttlers</populationGroupTag>
      </li>
    </modExtensions>
    <tradeTags>
      <li>AnimalExotic</li>
    </tradeTags>
  </ThingDef>

  <PawnKindDef ParentName="AnimalKindBase">
    <defName>RM_Karrimeth</defName>
    <label>karrimeth</label>
    <race>RM_Karrimeth</race>
    <combatPower>2</combatPower>
    <!-- INVENTED, same idiom RUT_Karrathil's swarm already uses: "only ever
         a moving mass" is delivered by a very high wildGroupSize on an
         ordinary PawnKindDef, not new C#. -->
    <wildGroupSize>40~90</wildGroupSize>
    <ecoSystemWeight>0.4</ecoSystemWeight>
    <lifeStages>
