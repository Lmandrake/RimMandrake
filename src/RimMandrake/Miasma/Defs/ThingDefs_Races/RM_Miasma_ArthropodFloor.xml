  <!-- ==================== RM_Karrimeth — the mass ==================== -->

  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Karrimeth</defName>
    <label>karrimeth</label>
    <description>Individually unremarkable — a thumb-sized humped shell, pale grey, salt-frosted. Karrimeth are never seen individually for long: they occur as a moving carpet thousands strong, flowing around obstacles as a single audibly clicking body. A lone karrimeth is a straggler, and stragglers do not last. A mass crossing a colony strips forage and fills traps rather than threatening anyone directly — the aftermath of a surge, made visible.</description>
    <statBases>
      <MoveSpeed>2.1</MoveSpeed>
      <Mass>0.15</Mass>
      <MarketValue>3</MarketValue>
      <Wildness>0.25</Wildness>
      <ComfyTemperatureMin>22</ComfyTemperatureMin>
      <ComfyTemperatureMax>62</ComfyTemperatureMax>
    </statBases>
    <tools>
      <li>
        <label>mandibles</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>1.5</power>
        <cooldownTime>1.8</cooldownTime>
        <linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <race>
      <body>BeetleLike</body>
      <predator>false</predator>
      <baseBodySize>0.1</baseBodySize>
      <baseHealthScale>0.3</baseHealthScale>
      <baseHungerRate>0.35</baseHungerRate>
      <foodType>OmnivoreRoughAnimal</foodType>
      <fleshType>Insectoid</fleshType>
      <bloodDef>Filth_BloodInsect</bloodDef>
      <bloodSmearDef>Filth_BloodSmear</bloodSmearDef>
      <meatColor>(160,160,155)</meatColor>
