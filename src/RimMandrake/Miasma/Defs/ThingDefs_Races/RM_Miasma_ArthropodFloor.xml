  <!-- ==================== RM_Karrolun — the harvest ==================== -->

  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Karrolun</defName>
    <label>karrolun</label>
    <description>A slow, long-legged scuttler the size of a spread hand — visibly the biggest of its kin, its shell a deep iridescent blue-green that fades to chalk when it dies. Faintly comic in its deliberateness, and the only one of the floor's four worth picking up by hand: the Miasma's ordinary meat, and the one thing that gives the arthropod harvest a real target instead of a chore spread across three other species.</description>
    <statBases>
      <MoveSpeed>1.5</MoveSpeed>
      <Mass>3.5</Mass>
      <MarketValue>22</MarketValue>
      <Wildness>0.2</Wildness>
      <ComfyTemperatureMin>16</ComfyTemperatureMin>
      <ComfyTemperatureMax>56</ComfyTemperatureMax>
      <ArmorRating_Sharp>0.15</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.05</ArmorRating_Blunt>
    </statBases>
    <tools>
      <li>
        <label>claw</label>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>4</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadClaw</linkedBodyPartsGroup>
        <chanceFactor>0.5</chanceFactor>
      </li>
      <li>
        <label>mandibles</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>3</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
      </li>
    </tools>
    <race>
      <body>BeetleLikeWithClaw</body>
      <predator>false</predator>
      <baseBodySize>0.35</baseBodySize>
      <baseHealthScale>0.6</baseHealthScale>
      <baseHungerRate>0.45</baseHungerRate>
      <foodType>OmnivoreRoughAnimal</foodType>
      <fleshType>Insectoid</fleshType>
      <bloodDef>Filth_BloodInsect</bloodDef>
      <bloodSmearDef>Filth_BloodSmear</bloodSmearDef>
      <meatColor>(140,150,145)</meatColor>
      <meatMarketValue>0.3</meatMarketValue>
      <herdAnimal>false</herdAnimal>
      <roamMtbDays>5</roamMtbDays>
      <trainability>None</trainability>
      <manhunterOnDamageChance>0.02</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0.02</manhunterOnTameFailChance>
      <lifeExpectancy>6</lifeExpectancy>
      <gestationPeriodDays>5</gestationPeriodDays>
      <litterSizeCurve>
        <points>
          <li>(0.5, 0)</li>
          <li>(1, 1)</li>
          <li>(2, 1)</li>
          <li>(2.5, 0)</li>
        </points>
      </litterSizeCurve>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.15</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.4</minAge>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
      <soundEating>Insectoid_Eat</soundEating>
    </race>
    <comps>
      <li Class="RimMandrake.CreatureBehaviors.RM_CompProperties_VerminBreeder" MayRequire="mandrake.rm.creaturebehaviors">
        <pawnSpawnIntervalDays>2~4</pawnSpawnIntervalDays>
        <pawnSpawnRadius>3</pawnSpawnRadius>
