      <MoveSpeed>4.00</MoveSpeed>
      <ComfyTemperatureMin>-10</ComfyTemperatureMin>
      <MarketValue>350</MarketValue>
      <FilthRate>4</FilthRate>
      <Wildness>0.8</Wildness>
    </statBases>
