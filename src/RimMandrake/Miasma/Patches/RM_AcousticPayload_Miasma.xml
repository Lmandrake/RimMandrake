<?xml version="1.0" encoding="utf-8"?>
<!--
  GRAVSHIP_ACOUSTIC_SCANNER_1: the acoustic-scanner payload for RM_Miasma.
  Owner decision by question card 2026-10-06: the payload goes on EVERY biome of ours.

  Pure XML, FindMod-guarded on "RimMandrake: Acoustic Scanner", so the extension class
  is only named while its assembly is active. Every def is a defName STRING resolved
  at pulse time (GetNamedSilentFail), so a target naming another mod's def just hears
  nothing when that mod is absent. Each target is drawn from this biome's own content;
  the biome's sitting may re-author it. The reading is always banded by the scanner.
-->
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>RimMandrake: Acoustic Scanner</li>
    </mods>
    <match Class="PatchOperationAddModExtension">
      <xpath>/Defs/BiomeDef[defName="RM_Miasma"]</xpath>
      <value>
        <li Class="RimMandrake.AcousticScanner.RM_AcousticPayloadExtension">
          <quietText>Brackish water and soft roots, deadened by the salt. Nothing in the channels is any bigger than it looks.</quietText>
          <targets>
            <li>
              <label>nursery shallows</label>
              <reading>Many small quick echoes in the brine shallows, and one larger, slower one keeping watch.</reading>
              <color>(1, 0.6, 0.45)</color>
              <weight>2</weight>
              <thingDefs>
                <li>RUT_CrecheMarker</li>
              </thingDefs>
            </li>
            <li>
              <label>young things in the channel mud</label>
              <reading>Small hard shells and soft bodies in the channel mud, a lot of them.</reading>
              <color>(0.9, 0.5, 0.4)</color>
              <pawnRaces>
                <li>RM_SiltLampreyJuv</li>
                <li>RM_RustNipperJuv</li>
                <li>RM_CrimsonOpeeJuv</li>
                <li>RM_ThornbackColoJuv</li>
                <li>RM_ShaleGorgerJuv</li>
                <li>RM_ReefbackJuv</li>
              </pawnRaces>
            </li>
            <li>
              <label>brined flotsam</label>
              <reading>Salt-crusted metal thrown up by a surge, hollow and ringing dull.</reading>
              <color>(0.8, 0.8, 0.85)</color>
              <thingDefs>
                <li>RM_MiasmaFlotsamFrame</li>
                <li>RM_MiasmaFlotsamTank</li>
              </thingDefs>
            </li>
            <li>
              <label>void under the roots</label>
              <reading>The echo falls into a hollow under the stilt roots.</reading>
              <color>(0.6, 0.6, 0.9)</color>
              <hiddenCaves>true</hiddenCaves>
              <cellSampleStride>4</cellSampleStride>
            </li>
          </targets>
        </li>
      </value>
    </match>
  </Operation>
</Patch>
