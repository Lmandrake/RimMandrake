<!--
  SHIPVERMIN_FREE_TIER_BEASTS_1 - ShipVermin's own franchise-free cast.

  Owner ruling (card, typed, 2026-10-07): "Make the free tier have its own beasts that get
  patched by the Star Wars bestiary when active. Same mechanics same mod otherwise."

  Four invented RM_ species, one per nest-roster slot. Each copies the stats, tools, body
  plan and life stages of the canon creature that fills the same slot when
  mandrake.rsw.swbestiary is active (SWBestiary's Patches/ShipVermin/RSW_ShipVermin_CanonCast.xml
  adds RM_ShipVerminCanonSwapExtension to the free PawnKindDef, and the nest then spawns the
  canon kind in that slot instead):

    slot            free (this file)   canon (SWBestiary)
    hull leech      RM_Skivvik         RSW_Mynock
    pest rodent     RM_Rattagh         RSW_Scavrat
    predator rodent RM_Gorrud          RSW_WompRat
    fuel mite       RM_Fethrik         RSW_Zhakka

  Departures from the canon defs, all forced by the tier line (no RSW_ def may be named here):
    - RSW_ leathers/meats/body/name generators/sounds swapped for the nearest vanilla ones
      (Leather_Light, auto-generated meat, QuadrupedAnimalWithPaws, Pawn_Boomrat_* sounds).
    - No wildBiomes: these arrive by wreck nest and breeding. The canon rodents' vanilla-biome
      wildBiomes belong to those canon species and are not ShipVermin's mechanics.
    - RM_Fethrik carries no leather (the canon mite's RSW_InsectChitin has no vanilla twin).

  ART: PLACEHOLDER ONLY. Every texPath below is a vanilla Core texture (Sparrow, Rat, Boomrat,
  Megascarab), tinted, so the free tier renders with nothing else loaded. Real art is owed per
  species - see the item file. No new PNG ships with this file.
-->
<Defs>

  <!-- ══ hull leech: RM_Skivvik (slot of RSW_Mynock) ══════════════════════════════ -->

  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Skivvik</defName>
    <label>skivvik</label>
    <description>A flat, rubbery hull-leech with a sucker-ring mouth and two thin wing-flaps that it uses more for steering than for flight. Skivviks drift through vacuum toward the warmth of a powered hull and cling there, feeding on insulation, lighting and the floor laid over a ship's frame. One is a nuisance you barely notice. They breed fast once a few take hold, and a real infestation will chew a ship's conduits and lights dead, room by room. They never need air, warmth or a roof.</description>
    <statBases>
      <MoveSpeed>3.2</MoveSpeed>
      <MarketValue>8</MarketValue>
      <Mass>0.03</Mass>
      <ComfyTemperatureMin>-150</ComfyTemperatureMin>
      <ComfyTemperatureMax>150</ComfyTemperatureMax>
      <FilthRate>1</FilthRate>
      <Wildness>0.9</Wildness>
      <VacuumResistance>1</VacuumResistance>
      <MaxFlightTime>30</MaxFlightTime>
      <FlightCooldown>10</FlightCooldown>
    </statBases>
    <uiIconScale>0.6</uiIconScale>
    <race>
      <thinkTreeMain>Animal</thinkTreeMain>
      <thinkTreeConstant>AnimalConstant</thinkTreeConstant>
      <trainability>None</trainability>
      <body>Bird</body>
      <herdAnimal>false</herdAnimal>
      <canBeVacuumBurnt>false</canBeVacuumBurnt>
      <canFlyInVacuum>true</canFlyInVacuum>
      <flightStartChanceOnJobStart>0.05</flightStartChanceOnJobStart>
      <flightSpeedFactor>2.5</flightSpeedFactor>
      <canFlyIntoMap>true</canFlyIntoMap>
      <baseBodySize>0.12</baseBodySize>
      <baseHealthScale>0.25</baseHealthScale>
      <baseHungerRate>0.2</baseHungerRate>
      <foodType>OmnivoreAnimal</foodType>
      <leatherDef>Leather_Plain</leatherDef>
      <roamMtbDays>2</roamMtbDays>
      <lifeExpectancy>4</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalBabyTiny</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.15</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.3</minAge>
          <soundWounded>Pawn_Rodent_Wounded</soundWounded>
          <soundDeath>Pawn_Rodent_Death</soundDeath>
          <soundCall>Pawn_Rodent_Call</soundCall>
          <soundAngry>Pawn_Rodent_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <tools>
      <li>
        <label>sucker mouth</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>3</power>
        <cooldownTime>1.6</cooldownTime>
        <linkedBodyPartsGroup>Beak</linkedBodyPartsGroup>
      </li>
    </tools>
    <!-- Mechanics: identical to the canon hull leech's (SWBestiary's RSW_ShipVermin_CanonCast.xml
         puts the same comp and extensions, with the same numbers, on RSW_Mynock). Soft cap 3 /
         hard cap 12 per map, breed every 1-2 days, drift to substructure, gnaw lights/conduits/
         laid floor. -->
    <comps>
      <li Class="RimMandrake.CreatureBehaviors.RM_CompProperties_VerminBreeder">
        <pawnSpawnIntervalDays>1~2</pawnSpawnIntervalDays>
        <pawnSpawnRadius>3</pawnSpawnRadius>
      </li>
    </comps>
    <modExtensions>
      <li Class="RimMandrake.CreatureBehaviors.RM_VerminPressureExtension">
        <populationSoftCap>3</populationSoftCap>
        <populationHardCap>12</populationHardCap>
        <populationGroupTag>ShipVermin</populationGroupTag>
      </li>
      <li Class="RimMandrake.CreatureBehaviors.RM_SeekTargetExtension">
        <seekSubstructure>true</seekSubstructure>
        <searchRadius>40</searchRadius>
        <seekChancePerCheck>0.05</seekChancePerCheck>
      </li>
      <li Class="RimMandrake.CreatureBehaviors.RM_GnawTargetExtension">
        <gnawBuildingDefNames>
          <li>PowerConduit</li>
        </gnawBuildingDefNames>
        <gnawCompTypeNames>
          <li>CompGlower</li>
        </gnawCompTypeNames>
        <gnawFloorTerrainDefNames>
          <li>MetalTile</li>
        </gnawFloorTerrainDefNames>
        <searchRadius>30</searchRadius>
        <biteDamage>6</biteDamage>
        <meannessDamageMultiplier>2</meannessDamageMultiplier>
        <nutritionPerBite>0.04</nutritionPerBite>
        <ticksBetweenBites>240</ticksBetweenBites>
        <seekChanceAtLowPressure>0.01</seekChanceAtLowPressure>
        <seekChanceAtHighPressure>0.2</seekChanceAtHighPressure>
      </li>
    </modExtensions>
    <useHitPoints>false</useHitPoints>
  </ThingDef>

