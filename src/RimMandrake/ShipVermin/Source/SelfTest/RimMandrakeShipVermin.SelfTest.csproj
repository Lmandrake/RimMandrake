<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ShipVermin offline fuzz (Approach B). Plain net8.0, zero RimWorld/Unity references: ../Kernel/RM_VerminKernel.cs is the PRODUCTION file the
    mod compiles, pulled in directly. A `using Verse;` landing in it breaks this build - that is the guard rail working.
    Run: python3 src/RimMandrake/Utils/selftest_shipvermin_fuzz.py [fuzz knobs]
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RimMandrakeShipVermin.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.ShipVermin.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Kernel\RM_VerminKernel.cs" />
    <Compile Include="ShipVerminFuzz.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
