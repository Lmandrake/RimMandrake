<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TERMINALBIOMES_RM_MOD_BUILD_1. Same recipe as
    src/RimMandrake/Greentide/Source/RM_Greentide.csproj — copy that header
    if this one goes stale.

    Build (the dotnet is WINDOWS-NATIVE and cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\Rimworld\src\RimMandrake\TerminalBiomes\Source\RM_TerminalBiomes.csproj -c Release

    Output lands in ../Assemblies/, which is where RimWorld looks.

    No Harmony. The kit classes the Scald's content names
    (RM_GenStep_PlacedSetPieces, CompProperties_ResourceCondenser,
    RM_GameCondition_WeatherPulse, RUT_IncidentWorker_WalkerSurfacing ...)
    live in mandrake.rm.environmentalhazards, reached via loadAfter. This
    assembly holds Mod + ModSettings, the settings-gate registration into
    that assembly's RM_MechanicGates, and two thin vanilla subclasses
    (RM_TerminalBiomesScaldKit.cs) for the pieces whose engine class was
    vanilla.

    References RimMandrake.EnvironmentalHazards.dll (Private=false: never
    copied here). That mod is loadAfter, not a hard dependency, so every
    touch of its types sits behind a ModsConfig.IsActive check in a
    NoInlining method — see RM_TerminalBiomesMod's constructor. Build
    EnvironmentalHazards first.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrake.TerminalBiomes</AssemblyName>
    <RootNamespace>RimMandrake.TerminalBiomes</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="RM_TerminalBiomesMod.cs" />
    <Compile Include="RM_TerminalBiomesScaldKit.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RimMandrake.EnvironmentalHazards">
      <HintPath>..\..\EnvironmentalHazards\Assemblies\RimMandrake.EnvironmentalHazards.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
