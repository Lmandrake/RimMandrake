<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TERMINALBIOMES_RM_MOD_BUILD_1. Same recipe as
    src/RimMandrake/Greentide/Source/RM_Greentide.csproj — copy that header
    if this one goes stale.

    Build (the dotnet is WINDOWS-NATIVE and cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\RimMandrake\src\RimMandrake\TerminalBiomes\Source\RM_TerminalBiomes.csproj -c Release

    Output lands in ../Assemblies/, which is where RimWorld looks.

    TWILIGHT_PANE_STRIKE_1, 2026-09-27: this assembly now references
    0Harmony.dll for exactly ONE patch (RM_Patch_GravEngineLaunchGate.cs,
    Building_GravEngine.CanLaunch — D8's never-a-stranding launch gate; see
    that file's own header for why a Harmony postfix is the correct choke
    point). The line that used to read "No Harmony" here is corrected, not
    superseded-in-place, per this repo's own "inaccurate material is
    deleted" rule. Every OTHER class in this assembly is still plain
    XML-wired. The kit classes the Scald's content names
    (RM_GenStep_PlacedSetPieces, CompProperties_ResourceCondenser,
    RM_GameCondition_WeatherPulse, RUT_IncidentWorker_WalkerSurfacing ...)
    live in mandrake.rm.environmentalhazards, reached via loadAfter. This
    assembly holds Mod + ModSettings, the settings-gate registration into
    that assembly's RM_MechanicGates, two thin vanilla subclasses
    (RM_TerminalBiomesScaldKit.cs) for the pieces whose engine class was
    vanilla, and the Twilight Sea's pane-strike kit (RM_VeilFallDefOf.cs,
    RM_IncidentWorker_PaneStrike.cs, RM_MapComponent_VeilFall.cs,
    RM_Patch_GravEngineLaunchGate.cs).

    References RimMandrake.EnvironmentalHazards.dll (Private=false: never
    copied here). That mod is loadAfter, not a hard dependency, so every
    touch of its types sits behind a ModsConfig.IsActive check in a
    NoInlining method — see RM_TerminalBiomesMod's constructor. Build
    EnvironmentalHazards first.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrake.TerminalBiomes</AssemblyName>
    <RootNamespace>RimMandrake.TerminalBiomes</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\_Shared\HarmonyResilience\PatchApplier.cs" Link="Shared\PatchApplier.cs" />
    <Compile Include="RM_TerminalBiomesMod.cs" />
    <Compile Include="RM_TerminalBiomesScaldKit.cs" />
    <!-- CHILL_CRYOPONICS_GROWER_1 / CHILL_FLOOR_GROWING_BED_1 -->
    <Compile Include="RM_Building_CryoGrower.cs" />
    <Compile Include="RM_PlaceWorker_ChillFloorOnly.cs" />
    <Compile Include="RM_Patch_ChillGrowers.cs" />
    <!-- TWILIGHT_DANGER_LIGHTWEB_1 -->
    <Compile Include="RM_TerminalBiomesJobDefOf.cs" />
    <Compile Include="RM_SeekGlowExtension.cs" />
    <Compile Include="RM_JobGiver_SeekGlow.cs" />
    <Compile Include="RM_JobDriver_FeedOnGlow.cs" />
    <Compile Include="RM_Comp_VaeuliskLure.cs" />
    <Compile Include="RM_Comp_DropLureOrganOnDeath.cs" />
    <Compile Include="RM_Comp_WaxProcession.cs" />
    <Compile Include="RM_GenStep_ScatterVauliskLure.cs" />
    <Compile Include="RM_IncidentWorker_SuulkArrival.cs" />
    <!-- TWILIGHT_PANE_STRIKE_1 -->
    <Compile Include="RM_VeilFallDefOf.cs" />
    <Compile Include="RM_IncidentWorker_PaneStrike.cs" />
    <Compile Include="RM_MapComponent_VeilFall.cs" />
    <Compile Include="RM_Patch_GravEngineLaunchGate.cs" />
    <!-- GREYSEA_SALTDOME_SCATTER_OOB_1 -->
    <Compile Include="RM_Patch_ScatterThingsClusterCenterGuard.cs" />
    <!-- TWILIGHT_LIGHT_ECONOMY_1 -->
    <Compile Include="RM_MapComponent_WellLedger.cs" />
    <Compile Include="RM_CompGlowerMobile.cs" />
    <Compile Include="RM_CompCageCropSnapshot.cs" />
    <Compile Include="RM_Building_SunSphere.cs" />
    <!-- TWILIGHT_CHANNEL_CURRENT_1 -->
    <Compile Include="RM_MapComponent_ChannelCurrent.cs" />
    <Compile Include="RM_TerminalBiomesDefOf.cs" />
    <Compile Include="RM_HediffComp_Sunk.cs" />
    <Compile Include="RM_GameCondition_Undersurge.cs" />
    <Compile Include="RM_Apparel_FloatHarness.cs" />
    <Compile Include="RM_Thing_CargoFloat.cs" />
    <Compile Include="RM_GenStep_TwilightChannels.cs" />
    <!-- GREYSEA_HULL_CRUST_BUILD_1 -->
    <Compile Include="RM_GreyHullCrust.cs" />
    <!-- GREYSEA_LAMP_RESPONSE_BUILD_1 -->
    <Compile Include="RM_GreyLampResponse.cs" />
    <!-- Verse-free kernels (also compiled by SelfTest/RimMandrakeTerminalBiomes.SelfTest.csproj). -->
    <Compile Include="Kernel\RM_WellKernel.cs" />
    <Compile Include="Kernel\RM_SunSphereKernel.cs" />
    <Compile Include="Kernel\RM_ChannelKernel.cs" />
    <Compile Include="Kernel\RM_CrustKernel.cs" />
    <Compile Include="Kernel\RM_LampWatchKernel.cs" />
    <Compile Include="Kernel\RM_TerminalMiscKernel.cs" />
    <!-- LIGHT_LEDGER_ONE_1: the shared light ledger, compiled into this assembly (design/RimMandrake/light_ledger_design.md) -->
    <Compile Include="..\..\_Shared\LightLedger\LightLedger.cs" Link="Shared\LightLedger.cs" />
    <Compile Include="..\..\_Shared\LightLedger\LightLedgerKernel.cs" Link="Shared\LightLedgerKernel.cs" />
