<Defs>

  <TerrainDef ParentName="WaterDeepBase">
    <defName>RM_TheChillDeep</defName>
    <label>liquid propane</label>
    <description>A black mirror of liquid fuel, cold enough to kill and still enough to read the sky in. Nothing drinks it and nothing should try to cross it.</description>
    <renderPrecedence>399</renderPrecedence>
    <texturePath>Terrain/Surfaces/WaterDeepRamp</texturePath>
    <pollutedTexturePath>Terrain/Surfaces/WaterDeepRampPolluted</pollutedTexturePath>
    <waterBodyType>None</waterBodyType>
    <canFreeze>false</canFreeze>
    <avoidWander>true</avoidWander>
    <!-- SEA_FLOOR_SINGLE_BAND_1, 2026-09-30: RM_TheChillBed added.
         RM_TheChillFlora.xml's own header names this tag as the deep-floor
         half of its wildTerrainTags convention ("RM_TheChillBed = deep
         floor, RM_TheChillShelf = shallow floor") and six of its ten
         plants carry it, but until now the tag existed only on FlowWorks'
         RM_PropaneDeep (RM_Propane.xml, CHILL_FLORA_BUILD_1's manual-patch
         comment) — a shore-edge terrain, not this def, which is what
         RM_TheChill.xml's terrainsByFertility split (this same commit)
         actually selects for the dive floor's deep cells. -->
    <tags>
      <li>Water</li>
      <li>RM_TheChillBed</li>
    </tags>
  </TerrainDef>

  <TerrainDef ParentName="WaterShallowBase">
    <defName>RM_SolidPropane</defName>
    <label>frozen propane crust</label>
    <description>Propane frozen solid at the lake's cold margin — a standable crust over the liquid centre, cracked in places, crunching underfoot.</description>
    <renderPrecedence>398</renderPrecedence>
    <texturePath>Terrain/Surfaces/WaterShallowRamp</texturePath>
    <pollutedTexturePath>Terrain/Surfaces/WaterShallowRampPolluted</pollutedTexturePath>
    <waterBodyType>None</waterBodyType>
    <canFreeze>false</canFreeze>
    <pathCost>12</pathCost>
    <!-- SEA_FLOOR_SINGLE_BAND_1, 2026-09-30: RM_TheChillShelf added — the
         shallow-floor half of the same tag pair, see RM_TheChillDeep's own
         comment above. Four of the ten RM_TheChillFlora.xml plants
         (Slackwax, Ghostpane, Keelgrass, Skyharp) need it. -->
    <tags>
      <li>Water</li>
      <li>RM_TheChillShelf</li>
    </tags>
  </TerrainDef>

</Defs>
