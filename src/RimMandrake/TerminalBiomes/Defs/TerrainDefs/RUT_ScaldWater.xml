  <TerrainDef ParentName="WaterShallowBase">
    <defName>RUT_ScaldWaterShallow</defName>
    <label>shallow boiling water</label>
    <description>Shallow water at the boil. Steam stands off it even in the flat, unmoving light of the Anvil, and the mud at its edge is baked hard.</description>
    <renderPrecedence>394</renderPrecedence>
    <texturePath>Terrain/Surfaces/WaterShallowRamp</texturePath>
    <pollutedTexturePath>Terrain/Surfaces/WaterShallowRampPolluted</pollutedTexturePath>
    <waterDepthShader>Map/WaterDepth</waterDepthShader>
    <driesTo>Gravel</driesTo>
    <glowColor>(2,154,229)</glowColor>
    <glowRadius>2</glowRadius>
    <burnDamage>3</burnDamage>
    <burnIntervalTicks>300</burnIntervalTicks>
    <!-- SCALD_WATER_AGITATION_FLECKS_1, 2026-09-26 — see
         RUT_ScaldWaterDeep for the rate derivation. Shallow breathes less
         hard than deep: same puff, smaller and less often. -->
    <fleckData>
      <fleck>AirPuff</fleck>
      <velocitySpeedRange>0.15~0.45</velocitySpeedRange>
      <velocityAngleRange>-30~30</velocityAngleRange>
      <rotationSpeedRange>-20~20</rotationSpeedRange>
      <solidTicksRange>1~3</solidTicksRange>
      <scaleRange>1.5~3</scaleRange>
    </fleckData>
    <throwFleckChance>0.45</throwFleckChance>
    <traversedThought>HotSpring</traversedThought>
    <avoidWander>true</avoidWander>
    <tags>
      <li>Water</li>
      <li>RUT_ScaldShallow</li>
      <li>RM_WaterAgitationLight</li>
    </tags>
  </TerrainDef>

  <TerrainDef ParentName="WaterShallowBase">
