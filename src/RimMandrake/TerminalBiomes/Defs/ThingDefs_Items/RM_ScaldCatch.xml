<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_ScaldCatch.xml                      TerminalBiomes — authored 2026-09-24
  ==========================================================================
  terminal_seas_cast_proposal_2026-09-25.md, the Scald gap-check §2: shulla
  joins the existing eight-species freshwater catch (RM_EeshCatch…
  RM_EkkelCatch, RM_RareScaldCatches) as ONE ADDITIONAL row in
  RM_TheScald.xml's own freshwater_Common block.

  Catch def (shulla's own floor-resident form is RM_Shulla in
  RM_ScaldFauna.xml). Register stats follow RUT_ScaldFish.xml's
  own envelope; freshwater per that file's own measured note (the Scald's
  fishing water is freshwater, not saltwater).
-->
<Defs>

  <!-- shulla — the silver shoal fish-analog, common. -->
  <ThingDef ParentName="FishBase" MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>RM_ShullaCatch</defName>
    <label>shulla</label>
    <description>A hot-white sliver netted from between the Scald's vent plumes, a heat-shimmer still playing off its edge as it cools in the pail. Always comes up in company.</description>
    <graphicData>
      <!-- SCALD_ART_UPGRADE_WAVE_1, 2026-09-26: owned Graphic_StackCount
           folder, three variants small/medium/large (FishBase's own
           graphicClass; texPath is a FOLDER, and
           Graphic_StackCount.SubGraphicForStackCount takes [0] at
           stackCount 1, [2] at the stack limit and [1] between — which is
           why the files must sort small→large by name).
           _b/_c are scald2_shullacatch_b/_c; _a is scald3_shullacatch_a, a
           refile, because the original scald2_shullacatch_a finished with
           no PNG on disk and was the one missing render in the wave. -->
      <texPath>Things/Item/Resource/RM_ShullaCatch</texPath>
    </graphicData>
    <statBases>
      <Nutrition>0.1</Nutrition>
      <MarketValue>4</MarketValue>
      <Mass>0.25</Mass>
    </statBases>
    <ingestible>
      <preferability>RawTasty</preferability>
      <tasteThought></tasteThought>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>1</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
  </ThingDef>

</Defs>
