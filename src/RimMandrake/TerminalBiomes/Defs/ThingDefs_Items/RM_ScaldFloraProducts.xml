<!--
  RM_ScaldFloraProducts.xml           TerminalBiomes · SCALD_UNDERWATER_FLORA_1
  The one new item the Scald understorey owes: RM_KettlewickSalt, the crusted
  mineral collar of the kettlewick. Ruled 2026-09-27 (decision by question
  card): a tiny NEW mineral-salt keepsake, never drinkable (Ban 1), no mechanic.
  Pilgrim-keepsake register beside the karrash shell and ekkel knot.
  PLACEHOLDER ART: Things/Mote/BeamGlow tinted off-white (the borrowed icon the
  Twilight items use); real art job filed (scflora_RM_KettlewickSalt_v1).
-->
<Defs>
  <ThingDef ParentName="ResourceBase">
    <defName>RM_KettlewickSalt</defName>
    <label>kettlewick salt</label>
    <description>A pinch of crusted white-grey mineral scraped from the collar of a kettlewick, left behind by every clean drop the little distillery ever sweated. Pilgrims of both faiths keep a grain in a pocket and read opposite things in it. Not drinkable, and not meant to be.</description>
    <graphicData>
      <texPath>Things/Mote/BeamGlow</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.5</drawSize>
      <color>(225,222,212,255)</color>
    </graphicData>
    <soundInteract>Standard_Drop</soundInteract>
    <soundDrop>Standard_Drop</soundDrop>
    <stackLimit>25</stackLimit>
    <statBases>
      <MaxHitPoints>40</MaxHitPoints>
      <MarketValue>4</MarketValue>
      <Mass>0.05</Mass>
      <Flammability>0</Flammability>
      <Beauty>1</Beauty>
    </statBases>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
  </ThingDef>
</Defs>
