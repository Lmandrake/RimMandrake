<Defs>

  <ThingDef ParentName="ResourceBase">
    <defName>RM_RainbowPigment</defName>
    <label>rainbow pigment</label>
    <description>A jar of thick, vividly banded dye rendered down from welcome-blanket mats. Each batch carries whatever hue the water was when the mat that made it grew — no two jars ever quite match, and dyers prize that as much as the color itself.</description>
    <graphicData>
      <texPath>Things/Item/Resource/RM_RainbowPigment</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>3.0</MarketValue>
      <MaxHitPoints>50</MaxHitPoints>
      <Mass>0.05</Mass>
      <Flammability>0.5</Flammability>
      <DeteriorationRate>2.0</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
  </ThingDef>

</Defs>
