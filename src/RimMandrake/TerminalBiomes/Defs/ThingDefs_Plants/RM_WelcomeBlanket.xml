<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  RM_WelcomeBlanket.xml                  TerminalBiomes · moved 2026-09-24
  ============================================================================
  SCALD_FLOOR_PASS_1: moved from src/RimUtinni/UtinniPatches/Defs/ThingDefs_Plants/
  RUT_WelcomeBlanket.xml (defName RUT_WelcomeBlanket -> RM_WelcomeBlanket) — this
  is invented, franchise-free content (rainbow thermophile bacterial mats), not
  Star Wars IP, so it belongs natively in the RM_ tier rather than gated behind
  `MayRequire="mandrake.rut.patches"`. Without this move a franchise-free install
  of mandrake.rm.terminalbiomes got ZERO Scald flora. RM_TheScald.xml's wildPlants
  row updated to the bare native defName in the same pass. The frozen world-
  carrying twin (`src/RimUtinni/UtinniPatches/Defs/BiomeDefs/RUT_TheScald.xml`,
  "do not edit here") still names the old `RUT_WelcomeBlanket` defName in its
  byte-identical body and will not resolve it post-move — same fallout the
  RM_TheRot split already accepted for `RUT_TheRot.xml`'s now-dangling
  `mandrake.rut.rotsporekit`-gated rows; both wait on the same terminal repaint.

  Original authorship, preserved from the pre-move file (COMMISSION_LEDGER_CLEANUP_1,
  the_scald sheet commission, `ledger:the_scald:welcome-blanket-thermophile-
  mats-rainbow-banded-by-temperatu`, the_scald.md §4 "the welcome blankets" and §7
  "rainbow pigment"): "rainbow sheets of thermophile bacteria and algae coating
  everything in the depths, oddly fuzzy, banded by temperature... the mats at the
  margins are a pigment source — rainbow dyes from the most ancient life there
  is." Restricted to wild spawn on the `RUT_ScaldMarginMat` terrain tag (a string
  tag test, not a defName cross-reference, so it works regardless of which mod's
  copy of `RUT_ScaldMargin` is active) rather than the general `Water` tag every
  boil terrain also carries — spawning it on open boil water would put a plant on
  the biome's own "nothing swims/grows the roiling surface" ban.

  maxGrowthTemperature 90 (engine default 58, `PlantProperties.cs:93`): the_scald's
  own measured air range is +58..+70 degC, AT or ABOVE the unedited default
  ceiling, so this plant needs the override to grow in its own biome's ambient
  heat at all.

  completelyIgnoreFertility + fertilitySensitivity 0: `RUT_ScaldMargin` is
  `ParentName="WaterShallowBase"`, which sets fertility 0.

  No sowTags: wild-forage bacterial film, not a player-sown crop.

  Placeholder-only art (`Things/Plant/Ambrosia`, Core's own vanilla texPath) —
  real art still owed, unchanged by this move.
  ============================================================================
-->
<Defs>

  <ThingDef ParentName="PlantBaseNonEdible">
    <defName>RM_WelcomeBlanket</defName>
    <label>welcome blanket</label>
    <description>A fuzzy, rainbow-banded sheet of thermophile bacteria and algae, coating the Scald's margins in bands that read the water's own temperature back at you. It is the oldest life on the whole planet, wearing the loudest colors — the shore's one truth that never lies about the heat.</description>
    <graphicData>
      <texPath>Things/Plant/Ambrosia</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <drawSize>0.85</drawSize>
    </graphicData>
    <selectable>true</selectable>
    <pathCost>8</pathCost>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <plant>
      <completelyIgnoreFertility>true</completelyIgnoreFertility>
      <fertilitySensitivity>0</fertilitySensitivity>
      <wildTerrainTags>
        <li>RUT_ScaldMarginMat</li>
      </wildTerrainTags>
      <minGrowthTemperature>0</minGrowthTemperature>
      <maxGrowthTemperature>90</maxGrowthTemperature>
      <harvestTag>Standard</harvestTag>
      <harvestedThingDef>RM_RainbowPigment</harvestedThingDef>
      <harvestYield>4</harvestYield>
      <harvestWork>120</harvestWork>
      <growDays>3</growDays>
      <visualSizeRange>0.5~0.9</visualSizeRange>
      <topWindExposure>0</topWindExposure>
      <wildOrder>2</wildOrder>
      <purpose>Misc</purpose>
    </plant>
  </ThingDef>

</Defs>
