<Defs>

  <ThingDef ParentName="RM_GreyCrystalFloraBase">
    <defName>RM_SaltBladeGrey</defName>
    <label>salt-rimed blade</label>
    <description>A single flat blade of tissue standing alone on the floor, dark green-black inside and rimed white outside where it has spent a lifetime pushing salt out through its own skin. There is only ever one in sight at a time — the next stands so far off it is lost in the murk — and the crust flakes and rebuilds without ever quite matching the blade beneath it. Centuries old, and never crowded by another of its own kind.</description>
    <statBases>
      <MaxHitPoints>220</MaxHitPoints>
      <Beauty>8</Beauty>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/RM_GreySea/RM_SaltBladeGrey</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <colorTwo>(40,48,44)</colorTwo>
      <drawSize>(1.4,1.4)</drawSize>
    </graphicData>
    <plant>
      <growDays>30</growDays>
      <harvestWork>360</harvestWork>
      <maxMeshCount>1</maxMeshCount>
      <visualSizeRange>1.1~1.8</visualSizeRange>
      <!-- "Hundreds of metres apart": the sparsest thing this floor grows. -->
      <wildClusterRadius>14</wildClusterRadius>
      <wildClusterWeight>1</wildClusterWeight>
      <wildOrder>2</wildOrder>
    </plant>
  </ThingDef>

</Defs>
