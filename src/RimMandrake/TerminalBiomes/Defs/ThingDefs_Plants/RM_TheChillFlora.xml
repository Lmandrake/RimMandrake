<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  RM_TheChillFlora.xml                    CHILL_FLORA_BUILD_1
  ============================================================================
  The Chill's ten sea-floor flora, per
  design/Jawa/worldbuilding/biomes/the_propane_lake_flora_pass_2026-09-27.md
  (the REVISED doc, post-2026-09-27-sitting rulings — built from that file,
  not from the item's own ruling-summary bullets). Slackwax, Ghostpane,
  Eldspar, Tarspool, Keelgrass, Stonewater, Fuselight, Skyharp, Stillbloom,
  Pitchpearl.

  Every plant here is `completelyIgnoreFertility` + `wildTerrainTags`
  (RM_TheChillBed = deep floor, RM_TheChillShelf = shallow floor), the same
  water-flora shape the doc names (RM_Crowncarpet/Scald convention) — fertility
  on a liquid-propane cell is not a number the engine will read.

  🔴 TEMPERATURE BAND, not a per-plant guess: the Chill seabed pocket map's
  ambient is -110 C (RM_SeaDiveGenerators.xml's pocketMapProperties.temperature,
  read live via RM_ChillFireGate.ChillSeabedAmbientC) and
  RM_MapComponent_ChillBoilShroud already treats -20 C as "genuinely warmed"
  (its own HullWarmThresholdC). Every plant below reuses that SAME -20 C
  ceiling as maxGrowthTemperature (minGrowthTemperature -273, i.e. no cold
  floor) — one number, already established by the sibling item, instead of a
  second invented threshold that could drift from it. A plant standing in
  undisturbed -110 C ambient is comfortably inside that range; a cell warmed
  past a ship's hull or a working pawn's own heat (ChillBoilShroud's grade-1/
  grade-2 cells) kills it back, matching "nothing survives the crossing
  dayside" and the fiction's own "boils bare" language for anything that
  strays into real warmth.

  RM_ChillStillbloom is the ruled exception (Q6, "warm bloom, both edges")
  — see its own def comment.

  No new GenStep: per the doc's own "no GenStep route needed" section, the
  whole roster carries by `wildPlants` alone (RM_TheChill.xml, this pass).

  Art: all ten already had SPECULATIVE-batch, artpipe-validated single
  sprites sitting in infrastructure/artpipe/_artsrc/chill_plant_<name>/ before
  this build ran (art-leads-defs ruling, 2026-09-27) — copied into this mod's
  own Textures/Things/Plant/RM_<Name>/ this pass, texPaths below point at the
  real files, no placeholders. drawSize values are the exact numbers already
  recorded on each art job's own spec (matches the doc's art-direction table).
  ============================================================================
-->
<Defs>

  <!-- 1. RM_Slackwax — wax kelp, shallow floor. Phase inversion: alive as a
       liquid-phase wax, its corpse a building material shaped by its life.
       Primary harvest is the WoodLog-register timber (harvestTag "Wood", the
       biome's only timber, furniture-grade — see RM_SlackwaxTimber). The
       "offcuts render as hydrocarbon flesh" is a SEPARATE bench recipe on
       that timber (RM_TheChillFuelChain.xml), not a second harvestedThingDef
       — vanilla plants carry exactly one. -->
  <ThingDef ParentName="PlantBaseNonEdible">
    <defName>RM_Slackwax</defName>
    <label>slackwax</label>
    <description>A kelp whose flesh is paraffin — rock on any dayside shelf, but down here, part-dissolved in the cold fuel, as supple as anything that ever waved in a sea. Slackwax stands in slow ribbons off the shallow floor, thickening and thinning with every current that ever crossed it. Hauled into air it does not die so much as set: rigid in seconds, stone-hard in a minute, holding whatever curve it drowned in. The scrapers' shacks along the crust are furnished with it — chairs, hafts, window-lattices, all of it furniture that was briefly an organism, and all of it burning like a torch near flame.</description>
    <graphicData>
      <texPath>Things/Plant/RM_Slackwax/RM_Slackwax</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.35</drawSize>
    </graphicData>
    <selectable>true</selectable>
    <pathCost>8</pathCost>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Flammability>1.0</Flammability>
    </statBases>
    <plant>
      <completelyIgnoreFertility>true</completelyIgnoreFertility>
      <fertilitySensitivity>0</fertilitySensitivity>
      <wildTerrainTags>
        <li>RM_TheChillShelf</li>
      </wildTerrainTags>
      <minGrowthTemperature>-273</minGrowthTemperature>
      <maxGrowthTemperature>-20</maxGrowthTemperature>
      <!-- "No sun has ever reached this floor and none ever will" (doc,
           Skyharp's own description) — growMinGlow/growOptimalGlow 0,
           matching RM_GreyCrystalFloraBase's own established idiom for
           this campaign's other lightless sea floor ("blind murk",
           RM_GreySeaUnderstorey.xml). PlantBaseNonEdible's inherited
           default (0.51/1.0, i.e. "needs real daylight") would otherwise
           leave this whole roster unable to regrow after harvest or death
           on a map with no sun and only occasional aurora/Fuselight light —
           the same class of silent dead-content bug as the unset
           plantDensity/animalDensity traps this file's own header warns
           about. -->
      <growMinGlow>0</growMinGlow>
      <growOptimalGlow>0</growOptimalGlow>
      <harvestTag>Wood</harvestTag>
      <harvestedThingDef>RM_SlackwaxTimber</harvestedThingDef>
      <harvestYield>8</harvestYield>
      <harvestWork>200</harvestWork>
      <growDays>10</growDays>
      <visualSizeRange>0.7~1.1</visualSizeRange>
      <topWindExposure>0</topWindExposure>
      <wildOrder>2</wildOrder>
      <purpose>Misc</purpose>
    </plant>
  </ThingDef>

  <!-- 2. RM_Ghostpane — frozen-gas membrane, shallow floor / crust edge.
       Sublimation: it can vanish but it cannot wilt. Structurally
       unharvestable (harvestYield unset -> 0 -> PlantProperties.Harvestable
       false) — "anything warm enough to hold it is warm enough to erase
       it," per the doc.

       CHILL_FLOOR_LIGHT_1, 2026-09-28: CompProperties_Glower added —
       this item's own text names Ghostpane (alongside Fuselight, which
       already shipped one under CHILL_FLORA_BUILD_1) as the bottom's
       "bioluminescent constants," and it had none. A pale violet-white ice
       glow, dimmer and cooler than Fuselight's peroxide-lamp blue
       (glowRadius 1.5 vs Fuselight's 2 — a passive frozen membrane reads
       quieter than a hoarded-fire stalk), on the SAME violet-teal palette
       this item's other layer (the drowned aurora) uses, never a generic
       white/blue. -->
  <ThingDef ParentName="PlantBaseNonEdible">
    <defName>RM_Ghostpane</defName>
    <label>ghostpane</label>
    <description>A colony that builds in a material no dayside chemistry can keep: panes of frozen gas laid down molecule by molecule into sheets a hand wide and a hair thick, joined at angles like a shattered window reassembled by something that never saw the original. Warmed even slightly the panes do not melt; they sublime, un-existing edge-inward with a hiss and a shiver of fumes. The hoolen lick the crust-edge panes for the frost that condenses on them, and the panes grow back by morning.</description>
    <graphicData>
      <texPath>Things/Plant/RM_Ghostpane/RM_Ghostpane</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.9</drawSize>
    </graphicData>
    <selectable>true</selectable>
    <pathCost>4</pathCost>
    <statBases>
      <MaxHitPoints>20</MaxHitPoints>
      <Flammability>0</Flammability>
      <Beauty>2</Beauty>
    </statBases>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>1.5</glowRadius>
        <glowColor>(170,150,235,0)</glowColor>
      </li>
    </comps>
    <plant>
      <completelyIgnoreFertility>true</completelyIgnoreFertility>
      <fertilitySensitivity>0</fertilitySensitivity>
      <wildTerrainTags>
        <li>RM_TheChillShelf</li>
      </wildTerrainTags>
      <minGrowthTemperature>-273</minGrowthTemperature>
      <maxGrowthTemperature>-20</maxGrowthTemperature>
      <!-- "No sun has ever reached this floor and none ever will" (doc,
           Skyharp's own description) — growMinGlow/growOptimalGlow 0,
           matching RM_GreyCrystalFloraBase's own established idiom for
           this campaign's other lightless sea floor ("blind murk",
           RM_GreySeaUnderstorey.xml). PlantBaseNonEdible's inherited
           default (0.51/1.0, i.e. "needs real daylight") would otherwise
           leave this whole roster unable to regrow after harvest or death
           on a map with no sun and only occasional aurora/Fuselight light —
           the same class of silent dead-content bug as the unset
           plantDensity/animalDensity traps this file's own header warns
           about. -->
      <growMinGlow>0</growMinGlow>
      <growOptimalGlow>0</growOptimalGlow>
      <harvestFailable>false</harvestFailable>
      <growDays>3</growDays>
      <visualSizeRange>0.6~1.0</visualSizeRange>
      <topWindExposure>0</topWindExposure>
      <wildOrder>2</wildOrder>
      <purpose>Misc</purpose>
    </plant>
  </ThingDef>

