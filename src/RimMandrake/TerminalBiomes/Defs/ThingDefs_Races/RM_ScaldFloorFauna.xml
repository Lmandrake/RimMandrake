      <MoveSpeed>4.8</MoveSpeed>
      <MarketValue>4</MarketValue>
      <ComfyTemperatureMin>15</ComfyTemperatureMin>
      <ComfyTemperatureMax>95</ComfyTemperatureMax>
      <Wildness>0.7</Wildness>
    </statBases>
    <tools>
      <li>
        <label>nip</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>2</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
      </li>
    </tools>
    <race>
      <herdAnimal>true</herdAnimal>
      <body>Snake</body>
      <baseBodySize>0.05</baseBodySize>
      <baseHealthScale>0.18</baseHealthScale>
      <baseHungerRate>0.3</baseHungerRate>
      <foodType>OmnivoreAnimal</foodType>
      <predator>false</predator>
      <trainability>None</trainability>
      <manhunterOnDamageChance>0</manhunterOnDamageChance>
      <lifeExpectancy>2</lifeExpectancy>
      <waterSeeker>true</waterSeeker>
      <waterCellCost>1</waterCellCost>
      <lifeStageAges>
