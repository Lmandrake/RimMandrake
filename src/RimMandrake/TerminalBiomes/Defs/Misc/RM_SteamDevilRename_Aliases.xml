<?xml version="1.0" encoding="utf-8"?>
<!--
  GREENTIDE_BASE_PORT_BUILD_1: the steam devil defs in this free mod carried campaign RUT_ names and were
  renamed RM_. A save holding a live RUT_SteamDevil vortex loads it as RM_SteamDevil through
  RM_DefAliasDef (EnvironmentalHazards, RM_DefAliases.cs).
-->
<Defs>
  <RimMandrake.EnvironmentalHazards.RM_DefAliasDef>
    <defName>RM_SteamDevilRenameAliases</defName>
    <aliases>
      <li><from>RUT_SteamDevil</from><to>RM_SteamDevil</to></li>
      <li><from>RUT_SteamDevilAppears</from><to>RM_SteamDevilAppears</to></li>
    </aliases>
  </RimMandrake.EnvironmentalHazards.RM_DefAliasDef>
</Defs>
