<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  RUT_SteamDevilAppears.xml              UtinniPatches · GREENTIDE_MECHANICS_2 M3
  ============================================================================
  greentide_kit_spec.md M3: "Spawned by an IncidentDef weighted into the
  biome and, rarely, by the Roil condition itself." Only this plain
  IncidentDef route ships this pass — see RUT_IncidentWorker_SteamDevil's
  own header for why the Roil-condition rare-spawn hook is owed, not wired.

  workerClass -> RUT_IncidentWorker_SteamDevil (new this pass,
  src/RimMandrake/EnvironmentalHazards/Source/) hardcodes the RM_Greentide
  biome defName in CanFireNowSub, same posture as RUT_IncidentWorker_
  ContagionProbe's own hardcoded RUT_TheForge check — this is Greentide
  content, not a shared mechanism.

  baseChance/minRefireDays: INVENTED, same "MTB-ish ~once per N days" idiom
  RUT_ContagionProbe.xml's own header explains (minRefireDays is the actual
  refire floor; baseChance is the storyteller weight). ~1 per 5 days —
  "rare, visible from far off" per the spec's own player-experience line,
  slightly more frequent than Contagion Probe's own 8-day figure since the
  spec calls this "the biome's signature event."
  ============================================================================
-->
<Defs>

  <IncidentDef MayRequire="mandrake.rm.environmentalhazards">
    <defName>RUT_SteamDevilAppears</defName>
    <label>steam devil appears</label>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <category>Misc</category>
    <workerClass>RimMandrake.EnvironmentalHazards.RUT_IncidentWorker_SteamDevil</workerClass>
    <baseChance>2</baseChance>
    <minRefireDays>5</minRefireDays>
  </IncidentDef>

</Defs>
