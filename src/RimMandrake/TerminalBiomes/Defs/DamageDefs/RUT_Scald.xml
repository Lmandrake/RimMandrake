<?xml version="1.0" encoding="utf-8"?>
<!--
  RUT_Scald.xml                          TerminalBiomes - FORGE_MECHANICS_1 F1

  The scald: a wound from live steam and boiling water, dealt by the steam
  devil's vortex and the Forge's boiling-rain pulse.

  armorCategory Heat (SCALD_FOLD_INTO_HEAT_1, decision taken by question
  card 2026-10-08): one kind of heat planet-wide, so the same heat armor
  that stops fire stops steam. A steam burn is an injury, so it reads
  ArmorRating_Heat, never Insulation_Heat.

  Not Flame-class (no ParentName="Flame", no DamageWorker_Flame): scald
  never ignites anything. Cribbed from vanilla Frostbite's posture (an
  environmental injury, externalViolence false, no ignition) with
  workerClass DamageWorker_AddInjury, since scald is a one-shot wound per
  interval, and hediff Burn, so the wound reads as an ordinary burn to the
  player and the health system.

  defaultDamage/defaultArmorPenetration mirror RUT_ForgePulse's own
  scaldDamageAmount/armorPenetration (WeatherPulseExtension, F1's INVENTED
  ~4 dmg/60-tick-interval unroofed/unarmored figure) so a bare "attack with
  this DamageDef" (debug tools, a future non-weather consumer) behaves
  consistently with the weather condition's own tuning.
-->
<Defs>

  <DamageDef>
    <defName>RUT_Scald</defName>
    <label>scald</label>
    <description>A wound from scalding steam and boiling water - a wet burn. Heat-rated armor protects against it.</description>
    <workerClass>DamageWorker_AddInjury</workerClass>
    <hediff>Burn</hediff>
    <externalViolence>false</externalViolence>
    <canUseDeflectMetalEffect>false</canUseDeflectMetalEffect>
    <armorCategory>Heat</armorCategory>
    <defaultDamage>4</defaultDamage>
    <defaultArmorPenetration>0</defaultArmorPenetration>
    <deathMessage>{0} has been scalded to death.</deathMessage>
  </DamageDef>

</Defs>
