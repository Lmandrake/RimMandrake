    <defName>RM_PackedIce</defName>
    <label>packed ice</label>
    <texturePath>Terrain/Surfaces/AB_WhiteIce</texturePath>
    <pollutedTexturePath>StandIn/Terrain/Surfaces/AB_WhiteIce_Polluted</pollutedTexturePath>
