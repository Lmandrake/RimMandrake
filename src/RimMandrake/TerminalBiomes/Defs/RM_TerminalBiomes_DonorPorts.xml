    <pollutionColor>(1, 1, 1, 1)</pollutionColor>
    <pollutionCloudColor>(1, 1, 1, 0.66)</pollutionCloudColor>
    <edgeType>FadeRough</edgeType>
    <renderPrecedence>352</renderPrecedence>
    <pathCost>6</pathCost>
    <holdSnowOrSand>false</holdSnowOrSand>
    <statBases>
      <Beauty>-3</Beauty>
      <BeautyOutdoors>0</BeautyOutdoors>
    </statBases>
    <scatterType>SoftGray</scatterType>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>Diggable</li>
    </affordances>
    <generatedFilth>Filth_Dirt</generatedFilth>
    <fertility>0.00</fertility>
    <tags>
      </tags>
    <takeFootprints>True</takeFootprints>
  </TerrainDef>
  <!-- RM_PoisonShrub: port of PoisonShrub (Advanced Biomes (Continued), Mlie.AdvancedBiomes, workshop 3541022508,
       1.6/Defs/ThingDefs_Plants/Plants_PoisonForest.xml), plain XML copy 2026-11-01 for donor retirement
       (DONOR_BIOME_MODS_RETIRE_ZERO_TILES_LEFT): the Auroral Umbra (RUT_Umbra) was the last painted biome naming it
       (owner review 2026-09-20 moved it in, SHEET_ORPHAN_CONSUMPTION_1). Donor values kept; art is a StandIn copy of
       the donor's AssetBundle pictures (ShrubLowA/B). -->
  <ThingDef ParentName="BushBase">
    <defName>RM_PoisonShrub</defName>
    <label>poison shrub</label>
    <description>A short shrub. Does not typically talk.</description>
    <graphicData>
      <texPath>StandIn/Plant/PoisonShrub</texPath>
      <drawSize>1.15</drawSize>
      <shadowData>
        <volume>(0.55, 0.2, 0.2)</volume>
      </shadowData>
    </graphicData>
    <plant>
      <!-- ART_SIZES_AUDIT_AFTER_DONORS_LEAVE (2026-11-03): owner order ".8 cells, propane lakes" (flora_assignment_register.decisions.json, 2026-09-11) enacted; was 1.265 cells. -->
      <visualSizeRange>0.443~0.696</visualSizeRange>
      <growDays>3</growDays>
    </plant>
  </ThingDef>
</Defs>
