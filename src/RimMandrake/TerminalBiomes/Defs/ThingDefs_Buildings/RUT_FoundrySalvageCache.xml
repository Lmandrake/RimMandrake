<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    ============================================================================
    RUT_FoundrySalvageCache             UtinniPatches · FORGE_MECHANICS_1 F4
    ============================================================================
    forge_kit_spec.md F4 player-experience line: "forge-tech salvage as the
    prize." The F4 pass shipped an inert marker; SALVAGE_WRECKAGE_EVERYWHERE_1
    gave it the shared wreck-family salvage (loot on careful deconstruction).

    Spawned via RM_GenStep_PlacedSetPieces / RM_SetPieceElement_SpawnMarker
    (Defs/MapGeneration/RUT_FoundryFloor_SalvageCache.xml), same shared
    marker-spawn element every sibling kit in this mod already reuses.

    Art wired f94585748 (2026-09-29). Loot: SALVAGE_WRECKAGE_EVERYWHERE_1, below.
    ============================================================================
  -->

  <!-- SALVAGE_WRECKAGE_EVERYWHERE_1 (design §4 The Forge row: "Salvage cache (built shell) ... Forge-warm
       x1.0, RUT_FoundrySalvage extra table, gets the §3c comp and art"). The cache is now a child of the
       shared Carapace wreck family (mandrake.rm.wreckage, composed in mandrake.rm.biomes). It lives in TerminalBiomes
       beside RUT_ScaldWrecks.xml because a ParentName cannot cross to a mod loaded later (UtinniPatches sorts
       before the biomes mod in the live list: 'Could not find parent node' 2026-10-09): careful deconstruction gives its costList, a Carapace roll and the foundry's own
       RUT_SalvageLoot_Foundry roll; smashing gives slag. Everything the old marker set that the family
       would change is restated here: the 1x1 single sprite, pass-through floor heap, tickerType (the
       spunstone-study patch replaces it). Destroyable now, because deconstruction destroys. -->
  <!-- BAROQUE_LOAD_RESIDUE_ERRORS_1: Utinni content (its weathering def, texture and spawning genstep all live in
       mandrake.rut.patches), so the def loads only with that mod; without it the biomes mod no longer logs a dead
       cross-ref and a missing texture for a thing nothing can spawn. -->
  <ThingDef ParentName="RM_WreckFamily_Carapace" MayRequire="mandrake.rut.patches">
    <defName>RUT_FoundrySalvageCache</defName>
    <label>forge-tech salvage</label>
    <description>A heap of scavenged forge-tech, still warm, wedged against the melt channel wall. Whoever, or whatever, stacked it here clearly meant to come back. Deconstruct it carefully for what the foundry made.</description>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <tickerType>Never</tickerType>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.2</fillPercent>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Building/Production/RUT_FoundrySalvageCache</texPath>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <statBases>
      <Flammability>0</Flammability>
      <Beauty>0</Beauty>
    </statBases>
    <modExtensions>
      <li Class="RimMandrake.Wreckage.RM_WreckWeathering">
        <weathering>RUT_WreckWeathering_ForgeWarm</weathering>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
