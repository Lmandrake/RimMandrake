<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  RUT_SteamCatch.xml                     UtinniPatches · authored 2026-09-13
  ============================================================================
  SCALD_MECHANICS_1 build pass, S2 "the steam-catch" (scald_kit_spec.md §S2,
  the_scald.md §7 ⭐ "the tap of the world"). Condensers raised on the
  Scald's vents drink the clean breath: free, endless distilled water.

  comps -> RM_CompResourceCondenser (SCALD_MECHANICS_1 spike, already built
  and compiling), requiredThingAtPosition repointed from its C# default
  (vanilla ThingDefOf.SteamGeyser) to RUT_ScaldVent now that S4 ships it —
  exactly the "S4 repoints it per-building via XML the day that def ships"
  step the spec's own S2 text called for.

  placeWorkers -> RM_PlaceWorker_OnRequiredVentComp (new this pass, crib of
  the confirmed-real PlaceWorker_OnSteamGeyser reading its required def off
  this building's own CompProperties_ResourceCondenser instead of a
  hardcoded ThingDefOf — see that class's own header for why a hardcoded
  RUT_ScaldVent check does not belong in the shared RM_ mod).

  outputDef -> RM_DistilledWater (TerminalBiomes, SCALD_MECHANICS_1
  2026-10-11). Owner card 2 (S2 output FORM) ruled (c) BOTH, item water the
  default; that item is RM_DistilledWater. The FlowWorks pipe-water variant
  is not built and is FlowWorks work. 25 per day (PROVISIONAL, INVENTED,
  the kit spec's own "25 water units/day equivalent").
  Ban 1 patrol holds: no bill, no ingredient, no recipe.

  Costs/stats: INVENTED, no ruled figures exist. Scaled down from vanilla
  GeothermalGenerator's 340 Steel/8 ComponentIndustrial (a full power
  plant) — this only condenses water, no power output, no CompPowerPlantSteam.
  Size matches RUT_ScaldVent's own (2,2) footprint rather than
  GeothermalGenerator's 6x6 — simplest safe placement shape, not a
  from-source-verified vanilla convention.

  Texture: its own art. SCALD_ART_UPGRADE_WAVE_1, 2026-09-26 — replaced
  scald_steamcatchbuilding_v1 with scald2_steamcatchbuilding_a, the redo the
  owner asked for: the machine no longer reads blue-tinted (it stands above
  the water, dry, not an aquatic object) and the vent it sits on is visibly
  CAPPED.
  ============================================================================
-->
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>RUT_SteamCatch</defName>
    <label>steam-catch condenser</label>
    <description>A condenser locked to a scald vent, drinking the clean breath of the boil and yielding distilled water for free — so long as you hold the ground and pay the shore's burns to build there.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/RUT_SteamCatch</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.5</fillPercent>
    <size>(2,2)</size>
    <rotatable>false</rotatable>
    <scatterableOnMapGen>false</scatterableOnMapGen>
    <canOverlapZones>false</canOverlapZones>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>3000</WorkToBuild>
      <Flammability>0.5</Flammability>
      <Beauty>-4</Beauty>
    </statBases>
    <costList>
      <Steel>75</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="RimMandrake.EnvironmentalHazards.CompProperties_ResourceCondenser">
        <requiredThingAtPosition>RUT_ScaldVent</requiredThingAtPosition>
        <outputDef>RM_DistilledWater</outputDef>
        <outputCountPerCycle>25</outputCountPerCycle>
        <cycleTicks>60000</cycleTicks>
      </li>
    </comps>
    <placeWorkers>
      <li>RimMandrake.EnvironmentalHazards.RM_PlaceWorker_OnRequiredVentComp</li>
    </placeWorkers>
    <designationCategory>Production</designationCategory>
    <constructEffect>ConstructMetal</constructEffect>
    <modExtensions>
      <!-- Mod Settings gate: Terminal Biomes' S2 steam-catch toggle. -->
      <li Class="RimMandrake.EnvironmentalHazards.RM_MechanicGateExtension">
        <gateKey>Scald.S2</gateKey>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
