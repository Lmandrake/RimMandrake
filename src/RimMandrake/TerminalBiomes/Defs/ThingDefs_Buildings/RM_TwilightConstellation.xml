<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  RM_TwilightConstellation.xml          TerminalBiomes · TWILIGHT_LIGHT_ECONOMY_1
  ============================================================================
  §2: the mobile constellation. Every def here is minifiable with near-zero
  uninstallWork — "unclip (an uninstall job, seconds), carry (a haul),
  re-anchor (a reinstall, seconds)" on vanilla verbs alone, no new movement
  system. costList spends exactly one RM_TetherChain per piece — the hard cap
  (§2.2-1): the constellation is only ever as big as the chain drawer.

  Cages carry RM_Comp_CageCropSnapshot so a move doesn't kill their crop.
  Lamps carry CompGlower + RM_Comp_WarblingGlow (the sealed living clip's
  breathing pulse, §2.2-4/§3.2) and deliberately nothing else — "no feed
  chores on the small lamps" is a refusal, not an oversight, so there is no
  CompRefuelable here. Passability is applied at runtime by
  RM_TwilightPassabilityApplier per the "cages passable-beneath" Mod
  Setting (default PassThroughOnly, matching his own "floats above you").

  PLACEHOLDER ART: RM_GlowTank's own texture (mandrake.rm.luminouspigment, a
  hard dependency) for the cages — a glass-vessel silhouette tinted
  differently per piece — and Things/Mote/BeamGlow tinted
  for the lamps (same family as RM_Skylight's placeholder, dimmer and
  smaller; validate_patch.py, pointed at the real 629-mod install and Data
  folders, confirms both textures exist and resolve). Real art owed
  alongside the rest of this pass.
  ============================================================================
-->
<Defs>

  <!-- ==================================================================
       Shared shape for the two cage fields (sphere/cube per §2, content
       doc's own cage silhouettes — this pass gives them the mechanism,
       not new art).
       ================================================================== -->
  <ThingDef Name="RM_ConstellationCageBase" ParentName="BuildingBase" Abstract="True">
    <thingClass>Building_PlantGrower</thingClass>
    <category>Building</category>
    <altitudeLayer>LowPlant</altitudeLayer>
    <drawerType>MapMeshOnly</drawerType>
    <tickerType>Rare</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <size>(2,2)</size>
    <fertility>1.0</fertility>
    <canOverlapZones>false</canOverlapZones>
    <fillPercent>0.2</fillPercent>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <statBases>
      <MaxHitPoints>140</MaxHitPoints>
      <WorkToBuild>2200</WorkToBuild>
      <Flammability>0.2</Flammability>
      <Beauty>3</Beauty>
    </statBases>
    <costList>
      <Steel>60</Steel>
      <RM_TetherChain>1</RM_TetherChain>
    </costList>
    <designationCategory>Production</designationCategory>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <building>
      <uninstallWork>60</uninstallWork>
      <isEdifice>false</isEdifice>
    </building>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="RimMandrake.TerminalBiomes.RM_CompProperties_CageCropSnapshot" />
    </comps>
  </ThingDef>

  <ThingDef ParentName="RM_ConstellationCageBase">
    <defName>RM_ConstellationCageSphere</defName>
    <label>sphere cage</label>
    <description>A round frame of light alloy strung with waveglass panes, hung from a single tether-chain. Whatever grows inside it grows just the same whether it's over open water, a channel bed, or nothing at all — it floats above you, and moving it costs an afternoon, not a season.</description>
    <graphicData>
      <texPath>Things/Building/Production/RM_GlowTank</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
      <color>(150,210,220)</color>
    </graphicData>
    <building>
      <sowTag>RM_ConstellationCage</sowTag>
    </building>
  </ThingDef>

  <ThingDef ParentName="RM_ConstellationCageBase">
    <defName>RM_ConstellationCageCube</defName>
    <label>cube cage</label>
    <description>A boxed frame of light alloy strung with waveglass panes, hung from a single tether-chain. Squarer and a little roomier than its sphere sibling, otherwise the same trade: an afternoon's haul instead of a season's regrowth.</description>
    <graphicData>
      <texPath>Things/Building/Production/RM_GlowTank</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2.2,2.2)</drawSize>
      <color>(190,180,220)</color>
    </graphicData>
    <building>
      <sowTag>RM_ConstellationCage</sowTag>
    </building>
  </ThingDef>

  <!-- ==================================================================
       Clipped lamps, stage 2 of §3.1's progression. Built from a
       harvested/grown living clip (RM_NoothelmBulb or RM_HoolimbreString,
       RM_TwilightLightEconomyItems.xml) + one tether-chain. Permanent,
       sealed, no feed — dark while minified/in transit, for free.
       ================================================================== -->
  <ThingDef Name="RM_ConstellationLampBase" ParentName="BuildingBase" Abstract="True">
    <category>Building</category>
    <altitudeLayer>Building</altitudeLayer>
    <drawerType>MapMeshOnly</drawerType>
    <tickerType>Normal</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <size>(1,1)</size>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.15</fillPercent>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>900</WorkToBuild>
      <Flammability>0.1</Flammability>
      <Beauty>4</Beauty>
    </statBases>
    <costList>
      <RM_TetherChain>1</RM_TetherChain>
    </costList>
    <designationCategory>Production</designationCategory>
    <constructionSkillPrerequisite>2</constructionSkillPrerequisite>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <building>
      <uninstallWork>40</uninstallWork>
      <isEdifice>false</isEdifice>
    </building>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="RimMandrake.EnvironmentalHazards.RM_CompProperties_WarblingGlow">
        <hueRangeDegrees>14</hueRangeDegrees>
        <valuePulseFraction>0.1</valuePulseFraction>
        <radiusPulseFraction>0.07</radiusPulseFraction>
        <primaryPeriodTicks>257</primaryPeriodTicks>
        <secondaryPeriodTicks>149</secondaryPeriodTicks>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="RM_ConstellationLampBase">
    <defName>RM_NoothelmLampClipped</defName>
    <label>noothelm lamp</label>
    <description>A noothelm bulb clipped whole to a tether-chain — sealed, living and permanent, needing nothing but the water around it. Its light is warm gold, and it breathes, slow and steady, the way every real living lamp in this sea does.</description>
    <graphicData>
      <texPath>Things/Mote/BeamGlow</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>MoteGlow</shaderType>
      <drawSize>(1.4,1.4)</drawSize>
      <color>(255,220,150,200)</color>
    </graphicData>
    <costList>
      <RM_NoothelmBulb>1</RM_NoothelmBulb>
      <RM_TetherChain>1</RM_TetherChain>
    </costList>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>4.0</glowRadius>
        <glowColor>(255,220,150,0)</glowColor>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="RM_ConstellationLampBase">
    <defName>RM_HoolimbreLampClipped</defName>
    <label>hoolimbre lamp</label>
    <description>A string of hoolimbre clipped whole to a tether-chain — sealed, living and permanent. It is the same organism as the loose bladder you can pick up on day one, grown out and fixed instead of carried and left to rot. Its light runs cooler and greener than the noothelm's, and it breathes the same slow way.</description>
    <graphicData>
      <texPath>Things/Mote/BeamGlow</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>MoteGlow</shaderType>
      <drawSize>(1.4,1.4)</drawSize>
      <color>(170,225,180,200)</color>
    </graphicData>
    <costList>
      <RM_LampBladder>2</RM_LampBladder>
      <RM_TetherChain>1</RM_TetherChain>
    </costList>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>3.5</glowRadius>
        <glowColor>(170,225,180,0)</glowColor>
      </li>
    </comps>
  </ThingDef>


</Defs>
