<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  RUT_SteamDevil.xml                     UtinniPatches · GREENTIDE_MECHANICS_2 M3
  ============================================================================
  greentide_kit_spec.md M3 ("Scald damage + steam devils"): "a wandering
  white column of boiling vapor spins off the river". Only the vortex ships
  here — the Scald damage-type trio (RUT_Scald/RM_ScaldArmor/
  RM_ArmorRating_Scald) already shipped under FORGE_MECHANICS_1 F1.

  Def shape cribbed from vanilla's own Tornado ThingDef (Data/Core/Defs/
  ThingDefs_Misc/Ethereal_Various.xml, read directly off the live install
  this pass — category Ethereal, useHitPoints false, tickerType Normal;
  vanilla's own comps list carries only CompProperties_WindSource, which
  this vortex does not need and so omits). thingClass -> RM_WanderingVortex
  (new this pass, src/RimMandrake/EnvironmentalHazards/Source/), a
  from-scratch reimplementation of Tornado's own wander/damage/dissipate
  shape per this repo's license posture for vanilla crib targets — see that
  class's own header.

  drawerType deliberately LEFT at EtherealThingBase's own inherited "None"
  (self-review catch: Tornado sets RealtimeOnly only because it also ships
  ~180 lines of custom DrawAt mesh-part code, which this pass does not crib
  — copying just the drawerType override without the draw code risks an
  engine draw call against a null Graphic every frame). No <graphicData>/
  art this pass (same DEPLOY_HOLD posture as RUT_RoilWeather's own overlay
  texture) — the vortex is represented only by its own Tick-driven fleck
  column (FleckMaker.ThrowSmoke, already-shipped vanilla flecks, no new
  art), not a drawn sprite. OWED, flagged rather than silently shipped: the
  spec's own "visible from far off" is NOT met by flecks alone (they only
  render near the vortex's own position) — real custom draw code (or at
  minimum a graphicData + drawerType once art exists) is owed to a later
  art/rendering pass.
  ============================================================================
-->
<Defs>

  <ThingDef ParentName="EtherealThingBase" MayRequire="mandrake.rm.environmentalhazards">
    <defName>RUT_SteamDevil</defName>
    <label>steam devil</label>
    <description>A wandering column of scalding vapor, dragged up off the river. It scalds what it crosses and knocks down what it can — a wet burn that heat-rated armor does nothing against.</description>
    <thingClass>RimMandrake.EnvironmentalHazards.RM_WanderingVortex</thingClass>
    <tickerType>Normal</tickerType>
    <alwaysFlee>true</alwaysFlee>
    <modExtensions>
      <li Class="RimMandrake.EnvironmentalHazards.RM_WanderingVortexExtension">
        <damageDef>RUT_Scald</damageDef> <!-- same mod as RUT_Scald.xml itself — no MayRequire needed -->

        <!-- All other fields left at RM_WanderingVortexExtension's own INVENTED defaults; see that class. -->
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
