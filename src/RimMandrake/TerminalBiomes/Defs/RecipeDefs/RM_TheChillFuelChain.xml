<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  RM_TheChillFuelChain.xml                CHILL_FLORA_BUILD_1
  ============================================================================
  Ruling 2 (owner, sitting of 2026-09-27): "it's ok to harvest them for fuel.
  This is very late gme" and, on shape: "Just have it result at the harvest
  bench (hydrocarbon flesh) that can then be converted at the refinery."

  The refinery ALREADY EXISTS — vanilla's own BiofuelRefinery, the same
  building RUT_PropaneCatch_Refining.xml already hangs a Chill-catch-to-
  chemfuel recipe on (src/RimUtinni/UtinniPatches/Defs/RecipeDefs/). No
  parallel refinery building is invented here, per the item's own
  instruction. Every recipe below is a standalone RecipeDef (no ParentName)
  in that same shape, MayRequire="Ludeon.RimWorld.Odyssey" mirroring the
  sibling recipe's own guard.

  Three-step chain, because a vanilla Plant can only carry ONE
  harvestedThingDef and two of these plants have TWO ruled fractions:

    harvest -> [bench recipe, if the plant has two fractions] -> hydrocarbon
    flesh (+ any second product) -> [refinery recipe] -> chemfuel

  - Slackwax: RM_SlackwaxTimber (primary, kept as timber), OR
  - Pitchpearl: RM_PitchpearlBeads (primary, kept as feed), feed into:
      RM_Make_HydrocarbonFleshFromChillFlora -> RM_HydrocarbonFlesh
  - Tarspool: RM_TarspoolStalk -> RM_Resolve_TarspoolStalk ->
      RM_RimeNoduleEuphoric (ruling 8) + RM_HydrocarbonFlesh
  - All hydrocarbon flesh -> RM_Make_ChemfuelFromHydrocarbonFlesh ->
      Chemfuel. THIS is the gate ruling 2 means.

  Yield numbers are [INVENTED], calibrated loosely against
  RUT_PropaneCatch_Refining.xml's own 10 catch -> 35 chemfuel ratio (a purer
  hydrocarbon feedstock than mixed catch, priced a little richer per unit).
  ============================================================================
-->
<Defs>

  <!-- SEA_FLOOR_AND_CATCH_PASS_1, 2026-11-11: the refinery bill for the catch a player actually lands.
       Owner ruling 2026-09-24 (question card, "Refinery bill"): the Propane Lake's catches are fuel as a
       MECHANIC, 10 catch -> 35 chemfuel at the vanilla BiofuelRefinery. That bill
       (RUT_Make_ChemfuelFromPropaneCatch) takes only the frozen RUT_ twin items, which no fishTypes table
       serves since CHILL_FREE_TIER_CATCH_1 moved the Chill's catch to RM_*Catch, so the shore's catch could
       not be refined at all. Same numbers and shape, on the seven hydrocarbon catches (Flammability 1.0 in
       RM_TheChillCatch.xml); heemin and oovanam carry no Flammability 1.0 and were absent from the
       original bill, so they stay out (validation.chill_refinery_checks). -->
  <RecipeDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>RM_Make_ChemfuelFromChillCatch</defName>
    <label>render Chill catch into chemfuel</label>
    <description>Crack a batch of Chill catch into chemfuel. The creatures of that shore are grown from fuel snow and burn like it; rendering them is closer to decanting than to refining.</description>
    <jobString>Rendering Chill catch into chemfuel.</jobString>
    <effectWorking>Cremate</effectWorking>
    <soundWorking>Recipe_Cremate</soundWorking>
    <workAmount>1200</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <allowMixingIngredients>true</allowMixingIngredients>
    <recipeUsers>
      <li>BiofuelRefinery</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <customSummary>Chill catch</customSummary>
          <thingDefs>
            <li>RM_FessuCatch</li>
            <li>RM_KrellikCatch</li>
            <li>RM_OdduCatch</li>
            <li>RM_OovuCatch</li>
            <li>RM_IlissCatch</li>
            <li>RM_TarnnCatch</li>
            <li>RM_ZhiilCatch</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>RM_FessuCatch</li>
        <li>RM_KrellikCatch</li>
        <li>RM_OdduCatch</li>
        <li>RM_OovuCatch</li>
        <li>RM_IlissCatch</li>
        <li>RM_TarnnCatch</li>
        <li>RM_ZhiilCatch</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Chemfuel>35</Chemfuel>
    </products>
  </RecipeDef>

  <!-- Tarspool's stalk, resolved into its two ruled fractions in one bench
       action ("scraping the crown... the heavy black tars at the base",
       doc's own two-part harvest description) — one RecipeDef, two
       <products>, rather than inventing a second harvestedThingDef field
       the engine does not have. -->
  <RecipeDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>RM_Resolve_TarspoolStalk</defName>
    <label>resolve a tarspool stalk</label>
    <description>Take a whole tarspool apart along its own bands: scrape the violet crown for its euphoric fraction, render the black base tars down to hydrocarbon flesh. The amber middle goes to neither and is simply lost.</description>
    <jobString>Resolving a tarspool stalk.</jobString>
    <workAmount>400</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cremate</effectWorking>
    <soundWorking>Recipe_Drug</soundWorking>
    <recipeUsers>
      <li>BiofuelRefinery</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>RM_TarspoolStalk</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>RM_TarspoolStalk</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <RM_RimeNoduleEuphoric>1</RM_RimeNoduleEuphoric>
      <RM_HydrocarbonFlesh>1</RM_HydrocarbonFlesh>
    </products>
  </RecipeDef>

  <!-- Slackwax's offcuts, Pitchpearl's beads: the doc's own "who feeds the
       chain" list, minus Tarspool (handled above). Interchangeable
       ingredient filter, same shape as RUT_PropaneCatch_Refining.xml's own
       seven-catch filter. -->
  <RecipeDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>RM_Make_HydrocarbonFleshFromChillFlora</defName>
    <label>render Chill flora into hydrocarbon flesh</label>
    <description>Cut slackwax offcuts, or pitchpearl beads not wanted for feed, rendered down into stacked hydrocarbon flesh — inert, industrial, and worth nothing until a refinery wants it.</description>
    <jobString>Rendering Chill flora into hydrocarbon flesh.</jobString>
    <workAmount>500</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cremate</effectWorking>
    <soundWorking>Recipe_Cremate</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <recipeUsers>
      <li>BiofuelRefinery</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <customSummary>Chill flora offcuts</customSummary>
          <thingDefs>
            <li>RM_SlackwaxTimber</li>
            <li>RM_PitchpearlBeads</li>
          </thingDefs>
        </filter>
        <count>4</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>RM_SlackwaxTimber</li>
        <li>RM_PitchpearlBeads</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <RM_HydrocarbonFlesh>2</RM_HydrocarbonFlesh>
    </products>
  </RecipeDef>

  <!-- The gate itself — ruling 2's "converted at the refinery." Very-late-
       game by construction: BiofuelRefinery's own research/power/Odyssey
       requirements are the gate, exactly as the doc specifies ("reached
       only by a colony that already flies a gravship to the floor and
       back... until that bench exists the flesh is just the strangest meat
       in the larder"). -->
  <RecipeDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>RM_Make_ChemfuelFromHydrocarbonFlesh</defName>
    <label>refine hydrocarbon flesh into chemfuel</label>
    <description>Crack the Chill floor's own hydrocarbon flesh into chemfuel. It is purer feedstock than the pipe crews haul up from the shore catch — closer to decanting than to refining, and priced entirely in ship time and refinery watts.</description>
    <jobString>Refining hydrocarbon flesh into chemfuel.</jobString>
    <workAmount>1200</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cremate</effectWorking>
    <soundWorking>Recipe_Cremate</soundWorking>
    <recipeUsers>
      <li>BiofuelRefinery</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>RM_HydrocarbonFlesh</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>RM_HydrocarbonFlesh</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Chemfuel>15</Chemfuel>
    </products>
  </RecipeDef>

  <!-- Stonewater's powered extractor, ruling 3: "Cooking + real water
       source w/ power" — the extractor melts harvested ice under power
       into a genuine water item. RM_ChillStonewaterExtractor itself
       (Building_WorkTable + CompPowerTrader) is in
       RM_ChillStonewaterExtractor.xml, this pass; Building_WorkTable's own
       power gate (CanWorkWithoutPower false, default) is what makes
       "melting costs watts" literally true — the bill simply will not run
       unpowered, verified against decompiled Building_WorkTable.BillStack/
       UsableNow, not assumed. -->
  <RecipeDef>
    <defName>RM_Extract_MeltedWater</defName>
    <label>melt stonewater ice</label>
    <description>Run harvested stonewater ice through the powered extractor. The local granite comes apart into real, drinkable water — the lake floor's only genuine water source, and every litre of it costs watts.</description>
    <jobString>Melting stonewater ice.</jobString>
    <workAmount>300</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cremate</effectWorking>
    <recipeUsers>
      <li>RM_ChillStonewaterExtractor</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>RM_StonewaterIce</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>RM_StonewaterIce</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <RM_MeltedWater>2</RM_MeltedWater>
    </products>
  </RecipeDef>

</Defs>
