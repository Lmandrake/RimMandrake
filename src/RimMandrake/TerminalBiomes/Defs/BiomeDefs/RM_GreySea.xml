<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  RM_GreySea.xml                          TerminalBiomes · moved 2026-09-25
  ============================================================================
  TERMINALBIOMES_RM_MOD_BUILD_1 step 2. Content copied as-is from
  src/RimUtinni/UtinniPatches/Defs/BiomeDefs/RUT_GreySea.xml (now frozen,
  same folder) — see that file's own header for the full authorship history.

  ONE substantive change from the original build: the one `RSW_` wildAnimals
  row (RSW_Reefback) is no longer patched in via
  src/RimUtinni/UtinniPatches/Patches/WildAnimals_GreySea.xml — the Reefback
  is one of SEA_BEASTS_TIER_RULING_1's 11 INVENTED sea beasts (verified
  2026-09-25 against Wookieepedia's search API: no canon hit), so it ships
  inline below as `RM_Reefback` (RM_SeaBeasts_Invented.xml, same mod,
  no MayRequire) instead of behind a mandrake.rsw.swbestiary gate.
  AA_Aerofleet (Alpha Animals, not Star Wars) stays. Everything else —
  terrain, weather, fishTypes, GravTide support — is byte-identical to the
  twin.
  ============================================================================
-->
<Defs>

  <BiomeDef>
    <defName>RM_GreySea</defName>
    <label>the Grey Sea</label>
    <description>A hypersaline terminal sea on the terminator band, its own endemic mat holding it alone the way the Twilight Sea's holds that one. Salt-encrusted and shrinking faster than its sister sea — the planet's chemical works, and the retreating shoreline is free surveying for anyone who can read the terraces.</description>
    <workerClass>BiomeWorker_Ocean</workerClass>
    <isWaterBiome>true</isWaterBiome>
    <canBuildBase>false</canBuildBase>
    <allowRoads>true</allowRoads>
    <allowRivers>false</allowRivers>
    <hasVirtualPlants>false</hasVirtualPlants>
    <texture>World/Biomes/Ocean</texture>
    <impassable>true</impassable>
    <isBackgroundBiome>true</isBackgroundBiome>

    <!-- GREYSEA_SHORE_MUTATOR_SPECIFICS_1, 2026-09-26. Owner: "Make sure the
         shore mutator respects the specifics of the grey sea", with the
         crusted-white reference image.

         🔑 The per-sea seam ALREADY EXISTED and was simply empty. MEASURED
         2026-09-26 by reading RM_TileMutatorWorker_SeaCoast: it resolves the
         bordering sea in Init and overrides DeepWaterTerrainAt /
         ShallowWaterTerrainAt / BeachTerrainAt to read that sea's
         RM_SeaShoreExtension. With all three fields unset the Grey fell
         through to the VANILLA OCEAN pair — i.e. the Grey Sea's shore was
         indistinguishable from any other sea's, and from the ocean.
         That is the item's design question answered: route (a), one mutator
         reading the sea, already built. This is data, not a new mutator.

         ⚠️ The two water terrains are FlowWorks' (the Grey's own brine
         suite, RM_Liquid_Brine), and this mod loadAfters flowworks rather
         than hard-depending on it — hence MayRequire on those two fields.
         beachTerrain is ours and needs no guard. -->
    <modExtensions>
      <li Class="RimMandrake.SeaShores.RM_SeaShoreExtension" MayRequire="mandrake.rm.seashores">
        <deepTerrain MayRequire="mandrake.rm.flowworks">RM_WaterBrineDeep</deepTerrain>
        <shallowTerrain MayRequire="mandrake.rm.flowworks">RM_WaterBrineShallow</shallowTerrain>
        <beachTerrain>RM_SaltCrustShore</beachTerrain>
      </li>
    </modExtensions>

    <!-- Reefback (endemic giant, INVENTED — see SEA_BEASTS_TIER_RULING_1)
         ships inline, franchise-free, at the same commonality the Utinni
         patch used to add it at.
         TERMINALBIOMES_RM_MOD_BUILD_1 / terminal_seas_cast_proposal_2026-09-25.md
         verdict 1: the four ruled floor residents (RM_GreySeaFauna.xml).

         🔴 AA_Aerofleet CUT 2026-09-26 (owner, decision by question card at the
         Grey Sea sitting): the donor drifter is replaced by a new creature of
         ours, not by re-using a neighbour's. The replacement and the sheet's two
         unbuilt anchors are GREYSEA_ANCHOR_CREATURES_1.
         ⛔ This cut is scoped to the GREY SEA ONLY. RM_TwilightSea and
         RM_TheForge still cast AA_Aerofleet deliberately — a cut in one sheet is
         never a planet-wide sweep, so do not "fix" those to match. -->
    <wildAnimals>
      <RM_Reefback>0.005</RM_Reefback>
      <RM_Fessk>0.01</RM_Fessk>
      <RM_Sorruth>0.4</RM_Sorruth>
      <RM_Essarn>0.6</RM_Essarn>
      <RM_Otheska>0.2</RM_Otheska>
      <!-- GREYSEA_SESSILE_LAYER_1, 2026-09-26. The owner's "abundant
           shrimp, clam and mussel equivalents", RULED all three NEW at the
           bench (this overrode BENCH's own position that RM_Fessk already
           covered "shrimp"; the new one is hand-sized and is authored so it
           cannot read as a second ossuary shrimp).
           🔑 The abundance is HERE, in commonality — the highest three
           numbers on this sea — and NOT in wildGroupSize, which stays at 1
           (1~4 for the pillar-clustering grusk, the placement the sheet
           explicitly permits). That is precisely how "abundant" satisfies
           ban 2's "no herds, flocks, schools, packs or swarms."
           Defs: Defs/ThingDefs_Races/RM_GreySeaSessile.xml. -->
      <RM_Nissik>0.9</RM_Nissik>
      <RM_Grusk>0.8</RM_Grusk>
      <RM_Thollim>0.7</RM_Thollim>
      <!-- SEA_FISHABLES_ALIVE_IN_DEPTHS_1, 2026-09-26 (Grey portion). Owner:
           "All the fishables should also be alive and moving around in the
           depths (this is true for ALL seas)." These seven are the living
           counterparts of the seven catch-only rows in <fishTypes> below,
           authored from those items' own existing descriptions rather than
           invented fresh. Defs: RM_GreySeaFloorLife.xml.
           ⚠️ The catch items they pair with are RUT_-tier and MayRequire-
           gated; these are RM_ and inline, so the free mod's floor stands
           alone. The tier mismatch on the CATCH side is recorded as owed
           in RM_GreySeaFloorLife.xml's header. -->
      <RM_Sallik>0.5</RM_Sallik>
      <RM_Karrud>0.45</RM_Karrud>
      <RM_Hessal>0.55</RM_Hessal>
      <RM_Oomal>0.35</RM_Oomal>
      <RM_Maalu>0.3</RM_Maalu>
      <RM_Immu>0.3</RM_Immu>
      <RM_Haarn>0.08</RM_Haarn>
      <!-- GREYSEA_ANCHOR_CREATURES_1, ruling 2: the AA_Aerofleet replacement,
           at the same commonality the cut donor drifter held. Solitary,
           non-schooling (ban 2); no *Catch counterpart, see
           RM_GreySeaShoreLife.xml's own header. -->
      <RM_Corrik>0.05</RM_Corrik>
    </wildAnimals>
    <animalDensity>0.1</animalDensity>
    <coastalWildAnimals />

    <!-- GREYSEA_CRYSTAL_FLORA_1, 2026-09-26 — the owner's seven crystalline
         forms (Defs/ThingDefs_Plants/RM_GreySeaFlora.xml; HIS verbatim specs
         are the authority, in the content doc §4.2-§4.6).

         🔴 plantDensity WAS UNSET, i.e. 0f. WildPlantSpawner.
         GetDesiredPlantsCountAt multiplies the biome's plantDensity, so a
         biome that never sets it wants ZERO plants everywhere no matter what
         its wildPlants list says. Authoring the flora without this line
         would have shipped seven defs that can never appear. 0.14 is low on
         purpose: the floor is crowded with MINERAL forms (the scatter steps)
         and sparse with living ones.

         🔴 The shorthand <DefName>commonality</DefName> form, NOT <li>.
         BiomePlantRecord/BiomeAnimalRecord use a custom loader that reads
         the node NAME as the def and the node TEXT as the commonality; an
         <li> wrapper silently discards the whole entry.

         🔑 RM_GlassVeilKelp and RM_SaltChimneyVine sit at HIGH commonality
         here and are still rare on the map, because both are terrain-gated
         (wildTerrainTags RM_GreyBrineChannel / RM_GreyChimneySeep) and
         those two terrains cover a few hundred cells of a floor. The
         commonality is the weight WITHIN a cell they are allowed in, not
         across the map. They were held out of this list until
         GenStep_GreySeaFloorDressing existed to paint that terrain, because
         a kelp on open sediment is not the plant the owner specified
         ("over trenches and brine rivers"; "grow ONLY around warm mineral
         seeps"). ⛔ Never remove their wildTerrainTags to "make them show
         up". -->
    <plantDensity>0.14</plantDensity>
    <wildPlants>
      <RM_CubicSculpture>0.6</RM_CubicSculpture>
      <RM_CruciblePod>0.5</RM_CruciblePod>
      <RM_MosaicFanPalm>0.4</RM_MosaicFanPalm>
      <RM_SpherePlant>0.35</RM_SpherePlant>
      <RM_BrineCrown>0.15</RM_BrineCrown>
      <RM_GlassVeilKelp>2.0</RM_GlassVeilKelp>
      <RM_SaltChimneyVine>2.0</RM_SaltChimneyVine>
      <!-- TERMINAL_SEAS_FLOOR_DRESSING_1, 2026-09-26: terminator_sea.md §4/§9's
           "planar salt-rimed blade flora … hundreds of metres apart" — the
           sparsest thing on this floor by design, see RM_GreySeaSaltBlade.xml. -->
      <RM_SaltBladeGrey>0.03</RM_SaltBladeGrey>
    </wildPlants>

    <wildAnimalsCanWanderInto>false</wildAnimalsCanWanderInto>
    <!-- GREYSEA_SALT_SNOW_WEATHER_1, 2026-09-26.
         🔴 Vanilla `Rain 4` REMOVED, not superseded. It was a pre-existing
         defect against terminator_sea.md §6's hard ban ("no rain, no
         thunderstorms, no snow, no ice" — its own reason: at +14 degC with no
         lift the only water delivery is thin fog), found by the owner's
         2026-09-26 content drop pass and recorded in sheet §4c. It predates
         the drop and is not part of it.
         RM_GreySaltSnow ADDED (Defs/WeatherDefs/RM_GreySaltSnow.xml) —
         his "precipitating salt crystals, like snow." It lands on the FLOOR
         and nowhere else: RM_GreySea is impassable/isBackgroundBiome, so the
         only map carrying this biome is the sea-dive pocket map. -->
    <baseWeatherCommonalities>
      <Clear>12</Clear>
      <Fog>7</Fog>
      <RM_GreySaltSnow>6</RM_GreySaltSnow>
    </baseWeatherCommonalities>
    <terrainsByFertility>
      <li>
        <terrain>WaterOceanDeep</terrain>
        <min>-999</min>
        <max>999</max>
      </li>
    </terrainsByFertility>

    <!-- SEA_FLOOR_AND_CATCH_PASS_1 — the Grey Sea's catch table.
         terminal_seas_cast_proposal_2026-09-25.md verdict 2: essarn/sorruth
         ADDED here, not replacing the pre-existing table (see
         RM_GreySeaCatch.xml's own header). -->
    <maxFishPopulation>120</maxFishPopulation>
    <fishTypes MayRequire="Ludeon.RimWorld.Odyssey">
      <saltwater_Common>
        <RUT_Sallik MayRequire="mandrake.rut.patches">1.2</RUT_Sallik>
        <RUT_Karrud MayRequire="mandrake.rut.patches">1</RUT_Karrud>
        <RUT_Hessal MayRequire="mandrake.rut.patches">1</RUT_Hessal>
        <RUT_Oomal MayRequire="mandrake.rut.patches">0.6</RUT_Oomal>
        <RM_EssarnCatch>1</RM_EssarnCatch>
        <!-- GREYSEA_SESSILE_LAYER_1: the sessile layer is catchable, so
             each of the three owes a row here beside its floor resident
             (the standing two-defs-per-species law). These are the cheap,
             reliable end of the table — sheet §7's "the sessile catch",
             what the shore camps actually live on. -->
        <RM_NissikCatch>1.3</RM_NissikCatch>
        <RM_ThollimCatch>1.1</RM_ThollimCatch>
        <RM_GruskCatch>0.9</RM_GruskCatch>
      </saltwater_Common>
      <saltwater_Uncommon>
        <RUT_Maalu MayRequire="mandrake.rut.patches">1</RUT_Maalu>
        <RUT_Immu MayRequire="mandrake.rut.patches">0.7</RUT_Immu>
        <RUT_Haarn MayRequire="mandrake.rut.patches">0.4</RUT_Haarn>
        <RM_SorruthCatch>0.5</RM_SorruthCatch>
      </saltwater_Uncommon>
      <rareCatchesSetMaker>RUT_RareGreyCatches</rareCatchesSetMaker>
    </fishTypes>
  </BiomeDef>

</Defs>
