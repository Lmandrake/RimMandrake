<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  RM_TwilightSea.xml                     TerminalBiomes · moved 2026-09-25
  ============================================================================
  TERMINALBIOMES_RM_MOD_BUILD_1 step 2. Content copied as-is from
  src/RimUtinni/UtinniPatches/Defs/BiomeDefs/RUT_TwilightSea.xml (now frozen,
  same folder) — see that file's own header for the full authorship history.

  Two changes from the twin:
  1. The one `RSW_` wildAnimals row (RSW_Lanternwhale) is no longer patched
     in via src/RimUtinni/UtinniPatches/Patches/WildAnimals_TwilightSea.xml —
     SEA_BEASTS_TIER_RULING_1 found the lanternwhale is one of the 11
     INVENTED sea beasts (verified 2026-09-25, no Wookieepedia canon hit), so
     it ships inline below as `RM_Lanternwhale` (RM_SeaBeasts_Invented.xml,
     same mod, no MayRequire). AA_Aerofleet (Alpha Animals, not Star Wars)
     stays.
  2. `fishTypes`/`maxFishPopulation` are FOLDED IN from
     src/RimUtinni/UtinniPatches/Patches/BiomeFishTypes_TwilightDeep.xml
     (a PatchOperationAdd onto RUT_TwilightSea, hold lifted 2026-09-20) per
     item §6/§11 step 2's explicit instruction — that patch keeps targeting
     the frozen twin unchanged; this def carries the same 10 species
     natively instead of via a patch, since this mod owns the def outright.
  ============================================================================
-->
<Defs>

  <BiomeDef>
    <defName>RM_TwilightSea</defName>
    <label>the Twilight Sea</label>
    <description>A hypersaline terminal sea on the terminator band, lidded from shore to shore by one organism that has never had to share it: the waveglass, a blue-green sheen on the water from above and a ceiling of living stained glass from far beneath. It has no outflow and it is shrinking — the stranded shoreline terraces mark where it used to reach.</description>
    <workerClass>BiomeWorker_Ocean</workerClass>
    <isWaterBiome>true</isWaterBiome>
    <canBuildBase>false</canBuildBase>
    <allowRoads>true</allowRoads>
    <allowRivers>false</allowRivers>
    <hasVirtualPlants>false</hasVirtualPlants>
    <texture>World/Biomes/Ocean</texture>
    <impassable>true</impassable>
    <isBackgroundBiome>true</isBackgroundBiome>

    <modExtensions>
      <li Class="RimMandrake.SeaShores.RM_SeaShoreExtension" />
    </modExtensions>

    <!-- Lanternwhale (endemic giant, INVENTED — see SEA_BEASTS_TIER_RULING_1)
         ships inline, franchise-free, at the same commonality the Utinni
         patch used to add it at. AA_Aerofleet (Alpha Animals) stays.
         TERMINALBIOMES_RM_MOD_BUILD_1 / terminal_seas_cast_proposal_2026-09-25.md
         verdict 1: the four ruled floor residents (RM_TwilightSeaFauna.xml). -->
    <wildAnimals>
      <AA_Aerofleet MayRequire="sarg.alphaanimals">0.05</AA_Aerofleet>
      <RM_Lanternwhale>0.005</RM_Lanternwhale>
      <!-- Gripping terror: moved here from the Scald (owner, Scald sheet 2026-10-05). -->
      <RM_GrippingTerror>0.005</RM_GrippingTerror>
      <RM_Noolim>0.8</RM_Noolim>
      <RM_Loohn>0.01</RM_Loohn>
      <RM_Weloon>0.4</RM_Weloon>
      <RM_Lunoowa>0.3</RM_Lunoowa>
      <!-- SEA_FISHABLES_ALIVE_IN_DEPTHS_1 (2026-10-03): the ten catches' living bodies,
           RM_TwilightSeaFloorLife.xml; weights PROVISIONAL, scaled off each catch's fishTypes weight. -->
      <RM_Niim>1.0</RM_Niim>
      <RM_Pallu>0.6</RM_Pallu>
      <RM_Tikkarr>0.4</RM_Tikkarr>
      <RM_Nuudal>0.5</RM_Nuudal>
      <RM_Aluun>0.4</RM_Aluun>
      <RM_Kellu>0.3</RM_Kellu>
      <RM_Murrol>0.4</RM_Murrol>
      <RM_Hollu>0.4</RM_Hollu>
      <!-- New creature from the hollu v2 render (owner, Twilight Sea sheet 2026-10-07). -->
      <RM_DancingSkresh>0.3</RM_DancingSkresh>
      <RM_Oobo>0.15</RM_Oobo>
      <RM_Liiru>0.3</RM_Liiru>
    </wildAnimals>
    <animalDensity>0.1</animalDensity>
    <coastalWildAnimals />

    <!-- TERMINAL_SEAS_FLOOR_DRESSING_1, 2026-09-26. plantDensity WAS UNSET
         (0f) and this biome shipped no <wildPlants> at all until this pass.
         See RM_TwilightSeaFlora.xml's header for the blade's judgement call
         (shared with the Grey's). The mat-roof row that used to stand here
         (`RM_MoldMatRoof`) is RETIRED, not renamed — TWILIGHT_PANE_STRIKE_1,
         2026-09-27: the ceiling organism is a shed-panel event/item
         (RM_VeilFallIncoming/RM_VeilPane), never a floor plant. -->
    <plantDensity>0.5</plantDensity>
    <wildPlants>
      <!-- RM_SaltBladeTwilight moved to the Grey Sea (owner, Twilight Sea sheet 2026-10-07). -->
      <!-- TWILIGHT_LIGHT_ECONOMY_1 §3.1: the two cultivated-light inputs,
           findable wild before a player ever builds a cage grower for them
           (RM_TwilightLightPlants.xml). -->
      <RM_HoolimbrePlant>0.15</RM_HoolimbrePlant>
      <RM_NoothelmPlant>0.05</RM_NoothelmPlant>
      <!-- TWILIGHTSEA_FLORA_PASS_1 (2026-10-08): the understorey, Route A rows
           (RM_TwilightUnderstorey.xml). plantDensity 0.2 -> 0.5, ruled lusher
           2026-09-27. Route B species (Tithemoss, Tollhorn, Gleamfloss, Farwick)
           are deliberately NOT here: they need the dressing genstep. Weircomb is
           terrain-gated on RM_BankSilt (dead letter until that terrain exists). -->
      <RM_Almslight>0.8</RM_Almslight>
      <RM_Weircomb>0.7</RM_Weircomb>
      <RM_Murkspindle>0.6</RM_Murkspindle>
      <RM_Gloamurn>0.5</RM_Gloamurn>
      <RM_Glimmerhusk>0.35</RM_Glimmerhusk>
      <RM_Hushcoral>0.3</RM_Hushcoral>
    </wildPlants>

    <wildAnimalsCanWanderInto>false</wildAnimalsCanWanderInto>
    <baseWeatherCommonalities>
      <Clear>12</Clear>
      <Fog>7</Fog>
      <Rain>4</Rain>
    </baseWeatherCommonalities>
    <!-- SEA_FLOOR_SINGLE_BAND_1, 2026-09-30: same single-band defect
         SCALD_CROWNCARPET_NO_HABITAT_1 fixed on RM_TheScald.xml (ca774b8b9).
         Split into two bands, deep-first (order matters, first match wins).

         🔴 Unlike the Grey Sea (RM_WaterBrineDeep/Shallow) and the Chill
         (RM_TheChillDeep/RM_SolidPropane), the Twilight Sea has NO
         bespoke deep/shallow TerrainDef pair anywhere under src/ — its
         RM_SeaShoreExtension above is a bare, field-less
         `<li Class="..." />` (no deepTerrain/shallowTerrain/beachTerrain
         set), and there is no RM_TwilightSea*Terrains.xml. Per this item's
         own instruction ("if a sea has no shallow variant, report it
         rather than borrowing another sea's"): this stays on vanilla
         WaterOceanDeep/WaterOceanShallow — the shared baseline every sea
         falls back to with nothing of its own, not a borrow of the Grey's
         brine or the Chill's propane. None of the Twilight's
         wildPlants rows (RM_HoolimbrePlant, RM_NoothelmPlant —
         RM_TwilightLightPlants.xml) carries a
         wildTerrainTags at all, so this split unblocks no currently-blocked
         roster row here either; it only corrects the structural defect. -->
    <terrainsByFertility>
      <li>
        <terrain>WaterOceanDeep</terrain>
        <min>-999</min>
        <max>0.6</max>
      </li>
      <li>
        <terrain>WaterOceanShallow</terrain>
        <min>0.6</min>
        <max>999</max>
      </li>
    </terrainsByFertility>

    <!-- FOLDED IN from Patches/BiomeFishTypes_TwilightDeep.xml (10 species,
         hold lifted 2026-09-20: "Just make the surface fishable.").
         terminal_seas_cast_proposal_2026-09-25.md, the Twilight Sea section:
         noolim/weloon ADDED as two more rows (see RM_TwilightSeaCatch.xml's
         own header). -->
    <maxFishPopulation>700</maxFishPopulation>
    <fishTypes MayRequire="Ludeon.RimWorld.Odyssey">
      <saltwater_Common>
        <RM_NiimCatch>1.5</RM_NiimCatch>
        <RM_PalluCatch>1</RM_PalluCatch>
        <RM_TikkarrCatch>0.8</RM_TikkarrCatch>
        <RM_NuudalCatch>0.6</RM_NuudalCatch>
        <RM_AluunCatch>0.6</RM_AluunCatch>
        <RM_NoolimCatch>0.8</RM_NoolimCatch>
      </saltwater_Common>
      <saltwater_Uncommon>
        <RM_KelluCatch>1</RM_KelluCatch>
        <RM_MurrolCatch>0.8</RM_MurrolCatch>
        <RM_HolluCatch>0.8</RM_HolluCatch>
        <RM_OoboCatch>0.4</RM_OoboCatch>
        <RM_LiiruCatch>0.5</RM_LiiruCatch>
        <RM_WeloonCatch>0.4</RM_WeloonCatch>
      </saltwater_Uncommon>
      <rareCatchesSetMaker>RM_RareTwilightCatches</rareCatchesSetMaker>
    </fishTypes>
  </BiomeDef>

</Defs>
