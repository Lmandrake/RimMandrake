<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  RM_TheScald.xml                        TerminalBiomes · moved 2026-09-25
  ============================================================================
  TERMINALBIOMES_RM_MOD_BUILD_1 step 2. Content copied as-is from
  src/RimUtinni/UtinniPatches/Defs/BiomeDefs/RUT_TheScald.xml (now frozen,
  same folder) at the moment of the move — see that file's own header for
  the full authorship history (LIQUID_BIOMES_MAP_1, FISH_BESTIARY_BUILD_1,
  SEA_FLOOR_AND_CATCH_PASS_1, GRAVTIDE SUPPORT, ECOSYSTEM_PYRAMID_LAW_1) and
  this file's own frozen twin for the "carrying the world" note.

  Four `RSW_` wildAnimals rows originally shipped only via a Utinni-tier
  patch (Star Wars creatures never the RimMandrake def, item §3/§6,
  criteria): RSW_SandoAquaMonster, RSW_ElderSando, RSW_Faa, RSW_Mee. Of
  those, SEA_BEASTS_TIER_RULING_1 found RSW_ElderSando is one of the 11
  INVENTED sea beasts (verified 2026-09-25, no Wookieepedia canon hit) —
  it now ships inline below as `RM_ElderSando` (RM_SeaBeasts_Invented.xml,
  same mod, no MayRequire). The three genuine canon rows
  (RSW_SandoAquaMonster/RSW_Faa/RSW_Mee) still land on THIS defName via
  src/RimUtinni/UtinniPatches/Patches/WildAnimals_TheScald.xml,
  MayRequire="mandrake.rsw.swbestiary", so a franchise-free install of this
  mod still gets a real biome (terrain, weather, fishing, welcome-blanket
  flora, and now the elder sando too) — only the three genuine Star Wars
  residents are absent. Everything else below — terrain, weather, fishTypes,
  wildPlants, GravTide support — is byte-identical content, this mod's own
  tier.
  ============================================================================
-->
<Defs>

  <BiomeDef>
    <defName>RM_TheScald</defName>
    <label>the Scald</label>
    <description>A perched ocean in the world's hottest basin, held in a vast crater by the ring of mountains that feed it. It boils where it is shallow and simmers where it is deep, and it spills outward through every river that nourishes the world.</description>
    <workerClass>BiomeWorker_Ocean</workerClass>
    <isWaterBiome>true</isWaterBiome>
    <canBuildBase>false</canBuildBase>
    <allowRoads>true</allowRoads>
    <allowRivers>false</allowRivers>
    <hasVirtualPlants>false</hasVirtualPlants>
    <texture>World/Biomes/Ocean</texture>
    <impassable>true</impassable>
    <isBackgroundBiome>true</isBackgroundBiome>
    <waterShallowTerrain>RUT_ScaldWaterShallow</waterShallowTerrain>
    <waterDeepTerrain>RUT_ScaldWaterDeep</waterDeepTerrain>
    <waterMovingShallowTerrain>RUT_ScaldWaterMovingShallow</waterMovingShallowTerrain>
    <waterMovingChestDeepTerrain>RUT_ScaldWaterMovingChestDeep</waterMovingChestDeepTerrain>

    <!-- SEA_FLOOR_AND_CATCH_PASS_1: makes the land tiles around the Scald read
         as coastal and cut a real shore, with the Scald's own water. -->
    <modExtensions>
      <li Class="RimMandrake.SeaShores.RM_SeaShoreExtension">
        <deepTerrain>RUT_ScaldWaterOceanDeep</deepTerrain>
        <shallowTerrain>RUT_ScaldWaterOceanShallow</shallowTerrain>
      </li>
      <!-- SOLAR_HEAT_EXPOSURE_1: sun heat kind "ambient" - the Scald: the_scald.md "A crater sea that boils. Volcanic heat rises under it".
           heatOffsetC is an invented first value; the owner-watched sitting tunes it. -->
      <li Class="RimMandrake.CreatureBehaviors.RM_SunHeatExtension" MayRequire="mandrake.rm.creaturebehaviors">
        <heatKind>ambient</heatKind>
        <heatOffsetC>15</heatOffsetC>
      </li>
    </modExtensions>

    <!-- Genuine canon Star Wars residents (sando aqua monster, faa, mee) ride
         WildAnimals_TheScald.xml (UtinniPatches), MayRequire
         mandrake.rsw.swbestiary — item §3/§6. The invented elder sando ships
         inline here instead (SEA_BEASTS_TIER_RULING_1).
         TERMINALBIOMES_RM_MOD_BUILD_1 / terminal_seas_cast_proposal_2026-09-25.md
         verdict 1: the two ruled floor residents (RM_ScaldFauna.xml). -->
    <!-- SEA_FISHABLES_ALIVE_IN_DEPTHS_1, 2026-09-26 (owner ruling: every
         fishable owes a living creature swimming the depths, in EVERY sea):
         the seven catch-only species below now live here too, authored from
         their own catch items' descriptions in RM_ScaldFloorFauna.xml. With
         them the Scald's nine fishTypes entries have nine living residents
         and the roster's food pyramid inverts the right way up
         (ECOSYSTEM_PYRAMID_LAW_1 measured this roster at 0.0% small on
         2026-09-20, when it held two animals; every species added here is
         baseBodySize 0.05-0.3, far under the law's 1.0 line).
         ⚠️ Shorthand form only: BiomeAnimalRecord has a custom loader that
         reads the node NAME as the animal and the node TEXT as the
         commonality. An <li> wrapper here silently discards the whole
         roster. -->
    <wildAnimals>
      <RM_ElderSando>0.005</RM_ElderSando>
      <RM_Noohm>0.4</RM_Noohm>
      <RM_Shulla>0.9</RM_Shulla>
      <RM_Eesh>1.2</RM_Eesh>
      <RM_Doss>1.0</RM_Doss>
      <RM_Muddal>0.7</RM_Muddal>
      <RM_Bladderboil>0.6</RM_Bladderboil>
      <RM_Thuum>0.5</RM_Thuum>
      <RM_Karrash>0.45</RM_Karrash>
      <RM_Ekkel>0.3</RM_Ekkel>
    </wildAnimals>
    <animalDensity>0.15</animalDensity>
    <coastalWildAnimals />

    <!-- RM_Crowncarpet (DEEPFIRE_PIGMENT_MOD_1: moved again, this time to the
         LuminousPigment mod — RM_WelcomeBlanket renamed RM_Crowncarpet,
         mandrake.rm.luminouspigment now required — spec §2.1), gated on its
         own wildTerrainTags: [RUT_ScaldMarginMat], a tag that exists on
         exactly one terrain (RUT_ScaldMargin), already in this mod. -->
    <wildPlants>
      <RM_Crowncarpet>0.4</RM_Crowncarpet>
    </wildPlants>

    <!-- FISH_BESTIARY_BUILD_1 / SEA_FLOOR_AND_CATCH_PASS_1 — the margin
         harvest, eight species + rareCatchesSetMaker, all moved with this def.
         terminal_seas_cast_proposal_2026-09-25.md §"The Scald — gap check":
         shulla ADDED as a ninth (see RM_ScaldCatch.xml's own header). -->
    <maxFishPopulation>40</maxFishPopulation>
    <fishTypes MayRequire="Ludeon.RimWorld.Odyssey">
      <freshwater_Common>
        <RM_EeshCatch>1.5</RM_EeshCatch>
        <RM_MuddalCatch>0.8</RM_MuddalCatch>
        <RM_DossCatch>0.7</RM_DossCatch>
        <RM_ThuumCatch>0.5</RM_ThuumCatch>
        <RM_ShullaCatch>0.6</RM_ShullaCatch>
      </freshwater_Common>
      <freshwater_Uncommon>
        <RM_KarrashCatch>1</RM_KarrashCatch>
        <RM_Saal>0.5</RM_Saal>
        <RM_BladderboilCatch>0.5</RM_BladderboilCatch>
        <RM_EkkelCatch>0.4</RM_EkkelCatch>
      </freshwater_Uncommon>
      <rareCatchesSetMaker>RM_RareScaldCatches</rareCatchesSetMaker>
    </fishTypes>

    <!-- GRAVTIDE SUPPORT (UNDERWATER_BIOME_SUPPORT_1) — the three fields a
         modded water biome needs that GravTide otherwise only patches onto
         vanilla Ocean/Lake by defName. -->
    <wildAnimalsCanWanderInto>false</wildAnimalsCanWanderInto>
    <baseWeatherCommonalities>
      <Clear>14</Clear>
      <Fog>8</Fog>
    </baseWeatherCommonalities>
    <terrainsByFertility>
      <li>
        <terrain>RUT_ScaldWaterOceanDeep</terrain>
        <min>-999</min>
        <max>999</max>
      </li>
    </terrainsByFertility>
  </BiomeDef>

</Defs>
