<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  RM_TheChill.xml                     TerminalBiomes · moved 2026-09-25
  ============================================================================
  TERMINALBIOMES_RM_MOD_BUILD_1 step 2. Content copied as-is from
  src/RimUtinni/UtinniPatches/Defs/BiomeDefs/RUT_PropaneLake.xml (now frozen,
  same folder) — see that file's own header for the full authorship history.

  🔴 ONE substantive change: `waterDeepTerrain`/`waterShallowTerrain`/
  `terrainsByFertility` are repointed off the donor Alpha Biomes terrains
  (`AB_PropaneLake`/`AB_SolidPropane`, neither defined anywhere under src/)
  onto this mod's own `RM_TheChillDeep`/`RM_SolidPropane`
  (Defs/TerrainDefs/RM_TheChillTerrains.xml, this pass) — a donor
  TerrainDef in these fields is exactly the hard dependency the RimMandrake
  tier may not assume (item §2/§5 step 2). No other field changes: no
  wildAnimals row here is `RSW_`/`SW_` (AA_AuroraSylph/AA_Skyeel are Alpha
  Animals; RM_Vaunoom is this mod's own creature, the 2026-09-25-ruled name
  for the V-wake role), so all three stay on this def, and fishTypes/description/weather/GravTide-support fields are
  byte-identical to the twin.

  texture: `World/Biomes/Jawa_SickWater` is this mod's OWN texture (was
  already authored under UtinniPatches/Textures, not a donor asset) — moved
  alongside this def to Textures/World/Biomes/Jawa_SickWater.png, no
  placeholder needed.
  ============================================================================
-->
<Defs>

  <BiomeDef>
    <defName>RM_TheChill</defName>
    <label>the Chill</label>
    <description>A black mirror of liquid fuel under the brightest sky on the planet, ringed by a crust of the same compound frozen solid. The cold here is total, and the stillness is older than anyone's records.</description>
    <workerClass>BiomeWorker_Ocean</workerClass>
    <isWaterBiome>true</isWaterBiome>
    <canBuildBase>false</canBuildBase>
    <allowRoads>true</allowRoads>
    <allowRivers>false</allowRivers>
    <hasVirtualPlants>false</hasVirtualPlants>
    <texture>World/Biomes/Jawa_SickWater</texture>
    <impassable>true</impassable>
    <isBackgroundBiome>true</isBackgroundBiome>
    <waterDeepTerrain>RM_TheChillDeep</waterDeepTerrain>
    <waterShallowTerrain>RM_SolidPropane</waterShallowTerrain>

    <!-- SEA_FLOOR_AND_CATCH_PASS_1 — the shore terrains are FlowWorks' own
         propane suite (mandrake.rm.flowworks), unchanged by this move. -->
    <modExtensions>
      <li Class="RimMandrake.SeaShores.RM_SeaShoreExtension">
        <deepTerrain>RM_PropaneDeep</deepTerrain>
        <shallowTerrain>RM_PropaneShallow</shallowTerrain>
      </li>
    </modExtensions>

    <!-- CHILL_FLOOR_CAST_TRIM_1 (sitting 2026-10-02 Q1a): the floor is its own
         strange solvent-world. The hoolen and vaunoom (surface animals) and the
         two Alpha Animals borrowings (AuroraSylph, Skyeel) are OFF this roster;
         they wait for a surface home at the surface sitting. Their ThingDefs
         (RM_TheChillFauna.xml) stay. The living zhiil body is
         RM_Zhiil (CHILL_ZHIIL_FLOOR_BODY_1). Heemin/oovanam: lake residents from
         RM_TheChillFauna.xml. -->
    <wildAnimals>
      <RM_Heemin>0.7</RM_Heemin>
      <RM_Oovanam>0.3</RM_Oovanam>
      <!-- SEA_FISHABLES_ALIVE_IN_DEPTHS_1, 2026-09-26. The six remaining
           catch-only rows in <fishTypes> below (RUT_Fessu, RUT_Krellik,
           RUT_Oddu, RUT_Oovu, RUT_Iliss, RUT_Tarnn) now have living
           counterparts, authored from those items' own descriptions.
           RM_Zhiil is its floor body (CHILL_ZHIIL_FLOOR_BODY_1).
           Defs: RM_TheChillFloorLife.xml.
           ⚠️ Shorthand form only — an <li> wrapper here silently discards
           the whole entry (BiomeAnimalRecord's custom loader). -->
      <RM_Fessu>0.55</RM_Fessu>
      <RM_Krellik>0.5</RM_Krellik>
      <RM_Oddu>0.45</RM_Oddu>
      <RM_Oovu>0.4</RM_Oovu>
      <RM_Iliss>0.3</RM_Iliss>
      <RM_Tarnn>0.2</RM_Tarnn>
      <!-- CHILL_ZHIIL_FLOOR_BODY_1 (Q3a): the zhiil's own floor body. -->
      <RM_Zhiil>0.25</RM_Zhiil>
      <!-- CHILL_WAX_PROCESSION_GIANT_1: the floor's giant (Q4b), a slow file. -->
      <RM_Hesuun>0.12</RM_Hesuun>
      <RM_Ulkhoss>0.08</RM_Ulkhoss>  <!-- ulkhoss: the kept bluedesert_Vapaad_v2 render, moved here by the owner 2026-10-04 (PROPANE_LAKE_HYDROCARBON_TENTACLER_1) -->
    </wildAnimals>
    <!-- PROPANELAKE_ANIMALDENSITY_ZERO_1, 2026-09-26 — animalDensity was UNSET (engine
         default 0f), so WildAnimalSpawner.DesiredTotalAnimalWeight was 0 and the six
         animals above could never spawn, at map-gen or ever (MEASURED from the
         decompiled engine). 0.08 — a hair below the Grey Sea's 0.1 and the sparsest of
         the four seas, matching the fiction: a black mirror of frozen liquid fuel,
         "the stillness is older than anyone's records." -->
    <animalDensity>0.08</animalDensity>
    <coastalWildAnimals />

    <!-- CHILL_FLORA_BUILD_1, 2026-09-28 — the same unset-field trap
         PROPANELAKE_ANIMALDENSITY_ZERO_1 found on animalDensity applies
         verbatim to plantDensity: left unset it defaults to 0f and the ten
         RM_TheChillFlora.xml rows below could never spawn. 0.18 is RULED
         (Q1, design/Jawa/worldbuilding/biomes/the_propane_lake_flora_pass_2026-09-27.md
         §"plantDensity and the unset-field trap") — a hair above the Grey
         Sea's animalDensity-relative position, sparser than any dayside
         biome, matching the floor's own register of stillness. -->
    <plantDensity>0.18</plantDensity>
    <wildPlants>
      <!-- Shorthand form only, per the same BiomeAnimalRecord/custom-loader
           trap wildAnimals already carries above — an <li> wrapper here
           silently discards the row. -->
      <RM_Slackwax>0.9</RM_Slackwax>
      <RM_Skyharp>0.8</RM_Skyharp>
      <RM_Ghostpane>0.7</RM_Ghostpane>
      <RM_Pitchpearl>0.7</RM_Pitchpearl>
      <RM_Keelgrass>0.6</RM_Keelgrass>
      <RM_Tarspool>0.6</RM_Tarspool>
      <RM_Stonewater>0.4</RM_Stonewater>
      <!-- RM_ChillStillbloom, not bare RM_Stillbloom — that defName
           collides with RM_GreySeaUnderstorey.xml's own plant, see
           RM_TheChillFlora.xml's def comment. -->
      <RM_ChillStillbloom>0.35</RM_ChillStillbloom>
      <RM_Fuselight>0.3</RM_Fuselight>
      <RM_Eldspar>0.25</RM_Eldspar>
    </wildPlants>

    <wildAnimalsCanWanderInto>false</wildAnimalsCanWanderInto>
    <baseWeatherCommonalities>
      <Clear>14</Clear>
      <Fog>6</Fog>
    </baseWeatherCommonalities>
    <!-- SEA_FLOOR_SINGLE_BAND_1, 2026-09-30: the same single-band defect
         SCALD_CROWNCARPET_NO_HABITAT_1 found and fixed on RM_TheScald.xml
         (ca774b8b9) — the one band below gave every non-rock cell
         RM_TheChillDeep unconditionally, so RM_SolidPropane (this def's own
         waterShallowTerrain, RM_TheChillTerrains.xml) could never be
         selected by MapGenUtility.TerrainFrom(). Two bands now, deep-first.

         🔴 Splitting the band ALONE does not unblock the ten-species Chill
         flora roster below (wildTerrainTags RM_TheChillBed/RM_TheChillShelf,
         per RM_TheChillFlora.xml's own header). Those two tags previously
         existed ONLY on FlowWorks' RM_PropaneDeep/RM_PropaneShallow
         (RM_Propane.xml, CHILL_FLORA_BUILD_1's own manual-patch comment) —
         this def's OWN RM_TheChillDeep/RM_SolidPropane (the terrain this
         terrainsByFertility split actually selects) carried no such tags at
         all. Added here too (RM_TheChillTerrains.xml, this same commit) so
         the habitat tag actually sits on the terrain this band split picks. -->
    <terrainsByFertility>
      <li>
        <terrain>RM_TheChillDeep</terrain>
        <min>-999</min>
        <max>0.6</max>
      </li>
      <li>
        <terrain>RM_SolidPropane</terrain>
        <min>0.6</min>
        <max>999</max>
      </li>
    </terrainsByFertility>

    <!-- SEA_FLOOR_AND_CATCH_PASS_1 — the Chill's catch table.
         terminal_seas_cast_proposal_2026-09-25.md verdict 3: heemin/oovanam
         ADDED here (see RM_TheChillCatch.xml's own header). CHILL_FREE_TIER_CATCH_1
         (2026-10-03): all nine rows are free-tier RM_*Catch, no MayRequire. -->
    <maxFishPopulation>60</maxFishPopulation>
    <fishTypes MayRequire="Ludeon.RimWorld.Odyssey">
      <saltwater_Common>
        <RM_FessuCatch>1.2</RM_FessuCatch>
        <RM_KrellikCatch>1</RM_KrellikCatch>
        <RM_OdduCatch>0.8</RM_OdduCatch>
        <RM_OovuCatch>0.6</RM_OovuCatch>
        <RM_HeeminCatch>0.9</RM_HeeminCatch>
      </saltwater_Common>
      <saltwater_Uncommon>
        <RM_IlissCatch>1</RM_IlissCatch>
        <RM_TarnnCatch>0.6</RM_TarnnCatch>
        <RM_ZhiilCatch>0.4</RM_ZhiilCatch>
        <RM_OovanamCatch>0.4</RM_OovanamCatch>
      </saltwater_Uncommon>
      <rareCatchesSetMaker>RM_RareChillCatches</rareCatchesSetMaker>
    </fishTypes>
  </BiomeDef>

</Defs>
