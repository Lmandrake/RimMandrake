<?xml version="1.0" encoding="utf-8"?>
<!--
  SEA_FLOOR_AND_CATCH_PASS_1 — the Propane Lake's rare-catch pool, per
  design/Jawa/worldbuilding/sea_catch_rosters_2026-09-24.md's rare-catch
  table. Parented on vanilla's own RareFishingCatchesBase, same shape as
  RM_RareScaldCatches/RM_RareTwilightCatches/RUT_RareGreyCatches.

  Three options: weight 4 Chemfuel x10-20 ("a sac of pooled fuel, frozen
  round the line" — the tank's own catch, vanilla def); weight 2
  RUT_AuroraGlass x1 (🔴 not kyber, carries no lightsaber property, never
  will — ban 2, the_propane_lakes.md); weight 1 RUT_Oddu x4-6 ("a good
  evening's worth").
-->
<Defs>

  <ThingSetMakerDef ParentName="RareFishingCatchesBase">
    <defName>RUT_RarePropaneCatches</defName>
    <root Class="ThingSetMaker_RandomOption">
      <options>
        <li>
          <weight>4</weight>
          <thingSetMaker Class="ThingSetMaker_StackCount">
            <fixedParams>
              <filter>
                <thingDefs>
                  <li>Chemfuel</li>
                </thingDefs>
              </filter>
              <countRange>10~20</countRange>
            </fixedParams>
          </thingSetMaker>
        </li>
        <li>
          <weight>2</weight>
          <thingSetMaker Class="ThingSetMaker_StackCount">
            <fixedParams>
              <filter>
                <thingDefs>
                  <li MayRequire="mandrake.rut.patches">RUT_AuroraGlass</li>
                </thingDefs>
              </filter>
              <countRange>1~1</countRange>
            </fixedParams>
          </thingSetMaker>
        </li>
        <li>
          <weight>1</weight>
          <thingSetMaker Class="ThingSetMaker_StackCount">
            <fixedParams>
              <filter>
                <thingDefs>
                  <li MayRequire="mandrake.rut.patches">RUT_Oddu</li>
                </thingDefs>
              </filter>
              <countRange>4~6</countRange>
            </fixedParams>
          </thingSetMaker>
        </li>
      </options>
    </root>
  </ThingSetMakerDef>

</Defs>
