<?xml version="1.0" encoding="utf-8"?>
<!--
  TWILIGHTSEA_FLORA_PASS_1: registers RM_TwilightFloraDressing on both Twilight floor generators
  (mandrake.rm.divinginteraction). Conditional, so a missing generator skips silently. The step
  itself also refuses any map that is not a Twilight floor.
-->
<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/MapGeneratorDef[defName="RM_SeaDiveGenerator_TwilightSea"]/genSteps</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/MapGeneratorDef[defName="RM_SeaDiveGenerator_TwilightSea"]/genSteps</xpath>
      <value>
        <li>RM_TwilightFloraDressing</li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/MapGeneratorDef[defName="RM_SeabedGenerator_TwilightSea"]/genSteps</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/MapGeneratorDef[defName="RM_SeabedGenerator_TwilightSea"]/genSteps</xpath>
      <value>
        <li>RM_TwilightFloraDressing</li>
      </value>
    </match>
  </Operation>
</Patch>
