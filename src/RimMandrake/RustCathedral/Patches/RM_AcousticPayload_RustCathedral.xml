<?xml version="1.0" encoding="utf-8"?>
<!--
  GRAVSHIP_ACOUSTIC_SCANNER_1: the acoustic-scanner payload for RM_RustCathedral.
  Owner decision by question card 2026-10-06: the payload goes on EVERY biome of ours.

  Pure XML, FindMod-guarded on "RimMandrake: Acoustic Scanner", so the extension class
  is only named while its assembly is active. Every def is a defName STRING resolved
  at pulse time (GetNamedSilentFail), so a target naming another mod's def just hears
  nothing when that mod is absent. Each target is drawn from this biome's own content;
  the biome's sitting may re-author it. The reading is always banded by the scanner.
-->
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>RimMandrake: Acoustic Scanner</li>
    </mods>
    <match Class="PatchOperationAddModExtension">
      <xpath>/Defs/BiomeDef[defName="RM_RustCathedral"]</xpath>
      <value>
        <li Class="RimMandrake.AcousticScanner.RM_AcousticPayloadExtension">
          <quietText>Deck plate under deck plate, ringing the same note forever.</quietText>
          <targets>
            <li>
              <label>dead smartsteel</label>
              <reading>A patterned ring inside the plate, as if the metal were still trying to answer.</reading>
              <color>(0.75, 0.85, 1)</color>
              <weight>2</weight>
              <thingDefs>
                <li>RM_MineableDeadSmartsteel</li>
              </thingDefs>
            </li>
            <li>
              <label>sacred conduit</label>
              <reading>A wall that hums back at you, just slightly out of tune with the pulse.</reading>
              <color>(1, 0.85, 0.4)</color>
              <weight>2</weight>
              <thingDefs>
                <li>RM_SacredWall_Conduit</li>
              </thingDefs>
            </li>
            <li>
              <label>something living in the metal</label>
              <reading>A small clicking echo moving along the inside of a wall.</reading>
              <color>(1, 0.45, 0.35)</color>
              <pawnRaces>
                <li>RM_LivingBolt</li>
              </pawnRaces>
            </li>
            <li>
              <label>void in the deck</label>
              <reading>The pulse falls into an empty chamber below the deck plate.</reading>
              <color>(0.6, 0.6, 0.9)</color>
              <hiddenCaves>true</hiddenCaves>
              <cellSampleStride>4</cellSampleStride>
            </li>
          </targets>
        </li>
      </value>
    </match>
  </Operation>
</Patch>
