      <li>
        <grains>
          <li Class="AudioGrain_Folder">
            <clipFolderPath>Impact/DrillArm_Hit</clipFolderPath>
          </li>
        </grains>
        <volumeRange>30</volumeRange>
        <pitchRange>0.45~0.6</pitchRange>
      </li>
    </subSounds>
  </SoundDef>
</Defs>
