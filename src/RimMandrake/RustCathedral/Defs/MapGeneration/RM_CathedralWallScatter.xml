<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- RUST_CATHEDRAL_MECHANICS_1 §2. GenStep_ScatterCathedralWallTiers
       self-gates to RM_RustCathedral (same convention as
       FungalSoilTrade's GenStep_ScatterFungalGround and LanternDeeps'
       GenStep_ScatterCavePortal), so adding it to the shared base generator
       (../../Patches/RUT_CathedralWallScatter_MapGenPatch.xml) is safe: it
       no-ops on every other biome's maps.

       Two groups, two densities, matching the "endless bulk vs. distinctly
       valuable seam" player experience: Tier 1 (deck plate) is common,
       Tier 2 (dead smartsteel) is a fraction of that. Both are placeholder
       density pending the owner's actual call, same status LanternDeeps'
       own chancePerMap and FungalSoilTrade's own coveredCellsPer10Cells
       carry. -->

  <GenStepDef>
    <defName>RM_CathedralWallScatter</defName>
    <order>321</order>
    <genStep Class="RimMandrake.RustCathedral.Walls.GenStep_ScatterCathedralWallTiers">
      <minSpacing>10</minSpacing>
      <!-- GenStep_Scatterer: no count/countPer10kCellsRange = zero scatters, silently. Placeholder density. -->
      <countPer10kCellsRange>2~4</countPer10kCellsRange>
      <groups>
        <li>
          <things>
            <RM_CathedralDeckPlate>1</RM_CathedralDeckPlate>
          </things>
          <coveredCellsPer10Cells>0.3~0.6</coveredCellsPer10Cells>
          <clusterRectRadius>2~4</clusterRectRadius>
        </li>
        <li>
          <things>
            <RM_MineableDeadSmartsteel>1</RM_MineableDeadSmartsteel>
          </things>
          <!-- SCATTER_AUDIT_DENSITY_TRUNCATES_ZERO: 0.02~0.05 covered (int)(25/10 * 0.05) = 0 cells even
               at r2, so tier 2 never placed. Rarity now comes from the group weight (about 1 cluster in 4
               is tier 2) and the seam is small: 1.2~2.0 covers 1 cell at r1, 3-5 at r2.
               Placeholder, kept modest. -->
          <weight>0.3</weight>
          <coveredCellsPer10Cells>1.2~2.0</coveredCellsPer10Cells>
          <clusterRectRadius>1~2</clusterRectRadius>
        </li>
      </groups>
      <validators>
        <li Class="ScattererValidator_Buildable">
          <affordance>Heavy</affordance>
        </li>
        <li Class="ScattererValidator_NoNonNaturalEdifices" />
      </validators>
    </genStep>
  </GenStepDef>

</Defs>
