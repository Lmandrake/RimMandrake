<?xml version="1.0" encoding="utf-8"?>
<!--
  RUSTCATHEDRAL_RM_MOD_BUILD_1 step 2. The frozen RUT_RustCathedral.xml
  borrowed two Alpha Biomes donor TerrainDefs outright (AB_SoilOnCrackedMetal
  for lakeBeachTerrain/mudTerrain/riverbankTerrain, GU_MetalFloor1 for its
  sole terrainsByFertility row) — a donor DEF is a hard dependency the
  RimMandrake tier may not assume (the def could vanish if Alpha Biomes ever
  changes that defName). These two OWN TerrainDefs remove that def
  dependency: no ParentName chain into an Alpha Biomes def, own defNames.

  TEXTURE ORIGIN: both texturePaths point at pixels copied from Alpha Biomes
  (Terrain/Surfaces/AB_SoilOnCrackedMetal, Terrain/Surfaces/AB_Polymer) into this
  mod's own Textures/ folder, so Alpha Biomes (retired from the mod list) is NOT
  a dependency of this mod. No art pipeline pass has run for this biome's floor
  yet; a future pass can generate its own floor art (only texturePath moves).

  Field values (edgeType/renderPrecedence/statBases/affordances/fertility)
  copied from the donor def (same source file) since this mod's own biome
  ships identical gameplay behavior for its floor, only the ownership of the
  def changes.
-->
<Defs>

  <TerrainDef ParentName="NaturalTerrainBase">
    <defName>RM_RustCathedral_CrackedMetalSoil</defName>
    <label>soil on cracked metal</label>
    <texturePath>Terrain/Surfaces/AB_SoilOnCrackedMetal</texturePath>
    <color>(100,100,100)</color>
    <edgeType>FadeRough</edgeType>
    <renderPrecedence>350</renderPrecedence>
    <statBases>
      <Beauty>-3</Beauty>
      <BeautyOutdoors>0</BeautyOutdoors>
      <Cleanliness>-1</Cleanliness>
    </statBases>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>GrowSoil</li>
      <li>Diggable</li>
    </affordances>
    <fertility>0.45</fertility>
    <takeFootprints>false</takeFootprints>
    <tags>
      <li>Soil</li>
    </tags>
  </TerrainDef>

  <TerrainDef ParentName="NaturalTerrainBase">
    <defName>RM_RustCathedral_PolymerFloor</defName>
    <label>polymer flooring</label>
    <texturePath>StandIn/Terrain/Surfaces/AB_Polymer</texturePath>
    <pollutedTexturePath>StandIn/Terrain/Surfaces/AB_Polymer_Polluted</pollutedTexturePath>
    <pollutionOverlayTexturePath>Terrain/Surfaces/PollutionFloorSmooth</pollutionOverlayTexturePath>
    <pollutionColor>(1, 1, 1, 0.1)</pollutionColor>
    <edgeType>FadeRough</edgeType>
    <renderPrecedence>350</renderPrecedence>
    <statBases>
      <Beauty>-1</Beauty>
      <BeautyOutdoors>0</BeautyOutdoors>
      <Cleanliness>-1</Cleanliness>
    </statBases>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
    </affordances>
    <fertility>0</fertility>
    <takeFootprints>false</takeFootprints>
  </TerrainDef>

</Defs>
