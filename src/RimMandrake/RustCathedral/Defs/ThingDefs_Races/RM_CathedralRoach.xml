  <ThingDef ParentName="BaseMechanoidWalker">
    <defName>RM_CathedralRoach</defName>
    <label>cathedral roach</label>
    <description>A small mechanoid, roach-shaped down to the twitch of its antennae, that patrols the deck plate in and near the Rust Cathedral clearing filth and scrap-waste from the ground nothing else tends. It looks fragile. It is not: strip its plating and it keeps walking, keeps cleaning, patient past any reasonable point — small, quiet, and far harder to put down than its size suggests.</description>
    <statBases>
      <ArmorRating_Blunt>0.75</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.75</ArmorRating_Sharp>
      <StaggerDurationFactor>0</StaggerDurationFactor>
      <MoveSpeed>4.2</MoveSpeed>
      <BandwidthCost>3</BandwidthCost>
      <MarketValue>90</MarketValue>
    </statBases>
    <uiIconScale>0.55</uiIconScale>
    <tools>
      <li>
        <label>mandibles</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>6</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
      </li>
    </tools>
    <race>
      <body>RM_RoachHex</body>
      <baseBodySize>0.22</baseBodySize>
      <baseHealthScale>1.6</baseHealthScale>
      <thinkTreeMain>RM_ThinkTree_CathedralRoach</thinkTreeMain>
      <lifeStageAges Inherit="False">
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_Mech_Scorcher_Wounded</soundWounded>
          <soundDeath>Pawn_Mech_Scorcher_Death</soundDeath>
          <soundCall>Pawn_Mech_Scorcher_Call</soundCall>
        </li>
      </lifeStageAges>
      <mechWeightClass>Light</mechWeightClass>
    </race>
    <butcherProducts>
      <Steel>4</Steel>
      <RM_CathedralRoachShell>1</RM_CathedralRoachShell>
    </butcherProducts>
    <modExtensions>
      <li Class="RimMandrake.CreatureBehaviors.RM_EatCleanableExtension">
        <cleanableThingDefNames>
          <li>Wastepack</li>
        </cleanableThingDefNames>
        <eatsFilth>true</eatsFilth>
        <searchRadius>25</searchRadius>
        <nutritionPerMeal>0</nutritionPerMeal>
        <eatDurationTicks>5000</eatDurationTicks>
        <seekChance>0.03</seekChance>
      </li>
    </modExtensions>
  </ThingDef>

  <PawnKindDef ParentName="BaseMechanoidKind">
