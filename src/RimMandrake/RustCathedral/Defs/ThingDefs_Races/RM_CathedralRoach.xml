    <label>cathedral roach</label>
    <labelPlural>cathedral roaches</labelPlural>
    <race>RM_CathedralRoach</race>
    <combatPower>60</combatPower>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/RM_CathedralRoach/RM_CathedralRoach</texPath>
          <shaderType>CutoutWithOverlay</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>0.55</drawSize>
        </bodyGraphicData>
        <corpseGraphicData>
          <texPath>Things/Pawn/Animal/RM_CathedralRoach/RM_CathedralRoachCorpse</texPath>
          <shaderType>CutoutWithOverlay</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>0.55</drawSize>
        </corpseGraphicData>
      </li>
    </lifeStages>
