<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cathedral hum-mood offline fuzz (Approach B, same shape as FlowWorks/GimmeSomeSlack/Bazaar). Plain net8.0, zero
    RimWorld/Unity references: ../Hum/RM_AttitudeKernel.cs is the PRODUCTION file the mod compiles, pulled in directly.
    Run (builds on Windows via winbuild staging, then runs the exe):
      python3 src/RimMandrake/Utils/selftest_rustcathedral_attitude_fuzz.py [fuzz knobs]
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RimMandrakeRustCathedralAttitude.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.RustCathedral.Hum.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Hum\RM_AttitudeKernel.cs" />
    <Compile Include="AttitudeFuzz.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
