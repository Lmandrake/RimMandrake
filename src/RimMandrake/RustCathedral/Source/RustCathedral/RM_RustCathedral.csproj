<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RUSTCATHEDRAL_RM_MOD_BUILD_1. Same recipe as
    src/RimMandrake/Miasma/Source/RM_Miasma.csproj — copy that header if
    this one goes stale.

    This is the THIRD assembly in mandrake.rm.rustcathedral (assembly-merge
    trade §6, option (b): Hum and Walls keep their own two DLLs unchanged;
    this project carries only what is genuinely NEW for the RM_ mod itself —
    the Mod Settings screen, the biome worker replacing the donor
    AlphaBiomes.BiomeWorker_MechanoidIntrusion, and the roach
    cleaning-toggle gate). References the other two DLLs (already built into
    ../../Assemblies/) to surface their settings screens from one Mod class
    — build Hum and Walls FIRST.

    NO HARMONY REFERENCE — nothing here patches an engine method.

    Build (dotnet is WINDOWS-NATIVE, cannot take a /mnt/d path), IN ORDER:
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\Rimworld\src\RimMandrake\RustCathedral\Source\Hum\RimMandrake.Utinni.RustCathedralHum.csproj -c Release
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\Rimworld\src\RimMandrake\RustCathedral\Source\Walls\RimMandrake.Utinni.RustCathedralWalls.csproj -c Release
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\Rimworld\src\RimMandrake\RustCathedral\Source\RustCathedral\RM_RustCathedral.csproj -c Release

    Output lands in ../../Assemblies/, which is where RimWorld looks.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrake.RustCathedral</AssemblyName>
    <RootNamespace>RimMandrake.RustCathedral</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="RM_RustCathedralMod.cs" />
    <Compile Include="RM_BiomeWorker_RustCathedral.cs" />
    <Compile Include="RM_ThinkNode_ConditionalRoachCleaningEnabled.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RimMandrake.Utinni.RustCathedralHum">
      <HintPath>..\..\Assemblies\RimMandrake.Utinni.RustCathedralHum.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RimMandrake.Utinni.RustCathedralWalls">
      <HintPath>..\..\Assemblies\RimMandrake.Utinni.RustCathedralWalls.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
