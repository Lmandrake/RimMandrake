<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  RUT_AncientAirlocks.xml                AssailantSalvage · CRYPTOFORGE_HARVEST_RETIRE_1 step 1
  ============================================================================
  Citation-swap replacements for 7 of the 22 salvage props donor-cited to
  Workshop mod "Vanilla Quests Expanded - Cryptoforge" (vanillaquestsexpanded.cryptoforge)
  in design/Jawa/art/SALVAGE_PALETTE.md. Owner ruling: retire-after-harvest —
  Workshop art is not ours to ship, so gameplay stats/function are carried
  over exactly, but defName, texPath and flavor text are entirely our own.
  Owned art is queued separately to the artpipe (does not exist yet; expected).
  Resolved flat (no shared abstract parent) against the donor's own
  VQE_CryptoForgeBuildingBase / VQE_CryptoForgeBaseDoor abstracts, both of
  which in turn add nothing beyond vanilla BuildingBase.
  ============================================================================
-->
<Defs>

  <!-- ===================================================================
       RUT_AncientAirlock — a working reinforced airlock door, frozen-ship
       set dressing. Donor: VQE_AncientAirlock (Buildings_Structure.xml,
       ParentName VQE_CryptoForgeBaseDoor). thingClass Building_MultiTileDoor
       is a vanilla RimWorld class (Source/RimWorld/Building_MultiTileDoor.cs)
       — no donor C# dependency, kept as-is.
       =================================================================== -->
  <ThingDef ParentName="BuildingBase">
    <defName>RUT_AncientAirlock</defName>
    <label>ancient airlock</label>
    <description>A hull airlock salvaged from a wreck older than anyone can date. The seal motors still hold pressure, slow and stubborn, and require solid wall on both sides to seat properly.</description>
    <thingClass>Building_MultiTileDoor</thingClass>
    <altitudeLayer>DoorMoveable</altitudeLayer>
    <fillPercent>1</fillPercent>
    <size>(1,1)</size>
    <rotatable>true</rotatable>
    <selectable>true</selectable>
    <tickerType>Normal</tickerType>
    <clearBuildingArea>true</clearBuildingArea>
    <holdsRoof>true</holdsRoof>
    <blockLight>true</blockLight>
    <drawerType>RealtimeOnly</drawerType>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <statBases>
      <WorkToBuild>5000</WorkToBuild>
      <DoorOpenSpeed>0.5</DoorOpenSpeed>
      <Beauty>0</Beauty>
      <Flammability>0</Flammability>
    </statBases>
    <graphicData>
      <texPath>Things/Building/Ancient/RUT_AncientAirlock</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <uiIconPath>Things/Building/Ancient/RUT_AncientAirlock</uiIconPath>  <!-- own landed art; no separate menu-icon art exists -->
    <building>
      <isInert>true</isInert>
      <canPlaceOverWall>false</canPlaceOverWall>
      <soundDoorOpenPowered>Door_OpenPowered</soundDoorOpenPowered>
      <soundDoorClosePowered>Door_ClosePowered</soundDoorClosePowered>
      <soundDoorOpenManual>Door_OpenManual</soundDoorOpenManual>
      <soundDoorCloseManual>Door_CloseManual</soundDoorCloseManual>
      <ai_chillDestination>false</ai_chillDestination>
      <paintable>false</paintable>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
      <neverBuildable>true</neverBuildable>
      <roamerCanOpen>false</roamerCanOpen>
      <blueprintClass>Blueprint_Build</blueprintClass>
      <blueprintGraphicData>
        <texPath>Things/Building/Ancient/RUT_AncientAirlock</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        <shaderType>EdgeDetect</shaderType>
        <drawSize>2</drawSize>
      </blueprintGraphicData>
      <!-- doorTopGraphic removed: its textures (…_Top) were never installed, so the game logged a missing texture and drew a bad graphic.
           The renders sit in artpipe _artsrc (RUT_AncientAirlock_Top east/north/south, Large_Top east/south; Large_Top north FAILED);
           put this block back when `art install` lands them:
      <doorTopGraphic>
        <texPath>Things/Building/Ancient/RUT_AncientAirlock_Top</texPath>
        <graphicClass>Graphic_Multi</graphicClass>
        <drawSize>(2.2, 2.2)</drawSize>
      </doorTopGraphic>
      -->
    </building>
    <comps>
      <li Class="CompProperties_Forbiddable">
        <allowNonPlayer>true</allowNonPlayer>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_DoorLearnOpeningSpeed</li>
    </placeWorkers>
    <stealable>false</stealable>
    <designationHotKey>Misc3</designationHotKey>
  </ThingDef>

