  <!-- ===================================================================
       RUT_FrozenEmptyCryptosleepPod — an opened, vacated cryptosleep pod.
       Donor: VQE_FrozenEmptyCryptosleepPod (Buildings_Cryptopods.xml).
       thingClass Building is plain vanilla — no donor C# dependency.
       =================================================================== -->
  <ThingDef ParentName="BuildingBase">
    <defName>RUT_FrozenEmptyCryptosleepPod</defName>
    <label>empty ancient cryptosleep pod</label>
    <description>A cryptosleep pod, iced over and standing open. Whoever it once held is long gone — walked off the wreck, or never made it this far.</description>
    <thingClass>Building</thingClass>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <selectable>true</selectable>
    <fillPercent>0.5</fillPercent>
    <size>(1,2)</size>
    <rotatable>true</rotatable>
    <blockWind>true</blockWind>
    <pathCost>42</pathCost>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <Flammability>0</Flammability>
      <WorkToBuild>2000</WorkToBuild>
    </statBases>
    <graphicData>
      <texPath>Things/Building/Ancient/RUT_FrozenEmptyCryptosleepPod</texPath>
      <graphicClass>Graphic_Single</graphicClass>  <!-- landed artpipe art is one rotating sprite (2026-10-03) -->
      <drawSize>(2,2)</drawSize>  <!-- square 256 canvas, pod fills ~0.8 x 0.95 of it: (1,2) would stretch it 2x tall -->
    </graphicData>
    <costList>
      <ChunkSlagSteel>2</ChunkSlagSteel>
      <Steel>50</Steel>
      <Uranium>6</Uranium>
    </costList>
    <building>
      <paintable>false</paintable>
      <claimable>false</claimable>
      <neverBuildable>true</neverBuildable>
    </building>
  </ThingDef>

</Defs>
