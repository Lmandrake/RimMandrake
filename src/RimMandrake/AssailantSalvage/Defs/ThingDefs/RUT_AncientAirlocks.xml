  <!-- ===================================================================
       RUT_ForcedAncientAirlock — the post-force-open state: propped, can't
       close again, passable rubble overlay. Donor: VQE_ForcedAncientAirlock.
       No donor C# on this state (no comps) — carried over as-is.
       =================================================================== -->
  <ThingDef ParentName="BuildingBase">
    <defName>RUT_ForcedAncientAirlock</defName>
    <label>forced ancient airlock</label>
    <description>A hull airlock pried open by main force. The seal is ruined; it will never close again.</description>
    <thingClass>Building</thingClass>
    <destroyable>false</destroyable>
    <useHitPoints>false</useHitPoints>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0</fillPercent>
    <size>(1,1)</size>
    <uiIconScale>0.5</uiIconScale>
    <statBases>
      <Flammability>0</Flammability>
    </statBases>
    <graphicData>
      <texPath>Things/Building/Ancient/RUT_ForcedAncientAirlock</texPath>
      <graphicClass>Graphic_Single</graphicClass>  <!-- landed artpipe art is one rotating sprite (2026-10-03) -->
