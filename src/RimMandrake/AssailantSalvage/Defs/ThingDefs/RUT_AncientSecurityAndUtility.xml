  <!-- =================================================================
       RUT_AncientLandmine — donor VQE_AncientLandmine (parent abstract
       VQE_TrapIEDBase, flattened in below).
       thingClass swap: donor's VanillaQuestsExpandedCryptoforge.Building_
       InvisibleMine -> vanilla Building_TrapExplosive. This is a close
       functional match, not a downgrade: vanilla's own buried IED traps
       already use Building_TrapExplosive with an UI/Empty texPath and
       selectable=false for exactly this "hidden until triggered" pattern,
       so nothing donor-specific is actually lost here.
       ================================================================= -->
  <ThingDef ParentName="BuildingBase">
    <defName>RUT_AncientLandmine</defName>
    <label>ancient landmine</label>
    <description>A buried charge scavenged from an old minefield, wired to a pressure-and-impact trigger. It sits invisible underfoot until something sets it off, and it's impossible to spot before that happens. Keep it well clear of other traps - the trigger is skittish.</description>
    <thingClass>Building_TrapExplosive</thingClass>
    <graphicData>
      <texPath>UI/Empty</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <damageData>
        <rect>(0.1,0,0.8,0.3)</rect>
      </damageData>
    </graphicData>
    <selectable>false</selectable>
    <uiIconOffset>(0,-0.14)</uiIconOffset>
    <uiIconPath>Things/Building/Ancient/RUT_AncientLandmine</uiIconPath>
    <drawerType>MapMeshAndRealTime</drawerType>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>false</rotatable>
    <tickerType>Normal</tickerType>
    <stealable>false</stealable>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <uiOrder>40</uiOrder>
    <statBases>
      <MaxHitPoints>40</MaxHitPoints>
      <Flammability>1</Flammability>
      <Beauty>-4</Beauty>
      <TrapSpringChance>1.0</TrapSpringChance>
    </statBases>
    <comps>
      <li Class="CompProperties_Explosive">
        <explosiveRadius>3.9</explosiveRadius>
        <explosiveDamageType>Bomb</explosiveDamageType>
        <startWickHitPointsPercent>0.2</startWickHitPointsPercent>
        <wickTicks>30</wickTicks>
        <startWickOnDamageTaken>
          <li>Bullet</li>
          <li>Arrow</li>
          <li>ArrowHighVelocity</li>
        </startWickOnDamageTaken>
      </li>
    </comps>
    <building>
      <isTrap>true</isTrap>
      <trapPeacefulWildAnimalsSpringChanceFactor>0.25</trapPeacefulWildAnimalsSpringChanceFactor>
      <expandHomeArea>false</expandHomeArea>
      <ai_chillDestination>false</ai_chillDestination>
      <neverBuildable>true</neverBuildable>
      <deconstructible>false</deconstructible>
    </building>
    <placeWorkers>
      <li>PlaceWorker_NeverAdjacentTrap</li>
    </placeWorkers>
    <specialDisplayRadius>3.9</specialDisplayRadius>
  </ThingDef>

  <!-- =================================================================
       RUT_AncientFloorHeater — donor VQE_AncientFloorHeater.
       thingClass swap: donor's VanillaQuestsExpandedCryptoforge.Building_
       FloorHeater -> vanilla Building. All the actual heating/power/glow
       behavior lives in the comps below (CompPowerTrader,
       CompHeatPusherPowered, CompGlower), which are all vanilla and need
       no custom class — the only thing that could theoretically be lost
       is a donor-side visual on/off graphic swap, which this def doesn't
       reproduce (it ships with one fixed graphic pending owned art).
       ================================================================= -->
  <ThingDef ParentName="BuildingBase">
    <defName>RUT_AncientFloorHeater</defName>
    <label>ancient floor heater</label>
    <description>A squat, outdated floor unit salvaged from a derelict's environmental deck. The insulation is shot and the casing is scorched, but wire it to power and it still throws real heat.</description>
    <thingClass>Building</thingClass>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <selectable>true</selectable>
    <fillPercent>0.05</fillPercent>
    <useHitPoints>false</useHitPoints>
    <drawerType>MapMeshAndRealTime</drawerType>
    <tickerType>Normal</tickerType>
    <size>(2,2)</size>
    <rotatable>false</rotatable>
    <pathCost>0</pathCost>
    <statBases>
      <Flammability>0</Flammability>
      <MarketValue>280</MarketValue>
      <Beauty>-20</Beauty>
    </statBases>
    <graphicData>
      <texPath>Things/Building/Ancient/RUT_AncientFloorHeater</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <building>
      <paintable>false</paintable>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
      <neverBuildable>true</neverBuildable>
    </building>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>250</basePowerConsumption>
      </li>
      <li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusherPowered</compClass>
        <heatPerSecond>21</heatPerSecond>
        <heatPushMaxTemperature>28</heatPushMaxTemperature>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>3</glowRadius>
        <glowColor>(255,150,100,0)</glowColor>
      </li>
    </comps>
  </ThingDef>

  <!-- =================================================================
       RUT_AncientBlackBox / RUT_AncientBlackBox_Off — donor
       VQE_AncientBlackBox / VQE_AncientBlackBox_Off.

       The "On" donor def's thingClass (VanillaQuestsExpandedCryptoforge.
       StudiableBuilding_Cryptoforge) plus its VEF.Buildings.
       StudiableBuildingDetails modExtension are donor quest machinery: a
       study gizmo that unlocks quest-chain intel for VQE_Cryptoforge_
       Chapter1, a quest we are not keeping. DROPPED ENTIRELY per this
       item's brief, not carried to a vanilla equivalent — there is no
       quest to hook it to any more. Reinterpreted per SALVAGE_PALETTE.md
       row 406 (VQE_AncientBlackBox_Off: Graphic_Multi, ~0.5 market,
       ChunkSlagSteel x1.0 yield) as inert wreck salvage: both variants
       are now plain scrap furniture, mineable/scrappable, matching the
       donor's own "_Off" sibling which was ALREADY a bare vanilla
       Building with no custom class or quest hook. RUT_AncientBlackBox
       ("on") keeps only its cosmetic glow (vanilla CompProperties_Glower,
       no custom code) as the visual difference from RUT_AncientBlackBox_
       Off ("dead") - it carries no quest, gizmo or intel mechanic.
       No cost data exists for the donor's "on" state (it was quest-only,
       not deconstructible), so its HP/costList below are set to match its
       "_Off" sibling, which does have real numbers.
       ================================================================= -->
  <ThingDef ParentName="BuildingBase">
    <defName>RUT_AncientBlackBox</defName>
    <label>ancient black box</label>
    <description>A gutted flight recorder pried from a wreck's crash frame, its casing still faintly lit by a dying indicator. Whatever data it once held is long past recovery - it's dead weight now, good for its metal.</description>
    <thingClass>Building</thingClass>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <drawerType>MapMeshAndRealTime</drawerType>
    <selectable>true</selectable>
    <fillPercent>0.4</fillPercent>
    <size>(3,1)</size>
    <rotatable>true</rotatable>
    <pathCost>30</pathCost>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <graphicData>
      <texPath>Things/Building/Ancient/RUT_AncientBlackBox</texPath>
      <!-- One top-down image the game rotates, like RUT_AncientBlackBox_Off (artpipe 2026-10-03). -->
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3.5,1.75)</drawSize>
    </graphicData>
    <costList>
      <ChunkSlagSteel>2</ChunkSlagSteel>
    </costList>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>2.68</glowRadius>
        <glowColor>(0, 235, 31, 0)</glowColor>
      </li>
    </comps>
    <building>
      <paintable>false</paintable>
      <claimable>false</claimable>
      <neverBuildable>true</neverBuildable>
    </building>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>RUT_AncientBlackBox_Off</defName>
    <label>disabled ancient black box</label>
    <description>A flight recorder stripped of power and purpose, its casing dark and cold. Nothing left inside worth reading - just scrap waiting to be broken down.</description>
    <thingClass>Building</thingClass>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <selectable>true</selectable>
    <fillPercent>0.4</fillPercent>
    <size>(3,1)</size>
    <rotatable>true</rotatable>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <pathCost>30</pathCost>
    <graphicData>
      <texPath>Things/Building/Ancient/RUT_AncientBlackBox_Off</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3.5,1.75)</drawSize>
    </graphicData>
    <costList>
      <ChunkSlagSteel>2</ChunkSlagSteel>
    </costList>
    <building>
      <paintable>false</paintable>
      <claimable>false</claimable>
      <neverBuildable>true</neverBuildable>
    </building>
  </ThingDef>

  <!-- =================================================================
