<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  RUT_AncientSecurityAndUtility.xml       AssailantSalvage · CRYPTOFORGE_HARVEST_RETIRE_1
  ============================================================================
  Step 1 citation swap: owned RUT_-prefixed replacements for 7 of the props
  formerly cited in design/Jawa/art/SALVAGE_PALETTE.md to the donor Workshop
  mod "Vanilla Quests Expanded - Cryptoforge" (packageId
  vanillaquestsexpanded.cryptoforge, being retired outright per the owner's
  "retire-after-harvest" ruling). Same gameplay stats/function as the donor
  originals — HP, cost, size, and for the two turrets the full damage/range/
  accuracy/power profile, carried over line-for-line from the donor XML —
  but new defNames, OWNED art (queued separately, not yet on disk), and
  original flavor text. Workshop art is not ours to ship.

  Two turrets pull in their vanilla-style Gun + Bullet sub-defs
  (RUT_<Name>_Gun / _Bullet) since Building_TurretGun needs them to function;
  those weren't in this item's named defName list but are load-bearing
  plumbing for RUT_AncientShieldedTurret / RUT_AncientSpacerAutocannon and
  carry no independent gameplay content of their own, so no separate art
  job — the Gun sub-defs reuse their parent's single art asset and the
  Bullet sub-defs reuse existing vanilla Core projectile textures.

  Where a donor def's thingClass was the donor's own compiled C# (not a
  vanilla RimWorld class), that class is NOT reproduced — see the per-def
  comments below for the closest vanilla equivalent used instead and what
  donor-specific behavior was dropped.
  ============================================================================
-->
<Defs>

  <!-- =================================================================
       RUT_AncientShieldedTurret — donor VQE_AncientShieldedTurret.
       thingClass swap: donor's VanillaQuestsExpandedCryptoforge.Building_
       TurretGun_Armoured (a subclass adding "ballistic shield deflects
       some shots" logic) -> vanilla Building_TurretGun. DROPPED: the
       shield-deflection behavior described in the donor's flavor text —
       there is no vanilla stat/comp equivalent, so this turret takes full
       damage like any other turret. Every other stat (HP, power draw,
       refuel economy, explosion-on-death, accuracy, range, burst/cooldown)
       is carried over unchanged.
       ================================================================= -->
  <ThingDef ParentName="BuildingBase">
    <defName>RUT_AncientShieldedTurret</defName>
    <label>ancient shielded turret</label>
    <description>A scavenged autonomous gun nest wrapped in a slab of ballistic plating, torn from some long-dead ship's hull. Its firing logic is dumb and indiscriminate - anything that moves in range gets shot, friend or foe. Burns through steel barrels fast, and it cooks off if hit hard enough.</description>
    <thingClass>Building_TurretGun</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Ancient/RUT_AncientShieldedTurret</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
      <damageData>
        <rect>(0.2,0.2,0.6,0.6)</rect>
      </damageData>
      <shadowData>
        <volume>(0.27,0.25,0.27)</volume>
        <offset>(0,0,0)</offset>
      </shadowData>
    </graphicData>
    <minifiedDef>MinifiedThing</minifiedDef>
    <altitudeLayer>Building</altitudeLayer>
    <stealable>false</stealable>
    <rotatable>false</rotatable>
    <thingCategories>
      <li>BuildingsSecurity</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>0.7</Flammability>
      <WorkToBuild>1800</WorkToBuild>
      <Mass>8</Mass>
      <Beauty>-20</Beauty>
      <MarketValue>220</MarketValue>
      <ShootingAccuracyTurret>0.96</ShootingAccuracyTurret>
    </statBases>
    <tickerType>Normal</tickerType>
    <comps>
      <li Class="CompProperties_Explosive">
        <wickTicks>240</wickTicks>
        <explosiveRadius>3.9</explosiveRadius>
        <explosiveDamageType>Bomb</explosiveDamageType>
        <chanceNeverExplodeFromDamage>0.5</chanceNeverExplodeFromDamage>
      </li>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>125</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Refuelable">
        <fuelLabel>Shots until barrel change</fuelLabel>
        <fuelGizmoLabel>Barrel durability</fuelGizmoLabel>
        <outOfFuelMessage>Needs new barrel</outOfFuelMessage>
        <fuelFilter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </fuelFilter>
        <fuelCapacity>60</fuelCapacity>
        <fuelMultiplier>0.75</fuelMultiplier>
        <initialFuelPercent>1</initialFuelPercent>
        <autoRefuelPercent>0.5</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <minimumFueledThreshold>1</minimumFueledThreshold>
        <factorByDifficulty>true</factorByDifficulty>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <fuelIconPath>UI/Overlays/Barrel</fuelIconPath>
      </li>
      <li Class="CompProperties_Stunnable">
        <affectedDamageDefs>
          <li>Stun</li>
          <li>EMP</li>
        </affectedDamageDefs>
      </li>
    </comps>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.8</fillPercent>
    <hasTooltip>true</hasTooltip>
    <costList>
      <Steel>44</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <building>
      <combatPower>45</combatPower>
      <ai_combatDangerous>true</ai_combatDangerous>
      <turretGunDef>RUT_AncientShieldedTurret_Gun</turretGunDef>
      <turretBurstCooldownTime>4.8</turretBurstCooldownTime>
      <neverBuildable>true</neverBuildable>
    </building>
    <placeWorkers>
      <li>PlaceWorker_TurretTop</li>
      <li>PlaceWorker_ShowTurretRadius</li>
    </placeWorkers>
  </ThingDef>

