  <ThingDef ParentName="BuildingBase">
    <defName>RUT_BlueprintsBench</defName>
    <label>ancient blueprints bench</label>
    <description>A drafting bench salvaged from a wreck's fabrication bay, its surface still layered with brittle, water-stained schematics. The designs have long since faded past any use - it's just old furniture now.</description>
    <thingClass>Building</thingClass>
    <clearBuildingArea>true</clearBuildingArea>
    <drawerType>MapMeshAndRealTime</drawerType>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.4</fillPercent>
    <graphicData>
      <texPath>Things/Building/Ancient/RUT_BlueprintsBench</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.2,1.2)</drawSize>
      <drawRotated>false</drawRotated>
    </graphicData>
