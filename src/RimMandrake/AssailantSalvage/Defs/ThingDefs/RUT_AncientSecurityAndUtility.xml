    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <defaultProjectile>RUT_AncientShieldedTurret_Bullet</defaultProjectile>
        <warmupTime>0</warmupTime>
        <range>28.9</range>
