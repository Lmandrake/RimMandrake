  <ThingDef ParentName="BuildingBase">
    <defName>RUT_RuinedHospitalBed</defName>
    <label>corroded medical berth</label>
    <description>A rusted-out bed frame, its thin mattress somehow still mostly intact. It will hold a patient, poorly.</description>
    <thingClass>Building_Bed</thingClass>
    <altitudeLayer>Building</altitudeLayer>
    <drawGUIOverlay>true</drawGUIOverlay>
    <canOverlapZones>false</canOverlapZones>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
    <passability>PassThroughOnly</passability>
    <defaultPlacingRot>South</defaultPlacingRot>
    <uiOrder>2020</uiOrder>
    <graphicData>
      <texPath>Things/Building/Ancient/RUT_RuinedHospitalBed</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <castEdgeShadows>True</castEdgeShadows>
    <statBases>
      <MaxHitPoints>140</MaxHitPoints>
      <Beauty>1</Beauty>
      <WorkToBuild>2800</WorkToBuild>
      <Mass>20</Mass>
      <Flammability>0.8</Flammability>
      <BedRestEffectiveness>0.85</BedRestEffectiveness>
      <Comfort>0.75</Comfort>
      <ImmunityGainSpeedFactor>0.95</ImmunityGainSpeedFactor>
      <SurgerySuccessChanceFactor>0.65</SurgerySuccessChanceFactor>
      <BirthRitualQualityOffset MayRequire="Ludeon.RimWorld.Biotech">1.5</BirthRitualQualityOffset>
    </statBases>
    <comps>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>VitalsMonitor</li>
          <li>EndTable</li>
          <li>Dresser</li>
          <li MayRequire="Ludeon.RimWorld.Ideology">SleepAccelerator</li>
        </linkableFacilities>
      </li>
      <li Class="CompProperties_AssignableToPawn">
        <drawAssignmentOverlay>false</drawAssignmentOverlay>
        <compClass>CompAssignableToPawn_Bed</compClass>
      </li>
    </comps>
    <size>(1,2)</size>
    <building>
      <bed_showSleeperBody>True</bed_showSleeperBody>
      <bed_healPerDay>10</bed_healPerDay>
      <buildingSizeCategory>Small</buildingSizeCategory>
      <paintable>true</paintable>
      <buildingTags>
        <li>Bed</li>
      </buildingTags>
      <neverBuildable>true</neverBuildable>
    </building>
    <fillPercent>0.4</fillPercent>
    <pathCost>42</pathCost>
    <costList>
      <Steel>70</Steel>
    </costList>
    <staticSunShadowHeight>0.17</staticSunShadowHeight>
    <techLevel>Medieval</techLevel>
    <uiIconScale>0.90</uiIconScale>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
  </ThingDef>

