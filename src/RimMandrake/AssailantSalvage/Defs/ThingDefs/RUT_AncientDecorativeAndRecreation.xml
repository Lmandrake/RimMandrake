  <ThingDef ParentName="BuildingBase">
    <defName>RUT_AncientWargamingTable</defName>
    <label>battered wargaming table</label>
    <description>A sturdy old tabletop built for pushing miniature armies across painted terrain. Its surface is scuffed and its edges dented, but the strategy games it hosts are as sharp as ever.</description>
    <thingClass>Building</thingClass>
    <!-- Donor's joyKind was its own custom JoyKindDef (VQE_Gaming_StrategicPlay,
         backed by a donor JobDef + JoyGiverDef). We depend only on Core, so this
         is retargeted to vanilla Gaming_Cerebral ("cerebral play" — chess/poker),
         the closest vanilla joy category to tabletop strategy gaming. Donor
         behavior dropped: none functionally — joy is still granted, at the
         same JoyGainFactor, just filed under the vanilla joy kind instead of a
         donor-specific one. -->
    <graphicData>
      <texPath>Things/Building/Ancient/RUT_AncientWargamingTable</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(4,4)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsJoy</li>
    </thingCategories>
    <staticSunShadowHeight>0.2</staticSunShadowHeight>
    <castEdgeShadows>True</castEdgeShadows>
    <altitudeLayer>Building</altitudeLayer>
    <socialPropernessMatters>true</socialPropernessMatters>
    <fillPercent>0.40</fillPercent>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <building>
      <joyKind>Gaming_Cerebral</joyKind>
      <buildingSizeCategory>Medium</buildingSizeCategory>
      <paintable>false</paintable>
      <claimable>true</claimable>
      <neverBuildable>true</neverBuildable>
    </building>
    <statBases>
      <MaxHitPoints>350</MaxHitPoints>
      <Mass>75</Mass>
      <Flammability>0</Flammability>
      <Beauty>0</Beauty>
      <JoyGainFactor>1.4</JoyGainFactor>
    </statBases>
    <size>(2,3)</size>
    <costList>
      <Steel>80</Steel>
      <Cloth>80</Cloth>
      <Plasteel>10</Plasteel>
    </costList>
    <pathCost>42</pathCost>
    <passability>PassThroughOnly</passability>
    <canOverlapZones>false</canOverlapZones>
    <placeWorkers>
      <li>PlaceWorker_NeverAdjacentUnstandable</li>
    </placeWorkers>
    <comps>
      <li>
        <compClass>CompQuality</compClass>
      </li>
    </comps>
  </ThingDef>

</Defs>
