<!--
  ============================================================================
  RUT_AncientDecorativeAndRecreation.xml         AssailantSalvage · 2026-09-28
  ============================================================================
  CRYPTOFORGE_HARVEST_RETIRE_1 step 1 — citation swap for the donor Workshop
  mod "Vanilla Quests Expanded - Cryptoforge" (vanillaquestsexpanded.cryptoforge,
  packageId retired per the owner's "retire-after-harvest" ruling). Each def
  below reproduces one donor prop cited in design/Jawa/art/SALVAGE_PALETTE.md:
  same gameplay stats/function, but our own RUT_ defName, our own texPath
  (art queued separately, not yet generated) and original flavor prose — the
  donor's own description text is not reused anywhere here. Workshop art is
  not ours to ship. All eight build directly on vanilla Core's BuildingBase,
  matching the donor's own flat inheritance shape (its VQE_CryptoForgeBuildingBase
  was itself an empty ParentName="BuildingBase" wrapper) — no new abstract
  parent invented for this file.
  ============================================================================
-->
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>RUT_BustedShieldedTurret</defName>
    <label>wrecked shielded turret</label>
    <description>A gutted turret emplacement, its deflector housing crushed and its weapon long stripped for parts. Pure scrap now.</description>
    <thingClass>Building</thingClass>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <selectable>true</selectable>
    <fillPercent>0.5</fillPercent>
    <size>(1,1)</size>
    <costList>
      <Steel>20</Steel>
    </costList>
    <rotatable>false</rotatable>
    <pathCost>20</pathCost>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>0</Flammability>
      <Beauty>-20</Beauty>
    </statBases>
    <graphicData>
      <texPath>Things/Building/Ancient/RUT_BustedShieldedTurret</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <building>
      <paintable>false</paintable>
      <claimable>false</claimable>
      <neverBuildable>true</neverBuildable>
      <deconstructible>false</deconstructible>
    </building>
  </ThingDef>

