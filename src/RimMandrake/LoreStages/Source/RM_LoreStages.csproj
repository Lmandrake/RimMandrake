<Project Sdk="Microsoft.NET.Sdk">

  <!--
    STAGED_LORE_BUILD_1 — the staged-lore-description engine.

    RimMandrake tier: nothing here names a campaign, a biome or a ladder. The
    ladders themselves ship as RM_LoreStageTableDefs from content mods
    (mandrake.rut.scarlandsladder is the first), per the engine/content split
    rule in design/NAMING_SCHEME_PLAN.md §2.

    NO Harmony reference, deliberately — the mechanism is def mutation plus two
    reflection cache-clears; see LoreStageApplier.cs for why that beats a patch.

    Build (the dotnet is WINDOWS-NATIVE and cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\Rimworld\src\RimMandrake\LoreStages\Source\RM_LoreStages.csproj -c Release

    Output lands in ../Assemblies/, which is where RimWorld looks.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrakeLoreStages</AssemblyName>
    <RootNamespace>RimMandrake.LoreStages</RootNamespace>
    <Version>0.1.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="LoreStageText.cs" />
    <Compile Include="LoreStageTarget.cs" />
    <Compile Include="RM_LoreStageTableDef.cs" />
    <Compile Include="LoreStageApplier.cs" />
    <Compile Include="LoreStageDefDatabase.cs" />
    <Compile Include="GameComponent_LoreStage.cs" />
    <Compile Include="LoreStageDebugActions.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
