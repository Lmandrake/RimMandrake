<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ========================================================================
       PYRELANDS_MECHANICS_1, mechanism 3 — the fire-hawk's twig.
       Driver: RimMandrake.Pyrelands.JobDriver_RUT_FireHawkCarryEmber.
       Dispatched only by JobGiver_RUT_FireHawkCarryEmber, which will not issue
       it unless a fire is ALREADY burning in scan range (the spread-only law,
       RUT_ruled_commissions_wave2.md §7c, RATIFIED owner 2026-09-10).

       TargetA is the fire the ember comes from; TargetB is the cell it goes to.

       suspendable false, matching RM_AnimalSteal (this repo's own animal-job
       precedent): a half-flown sortie that resumes days later with the source
       fire long out is worse than one that simply ends.

       PYRELANDS_RM_MOD_BUILD_1 §6: defName renamed RUT_ -> RM_ at the move
       into mandrake.rm.pyrelands. The C# class names (JobDriver_RUT_..., a
       data field, not a def) were left as-is — only defNames were renamed.
  ======================================================================== -->
  <JobDef>
    <defName>RM_FireHawkCarryEmber</defName>
    <driverClass>RimMandrake.Pyrelands.JobDriver_RUT_FireHawkCarryEmber</driverClass>
    <reportString>carrying an ember from TargetA.</reportString>
    <suspendable>false</suspendable>
    <!-- FIREHAWK_EMBER_FIX_WALKS_ITS_TWIG (2026-10-15): with neither flag, Pawn_FlightTracker.Notify_JobStarted sets
         job.flying=false and ForceLand()s a flying hawk, so the sortie was walked. tryStartFlying takes off (chance 1,
         as vanilla's flight-forced jobs set it); ifFlyingKeepFlying keeps an airborne hawk up. A hawk on flight
         cooldown still walks: that is vanilla's rule, not ours. -->
    <tryStartFlying>true</tryStartFlying>
    <ifFlyingKeepFlying>true</ifFlyingKeepFlying>
    <overrideFlyChance>1</overrideFlyChance>
  </JobDef>

  <!-- ========================================================================
       PYRELANDS_DEDICATED_GRAZER_1 — the burrow-on-fire job.
       Driver: RimMandrake.Pyrelands.RM_JobDriver_Burrow. Dispatched only by
       RM_JobGiver_BurrowOnFire, which will not issue it unless a fire is
       already burning within the carrying race's own
       RM_BurrowOnFireExtension.detectionRadius.

       suspendable false, same reasoning as RM_FireHawkCarryEmber immediately
       above: a burrow that resumes days later with the front long since
       passed makes no sense — the driver's own tick check already re-derives
       "is it still worth burrowing" every tick it runs, so nothing is lost by
       simply not resuming a stale one.
  ======================================================================== -->
  <JobDef>
    <defName>RM_Burrow</defName>
    <driverClass>RimMandrake.Pyrelands.RM_JobDriver_Burrow</driverClass>
    <reportString>burrowing to let the fire pass.</reportString>
    <suspendable>false</suspendable>
  </JobDef>

</Defs>
