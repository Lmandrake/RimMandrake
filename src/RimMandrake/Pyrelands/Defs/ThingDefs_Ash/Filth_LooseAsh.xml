<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    The loose surface-ash layer that rides on top of the ground (mostly deep
    ash, AshField.xml) — the visible mark of a fresh fall or a fresh burn. Vanilla's own DamageWorker_Flame already drops Filth_Ash
    unconditionally on every fire tick everywhere (RimSage,
    Source/Verse/DamageWorker_Flame.cs:29) — that keeps happening, untouched,
    in every biome including this one.

    This is a SEPARATE filth, spawned by the C# fire hook and the ash-fall
    weather, carrying rainWashes=true — vanilla's own SteadyEnvironmentEffects
    already washes any rainWashes filth away under ANY weather with rainRate>0
    (Source/RimWorld/SteadyEnvironmentEffects.cs:124), including Black Rain.
    That passive vanilla mechanic is what actually delivers "converts
    accumulated ash to fast-clearing slurry". The deep-ash terrain itself
    never washes away; Black Rain instead waters it (AshField.xml).
  -->

  <ThingDef ParentName="BaseFilth">
    <defName>RM_FE_Filth_LooseAsh</defName>
    <label>loose ash</label>
    <description>A drift of fine grey ash over the ground beneath it. A hard rain carries it off fast.</description>
    <altitudeLayer>Filth</altitudeLayer>
    <category>Filth</category>
    <drawerType>MapMeshOnly</drawerType>
    <filth>
      <cleaningSound>Interact_CleanFilth</cleaningSound>
      <ignoreFilthMultiplierStat>true</ignoreFilthMultiplierStat>
      <disappearsInDays>6~9</disappearsInDays>
      <rainWashes>true</rainWashes>
      <cleaningWorkToReduceThickness>60</cleaningWorkToReduceThickness>
      <canFilthAttach>true</canFilthAttach>
      <maxThickness>4</maxThickness>
    </filth>
    <!--
      Owner verdict 2026-09-18 on the minimal-list review: "I don't see ash...
      anywhere" — 1,900 of these were on the map after ashfall+fire, mechanically
      fine, invisible. The original (140,136,130,200) is a mid-grey close in
      value to Pyrelands' own grey-brown ground (see ScorchableGround.xml's
      Gravel/Soil tints, ~120-140 range) — same tone, low alpha, no contrast
      either way. Real ash reads pale, near-white against dark ground; raised
      here to a pale warm-grey and near-opaque so the drift actually stands out
      rather than blending into the dirt it is meant to be visible on top of.
    -->
    <!--
      Owner 2026-11-07 on the grey ground: "blurry grey stuff ... looks low-res and ugly". Measured by rebuilding a burned patch one
      layer at a time: vanilla's Things/Filth/Ash blob at 3.3 cells, one splotch per point of thickness (Graphic_Cluster), laid
      a soft grey fog over every cell. Our own crisp drifts instead (Textures/Things/Filth/RM_FE_LooseAsh, 256 px for 1.5 cells),
      so a thin scatter shows the dark ground between them and a deep drift reads as heaped ash, not haze. Tinted down to a mid-light
      grey: at full white a burned cell at x4 read as snow.
      Same day, at play zoom on map p: one 1.5-cell drift on 92% of a scar's cells still read as pale camouflage blotches. A fire
      now leaves a drift on about a third of its cells (FireEcologyHook, ScarAshShare), drawn at 1.25 and a little darker, so the
      scar reads as char with ash lying on it.
    -->
    <graphicData>
      <graphicClass>Graphic_Cluster</graphicClass>
      <shaderType>Transparent</shaderType>
      <texPath>Things/Filth/RM_FE_LooseAsh</texPath>
      <color>(184, 180, 172, 200)</color>
      <drawSize>1.25</drawSize>
    </graphicData>
    <statBases>
      <!-- Under open sky ash is the ground's own colour here: a burn must not read as an ugly environment for days. Indoors it is dirt. -->
      <BeautyOutdoors>0</BeautyOutdoors>
      <Beauty>-8</Beauty>
      <Cleanliness>-10</Cleanliness>
    </statBases>
    <thingClass>Filth</thingClass>
    <useHitPoints>false</useHitPoints>
  </ThingDef>

</Defs>
