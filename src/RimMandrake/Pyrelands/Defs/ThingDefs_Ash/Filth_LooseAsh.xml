<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    LEGACY, kept one cycle so an older save loads. Loose ash was this filth until 2026-11-08; it is now Odyssey's sand depth on
    a map fire ecology runs on (owner, by card: "Rebuild ash on vanilla sand?" -> "Yes, rebuild on sand"; Source/PyrelandsAshSand.cs).
    Nothing spawns this def any more: fire, ash fall, the ruins and yesterday's fire all lay sand depth. A save that still holds
    some has every one converted on load to sand depth, a drift level (0.25) per point of thickness, and destroyed
    (MapComponent_PyrelandsAshfall.FinalizeInit, FireEcologyHook.cs). Drop this def once no save from before 2026-11-08 is played.
    The history of its eight sprite redraws and the ground cover that replaced them is in git (de23b05e44 and before).
  -->

  <ThingDef ParentName="BaseFilth">
    <defName>RM_FE_Filth_LooseAsh</defName>
    <label>loose ash (old)</label>
    <description>Ash from before ash lay on the ground as a drift of its own. It turns into that drift when the map loads.</description>
    <altitudeLayer>Filth</altitudeLayer>
    <category>Filth</category>
    <drawerType>MapMeshOnly</drawerType>
    <filth>
      <cleaningSound>Interact_CleanFilth</cleaningSound>
      <ignoreFilthMultiplierStat>true</ignoreFilthMultiplierStat>
      <disappearsInDays>6~9</disappearsInDays>
      <rainWashes>true</rainWashes>
      <cleaningWorkToReduceThickness>60</cleaningWorkToReduceThickness>
      <canFilthAttach>true</canFilthAttach>
      <maxThickness>4</maxThickness>
    </filth>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
      <texPath>Things/Filth/RM_FE_LooseAsh/LooseAshA0</texPath>
      <color>(184, 180, 172, 200)</color>
      <drawSize>1.6</drawSize>
    </graphicData>
    <statBases>
      <BeautyOutdoors>0</BeautyOutdoors>
      <Beauty>-8</Beauty>
      <Cleanliness>-10</Cleanliness>
    </statBases>
    <thingClass>Filth</thingClass>
    <useHitPoints>false</useHitPoints>
  </ThingDef>

</Defs>
