<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- RM_FurnaceWarmth retired by PYRELANDS_FURNACE_WARMTH_AMBIENT_1: one kind of heat planet-wide. The furnace-beast's
       open-field warmth is a local felt-temperature offset (CompFurnaceWarmthAura / FurnaceWarmthField), not a hediff. -->

  <!-- ========================================================================
       PYRELANDS_DEDICATED_GRAZER_1 — the burrow state itself.
       Applied by RM_JobDriver_Burrow for as long as an extension-carrying
       pawn is sheltering from a nearby fire front; removed by the same
       driver's AddFinishAction on every exit path (safe emergence, the
       safety-cap timeout, or the job being interrupted).

       TWO STAT OFFSETS, same idiom RM_FurnaceBeast's permanent statBases
       use for total fire immunity (ArmorRating_Heat, Flammability), applied
       here only WHILE burrowed rather than always:
         ArmorRating_Heat +4.0   comfortably past the point the vanilla armor
                                  formula treats as near-total mitigation —
                                  "the fire pass[es] over" it (the_pyrelands.md
                                  §4), not merely resists it. [INVENTED]
         Flammability     -1.0   zeroes the default 1.0 base outright, so a
                                  burrowed pawn standing in a burning cell
                                  cannot itself catch alight.

       isBad false: this is the mechanism working as intended, not an
       affliction — the player should read it as "sheltering", not "hurt".
  ======================================================================== -->
  <HediffDef>
    <defName>RM_Burrowed</defName>
    <label>burrowed</label>
    <description>Gone to ground, sheltering from a fire front passing overhead. Nearly immune to heat and flame while it holds; the animal cannot do anything else until it surfaces.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <everCurableByItem>false</everCurableByItem>
    <maxSeverity>1</maxSeverity>
    <initialSeverity>1</initialSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <!-- the dome pose (RM_BurrowHeatReaction's GraphicFor postfix) must redraw on add and remove -->
    <forceRenderTreeRecache>true</forceRenderTreeRecache>
    <stages>
      <li>
        <statOffsets>
          <ArmorRating_Heat>4.0</ArmorRating_Heat>
          <Flammability>-1.0</Flammability>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- ========================================================================
       RM_FE_SmokeChoke — the sign of the choking smoke weather (owner
       2026-11-13: "the choking smoke that sometimes come as its own weather";
       bar pyre_smoke_weather_chokes). Given only by
       Source/PyrelandsSmokeWeather.cs to a breathing pawn under open sky while
       RM_FE_Weather_Smoke is the weather; never under a roof.
       Rates (they live in RM_FireEcoKernel.SmokeGainPerCheck and here):
       +0.02 a check every 250 ticks = +0.20 a game hour in the open, against
       the -2.4 a day (-0.10 an hour) below, so +0.10 an hour net outdoors:
       "coughing" at once, "choking" after ~3.5 h, "gasping" after ~7 h.
       Under a roof it only falls, 0.10 an hour: gone in at most 10 h.
       Not lethal (maxSeverity 1, no lethalSeverity): it hampers, it does not kill.
       ======================================================================== -->
  <HediffDef>
    <defName>RM_FE_SmokeChoke</defName>
    <label>smoke in the lungs</label>
    <description>Smoke breathed in under an open, smoke-filled sky. It makes breathing hard and slows the body down. It wears off under a roof or once the smoke clears.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.80, 0.68, 0.48)</defaultLabelColor>
    <isBad>true</isBad>
    <tendable>false</tendable>
    <everCurableByItem>false</everCurableByItem>
    <maxSeverity>1</maxSeverity>
    <initialSeverity>0.02</initialSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-2.4</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>coughing</label>
        <capMods>
          <li>
            <capacity>Breathing</capacity>
            <offset>-0.10</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>choking</label>
        <minSeverity>0.35</minSeverity>
        <capMods>
          <li>
            <capacity>Breathing</capacity>
            <offset>-0.20</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.10</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>gasping</label>
        <minSeverity>0.7</minSeverity>
        <capMods>
          <li>
            <capacity>Breathing</capacity>
            <offset>-0.35</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.15</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
