<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Clones of vanilla Sand/Gravel/Soil/SoilRich, scoped to whatever biome's
    terrainsByFertility/terrainPatchMakers actually reference them (only
    RM_Pyrelands' own BiomeDef, BiomeDefs/Pyrelands.xml) — NOT a patch on the
    shared vanilla terrains themselves. Patching Flammability onto Soil/Sand
    directly would make every biome on the planet that uses those terrains
    start converting to ash, which is not what this item asked for. Cloning
    keeps the blast radius to exactly the biome that opts in.

    Stat values are copied from vanilla Terrain_Natural.xml (RimSage,
    2026-09-01) so these read identically to ordinary ground until they burn.
    The only additions are Flammability (FireUtility.Flammable() reads
    StatDefOf.Flammability > 0.01, RimWorld/FireUtility.cs:206) and burnedDef
    (RM_FE_Ash_Deep: one burn, one step, AshField.xml),
    which Verse/TerrainGrid.cs:609 and Fire.cs's TryBurnFloor already consume
    with zero new code — Notify_TerrainBurned fires on ANY standing terrain
    under a Fire thing each burn tick, not just constructed floors.
  -->

  <TerrainDef Name="RM_FE_ScorchableGroundBase" Abstract="true">
    <researchPrerequisites/>
    <renderPrecedence>100</renderPrecedence>
    <fertility>0</fertility>
    <affordances>
      <li>Light</li>
      <li>Heavy</li>
    </affordances>
    <statBases>
      <Beauty>0</Beauty>
      <Flammability>0.6</Flammability>
    </statBases>
  </TerrainDef>

  <TerrainDef ParentName="RM_FE_ScorchableGroundBase">
    <defName>RM_FE_Ground_Sand</defName>
    <label>sand</label>
    <description>Loose, pale sand. Dry enough to carry a grass fire's heat straight down into it.</description>
    <texturePath>Terrain/Surfaces/Sand</texturePath>
    <color>(240, 220, 130)</color>
    <fertility>0.05</fertility>
    <passability>Standable</passability>
    <pathCost>3</pathCost>
    <burnedDef>RM_FE_Ash_Deep</burnedDef>
    <modExtensions>
      <!-- PYRELANDS_SAND_TERRAIN_YIELD_1: "Shovel sand" digs a cell to gravel for glass sand (the breaker's hopper
           fuel and the forge's breaker-core input). Finite by design: the cell does not stay sand. -->
      <li Class="RimMandrake.Pyrelands.RM_TerrainDigYieldExtension">
        <yield>RM_GlassSand</yield>
        <count>5</count>
        <workTicks>400</workTicks>
        <leaves>RM_FE_Ground_Gravel</leaves>
      </li>
    </modExtensions>
  </TerrainDef>

  <TerrainDef ParentName="RM_FE_ScorchableGroundBase">
    <defName>RM_FE_Ground_Gravel</defName>
    <label>gravel</label>
    <description>Loose stone chips over hardpan. Sparse fuel, but what grows in it still burns.</description>
    <texturePath>Terrain/Surfaces/Gravel</texturePath>
    <color>(140, 130, 120)</color>
    <fertility>0.28</fertility>
    <passability>Standable</passability>
    <pathCost>2</pathCost>
    <burnedDef>RM_FE_Ash_Deep</burnedDef>
  </TerrainDef>

  <TerrainDef ParentName="RM_FE_ScorchableGroundBase">
    <defName>RM_FE_Ground_Soil</defName>
    <label>soil</label>
    <description>Ordinary dirt, thick with dry grass roots that carry a fire's heat into the ground itself.</description>
    <texturePath>Terrain/Surfaces/Soil</texturePath>
    <color>(119, 96, 64)</color>
    <fertility>0.7</fertility>
    <passability>Standable</passability>
    <pathCost>1</pathCost>
    <burnedDef>RM_FE_Ash_Deep</burnedDef>
  </TerrainDef>

  <TerrainDef ParentName="RM_FE_ScorchableGroundBase">
    <defName>RM_FE_Ground_SoilRich</defName>
    <label>rich soil</label>
    <description>Dark, fertile dirt, ash-fertilized and thick with growth — the richest fuel bed on the savanna.</description>
    <texturePath>Terrain/Surfaces/SoilRich</texturePath>
    <color>(90, 69, 46)</color>
    <fertility>1.4</fertility>
    <passability>Standable</passability>
    <pathCost>1</pathCost>
    <burnedDef>RM_FE_Ash_Deep</burnedDef>
  </TerrainDef>

</Defs>
