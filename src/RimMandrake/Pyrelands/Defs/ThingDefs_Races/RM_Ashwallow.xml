<?xml version="1.0" encoding="utf-8"?>
<!--
  RM_Ashwallow.xml                          Pyrelands — new file 2026-09-28

  PYRELANDS_DEDICATED_GRAZER_1: the "burrowers" family's own dedicated species
  (the_pyrelands.md §4 — "grazers that let the fire pass over and emerge into
  the fertilized ash"), distinct from RSW_Orray. Checked cast_assignment.csv
  and animal_census.csv first (per this item's own step 1): no unassigned
  small-grazer/burrower candidate exists there for this slot — every grazer
  row already carries a biome ("ash-grazer" rows Zeer/Iriaz/AA_Barbslinger are
  a DIFFERENT family; every other small grazer in the two CSVs is already
  homed elsewhere) — so this is authored from scratch, same posture
  the slime grazer and RUT_EmperorVulture used when no live donor passed.

  DISTINCT FROM ORRAY, on every axis the item asks for:
    - Orray: <predator>true</predator>, foodType includes CarnivoreAnimal/
      OvivoreAnimal, custom claw-and-fang Orray BodyDef, baseBodySize 2.0,
      MoveSpeed 5.0, packAnimal, manhunterOnDamageChance 1.0.
    - Ashwallow: predator false, foodType VegetarianRoughAnimal only, plain
      vanilla QuadrupedAnimalWithHooves body (hooves + head-butt tools only,
      no claws/fangs), baseBodySize 1.3, MoveSpeed 3.7, not a pack animal,
      manhunterOnDamageChance 0.05 (a docile grazer, not a fighter).
    - Orray's own register text is flavor only ("burrows underground when
      hungry") — grep confirmed (PYRELANDS_DEDICATED_GRAZER_1's own filing)
      no C# anywhere implements it. Ashwallow is the first creature in this
      repo with a REAL, mechanically-driven burrow-on-fire behaviour.

  BEHAVIOUR: RM_BurrowOnFireExtension (below) opts it into
  RM_JobGiver_BurrowOnFire / RM_JobDriver_Burrow
  (src/RimMandrake/Pyrelands/Source/) — the biome's own new, generic
  burrow-on-fire mechanism. Hooks MapComponent_BurnLine (already-built
  fire-tracking) rather than re-deriving fire detection; see that mechanism's
  own file headers. The modExtension class ships in this same mod's assembly.

  ART: artpipe RM_Ashwallow_{east,north,south} (PYRELANDS_DEDICATED_GRAZER_1),
  at Things/Pawn/Animal/Pyrelands/Ashwallow/Ashwallow_<facing>.

  Wired into RM_Pyrelands' own <wildAnimals> (Defs/BiomeDefs/Pyrelands.xml)
  at commonality 0.18.
-->
<Defs>

  <ThingDef ParentName="AnimalThingBase">
    <defName>RM_Ashwallow</defName>
    <label>ashwallow</label>
    <description>A low, broad grazer of the burning savanna, plated across the shoulders in cracked grey hide the same colour as spent ash. Its face is wide and flat as a spade, the jaw lined with blunt digging teeth that rake the root-mat loose, and its legs fold inward along the body so that, half-buried, it closes into a smooth ash-grey dome. It works the quickgrass in the calm between burns, and the instant it reads a front coming — heat on the wind, the hiss climbing before the light does — it drops flat, digs in, curls its legs under, and goes still. The fire walks over it. It comes back up into the black once the ground has cooled, first into the fertilized ash and first to the regrowth sprint. It has no bite worth the name and nothing to hunt with; going to ground is the only trick it has, and it is enough.</description>
    <statBases>
      <MoveSpeed>3.7</MoveSpeed>
      <MarketValue>220</MarketValue>
      <ComfyTemperatureMin>-10</ComfyTemperatureMin>
      <!-- PROVISIONAL numbers (owner 2026-10-11, Pyrelands sheet note: "enormous temperature resistance to
           survive fires"): ComfyTemperatureMax 58 -> 120, ArmorRating_Heat 0 -> 1.0, Flammability 0.05. Below
           the FurnaceBeast's total immunity (Heat 2.0 / Flammability 0) on purpose: it still dies to a long
           burn. Tune after a live fire test. The RM_Burrowed hediff (while in the dome stance) adds on top. -->
      <ComfyTemperatureMax>120</ComfyTemperatureMax>
      <ArmorRating_Heat>1.0</ArmorRating_Heat>
      <Flammability>0.05</Flammability>
      <ArmorRating_Blunt>0.1</ArmorRating_Blunt>
      <FilthRate>1.5</FilthRate>
      <Wildness>0.55</Wildness>
    </statBases>
    <tools>
      <li>
        <label>left forehoof</label>
        <labelNoLocation>forehoof</labelNoLocation>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>7</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftLeg</linkedBodyPartsGroup>
      </li>
      <li>
        <label>right forehoof</label>
        <labelNoLocation>forehoof</labelNoLocation>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>7</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>FrontRightLeg</linkedBodyPartsGroup>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>5</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <race>
      <body>QuadrupedAnimalWithHooves</body>
      <predator>false</predator>
      <herdAnimal>false</herdAnimal>
      <baseBodySize>1.3</baseBodySize>
      <baseHealthScale>1.1</baseHealthScale>
      <baseHungerRate>0.4</baseHungerRate>
      <foodType>VegetarianRoughAnimal</foodType>
      <leatherDef>Leather_Plain</leatherDef>
      <trainability>None</trainability>
      <manhunterOnTameFailChance>0.02</manhunterOnTameFailChance>
      <manhunterOnDamageChance>0.05</manhunterOnDamageChance>
      <gestationPeriodDays>10</gestationPeriodDays>
      <lifeExpectancy>11</lifeExpectancy>
      <litterSizeCurve>
        <points>
          <li>(0.5, 0)</li>
          <li>(1, 1)</li>
          <li>(2, 0.6)</li>
          <li>(2.5, 0)</li>
        </points>
      </litterSizeCurve>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.2</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.45</minAge>
          <soundWounded>Pawn_Muffalo_Wounded</soundWounded>
          <soundDeath>Pawn_Muffalo_Death</soundDeath>
          <soundCall>Pawn_Muffalo_Call</soundCall>
          <soundAngry>Pawn_Muffalo_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
      <soundEating>Herbivore_Eat</soundEating>
    </race>
    <modExtensions>
      <li Class="RimMandrake.Pyrelands.RM_BurrowOnFireExtension">
        <detectionRadius>15</detectionRadius>
        <!-- ASHWALLOW_HEAT_DOME_WIRE_CURLS_UP_LATE: a heat hit domes it at once; the dome pose draws while RM_Burrowed holds -->
        <domeOnHeatHit>true</domeOnHeatHit>
        <domeTexPath>Things/Pawn/Animal/Pyrelands/Ashwallow/AshwallowDome</domeTexPath>
      </li>
    </modExtensions>
    <tradeTags>
      <li>AnimalUncommon</li>
    </tradeTags>
  </ThingDef>

  <PawnKindDef ParentName="AnimalKindBase">
    <defName>RM_Ashwallow</defName>
    <label>ashwallow</label>
    <race>RM_Ashwallow</race>
    <combatPower>50</combatPower>
    <ecoSystemWeight>0.4</ecoSystemWeight>
    <wildGroupSize>1~3</wildGroupSize>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/Pyrelands/Ashwallow/Ashwallow</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.1</drawSize>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/Pyrelands/Ashwallow/Ashwallow</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.5</drawSize>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/Pyrelands/Ashwallow/Ashwallow</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.9</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>

</Defs>
