<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    PYRELANDS_SCORCHED_RUINS_1. Wired in ONLY via RM_Pyrelands's own
    <extraGenSteps> (Defs/BiomeDefs/Pyrelands.xml) — BiomeDef.extraGenSteps is
    concatenated into a map's genstep list only when that map's biome IS the
    one carrying the list (RimSage, Verse/MapGenerator.cs:163), so this never
    fires on, and needs no patch into, any other biome's MapGeneratorDef.

    order=760 sits right after ScatterRuinsSimple (order=750, RimSage) and
    well before Plants (order=900), so the worker (FireEcologyHook.cs,
    GenStep_ScorchPyrelandsRuins) sees the ruin's footprint before wild
    plants roll what grows on top of it.
  -->
  <GenStepDef>
    <defName>RM_FE_ScorchRuins</defName>
    <genStep Class="RimMandrake.Pyrelands.GenStep_ScorchPyrelandsRuins" />
    <order>760</order>
  </GenStepDef>

  <!--
    PYRE_RUINS_DIAGNOSE_JUNKYARD_STAYS_PRISTINE (2026-10-12). The 760 pass sees
    only UsedRects; vanilla's ancient junk scatters (AncientJunkClusters,
    ScatterRoadDebris, MechanoidRemains, AncientFences, ... all order 960,
    RimSage Defs/Ideology/MapGeneration/CommonMapGenerator.xml) run later and
    never register a used rect, and AncientUtilityBuilding (750) never adds its
    own. This late sweep runs after all of them and scorches every unowned
    artificial building's footprint plus a one-cell rim. Wired through the same
    RM_Pyrelands <extraGenSteps>, so it too runs only on Pyrelands maps.
  -->
  <GenStepDef>
    <defName>RM_FE_ScorchRuinsLate</defName>
    <genStep Class="RimMandrake.Pyrelands.GenStep_ScorchPyrelandsRuins">
      <sweepUnownedBuildings>true</sweepUnownedBuildings>
    </genStep>
    <order>965</order>
  </GenStepDef>

  <!-- The fire cast is met on every fresh map; see GenStep_PyrelandsFireCast. Right after Animals (1200). -->
  <GenStepDef>
    <defName>RM_FE_FireCast</defName>
    <genStep Class="RimMandrake.Pyrelands.GenStep_PyrelandsFireCast" />
    <order>1210</order>
  </GenStepDef>
  <!-- The rare water, never none: a map the noise left with almost no standing water gets two or three ponds, and
       every pond gets a ragged shore and a thin mud, rich-soil, ash ring (GenStep_PyrelandsStandingWater). Right after
       Terrain (210), before roads, ruins, plants and animals. -->
  <GenStepDef>
    <defName>RM_FE_StandingWater</defName>
    <genStep Class="RimMandrake.Pyrelands.GenStep_PyrelandsStandingWater" />
    <order>215</order>
  </GenStepDef>
  <!-- The green ring: rich soil within about 7 cells of water starts fully grassed, mostly Quickgrass
       (GenStep_PyrelandsGreenRing, map s 2026-11-07 found it a third planted and orange). After Plants (900) and the
       late ruin scorch (965), so neither the wild fill nor the scorch decides that ground after it. -->
  <GenStepDef>
    <defName>RM_FE_GreenRing</defName>
    <genStep Class="RimMandrake.Pyrelands.GenStep_PyrelandsGreenRing" />
    <order>970</order>
  </GenStepDef>
</Defs>
