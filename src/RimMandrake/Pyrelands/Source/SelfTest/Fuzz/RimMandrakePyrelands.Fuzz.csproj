<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pyrelands offline fuzz, Approach B (same shape as TheForge/Stillsand/Scarlands). Plain net8.0, zero RimWorld/Unity
    references: ../../Kernel/*.cs and ../../FurnaceWarmthMath.cs are the PRODUCTION files the mod compiles, pulled in directly.
    A `using Verse;` landing in one of them breaks this build - that is the guard rail working. The tuning numbers are NOT copied:
    the fuzz reads ../../PyrelandsTuning.cs itself (a tuning-path argument passed by the wrapper), so it cannot drift from what ships.
    Run (builds on Windows via winbuild staging, then runs the exe):
      python3 src/RimMandrake/Utils/selftest_pyrelands_fuzz.py [fuzz knobs]
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RimMandrakePyrelands.Fuzz</AssemblyName>
    <RootNamespace>RimMandrake.Pyrelands.Fuzz</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Kernel\RM_BurnKernel.cs" />
    <Compile Include="..\..\Kernel\RM_FurnaceKernel.cs" />
    <Compile Include="..\..\Kernel\RM_BreakerKernel.cs" />
    <Compile Include="..\..\Kernel\RM_FireEcoKernel.cs" />
    <Compile Include="..\..\FurnaceWarmthMath.cs" />
    <Compile Include="PyrelandsFuzz.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
