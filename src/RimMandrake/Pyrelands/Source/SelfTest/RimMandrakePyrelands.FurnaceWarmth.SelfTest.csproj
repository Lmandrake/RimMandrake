<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline, no-game selftest for PYRELANDS_FURNACE_WARMTH_AMBIENT_1: compiles the REAL production
    FurnaceWarmthMath.cs (System.Math only) straight in. NOT the mod build (FireEcologyHook.csproj one
    directory up lists its files explicitly and never mentions this folder).
    Run via src/RimMandrake/Utils/selftest_furnace_warmth.py.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrakePyrelands.FurnaceWarmth.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.Pyrelands.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <DebugType>none</DebugType>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\FurnaceWarmthMath.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
