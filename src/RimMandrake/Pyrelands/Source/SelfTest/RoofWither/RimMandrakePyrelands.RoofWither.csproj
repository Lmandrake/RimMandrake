<Project Sdk="Microsoft.NET.Sdk">

  <!--
    T_ROOF_WITHER_OFFLINE driver: plain net8.0, zero RimWorld/Unity references. ../../Kernel/RM_RoofWitherKernel.cs is the
    PRODUCTION file the mod compiles (CompWithersUnderRoof.cs calls it), pulled in directly; a `using Verse;` landing in it
    breaks this build. Program.cs reads one plant per stdin line and prints every long tick of it.
    Run: python3 src/RimMandrake/Pyrelands/selftest_pyrelands_roof_wither.py
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RimMandrakePyrelands.RoofWither</AssemblyName>
    <RootNamespace>RimMandrake.Pyrelands.RoofWither</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Kernel\RM_RoofWitherKernel.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
