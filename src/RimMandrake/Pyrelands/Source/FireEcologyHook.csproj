<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RimWorld 1.6 runs Unity/Mono against a .NET Framework 4.7.2 profile, so
    the mod DLL must target net472. Same shape as
    src/RimStarWars/JawaRules/Source/JawaRules.csproj — copy that file's own
    header if this one goes stale.

    Build: python3 src/RimMandrake/Utils/winbuild.py Pyrelands (stages on
    D:\ClaudeWork\rimmandrake\build; dotnet is Windows-native and cannot take a /mnt path).
    Commit the DLL with its .srchash.

    Output lands in ../Assemblies/, which is where RimWorld looks.

    The assembly name is historical: it began as FIRE_ECOLOGY_LOOP_1's one
    light hook (FireEcologyHook.cs) and now carries the whole mod's C# —
    fire cycle, ash field, fauna behaviours, terrain dig,
    settings and the Verse-free kernels listed below.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FireEcologyHook</AssemblyName>
    <RootNamespace>FireEcologyHook</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- A member hiding an engine member (CS0108/CS0114) compiles silently into a second field; RM_JobDriver_Burrow once
         shadowed JobDriver.startTick this way. -->
    <WarningsAsErrors>CS0108;CS0114</WarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HarmonyDll)' == ''">
    <HarmonyDll>C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\2009463077\Current\Assemblies\0Harmony.dll</HarmonyDll>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="FireEcologyHook.cs" />
    <Compile Include="PlantGrowthStages.cs" />
    <Compile Include="RM_PyrelandsMod.cs" />
    <Compile Include="..\..\_Shared\SettingsKit\SettingsKitCore.cs" Link="Shared\SettingsKitCore.cs" />
    <Compile Include="..\..\_Shared\SettingsKit\SettingsKitDrawer.cs" Link="Shared\SettingsKitDrawer.cs" />
    <Compile Include="..\..\_Shared\SettingsKit\SettingsKitMasters.cs" Link="Shared\SettingsKitMasters.cs" />
    <Compile Include="..\..\_Shared\SettingsKit\SettingsKitMastersDrawer.cs" Link="Shared\SettingsKitMastersDrawer.cs" />
    <Compile Include="RM_PyrelandsDensityEnforcer.cs" />
    <Compile Include="WildPlantAllowlist.cs" />
    <!-- PYRELANDS_RM_MOD_BUILD_1 §6 — absorbed from
         mandrake.rut.pyrelandsmechanics; the campaign-specific remainder
         (fire rite, Tribes factions, arson-justice, flame harvest) stays
         there. -->
    <Compile Include="PyrelandsTuning.cs" />
    <Compile Include="PyrelandsMechanicsDefOf.cs" />
    <Compile Include="PyrelandsFireRiteHook.cs" />
    <Compile Include="MapComponent_BurnLine.cs" />
    <Compile Include="PyrelandsAshField.cs" />
    <Compile Include="..\..\_Shared\FlowWorksIrrigation\FlowWorksIrrigationRead.cs" Link="Shared\FlowWorksIrrigationRead.cs" />
    <Compile Include="..\..\_Shared\FlowWorksIrrigation\FlowWorksIrrigationKernel.cs" Link="Shared\FlowWorksIrrigationKernel.cs" />
    <Compile Include="RM_PyrelandsGiants.cs" />
    <Compile Include="RM_TerrainDig.cs" />
    <Compile Include="PyrelandsFireFront.cs" />
    <Compile Include="CompFireHawkSpread.cs" />
    <Compile Include="JobGiver_RUT_FireHawkCarryEmber.cs" />
    <Compile Include="JobDriver_RUT_FireHawkCarryEmber.cs" />
    <Compile Include="CompFurnaceWarmthAura.cs" />
    <Compile Include="FurnaceWarmthMath.cs" />
    <Compile Include="CompFurnaceBedIgnition.cs" />
    <Compile Include="CompFurnaceThermalCharge.cs" />
    <Compile Include="JobGiver_RUT_FurnaceThermalCycle.cs" />
    <Compile Include="Patch_FurnaceBeastHeatImmunity.cs" />
    <!-- FURNACEBEAST_WORLD_MIGRATION_1 — the world leg. -->
    <Compile Include="WorldObject_RM_FurnaceHerd.cs" />
    <Compile Include="WorldComponent_RM_FurnaceHerdSeeder.cs" />
    <Compile Include="Patch_FurnaceHerdMapRemoval.cs" />
    <!-- PYRELANDS_DEDICATED_GRAZER_1 — burrow-on-fire, generic and opt-in. -->
    <Compile Include="RM_BurrowOnFireExtension.cs" />
    <Compile Include="RM_JobGiver_BurrowOnFire.cs" />
    <Compile Include="RM_JobDriver_Burrow.cs" />
    <Compile Include="RM_BurrowHeatReaction.cs" />
    <Compile Include="PyrelandsMechanicsGate.cs" />
    <!-- Verse-free kernels the fuzz (SelfTest/Fuzz) drives; the mod and mandrake.rut.pyrelandsmechanics call them with the same expressions -->
    <Compile Include="Kernel\RM_BurnKernel.cs" />
    <Compile Include="Kernel\RM_FurnaceKernel.cs" />
    <Compile Include="Kernel\RM_FireEcoKernel.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
