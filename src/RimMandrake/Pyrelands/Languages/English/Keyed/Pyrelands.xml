  <!-- PYRELANDS_SAND_TERRAIN_YIELD_1. The sand-shovel designator (Designator_RM_ShovelTerrain) and its refusals. -->
  <RM_ShovelSandLabel>Shovel sand</RM_ShovelSandLabel>
  <RM_ShovelSandDesc>Dig out loose sand for glass sand. The cell is shovelled down to what lies beneath (gravel), so a sand patch is a finite deposit. Done by miners.</RM_ShovelSandDesc>
  <RM_ShovelSandAlreadyOrdered>Already ordered.</RM_ShovelSandAlreadyOrdered>
  <RM_ShovelSandNotSand>Not loose sand.</RM_ShovelSandNotSand>
  <RM_ShovelSandOpenGround>Must designate open ground.</RM_ShovelSandOpenGround>

