#!/usr/bin/env bash
# pipe — command the Maturation Pipeline in one line: on/off switches, three stop modes, show, why, log, void, grant,
# and (through pipeline_control.py) counts, limits and the queue. Every act binds the moment it commits to the one
# control store (~/.local/state/rimmandrake/control/control.db: no clone, build or publish) and prints at most 3 lines.
#     ./pipe show [Mod]   ./pipe off Graffiti --why "..."   ./pipe stop Graffiti --at-easy-spot --why "..."   ./pipe why Graffiti
# See src/RimMandrake/rimflow/control.py (item RIMMANDRAKE_BUILD_PIPELINE_CONTROL_ONE_LINERS_NO_BUILD_PROCESS).
exec python3 "$(dirname "$(readlink -f "$0")")/src/RimMandrake/rimflow/control.py" "$@"
