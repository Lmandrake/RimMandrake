diff --git a/src/RimMandrake/FlowWorks/Source/RM_DigProgress.cs b/src/RimMandrake/FlowWorks/Source/RM_DigProgress.cs
new file mode 100644
index 0000000000..19b5c2398f
--- /dev/null
+++ b/src/RimMandrake/FlowWorks/Source/RM_DigProgress.cs
@@ -0,0 +1,178 @@
+using System.Collections.Generic;
+using Verse;
+
+namespace RimMandrake.FlowWorks
+{
+	/// <summary>Shovel work already done on a square whose dig or fill was interrupted (hunger, thirst, sleep, a fire, a
+	/// draft, a lost shovel) and is not finished: the next job on the square, by anyone, carries on from it. See
+	/// <see cref="RM_DigProgressMath"/>. A running job holds its own work (<see cref="RM_JobDriver_ShovelFloor"/>, saved with
+	/// the job); only paused work lives here, keyed by square and direction and tagged with the depth it was done at.
+	/// Dropped when the order is cancelled (no designation) or the square's depth moves under it.</summary>
+	public class RM_MapComponent_DigProgress : MapComponent
+	{
+		private Dictionary<int, float> done = new Dictionary<int, float>();
+
+		private Dictionary<int, int> depthAt = new Dictionary<int, int>();
+
+		private readonly List<int> pruneBuffer = new List<int>();
+
+		public RM_MapComponent_DigProgress(Map map) : base(map)
+		{
+		}
+
+		public int Count => done.Count;
+
+		private bool KeyOf(IntVec3 c, bool fill, out int key)
+		{
+			key = 0;
+			if (!c.InBounds(map))
+			{
+				return false;
+			}
+			key = RM_DigProgressMath.Key(map.cellIndices.CellToIndex(c), fill);
+			return true;
+		}
+
+		private int DepthNow(IntVec3 c)
+		{
+			return map.GetComponent<RM_MapComponent_Excavation>()?.ExcavatedDepthAt(c) ?? 0;
+		}
+
+		/// <summary>The work paused on the square, removed from the store (the job taking it now holds it); 0 when there is
+		/// none or the square's depth has moved since.</summary>
+		public float Take(IntVec3 c, bool fill)
+		{
+			if (!KeyOf(c, fill, out int key))
+			{
+				return 0f;
+			}
+			bool has = done.TryGetValue(key, out float stored);
+			depthAt.TryGetValue(key, out int storedDepth);
+			done.Remove(key);
+			depthAt.Remove(key);
+			return RM_DigProgressMath.Resume(has, stored, storedDepth, DepthNow(c));
+		}
+
+		/// <summary>Pause work on the square at its current depth (replaces anything stored there).</summary>
+		public void Put(IntVec3 c, bool fill, float work)
+		{
+			if (!KeyOf(c, fill, out int key))
+			{
+				return;
+			}
+			if (!RM_DigProgressMath.Usable(work))
+			{
+				done.Remove(key);
+				depthAt.Remove(key);
+				return;
+			}
+			done[key] = work;
+			depthAt[key] = DepthNow(c);
+		}
+
+		public void Clear(IntVec3 c, bool fill)
+		{
+			if (KeyOf(c, fill, out int key))
+			{
+				done.Remove(key);
+				depthAt.Remove(key);
+			}
+		}
+
+		public float Peek(IntVec3 c, bool fill)
+		{
+			if (!KeyOf(c, fill, out int key))
+			{
+				return 0f;
+			}
+			bool has = done.TryGetValue(key, out float stored);
+			depthAt.TryGetValue(key, out int storedDepth);
+			return RM_DigProgressMath.Resume(has, stored, storedDepth, DepthNow(c));
+		}
+
+		public override void MapComponentTick()
+		{
+			if (done.Count == 0 || Find.TickManager.TicksGame % RM_DigProgressMath.PruneEveryTicks != 0)
+			{
+				return;
+			}
+			Prune();
+		}
+
+		/// <summary>Drops work whose order is gone (cancelled, or deleted as stale by the work giver) or whose square's depth
+		/// moved (someone else cut or filled it).</summary>
+		private void Prune()
+		{
+			RM_MapComponent_Excavation ex = map.GetComponent<RM_MapComponent_Excavation>();
+			DesignationManager dm = map.designationManager;
+			int cells = map.cellIndices.NumGridCells;
+			pruneBuffer.Clear();
+			foreach (KeyValuePair<int, float> kv in done)
+			{
+				int idx = RM_DigProgressMath.CellOf(kv.Key);
+				if (idx < 0 || idx >= cells)
+				{
+					pruneBuffer.Add(kv.Key);
+					continue;
+				}
+				IntVec3 c = map.cellIndices.IndexToCell(idx);
+				DesignationDef des = RM_DigProgressMath.IsFill(kv.Key) ? RimMandrakeFlowWorks_DefOf.RM_FillInCanal : RimMandrakeFlowWorks_DefOf.RM_DigCanal;
+				depthAt.TryGetValue(kv.Key, out int storedDepth);
+				if (dm.DesignationAt(c, des) == null || (ex?.ExcavatedDepthAt(c) ?? 0) != storedDepth)
+				{
+					pruneBuffer.Add(kv.Key);
+				}
+			}
+			for (int i = 0; i < pruneBuffer.Count; i++)
+			{
+				done.Remove(pruneBuffer[i]);
+				depthAt.Remove(pruneBuffer[i]);
+			}
+			pruneBuffer.Clear();
+		}
+
+		public override void ExposeData()
+		{
+			base.ExposeData();
+			Scribe_Collections.Look(ref done, "rmDigProgressDone", LookMode.Value, LookMode.Value);
+			Scribe_Collections.Look(ref depthAt, "rmDigProgressDepth", LookMode.Value, LookMode.Value);
+			if (Scribe.mode == LoadSaveMode.PostLoadInit)
+			{
+				if (done == null)
+				{
+					done = new Dictionary<int, float>();
+				}
+				if (depthAt == null)
+				{
+					depthAt = new Dictionary<int, int>();
+				}
+				// a half-written pair is no record: keep only work that has its depth tag and is a usable amount
+				pruneBuffer.Clear();
+				foreach (KeyValuePair<int, float> kv in done)
+				{
+					if (!depthAt.ContainsKey(kv.Key) || !RM_DigProgressMath.Usable(kv.Value))
+					{
+						pruneBuffer.Add(kv.Key);
+					}
+				}
+				for (int i = 0; i < pruneBuffer.Count; i++)
+				{
+					done.Remove(pruneBuffer[i]);
+				}
+				pruneBuffer.Clear();
+				foreach (int key in depthAt.Keys)
+				{
+					if (!done.ContainsKey(key))
+					{
+						pruneBuffer.Add(key);
+					}
+				}
+				for (int i = 0; i < pruneBuffer.Count; i++)
+				{
+					depthAt.Remove(pruneBuffer[i]);
+				}
+				pruneBuffer.Clear();
+			}
+		}
+	}
+}
diff --git a/src/RimMandrake/FlowWorks/Source/RM_DigProgressMath.cs b/src/RimMandrake/FlowWorks/Source/RM_DigProgressMath.cs
new file mode 100644
index 0000000000..90436ef3eb
--- /dev/null
+++ b/src/RimMandrake/FlowWorks/Source/RM_DigProgressMath.cs
@@ -0,0 +1,88 @@
+using System;
+
+namespace RimMandrake.FlowWorks
+{
+	/// <summary>Live bug (save NS_Pyrelands_play_q_col_d3dig, 2026-11-07): a colonist on RM_DigCanalJob stood on one
+	/// canal square for over 10 game hours and fell to food 0.05 and thirst 0.0. Vanilla's AffectFloor work toil never
+	/// lets the think tree look again until its work is done, and a first cut costs 3200 x 4 = 12,800 work, 16 to 31 hours
+	/// for a weak miner. Two fixes, both in <c>RM_JobDriver_ShovelFloor</c>: the job re-reads the think tree every
+	/// <see cref="OverrideCheckTicks"/> (food, drink, rest and fire win), and the work already done on a square is kept per
+	/// square (<c>RM_MapComponent_DigProgress</c>), so whoever comes back carries on from it. The arithmetic of that
+	/// store lives here, Verse-free, so the SelfTest can prove it.</summary>
+	public static class RM_DigProgressMath
+	{
+		/// <summary>How often a running dig or fill re-reads the pawn's think tree (Job.expiryInterval with
+		/// checkOverrideOnExpire). Under an hour: a notch at speed 1 is 12,800 / 1.7, about 7,500 ticks.</summary>
+		public const int OverrideCheckTicks = 2000;
+
+		/// <summary>How often the store drops work for squares whose order was cancelled or whose depth moved.</summary>
+		public const int PruneEveryTicks = 250;
+
+		/// <summary>One key per square and direction: a dig's work never counts toward a fill of the same square.</summary>
+		public static int Key(int cellIndex, bool fill)
+		{
+			return cellIndex * 2 + (fill ? 1 : 0);
+		}
+
+		public static int CellOf(int key)
+		{
+			return key >> 1;
+		}
+
+		public static bool IsFill(int key)
+		{
+			return (key & 1) == 1;
+		}
+
+		public static bool Usable(float work)
+		{
+			return work > 0f && !float.IsNaN(work) && !float.IsInfinity(work);
+		}
+
+		/// <summary>Work a resumed job starts from: what was stored for the square, only while the square is still at the
+		/// depth it was stored at (a cut or fill by anyone else in between voids it), otherwise nothing.</summary>
+		public static float Resume(bool has, float stored, int storedDepth, int depthNow)
+		{
+			return has && storedDepth == depthNow && Usable(stored) ? stored : 0f;
+		}
+
+		/// <summary>One tick interval of shovel work: vanilla AffectFloor's own rate, 1.7 x the speed stat per tick.</summary>
+		public static float AfterTicks(float done, float speed, int delta)
+		{
+			return done + speed * RM_DigDepthMath.WorkPerTickAtSpeedOne * delta;
+		}
+
+		public static bool Finished(float done, float total)
+		{
+			return total > 0f && done >= total;
+		}
+
+		/// <summary>The progress bar: the share of the work done, 0..1.</summary>
+		public static float Fraction(float done, float total)
+		{
+			if (!(total > 0f) || !Usable(done))
+			{
+				return 0f;
+			}
+			return Math.Min(1f, done / total);
+		}
+
+		/// <summary>Whether a job that ended keeps its work for the square: only work that did not land, on an order that
+		/// still stands. A cancelled order takes its work with it.</summary>
+		public static bool Keep(float done, bool landed, bool orderStands)
+		{
+			return !landed && orderStands && Usable(done);
+		}
+
+		/// <summary>A save from before this fix holds vanilla's private workLeft (counting down from the total, -1000 before
+		/// the work began). The work it stands for, 0..total; nothing when it says nothing.</summary>
+		public static float FromWorkLeft(float workLeft, float total)
+		{
+			if (!Usable(workLeft) || !(total > 0f))
+			{
+				return 0f;
+			}
+			return Math.Max(0f, Math.Min(total, total - workLeft));
+		}
+	}
+}
diff --git a/src/RimMandrake/FlowWorks/Source/RM_JobDriver_ShovelFloor.cs b/src/RimMandrake/FlowWorks/Source/RM_JobDriver_ShovelFloor.cs
new file mode 100644
index 0000000000..9ed4362244
--- /dev/null
+++ b/src/RimMandrake/FlowWorks/Source/RM_JobDriver_ShovelFloor.cs
@@ -0,0 +1,156 @@
+using System.Collections.Generic;
+using System.Reflection;
+using HarmonyLib;
+using RimWorld;
+using Verse;
+using Verse.AI;
+
+namespace RimMandrake.FlowWorks
+{
+	/// <summary>The dig and fill jobs' engine: vanilla <see cref="JobDriver_AffectFloor"/>'s toils, rebuilt so hours of shovel
+	/// work no longer hold a pawn until it starves (live, save NS_Pyrelands_play_q_col_d3dig: over 10 game hours on one
+	/// square, food 0.05, thirst 0.0, square still undug; see <see cref="RM_DigProgressMath"/>).
+	///
+	/// Two changes, everything else as vanilla (designation FailOn, Goto Touch, FailOnCannotTouch, progress bar,
+	/// Construction learning, the speed stat at 1.7 per tick, DoEffect then the designation's deletion, same two-toil
+	/// layout so a saved toil index lands on the same toil):
+	///  1. The job re-reads the think tree every <see cref="RM_DigProgressMath.OverrideCheckTicks"/> ticks
+	///     (expiryInterval + checkOverrideOnExpire): Pawn_JobTracker.CheckForJobOverride starts food, drink, rest, joy or a
+	///     fire job over it, and with nothing better it keeps digging (same JobDef from the same JobGiver is a continuation).
+	///  2. The work done is the driver's own, saved with the job, and when the job ends unfinished on a standing order it
+	///     is parked per square in <see cref="RM_MapComponent_DigProgress"/>; the next job on the square starts from it.
+	/// Vanilla's per-job private workLeft lost all of it on any interruption.</summary>
+	public abstract class RM_JobDriver_ShovelFloor : JobDriver_AffectFloor
+	{
+		/// <summary>Vanilla's private countdown, read once to carry on a job saved before this driver existed.</summary>
+		private static readonly FieldInfo VanillaWorkLeft = AccessTools.Field(typeof(JobDriver_AffectFloor), "workLeft");
+
+		private float workDone;
+
+		private float workTotal;
+
+		/// <summary>Set when the work completed and DoEffect spent it; not saved (the job ends the same tick).</summary>
+		private bool workLanded;
+
+		/// <summary>Fill and dig work on a square are kept apart.</summary>
+		protected abstract bool IsFill { get; }
+
+		/// <summary>True after DoEffect when the finished work was not spent (a cut refused at this digger's cap that someone
+		/// else may still make): the work is parked for them rather than lost.</summary>
+		protected virtual bool KeepWorkAfterEffect => false;
+
+		public override void Notify_Starting()
+		{
+			base.Notify_Starting();
+			EnsureInterruptible();
+		}
+
+		/// <summary>Set at the start and checked every work tick, so a job saved without it (an old save, a job made by
+		/// another mod or a bridge tool) gets it too.</summary>
+		private void EnsureInterruptible()
+		{
+			if (job != null && (job.expiryInterval != RM_DigProgressMath.OverrideCheckTicks || !job.checkOverrideOnExpire))
+			{
+				job.expiryInterval = RM_DigProgressMath.OverrideCheckTicks;
+				job.checkOverrideOnExpire = true;
+			}
+		}
+
+		protected override IEnumerable<Toil> MakeNewToils()
+		{
+			// Added after any finish action the subclass added before calling this, so the dig's re-designation runs first
+			// and the order it restores counts as standing.
+			AddFinishAction(delegate (JobCondition cond)
+			{
+				ParkUnfinishedWork();
+			});
+			return ShovelToils();
+		}
+
+		private IEnumerable<Toil> ShovelToils()
+		{
+			this.FailOn(() => !job.ignoreDesignations && Map.designationManager.DesignationAt(TargetLocA, DesDef) == null);
+			yield return Toils_Goto.GotoCell(TargetIndex.A, PathEndMode.Touch);
+			Toil doWork = ToilMaker.MakeToil("RM_ShovelWork");
+			doWork.initAction = delegate
+			{
+				BeginWork(TakeParked());
+			};
+			doWork.tickIntervalAction = delegate (int delta)
+			{
+				if (workTotal <= 0f)
+				{
+					// loaded mid-work from a save made before this driver: vanilla's countdown says how far it got
+					float old = VanillaWorkLeft != null ? (float)VanillaWorkLeft.GetValue(this) : -1000f;
+					BeginWork(0f);
+					float carried = RM_DigProgressMath.FromWorkLeft(old, workTotal);
+					workDone = carried > 0f ? carried : TakeParked();
+				}
+				EnsureInterruptible();
+				Pawn actor = doWork.actor;
+				StatDef stat = SpeedStat;
+				float speed = stat != null && !stat.Worker.IsDisabledFor(actor) ? actor.GetStatValue(stat) : 1f;
+				workDone = RM_DigProgressMath.AfterTicks(workDone, speed, delta);
+				actor.skills?.Learn(SkillDefOf.Construction, 0.1f * delta);
+				if (clearSnow)
+				{
+					Map.snowGrid.SetDepth(TargetLocA, 0f);
+					Map.sandGrid?.SetDepth(TargetLocA, 0f);
+				}
+				if (RM_DigProgressMath.Finished(workDone, workTotal))
+				{
+					IntVec3 c = TargetLocA;
+					DoEffect(c);
+					workLanded = !KeepWorkAfterEffect;
+					Map.designationManager.DesignationAt(c, DesDef)?.Delete();
+					ReadyForNextToil();
+				}
+			};
+			doWork.FailOnCannotTouch(TargetIndex.A, PathEndMode.Touch);
+			doWork.WithProgressBar(TargetIndex.A, () => RM_DigProgressMath.Fraction(workDone, workTotal));
+			doWork.defaultCompleteMode = ToilCompleteMode.Never;
+			doWork.activeSkill = () => SkillDefOf.Construction;
+			yield return doWork;
+		}
+
+		private void BeginWork(float resumed)
+		{
+			// never 0: vanilla finished a zero-work job on its first tick, and so does this
+			workTotal = System.Math.Max(1, BaseWorkAmount);
+			workDone = resumed;
+			workLanded = false;
+		}
+
+		private float TakeParked()
+		{
+			Map map = Map;
+			if (map == null || !job.targetA.IsValid)
+			{
+				return 0f;
+			}
+			return map.GetComponent<RM_MapComponent_DigProgress>()?.Take(job.targetA.Cell, IsFill) ?? 0f;
+		}
+
+		private void ParkUnfinishedWork()
+		{
+			Map map = pawn?.MapHeld;
+			if (map == null || job == null || !job.targetA.IsValid)
+			{
+				return;
+			}
+			IntVec3 c = job.targetA.Cell;
+			bool orderStands = job.ignoreDesignations || map.designationManager.DesignationAt(c, DesDef) != null;
+			if (RM_DigProgressMath.Keep(workDone, workLanded, orderStands))
+			{
+				map.GetComponent<RM_MapComponent_DigProgress>()?.Put(c, IsFill, workDone);
+			}
+		}
+
+		public override void ExposeData()
+		{
+			base.ExposeData();
+			Scribe_Values.Look(ref workDone, "rmShovelWorkDone", 0f);
+			Scribe_Values.Look(ref workTotal, "rmShovelWorkTotal", 0f);
+		}
+	}
+}
