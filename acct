#!/usr/bin/env bash
# acct: command the account plan in one line. One plan file (~/.local/state/rimmandrake/account_plan/plan.json: no clone,
# build or publish); every write binds at the next read and prints at most 3 lines, the last its undo.
#     ./acct status   ./acct next   ./acct line steven 5 --until-reset --why "..."   ./acct whatif -- order lukas system steven
# See src/RimMandrake/Utils/account_plan.py (page design/specs/2026-11-24-account-plan-one-file/boundary.md).
exec python3 "$(dirname "$(readlink -f "$0")")/src/RimMandrake/Utils/account_plan.py" "$@"
