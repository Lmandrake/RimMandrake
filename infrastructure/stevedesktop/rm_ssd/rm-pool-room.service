[Unit]
Description=Refresh the object store, then read how many helper runs ~/rm still holds (rm_pool_room.py; reading ~/.local/state/rm-ssd/pool_room_ok.json)

[Service]
Type=oneshot
# Nothing else fetches mirror.git here: on 2026-11-25 it was a day behind origin, so every new pool clone fetched that day
# from GitHub into its own .git (0.9 GB each). Fetch it and feed the store (scratch_clone.py refresh). Then dedupe packs
# away every borrower's copies of what the store now holds, the mirror's, the seat clones' and the pool clones' (repack -l
# keeps only objects the store lacks; the store never prunes): 4.3 GB on 2026-11-26, most of it in runner, runner_b, bench.
# "-": a failed refresh (GitHub down) or dedupe never stops the room reading.
ExecStartPre=-/bin/bash -c 'git -C %h/rm/mirror.git fetch -q origin && /usr/bin/python3 %h/rm/runner/src/RimMandrake/Utils/scratch_clone.py refresh'
ExecStartPre=-/usr/bin/python3 %h/rm/runner/src/RimMandrake/Utils/scratch_clone.py dedupe
# testcentre_env.sh is the one home of RM_POOL_FLOOR_GB, the floor the pool admits clones by
ExecStart=/bin/bash -c '. %h/rm/runner/infrastructure/stevedesktop/testcentre_env.sh && exec /usr/bin/python3 %h/.local/bin/rm_pool_room.py'
# danger: a fetch or repack that hangs holds this oneshot active, so no later hour runs; longest: fetch+refresh 38 s, dedupe
# 94 s (2026-11-26; dedupe's own repacks stop at 900 s each); 2 h is far above that and below the next-but-one hour
TimeoutStartSec=2h
