# rm-arena-replay.service - the trial's replay runner (ARENA_SWITCH_BUILD_ONE_ARM_LIVE_ONLY, design 2.1). Rendered by
# arena_install.py. Runs only while rm-arm-trial.target is live (PartOf=). The driving loop is OWED: until it lands,
# `arena.py trial-runner` exits 3 and this unit shows failed.
[Unit]
Description=RimMandrake arena trial replay runner
PartOf=rm-arm-trial.target

[Service]
Type=simple
Environment=ARENA_ARM_TOML=@ARM_TOML@
ExecStart=/usr/bin/python3 @ARENA_PY@ trial-runner
Restart=no
