# arm.toml TEMPLATE (ARENA_SWITCH_BUILD_ONE_ARM_LIVE_ONLY). The REAL file lives OUTSIDE git:
#   $ARENA_ARM_TOML, default <arena root>/arm.toml  (D:\ClaudeWork\rimmandrake\arena\arm.toml). Never commit it.
mode = "production"          # v3 | v3c | ralph_a | ralph_c | trio | production | trial

[production]                 # the production clones that are live in v3 / production / trial mode
scope = ["bench", "foundry"]

[trial]                      # read only when mode = "trial"
steve_lane    = "trio"
archmagi_lane = "ralph_c"
replay_arms   = ["ralph_a", "trio", "v3", "v3c"]
areas_day     = "D:/ClaudeWork/rimmandrake/arena/areas/2026-10-31.json"

# optional clone path overrides (defaults: /home/mandrake/rm/<bench|foundry>, /home/mandrake/rm/arena/<arm>)
# [clones]
# ralph_a = "/home/mandrake/rm/arena/ralph_a"

# the units that belong to each arm's target (each gets PartOf=rm-arm-<arm>.target by the installer's drop-in).
# Substrate timers (account-usage, deadman, memwatch, mirror, pulse-*, ...) are in NO target.
[arms.ralph_a]
units = ["rm-ralph-loop@a.service"]
[arms.ralph_c]
units = ["rm-ralph-loop@a1.service", "rm-ralph-loop@a2.service", "rm-runner@steve.service", "rm-runner@archmagi.service"]
[arms.trio]
units = ["rm-testpilot@steve.service", "rm-testpilot@archmagi.service"]
[arms.v3]                    # the v3 machinery (enabled timers in timers.target.wants: `arena switch` DISABLES them
                             # when another arm goes live; it never enables anything - re-enable is the owner's step)
units = ["rm-dispatcher.timer", "rm-dispatcher.service", "testq-tick.timer", "testq-tick.service",
         "testq-steward-watch.timer", "testq-steward-watch.service", "rm-artpipe-idle-fill.timer",
         "rm-artpipe-idle-fill.service", "rm-arteval-autojudge.timer", "rm-arteval-autojudge.service"]
[arms.trial]                 # rm-arm-trial.target (live beside rm-arm-v3.target in trial mode): the replay runner
units = ["rm-arena-replay.service"]
[arms.v3c]
units = []
[arms.production]
units = []                   # production owns NO member units: a unit belongs to exactly one arm, and the v3 timers
                             # above (dispatcher, testq-tick, steward, artpipe-idle-fill, arteval-autojudge) are v3's.
# What `production` LIVE means (item 3), per production clone; only the clones in [production] scope are checked.
# `arena who` (a) fails when an entry is not active: a plain name must be active, a glob needs >= 1 active match
# (the seat scopes are transient: claude-seat-<SEAT>-<pid>.scope, scripts/claude_bounded.sh). This is a VERIFICATION
# set, not membership: nothing here gets a drop-in, and switching away from production stops none of it.
# Read 2026-10-29 from the unit files in ~/.config/systemd/user (WorkingDirectory / zz-*-workdir.conf drop-ins):
#   bench:   seat scope, rm-selftests-nightly.timer (WorkingDirectory=/home/mandrake/rm/bench)
#   foundry: seat scope, rm-artpiped.service (zz-foundry-workdir.conf), rm-codebase-health.timer
# UNCLASSIFIED (neither production-live nor substrate; decide before relying on them): testq-sweep.timer (runs in the
#   dispatch clone, not in v3's list), rm-scratch-reap.timer (foundry workdir housekeeping), rm-objstore.service,
#   rm-v3-vs-v2 (not enabled), account-plan, claude-account-warm (not enabled), hestia.
# Substrate (in NO arm, never checked): account-usage, deadman, memwatch, mirror, pulse-*, ops-watch, timer-guard,
#   telemetry-*, claude-account-*. No conductor unit file exists.
# Known noise: with no seat open in a clone, production `who` (a) fails (no active seat scope matches).
[arms.production.live]
bench   = ["claude-seat-BENCH-*.scope", "rm-selftests-nightly.timer"]
foundry = ["claude-seat-FOUNDRY-*.scope", "rm-artpiped.service", "rm-codebase-health.timer"]
