<?xml version="1.0" encoding="utf-8"?>
<!--
  DEEPCALM_AMBIENT_SOUND_1 — ambient loop for RUT_DeepCalm (the Lantern Deeps
  pocket-map weather). Target from the_lantern_deeps.md §9: "the hum, rising to
  a Chorus".

  NO new audio asset: both grains below point clipPath at clips already shipped
  in the Anomaly DLC (owned expansion, confirmed active in this campaign's
  knownExpansions — infrastructure/state/modlists/ModsConfig.FULL.20260819_201527.xml).
  The clip paths are copied verbatim from Anomaly's own shipped, working SoundDefs
  (Data/Anomaly/Defs/SoundDefs/World_Sustainers_Misc.xml's Ambient_Undercave, and
  Buildings_Misc.xml's VoidNode_Ambient) — proof the paths resolve, since those
  defs already play in a released, tested game. Cross-content-pack SoundDef
  reference is likewise proven live: Anomaly's own BloodRain WeatherDef lists
  Core's Ambient_Wind_Fog/Ambient_Rain in its ambientSounds — the DefDatabase
  lookup a WeatherDef.ambientSounds entry performs does not care which content
  pack declared the SoundDef, or which pack's clip a SoundDef's grain names.

  RUT_DeepHum   — the constant low cave drone ("the hum").
  RUT_DeepChorus — a quieter, slow-swelling eerie layer on top ("rising to a
                   Chorus"); soft enough to read as a periodic intensification
                   of the hum rather than a second distinct sound.
-->
<Defs>

  <SoundDef>
    <defName>RUT_DeepHum</defName>
    <sustain>True</sustain>
    <context>MapOnly</context>
    <priorityMode>PrioritizeNearest</priorityMode>
    <subSounds>
      <li>
        <onCamera>True</onCamera>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>Ambience/Undercave/Undercave_Ambience_Loop_A</clipPath>
          </li>
        </grains>
        <volumeRange>4</volumeRange>
        <pitchRange>0.85~0.95</pitchRange>
        <paramMappings>
          <li>
            <inParam Class="SoundParamSource_AmbientVolume" />
            <outParam Class="SoundParamTarget_Volume" />
          </li>
        </paramMappings>
        <randomStartPoint>true</randomStartPoint>
      </li>
    </subSounds>
  </SoundDef>

  <SoundDef>
    <defName>RUT_DeepChorus</defName>
    <sustain>True</sustain>
    <context>MapOnly</context>
    <priorityMode>PrioritizeNearest</priorityMode>
    <subSounds>
      <li>
        <onCamera>True</onCamera>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>Building/VoidNode/VoidNode_Ambience_Loop_A</clipPath>
          </li>
        </grains>
        <volumeRange>2~4</volumeRange>
        <pitchRange>0.9~1.05</pitchRange>
        <sustainAttack>4</sustainAttack>
        <sustainRelease>4</sustainRelease>
        <paramMappings>
          <li>
            <inParam Class="SoundParamSource_AmbientVolume" />
            <outParam Class="SoundParamTarget_Volume" />
          </li>
        </paramMappings>
        <randomStartPoint>true</randomStartPoint>
      </li>
    </subSounds>
  </SoundDef>

</Defs>
